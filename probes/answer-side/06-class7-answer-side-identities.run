#!/bin/sh
# probes/answer-side/06-class7-answer-side-identities.run — the class-7
# answer-side identity probe driver (the six native inverse-hyperbolic heads, the
# Mathematica conventions, the shim bodies; see the .py docstring).
#
#   sh probes/answer-side/06-class7-answer-side-identities.run
cd "$(dirname "$0")/../.." || exit 1
python3 probes/answer-side/06-class7-answer-side-identities.py > probes/answer-side/06-class7-answer-side-identities.out
echo "wrote probes/answer-side/06-class7-answer-side-identities.out"
