#!/bin/sh
# probes/answer-side/01-answer-side-identities.run — the answer-side
# identity probe driver (the class-2 normalization's two conventions,
# measured on the installed build; see the .py docstring).
#
#   sh probes/answer-side/01-answer-side-identities.run
cd "$(dirname "$0")/../.." || exit 1
python3 probes/answer-side/01-answer-side-identities.py > probes/answer-side/01-answer-side-identities.out
echo "wrote probes/answer-side/01-answer-side-identities.out"
