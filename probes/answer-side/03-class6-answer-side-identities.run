#!/bin/sh
# probes/answer-side/03-class6-answer-side-identities.run — the class-6
# answer-side identity probe driver (the six native hyperbolic heads plus
# the two rule-side special heads; see the .py docstring).
#
#   sh probes/answer-side/03-class6-answer-side-identities.run
cd "$(dirname "$0")/../.." || exit 1
python3 probes/answer-side/03-class6-answer-side-identities.py > probes/answer-side/03-class6-answer-side-identities.out
echo "wrote probes/answer-side/03-class6-answer-side-identities.out"
