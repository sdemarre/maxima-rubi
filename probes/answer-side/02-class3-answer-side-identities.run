#!/bin/sh
# probes/answer-side/02-class3-answer-side-identities.run — the class-3
# answer-side identity probe driver (the class-3 normalization's five
# conventions, measured on the installed build; see the .py docstring).
#
#   sh probes/answer-side/02-class3-answer-side-identities.run
cd "$(dirname "$0")/../.." || exit 1
python3 probes/answer-side/02-class3-answer-side-identities.py > probes/answer-side/02-class3-answer-side-identities.out
echo "wrote probes/answer-side/02-class3-answer-side-identities.out"
