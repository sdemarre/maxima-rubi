#!/bin/sh
# probes/answer-side/05-class5-answer-side-identities.run — the class-5
# answer-side identity probe driver (the six native inverse-trig heads, the
# Mathematica conventions, poly_discriminant; see the .py docstring).
#
#   sh probes/answer-side/05-class5-answer-side-identities.run
cd "$(dirname "$0")/../.." || exit 1
python3 probes/answer-side/05-class5-answer-side-identities.py > probes/answer-side/05-class5-answer-side-identities.out
echo "wrote probes/answer-side/05-class5-answer-side-identities.out"
