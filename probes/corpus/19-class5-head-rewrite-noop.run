#!/bin/sh
# probes/corpus/19-class5-head-rewrite-noop.run — the class-5 Step-7 no-op
# check for the driver's head rewrites over every corpus entry (no Maxima).
#
#   sh probes/corpus/19-class5-head-rewrite-noop.run
cd "$(dirname "$0")/../.." || exit 1
python3 probes/corpus/19-class5-head-rewrite-noop.py > probes/corpus/19-class5-head-rewrite-noop.out
echo "wrote probes/corpus/19-class5-head-rewrite-noop.out"
