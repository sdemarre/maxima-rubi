batch("probes/corpus/06-calibration.pass4.mac")
cali_entry(name,f,x):=block([ans,census,k,hp,d,i,ans4],
           print(concat("CALI ",name)),rubi_verbose:true,ans:rubi(f,x),
           print(concat("PROD ",
                        if atom(ans) then "atom" else string(op(ans)))),
           census:%mr_barefactors(f),k:part(census,1),hp:part(census,2),
           print(concat("P4CENSUS ",string(k)," ",string(hp))),
           if is(op(f) = "*")
               then print(concat("P4DIAG ",string(%mr_p4_diag(f)))),
           if is(hp = false) and is(k >= 2)
               then (for d from 0 thru 1 do
                         (for i thru k do
                              (print(concat("P4SCAN ",string(d)," ",
                                            string(i))),
                               ans4:%mr_p4_once(f,x,mr_rule_table,1,d,i),
                               if is(ans4 # false)
                                   then print(
                                   concat("P4FIRE ",string(d)," ",string(i),
                                          " ",
                                          if atom(ans4) then "atom"
                                              else string(op(ans4)))))))
               else print(concat("P4SKIP")),rubi_verbose:false,
           print(concat("CALIEND ",name)))
cali_entry("f2",(d+e*x)*(a+b*log(c*x^n)),x)
