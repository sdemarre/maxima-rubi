/* probes/corpus/26-class4-slice-attribution.mac -- the per-entry
   attribution of probes/corpus/25-class4-slice-ab.out's transitions in
   classes 1/3/7 (the class-6/5/8 ones are contains-noun -> answer through
   class-4 records). Run by 26-class4-slice-attribution.run, which prepends
   mr_oldff (true = the pre-class-4 FreeFactors/NonfreeFactors, the op()
   reading without inflag) and mr_f (the integrand). Prints the CPU time,
   whether the answer carries a noun, and (rubi_verbose) the rules that fired. */
load("maxima_rubi.mac")$
display2d:false$
mr_load_all()$
if mr_oldff = true then (
  %mr_nonfreeFactors(u, x) := block([r, i, t],
    if atom(u) then (if freeof(x, u) then 1 else u)
    elseif op(u) = "-" then %mr_nonfreeFactors(part(u, 1), x)
    elseif op(u) = "*" then (r : 1, for i : 1 thru length(u) do (t : part(u, i), if is(freeof(x, t)) = false then r : r * t), r)
    else if freeof(x, u) then 1 else u),
  %mr_freeFactors(u, x) := block([r, i, t],
    if atom(u) then (if freeof(x, u) then u else 1)
    elseif op(u) = "-" then -%mr_freeFactors(part(u, 1), x)
    elseif op(u) = "*" then (r : 1, for i : 1 thru length(u) do (t : part(u, i), if freeof(x, t) then r : r * t), r)
    else if freeof(x, u) then u else 1))$
rubi_verbose : true$
t0 : elapsed_run_time()$
r : rubi(mr_f, x)$
print("TIME", elapsed_run_time() - t0, "NOUN", not freeof(unintegrable, r))$
