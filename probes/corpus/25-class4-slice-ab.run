#!/bin/sh
# probes/corpus/25-class4-slice-ab.run — the class-4 port's Step-7 slice
# check (docs/class-porting.md Step 7): small single-process corpus slices of
# the earlier classes run on the class-4 tree's rules core AND on a core
# built at 9dd5f16 (the class-7 port's last commit, i.e. the tree before
# class 4; a throwaway git worktree; the driver is this tree's in both arms --
# its only class-4 change is the Hypergeometric2F1 reshape, a no-op outside
# section 4, probes/corpus/24-class4-head-rewrite-noop.out), A/B'd entry by
# entry with test/ab_records.py; then a 2-per-file class-4 slice on the
# class-4 core. Slices: class 1 "1.1.1" 2/file, class 2 2/file, classes
# 3/5/6/7/8 1/file (101 entries), 30 s cpu cap. One Maxima process at a
# time.
#
#   sh probes/corpus/25-class4-slice-ab.run      (rebuilds nothing: build
#                                                 test/mr_rules.core first)
cd "$(dirname "$0")/../.." || exit 1
ROOT=$(pwd)
W=$(mktemp -d)
OUT=probes/corpus/25-class4-slice-ab.out
SUITE="$ROOT/reference/maxima-syntax-test-suite"
git worktree add -q --detach "$W/base" 9dd5f16 || exit 1
ln -s "$(readlink -f reference)" "$W/base/reference"
(cd "$W/base" && bash test/build_rules_core.sh > "$W/base-build.log" 2>&1) || { cat "$W/base-build.log"; exit 1; }
slices() {  # $1 = tag
  python3 test/corpus_driver.py "1.1.1" 2 30 "$SUITE" 0 "" 0 "$W/$1-c1.out" < /dev/null > /dev/null 2>&1
  python3 test/corpus_driver.py "" 2 30 "$SUITE/2 Exponentials" 0 "" 0 "$W/$1-c2.out" < /dev/null > /dev/null 2>&1
  python3 test/corpus_driver.py "" 1 30 "$SUITE/3 Logarithms" 0 "" 0 "$W/$1-c3.out" < /dev/null > /dev/null 2>&1
  python3 test/corpus_driver.py "" 1 30 "$SUITE/5 Inverse trig functions" 0 "" 0 "$W/$1-c5.out" < /dev/null > /dev/null 2>&1
  python3 test/corpus_driver.py "" 1 30 "$SUITE/6 Hyperbolic functions" 0 "" 0 "$W/$1-c6.out" < /dev/null > /dev/null 2>&1
  python3 test/corpus_driver.py "" 1 30 "$SUITE/7 Inverse hyperbolic functions" 0 "" 0 "$W/$1-c7.out" < /dev/null > /dev/null 2>&1
  python3 test/corpus_driver.py "" 1 30 "$SUITE/8 Special functions" 0 "" 0 "$W/$1-c8.out" < /dev/null > /dev/null 2>&1
}
MR_RULES_CORE_PATH="$W/base/test/mr_rules.core" slices base
slices new
python3 test/corpus_driver.py "" 2 30 "$SUITE/4 Trig functions" 0 "" 0 "$W/new-c4.out" < /dev/null > /dev/null 2>&1
{
  echo "# class-4 Step-7 slice A/B, $(date -u '+%F %T UTC')"
  echo "# base core: $(grep -h '^built\|rules=' "$W/base-build.log" | tail -1)"
  echo "# new core:  $(grep -h '^rules\|^fingerprint' test/mr_rules.core.stamp | tr '\n' ' ')"
  for c in c1 c2 c3 c5 c6 c7 c8; do
    echo; echo "######## $c: base 9dd5f16 core vs the class-4 core"
    python3 test/ab_records.py "$W/base-$c.out" "$W/new-$c.out" --all
  done
  echo; echo "######## class 4, 2 per file, the class-4 core"
  grep -v '^maxima:' "$W/new-c4.out"
} > "$OUT"
rm -f "$W/base/reference"
git worktree remove --force "$W/base"
rm -rf "$W"
echo "wrote $OUT"
