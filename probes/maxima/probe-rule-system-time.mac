/* probes/maxima/probe-rule-system-time.mac — T2 route-A per-match cost,
 * *2026-08-17.
 *
 * The `time` function is unbound in the 5.49-series build, so this
 * probe does the raw repeated matching (2 x 100000 trials) and the shell driver
 * (.run) measures wall clock, subtracts one startup-only run, and
 * reports ms per match.
 *
 * Run via:  sh probes/maxima/probe-rule-system-time.run
 */

matchdeclare(a, lambda([e], e # 0 and freeof(x, e)), b, freeof(x))$
matchdeclare(c, true)$
matchdeclare(d, true)$
matchdeclare(n, true)$
defmatch(prod12, (a + b*x)^2*(c + d*x)^n, x)$
trials: 100000$
acc: 0$
for i: 1 thru trials do acc: acc + (if prod12((1 + 2*x)^2*(3 + 4*x)^(k + 1), x) # false then 1 else 0)$
disp(concat("MATCHED ", string(acc), " of ", string(trials)))$
acc2: 0$
for i: 1 thru trials do acc2: acc2 + if prod12((a1 + b1*x)^(m1)*(c1 + d1*x)^(n1) + x^11, x) # false then 1 else 0$
disp(concat("NONMATCHED ", string(trials - acc2), " of ", string(trials)))$
