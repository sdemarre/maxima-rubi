printf(true,"log(logarg) via abs+atan2=~a~%",lz_principal)
log(logarg) via abs+atan2=-(0.5103742042791239*%i)
printf(true,"log() minus principal=~a~%",float(rectform(lz-lz_principal)))
log() minus principal=6.283185307179586*%i
printf(true,"DONE~%")
