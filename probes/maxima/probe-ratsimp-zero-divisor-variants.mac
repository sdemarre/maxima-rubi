/* probe-ratsimp-zero-divisor-variants.mac — the constant pairs in the
   minimal repro (probe-ratsimp-zero-divisor.mac) are exactly the
   (integer part, sqrt(3) coefficient) of unit powers in Q(sqrt(3)):
     2*(2+sqrt(3))^7 = 10084 + 5822*sqrt(3)
     (2+sqrt(3))^8   = 18817 + 10864*sqrt(3)
   (identity measured 2026-08-28). This sweep checks whether the
   crash tracks the specific pairs or any large integers:
   V1 original pairs            -> RED (crashes; the committed probe)
   V2 18817 -> 18818 (neighbor) -> green expected
   V3 10084 -> 10085 (neighbor) -> green expected
   V4 both neighbors            -> green expected
   V5 successor unit powers     -> pairs (37634,21728) = 2*(2+sqrt(3))^8
                                   and (70226,40545) = (2+sqrt(3))^9
   V6 the two pairs swapped between the t1/t2 and t3/t4 positions
   V7 k=6 of the unit-power pattern (2702,1560) (5042,2911)
   V8 k=9 of the unit-power pattern (140452,81090) (262087,151316)
   Maxima 5.50.0 (build 2026-08-20 21:36:22), SBCL 2.6.7.
   RED = errcatch(ratsimp(...)) = [] (the `quotient' by `zero' crash);
   a fix upstream would flip RED rows to their simplified values. */
 t1p(i, j) := (3^(1/4)*(2-sqrt(3))*sqrt(sqrt(3)+2)*(j*sqrt(3)-i))
     /(2*(sqrt(3)-2)*sqrt(x+2)*((3^(1/4)*sqrt(2-sqrt(3))*sqrt(x+2)+sqrt(2-sqrt(3))*sqrt(sqrt(3)+2))^2/(sqrt(3)-2)^2+1))$
 t2p(i, j) := (3^(1/4)*(2-sqrt(3))*sqrt(sqrt(3)+2)*(j*sqrt(3)-i))
     /(2*(sqrt(3)-2)*sqrt(x+2)*((3^(1/4)*sqrt(2-sqrt(3))*sqrt(x+2)-sqrt(2-sqrt(3))*sqrt(sqrt(3)+2))^2/(sqrt(3)-2)^2+1))$
 t3p(k, l) := ((l*sqrt(3)-k)*((sqrt(3)*sqrt(sqrt(3)+2))/sqrt(x+2)+3^(3/4)))
     /(2*sqrt(3)*sqrt(sqrt(3)+2)*sqrt(x+2)+3^(3/4)*x+2*3^(3/4)+4*3^(1/4))$
 t4p(k, l) := ((k-l*sqrt(3))*(3^(3/4)-(sqrt(3)*sqrt(sqrt(3)+2))/sqrt(x+2)))
     /(-(2*sqrt(3)*sqrt(sqrt(3)+2)*sqrt(x+2))+3^(3/4)*x+2*3^(3/4)+4*3^(1/4))$
 check(name, e) := block([r],
   r : errcatch(ratsimp(e)),
   printf(true, "== ~s: ~a~%", name, if r = [] then "RED" else "green"))$
 /* unit-power identity (measured 2026-08-28) */
 printf(true, "== (2+sqrt(3))^8   : ~a~%", expand((2+sqrt(3))^8))$
 printf(true, "== 2*(2+sqrt(3))^7 : ~a~%", expand(2*(2+sqrt(3))^7))$
 printf(true, "== (2+sqrt(3))^9   : ~a~%", expand((2+sqrt(3))^9))$
 printf(true, "== 2*(2+sqrt(3))^8 : ~a~%", expand(2*(2+sqrt(3))^8))$
 check("V1 original (10084,5822) (18817,10864)",
       t1p(10084, 5822)+t2p(10084, 5822)+t3p(18817, 10864)+t4p(18817, 10864))$
 check("V2 18817->18818",
       t1p(10084, 5822)+t2p(10084, 5822)+t3p(18818, 10864)+t4p(18818, 10864))$
 check("V3 10084->10085",
       t1p(10085, 5822)+t2p(10085, 5822)+t3p(18817, 10864)+t4p(18817, 10864))$
 check("V4 both neighbors",
       t1p(10085, 5822)+t2p(10085, 5822)+t3p(18818, 10864)+t4p(18818, 10864))$
 check("V5 successor unit powers (37634,21728) (70226,40545)",
       t1p(37634, 21728)+t2p(37634, 21728)+t3p(70226, 40545)+t4p(70226, 40545))$
 check("V6 pairs swapped",
       t1p(18817, 10864)+t2p(18817, 10864)+t3p(10084, 5822)+t4p(10084, 5822))$
 /* k-sweep of the unit-power pattern (2*u^k, u^(k+1)), u = 2+sqrt(3):
    k=7: (10084,5822) (18817,10864)  = V1
    k=8: (37634,21728) (70226,40545) = V5
    k=6: 2*(2+sqrt(3))^6 = 2702+1560*sqrt(3); (2+sqrt(3))^7 = 5042+2911*sqrt(3)
    k=9: 2*(2+sqrt(3))^9 = 140452+81090*sqrt(3); (2+sqrt(3))^10 = 262087+151316*sqrt(3) */
 check("V7 k=6 (2702,1560) (5042,2911)",
       t1p(2702, 1560)+t2p(2702, 1560)+t3p(5042, 2911)+t4p(5042, 2911))$
 check("V8 k=9 (140452,81090) (262087,151316)",
       t1p(140452, 81090)+t2p(140452, 81090)+t3p(262087, 151316)+t4p(262087, 151316))$
 printf(true, "== DONE~%")$
