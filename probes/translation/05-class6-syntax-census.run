#!/bin/sh
# probes/translation/05-class6-syntax-census.run — class-6 census driver
# (docs/class-porting.md Step 1(a)).
#
#   sh probes/translation/05-class6-syntax-census.run
cd "$(dirname "$0")/../.." || exit 1
{
  echo "# class-6 rule syntax census, $(date -u +%F)"
  python3 probes/translation/01-class1-syntax-census.py reference/rubi "6 "
} > probes/translation/05-class6-syntax-census.out
echo "wrote probes/translation/05-class6-syntax-census.out"
