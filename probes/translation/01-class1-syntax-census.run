#!/bin/sh
# probes/translation/01-class1-syntax-census.run — T4 census driver.
#
#   sh probes/translation/01-class1-syntax-census.run
cd "$(dirname "$0")/../.." || exit 1
{
  echo "# class-1 rule syntax census, $(date -u +%F)"
  python3 probes/translation/01-class1-syntax-census.py
} > probes/translation/01-class1-syntax-census.out
echo "wrote probes/translation/01-class1-syntax-census.out"
