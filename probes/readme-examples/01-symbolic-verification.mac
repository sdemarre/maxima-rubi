/* probes/readme-examples/01-symbolic-verification.mac -- the README's
   "Examples native integrate does not do": for each integrand f,
     - integrate(f, x) comes back unevaluated (an integrate noun remains),
     - rubi(f, x) answers, and its time,
     - the residual diff(rubi(f, x), x) - f reduces to EXACTLY 0 by a named
       chain of Maxima simplifications (no numeric evaluation).
   From the repo root:
     maxima --very-quiet -b probes/readme-examples/01-symbolic-verification.mac < /dev/null
   Ends with `Results: <n> passed, <m> failed`. */
load("maxima_rubi.mac")$
mr_load_all()$
display2d : false$

/* The chains. Each takes the residual d and returns what it reduces to.
   radcan throughout (user preference 2026-09-26: ratsimp is for rational
   forms, and these residuals carry logs, radicals and special functions);
   no hand-chosen substitution anywhere (2026-09-26). */
ch_radcan(d) := radcan(d)$
ch_trigexpand_radcan(d) := radcan(trigexpand(d))$
ch_exponentialize_radcan(d) := radcan(exponentialize(d))$
/* rectform first: the answer's (-1)^(1/4) constants become (1+%i)/sqrt(2) */
ch_rectform_exponentialize_radcan(d) := radcan(exponentialize(rectform(d)))$
/* demoivre: %e^(2*%i*asin(sqrt(x))) -> cos + %i*sin of 2*asin(sqrt(x));
   trigexpand splits the double angle, and sin(asin(y)) = y,
   cos(asin(y)) = sqrt(1-y^2) simplify automatically */
ch_demoivre(d) := radcan(trigexpand(demoivre(d)))$
/* logarc: asinh(y) -> log(y + sqrt(y^2+1)), so %e^(2*asinh(..)) collapses */
ch_logarc(d) := radcan(logarc(d))$

EX : [
  [1/(x^8+1),                          ch_radcan],
  [sqrt(x^4+1),                        ch_trigexpand_radcan],
  [x/(%e^(2*x)+%e^x-1),                ch_radcan],
  [x/(%e^(2*x)+3*%e^x+3),              ch_radcan],
  [log(x^2/(x^2+1))/(x^2+1),           ch_radcan],
  [1/(x*log(7*x)^2+x*log(7*x)+x),      ch_radcan],
  [1/(sin(x)^4+1),                     ch_rectform_exponentialize_radcan],
  [cos(x)*sec(4*x),                    ch_exponentialize_radcan],
  [asin(sqrt(x))/x,                    ch_demoivre],
  [(x*acot(x))/(x^2+1),                ch_radcan],
  [1/(cosh(x)^4+1),                    ch_exponentialize_radcan],
  [tanh(8*x)^(1/3),                    ch_exponentialize_radcan],
  [asinh(sqrt(x))/x,                   ch_logarc],
  [x/(sqrt(x^2+1)*asinh(x)),           ch_radcan],
  [expintegral_si(2*x)*sin(5*x),       ch_exponentialize_radcan],
  [li[2](1+x)/(2+x),                   ch_radcan]
]$

print(build_info())$
/* Each rubi call is its OWN top-level statement, and each check another:
   rubi leaves the rat package's global kernel list (varlist/genvar)
   populated until the top-level statement ends, and a ratsimp in the same
   statement then fails to close residuals it closes otherwise (measured
   2026-09-26 on 4: 0 kernels before, 8 after; .scratch/rubi-rat-state-leak/
   issues/01). Maxima re-binds that list per top-level statement. */
answer(k) := block([t0 : elapsed_run_time()],
  NI[k] : not freeof(nounify('integrate), integrate(EX[k][1], x)),
  R[k] : rubi(EX[k][1], x),
  T[k] : elapsed_run_time() - t0)$
passed : 0$ failed : 0$
check(k) := block([f : EX[k][1], ch : EX[k][2], z],
  z : apply(ch, [diff(R[k], x) - f]),
  if NI[k] and z = 0 and freeof('unintegrable, R[k])
    then (passed : passed + 1, printf(true, "PASS: "))
    else (failed : failed + 1, printf(true, "FAIL: ")),
  printf(true, "~2d  ~a  integrate unevaluated: ~a  rubi ~,2f s  ~a -> ~a~%",
         k, string(f), NI[k], T[k], ch, string(z)))$
answer(1)$
check(1)$
answer(2)$
check(2)$
answer(3)$
check(3)$
answer(4)$
check(4)$
answer(5)$
check(5)$
answer(6)$
check(6)$
answer(7)$
check(7)$
answer(8)$
check(8)$
answer(9)$
check(9)$
answer(10)$
check(10)$
answer(11)$
check(11)$
answer(12)$
check(12)$
answer(13)$
check(13)$
answer(14)$
check(14)$
answer(15)$
check(15)$
answer(16)$
check(16)$
printf(true, "Results: ~d passed, ~d failed~%", passed, failed)$
