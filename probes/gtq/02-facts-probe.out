%p_val(op,u,v):=block([errormsg:false,r],r:errcatch(is(apply(op,[u,v]))),if r = [] then 'ERR else first(r))
%p_notval(op,u,v):=block([errormsg:false,r],r:errcatch(not is(apply(op,[u,v]))),if r = [] then 'ERR else first(r))
%p_disp(val):=block([errormsg:false,r],if val = 'ERR then "r" else (r:errcatch(is(val) = true),if r # [] and first(r) then "A" else "r"))
%p_tf(b):=if b then "T" else "F"
%p_bad:0
%p_short(s):=if slength(s) > 30 then concat(substring(s,1,28),"..") else s
%p_row(ctx,op,u,v,rubi):=block([iv,nv,f,rr],iv:%p_val(op,u,v),nv:%p_notval(op,u,v),f:%mr_gtq_F(op,u,v),rr:%mr_gtq_R(op,u,v),if not rr = rubi then %p_bad:%p_bad+1,
       printf(true,"~8a ~a~40t ~8a ~8a ~a/~a     ~a ~a ~a  ~a~a~%",ctx,%p_short(concat(op,"(",string(u),", ",string(v),")")),string(iv),string(nv),%p_disp(iv),%p_disp(nv),%p_tf(f),%p_tf(rr),
              %p_tf(rubi),if f = rubi then "" else "F#rubi",if rr = rubi then "" else "  R#rubi(!)"))
