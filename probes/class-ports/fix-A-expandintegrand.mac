/* probes/class-ports/fix-A-expandintegrand.mac -- RUNTIME PATCH (probe only,
   not applied to the tree): %mr_ei_linear_power_at from maxima_rubi_utils.mac
   (4ed1877) with ONE guard added, `not atom(denom(f))`, so a reciprocal
   factor 1/x (denominator an atom) no longer errors in op(denom(f))
   ("part: argument must be a non-atomic expression; found x") and falls
   through to the ExpandExpression catch-all, Rubi :3762. */
%mr_ei_linear_power_at(F, i, x, mode) :=
  block([f, base, ok, L, R, j, rest],
    f : part(F, i),
    ok : false,
    if mode = "power" then (
      if not atom(f) and op(f) = "^"
      then (base : part(f, 1), ok : true)
      else if not atom(f) and op(f) = "/" and is(num(f) = 1)
        and not atom(denom(f)) and op(denom(f)) = "^"
        and integerp(part(denom(f), 2))
        and is(part(denom(f), 2) > 0)
      then (base : part(denom(f), 1), ok : true)
    )
    else if not atom(f) and op(f) # "^"
    then (base : f, ok : true),
    if ok = false then false
    else (
      if %mr_linearQ(base, x) then (
        L : %mr_binomial_parts(base, x),
        if not atom(L) and is(part(L, 3) = 1)
          and %mr_neQ(part(L, 2), 0)
        then (
          R : [],
          for j : 1 thru length(F) do
            if j # i then R : append(R, [part(F, j)]),
          rest : %mr_product_from_list(R),
          if %mr_polynomialQ(rest, x)
          then [f, part(L, 1), part(L, 2), rest]
          else false
        )
        else false
      )
      else false
    ))$
