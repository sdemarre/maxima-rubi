batch("03-eqq-perfect-power-cost.mac")
showtime:false
Px:(d^3*(b*x+a)^7)/b^3+((3*b*c*d^2-3*a*d^3)*(b*x+a)^6)/b^3
                      +((3*a^2*d^3-6*a*b*c*d^2+3*b^2*c^2*d)*(b*x+a)^5)/b^3
                      +((-(a^3*d^3)+3*a^2*b*c*d^2+(-3)*a*b^2*c^2*d+b^3*c^3)
                       *(b*x+a)^4)
                       /b^3
D:Px-(b^(4/7)*d^(3/7)*x+a^(4/7)*c^(3/7))^7
tm(label,e)::=buildq([label,e],
   block([t0:elapsed_run_time(),r],r:e,
         print("STAGE",label,"cpu",elapsed_run_time()-t0,"zero?",is(r = 0),
               "len",slength(string(r))),r))
r0:tm("ratsimp(D)",ratsimp(D))
STAGE ratsimp(D) cpu 2.5299999999999975e-4 zero? false len 511 
print("showratvars",showratvars(r0))
              1/7      1/7      1/7      1/7
showratvars [a   , a, b   , b, c   , c, d   , d, x] 
r1:tm("ratsimp(expand(r0))",ratsimp(expand(r0)))
STAGE ratsimp(expand(r0)) cpu 1.8299999999999914e-4 zero? false len 511 
r2:tm("factor(r1)",factor(r1))
rc 200 cpu 120.070340
