/* probe 04: cheap NONZERO proofs for the probe-03 difference. radcan treats
   a^(1/7) and a as algebraically related (a principal-branch reading); a
   nonzero radcan therefore proves the difference is not IDENTICALLY zero
   (identically zero => zero on the principal branch). Also the same test on
   true perfect powers (must read zero) and on the branch identities the
   %mr_symbolicZeroQ docstring keeps nonzero (radcan reads them zero, which
   is why a radcan ZERO may not be taken as conclusive -- only nonzero). */
Px : (d^3*(b*x+a)^7)/b^3+((3*b*c*d^2-3*a*d^3)*(b*x+a)^6)/b^3+((3*a^2*d^3-6*a*b*c*d^2+3*b^2*c^2*d)*(b*x+a)^5)/b^3+((-(a^3*d^3)+3*a^2*b*c*d^2-3*a*b^2*c^2*d+b^3*c^3)*(b*x+a)^4)/b^3$
D : Px - (b^(4/7)*d^(3/7)*x+a^(4/7)*c^(3/7))^7$
tm(label, e) ::= buildq([label, e], block([t0 : elapsed_run_time(), r], r : e,
  print("STAGE", label, "cpu", elapsed_run_time() - t0, "zero?", is(r = 0), "len", slength(string(r))), r))$
r0 : tm("ratsimp(D)", ratsimp(D))$
tm("radcan(r0)", radcan(r0))$
/* a true perfect power with symbolic coefficients: Px2 = (a+b*x)^3 expanded;
   the r4 test compares it with (a^(3/3)... ) i.e. Rt(a^3,3) = a */
P2 : expand((a+b*x)^3)$
D2 : P2 - (%mr_rt(a^3, 3) + %mr_rt(b^3, 3)*x)^3$
tm("ratsimp(D2)", ratsimp(D2))$
P3 : expand((2*a+3*b*x)^5)$
D3 : P3 - (%mr_rt(coeff(P3, x, 0), 5) + %mr_rt(coeff(P3, x, 5), 5)*x)^5$
print("D3 kernels", showratvars(ratsimp(D3)))$
tm("ratsimp(D3)", ratsimp(D3))$
tm("radcan(D3)", radcan(D3))$
/* the branch identities: radcan reads them 0 (so only a nonzero radcan is conclusive) */
tm("radcan(sqrt(a*b)-sqrt(a)*sqrt(b))", radcan(sqrt(a*b)-sqrt(a)*sqrt(b)))$
tm("radcan((a*b)^m-a^m*b^m)", radcan((a*b)^m-a^m*b^m))$
