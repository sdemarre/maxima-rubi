batch("17-proposed-checks.green.mac")
%mr_radicalBaseQ(b):=%mr_isVarSym(b) or ratnump(b) and b > 0
%mr_radicalVarKernelQ(k):=%mr_isVarSym(k)
                       or not atom(k) and op(k) = 'sqrt
                                      and %mr_radicalBaseQ(part(k,1))
                       or not atom(k) and op(k) = "^"
                                      and %mr_radicalBaseQ(part(k,1))
                                      and ratnump(part(k,2))
%mr_symbolicZeroQ(%mr_eq_d):=block([%mr_eq_r,%mr_eq_c],
                  if atom(%mr_eq_d) or numberp(%mr_eq_d)
                                    or %mr_expanded_polyp(%mr_eq_d) then false
                      else (%mr_eq_r:errcatch(ratsimp(%mr_eq_d)),
                            if %mr_eq_r = []
                                then %mr_zeroChainQ(%mr_eq_d,%mr_eq_d)
                                else (if %mr_b(part(%mr_eq_r,1) = 0) then true
                                          else (if 
                                          errcatch(
                                           every(%mr_isVarSym,
                                                 showratvars(
                                                  part(%mr_eq_r,1))))
                                            = [true] then false
                                           else (if 
                                           errcatch(
                                            every(%mr_radicalVarKernelQ,
                                                  showratvars(
                                                   part(%mr_eq_r,1))))
                                             = [true]
                                             and (
                                             %mr_eq_c
                                              :errcatch(
                                               radcan(part(%mr_eq_r,1))),
                                             %mr_eq_c # []
                                               and not %mr_b(
                                               part(%mr_eq_c,1) = 0))
                                            then false
                                            else %mr_zeroChainQ(
                                            %mr_eq_d,part(%mr_eq_r,1)))))))
%mr_pseudoRoot(u,n):=block([],
               if n = 2 then sqrt(u)
                   else (if oddp(n) and %mr_rt_ltQ(u) then -(-u)^(1/n)
                             else u^(1/n)))
display2d:false
linel:400
mr_pc_pass:0
mr_pc_fail:0
pc(label,got,want):=if is(got = want) then (mr_pc_pass:mr_pc_pass+1,print("PASS:",label)) else (mr_pc_fail:mr_pc_fail+1,print("FAIL:",label,"got",got,"want",want))
pct(label,expr_val,want,t,lim):=pc(sconcat(label," (",t," s <= ",lim," s)"),is(expr_val = want and t <= lim),true)
ex(e)::=buildq([e],block([t0:elapsed_run_time(),r],r:e,[r,elapsed_run_time()-t0]))
pc("identically zero, symbolic coefficients (issue 03 witness)",%mr_eqQ(c*d^3*e-d*e*(c*d^2+a*e^2)+a*d*e^3,0),true)
PASS: identically zero, symbolic coefficients (issue 03 witness) 
pc("a true perfect power reads zero (1_4_1 r4 witness)",%mr_eqQ(expand((a+b*x)^3),(%mr_rt(a^3,3)+%mr_rt(b^3,3)*x)^3),true)
PASS: a true perfect power reads zero (1_4_1 r4 witness) 
pc("a branch identity stays nonzero (Rubi's EqQ False)",%mr_eqQ(sqrt(a*b),sqrt(a)*sqrt(b)),false)
PASS: a branch identity stays nonzero (Rubi's EqQ False) 
pc("a parameter-dependent zero stays nonzero",%mr_eqQ(a*b*c,0),false)
PASS: a parameter-dependent zero stays nonzero 
pc("pseudoRoot(d^9, 9) carries no conditional",freeof("if",%mr_pseudoRoot(d^9,9)) and freeof('unknown,%mr_pseudoRoot(d^9,9)),true)
PASS: pseudoRoot(d^9, 9) carries no conditional 
block([r],r:ex(%mr_eqQ(expand((a+b*x)^4*(c+d*x)^3),(%mr_rt(a^4*c^3,7)+%mr_rt(b^4*d^3,7)*x)^7)),pct("1_4_1 r4 test of (a+b*x)^4*(c+d*x)^3 is false and cheap (1.1.1.2 e1259)",r[1],false,r[2],2))
PASS: 1_4_1 r4 test of (a+b*x)^4*(c+d*x)^3 is false and cheap (1.1.1.2 e1259) (0.0013740000000000002 s <= 2 s) 
block([r],r:ex(%mr_eqQ((2*c*x+b)*(c*x^2+b*x+a)^3,(2^(1/7)*c^(4/7)*x+a^(3/7)*b^(1/7))^7)),pct("numeric-radical kernel 2^(1/7) is false and cheap (2.3 e620)",r[1],false,r[2],2))
PASS: numeric-radical kernel 2^(1/7) is false and cheap (2.3 e620) (6.340000000000026e-4 s <= 2 s) 
print(sconcat("Results: ",mr_pc_pass," passed, ",mr_pc_fail," failed"))
Results: 7 passed, 0 failed 
