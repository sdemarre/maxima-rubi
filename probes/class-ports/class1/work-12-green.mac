load("/home/serge/src/mr-attr/probes/class-ports/class1/values_trim.lisp")$
/* probes/class-ports/class1/fix-E-eqq-algebraic.mac -- CANDIDATE FIX E (probe
   overlay, not applied to the tree): EqQ / NeQ decide a difference that is
   algebraically zero but not syntactically so. The shipping %mr_eqQ is
   is(u - v = 0) on the simplified difference (maxima_rubi_utils.mac L398),
   so 4 (1-sqrt 3)^3 - 8 (5 - 3^(3/2)) and (a e^3 - c d^2 e) - e (a e^2 - c d^2)
   read as nonzero. Rubi's EqQ is PossibleZeroQ[u - v]: here the rational
   zero test with algebraic:true (radicals reduced), after the cheap
   syntactic test. */
%mr_eqQ(u, v) := block([%mr_eq_d : u - v],
  if is(%mr_eq_d = 0) then true
  else is(block([algebraic : true], ratsimp(%mr_eq_d)) = 0))$
%mr_neQ(u, v) := not %mr_eqQ(u, v)$
/* probes/class-ports/class1/12-proposed-layerA-checks.mac -- proposed Layer-A
   checks for the class-1 PASS->FAIL attribution of the class 8/5/7/4 ports.
     V: the rule-record globals _mr_rule_<key>_r<n> are not in Maxima's
        `values` infolist (fix V: values_trim.lisp's filter, run once at the
        end of mr_load_all / after each %mr_load_sibling); they stay BOUND.
     E: EqQ / NeQ decide an algebraically-zero difference (fix E:
        fix-E-eqq-algebraic.mac).
   RED on the class-ports core as is; GREEN with values_trim.lisp and
   fix-E-eqq-algebraic.mac loaded first. Run through run_text.py:
     python3 probes/class-ports/run_text.py test/mr_rules.core 120 FILE */
tests_passed : 0$
tests_failed : 0$
check(test_name, actual, expected) := block([],
  if actual = expected then (tests_passed : tests_passed + 1, print("  PASS: ", test_name))
  else (tests_failed : tests_failed + 1, print("  FAIL: ", test_name),
        print("    expected: ", expected), print("    actual:   ", actual)), true)$
check_bool(test_name, actual) := block([v],
  v : is(actual),
  if v = true then (tests_passed : tests_passed + 1, print("  PASS: ", test_name))
  else (tests_failed : tests_failed + 1, print("  FAIL: ", test_name), print("    actual:   ", actual)), true)$

/* V: every binding of a globally unbound variable (each cond/repl call's mm,
   x and block locals) scans `values` twice (MSET -> ADD2LNC, MUNBIND ->
   DELETE; mlisp.lisp L518-594, L2523). */
check("V1 no _mr_rule_* global in values after mr_load_all",
  length(sublist(values, lambda([s], symbolp(s) and is(ssearch("_mr_rule_", string(s)) = 1)))), 0)$
check_bool("V2 the rule-record globals stay bound (test_rule_table_order reads them)",
  integerp(_mr_rule_1_4_1_r7) and integerp(_mr_rule_9_3_r63))$
check_bool("V3 values holds fewer than 1000 entries after mr_load_all",
  length(values) < 1000)$

/* E: Rubi EqQ is PossibleZeroQ[u - v]. */
check_bool("E1 %mr_eqQ(4*(1-sqrt(3))^3 - 8*(5-3^(3/2)), 0)",
  %mr_eqQ(4*(1-sqrt(3))^3 - 8*(5-3^(3/2)), 0))$
check_bool("E2 not %mr_neQ(q*p*(r^2-s) - p*(q*r^2-q*s), 0)",
  not %mr_neQ(q*p*(r^2-s) - p*(q*r^2-q*s), 0))$
check_bool("E3 1_1_3_7 r28 (Rubi 1.1.3.7 L32, EllipticE) accepts a=1, b=4, c=1-sqrt(3), d=4^(1/3)",
  _mr_cond_1_1_3_7_r28([_mr_1_1_3_7_r28_a = 1, _mr_1_1_3_7_r28_b = 4,
                        _mr_1_1_3_7_r28_c = 1-sqrt(3), _mr_1_1_3_7_r28_d = 4^(1/3)], x))$
check_bool("E4 1_1_1_2 r37 declines b c - a d = 0 written unexpanded",
  not _mr_cond_1_1_1_2_r37([_mr_1_1_1_2_r37_a = p, _mr_1_1_1_2_r37_b = q,
                            _mr_1_1_1_2_r37_c = p*(r^2-s), _mr_1_1_1_2_r37_d = q*r^2-q*s,
                            _mr_1_1_1_2_r37_m = -1/2, _mr_1_1_1_2_r37_n = -1], x))$
check_bool("E5 rubi(x^3/((1-x)^(1/3)*(2-x)^(1/3)), x) (1.1.1.3 e864) carries no unintegrable",
  freeof(unintegrable, rubi(x^3/((1-x)^(1/3)*(2-x)^(1/3)), x)))$
print(concat("Results: ", tests_passed, " passed, ", tests_failed, " failed"))$
