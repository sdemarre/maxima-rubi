/* probes/class-ports/class1/09-unverified-numeric.mac -- 1.1.1.5 e14 and
   1.2.1.2 e2005 answer `unverified` on the class-ports core: is the answer
   WRONG, or right in a form the zero chain cannot close? d/dx(answer) -
   integrand at two numeric points (parameters positive, real branch). */
chk(mr_f, mr_pts) := block([mr_r, mr_d],
  mr_r : rubi(mr_f, x),
  mr_d : diff(mr_r, x) - mr_f,
  print("ANSWER-LEN", slength(string(mr_r)), "UNINT", not freeof(unintegrable, mr_r)),
  for mr_p in mr_pts do print("  RESID at", mr_p, errcatch(float(rectform(ev(mr_d, mr_p, numer))))))$
chk((A+B*x+C*x^2+D*x^3)/((a+b*x)*(c+d*x)^(3/2)),
    [[A=1.3,B=0.7,C=2.1,D=0.4,a=1.1,b=0.6,c=2.3,d=0.9,x=0.8],
     [A=0.2,B=1.7,C=0.5,D=1.4,a=2.1,b=1.6,c=0.3,d=1.9,x=1.8], [A=0.5,B=0.3,C=1.2,D=0.8,a=0.7,b=1.3,c=1.5,d=0.4,x=0.6]])$
chk(1/((d+e*x)^(1/2)*(a*d*e+(c*d^2+a*e^2)*x+c*d*e*x^2)),
    [[a=1.1,c=0.6,d=2.3,e=0.9,x=0.8], [a=2.1,c=1.6,d=0.3,e=1.9,x=1.8]])$
