/* probes/class-ports/class1/02-r107.mac -- the sub-integral of the 1.1.1.3
   e863..e870 family on which the two cores part: 1_1_3_2 r107's condition. */
rubi_verbose : true$
r1 : rubi((4^(1/3)*x)/sqrt(4*x^3+1), x);
print("UNINT1", not freeof(unintegrable, r1));
r2 : rubi(x/sqrt(4*x^3+1), x);
print("UNINT2", not freeof(unintegrable, r2));
