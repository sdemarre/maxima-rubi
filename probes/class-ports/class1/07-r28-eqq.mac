/* probes/class-ports/class1/07-r28-eqq.mac -- 1_1_3_7 r28's (Rubi 1.1.3.7
   L32, the EllipticE rule) condition on the chain's bindings a=1, b=4,
   c=1-sqrt(3), d=4^(1/3): b c^3 - 2 (5-3 sqrt 3) a d^3 is 0. */
e : 4*(1-sqrt(3))^3 - 2*(5-3*sqrt(3))*1*(4^(1/3))^3;
print("EXPAND", expand(e), "EQQ", %mr_eqQ(e, 0), "NEQ", %mr_neQ(e, 0), "POSQ-a", %mr_posQ(1))$
errcatch(_mr_repl_1_1_3_7_r29([_mr_1_1_3_7_r29_a = 1, _mr_1_1_3_7_r29_b = 4, _mr_1_1_3_7_r29_c = 1-sqrt(3), _mr_1_1_3_7_r29_d = 4^(1/3)], x));
