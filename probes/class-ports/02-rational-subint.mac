/* probes/class-ports/02-rational-subint.mac -- the SubstFor sub-integrals
   that 9_3 r67 gives up on in the 6.7.1 / 6.3.7 / 6.5.7 family. */
print("A", rubi((x^2-1)/x, x))$
print("B", rubi(((b*(x^2-1))/x^2+a)/x, x))$
print("C", rubi((x^4-2*x^2+1)/x^4, x))$
print("D", rubi((b/x^2+a)/x, x))$
print("E", rubi(x - 1/x, x))$
