batch("probes/leaf-size/08-classify-remaining-i.mac")
logexpand:false
radexpand:false
trighyp_ops:[sin,cos,tan,cot,sec,csc,sinh,cosh,tanh,coth,sech,csch]
invtrig_ops:[asin,acos,atan,acot,asec,acsc,asinh,acosh,atanh,acoth,asech,
             acsch,atan2]
elliptic_ops:[elliptic_f,elliptic_e,elliptic_pi,elliptic_kc,elliptic_ec]
ctx(e):=if e = %i then [bare]
     else (if atom(e) or freeof(%i,e) then []
               else block([o:op(e)],
                          if member(o,trighyp_ops)
                              then (if freeof(%pi,args(e)) then [trigarg]
                                        else [pishift])
                              else (if member(o,elliptic_ops) then [elliptic]
                                        else (if o = log then [log]
                                                  else (if 
                                                  member(o,invtrig_ops)
                                                   then [invtrig]
                                                   else (if 
                                                   o = "^"
                                                     and not integerp(
                                                     second(args(e)))
                                                     and not freeof(
                                                     %i,first(args(e)))
                                                    then append([fracpow],
                                                                ctx(
                                                                 second(
                                                                  args(e))))
                                                    else (if 
                                                    member(o,
                                                           ["+","*","^","-",
                                                            "/"])
                                                     then apply(append,
                                                                map(ctx,
                                                                    args(e)))
                                                     else [special])))))))
ctxset(e):=sort(listify(setify(ctx(e))))
lines:block([s:openr("probes/leaf-size/07-remaining-i-answers.out"),l,acc:[]],
            while (l:readline(s)) # false do acc:cons(l,acc),close(s),
            reverse(acc))
label:""
census:[]
single:[]
bump(al,k):=block([p:mr_find(k,al)],
     if p = false then cons([k,1],al)
         else map(lambda([q],if first(q) = k then [k,second(q)+1] else q),al))
mr_find(k,al):=block([r:false],for q in al do if first(q) = k then r:q,r)
for l in lines do
    if slength(l) > 3 and substring(l,1,4) = "## " then label:substring(l,4)
        else (if slength(l) > 7 and substring(l,1,8) = "ANSWER "
                  then block([e:errcatch(parse_string(substring(l,8))),c],
                             c:if e = [] then [parse_error]
                                   else ctxset(first(e)),
                             if c = [] then c:[none],
                             printf(true,"CTX ~a ~a~%",
                                    simplode(map(string,c),","),label),
                             census:bump(census,simplode(map(string,c),",")),
                             for k in c do single:bump(single,string(k))))
