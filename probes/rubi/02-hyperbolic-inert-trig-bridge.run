#!/bin/sh
# probes/rubi/02-hyperbolic-inert-trig-bridge.run — settle how Rubi answers
# the class-6 `.7` family (1,173 entries reaching no rule in our port).
# Static analysis over the pinned reference clones + the committed class-6
# record. No Maxima, no Mathematica.
#
#   sh probes/rubi/02-hyperbolic-inert-trig-bridge.run
cd "$(dirname "$0")/../.." || exit 1
python3 probes/rubi/02-hyperbolic-inert-trig-bridge.py \
    > probes/rubi/02-hyperbolic-inert-trig-bridge.out
echo "wrote probes/rubi/02-hyperbolic-inert-trig-bridge.out"
