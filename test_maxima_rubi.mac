/* test_maxima_rubi.mac — Layer A unit suite (diophantine protocol).
 * Gate: maxima --very-quiet -b test_maxima_rubi.mac
 * Ends with "Results: <n> passed, <m> failed"; a mid-run death prints no
 * Results line, which is itself a failure. */
display2d : false$

tests_passed : 0$
tests_failed : 0$

/* actual = expected (equations evaluate in if-conditions, T16). */
check(test_name, actual, expected) := block([],
  if actual = expected then (
    tests_passed : tests_passed + 1,
    print("  PASS: ", test_name)
  ) else (
    tests_failed : tests_failed + 1,
    print("  FAIL: ", test_name),
    print("    expected: ", expected),
    print("    actual:   ", actual)
  ),
  true
)$

/* Three-valued boolean assertion (diophantine item 19): is() gives
   true/false/unknown in this build; unknown is a broken assertion,
   counted as a failure so it cannot hide. */
check_bool(test_name, actual) := block([v],
  v : is(actual),
  if v = true then (
    tests_passed : tests_passed + 1,
    print("  PASS: ", test_name)
  ) elseif v = false then (
    tests_failed : tests_failed + 1,
    print("  FAIL: ", test_name)
  ) else (
    tests_failed : tests_failed + 1,
    print("  FAIL (non-boolean): ", test_name),
    print("    actual:   ", actual)
  ),
  true
)$

check_not(test_name, actual) := block([v],
  v : is(actual),
  if v = false then (
    tests_passed : tests_passed + 1,
    print("  PASS: ", test_name)
  ) elseif v = true then (
    tests_failed : tests_failed + 1,
    print("  FAIL: ", test_name)
  ) else (
    tests_failed : tests_failed + 1,
    print("  FAIL (non-boolean): ", test_name),
    print("    actual:   ", actual)
  ),
  true
)$

test_smoke() := block([],
  print("--- smoke ---"),
  check("smoke equality", 1 + 1, 2),
  check_bool("smoke true", true),
  check_not("smoke false", false),
  true
)$

run_all_tests() := block([],
  test_smoke(),
  test_load_and_api(),
  test_dispatch(),
  test_rules_1_1_1_1_struct(),
  test_pred_cluster1(),
  test_rules_1_1_1_1_behavior(),
  test_census(),
  print(""),
  print("========================================"),
  print("Results: ", tests_passed, " passed, ", tests_failed, " failed"),
  print("========================================"),
  tests_failed = 0
)$

load("maxima_rubi.mac")$

test_load_and_api() := block([r, saved_table],
  print("--- load + API fall-through ---"),
  check_bool("loader witness survived", is(mr_witness_maxima_rubi() = true)),
  /* the 1.1.1.1 rules are loaded, but the %mr_* predicates they guard
     with are undefined until Task 5, so their conds evaluate non-true and
     every call still falls through to Maxima's integrate */
  check("fall-through x^2", rubi(x^2, x), integrate(x^2, x)),
  check("fall-through 5", rubi(5, x), integrate(5, x)),
  /* the fall-through noun is Maxima's own, list-structured */
  r : rubi(sin(x)^x, x),
  check_bool("fall-through noun detect",
             is(atom(r) = false) and is(string(op(r)) = "integrate")),
  /* noun forms are distinct from the fall-through noun */
  check_bool("mr_unintegrable is a noun", is(mr_unintegrable(f, x) = 'unintegrable[f, x])),
  /* empty table -> fall-through. Save/restore the table so a later test
     (Task 3+) is not run against a wiped table (measured landmine 2026-08-20). */
  saved_table : mr_rule_table,
  mr_rule_table : [],
  check_bool("empty table -> noun", is(string(op(rubi(1/x, x))) = "integrate")
             or is(rubi(1/x, x) = log(x))),
  mr_rule_table : saved_table,
    true
)$

/* Non-vacuous dispatch regression test (guards the loop-level-return bug):
   %mr_dispatch must return the FIRING rule's result, not false. Uses
   controlled lambda rules so the result does not depend on any answer
   coinciding with Maxima's own integrate. */
test_dispatch() := block([saved_table],
  print("--- dispatch mechanism (non-vacuous) ---"),
  check("dispatch returns firing rule's result",
        %mr_dispatch(x^2, x, [lambda([f, x], false), lambda([f, x], 42)], 1), 42),
  check("dispatch returns false when no rule fires",
        %mr_dispatch(x^2, x, [lambda([f, x], false)], 1), false),
  check("dispatch: first firing rule wins (order)",
        %mr_dispatch(x^2, x, [lambda([f, x], 42), lambda([f, x], false)], 1), 42),
  /* end-to-end: rubi() must return the firing rule's result, not the
     fall-through (integrate(x^7,x) = x^8/8, not 99) — save/restore the table */
  saved_table : mr_rule_table,
  mr_rule_table : [lambda([f, x], if f = x^7 then 99 else false)],
  check("rubi uses the table (end-to-end, not fall-through)", rubi(x^7, x), 99),
  mr_rule_table : saved_table,
  true
)$

/* The behavioral test of the five rules needs the Task 5 predicates
   (%mr_neQ, %mr_linearQ, %mr_removeContent, …) and lands there; this
   asserts the generated file loaded intact. */
test_rules_1_1_1_1_struct() := block([],
  print("--- generated 1.1.1.1 (structural) ---"),
  check_bool("witness survived", is(mr_witness_1_1_1_1() = true)),
  check("count cross-check", mr_rules_count_1_1_1_1, 5),
  check_bool("table is the file's rules", is(mr_rule_table = mr_rules_1_1_1_1)),
  true
)$

test_pred_cluster1() := block([],
  print("--- predicate cluster 1 ---"),
  /* %mr_coeff: Maxima's coefficient is a noun here; %mr_coeff works */
  check("coeff x^2+2x+1", %mr_coeff(x^2 + 2*x + 1, x, 1), 2),
  check("coeff 3x", %mr_coeff(3*x, x, 1), 3),
  check("coeff missing", %mr_coeff(3*x, x, 2), 0),
  /* %mr_polyQ / %mr_linearQ: degree tests */
  check_bool("polyQ x^2+x", %mr_polyQ(x^2 + x, x)),
  check_not("polyQ 1/x", %mr_polyQ(1/x, x)),
  check_bool("linearQ a+b x", %mr_linearQ(a + b*x, x)),
  check_not("linearQ x^2", %mr_linearQ(x^2, x)),
  /* monic-term regression probes (review bugs A/B: the term walkers
     dropped the bare x term at n = 1 and bare x^n terms whose whole
     is ^-headed — the most common shape in class 1) */
  check("coeff x^2", %mr_coeff(x^2, x, 2), 1),
  check("coeff x^2+2x+1 (x^2)", %mr_coeff(x^2 + 2*x + 1, x, 2), 1),
  check("coeff x", %mr_coeff(x, x, 1), 1),
  check("coeff x+1", %mr_coeff(x + 1, x, 1), 1),
  check_bool("degree x^2", is(%mr_degree(x^2, x) = 2)),
  check_bool("degree x^2+1", is(%mr_degree(x^2 + 1, x) = 2)),
  /* totality: a non-polynomial returns the -1 sentinel, never a boolean */
  check_bool("degree 1/x (total)", is(%mr_degree(1/x, x) = -1)),
  check_bool("polyDegQ x^2+x deg 2", %mr_polyDegQ(x^2 + x, x, 2)),
  /* %mr_polyPowerQ / %mr_polyDegPowerQ (Task 6 Step 0 — Rubi's PolyQ
     power forms, IntegrationUtilityFunctions.m :512/:522/:532). The base
     is an EXPRESSION (x or a capture such as a + b*x): u is a polynomial
     in base^v iff expand(subst(t, base, u)) is a t-polynomial whose term
     exponents are all non-negative multiples of v. */
  check_bool("polyPowerQ x^4+1 in x^2", %mr_polyPowerQ(x^4 + 1, x, 2)),
  check_not("polyPowerQ x^3+1 in x^2", %mr_polyPowerQ(x^3 + 1, x, 2)),
  check_not("polyPowerQ 1/x in x^2", %mr_polyPowerQ(1/x, x, 2)),
  check_bool("polyPowerQ 5 in x^2", %mr_polyPowerQ(5, x, 2)),
  check_bool("polyPowerQ (x^2+1)^2 in x^2", %mr_polyPowerQ((x^2 + 1)^2, x, 2)),
  check_not("polyPowerQ sin(x)+x^4 in x^2", %mr_polyPowerQ(sin(x) + x^4, x, 2)),
  check_bool("polyPowerQ capture base 1+v^4 in v^2", %mr_polyPowerQ(1 + (a + b*x)^4, a + b*x, 2)),
  check_not("polyPowerQ capture base 1+v^3 in v^2", %mr_polyPowerQ(1 + (a + b*x)^3, a + b*x, 2)),
  check_bool("polyDegPowerQ x^4+1 in x^2 deg 2", %mr_polyDegPowerQ(x^4 + 1, x, 2, 2)),
  check_not("polyDegPowerQ x^4+1 in x^2 deg 1", %mr_polyDegPowerQ(x^4 + 1, x, 2, 1)),
  check_bool("linearQ x", %mr_linearQ(x, x)),
  check_bool("linearQ x+1", %mr_linearQ(x + 1, x)),
  check_bool("linearQ a+x", %mr_linearQ(a + x, x)),
  /* %mr_removeContent: strips the x-free content factor */
  check("removeContent 3(x+1)", ratsimp(%mr_removeContent(3*(x + 1), x)), x + 1),
  /* %mr_sign / posQ / negQ: the pos/neg/pnz mapping */
  check("sign pos", %mr_sign(3), 1),
  check("sign neg", %mr_sign(-3), -1),
  check("sign zero", %mr_sign(0), 0),
  check_bool("posQ a (undecidable -> false)", not %mr_posQ(a)),
  check_bool("posQ 3", %mr_posQ(3)),
  /* %mr_subst: Rubi's back-substitution (Subst[ans, x, u]) */
  check("subst", ratsimp(%mr_subst(x^2/2, x, 2*y)), ratsimp(2*y^2)),
  /* clone-gap equality pair (derived from usage — see clone-gap note) */
  check_bool("possible_zero 0", %mr_possible_zeroQ(0)),
  check_bool("possible_zero (x-x)", %mr_possible_zeroQ(x - x)),
  check_not("possible_zero 5", %mr_possible_zeroQ(5)),
  check_bool("possible_zero a (undecidable)", %mr_possible_zeroQ(a)),
  check_bool("neQ 1 2", %mr_neQ(1, 2)),
  check_not("neQ 1 1", %mr_neQ(1, 1)),
  check_bool("neQ a b (undecidable -> loose true)", %mr_neQ(a, b)),
  check_bool("eqQ a a", %mr_eqQ(a, a)),
  check_not("eqQ 1 2", %mr_eqQ(1, 2)),
  true
)$

test_rules_1_1_1_1_behavior() := block([r],
  print("--- generated 1.1.1.1 (behavioral) ---"),
  /* rule 2: the power rule x^m (m free of x, m # -1) */
  check("x^3", rubi(x^3, x), x^4/4),
  check("5x^2", rubi(5*x^2, x), 5*x^3/3),
  /* rule 1: 1/x -> log(x) */
  check("1/x", rubi(1/x, x), log(x)),
  /* rule 4: (a+b x)^m, m # -1. BRIEF DEVIATION (measured 2026-08-20):
     the brief's expected (1+2x)^4/12 is not an antiderivative —
     ratsimp(diff((1+2x)^4/12, x) - (1+2x)^3)
       = -((8*x^3+12*x^2+6*x+1)/3) # 0,
     while (1+2x)^4/8 closes (diff - integrand -> 0) and equals
     Maxima's own integrate up to a constant. Expected fixed to /8
     (the value rule 4 emits: (a+b x)^(m+1)/(b (m+1))). */
  check("(1+2x)^3", ratsimp(rubi((1 + 2*x)^3, x)), ratsimp((1 + 2*x)^4/8)),
  /* rule 3: 1/(a+b x) -> log(RemoveContent[a+b x, x])/b */
  check("1/(a+b x)", ratsimp(rubi(1/(a + b*x), x)), ratsimp(log(a + b*x)/b)),
  /* rule 5 shape (a+b u)^m, u linear in x. MEASURED (2026-08-20):
     (1 + 2*(3*x))^2 auto-simplifies to (1 + 6*x)^2, which rule 4
     matches directly — and the emitted rule-5 pattern
     (a + b*u)^m (a product of two pattern variables) matches NOTHING
     in this Maxima build (defmatch warning: "will be matched uniquely
     since sub-parts would otherwise be ambiguous"; all probe inputs
     -> false). So this input exercises rule 4, and rule 5 / the
     %mr_subst-via-rule path is NOT exercised end-to-end here
     (%mr_subst itself has a unit probe above). Generator/matcher
     finding — see task-5 report.
     BRIEF DEVIATION (measured): the brief's expected (1+6x)^3/9 is not
     an antiderivative — ratsimp(diff((1+6x)^3/9, x) - (1+6x)^2)
       = 36*x^2+12*x+1 # 0,
     while (1+6x)^3/18 closes to 0. Expected fixed to /18. */
   r : rubi((1 + 2*(3*x))^2, x),
   check_bool("linear base (1+6x)^2", is(ratsimp(r) = ratsimp((1 + 6*x)^3/18))),
  /* NeQ[m, -1]: the m = -1 case must NOT take the power rule (falls to 1/x) */
   check_bool("NeQ guard honored", is(rubi(1/x, x) = log(x))),
   true
)$

/* Census cross-check (T6 Step 4). BRIEF DEVIATION (measured 2026-08-20,
   probes/load_wall/probe-load-wall.out, build
   branch_5_49_base_796_g60186bb22_dirty): the brief's global check
   (length(mr_rule_table) = 2710) cannot run in-process on this build —
   the defmatch budget is exhausted partway through file 8 of 67, so
   2710 patterns cannot be held in one process. The global cross-check
   lives in the static probe probes/census/01-generation-vs-inventory
   (generator per-file counts vs the T1 inventory, all 67 files, total
   2710). Here: the loadable spot checks — 1.1.1.2 (count 40, the T1
   inventory per-file number) loaded with the table saved/restored,
   plus the core count re-verified. */
test_census() := block([saved_table],
  print("--- census cross-check (loadable subset; see docstring) ---"),
  saved_table : mr_rule_table,
  %mr_load_sibling("rules/class1/1_1_1_2.mac", 'mr_witness_1_1_1_2),
  check("1.1.1.2 count = 40 (T1 inventory)", mr_rules_count_1_1_1_2, 40),
  check_bool("1.1.1.2 witness survived", is(mr_witness_1_1_1_2() = true)),
  check("core 1.1.1.1 count still 5", mr_rules_count_1_1_1_1, 5),
  check("table (saved core) length 5", length(saved_table), 5),
  mr_rule_table : saved_table,
  true
)$

run_all_tests();
quit();
