/* test_maxima_rubi.mac — Layer A unit suite (diophantine protocol).
 * Gate: maxima --very-quiet -b test_maxima_rubi.mac
 * Ends with "Results: <n> passed, <m> failed"; a mid-run death prints no
 * Results line, which is itself a failure. */
display2d : false$

tests_passed : 0$
tests_failed : 0$

/* actual = expected (equations evaluate in if-conditions, T16). */
check(test_name, actual, expected) := block([],
  if actual = expected then (
    tests_passed : tests_passed + 1,
    print("  PASS: ", test_name)
  ) else (
    tests_failed : tests_failed + 1,
    print("  FAIL: ", test_name),
    print("    expected: ", expected),
    print("    actual:   ", actual)
  ),
  true
)$

/* Three-valued boolean assertion (diophantine item 19): is() gives
   true/false/unknown in this build; unknown is a broken assertion,
   counted as a failure so it cannot hide. */
check_bool(test_name, actual) := block([v],
  v : is(actual),
  if v = true then (
    tests_passed : tests_passed + 1,
    print("  PASS: ", test_name)
  ) elseif v = false then (
    tests_failed : tests_failed + 1,
    print("  FAIL: ", test_name)
  ) else (
    tests_failed : tests_failed + 1,
    print("  FAIL (non-boolean): ", test_name),
    print("    actual:   ", actual)
  ),
  true
)$

check_not(test_name, actual) := block([v],
  v : is(actual),
  if v = false then (
    tests_passed : tests_passed + 1,
    print("  PASS: ", test_name)
  ) elseif v = true then (
    tests_failed : tests_failed + 1,
    print("  FAIL: ", test_name)
  ) else (
    tests_failed : tests_failed + 1,
    print("  FAIL (non-boolean): ", test_name),
    print("    actual:   ", actual)
  ),
  true
)$

/* binds(mm, [name = value, ...]): mm is a binding list (not false) and
   geteqR finds every name bound to its value — the idiom for
   %mr_rule_bindings / %mr_rule_accept / %mr_matchQ_bindings results
   (matcher substrate). */
binds(mm, eqs) := listp(mm)
  and every(lambda([q], is(geteqR(mm, lhs(q)) = rhs(q))), eqs)$

test_smoke() := block([],
  print("--- smoke ---"),
  check("smoke equality", 1 + 1, 2),
  check_bool("smoke true", true),
  check_not("smoke false", false),
  true
)$

run_all_tests() := block([],
  test_smoke(),
  test_load_and_api(),
  test_dispatch(),
  test_rules_1_1_1_1_struct(),
  test_pred_cluster1(),
  test_numeric_predicates(),
  test_structural_predicates(),
    test_matchQ_predicates(),
    test_class2_marker_head(),
    test_generated_matchq_shapes(),
     test_class3_headvar(),
     test_class3_b1_freeof(),
     test_class3_b2_linearQ(),
      test_class3_b4_derDiv(),
       test_class3_c2_dhead(),
        test_class3_c1_slotted(),
         test_class3_c4_321(),
         test_class3_c3_ratio(),
           test_class3_b3_33(),
           test_class3_c5_34(),
            test_class3_c6_cassimp(),
            test_class3_c6b_functionoflog(),
            test_int_family_predicates(),
  test_sum_simpler_predicates(),
  test_cluster_d_predicates(),
  test_cluster_e_predicates(),
  test_cluster_f_predicates(),
  test_cluster_g_shims(),
  test_cluster_h_shims(),
  test_cluster_i_expandIntegrand(),
  test_cluster_j_shims(),
  test_cluster_k_shims(),
  test_cluster_l_powered_form(),
  test_class2_cluster_a(),
  test_class2_cluster_b(),
  test_class2_cluster_c(),
  test_class2_census(),
  test_class3_cluster_a(),
  test_class3_cluster_b(),
  test_class6_cluster_a(),
  test_class6_cluster_b(),
  test_class6_cluster_c(),
  test_rules_1_1_1_1_behavior(),
  test_translation_fixes_seen(),
  test_run_switches(),
  test_seen_cut_fallthrough(),
  test_expand_expression(),
  test_translation_fixes_generator(),
  test_translation_fixes_posaux(),
  test_inert_trig_rewrites(),
  test_inert_trig_reduce_powersum(),
  test_deactivate_trig(),
  test_function_of_trig_of_linear(),
  test_function_of_q(),
  test_inert_bridge(),
  test_try_pure_tan_subst(),
  test_weierstrass(),
  test_inert_leak_guard(),
  test_inert_giveup(),
  test_class4_with_capture(),
  test_mr_sum_capture(),
  test_with_local_capture_all(),
  test_section9_unsameQ(),
  test_section9_g1(),
  test_section9_g2a(),
  test_section9_g2b(),
  test_section9_g3(),
  test_section9_g4(),
  test_section9_g5(),
  test_section9_g6a(),
  test_section9_g6b(),
  test_section9_condassign(),
  test_class8_cluster_a(),
  test_class8_cluster_b(),
  test_class8_cluster_c(),
  test_class8_e2e(),
  test_class5_cluster_a(),
  test_class5_cluster_b(),
  test_class5_e2e(),
  test_class7_e2e(),
  test_class4_cluster_a(),
  test_census(),
  print(""),
  print("========================================"),
  print("Results: ", tests_passed, " passed, ", tests_failed, " failed"),
  print("========================================"),
  tests_failed = 0
)$

load("maxima_rubi.mac")$

/* Layer A measures what the RULES compute. For the cluster and corpus
   checks below that includes the nested integrate fall-through the
   expected answers were built with: a reduction whose sub-integral Maxima
   finishes is still the rule set's answer. The rules-only default
   (mr_nested_fallback false, exact seen test design 3.3) is a RUN
   parameter — it decides what a corpus run reports, not what the rules
   compute — so the suite binds the fall-through on and captures the
   default for test_run_switches() to assert. Measured 2026-09-16: without
   this binding 22 pre-existing behavioural checks (b1 e275, b2 e156, c1,
   c3, c4, c5, b3, c6b e134/e139/e258, the intSum fallback) and the exact
   seen test's own fall-through check answer the unintegrable noun instead.
   test/test_run_records.py holds the defmvar and the driver's
   SWITCH_DEFAULTS in step. */
mr_default_nested_fallback : mr_nested_fallback$
mr_nested_fallback : true$
/* Captured for the same reason, before any section flips it. */
mr_default_giveup_last : mr_giveup_last$

test_load_and_api() := block([r, saved_table],
  print("--- load + API fallback gate ---"),
  check_bool("loader witness survived", is(mr_witness_maxima_rubi() = true)),
  /* Tail rule lists (inert-trig substrate design 3.3). A bare-u_ record
   * sits at the END of mr_rule_table, because our dispatcher walks in
   * load order and stops at the first rule that answers (Mathematica
   * orders it last by pattern specificity instead).
   *
   * IMPORTANT (fix round 1, ledger R21): this suite never calls
   * mr_load_all() -- later Layer A targets depend on the rule table's
   * contents at their point in the suite, so it must not run here -- and
   * so this target only ever sees the EAGER MILESTONE-1 CORE STAND-IN
   * (body = mr_rules_1_1_1_1, tail = [], set at maxima_rubi.mac's top
   * level for exactly this reason). It is therefore permanently vacuous
   * on the real table mr_load_all() builds: both handle lists exist, the
   * body list is non-empty, and every tail handle (vacuously none, since
   * the stand-in's tail is always []) is greater than every body handle.
   * The real table's ordering -- including the universal bare-u_
   * cross-check over every loaded rule -- is gated OUTSIDE Layer A by
   * test/test_rule_table_order.mac (AGENTS.md, "Rule-table order"). */
  check_bool("tail records are last in the table (eager-core stand-in only -- test/test_rule_table_order.mac gates the real table)",
    listp(mr_rule_table_body_handles) and listp(mr_rule_table_tail_handles)
    and length(mr_rule_table_body_handles) > 0
    and every(lambda([mr_h], is(mr_h > lmax(mr_rule_table_body_handles))),
              mr_rule_table_tail_handles)),
  /* 5 fires no class-1 rule with the full table (measured 2026-08-24 —
     the 1.1.1.1 family is (a+b x)^m / x^m / 1/x forms only; x^2 DOES
     fire rule r2), so it exercises the two top-level fall-throughs
     directly. The default (2-arg) rubi is rules-only: a 0-firing
     returns the no-answer noun, not Maxima's integrate; rubi_fallback
     with fb = true restores the status-quo integrate fall-through. */
  check_bool("default off: constant -> unintegrable noun",
             is(rubi(5, x) = mr_unintegrable(5, x))),
  check("fallback on: rubi_fallback(5, x, true)",
        rubi_fallback(5, x, true), integrate(5, x)),
  /* the no-fallback noun is the package's own, list-structured */
  r : rubi(sin(x)^x, x),
  check_bool("no-fallback noun detect",
             is(atom(r) = false) and is(string(op(r)) = "unintegrable")),
  /* noun forms are distinct from the fall-through noun */
  check_bool("mr_unintegrable is a noun", is(mr_unintegrable(f, x) = 'unintegrable[f, x])),
  /* empty table -> no rule can fire -> no-answer noun (default off).
     Save/restore the table so a later test (Task 3+) is not run against
     a wiped table (measured landmine 2026-08-20). */
  saved_table : mr_rule_table,
  mr_rule_table : [],
  check_bool("empty table -> noun",
             is(string(op(rubi(1/x, x))) = "unintegrable")),
  mr_rule_table : saved_table,
    true
)$

/* Non-vacuous dispatch regression test (guards the loop-level-return bug):
   %mr_dispatch_tree must return the FIRING rule's result, not false. Uses
   controlled %mr_defrule records (synthetic cond/repl functions) so the
   result does not depend on any answer coinciding with Maxima's own
   integrate; test/matcher/test_mr_dispatch.mac covers the dispatcher's
   outcomes in full. */
t_disp_true(mm, x) := true$
t_disp_false(mm, x) := false$
t_disp_42(mm, x) := 42$
t_disp_7(mm, x) := 7$
t_disp_99(mm, x) := 99$
t_disp_flags(mm, x) := sconcat(radexpand, " ", logexpand)$
test_dispatch() := block([saved_table, pu, hf, h42, h7, h99, hfl],
  print("--- dispatch mechanism (non-vacuous) ---"),
  pu : "(Int (Pattern |_t_u| (Blank)) (Pattern x (Blank Symbol)))",
  hf : %mr_defrule("layerA", 1, pu, t_disp_true, t_disp_false),
  h42 : %mr_defrule("layerA", 2, pu, t_disp_true, t_disp_42),
  h7 : %mr_defrule("layerA", 3, pu, t_disp_true, t_disp_7),
  check("dispatch returns firing rule's result",
        %mr_dispatch_tree(x^2, x, [hf, h42], 1), 42),
  check("dispatch returns false when no rule fires",
        %mr_dispatch_tree(x^2, x, [hf], 1), false),
  check("dispatch: first firing rule wins (order)",
        %mr_dispatch_tree(x^2, x, [h42, h7], 1), 42),
  /* end-to-end: rubi() must return the firing rule's result, not the
     fall-through (integrate(x^7,x) = x^8/8, not 99) — save/restore the table */
  h99 : %mr_defrule("layerA", 4,
                    "(Int (Power (Pattern x (Blank)) 7) (Pattern x (Blank Symbol)))",
                    t_disp_true, t_disp_99),
  saved_table : mr_rule_table,
  mr_rule_table : [h99],
  check("rubi uses the table (end-to-end, not fall-through)", rubi(x^7, x), 99),
  /* mr_model_flags (spec 3.6): mr_top binds radexpand:false and
     logexpand:false around the dispatch while the switch is true */
  hfl : %mr_defrule("layerA", 5,
                    "(Int (Power (Pattern x (Blank)) 7) (Pattern x (Blank Symbol)))",
                    t_disp_true, t_disp_flags),
  mr_rule_table : [hfl],
  mr_model_flags : true,
  check("mr_model_flags true: radexpand, logexpand false inside the dispatch",
        rubi(x^7, x), "false false"),
  mr_model_flags : false,
  check("mr_model_flags false: Maxima defaults inside the dispatch",
        rubi(x^7, x), "true true"),
  mr_model_flags : true,
  check("the flags are restored after mr_top", [radexpand, logexpand], [true, true]),
  mr_rule_table : saved_table,
  true
)$

/* The behavioral test of the five rules needs the Task 5 predicates
   (%mr_neQ, %mr_linearQ, %mr_removeContent, …) and lands there; this
   asserts the generated file loaded intact. */
test_rules_1_1_1_1_struct() := block([],
  print("--- generated 1.1.1.1 (structural) ---"),
  check_bool("witness survived", is(mr_witness_1_1_1_1() = true)),
  check("count cross-check", mr_rules_count_1_1_1_1, 5),
  check_bool("table is the file's rules", is(mr_rule_table = mr_rules_1_1_1_1)),
  true
)$

test_pred_cluster1() := block([],
  print("--- predicate cluster 1 ---"),
  /* %mr_coeff: Maxima's coefficient is a noun here; %mr_coeff works */
  check("coeff x^2+2x+1", %mr_coeff(x^2 + 2*x + 1, x, 1), 2),
  check("coeff 3x", %mr_coeff(3*x, x, 1), 3),
  check("coeff missing", %mr_coeff(3*x, x, 2), 0),
  /* %mr_polyQ / %mr_linearQ: degree tests */
  check_bool("polyQ x^2+x", %mr_polyQ(x^2 + x, x)),
  check_not("polyQ 1/x", %mr_polyQ(1/x, x)),
  check_bool("linearQ a+b x", %mr_linearQ(a + b*x, x)),
  check_not("linearQ x^2", %mr_linearQ(x^2, x)),
  /* monic-term regression probes (review bugs A/B: the term walkers
     dropped the bare x term at n = 1 and bare x^n terms whose whole
     is ^-headed — the most common shape in class 1) */
  check("coeff x^2", %mr_coeff(x^2, x, 2), 1),
  check("coeff x^2+2x+1 (x^2)", %mr_coeff(x^2 + 2*x + 1, x, 2), 1),
  check("coeff x", %mr_coeff(x, x, 1), 1),
  check("coeff x+1", %mr_coeff(x + 1, x, 1), 1),
  check_bool("degree x^2", is(%mr_degree(x^2, x) = 2)),
  check_bool("degree x^2+1", is(%mr_degree(x^2 + 1, x) = 2)),
  /* totality: a non-polynomial returns the -1 sentinel, never a boolean */
  check_bool("degree 1/x (total)", is(%mr_degree(1/x, x) = -1)),
  check_bool("polyDegQ x^2+x deg 2", %mr_polyDegQ(x^2 + x, x, 2)),
  /* %mr_polyPowerQ / %mr_polyDegPowerQ (Task 6 Step 0 — Rubi's PolyQ
     power forms, IntegrationUtilityFunctions.m :512/:522/:532). The base
     is an EXPRESSION (x or a capture such as a + b*x): u is a polynomial
     in base^v iff expand(subst(t, base, u)) is a t-polynomial whose term
     exponents are all non-negative multiples of v. */
  check_bool("polyPowerQ x^4+1 in x^2", %mr_polyPowerQ(x^4 + 1, x, 2)),
  check_not("polyPowerQ x^3+1 in x^2", %mr_polyPowerQ(x^3 + 1, x, 2)),
  check_not("polyPowerQ 1/x in x^2", %mr_polyPowerQ(1/x, x, 2)),
  check_bool("polyPowerQ 5 in x^2", %mr_polyPowerQ(5, x, 2)),
  check_bool("polyPowerQ (x^2+1)^2 in x^2", %mr_polyPowerQ((x^2 + 1)^2, x, 2)),
  check_not("polyPowerQ sin(x)+x^4 in x^2", %mr_polyPowerQ(sin(x) + x^4, x, 2)),
  check_bool("polyPowerQ capture base 1+v^4 in v^2", %mr_polyPowerQ(1 + (a + b*x)^4, a + b*x, 2)),
  check_not("polyPowerQ capture base 1+v^3 in v^2", %mr_polyPowerQ(1 + (a + b*x)^3, a + b*x, 2)),
  check_bool("polyDegPowerQ x^4+1 in x^2 deg 2", %mr_polyDegPowerQ(x^4 + 1, x, 2, 2)),
  check_not("polyDegPowerQ x^4+1 in x^2 deg 1", %mr_polyDegPowerQ(x^4 + 1, x, 2, 1)),
  /* exact degree (Rubi :533 EqQ[Expon,n]): degree strictly less than n is
     false — the <= n over-fire (15 class-1 rules) */
  check_not("polyDegPowerQ x^2+1 in x^2 deg 2 (deg 1 < 2)", %mr_polyDegPowerQ(x^2 + 1, x, 2, 2)),
  check_not("polyDegPowerQ x^2+1 in x^2 deg 5 (deg 1 < 5)", %mr_polyDegPowerQ(x^2 + 1, x, 2, 5)),
  /* zero polynomial: Rubi Expon[0, x^v] = -Infinity, so NO degree form
     holds (the atom-0 term reads as a degree-0 monomial and would
     over-fire at n = 0); a nonzero constant is degree 0 */
  check_not("polyDegPowerQ 0 in x^2 deg 0 (zero poly)", %mr_polyDegPowerQ(0, x, 2, 0)),
  check_bool("polyDegPowerQ 5 in x^2 deg 0", %mr_polyDegPowerQ(5, x, 2, 0)),
  /* captured base (the production call-site shape) */
  check_not("polyDegPowerQ (a+b x)^2+1 in (a+b x)^2 deg 2", %mr_polyDegPowerQ((a + b*x)^2 + 1, a + b*x, 2, 2)),
  check_bool("linearQ x", %mr_linearQ(x, x)),
  check_bool("linearQ x+1", %mr_linearQ(x + 1, x)),
  check_bool("linearQ a+x", %mr_linearQ(a + x, x)),
  /* %mr_removeContent: strips the x-free content factor */
  check("removeContent 3(x+1)", ratsimp(%mr_removeContent(3*(x + 1), x)), x + 1),
  /* %mr_sign / posQ / negQ: the pos/neg/pnz mapping */
  check("sign pos", %mr_sign(3), 1),
  check("sign neg", %mr_sign(-3), -1),
  check("sign zero", %mr_sign(0), 0),
  check_bool("posQ a (PosAux: a symbol is positive)", %mr_posQ(a)),
  check_bool("posQ 3", %mr_posQ(3)),
  /* %mr_subst: Rubi's back-substitution (Subst[ans, x, u]) */
  check("subst", ratsimp(%mr_subst(x^2/2, x, 2*y)), ratsimp(2*y^2)),
  /* clone-gap equality pair (derived from usage — see clone-gap note) */
  check_bool("possible_zero 0", %mr_possible_zeroQ(0)),
  check_bool("possible_zero (x-x)", %mr_possible_zeroQ(x - x)),
  check_not("possible_zero 5", %mr_possible_zeroQ(5)),
  check_bool("possible_zero a (undecidable)", %mr_possible_zeroQ(a)),
  check_bool("neQ 1 2", %mr_neQ(1, 2)),
  check_not("neQ 1 1", %mr_neQ(1, 1)),
  check_bool("neQ a b (undecidable -> loose true)", %mr_neQ(a, b)),
   check_bool("eqQ a a", %mr_eqQ(a, a)),
   check_not("eqQ 1 2", %mr_eqQ(1, 2)),
   true
 )$

/* Task 7a cluster A1 — the explicit-number predicates (Rubi :70 IntegersQ,
   :87 FractionQ, :97 RationalQ). The generator emits 1-arg calls: scalar
   for one Rubi arg, a LIST for several (generate_class1.py :877-884), so
   the ports accept both shapes. Negative rationals are "-" nodes in this
   build (measured 2026-08-23: op(-1/2) = "-"), which the committed
   "/"-only %mr_rationalQ missed. */
test_numeric_predicates() := block([],
  print("--- numeric predicates (integersQ/fractionQ/rationalQ) ---"),
  check_bool("integersQ 3", %mr_integersQ(3)),
  check_bool("integersQ -5", %mr_integersQ(-5)),
  check_bool("integersQ [2, -5]", %mr_integersQ([2, -5])),
  check_not("integersQ 1/2", %mr_integersQ(1/2)),
  check_not("integersQ x", %mr_integersQ(x)),
  check_not("integersQ [2, x]", %mr_integersQ([2, x])),
  check_not("integersQ [1/2, 3]", %mr_integersQ([1/2, 3])),
  check_bool("fractionQ 1/2", %mr_fractionQ(1/2)),
  check_bool("fractionQ -1/2", %mr_fractionQ(-1/2)),
  check_not("fractionQ 2", %mr_fractionQ(2)),
  check_not("fractionQ 1", %mr_fractionQ(1)),
  check_not("fractionQ x", %mr_fractionQ(x)),
  check_bool("rationalQ 3", %mr_rationalQ(3)),
  check_bool("rationalQ 1/2", %mr_rationalQ(1/2)),
  check_bool("rationalQ -1/2", %mr_rationalQ(-1/2)),
  check_not("rationalQ x", %mr_rationalQ(x)),
  check_not("rationalQ (m+1)/2", %mr_rationalQ((m + 1)/2)),
  check_bool("rationalQ [1/2, 3]", %mr_rationalQ([1/2, 3])),
  check_not("rationalQ [x, 3]", %mr_rationalQ([x, 3])),
  check_not("rationalQ [(m+1)/2, 3]", %mr_rationalQ([(m + 1)/2, 3])),
  true
 )$

/* Task 7a cluster A2 — the structural shape predicates (PolynomialQ /
   AtomQ / MonomialQ / LeafCount). PolynomialQ is the STRICT port
   (Mathematica semantics: no cancellation — (x^2+x)/(x+1) is not a
   polynomial even though rat() cancels it to x, measured 2026-08-23),
   in contrast to %mr_polyQ (Rubi's PolyQ) which takes the Together
   route. MonomialQ is the .m usage semantics (a*x^n, n!=0, a!=0 —
   bare x and bare x^k are monomials). LeafCount counts the head as a
   leaf (Mathematica: LeafCount[1+x] = 3). */
test_structural_predicates() := block([],
  print("--- structural predicates (polynomialQ/atomQ/monomialQ/leafCount) ---"),
  check_bool("polynomialQ x^2+x", %mr_polynomialQ(x^2 + x, x)),
  check_bool("polynomialQ x/2", %mr_polynomialQ(x/2, x)),
  check_bool("polynomialQ 5", %mr_polynomialQ(5, x)),
  check_not("polynomialQ 1/x", %mr_polynomialQ(1/x, x)),
  check_not("polynomialQ (x^2+x)/(x+1)", %mr_polynomialQ((x^2 + x)/(x + 1), x)),
  check_not("polynomialQ x+sqrt(x)", %mr_polynomialQ(x + sqrt(x), x)),
  /* quotients with x-free denominators ARE polynomials, at any depth
     (Maxima does not auto-combine x/2 + 1 — measured 2026-08-23) */
  check_bool("polynomialQ x/2+1", %mr_polynomialQ(x/2 + 1, x)),
  check_bool("polynomialQ x*y/2+1", %mr_polynomialQ(x*y/2 + 1, x)),
  check_bool("polynomialQ (x+1)/(y+2)", %mr_polynomialQ((x + 1)/(y + 2), x)),
  check_bool("atomQ x", %mr_atomQ(x)),
  check_bool("atomQ 3", %mr_atomQ(3)),
  check_not("atomQ x+1", %mr_atomQ(x + 1)),
  check_not("atomQ [1,2]", %mr_atomQ([1, 2])),
  check_bool("monomialQ x", %mr_monomialQ(x, x)),
  check_bool("monomialQ x^2", %mr_monomialQ(x^2, x)),
  check_bool("monomialQ 5*x^3", %mr_monomialQ(5*x^3, x)),
  check_bool("monomialQ x*y", %mr_monomialQ(x*y, x)),
  check_bool("monomialQ -3*x", %mr_monomialQ(-3*x, x)),
  check_not("monomialQ 5", %mr_monomialQ(5, x)),
  check_not("monomialQ 3*x+1", %mr_monomialQ(3*x + 1, x)),
  check_not("monomialQ x^2+x", %mr_monomialQ(x^2 + x, x)),
  check_bool("monomialQ x*y^2 (a=y^2, n=1)", %mr_monomialQ(x*y^2, x)),
  check_not("monomialQ (x+1)^2", %mr_monomialQ((x + 1)^2, x)),
  check_not("monomialQ x^(1/x)", %mr_monomialQ(x^(1/x), x)),
  check("leafCount x", %mr_leafCount(x), 1),
  check("leafCount 1+x", %mr_leafCount(1 + x), 3),
  check("leafCount f(x)", %mr_leafCount(f(x)), 2),
  check("leafCount x^2", %mr_leafCount(x^2), 3),
  check("leafCount a+b*x", %mr_leafCount(a + b*x), 5),
  true
 )$

 /* %mr_matchQ (matcher substrate, spec section 3.4):
    %mr_matchQ(u, "<pattern s-expression>", [<parts>], cond) matches u with
    MR-MATCH. Each (MRArg k) in the pattern text is the k-th of the parts —
    the pattern's pattern-free pieces (x, x^2, ...), evaluated at call time —
    and cond is true or a lambda over the binding list, run on every complete
    binding; %mr_matchQ_bindings returns the accepted binding list. The
    patterns are the generated sites' shapes (1.1.2.10 x^m_.*u_., 1.2.2.7
    (f_+g_.*x^2)^r_., 1.4.1 / 9.1 a_+b_.*v_); the expectations follow
    MR-MATCH's Mathematica semantics (plan-2 pre-validation,
    probe_rewrite.mac, 2026-09-13). */
 test_matchQ_predicates() := block([P1, P2, Prb, intm, fr],
   print("--- matchQ (structural matcher) ---"),
   /* binding-list lookup: found / absent (fails closed) */
   check_bool("mk found", is(%mr_mk(_mr_9_r1mq1_m, [_mr_9_r1mq1_m = 3]) = 3)),
   check_not("mk absent", %mr_mk(_mr_9_r9mq9_z, [_mr_9_r1mq1_m = 3])),
   P1 : "(Times (Optional (Pattern |_mr_9_r1mq1_u| (Blank))) (Power (MRArg 1) (Optional (Pattern |_mr_9_r1mq1_m| (Blank)))))",
   intm : lambda([%mr_mqb], integerp(%mr_mk(_mr_9_r1mq1_m, %mr_mqb))),
   check_bool("matchQ x^2 = x^m*u, m integer", %mr_matchQ(x^2, P1, [x], intm)),
   check_bool("matchQ x^2 binds m = 2, u = 1",
              binds(%mr_matchQ_bindings(x^2, P1, [x], intm),
                    ['_mr_9_r1mq1_m = 2, '_mr_9_r1mq1_u = 1])),
   check_bool("matchQ x^3*y = x^m*u, m integer", %mr_matchQ(x^3*y, P1, [x], intm)),
   check_bool("matchQ x^3*y binds m = 3, u = y",
              binds(%mr_matchQ_bindings(x^3*y, P1, [x], intm),
                    ['_mr_9_r1mq1_m = 3, '_mr_9_r1mq1_u = y])),
   /* the bare-power pattern forces m := y, so the cond is false */
   check_not("matchQ cond false after binding (m -> y)",
             %mr_matchQ(x^y, "(Power (MRArg 1) (Pattern |_mr_9_r1mq1_m| (Blank)))", [x], intm)),
   /* MatchQ[5 x^2, x^m_. u_. /; IntegerQ[m]] is True (m = 2, u = 5): the
      coefficient is absorbed by u, so the 1.1.2.10 guard blocks Pq = 5 x^2 */
   check_bool("matchQ 5*x^2 = x^m*u (m=2, u=5)",
              binds(%mr_matchQ_bindings(5*x^2, P1, [x], true),
                    ['_mr_9_r1mq1_m = 2, '_mr_9_r1mq1_u = 5])),
   /* x^2 + x^3 is a Plus: with u at its default x^m_. must match the whole
      sum, and with m at its default x must — neither does (the defmatch-era
      pin u = x^2 + x^3, m = 1 was not Mathematica's reading) */
   check_not("matchQ x^2+x^3 vs x^m*u is false", %mr_matchQ(x^2 + x^3, P1, [x], true)),
   P2 : "(Power (Plus (Pattern |_mr_9_r5mq1_f| (Blank)) (Times (Optional (Pattern |_mr_9_r5mq1_g| (Blank))) (MRArg 1))) (Optional (Pattern |_mr_9_r5mq1_r| (Blank))))",
   fr : lambda([%mr_mqb], freeof(x, %mr_mk(_mr_9_r5mq1_f, %mr_mqb))
                          and freeof(x, %mr_mk(_mr_9_r5mq1_g, %mr_mqb))
                          and freeof(x, %mr_mk(_mr_9_r5mq1_r, %mr_mqb))),
   /* (f_ + g_.*x^2)^r_. at the 1.2.2.7 sites: the power-less base takes r = 1 */
   check_bool("matchQ 3+5x^2 = (f+g x^2)^r, freeofs (r=1)",
              %mr_matchQ(3 + 5*x^2, P2, [x^2], fr)),
   check_not("matchQ trinomial vs (f+g x^2)^r, freeofs",
             %mr_matchQ(3 + 5*x^2 + 7*x^4, P2, [x^2], fr)),
   /* Plus is Flat: without the FreeQ cond f_ takes the run 3 + 7*x^4 */
   check_bool("matchQ trinomial vs (f+g x^2)^r, no cond (f takes a run)",
              %mr_matchQ(3 + 5*x^2 + 7*x^4, P2, [x^2], true)),
   /* a re-occurring pattern variable binds consistently */
   Prb : "(Plus (Pattern |_mr_9_r7mq1_f| (Blank)) (Times (Pattern |_mr_9_r7mq1_f| (Blank)) (MRArg 1)))",
   check_not("matchQ consistent re-binding", %mr_matchQ(3 + 5*x^2, Prb, [x^2], true)),
   check_bool("matchQ consistent re-binding (equal values)",
              %mr_matchQ(3 + 3*x^2, Prb, [x^2], true)),
   /* a_+b_.*v_ at the 1.4.1 / 9.1 sites: v binds a whole sub-expression */
   check_bool("matchQ c+d*y = a+b*v (freeofs)",
              %mr_matchQ(c + d*y,
                         "(Plus (Pattern |_mr_9_r8mq1_a| (Blank)) (Times (Optional (Pattern |_mr_9_r8mq1_b| (Blank))) (Pattern |_mr_9_r8mq1_v| (Blank))))",
                         [],
                         lambda([%mr_mqb], freeof(x, %mr_mk(_mr_9_r8mq1_a, %mr_mqb))
                                           and freeof(x, %mr_mk(_mr_9_r8mq1_b, %mr_mqb))
                                           and freeof(x, %mr_mk(_mr_9_r8mq1_v, %mr_mqb))))),
   /* literals: a part and a number match only themselves; a symbol written
      in the pattern text is a literal, not a wildcard */
   check_bool("matchQ x = x", %mr_matchQ(x, "(MRArg 1)", [x], true)),
   check_not("matchQ y = x", %mr_matchQ(y, "(MRArg 1)", [x], true)),
   check_bool("matchQ 2 = 2", %mr_matchQ(2, "2", [], true)),
   check_not("matchQ 3 = 2", %mr_matchQ(3, "2", [], true)),
   check_not("matchQ literal symbol is not a wildcard", %mr_matchQ(y, "z", [], true)),
   /* power base binds a whole sub-expression */
   check_bool("matchQ (a+b x)^2 = v^2",
              %mr_matchQ((a + b*x)^2, "(Power (Pattern |_mr_9_r12mq1_v| (Blank)) 2)", [], true)),
   check_not("matchQ 3+5x^2 = (f+g x^2)^2 (literal exponent 2)",
             %mr_matchQ(3 + 5*x^2,
                        "(Power (Plus (Pattern |_mr_9_r13mq1_f| (Blank)) (Times (Optional (Pattern |_mr_9_r13mq1_g| (Blank))) (MRArg 1))) 2)",
                        [x^2], true)),
   true
  )$

  /* Milestone-2 Task 3 — %mr_matchQ's function-head case (2.3 r96: the
     first ported rule whose MatchQ pattern carries a pattern variable in
     HEAD position — F_[v_]). MR-MATCH binds a head pattern variable to the
     head of a non-atomic target (strict arity, ordered arguments); the bound
     value is the Maxima operator symbol the typed name reads as (asin reads
     as the noun %asin), which a cond re-applies as <symbol>(<arg>). The
     final checks load the generated 2.3 file and evaluate r96's emitted
     second MatchQ verbatim. */
  test_class2_marker_head() := block([P, P2, mh],
    print("--- matchQ marker-as-head (class 2 r96) ---"),
    P : "((Pattern |_mF| (Blank)) (Pattern |_mV| (Blank)))",
    P2 : "(Times ((Pattern |_mF| (Blank)) (Pattern |_mV| (Blank))) ((Pattern |_mF| (Blank)) (Pattern |_mW| (Blank))))",
    mh : lambda([%mr_mqb], %mr_inverseFunctionQ(%mr_mk(_mF, %mr_mqb)(%mr_mk(_mV, %mr_mqb)))),
    check_bool("marker head binds the inverse (asin)", %mr_matchQ(asin(x), P, [], mh)),
    check_not("marker head: non-inverse fails closed (sin)", %mr_matchQ(sin(x), P, [], mh)),
    check_not("marker head: 2-arg + target (strict arity)", %mr_matchQ(x + 1, P, [], true)),
    check_not("marker head: atom target", %mr_matchQ(x, P, [], true)),
    check_not("marker head: consistent re-binding (asin*sin)",
              %mr_matchQ(asin(x)*sin(x), P2, [], true)),
    check_bool("marker head: consistent re-binding (asin*asin)",
               %mr_matchQ(asin(x)*asin(y), P2, [], true)),
    %mr_load_sibling("rules/class2/2_3.mac", 'mr_witness_2_3),
    check_bool("2.3 witness survived", is(mr_witness_2_3() = true)),
    check_bool("r96 emitted MatchQ: asin head matches",
               %mr_matchQ(%e^(c*(a+b*x))*asin(x), "(Times (Power E (Times (Optional (Pattern |_mr_2_3_r96mq2_c| (Blank))) (Plus (Optional (Pattern |_mr_2_3_r96mq2_a| (Blank))) (Times (MRArg 1) (Optional (Pattern |_mr_2_3_r96mq2_b| (Blank))))))) ((Pattern |_mr_2_3_r96mq2_F| (Blank)) (Pattern |_mr_2_3_r96mq2_v| (Blank))))", [x], lambda([%mr_mqb], freeof(x, %mr_mk(_mr_2_3_r96mq2_a, %mr_mqb)) and freeof(x, %mr_mk(_mr_2_3_r96mq2_b, %mr_mqb)) and freeof(x, %mr_mk(_mr_2_3_r96mq2_c, %mr_mqb))  and  %mr_inverseFunctionQ(%mr_mk(_mr_2_3_r96mq2_F, %mr_mqb)(x))))),
    check_not("r96 emitted MatchQ: sin head fails closed",
              %mr_matchQ(%e^(c*(a+b*x))*sin(x), "(Times (Power E (Times (Optional (Pattern |_mr_2_3_r96mq2_c| (Blank))) (Plus (Optional (Pattern |_mr_2_3_r96mq2_a| (Blank))) (Times (MRArg 1) (Optional (Pattern |_mr_2_3_r96mq2_b| (Blank))))))) ((Pattern |_mr_2_3_r96mq2_F| (Blank)) (Pattern |_mr_2_3_r96mq2_v| (Blank))))", [x], lambda([%mr_mqb], freeof(x, %mr_mk(_mr_2_3_r96mq2_a, %mr_mqb)) and freeof(x, %mr_mk(_mr_2_3_r96mq2_b, %mr_mqb)) and freeof(x, %mr_mk(_mr_2_3_r96mq2_c, %mr_mqb))  and  %mr_inverseFunctionQ(%mr_mk(_mr_2_3_r96mq2_F, %mr_mqb)(x))))),
    true
   )$

  /* The generated MatchQ sites' pattern shapes (matcher substrate spec
     section 3.4: each distinct pattern the MatchQ sites use gets a unit
     test). The 24 generated sites carry 13 distinct pattern texts;
     test_matchQ_predicates and test_class2_marker_head pin four of them
     (x^m_.*u_., (f_+g_.*x^2)^r_., a_+b_.*v_ and the 2.3 r96 head F_[v_]),
     this section pins the other nine — one positive and one negative each,
     on the emitted pattern text with generic marker names and the site's
     cond where it carries one (plan-2 pre-validation, probe_shapes.mac and
     probe_s10.mac, 2026-09-13). Maxima distributes a power over a product
     even for a symbolic exponent ((2*x^3)^m stores as 2^m*x^(3*m), (3*x)^n
     as 3^n*x^n), so a pattern holding a power of a product is pinned on a
     nested power instead. */
  test_generated_matchq_shapes() := block([P],
    print("--- generated MatchQ shapes (spec 3.4) ---"),
    /* 1.1.1.7 r1, 1.4.1 r16: Qx_.*(c_+d_.*x^m_)^q_ */
    P : "(Times (Optional (Pattern |_s1_Qx| (Blank))) (Power (Plus (Pattern |_s1_c| (Blank)) (Times (Optional (Pattern |_s1_d| (Blank))) (Power (MRArg 1) (Pattern |_s1_m| (Blank))))) (Pattern |_s1_q| (Blank))))",
    check_bool("shape Qx*(c+d*x^m)^q on (2+3x^2)^3: Qx = 1, c = 2, d = 3, m = 2, q = 3",
               binds(%mr_matchQ_bindings((2+3*x^2)^3, P, [x], true),
                     ['_s1_Qx = 1, '_s1_c = 2, '_s1_d = 3, '_s1_m = 2, '_s1_q = 3])),
    check_bool("shape Qx*(c+d*x^m)^q on x*(2+3x^2)^3: Qx = x",
               binds(%mr_matchQ_bindings(x*(2+3*x^2)^3, P, [x], true), ['_s1_Qx = x])),
    check_not("shape Qx*(c+d*x^m)^q: a bare x term has no x^m_ (m_ is not Optional)",
              %mr_matchQ((2+3*x)^3, P, [x], true)),
    /* 1.4.1 r4 / r68: a_.*v_^k, k the computed Expon[Px, x] part */
    P : "(Times (Optional (Pattern |_s4_a| (Blank))) (Power (Pattern |_s4_v| (Blank)) (MRArg 1)))",
    check_bool("shape a*v^k, k = 3, on 5*(1+2x)^3: a = 5, v = 1+2x",
               binds(%mr_matchQ_bindings(5*(1+2*x)^3, P, [3], true), ['_s4_a = 5, '_s4_v = 1+2*x])),
    check_not("shape a*v^k, k = 3, on 5*(1+2x)^2", %mr_matchQ(5*(1+2*x)^2, P, [3], true)),
    /* 1.4.2 r17, first site: (d_.+x*e_.)^m*(f_.+x*g_.)^2*(a_.+x*b_.+c_.*x^2)^t_. */
    P : "(Times (Power (Plus (Optional (Pattern |_s7_d| (Blank))) (Times (MRArg 1) (Optional (Pattern |_s7_e| (Blank))))) (MRArg 2)) (Power (Plus (Optional (Pattern |_s7_f| (Blank))) (Times (MRArg 3) (Optional (Pattern |_s7_g| (Blank))))) 2) (Power (Plus (Optional (Pattern |_s7_a| (Blank))) (Times (MRArg 4) (Optional (Pattern |_s7_b| (Blank)))) (Times (Optional (Pattern |_s7_c| (Blank))) (MRArg 5))) (Optional (Pattern |_s7_t| (Blank)))))",
    check_bool("shape (d+e x)^m (f+g x)^2 (a+b x+c x^2)^t: d..g, a..c, t = tt",
               binds(%mr_matchQ_bindings((1+2*x)^mm*(3+4*x)^2*(5+6*x+7*x^2)^tt, P, [x, mm, x, x, x^2], true),
                     ['_s7_d = 1, '_s7_e = 2, '_s7_f = 3, '_s7_g = 4, '_s7_a = 5, '_s7_b = 6,
                      '_s7_c = 7, '_s7_t = tt])),
    check_not("shape (d+e x)^m (f+g x)^2 (…)^t: the literal exponent 2 does not take 3",
              %mr_matchQ((1+2*x)^mm*(3+4*x)^3*(5+6*x+7*x^2)^tt, P, [x, mm, x, x, x^2], true)),
    check_bool("shape (d+e x)^m (f+g x)^2 (…)^t: m = 1 folds the first power",
               %mr_matchQ((1+2*x)*(3+4*x)^2*(5+6*x+7*x^2)^tt, P, [x, 1, x, x, x^2], true)),
    /* 1.4.2 r17, second site: (a_.+c_.*x^2)^t_.*(d_.+x*e_.)^m*(f_.+x*g_.)^2, FreeQ cond */
    P : "(Times (Power (Plus (Optional (Pattern |_s8_a| (Blank))) (Times (Optional (Pattern |_s8_c| (Blank))) (MRArg 1))) (Optional (Pattern |_s8_t| (Blank)))) (Power (Plus (Optional (Pattern |_s8_d| (Blank))) (Times (MRArg 2) (Optional (Pattern |_s8_e| (Blank))))) (MRArg 3)) (Power (Plus (Optional (Pattern |_s8_f| (Blank))) (Times (MRArg 4) (Optional (Pattern |_s8_g| (Blank))))) 2))",
    check_bool("shape (a+c x^2)^t (d+e x)^m (f+g x)^2 with FreeQ: a = 5, c = 7, t = tt",
               binds(%mr_matchQ_bindings((5+7*x^2)^tt*(1+2*x)^mm*(3+4*x)^2, P, [x^2, x, mm, x],
                                         lambda([%mr_mqb], freeof(x, %mr_mk(_s8_a, %mr_mqb))
                                                           and freeof(x, %mr_mk(_s8_c, %mr_mqb))
                                                           and freeof(x, %mr_mk(_s8_t, %mr_mqb)))),
                     ['_s8_a = 5, '_s8_c = 7, '_s8_t = tt, '_s8_d = 1, '_s8_e = 2, '_s8_f = 3, '_s8_g = 4])),
    check_not("shape (a+c x^2)^t …: a trinomial base fails the FreeQ cond",
              %mr_matchQ((5+6*x+7*x^2)^tt*(1+2*x)^mm*(3+4*x)^2, P, [x^2, x, mm, x],
                         lambda([%mr_mqb], freeof(x, %mr_mk(_s8_a, %mr_mqb))
                                           and freeof(x, %mr_mk(_s8_c, %mr_mqb))))),
    check_bool("shape (a+c x^2)^t …: without the cond a_ takes the run 5+6x (Plus is Flat)",
               %mr_matchQ((5+6*x+7*x^2)^tt*(1+2*x)^mm*(3+4*x)^2, P, [x^2, x, mm, x], true)),
    /* 9.1 r12: b_*v_ /; FreeQ[b, x] */
    P : "(Times (Pattern |_s9_b| (Blank)) (Pattern |_s9_v| (Blank)))",
    check_bool("shape b*v on 3*sin(x): b = 3, v = sin(x)",
               binds(%mr_matchQ_bindings(3*sin(x), P, [], lambda([%mr_mqb], freeof(x, %mr_mk(_s9_b, %mr_mqb)))),
                     ['_s9_b = 3, '_s9_v = sin(x)])),
    check_not("shape b*v on sin(x): no product", %mr_matchQ(sin(x), P, [], true)),
    check_not("shape b*v /; FreeQ[b, x] on x*sin(x)",
              %mr_matchQ(x*sin(x), P, [], lambda([%mr_mqb], freeof(x, %mr_mk(_s9_b, %mr_mqb))))),
    /* 2.3 r96, first site: w_*(a_.*v_^n_)^m_ */
    P : "(Times (Pattern |_s10_w| (Blank)) (Power (Times (Optional (Pattern |_s10_a| (Blank))) (Power (Pattern |_s10_v| (Blank)) (Pattern |_s10_n| (Blank)))) (Pattern |_s10_m| (Blank))))",
    check_bool("shape w*(a*v^n)^m on sin(x)*((1+x)^n)^mm: w = sin(x), a = 1, v = 1+x",
               binds(%mr_matchQ_bindings(sin(x)*((1+x)^n)^mm, P, [], true),
                     ['_s10_w = sin(x), '_s10_a = 1, '_s10_v = 1+x, '_s10_n = n, '_s10_m = mm])),
    check_not("shape w*(a*v^n)^m on sin(x)*(2+x^3)^mm: a sum is no a*v^n",
              %mr_matchQ(sin(x)*(2+x^3)^mm, P, [], true)),
    /* 3.2.3 r16: u_.*(a+b x)^m_.*(c+d x)^n_. /; IntegersQ[m, n] (outer captures as parts) */
    P : "(Times (Optional (Pattern |_s12_u| (Blank))) (Power (MRArg 1) (Optional (Pattern |_s12_m| (Blank)))) (Power (MRArg 2) (Optional (Pattern |_s12_n| (Blank)))))",
    check_bool("shape u*(a+b x)^m*(c+d x)^n on k*(a+b x)^2*(c+d x)^3: u = k, m = 2, n = 3",
               binds(%mr_matchQ_bindings(k*(a+b*x)^2*(c+d*x)^3, P, [a+b*x, c+d*x],
                                         lambda([%mr_mqb], %mr_integersQ([%mr_mk(_s12_m, %mr_mqb),
                                                                          %mr_mk(_s12_n, %mr_mqb)]))),
                     ['_s12_u = k, '_s12_m = 2, '_s12_n = 3])),
    check_not("shape u*(a+b x)^m*(c+d x)^n /; IntegersQ: m = 1/2 fails",
              %mr_matchQ(k*sqrt(a+b*x)*(c+d*x)^3, P, [a+b*x, c+d*x],
                         lambda([%mr_mqb], %mr_integersQ([%mr_mk(_s12_m, %mr_mqb), %mr_mk(_s12_n, %mr_mqb)])))),
    /* 3.3 r59: e_.*(f_+x*g_.) /; FreeQ[{e, f, g}, x] */
    P : "(Times (Optional (Pattern |_s13_e| (Blank))) (Plus (Pattern |_s13_f| (Blank)) (Times (MRArg 1) (Optional (Pattern |_s13_g| (Blank))))))",
    check_bool("shape e*(f+g x) on 3*(4+5x): e = 3, f = 4, g = 5",
               binds(%mr_matchQ_bindings(3*(4+5*x), P, [x], true), ['_s13_e = 3, '_s13_f = 4, '_s13_g = 5])),
    check_not("shape e*(f+g x) on 3*(4+5x^2)", %mr_matchQ(3*(4+5*x^2), P, [x], true)),
    /* 3.5 r20: (x*g_.)^m_. /; FreeQ[{g, m}, x] */
    P : "(Power (Times (MRArg 1) (Optional (Pattern |_s14_g| (Blank)))) (Optional (Pattern |_s14_m| (Blank))))",
    check_bool("shape (g x)^m on 3*x: g = 3, m = 1",
               binds(%mr_matchQ_bindings(3*x, P, [x], true), ['_s14_g = 3, '_s14_m = 1])),
    check_bool("shape (g x)^m on x^2: g = 1, m = 2",
               binds(%mr_matchQ_bindings(x^2, P, [x], true), ['_s14_g = 1, '_s14_m = 2])),
    check_not("shape (g x)^m on 3*x^2", %mr_matchQ(3*x^2, P, [x], true)),
    true
  )$

  /* Task 3 — the function-head capture rules (class 3: 3.1.5 r58/r59,
     3.3 r58, 3.4 r37 — Px_. F_[d_.*(e_.+f_.*x_)]^m_. (a_.+b_.*Log[...])
     with MemberQ[{ArcSin, ...}, F]). MR-MATCH binds the head pattern
     variable F to the Maxima operator symbol (asin reads as %asin) and the
     cond's %mr_memberQ compares it with the literal list. The class-3 corpus
     carries twelve linear-argument inverse-function integrands (3.1.5
     e186-e197, probes/corpus/05-class3-inverse-function-exposure); the
     semantics are pinned here on synthetic integrands, through
     %mr_rule_accept (pattern + cond) and %mr_rule_bindings (pattern only).
     Bindings measured in the plan-2 pre-validation (probe_layerA_bind2.mac,
     probe_rewrite.mac, 2026-09-13). */
  test_class3_headvar() := block([mm],
    print("--- head-position capture matcher (class 3 F_[...] rules) ---"),
    %mr_load_sibling("rules/class3/3_1_5.mac", 'mr_witness_3_1_5),
    %mr_load_sibling("rules/class3/3_3.mac", 'mr_witness_3_3),
    %mr_load_sibling("rules/class3/3_4.mac", 'mr_witness_3_4),
    /* 3.1.5 r58: linear F-arg, free m, px log-arg, {ArcSin, ArcCos, ArcSinh, ArcCosh} */
    mm : %mr_rule_accept(_mr_rule_3_1_5_r58, x^2*asin(2*(3+4*x))^3*(5+6*log(7*x^2)), x),
    check_bool("hv r58 accepts (m = 3)", listp(mm)),
    check_bool("hv r58 binds the head symbol", binds(mm, ['_mr_3_1_5_r58_F = 'asin])),
    check_bool("hv r58 binds d, e, f, m",
               binds(mm, ['_mr_3_1_5_r58_d = 2, '_mr_3_1_5_r58_e = 3,
                          '_mr_3_1_5_r58_f = 4, '_mr_3_1_5_r58_m = 3])),
    check_bool("hv r58 binds Px (the leftover product)", binds(mm, ['_mr_3_1_5_r58_Px = x^2])),
    check_bool("hv r58 binds a, b, c, n",
               binds(mm, ['_mr_3_1_5_r58_a = 5, '_mr_3_1_5_r58_b = 6,
                          '_mr_3_1_5_r58_c = 7, '_mr_3_1_5_r58_n = 2])),
    /* 3.1.5 r59: bare F factor, {ArcTan, ArcCot, ArcTanh, ArcCoth} */
    mm : %mr_rule_accept(_mr_rule_3_1_5_r59, x*acot(2*(3+4*x))*(5+6*log(7*x^2)), x),
    check_bool("hv r59 accepts (bare factor)", listp(mm)),
    check_bool("hv r59 binds the head", binds(mm, ['_mr_3_1_5_r59_F = 'acot, '_mr_3_1_5_r59_Px = x])),
    /* 3.3 r58: log-arg c*(d+e*x)^n, the eight-head list */
    mm : %mr_rule_accept(_mr_rule_3_3_r58, x^2*atan(2*(3+4*x))*(5+6*log(7*(8+9*x)^3)), x),
    check_bool("hv 3.3 r58 accepts", listp(mm)),
    check_bool("hv 3.3 r58 binds the head", binds(mm, ['_mr_3_3_r58_F = 'atan])),
    check_bool("hv 3.3 r58 binds the log-arg d, e, n",
               binds(mm, ['_mr_3_3_r58_d = 8, '_mr_3_3_r58_e = 9, '_mr_3_3_r58_n = 3])),
    /* 3.4 r37: monomial F-arg f*x, free m, log-arg c*(d+e*x^n)^p, no Px */
    mm : %mr_rule_accept(_mr_rule_3_4_r37, asin(5*x)^2*(7+8*log(9*(10+11*x^3)^4)), x),
    check_bool("hv 3.4 r37 accepts", listp(mm)),
    check_bool("hv 3.4 r37 binds f, m, n, p",
               binds(mm, ['_mr_3_4_r37_f = 5, '_mr_3_4_r37_m = 2,
                          '_mr_3_4_r37_n = 3, '_mr_3_4_r37_p = 4])),
    /* a leading minus is a factor of the Times, so it lands in Px */
    check_bool("hv r58 binds Px with the sign",
               binds(%mr_rule_bindings(_mr_rule_3_1_5_r58, -x*asin(2*(3+4*x))^3*(5+6*log(7*x^2)), x),
                     ['_mr_3_1_5_r58_Px = -x])),
    /* a written constant times the bare log: a = 0, b = 1 (the Optional
       defaults) and the constant rides in Px */
    mm : %mr_rule_bindings(_mr_rule_3_1_5_r58, x*asin(2*(3+4*x))^3*(6*log(7*x^2)), x),
    check_bool("hv bare log factor binds a = 0, b = 1, Px = 6*x",
               binds(mm, ['_mr_3_1_5_r58_a = 0, '_mr_3_1_5_r58_b = 1, '_mr_3_1_5_r58_Px = 6*x])),
    mm : %mr_rule_bindings(_mr_rule_3_1_5_r58, x*asin(2*(3+4*x))^3*log(7*x^2), x),
    check_bool("hv bare log (no constant) binds a = 0, b = 1, c, n, Px",
               binds(mm, ['_mr_3_1_5_r58_a = 0, '_mr_3_1_5_r58_b = 1, '_mr_3_1_5_r58_c = 7,
                          '_mr_3_1_5_r58_n = 2, '_mr_3_1_5_r58_Px = x])),
    /* Px_. is Optional: no leftover factor binds Px = 1 */
    check_bool("hv no leftover factor binds Px = 1",
               binds(%mr_rule_bindings(_mr_rule_3_1_5_r58, asin(2*(3+4*x))^3*(5+6*log(7*x^2)), x),
                     ['_mr_3_1_5_r58_Px = 1])),
    /* F_[...]^m_. reaches a bare F factor through its Optional exponent, m = 1 */
    check_bool("hv bare factor vs the free-m rule binds m = 1",
               binds(%mr_rule_accept(_mr_rule_3_1_5_r58, x*asin(2*(3+4*x))*(5+6*log(7*x^2)), x),
                     ['_mr_3_1_5_r58_m = 1])),
    /* negatives: each declines */
    check_not("hv head outside the list (asin vs the r59 list)",
              %mr_rule_accept(_mr_rule_3_1_5_r59, x^2*asin(2*(3+4*x))*(5+6*log(7*x^2)), x)),
    check_not("hv non-linear F-arg",
              %mr_rule_bindings(_mr_rule_3_1_5_r59, x*asin(2*x^2)*(5+6*log(7*x^2)), x)),
    check_not("hv linear F-arg vs the monomial rule (3.4 r37)",
              %mr_rule_bindings(_mr_rule_3_4_r37, asin(2*(3+4*x))^2*(7+8*log(9*(10+11*x^3)^4)), x)),
    check_not("hv extra factor with no Px (3.4 r37)",
              %mr_rule_bindings(_mr_rule_3_4_r37, x*asin(5*x)^2*(7+8*log(9*(10+11*x^3)^4)), x)),
    check_not("hv powered factor vs the bare rule (r59)",
              %mr_rule_bindings(_mr_rule_3_1_5_r59, x*acot(2*(3+4*x))^3*(5+6*log(7*x^2)), x)),
    check_not("hv sum integrand (not a product)",
              %mr_rule_bindings(_mr_rule_3_1_5_r58, asin(2*(3+4*x))^3 + 5 + 6*log(7*x^2), x)),
    check_not("hv (d+e x)^n log-arg vs the x^n rule (r58)",
              %mr_rule_bindings(_mr_rule_3_1_5_r58, x*asin(2*(3+4*x))^3*(5+6*log(7*(8+9*x)^3)), x)),
    check_not("hv leading minus with no Px (3.4 r37: the sign cannot bind)",
              %mr_rule_bindings(_mr_rule_3_4_r37, -asin(5*x)^2*(7+8*log(9*(10+11*x^3)^4)), x)),
    true
  )$

  /* Task 4B-B1 (class-3 deferred campaign, 2026-09-01) — the
     generator's freeq_guarded regex had two false-positive faces: no
     word boundary (it matched the FreeQ substring inside
     InverseFunctionFreeQ — 3.5.m L5/L34/L37/L38/L40/L42/L43 are
     cond-only guards, no bare FreeQ[u|v, x]) and a greedy [^}]* that
     overran the FreeQ argument into later clauses (1.1.1.7.m L8 and
     1.4.1.m L174: FreeQ[q, x] && ... PolyQ[Qx, x] captured Qx). The
     9 affected slots now declare true; the conds already carry the
     faithful %mr_inverseFunctionFreeQ checks. Pinned here: the u/v
     slots bind x-dependent u at pattern level (previously 0-bound by
     the spurious freeof(x) declaration before the cond could run),
     the two g1 wave representatives (e275 on r37_u, 3.1.4 L352;
     e116 on r31_u, 3.5 L153) answer and close the zero-chain, and
     the cond predicate still gates inverse-function u (the fix is
     the declaration, not the cond). The answer-level reps run on
     the default 1.1.1.1 table + 3.5 (production order: class 1
     before class 3); their IBP residuals are answered by the
     mr_int fb=true native-integrate fall-through — measured
     2026-09-01 on branch_5_50_base_84_g4204fb669: both reps close
     the ratsimp zero-chain in 0 s and issue no integrate prompt. */
  test_class3_b1_freeof() := block([mm, ans, saved_table],
    print("--- b1: spurious freeof(x) matchdeclare removed (3.5 r2_u/r31_u/r34_u/r35_u/r37_u/r39_v/r40_v, 1.1.1.7 r5_Qx, 1.4.1 r18_Qx) ---"),
    %mr_load_sibling("rules/class3/3_5.mac", 'mr_witness_3_5),
    /* pattern level: the u slot binds the x-dependent u (the .m
       constrains it in the cond only); listp-guarded so a RED run
       (declaration reverted -> mm = false, or helper not loaded ->
       noun) fails the check without dying inside geteqR */
    mm : %mr_rule_bindings(_mr_rule_3_5_r31, log(a + %e^x*b), x),
    check_bool("b1 r31 binds x-dependent u",
               listp(mm) and length(mm) > 0
               and is(freeof(x, geteqR(mm, '_mr_3_5_r31_u)) = false)),
    mm : %mr_rule_bindings(_mr_rule_3_5_r35, log(g*(a + b*x + c*x^2)^n)/(d + e*x^2), x),
    check_bool("b1 r35 binds x-dependent u",
               listp(mm) and length(mm) > 0
               and is(freeof(x, geteqR(mm, '_mr_3_5_r35_u)) = false)),
    /* answer level: the literal suite integrands (the g1 wave list's
       fastest representatives) */
    saved_table : mr_rule_table,
    mr_rule_table : flatten([mr_rule_table, mr_rules_3_5]),
    ans : rubi(x*log(x)*sqrt(4 + x^2), x),
    /* the package no-answer noun is the listcons 'unintegrable[f, x]
       (mr_unintegrable, utils :27): measured 2026-09-01,
       is(op(noun) = 'unintegrable) is FALSE on it (op() on the
       listcons is not the bare symbol under is()), so the
       discriminant is string(op) — this disjunct was added by the
       B1 follow-up after the b2 cycle measured the gap */
    check_not("b1 e275 not a noun",
              is(atom(ans)) or is(op(ans) = 'integrate)
              or is(op(ans) = 'unintegrable)
              or is(string(op(ans)) = "unintegrable")),
    check_bool("b1 e275 zero-chain",
               is(ratsimp(diff(ans, x) - x*log(x)*sqrt(4 + x^2)) = 0)),
    ans : rubi(log(a + %e^x*b), x),
    check_not("b1 e116 not a noun",
              is(atom(ans)) or is(op(ans) = 'integrate)
              or is(op(ans) = 'unintegrable)
              or is(string(op(ans)) = "unintegrable")),
    check_bool("b1 e116 zero-chain",
               is(ratsimp(diff(ans, x) - log(a + %e^x*b)) = 0)),
    mr_rule_table : saved_table,
    /* negative pin: the cond's faithful check still gates
       inverse-function u (the ported iffQ, this file's
       test_class3_cluster_a pins) */
    check_bool("b1 r31 cond still gates inverse-function u",
               is(%mr_inverseFunctionFreeQ(atan(x), x) = false)),
    true
  )$

  /* Task 4B-B2 (class-3 deferred campaign, 2026-09-01) — the ported
     %mr_linearQ had dropped the .m LinearQ's ListQ arm (Rubi
     IntegrationUtilityFunctions.m :1373-1376): a list argument fell
     through to %mr_polyDegQ, which fails closed on a non-polynomial,
     so every emitted list-form cond (%mr_linearQ([u, v], x), from
     .m LinearQ[{u, v}] — 3_2_1 r5/r6/r23/r24, 3_2_2 r13/r14/r15)
     0-guarded and the 47 g2 D1 entries deferred. Pinned here: the
     list arm (all members linear -> true; one non-linear member ->
     false; the standing scalar pins at lines 178-179/218-220 stay),
     and the two g2 wave representatives (e156, 3.2.1 file L205;
     e226, 3.2.2 file L271 — the cover for both sets is 3.2.2.m L19
     r15) answer and close the zero-chain. The answer-level reps run
     on the minimal table (default 1.1.1.1 + 3_2_2, production order
     class 1 before class 3; 3_2_1 probed unnecessary — its rules
     0-fire/reject on both routes, measured 2026-09-01); the nested
     sub-integrals are answered by the mr_int fb=true native-
     integrate fall-through. Measured 2026-09-01 on
     branch_5_50_base_84_g4204fb669: e156's explicit (dilog-carrying)
     answer closes the driver's zero-chain (corpus_driver.py
     zero_chain, returns 1) ONLY under its elliptic-gated
     radcan(rat()) fallback stage — the numeric stage declines (n
     stays symbolic) and all eight symbolic stages fail; e226's
     answer (the r15 Subst rewrite, leaving the native integrate
     noun for the rewritten nested integrand — the .m's 3.2.2 L8
     rule, EqQ[m+q+2,0], covers that nested integrand in .m but
     0-binds here on the matcher's data-dependent factor order, the
     C-in-Rubi class, out of B2 scope) closes under plain ratsimp. */
  test_class3_b2_linearQ() := block([ans, z, saved_table, f],
    print("--- b2: %mr_linearQ list arm restored (.m LinearQ ListQ; 3.2.2 r15 et al.) ---"),
    check_bool("linearQ list", %mr_linearQ([a + b*x, c + d*x], x)),
    check_not("linearQ list rejects quadratic member",
              %mr_linearQ([a + b*x, c*x^2], x)),
    check_bool("linearQ scalar", %mr_linearQ(a + b*x, x)),
    check_not("linearQ scalar rejects quadratic",
              %mr_linearQ(a + b*x^2, x)),
    %mr_load_sibling("rules/class3/3_2_2.mac", 'mr_witness_3_2_2),
    saved_table : mr_rule_table,
    mr_rule_table : flatten([mr_rule_table, mr_rules_3_2_2]),
    /* the package no-answer noun is the listcons 'unintegrable[f, x]
       (mr_unintegrable, utils :27): measured 2026-09-01, is(op(noun) =
       'unintegrable) is FALSE on it (op() on a listcons is not the
       bare symbol under is()), so the discriminant is string(op);
       the b1 non-noun checks gained the same disjunct in the B1
       follow-up. diff of the noun evaluates to 0 (measured on all
       four reps' shapes — no crash). */
    f : (a+b*x)^3*(A+B*log(e*(a+b*x)^n/(c+d*x)^n))^2,
    ans : rubi(f, x),
    check_not("b2 e156 not a noun",
              is(atom(ans)) or is(op(ans) = 'integrate)
              or is(string(op(ans)) = "unintegrable")),
    /* the driver's full zero-chain returns 1; the closing stage
       measured is the radcan(rat()) fallback (errcatched, per the
       driver's semantics: [] on crash, [value] on success) */
    z : errcatch(radcan(rat(diff(ans, x) - f))),
    check_bool("b2 e156 zero-chain (driver radcan(rat()) fallback)",
               is(z # []) and is(part(z, 1) = 0)),
    f : (a*g+b*g*x)^m*(c*i+d*i*x)^(-2-m)*(A+B*log(e*(a+b*x)^n/(c+d*x)^n))^p,
    ans : rubi(f, x),
    check_not("b2 e226 not a noun",
              is(atom(ans)) or is(op(ans) = 'integrate)
              or is(string(op(ans)) = "unintegrable")),
    /* errcatched per the driver's semantics (this build's errcatch:
       [value] on success / [] on error; diff of the RED-run listcons
       noun evaluates to 0 — measured — so RED fails clean on
       ratsimp(0 - f) # 0) */
    z : errcatch(ratsimp(diff(ans, x) - f)),
    check_bool("b2 e226 zero-chain",
               is(z # []) and is(part(z, 1) = 0)),
    mr_rule_table : saved_table,
    true
  )$

  /* Task 4B-B4 (class-3 deferred campaign, 2026-09-01) — the .m's
     DerivativeDivides (IntegrationUtilityFunctions.m :7450-7462)
     runs on MA's Times storage of P/x^m (its EasyDQ rule-1 strip,
     EasyDQ[u_.*x_^m_., x] /; FreeQ[m, x], matches the factor
     x^(-m)); Maxima stores the same expression as a "/" node, which
     the line-ported %mr_easyDQ declines (no strip arm for "/", and
     the RationalFunctionExponents=={1,1} arm reads [0,0] on a
     symbolic m) — so 3_5 r1/r2's e392 shape (3.4 file L509, v =
     (a+x^n)/x^n, integrand log((a+x^n)/x^n)/x) 0-fired while the
     algebraic twin log(1+a*x^-n)/x (Plus storage) fired. The probe
     (t4b4, 2026-09-01, branch_5_50_base_84_g4204fb669) measured the
     decline at the EasyDQ cond, NOT the u/v step (%mr_simp(u/
     diff(y,x)) = 1/n pre-fix — the ratsimp stage alone closes it),
     and the fix expands y at the binding — the identity on every
     other form the ladder accepts (plus / binomial / monomial /
     power / product-of-linears / log shapes measured unchanged;
     the .m's a_.*x guard runs on y as bound, .m order). Pinned
     here: the e392 quotient shape returns the 1/n quotient (RED:
     false — the pre-fix decline), the two corpus shapes that
     currently fire 3_5 r1 keep their exact pre-fix values (the
     Plus shape 1/n — the brief's Step-1 (ii) pin; e390 (a+x)/x,
     3.4 file L507, w = 1), and the e392 answer on the minimal table
     (default 1.1.1.1 + 3_5, production order class 1 before class
     3; 3_5 reloaded here — the reload is TLS-idempotent, the
     slot declaims are per-symbol) is the r1 repl form w*
     polylog(2, 1-v) — the corpus expected polylog(2,-a/x^n)/n in
     stored argument. The e392 answer's zero-chain CANNOT close in
     this build (Maxima has no diff rule for polylog —
     diff(polylog(2, x), x) is a noun, no manual entry — so the
     self-diff and the expected-diff of the correct answer both
     carry a diff noun; the driver's zero_chain, executed verbatim,
     returned 0: the numeric stage crashed on the diff noun's
     variable slot, all eight symbolic stages and the elliptic-gated
     radcan(rat()) fallback keep the noun) — the pin is therefore
     answer-form equality, not a zero-chain stage (flagged in
     t4b4-report). */
  test_class3_b4_derDiv() := block([ans, saved_table, f],
    print("--- b4: %mr_derivativeDivides stored-quotient y storage (3_5 r1/r2; e392) ---"),
    /* predicate level: the e392 quotient shape (RED: false — the
       pre-fix EasyDQ cond decline; the brief's literal
       check_bool(derDiv(...)) is unsatisfiable — the post-fix
       value is the quotient 1/n, not true — so the intent is
       pinned as equality with the quotient) */
    check_bool("b4 derDiv e392 quotient shape",
               is(%mr_derivativeDivides((a+x^n)/x^n,
                  (1/x)*(1 - (a+x^n)/x^n), x) = 1/n)),
    /* regression pins: the shapes that currently fire 3_5 r1 keep
       their exact pre-fix values (the Plus shape — the brief's
       Step-1 (ii) pin, measured 1/n; e390 (a+x)/x — 3.4 file L507,
       measured 1; both GREEN in a RED run — regression pins, not
       RED detectors) */
    check("b4 derDiv Plus shape unchanged",
          %mr_derivativeDivides(1 + a*x^-n,
            (1/x)*(1 - (1 + a*x^-n)), x), 1/n),
    check("b4 derDiv e390 shape unchanged",
          %mr_derivativeDivides((a+x)/x,
            (1/x)*(1 - (a+x)/x), x), 1),
    /* answer level: the e392 integrand on the minimal table */
    %mr_load_sibling("rules/class3/3_5.mac", 'mr_witness_3_5),
    saved_table : mr_rule_table,
    mr_rule_table : flatten([mr_rule_table, mr_rules_3_5]),
    f : log((a+x^n)/x^n)/x,
    ans : rubi(f, x),
    /* the package no-answer noun is the listcons 'unintegrable[f, x]
       (mr_unintegrable, utils :27): is(op(noun) = 'unintegrable) is
       FALSE on it (measured 2026-09-01, b2 idiom) — the
       discriminant is string(op) */
    check_not("b4 e392 not a noun",
              is(atom(ans)) or is(op(ans) = 'integrate)
              or is(string(op(ans)) = "unintegrable")),
    /* the r1 repl form w*polylog(2, 1-v) with w = 1/n, v the bound
       quotient — the corpus expected polylog(2,-a/x^n)/n in stored
       argument (1-(a+x^n)/x^n stores unsimplified, so the
       is()-equality is against the stored form) */
    check_bool("b4 e392 answer is the r1 repl form",
               is(ans = (1/n)*polylog(2, 1 - (a+x^n)/x^n))),
    mr_rule_table : saved_table,
    true
  )$

  /* Task 4B-C2 (class-3 deferred campaign, 2026-09-01) — the 3.1.2
     m10 (d*x)^m head 0-bind (M6). The (d*x)^m power has a NON-ATOMIC
     head: in a Times integrand findfun's first-match-wins scan hands
     it the (a+b log(c x^n))^p factor (Power[Plus, p]) and there is no
     backtracking, so the old pattern 0-bound every stored corpus form
     of a unit monomial head over the log power — e65/e66/e67 (x^3, x^2,
     x over a+b log(c x^n); 3.1.2 suite L82-84) returned the no-answer
     noun while the .m integrates all three. The fix re-transcribes the
     head to d*x^m (atomic-base power) and matchdeclare's d with
     is(u = 1) — .m parity, not .m excess: the repl is not (d,m)-
     invariant (a d=8 bind would integrate the wrong integrand) and
     the free-d / (2*x)^k3 rows 0-bind in production today anyway
     (probed; parity pins below). Measured 2026-09-01 on
     branch_5_50_base_84_g4204fb669 (probes /tmp/opencode/t4c2_*): the
     stored forms bind d=1, m=3/2/1, p=-1; the minimal table
     (default 1.1.1.1 + 2_1 + 3_1_2, production order class 1 before
     class 2 before class 3) answers all three non-noun. The two-step
     premise: the Subst re-dispatch's inner integral
     E^((m+1)/n x)(a+b x)^p is closed by the native integrate
     fallback (fb=true) in the E1/expintegral_e form — the ported
     2_1 r3 (2.1.m L7 Ei rule) 0-binds the Subst integrand (zero
     fire= lines in the class-2 production run), so the rescue is the
     native fall-through, not the ported rule (flagged in
     t4c2-report). Zero-chains (driver stage order, corpus_driver.py
     zero_chain): the self-diff closes ONLY at the radcan(rat())
     fallback (all eight ratsimp/factor stages fail) and the
     expected-diff closes at the factor stage — the expected uses the
     driver's HEAD_REWRITES form (corpus_driver.py:74: the suite's Ei
     is an unbound noun in this build; expintegral_ei differentiates). */
  test_class3_c2_dhead() := block([ans, saved_table, f, z, mm],
    print("--- c2: 3_1_2 r10 (d*x)^m head re-transcription (e65/e66/e67) ---"),
    %mr_load_sibling("rules/class2/2_1.mac", 'mr_witness_2_1),
    %mr_load_sibling("rules/class3/3_1_2.mac", 'mr_witness_3_1_2),
    saved_table : mr_rule_table,
    mr_rule_table : flatten([mr_rule_table, mr_rules_2_1, mr_rules_3_1_2]),
    /* pattern level: the stored corpus forms bind with exactly the .m
       values (RED: every one of these listp()s is false pre-fix — the
       M6 0-bind) */
    mm : %mr_rule_bindings(_mr_rule_3_1_2_r10, x^3/(a + b*log(c*x^n)), x),
    check_bool("c2 r10 binds the e65 stored quotient", listp(mm)),
    check_bool("c2 r10 e65 binds d=1, m=3, p=-1",
               listp(mm) and is(geteqR(mm, '_mr_3_1_2_r10_d) = 1)
               and is(geteqR(mm, '_mr_3_1_2_r10_m) = 3)
               and is(geteqR(mm, '_mr_3_1_2_r10_p) = -1)),
    mm : %mr_rule_bindings(_mr_rule_3_1_2_r10, x^2/(a + b*log(c*x^n)), x),
    check_bool("c2 r10 e66 binds d=1, m=2, p=-1",
               listp(mm) and is(geteqR(mm, '_mr_3_1_2_r10_d) = 1)
               and is(geteqR(mm, '_mr_3_1_2_r10_m) = 2)
               and is(geteqR(mm, '_mr_3_1_2_r10_p) = -1)),
    mm : %mr_rule_bindings(_mr_rule_3_1_2_r10, x/(a + b*log(c*x^n)), x),
    check_bool("c2 r10 e67 binds d=1, m=1, p=-1",
               listp(mm) and is(geteqR(mm, '_mr_3_1_2_r10_d) = 1)
               and is(geteqR(mm, '_mr_3_1_2_r10_m) = 1)
               and is(geteqR(mm, '_mr_3_1_2_r10_p) = -1)),
    /* .m-parity rejections (GREEN in a RED run — regression pins, not
       RED detectors): the d-gate keeps the port from binding stored
       numeric-coefficient monomials, and the power-head rows
       (free-d / (2*x)^k3) 0-bind exactly as today's production does */
    check_not("c2 r10 rejects the 8*x^3 stored quotient",
              %mr_rule_bindings(_mr_rule_3_1_2_r10, 8*x^3/(a + b*log(c*x^n)), x)),
    check_not("c2 r10 rejects the 8*x^3 Times form",
              %mr_rule_bindings(_mr_rule_3_1_2_r10, 8*x^3*(a + b*log(c*x^n))^2, x)),
    /* the faithful (d_.*x_)^m_. binds a free-d power head (d = dd,
       m = mm2) — the defmatch-era is(u = 1) gate went with the
       re-transcription (plan-2 pre-validation, 2026-09-13) */
    check_bool("c2 r10 binds the free-d head (d = dd, m = mm2)",
               binds(%mr_rule_bindings(_mr_rule_3_1_2_r10, (dd*x)^mm2*(a + b*log(c*x^n))^2, x),
                     ['_mr_3_1_2_r10_d = dd, '_mr_3_1_2_r10_m = mm2])),
    check_not("c2 r10 rejects the (2*x)^k3 head",
              %mr_rule_bindings(_mr_rule_3_1_2_r10, (2*x)^k3*(a + b*log(c*x^n))^2, x)),
    /* answer level: e65 (m=3) on the minimal table */
    f : x^3/(a + b*log(c*x^n)),
    ans : rubi(f, x),
    check_not("c2 e65 not a noun",
              is(atom(ans)) or is(op(ans) = 'integrate)
              or is(string(op(ans)) = "unintegrable")),
    /* the self-diff closes only at the driver's radcan(rat()) fallback
       (all eight ratsimp/factor stages measured false) */
    z : errcatch(radcan(rat(diff(ans, x) - f))),
    check_bool("c2 e65 self-diff (driver radcan(rat()) fallback)",
               is(z # []) and is(part(z, 1) = 0)),
    /* the expected-diff closes at the factor stage (driver form:
       expintegral_ei, not the suite's unbound Ei noun) */
    z : errcatch(factor(diff(ans - x^4*expintegral_ei(4*(a+b*log(c*x^n))/(b*n))/(%e^(4*a/(b*n))*b*n*(c*x^n)^(4/n)), x))),
    check_bool("c2 e65 expected-diff (factor)",
               is(z # []) and is(part(z, 1) = 0)),
    /* answer level: e66 (m=2) */
    f : x^2/(a + b*log(c*x^n)),
    ans : rubi(f, x),
    check_not("c2 e66 not a noun",
              is(atom(ans)) or is(op(ans) = 'integrate)
              or is(string(op(ans)) = "unintegrable")),
    z : errcatch(radcan(rat(diff(ans, x) - f))),
    check_bool("c2 e66 self-diff (driver radcan(rat()) fallback)",
               is(z # []) and is(part(z, 1) = 0)),
    z : errcatch(factor(diff(ans - x^3*expintegral_ei(3*(a+b*log(c*x^n))/(b*n))/(%e^(3*a/(b*n))*b*n*(c*x^n)^(3/n)), x))),
    check_bool("c2 e66 expected-diff (factor)",
               is(z # []) and is(part(z, 1) = 0)),
    /* answer level: e67 (m=1 — the bare x factor binds m=1) */
    f : x/(a + b*log(c*x^n)),
    ans : rubi(f, x),
    check_not("c2 e67 not a noun",
              is(atom(ans)) or is(op(ans) = 'integrate)
              or is(string(op(ans)) = "unintegrable")),
    z : errcatch(radcan(rat(diff(ans, x) - f))),
    check_bool("c2 e67 self-diff (driver radcan(rat()) fallback)",
               is(z # []) and is(part(z, 1) = 0)),
    z : errcatch(factor(diff(ans - x^2*expintegral_ei(2*(a+b*log(c*x^n))/(b*n))/(%e^(2*a/(b*n))*b*n*(c*x^n)^(2/n)), x))),
    check_bool("c2 e67 expected-diff (factor)",
               is(z # []) and is(part(z, 1) = 0)),
     mr_rule_table : saved_table,
     true
   )$

   /* Task 4C-C1 (class-3 deferred campaign, 2026-09-01) — the slotted
      inner exponent (d_.+e_.*x_^r_.)^q_. of 3.1.3 / 3.1.4 / 3.1.5, including
      the sqrt nodes Maxima stores for q = 1/2 or r = 1/2. The defmatch runner
      0-bound the slot and needed the M1 / C1c single-slot re-emission;
      MR-MATCH binds the faithful patterns, so the checks read the captures
      directly (bindings measured in the plan-2 pre-validation,
      probe_layerA_bind2.mac, 2026-09-13). The 3.1.4 r23 rep has an x^2 head:
      with 5*x^2 the head item (f_.*x_)^m_. cannot absorb the 5 ((f*x)^2 is
      not 5*x^2) and the rule declines, as in Mathematica. Answer level: the
      q=1 bare-binomial row is non-noun and closes the zero-chain. */
   test_class3_c1_slotted() := block([ans, saved_table, f, z, mm],
     print("--- c1: slotted inner exponent (3_1_3/3_1_4/3_1_5) ---"),
     %mr_load_sibling("rules/class3/3_1_3.mac", 'mr_witness_3_1_3),
     %mr_load_sibling("rules/class3/3_1_4.mac", 'mr_witness_3_1_4),
     %mr_load_sibling("rules/class3/3_1_5.mac", 'mr_witness_3_1_5),
     saved_table : mr_rule_table,
     mr_rule_table : flatten([mr_rule_table, mr_rules_3_1_3, mr_rules_3_1_4, mr_rules_3_1_5]),
     /* 3_1_3 r1: the q=1 bare binomial */
     mm : %mr_rule_bindings(_mr_rule_3_1_3_r1, (c1d+c1e*x)*(c1a+c1b*log(c1c*x)), x),
     check_bool("c1 3_1_3_r1 binds the q=1 bare binomial", listp(mm)),
     check_bool("c1 3_1_3_r1 binds d=c1d, e=c1e, r=1, q=1",
                binds(mm, ['_mr_3_1_3_r1_d = c1d, '_mr_3_1_3_r1_e = c1e,
                           '_mr_3_1_3_r1_r = 1, '_mr_3_1_3_r1_q = 1])),
     /* 3_1_3 r1: the sqrt node sqrt(1+x^2) is (1+x^2)^(1/2) */
     mm : %mr_rule_bindings(_mr_rule_3_1_3_r1, sqrt(1+x^2)*(c1a+c1b*log(c1c*x)), x),
     check_bool("c1 3_1_3_r1 binds sqrt(1+x^2)", listp(mm)),
     check_bool("c1 3_1_3_r1 sqrt binds d=1, e=1, r=2, q=1/2",
                binds(mm, ['_mr_3_1_3_r1_d = 1, '_mr_3_1_3_r1_e = 1,
                           '_mr_3_1_3_r1_r = 2, '_mr_3_1_3_r1_q = 1/2])),
     /* 3_1_4 r23: sqrt(c1d+c1e*x) under the (f_.*x_)^m_. head */
     mm : %mr_rule_accept(_mr_rule_3_1_4_r23, x^2*sqrt(c1d+c1e*x)*(c1a+c1b*log(c1c*x^3)), x),
     check_bool("c1 3_1_4_r23 accepts sqrt(c1d+c1e*x) under the x^2 head", listp(mm)),
     check_bool("c1 3_1_4_r23 binds f=1, m=2 and d=c1d, e=c1e, r=1, q=1/2",
                binds(mm, ['_mr_3_1_4_r23_f = 1, '_mr_3_1_4_r23_m = 2,
                           '_mr_3_1_4_r23_d = c1d, '_mr_3_1_4_r23_e = c1e,
                           '_mr_3_1_4_r23_r = 1, '_mr_3_1_4_r23_q = 1/2])),
     check_not("c1 3_1_4_r23 declines the 5*x^2 head",
               %mr_rule_bindings(_mr_rule_3_1_4_r23, 5*x^2*sqrt(c1d+c1e*x)*(c1a+c1b*log(c1c*x^3)), x)),
     /* 3_1_5 r46: the sqrt(x) term in the log-arg binomial, inner exponent 1/2 */
     mm : %mr_rule_bindings(_mr_rule_3_1_5_r46, log(c1d*(c1e+c1f*sqrt(x))^c1ro)*(c1a+c1b*log(c1c*x))^c1po/x, x),
     check_bool("c1 3_1_5_r46 binds (c1e+c1f*sqrt(x))^c1ro", listp(mm)),
     check_bool("c1 3_1_5_r46 binds inner exponent 1/2, outer c1ro",
                binds(mm, ['_mr_3_1_5_r46_m = 1/2, '_mr_3_1_5_r46_r = c1ro,
                           '_mr_3_1_5_r46_e = c1e, '_mr_3_1_5_r46_f = c1f])),
     /* 3_1_5 r47: the same under the (g*x)^h head */
     mm : %mr_rule_bindings(_mr_rule_3_1_5_r47, (c1g*x)^c1h*log(c1d*(c1e+c1f*sqrt(x))^c1ro)*(c1a+c1b*log(c1c*x)), x),
     check_bool("c1 3_1_5_r47 binds under the (g*x)^h head", listp(mm)),
     check_bool("c1 3_1_5_r47 binds g=c1g, q=c1h and inner 1/2, outer c1ro",
                binds(mm, ['_mr_3_1_5_r47_g = c1g, '_mr_3_1_5_r47_q = c1h,
                           '_mr_3_1_5_r47_m = 1/2, '_mr_3_1_5_r47_r = c1ro])),
     /* answer level: the q=1 bare-binomial row is non-noun, closes ratsimp */
     f : (1+x^2)*(1+log(x)),
     ans : rubi(f, x),
     check_not("c1 e(q=1) not a noun",
               is(atom(ans)) or is(op(ans) = 'integrate)
               or is(string(op(ans)) = "unintegrable")),
      z : errcatch(ratsimp(diff(ans, x) - f)),
      check_bool("c1 e(q=1) zero-chain (ratsimp)",
                 is(z # []) and is(part(z, 1) = 0)),
      mr_rule_table : saved_table,
      true
    )$

    /* Task 4C-C4 (class-3 deferred campaign, 2026-09-01) — 3_2_1
       r16/r18/r20, (f+g x)^m (A+B log(e (a+b x)^n (c+d x)^mn))^p on the
       stored forms. The defmatch runner 0-bound all 13 numeric-n entries and
       needed the %mr_logpow_match structural matcher; MR-MATCH binds the
       faithful patterns and the cond, retried over the complete bindings,
       selects the .m orientation — r18's accepted binding on
       e*(c+d*x)^2/(a+b*x)^2 is (a, b) := (c, d), n = 2 (plan-2
       pre-validation, probe_rewrite.mac, 2026-09-13). Answer level: the
       minimal table is the default 1.1.1.1 + 3_1_x + 3_2_1 + 3_3 in
       production order — without the 3_1_x files the substituted
       (A+B log(e x^2))/x^2 reaches the 3_3 r61 Unintegrable catch-all
       first (probe_c4v.mac, probe_tables.mac). e210's answer carries
       polylog, which has no diff rule in this build (the b4 e392 note), so
       its pin is non-noun with no nested no-answer noun, not a zero-chain.
       e268's answer-level check stays omitted (the campaign's cumulative
       suite interaction note). */
    test_class3_c4_321() := block([ans, saved_table, f, z, mm],
      print("--- c4: 3_2_1 r16/r18/r20 log-arg (C4) ---"),
      %mr_load_sibling("rules/class3/3_1_1.mac", 'mr_witness_3_1_1),
      %mr_load_sibling("rules/class3/3_1_2.mac", 'mr_witness_3_1_2),
      %mr_load_sibling("rules/class3/3_1_3.mac", 'mr_witness_3_1_3),
      %mr_load_sibling("rules/class3/3_1_4.mac", 'mr_witness_3_1_4),
      %mr_load_sibling("rules/class3/3_1_5.mac", 'mr_witness_3_1_5),
      %mr_load_sibling("rules/class3/3_2_1.mac", 'mr_witness_3_2_1),
      %mr_load_sibling("rules/class3/3_3.mac", 'mr_witness_3_3),
      saved_table : mr_rule_table,
      mr_rule_table : flatten([mr_rule_table, mr_rules_3_1_1, mr_rules_3_1_2, mr_rules_3_1_3,
                               mr_rules_3_1_4, mr_rules_3_1_5, mr_rules_3_2_1, mr_rules_3_3]),
      /* pattern + cond: e124 (r16) */
      mm : %mr_rule_accept(_mr_rule_3_2_1_r16, (A+B*log(e*(a+b*x)^2/(c+d*x)^2))/(a*g+b*g*x)^2, x),
      check_bool("c4 e124 accepts (r16)", listp(mm)),
      check_bool("c4 e124 f=a*g g=b*g m=-2",
                 binds(mm, ['_mr_3_2_1_r16_f = a*g, '_mr_3_2_1_r16_g = b*g, '_mr_3_2_1_r16_m = -2])),
      check_bool("c4 e124 a,b,n,c,d,mn,p",
                 binds(mm, ['_mr_3_2_1_r16_a = a, '_mr_3_2_1_r16_b = b, '_mr_3_2_1_r16_n = 2,
                            '_mr_3_2_1_r16_c = c, '_mr_3_2_1_r16_d = d, '_mr_3_2_1_r16_mn = -2,
                            '_mr_3_2_1_r16_p = 1])),
      check_bool("c4 e124 A,B,e",
                 binds(mm, ['_mr_3_2_1_r16_A = A, '_mr_3_2_1_r16_B = B, '_mr_3_2_1_r16_e = e])),
      /* pattern + cond: e210 (r18) — the (c,d)-swapped orientation */
      mm : %mr_rule_accept(_mr_rule_3_2_1_r18, (a*g+b*g*x)^4*(A+B*log(e*(c+d*x)^2/(a+b*x)^2))^2, x),
      check_bool("c4 e210 accepts (r18)", listp(mm)),
      check_bool("c4 e210 f,g,m + swap a=c b=d n=2 c=a d=b mn=-2 p=2",
                 binds(mm, ['_mr_3_2_1_r18_f = a*g, '_mr_3_2_1_r18_g = b*g, '_mr_3_2_1_r18_m = 4,
                            '_mr_3_2_1_r18_a = c, '_mr_3_2_1_r18_b = d, '_mr_3_2_1_r18_n = 2,
                            '_mr_3_2_1_r18_c = a, '_mr_3_2_1_r18_d = b, '_mr_3_2_1_r18_mn = -2,
                            '_mr_3_2_1_r18_p = 2])),
      /* pattern + cond: e268 (r20) — the free (f+g x) head */
      mm : %mr_rule_accept(_mr_rule_3_2_1_r20, (A+B*log(e*(a+b*x)^2/(c+d*x)^2))/(f+g*x)^2, x),
      check_bool("c4 e268 accepts (r20)", listp(mm)),
      check_bool("c4 e268 f=f g=g m=-2 p=1",
                 binds(mm, ['_mr_3_2_1_r20_f = f, '_mr_3_2_1_r20_g = g, '_mr_3_2_1_r20_m = -2,
                            '_mr_3_2_1_r20_p = 1])),
      check_bool("c4 e268 a,b,n,c,d,mn",
                 binds(mm, ['_mr_3_2_1_r20_a = a, '_mr_3_2_1_r20_b = b, '_mr_3_2_1_r20_n = 2,
                            '_mr_3_2_1_r20_c = c, '_mr_3_2_1_r20_d = d, '_mr_3_2_1_r20_mn = -2])),
      /* rejections */
      check_not("c4 rejects the non-linear head (f+g x^2)^2",
                %mr_rule_bindings(_mr_rule_3_2_1_r20, (A+B*log(e*(a+b*x)^2/(c+d*x)^2))/(f+g*x^2)^2, x)),
      check_not("c4 rejects a log-arg sum (not a product of binomial powers)",
                %mr_rule_bindings(_mr_rule_3_2_1_r20, (A+B*log(e*(a+b*x)^2+(c+d*x)^2))/(f+g*x)^2, x)),
      check_not("c4 rejects a log-less integrand",
                %mr_rule_bindings(_mr_rule_3_2_1_r20, (f+g*x)^2*(a+b*x)^2, x)),
      /* answer level: e124 non-noun, self-diff closes (ratsimp + the
         driver's radcan(rat()) fallback) */
      f : (A+B*log(e*(a+b*x)^2/(c+d*x)^2))/(a*g+b*g*x)^2,
      ans : rubi(f, x),
      check_not("c4 e124 not a noun",
                is(atom(ans)) or is(op(ans) = 'integrate)
                or is(string(op(ans)) = "unintegrable")),
      z : errcatch(ratsimp(diff(ans, x) - f)),
      check_bool("c4 e124 self-diff (ratsimp)",
                 is(z # []) and is(part(z, 1) = 0)),
      z : errcatch(radcan(rat(diff(ans, x) - f))),
      check_bool("c4 e124 self-diff (driver radcan(rat()) fallback)",
                 is(z # []) and is(part(z, 1) = 0)),
      /* answer level: e210 (r18) non-noun, no nested no-answer noun */
      f : (a*g+b*g*x)^4*(A+B*log(e*(c+d*x)^2/(a+b*x)^2))^2,
      ans : rubi(f, x),
      check_not("c4 e210 not a noun",
                is(atom(ans)) or is(op(ans) = 'integrate)
                or is(string(op(ans)) = "unintegrable")),
      check_bool("c4 e210 has no nested no-answer noun", freeof('unintegrable, ans)),
      mr_rule_table : saved_table,
      true
     )$

    /* Task 4C-C3 (class-3 deferred campaign, 2026-09-02) — the ratio
    log-arg rules 3.2.1 r15, 3.2.2 r3/r5, 3.2.3 r5 on the stored Quotient
    forms. The defmatch runner 0-bound them (99 entries) and needed the
    %mr_logratio[_sq]_match structural matchers; MR-MATCH binds the faithful
    patterns, and %mr_rule_accept reads the binding the cond accepts. e104's
    accepted binding is e := (b*e-a*f)/(d*e-c*f), f := 1, p := -1, q := 1
    (the defmatch-era pin had e := b*e-a*f, f := 1/(d*e-c*f)); both make
    the repl's log-arg re-expand to the stored argument. The numeric-k
    distributed quotient e*(a+b*x)^2/(c+d*x)^2 does not bind r15's
    e*((a+b*x)/(c+d*x))^n — a power of a quotient is not a product of
    powers — and r16 covers it (test_class3_c4_321). Bindings measured in
    the plan-2 pre-validation (probe_rewrite.mac, 2026-09-13). The
    answer-level reps run on the default 1.1.1.1 + the three 3.2.x
    families: e93 verifies at the driver's numeric stage, e10 at factor. */
    test_class3_c3_ratio() := block([ans, z, n1, n2, D, saved_table, f, mm],
      print("--- c3: ratio log-arg (C3) ---"),
      %mr_load_sibling("rules/class3/3_2_1.mac", 'mr_witness_3_2_1),
      %mr_load_sibling("rules/class3/3_2_2.mac", 'mr_witness_3_2_2),
      %mr_load_sibling("rules/class3/3_2_3.mac", 'mr_witness_3_2_3),
      saved_table : mr_rule_table,
      mr_rule_table : flatten([mr_rule_table, mr_rules_3_2_1, mr_rules_3_2_2, mr_rules_3_2_3]),
      /* e93 (3.2.1 r15) */
      mm : %mr_rule_accept(_mr_rule_3_2_1_r15, (A+B*log(e*(a+b*x)/(c+d*x)))/(a*g+b*g*x)^2, x),
      check_bool("c3 e93 accepts (3.2.1 r15)", listp(mm)),
      check_bool("c3 e93 f=a*g g=b*g m=-2 n=1 p=1",
                 binds(mm, ['_mr_3_2_1_r15_f = a*g, '_mr_3_2_1_r15_g = b*g, '_mr_3_2_1_r15_m = -2,
                            '_mr_3_2_1_r15_n = 1, '_mr_3_2_1_r15_p = 1])),
      check_bool("c3 e93 A,B,e + a,b,c,d",
                 binds(mm, ['_mr_3_2_1_r15_A = A, '_mr_3_2_1_r15_B = B, '_mr_3_2_1_r15_e = e,
                            '_mr_3_2_1_r15_a = a, '_mr_3_2_1_r15_b = b, '_mr_3_2_1_r15_c = c,
                            '_mr_3_2_1_r15_d = d])),
      /* e10 (3.2.2 r3): the two-head integrand */
      mm : %mr_rule_accept(_mr_rule_3_2_2_r3, (a*g+b*g*x)^3*(c*i+d*i*x)^2*(A+B*log(e*(a+b*x)/(c+d*x))), x),
      check_bool("c3 e10 accepts (3.2.2 r3)", listp(mm)),
      check_bool("c3 e10 f=a*g g=b*g m=3 h=c*i i=d*i q=2",
                 binds(mm, ['_mr_3_2_2_r3_f = a*g, '_mr_3_2_2_r3_g = b*g, '_mr_3_2_2_r3_m = 3,
                            '_mr_3_2_2_r3_h = c*i, '_mr_3_2_2_r3_i = d*i, '_mr_3_2_2_r3_q = 2])),
      check_bool("c3 e10 A,B,e,n=1,p=1 + a,b,c,d",
                 binds(mm, ['_mr_3_2_2_r3_A = A, '_mr_3_2_2_r3_B = B, '_mr_3_2_2_r3_e = e,
                            '_mr_3_2_2_r3_n = 1, '_mr_3_2_2_r3_p = 1, '_mr_3_2_2_r3_a = a,
                            '_mr_3_2_2_r3_b = b, '_mr_3_2_2_r3_c = c, '_mr_3_2_2_r3_d = d])),
      /* e214 (3.2.2 r5): the symbolic-n Times[e, Power[Quotient, n]] form */
      mm : %mr_rule_accept(_mr_rule_3_2_2_r5, (a*g+b*g*x)^m*(c*i+d*i*x)^(-2-m)*(A+B*log(e*((a+b*x)/(c+d*x))^n)), x),
      check_bool("c3 e214 accepts (3.2.2 r5, symbolic-n form)", listp(mm)),
      check_bool("c3 e214 m free q=-2-m n free p=1",
                 binds(mm, ['_mr_3_2_2_r5_m = m, '_mr_3_2_2_r5_q = -2-m,
                            '_mr_3_2_2_r5_n = n, '_mr_3_2_2_r5_p = 1])),
      /* e104 (3.2.3 r5): the squared-log integrand */
      mm : %mr_rule_accept(_mr_rule_3_2_3_r5, log((b*e-a*f)*(c+d*x)/((d*e-c*f)*(a+b*x)))^2/(a+b*x), x),
      check_bool("c3 e104 accepts (3.2.3 r5)", listp(mm)),
      check_bool("c3 e104 a-d + e=C1/C2 f=1 g=a h=b p=-1 q=1 r=1",
                 binds(mm, ['_mr_3_2_3_r5_a = a, '_mr_3_2_3_r5_b = b, '_mr_3_2_3_r5_c = c,
                            '_mr_3_2_3_r5_d = d, '_mr_3_2_3_r5_e = (b*e-a*f)/(d*e-c*f),
                            '_mr_3_2_3_r5_f = 1, '_mr_3_2_3_r5_g = a, '_mr_3_2_3_r5_h = b,
                            '_mr_3_2_3_r5_p = -1, '_mr_3_2_3_r5_q = 1, '_mr_3_2_3_r5_r = 1])),
      z : if is(listp(mm)) then
        errcatch(rat(geteqR(mm, '_mr_3_2_3_r5_e)
                     *(geteqR(mm, '_mr_3_2_3_r5_f)*(geteqR(mm, '_mr_3_2_3_r5_a)+geteqR(mm, '_mr_3_2_3_r5_b)*x)^geteqR(mm, '_mr_3_2_3_r5_p)
                       *(geteqR(mm, '_mr_3_2_3_r5_c)+geteqR(mm, '_mr_3_2_3_r5_d)*x)^geteqR(mm, '_mr_3_2_3_r5_q))^geteqR(mm, '_mr_3_2_3_r5_r)
             - (b*e-a*f)*(c+d*x)/((d*e-c*f)*(a+b*x))))
      else [],
      check_bool("c3 e104 repl log-arg re-expands the stored arg",
                 is(z # []) and is(part(z, 1) = 0)),
      /* cross-rule rejections */
      check_not("c3 3.2.2 r3 does not bind the 3.2.3 squared-log integrand",
                %mr_rule_bindings(_mr_rule_3_2_2_r3, log((b*e-a*f)*(c+d*x)/((d*e-c*f)*(a+b*x)))^2/(a+b*x), x)),
      check_not("c3 3.2.1 r15 does not bind the two-head integrand",
                %mr_rule_bindings(_mr_rule_3_2_1_r15, (a*g+b*g*x)^3*(c*i+d*i*x)^2*(A+B*log(e*(a+b*x)/(c+d*x))), x)),
      check_not("c3 3.2.3 r5 does not bind the 3.2.1 ratio integrand",
                %mr_rule_bindings(_mr_rule_3_2_3_r5, (A+B*log(e*(a+b*x)/(c+d*x)))/(a*g+b*g*x)^2, x)),
      /* the free-k distributed quotient (e226 shape) does not bind r5 */
      check_not("c3 declines the free-k distributed quotient (e226 shape)",
                %mr_rule_bindings(_mr_rule_3_2_2_r5, (a*g+b*g*x)^m*(c*i+d*i*x)^(-2-m)*(A+B*log(e*(a+b*x)^n/(c+d*x)^n))^p, x)),
      check_not("c3 r15 declines the numeric-k distributed quotient (r16's form)",
                %mr_rule_bindings(_mr_rule_3_2_1_r15, (A+B*log(e*(a+b*x)^2/(c+d*x)^2))/(a*g+b*g*x)^2, x)),
      /* answer level: e93 — the driver's numeric stage (two points,
         resid < 1e-9) */
      f : (A+B*log(e*(a+b*x)/(c+d*x)))/(a*g+b*g*x)^2,
      ans : rubi(f, x),
      check_not("c3 e93 not a noun",
                is(atom(ans)) or is(op(ans) = 'integrate)
                or is(string(op(ans)) = "unintegrable")),
      /* materialize the diff BEFORE the ev (the driver's measured quirk: ev
         over a still-unevaluated diff(mr_r, x) substitutes x into the diff's
         variable argument and errors) */
      D : diff(ans, x) - f,
      n1 : errcatch(float(ev(D, [a=0.9, b=1.3, c=0.5, d=0.9, e=1.1, g=1.7, A=0.6, B=1.4, x=0.35]))),
      n2 : errcatch(float(ev(D, [a=0.9, b=1.3, c=0.5, d=0.9, e=1.1, g=1.7, A=0.6, B=1.4, x=0.65]))),
      check_bool("c3 e93 self-diff numeric two-point (driver stage)",
                 is(n1 # []) and is(n2 # [])
                 and is(abs(part(n1, 1)) < 1e-9) and is(abs(part(n2, 1)) < 1e-9)),
      /* answer level: e10 — closes at factor */
      f : (a*g+b*g*x)^3*(c*i+d*i*x)^2*(A+B*log(e*(a+b*x)/(c+d*x))),
      ans : rubi(f, x),
      check_not("c3 e10 not a noun",
                is(atom(ans)) or is(op(ans) = 'integrate)
                or is(string(op(ans)) = "unintegrable")),
      z : errcatch(factor(diff(ans, x) - f)),
       check_bool("c3 e10 self-diff (factor, the driver's first symbolic stage)",
                  is(z # []) and is(part(z, 1) = 0)),
       mr_rule_table : saved_table,
       true
     )$

    /* Task 4B-B3 — the 3_3 binomial-power covers: a (f+g x^r)^q factor
    times/over an (a+b log(c (d+e x)^n))^p factor. The defmatch runner
    0-bound every stored form (two structured sub-patterns) and needed the
    M1 slot re-emission with %mr_mbp_unwrap / %mr_mbp_base recovery;
    MR-MATCH binds the faithful patterns, so the checks read the captures
    directly (plan-2 pre-validation, probe_layerA_bind2.mac, 2026-09-13).
    The answer-level rep runs on the default 1.1.1.1 + 3_1_x + 3_3 + the
    3.2.x families in production order: without the 3_1_x files the
    reduction's sub-integral reaches the 3_3 r61 Unintegrable catch-all
    first (probe_tables.mac). */
    test_class3_b3_33() := block([saved_table, mm, f, ans, z],
      print("--- b3: 3_3 binomial-power covers ---"),
      %mr_load_sibling("rules/class3/3_1_1.mac", 'mr_witness_3_1_1),
      %mr_load_sibling("rules/class3/3_1_2.mac", 'mr_witness_3_1_2),
      %mr_load_sibling("rules/class3/3_1_3.mac", 'mr_witness_3_1_3),
      %mr_load_sibling("rules/class3/3_1_4.mac", 'mr_witness_3_1_4),
      %mr_load_sibling("rules/class3/3_1_5.mac", 'mr_witness_3_1_5),
      %mr_load_sibling("rules/class3/3_3.mac", 'mr_witness_3_3),
      %mr_load_sibling("rules/class3/3_2_1.mac", 'mr_witness_3_2_1),
      %mr_load_sibling("rules/class3/3_2_2.mac", 'mr_witness_3_2_2),
      %mr_load_sibling("rules/class3/3_2_3.mac", 'mr_witness_3_2_3),
      saved_table : mr_rule_table,
      mr_rule_table : flatten([mr_rule_table, mr_rules_3_1_1, mr_rules_3_1_2, mr_rules_3_1_3,
                               mr_rules_3_1_4, mr_rules_3_1_5, mr_rules_3_3, mr_rules_3_2_1,
                               mr_rules_3_2_2, mr_rules_3_2_3]),
      /* r11 (quotient): e88 / e90 */
      mm : %mr_rule_bindings(_mr_rule_3_3_r11, (f+g*x)^3/(a+b*log(c*(d+e*x)^n)), x),
      check_bool("b3 r11 binds e88 (quotient, q=3)", listp(mm)),
      check_bool("b3 r11 binds base (f, g) and q=3",
                 binds(mm, ['_mr_3_3_r11_f = f, '_mr_3_3_r11_g = g, '_mr_3_3_r11_q = 3])),
      mm : %mr_rule_bindings(_mr_rule_3_3_r11, (f+g*x)/(a+b*log(c*(d+e*x)^n)), x),
      check_bool("b3 r11 binds e90 (bare numerator, q=1)", listp(mm)),
      check_bool("b3 r11 bare numerator binds (f, g) and q=1",
                 binds(mm, ['_mr_3_3_r11_f = f, '_mr_3_3_r11_g = g, '_mr_3_3_r11_q = 1])),
      /* r10 (product): e156, both factors sqrt nodes */
      mm : %mr_rule_bindings(_mr_rule_3_3_r10, sqrt(f+g*x)*sqrt(a+b*log(c*(d+e*x)^n)), x),
      check_bool("b3 r10 binds e156 (both-sqrt product)", listp(mm)),
      check_bool("b3 r10 binds (f, g), q=1/2, p=1/2",
                 binds(mm, ['_mr_3_3_r10_f = f, '_mr_3_3_r10_g = g,
                            '_mr_3_3_r10_q = 1/2, '_mr_3_3_r10_p = 1/2])),
      /* r20: (f+g*x^r)^q factor */
      mm : %mr_rule_bindings(_mr_rule_3_3_r20, (f+g*x^(1/2))^2*(a+b*log(c*(d+e*x)^n))^3, x),
      check_bool("b3 r20 binds the slotted-base rep (r=1/2, q=2)", listp(mm)),
      check_bool("b3 r20 binds (f, g, r=1/2), q=2, p=3",
                 binds(mm, ['_mr_3_3_r20_f = f, '_mr_3_3_r20_g = g, '_mr_3_3_r20_r = 1/2,
                            '_mr_3_3_r20_q = 2, '_mr_3_3_r20_p = 3])),
      /* r25: x^m head kept */
      mm : %mr_rule_bindings(_mr_rule_3_3_r25, x*(f+g*x^(1/2))^2*(a+b*log(c*(d+e*x)^n))^3, x),
      check_bool("b3 r25 binds the x^m-head rep (m=1, r=1/2, q=2)", listp(mm)),
      check_bool("b3 r25 binds m=1, (f, g, r=1/2), q=2",
                 binds(mm, ['_mr_3_3_r25_m = 1, '_mr_3_3_r25_f = f, '_mr_3_3_r25_g = g,
                            '_mr_3_3_r25_r = 1/2, '_mr_3_3_r25_q = 2])),
      /* rejections */
      check_not("b3 r11 does not bind a product (not a quotient)",
                %mr_rule_bindings(_mr_rule_3_3_r11, (f+g*x)^3*(a+b*log(c*(d+e*x)^n)), x)),
      check_not("b3 r10 does not bind the (f+g/x) base",
                %mr_rule_bindings(_mr_rule_3_3_r10, x^2*(f+g/x)^2*(a+b*log(c*(d+e*x)^n))^2, x)),
      check_not("b3 r10 does not bind the r46 two-log-factor shape",
                %mr_rule_bindings(_mr_rule_3_3_r10, (k+l*x)^r*(a+b*log(c*(d+e*x)^n))
                                                    *(f+g*log(h*(i+j*x)^m)), x)),
      /* the reduction fires on e88 */
      check_bool("b3 r11 reduction fires on e88",
                 is(%mr_rule_apply(_mr_rule_3_3_r11, (f+g*x)^3/(a+b*log(c*(d+e*x)^n)), x)
                    # false)),
      /* answer-level zero-chain: the integer-power product rep (r10, q=2
         p=2); factor(diff - f) = 0 (the driver's symbolic stage) */
      f : (f+g*x)^2*(a+b*log(c*(d+e*x)^n))^2,
      ans : rubi(f, x),
      check_not("b3 e-r10-int not a top noun",
                is(atom(ans)) or is(op(ans) = 'integrate)
                or is(string(op(ans)) = "unintegrable")),
      z : errcatch(factor(diff(ans, x) - f)),
      check_bool("b3 e-r10-int self-diff zero (factor)",
                 is(z # []) and is(part(z, 1) = 0)),
      mr_rule_table : saved_table,
      true
    )$

    /* Task 4C-C5 — the 3_4 slotted inner exponents (128 entries):
    x^m (a+b log(c (d+e x^n)^p))^q with a sqrt / cbrt / reciprocal inner
    exponent on the stored forms. The defmatch runner needed the mly / m1b
    slot re-emission with %mr_lpfac_parse recovery; MR-MATCH binds the
    faithful r8 / r4 patterns, so the checks read the captures directly
    (plan-2 pre-validation, probe_layerA_bind2.mac, 2026-09-13). A 5*x^2
    head declines: the x_^m_. item cannot absorb the 5. The answer-level
    reps run on the default 1.1.1.1 + 3_1_x + 3_3 + 3_4 in production order:
    without the 3_1_x files the reduction's sub-integral reaches the 3_3 r61
    Unintegrable catch-all first (probe_tables.mac). */
    test_class3_c5_34() := block([saved_table, mm, f, ans, z],
      print("--- c5: 3_4 slotted inner exponent ---"),
      %mr_load_sibling("rules/class3/3_1_1.mac", 'mr_witness_3_1_1),
      %mr_load_sibling("rules/class3/3_1_2.mac", 'mr_witness_3_1_2),
      %mr_load_sibling("rules/class3/3_1_3.mac", 'mr_witness_3_1_3),
      %mr_load_sibling("rules/class3/3_1_4.mac", 'mr_witness_3_1_4),
      %mr_load_sibling("rules/class3/3_1_5.mac", 'mr_witness_3_1_5),
      %mr_load_sibling("rules/class3/3_3.mac", 'mr_witness_3_3),
      %mr_load_sibling("rules/class3/3_4.mac", 'mr_witness_3_4),
      saved_table : mr_rule_table,
      mr_rule_table : flatten([mr_rule_table, mr_rules_3_1_1, mr_rules_3_1_2, mr_rules_3_1_3,
                               mr_rules_3_1_4, mr_rules_3_1_5, mr_rules_3_3, mr_rules_3_4]),
      /* r8 (head x^m): sqrt inner exponent */
      mm : %mr_rule_bindings(_mr_rule_3_4_r8, x^2*(a+b*log(c*(d+e*sqrt(x))^n))^2, x),
      check_bool("c5 r8 binds sqrt-inner head x^2", listp(mm)),
      check_bool("c5 r8 head exponent m=2", binds(mm, ['_mr_3_4_r8_m = 2])),
      check_bool("c5 r8 binds (a,b,c,d,e, inner n=1/2, p=n, q=2)",
                 binds(mm, ['_mr_3_4_r8_a = a, '_mr_3_4_r8_b = b, '_mr_3_4_r8_c = c,
                            '_mr_3_4_r8_d = d, '_mr_3_4_r8_e = e, '_mr_3_4_r8_n = 1/2,
                            '_mr_3_4_r8_p = n, '_mr_3_4_r8_q = 2])),
      /* reciprocal inner exponent: 1/sqrt(x) -> n = -1/2 */
      check_bool("c5 r8 recip-inner binds n=-1/2",
                 binds(%mr_rule_bindings(_mr_rule_3_4_r8, x*(a+b*log(c*(d+e*(1/sqrt(x)))^n))^2, x),
                       ['_mr_3_4_r8_n = -1/2, '_mr_3_4_r8_m = 1])),
      /* r4 (no head) */
      mm : %mr_rule_bindings(_mr_rule_3_4_r4, (a+b*log(c*(d+e*sqrt(x))^n))^2, x),
      check_bool("c5 r4 binds bare sqrt-inner (q=2)",
                 binds(mm, ['_mr_3_4_r4_n = 1/2, '_mr_3_4_r4_q = 2])),
      check_not("c5 r8 does not bind the 5*x^2 head",
                %mr_rule_bindings(_mr_rule_3_4_r8, 5*x^2*(a+b*log(c*(d+e*sqrt(x))^n))^2, x)),
      /* the reduction fires on the row-408 rep */
      check_bool("c5 r8 reduction fires on row-408 rep",
                 is(%mr_rule_apply(_mr_rule_3_4_r8, x^2*(a+b*log(c*(d+e*sqrt(x))^n))^2, x) # false)),
      /* answer-level zero-chain 1: row 408 (sqrt, head x^2, q=2) */
      f : x^2*(a+b*log(c*(d+e*sqrt(x))^n))^2,
      ans : rubi(f, x),
      check_not("c5 row-408 not a top noun",
                is(atom(ans)) or is(op(ans) = 'integrate)
                or is(string(op(ans)) = "unintegrable")),
      z : errcatch(factor(diff(ans, x) - f)),
      check_bool("c5 row-408 self-diff zero (factor)",
                 is(z # []) and is(part(z, 1) = 0)),
      /* answer-level zero-chain 2: row 450 (cbrt, head x, q=2) */
      f : x*(a+b*log(c*(d+e*x^(1/3))^n))^2,
      ans : rubi(f, x),
      check_not("c5 row-450 not a top noun",
                is(atom(ans)) or is(op(ans) = 'integrate)
                or is(string(op(ans)) = "unintegrable")),
      z : errcatch(factor(diff(ans, x) - f)),
      check_bool("c5 row-450 self-diff zero (factor)",
                 is(z # []) and is(part(z, 1) = 0)),
       mr_rule_table : saved_table,
       true
     )$

    /* Task 4C-C6 M-cas-simp (3.5 r10): the .m cond EqQ[D[Px/Qx, x], 0]
       tests that the ratio Px/Qx is a constant. Maxima's diff does not
       auto-simplify the derivative of a constant ratio to 0 (the e92
       binding c*x^2+a over c*e*x^2+a*e leaves a non-zero rational), so
       the faithful port is ratsimp on the derivative. The GREEN pin is a
       NON-constant ratio that must stay rejected. */
    test_class3_c6_cassimp() := block([mm, fc],
      print("--- c6: M-cas-simp 3.5 r10 cond ratsimp (e92/e93) ---"),
      %mr_load_sibling("rules/class3/3_5.mac", 'mr_witness_3_5),
      /* e92: Px = c*x^2+a, Qx = c*e*x^2+a*e -> ratio 1/e (constant,
         non-trivial); diff(Px/Qx) is a non-zero rational, ratsimp -> 0. */
      mm : %mr_rule_accept(_mr_rule_3_5_r10, log(d*(a+c*x^2)^n)/(a*e+c*e*x^2), x),
      check_bool("c6 r10 e92 binds", listp(mm)),
      check_bool("c6 r10 e92 cond true (ratsimp fix)",
                 is(listp(mm)) and _mr_cond_3_5_r10(mm, x)),
      /* e93: linear+quadratic (the b*x term). */
      mm : %mr_rule_accept(_mr_rule_3_5_r10, log(d*(a+b*x+c*x^2)^n)/(a*e+b*e*x+c*e*x^2), x),
      check_bool("c6 r10 e93 binds", listp(mm)),
      check_bool("c6 r10 e93 cond true (ratsimp fix)",
                 is(listp(mm)) and _mr_cond_3_5_r10(mm, x)),
      /* GREEN pin: Qx = 2+3*x^2 vs Px = a+c*x^2 is a NON-constant ratio;
         the ratsimp must not over-fire (measured probes c6 D12/D13). */
      mm : %mr_rule_bindings(_mr_rule_3_5_r10, log(d*(a+c*x^2)^n)/(2+3*x^2), x),
      check_bool("c6 r10 neg ratio binds", listp(mm)),
      check_not("c6 r10 neg ratio cond stays false",
                is(listp(mm)) and _mr_cond_3_5_r10(mm, x)),
      /* answer-level engagement: a concrete positive instance (no sign
         query) now FIRES the rule (previously the false cond declined
         every e92-shape binding). */
      fc : log(3*(1+x^2)^2)/(2+2*x^2),
      check_bool("c6 r10 concrete e92 fires",
                 is(%mr_rule_apply(_mr_rule_3_5_r10, fc, x) # false)),
      true
    )$

    /* Task 4C-C6b (3.5 r42, the .m 3.5.m L46 FunctionOfLog catch-all,
       class-3 deferred campaign C6b): the new-rule port of the
       M-functionoflog wave group (13 entries). The rule is the
       non-ShowSteps branch of the .m's
       If[TrueQ[$LoadShowSteps], …] wrapper (the branch-selection
       decision: in the port the two branches are semantically
       identical — the ShowStep handler values ShowStep to its held
       4th arg = the plain branch's body, and the ShowStep branch's
       extra SimplifyFlag gate is mr_simplify_flag, constant true —
       see the report and the generator's unwrap_showsteps_line).
       The decomposition contract: FunctionOfLog[u, x] = [f, a*x^n,
       n] iff u is a function of log(a*x^n) with the log argument
       replaced by x in f; the repl is 1/n * Subst[Int[f, x], x,
       log(a*x^n)]. The three answer-level reps span the wave table's
       shapes (e134 the sqrt-rational f, e139 the pure-Subst f, e258
       the polynomial-in-t f); measured 2026-09-04 on
       branch_5_50_base_84_g4204fb669 / SBCL 2.6.7: on this minimal
       table the nested mr_int 0-fires and takes the native
       integrate fall-through (the same antiderivative family the
       .m rule would produce; e139/e258 land on the suite's expected
       answer form exactly, e134 lands on a log form that
       ratsimp-closes against the suite's atanh form). */
    test_class3_c6b_functionoflog() := block([mm, f, ans, z, saved_table],
      print("--- c6b: 3.5 r42 FunctionOfLog catch-all (e134/e139/e258) ---"),
      %mr_load_sibling("rules/class3/3_5.mac", 'mr_witness_3_5),
      /* predicate level: the three wave-shape decompositions
         (t = log(a*x^n); the log argument is replaced by x in f). */
      check("c6b fOL e134 shape (f = 1/sqrt(t^2-3), a = 1, n = 1)",
            %mr_functionOfLog(%mr_cancel(x*(1/(x*sqrt(-3+log(x)^2)))), x),
            [1/sqrt(x^2-3), x, 1]),
      check("c6b fOL e139 shape (f = 2^t)",
            %mr_functionOfLog(2^log(x), x), [2^x, x, 1]),
      check("c6b fOL e258 shape (f = 1/(1+t+t^2), a = 7, n = 1)",
            %mr_functionOfLog(%mr_cancel(x*(1/(x+x*log(7*x)+x*log(7*x)^2))), x),
            [1/(x^2+x+1), 7*x, 1]),
      /* the .m's decline clauses: the bare variable is not a log
         function; no log at all; two DIFFERENT log arguments. */
      check_not("c6b fOL bare x declines", %mr_functionOfLog(x, x)),
      check_not("c6b fOL no-log declines", %mr_functionOfLog(sin(x), x)),
      check_not("c6b fOL two log args declines",
                %mr_functionOfLog(log(x) + log(1+x), x)),
      /* the outer cond's NonsumQ gate and the LogQ head test. */
      check_not("c6b nonsumQ rejects a sum", %mr_nonsumQ(1+x)),
      check_bool("c6b nonsumQ accepts a power", %mr_nonsumQ(x^2)),
      check_bool("c6b logQ the log head", %mr_logQ(log(x))),
      check_not("c6b logQ rejects the power over log", %mr_logQ(log(x)^2)),
      /* pattern level: the single u_ catch-all slot binds the whole
         integrand (the geteqR idiom); the cond is the NonsumQ gate. */
      mm : %mr_rule_bindings(_mr_rule_3_5_r42, 1/(x*sqrt(-3+log(x)^2)), x),
      check_bool("c6b r42 e134 binds", listp(mm)),
      check_bool("c6b r42 e134 u capture (geteqR)",
                 listp(mm) and is(geteqR(mm, '_mr_3_5_r42_u)
                 = 1/(x*sqrt(-3+log(x)^2)))),
      check_bool("c6b r42 e134 cond true",
                 is(listp(mm)) and _mr_cond_3_5_r42(mm, x)),
      /* GREEN pin for the NonsumQ cond: the u_ slot binds a sum
         integrand too, but the cond must decline it (the .m's outer
         /; NonsumQ[u] — the sum shapes are another wave group's). */
      mm : %mr_rule_bindings(_mr_rule_3_5_r42, 1 + 1/(x*sqrt(-3+log(x)^2)), x),
      check_bool("c6b r42 sum integrand binds", listp(mm)),
      check_not("c6b r42 sum integrand cond false (NonsumQ)",
                is(listp(mm)) and _mr_cond_3_5_r42(mm, x)),
      /* answer level: rubi() on the three reps, non-noun + the
         driver's ratsimp zero-chain stage. */
      saved_table : mr_rule_table,
      mr_rule_table : flatten([mr_rule_table, mr_rules_3_5]),
      f : 1/(x*sqrt(-3+log(x)^2)),
      ans : rubi(f, x),
      check_not("c6b e134 not a noun",
                is(atom(ans)) or is(op(ans) = 'integrate)
                or is(string(op(ans)) = "unintegrable")),
      z : errcatch(ratsimp(diff(ans, x) - f)),
      check_bool("c6b e134 zero-chain (ratsimp)",
                 is(z # []) and is(part(z, 1) = 0)),
      f : 2^log(x)/x,
      ans : rubi(f, x),
      check_not("c6b e139 not a noun",
                is(atom(ans)) or is(op(ans) = 'integrate)
                or is(string(op(ans)) = "unintegrable")),
      check_bool("c6b e139 is the suite answer form",
                 is(ans = 2^log(x)/log(2))),
      z : errcatch(ratsimp(diff(ans, x) - f)),
      check_bool("c6b e139 zero-chain (ratsimp)",
                 is(z # []) and is(part(z, 1) = 0)),
      f : 1/(x+x*log(7*x)+x*log(7*x)^2),
      ans : rubi(f, x),
      check_not("c6b e258 not a noun",
                is(atom(ans)) or is(op(ans) = 'integrate)
                or is(string(op(ans)) = "unintegrable")),
      check_bool("c6b e258 is the suite answer form",
                 is(ans = 2*atan((1+2*log(7*x))/sqrt(3))/sqrt(3))),
      z : errcatch(ratsimp(diff(ans, x) - f)),
      check_bool("c6b e258 zero-chain (ratsimp)",
                 is(z # []) and is(part(z, 1) = 0)),
      mr_rule_table : saved_table,
      true
    )$

    /* Task 7a cluster B — the int-family + binomial predicates. The
    binomialQ / intBinomialQ probes go through the LISP dispatchers
    (maxima_rubi_dispatch.lisp) — a dispatcher miss leaves the calls
    as nouns and these checks fail loudly. Expected values are
    hand-computed from the pinned Rubi definitions (provenance in
    maxima_rubi_utils.mac). */
 test_int_family_predicates() := block([],
   print("--- int-family + binomial predicates (cluster B) ---"),
   check_bool("binomialQ 3+5x^2 (a=3, b=5, n=2)",
              %mr_binomialQ(3 + 5*x^2, x)),
   check_bool("binomialQ x^2 (a=0 branch)", %mr_binomialQ(x^2, x)),
   check_not("binomialQ x+x^2 (exps {1,2}, no constant)",
             %mr_binomialQ(x + x^2, x)),
   check_not("binomialQ constant (Exponent 0)", %mr_binomialQ(5, x)),
   check_bool("binomialQ sqrt(x) (stored collapsed 1/2 power, n=1/2)",
              %mr_binomialQ(x^(1/2), x)),
   check_bool("binomialQ x^(3/2) (stored fractional power, n=3/2)",
              %mr_binomialQ(x^(3/2), x)),
   /* the reciprocal-power deviation: 1/x stores as a "/" node here,
      not x^(-1); the port accepts it as a = 0, b = 1, n = -1 */
   check_bool("binomialQ 1/x (a=0, n=-1)", %mr_binomialQ(1/x, x)),
   check_bool("binomialQ 1+1/x (sum branch over reciprocal)",
              %mr_binomialQ(1 + 1/x, x)),
   check_bool("binomialQ 5(1+x^2) (product branch)",
              %mr_binomialQ(5*(1 + x^2), x)),
   check_not("binomialQ 5x+5x^3 (not a+b x^n)",
             %mr_binomialQ(5*x + 5*x^3, x)),
   check_bool("binomialQ list arg, all binomials",
              %mr_binomialQ([3 + x, x^2], x)),
   check_not("binomialQ list arg, one not",
             %mr_binomialQ([3 + x, x + x^2], x)),
   check_bool("binomialQ3 n matches (3+5x^2, n=2)",
              %mr_binomialQ(3 + 5*x^2, x, 2)),
   check_not("binomialQ3 n differs (3+5x^2, n=3)",
             %mr_binomialQ(3 + 5*x^2, x, 3)),
   /* intLinearQ (fixed 7-arg; a-d unused, as in the .m) */
   check_bool("intLinearQ m>0 (m=2, n=-1)",
              %mr_intLinearQ(1, 1, 1, 1, 2, -1, x)),
   check_bool("intLinearQ IntegersQ[4m,4n] (m=1/2, n=-1/2)",
              %mr_intLinearQ(1, 1, 1, 1, 1/2, -1/2, x)),
   check_bool("intLinearQ ILtQ[m+n,-1] (m=n=-2)",
              %mr_intLinearQ(1, 1, 1, 1, -2, -2, x)),
   check_bool("intLinearQ IntegerQ[m+n]&&RationalQ[m] (m+n=1)",
              %mr_intLinearQ(1, 1, 1, 1, 1/10, 9/10, x)),
   check_not("intLinearQ no disjunct (m=1/2, n=1/5)",
             %mr_intLinearQ(1, 1, 1, 1, 1/2, 1/5, x)),
   /* intQuadraticQ (fixed 8-arg) */
   check_bool("intQuadraticQ IntegerQ[p] (p=3)",
              %mr_intQuadraticQ(1, 1, 1, 1, 1, 1/2, 3, x)),
   check_bool("intQuadraticQ IGtQ[m,0] (m=1)",
              %mr_intQuadraticQ(1, 1, 1, 1, 1, 1, 1/2, x)),
   check_bool("intQuadraticQ IntegersQ[m,4p] (m=-1, p=1/4)",
              %mr_intQuadraticQ(1, 1, 1, 1, 1, -1, 1/4, x)),
   check_bool("intQuadraticQ [m,p+1/3] + 2nd EqQ (a=2/9)",
              %mr_intQuadraticQ(2/9, 1, 1, 1, 1, -1, 2/3, x)),
   check_not("intQuadraticQ same exponents, EqQs fail (a=1)",
             %mr_intQuadraticQ(1, 1, 1, 1, 1, -1, 2/3, x)),
   check_not("intQuadraticQ no disjunct (m=1/2, p=1/3)",
             %mr_intQuadraticQ(1, 1, 1, 1, 1, 1/2, 1/3, x)),
   /* intBinomialQ (Lisp-dispatched 7/8/10-arg) */
   check_bool("intBinomialQ7 IGtQ[p,0] (p=2)",
              %mr_intBinomialQ(1, 1, 1, 2, -5, 2, x)),
   check_bool("intBinomialQ7 RationalQ[m]&&IntegersQ[n,2p] (n=2, p=-1)",
              %mr_intBinomialQ(1, 1, 1, 2, 1/2, -1, x)),
   check_bool("intBinomialQ7 n=4&&IntegersQ[2m,4p] (m=1/2, p=-1/4)",
              %mr_intBinomialQ(1, 1, 1, 4, 1/2, -1/4, x)),
   check_bool("intBinomialQ7 n=2&&IntegerQ[6p]&&IntegerQ[m] (p=1/6, m=1)",
              %mr_intBinomialQ(1, 1, 1, 2, 1, 1/6, x)),
   check_not("intBinomialQ7 no disjunct (m=sqrt(2), p=-1/4)",
             %mr_intBinomialQ(1, 1, 1, 2, sqrt(2), -1/4, x)),
   /* the n = 0 guard: Maxima hard-errors (m+1)/0 where Mathematica's
      Infinity answers false — the guard must suppress it and fail
      closed, not crash the batch */
   check_not("intBinomialQ7 n=0 (no crash, fails closed)",
             %mr_intBinomialQ(1, 1, 1, 0, 1/3, -1/4, x)),
   check_bool("intBinomialQ8 IntegersQ[p,q] (p=1, q=-3)",
              %mr_intBinomialQ(1, 1, 1, 1, 2, 1, -3, x)),
   check_bool("intBinomialQ8 n=4&&IntegersQ[4p,q] (p=-1/2, q=-1)",
              %mr_intBinomialQ(1, 1, 1, 1, 4, -1/2, -1, x)),
   check_bool("intBinomialQ8 n=2&&IntegersQ[p,3q]&&3bc+ad=0 (a=3, d=-1)",
              %mr_intBinomialQ(3, 1, 1, -1, 2, -1, -1/3, x)),
   check_not("intBinomialQ8 no disjunct (n=3, p=1/3, q=-1/2)",
             %mr_intBinomialQ(1, 1, 1, 1, 3, 1/3, -1/2, x)),
   check_bool("intBinomialQ10 IntegersQ[p,q] (p=-1, q=2)",
              %mr_intBinomialQ(1, 1, 1, 1, 1, 1, 2, -1, 2, x)),
   check_bool("intBinomialQ10 n=2&&IntegersQ[m,2p,2q] (m=-1, p=q=-1/2)",
              %mr_intBinomialQ(1, 1, 1, 1, 1, -1, 2, -1/2, -1/2, x)),
   check_bool("intBinomialQ10 n=4&&IntegersQ[m,p,2q] (p=-1, q=-1/2)",
              %mr_intBinomialQ(1, 1, 1, 1, 1, -1, 4, -1, -1/2, x)),
   check_bool("intBinomialQ10 n=2&&[m/2,p+1/3,q]&&bc+3ad=0 (b=3, d=-1)",
              %mr_intBinomialQ(1, 3, 1, -1, 1, -2, 2, 2/3, -1, x)),
   check_bool("intBinomialQ10 n=3&&[(m-1)/3,q,p-1/2]&&bc-4ad=0 (d=1/4)",
              %mr_intBinomialQ(1, 1, 1, 1/4, 1, 4, 3, 3/2, -1, x)),
   check_not("intBinomialQ10 no disjunct (m=1/2, n=3, p=1/3, q=-1/2)",
             %mr_intBinomialQ(1, 1, 1, 1, 1, 1/2, 3, 1/3, -1/2, x)),
   true
   )$

 test_sum_simpler_predicates() := block([],
  print("--- sum/simpler predicates (cluster C) ---"),
  /* SumQ (Rubi :176 — SumQ[_Plus] = True, else False) */
  check_bool("sumQ 1+x", %mr_sumQ(1 + x)),
  check_bool("sumQ 1+x+y", %mr_sumQ(1 + x + y)),
  check_not("sumQ x", %mr_sumQ(x)),
  check_not("sumQ 5", %mr_sumQ(5)),
  check_not("sumQ x*y", %mr_sumQ(x*y)),
  check_not("sumQ x^2", %mr_sumQ(x^2)),
  /* FractionalPowerFactorQ (Rubi :658; the NiceSqrtQ dependency —
     pulled forward from cluster F) */
  check_not("fpfQ 2", %mr_fractionalPowerFactorQ(2)),
  check_bool("fpfQ %i (complex atom)", %mr_fractionalPowerFactorQ(%i)),
  check_not("fpfQ x", %mr_fractionalPowerFactorQ(x)),
  check_bool("fpfQ x^(1/2) (stored sqrt node)", %mr_fractionalPowerFactorQ(x^(1/2))),
  check_bool("fpfQ x^(3/2) (stored fractional power)", %mr_fractionalPowerFactorQ(x^(3/2))),
  check_not("fpfQ x^2 (integer exponent)", %mr_fractionalPowerFactorQ(x^2)),
  check_not("fpfQ 2*x", %mr_fractionalPowerFactorQ(2*x)),
  check_bool("fpfQ sqrt(2)*sqrt(x) (product)", %mr_fractionalPowerFactorQ(sqrt(2)*sqrt(x))),
  check_bool("fpfQ 1/sqrt(2) (/ node — Maxima stores x^(-1/2) this way)",
             %mr_fractionalPowerFactorQ(1/sqrt(2))),
  check_bool("fpfQ x^(-1/2) (stored 1/sqrt(x))", %mr_fractionalPowerFactorQ(x^(-1/2))),
  check_bool("fpfQ -sqrt(2) (unary - node)", %mr_fractionalPowerFactorQ(-sqrt(2))),
  check_not("fpfQ abs(x) (Maxima stores sqrt(x^2) as abs(x) — Rubi: Sqrt[x^2] is a fractional power)",
            %mr_fractionalPowerFactorQ(abs(x))),
  check_not("fpfQ 1/x (integer reciprocal)", %mr_fractionalPowerFactorQ(1/x)),
  /* NiceSqrtQ (Rubi :647) */
  check_bool("niceSqrtQ 4 (positive rational)", %mr_niceSqrtQ(4)),
  check_not("niceSqrtQ 0 (rational, not > 0)", %mr_niceSqrtQ(0)),
  check_not("niceSqrtQ -1 (rational, not > 0)", %mr_niceSqrtQ(-1)),
  check_not("niceSqrtQ x (sqrt(x) has a sqrt node)", %mr_niceSqrtQ(x)),
  /* DEVIATION (measured 2026-08-23): Maxima's sqrt(x^2) -> abs(x) while
     Mathematica keeps Sqrt[x^2] — the Rubi answer for x^2 is false,
     the port answers true. Unreachable at the class-1 sites: the
     discriminants passed are sums/products of distinct parameters,
     never structural perfect squares. */
  check_bool("niceSqrtQ x^2 (abs corner — Rubi: false)", %mr_niceSqrtQ(x^2)),
  check_bool("niceSqrtQ x^4 (sqrt -> x^2, integer exponent; Rubi: true)",
             %mr_niceSqrtQ(x^4)),
  check_not("niceSqrtQ 2*x (sqrt distributes: sqrt(2)*sqrt(x))", %mr_niceSqrtQ(2*x)),
  check_not("niceSqrtQ 4*x (2*sqrt(x))", %mr_niceSqrtQ(4*x)),
  check_not("niceSqrtQ -4 (2*%i — complex factor)", %mr_niceSqrtQ(-4)),
  check_not("niceSqrtQ 1/(2*x) (1/(sqrt(2)*sqrt(x)) — / branch)",
            %mr_niceSqrtQ(1/(2*x))),
  check_not("niceSqrtQ b^2-4*a*c (generic discriminant)",
            %mr_niceSqrtQ(b^2 - 4*a*c)),
  check_not("niceSqrtQ -a*c (generic discriminant)", %mr_niceSqrtQ(-a*c)),
  /* SimplerQ (Rubi :677) */
  check_bool("simplerQ 1 2 (abs 1 < abs 2)", %mr_simplerQ(1, 2)),
  check_not("simplerQ 2 1", %mr_simplerQ(2, 1)),
  check_not("simplerQ 1 1 (equal)", %mr_simplerQ(1, 1)),
  check_not("simplerQ -1 1 (u = -v, v not < 0)", %mr_simplerQ(-1, 1)),
  check_bool("simplerQ 1 -1 (u = -v, v < 0)", %mr_simplerQ(1, -1)),
  check_not("simplerQ x 2 (v integer, u not)", %mr_simplerQ(x, 2)),
  check_bool("simplerQ 1/2 1/3 (denom 2 < 3)", %mr_simplerQ(1/2, 1/3)),
  check_not("simplerQ 1/3 1/2 (denom 3 > 2)", %mr_simplerQ(1/3, 1/2)),
  check_bool("simplerQ 1/2 3/2 (equal denoms, num 1 < 3)", %mr_simplerQ(1/2, 3/2)),
  check_not("simplerQ 3/2 1/2 (equal denoms, num 3 > 1)", %mr_simplerQ(3/2, 1/2)),
  check_not("simplerQ 2*i i (pure imaginary: Im 2 vs 1)", %mr_simplerQ(2*%i, %i)),
  check_bool("simplerQ i 2*i (pure imaginary: Im 1 vs 2)", %mr_simplerQ(%i, 2*%i)),
  check_bool("simplerQ 1+i 2+i (Re 1 vs 2)", %mr_simplerQ(1 + %i, 2 + %i)),
  check_bool("simplerQ 1+i 1+2*i (equal Re, Im 1 vs 2)",
             %mr_simplerQ(1 + %i, 1 + 2*%i)),
  check_bool("simplerQ %pi x (both atoms, %pi sorts first)", %mr_simplerQ(%pi, x)),
  check_not("simplerQ x %pi", %mr_simplerQ(x, %pi)),
  check_bool("simplerQ x 2*x (atom before non-atom)", %mr_simplerQ(x, 2*x)),
  check_not("simplerQ 1+x x (non-atom after atom)", %mr_simplerQ(1 + x, x)),
  check_bool("simplerQ 1+x 1+y (scan: equal 1s, x before y)",
             %mr_simplerQ(1 + x, 1 + y)),
  check_not("simplerQ 1+y 1+x (scan: y after x)", %mr_simplerQ(1 + y, 1 + x)),
  check_bool("simplerQ 1+x 1+x*y (leafcount 3 < 4)", %mr_simplerQ(1 + x, 1 + x*y)),
  check_not("simplerQ 1+x+y 1+x (length 3 > 2)", %mr_simplerQ(1 + x + y, 1 + x)),
  check_not("simplerQ x^2 1+x (heads differ, leafcounts equal, 1+x sorts first)",
            %mr_simplerQ(x^2, 1 + x)),
  check_bool("simplerQ 1+x x^2 (heads differ, 1+x sorts first)",
             %mr_simplerQ(1 + x, x^2)),
  /* SimplerSqrtQ (Rubi :732) */
  check_not("simplerSqrtQ -4 9 (u < 0, v not)", %mr_simplerSqrtQ(-4, 9)),
  check_bool("simplerSqrtQ 9 -4 (v < 0, u not)", %mr_simplerSqrtQ(9, -4)),
  check_bool("simplerSqrtQ 4 9 (sqrt 2 < sqrt 3, both integer)",
             %mr_simplerSqrtQ(4, 9)),
  check_not("simplerSqrtQ 9 4 (sqrt 3 > sqrt 2)", %mr_simplerSqrtQ(9, 4)),
  /* the .m PosQ[u] && PosQ[v] branch is the BARE LeafCount comparison
     (a tie answers false — the Not[OrderedQ] tiebreak is only reached
     when neither u nor v is posQ) */
  check_not("simplerSqrtQ 2 3 (both posQ, equal leafcounts -> false)",
            %mr_simplerSqrtQ(2, 3)),
  check_not("simplerSqrtQ 3 2 (both posQ, equal leafcounts -> false)",
            %mr_simplerSqrtQ(3, 2)),
  /* undecidable signs: Rubi's If stays pending (decline); the port
     must fail closed with false, not fall through to the leafcount
     comparison */
  check_not("simplerSqrtQ -b/a -d/c (undecidable signs -> false)",
            %mr_simplerSqrtQ(-b/a, -d/c)),
  check_not("simplerSqrtQ x y (undecidable signs -> false)",
            %mr_simplerSqrtQ(x, y)),
  /* SumSimplerQ (Rubi :767) — the 36 call sites pass
     (exponent-parameter, integer-constant) */
  check_not("sumSimplerQ 5 1 (rational, v > 0, 5 not < -1)",
            %mr_sumSimplerQ(5, 1)),
  check_bool("sumSimplerQ -3 1 (rational, v > 0, -3 < -1)",
             %mr_sumSimplerQ(-3, 1)),
  check_bool("sumSimplerQ 1 -1 (v <= 0, 1 >= 1)", %mr_sumSimplerQ(1, -1)),
  check_bool("sumSimplerQ 2 -2 (v <= 0, 2 >= 2)", %mr_sumSimplerQ(2, -2)),
  check_not("sumSimplerQ -1 -1 (v <= 0, -1 not >= 1)", %mr_sumSimplerQ(-1, -1)),
  check_not("sumSimplerQ m 1 (NNF m vs 1)", %mr_sumSimplerQ(m, 1)),
  check_not("sumSimplerQ m+1 1 (sum split: 1 rational, aux(m,1) fails)",
            %mr_sumSimplerQ(m + 1, 1)),
  check_bool("sumSimplerQ -3*m 2*m (NNF m = m, NF ratio -3/2 < -1/2)",
             %mr_sumSimplerQ(-3*m, 2*m)),
  check_not("sumSimplerQ m -2*m (ratio -1/2 but NF[m] = 1 not < 0)",
            %mr_sumSimplerQ(m, -2*m)),
  check_not("sumSimplerQ -3*m -4*m (ratio 3/4)", %mr_sumSimplerQ(-3*m, -4*m)),
  check_not("sumSimplerQ m 1+x (v sum: 1 rational, aux(m,x) fails)",
            %mr_sumSimplerQ(m, 1 + x)),
  check_not("sumSimplerQ 2*m 1+m (aux(2m,m): NNF m = m, NF ratio 2)",
            %mr_sumSimplerQ(2*m, 1 + m)),
  true
  )$

  /* Task 7a cluster D — the trinomial/quadratic/binomial-degree
     predicates. Expected values hand-computed from the pinned Rubi
     definitions (provenance in maxima_rubi_utils.mac). The *MatchQ
     conds are threaded through the matcher's structural backtracking,
     so the unit-coefficient bare-power cases now answer as in Rubi.
     The remaining port-false pins are the matcher's absent-rule
     corner: a product factor containing a literal (b_*x, c_*x^2)
     cannot be deleted as a whole by its optional coefficient. */
  test_cluster_d_predicates() := block([],
   print("--- trinomial/quadratic/binomial-degree predicates (cluster D) ---"),
   /* quadraticQ (Rubi :1380) — PolyQ[u,x,2] && Not[c0===0 && c1===0] */
   check_bool("quadraticQ 1+x+x^2", %mr_quadraticQ(1 + x + x^2, x)),
   check_bool("quadraticQ 1+x^2 (c0 nonzero, c1 = 0)",
              %mr_quadraticQ(1 + x^2, x)),
   check_bool("quadraticQ 3*x+5*x^2 (c0 = 0, c1 nonzero)",
              %mr_quadraticQ(3*x + 5*x^2, x)),
   check_not("quadraticQ 5*x^2 (a*x^2 monomial)", %mr_quadraticQ(5*x^2, x)),
   check_not("quadraticQ 1+2*x (degree 1)", %mr_quadraticQ(1 + 2*x, x)),
   check_not("quadraticQ 1+x+x^2+x^3 (degree 3)",
             %mr_quadraticQ(1 + x + x^2 + x^3, x)),
   check_bool("quadraticQ (1+x)^2 (unexpanded power, coeffs via expand)",
              %mr_quadraticQ((1 + x)^2, x)),
   check_bool("quadraticQ list, all quadratic",
              %mr_quadraticQ([1 + x + x^2, 3*x + 5*x^2], x)),
   check_not("quadraticQ list, one not",
             %mr_quadraticQ([1 + x + x^2, 5*x^2], x)),
   /* binomialDegree (Rubi :846) — BinomialParts[u,x][[3]] */
   check("binomialDegree 3+5x^2", %mr_binomialDegree(3 + 5*x^2, x), 2),
   check("binomialDegree x^2 (a = 0)", %mr_binomialDegree(x^2, x), 2),
   check("binomialDegree 1/x (reciprocal corner, n = -1)",
         %mr_binomialDegree(1/x, x), -1),
   /* the .m False[[3]] hard-errors on a non-binomial; the port fails
      closed (call sites gate on BinomialQ first) */
   check_not("binomialDegree x+x^2 (non-binomial, fails closed)",
             %mr_binomialDegree(x + x^2, x)),
   /* linearMatchQ (Rubi :1420) — MatchQ[u, a_.+b_.*x /; FreeQ[{a,b},x]] */
   check_bool("linearMatchQ 1+2*x", %mr_linearMatchQ(1 + 2*x, x)),
   check_bool("linearMatchQ 2*x+3 (stored term order)",
              %mr_linearMatchQ(2*x + 3, x)),
   check_bool("linearMatchQ x (a = 0 absent)", %mr_linearMatchQ(x, x)),
    /* Rubi: TRUE (a = 1+x^2, b = 0 — the absent x term). The port's
       matcher cannot make a product factor (b_*x) absent in a sum:
       the x literal has no Optional default, so no structural
       binding exists. Unreachable at the call sites: the LinearQ
       guard guarantees a real b*x term. */
    check_not("linearMatchQ 1+x^2 (Rubi true, b = 0 absent-corner)",
             %mr_linearMatchQ(1 + x^2, x)),
   check_bool("linearMatchQ list, all linear",
              %mr_linearMatchQ([1 + x, 3*x], x)),
   check_not("linearMatchQ list, one not (x^2+2*x)",
             %mr_linearMatchQ([1 + x, x^2 + 2*x], x)),
   /* quadraticMatchQ (Rubi :1427) — the a_.+b_*x+c_*x^2 pattern OR
      the a_.+c_*x^2 pattern */
   check_bool("quadraticMatchQ 1+2x+3x^2",
              %mr_quadraticMatchQ(1 + 2*x + 3*x^2, x)),
   check_bool("quadraticMatchQ 1+3x^2 (2-term pattern)",
              %mr_quadraticMatchQ(1 + 3*x^2, x)),
   check_bool("quadraticMatchQ 2x+3x^2 (a = 0)",
              %mr_quadraticMatchQ(2*x + 3*x^2, x)),
   check_bool("quadraticMatchQ x^2 (a = 0, c = 1)",
              %mr_quadraticMatchQ(x^2, x)),
   check_not("quadraticMatchQ 1+x+x^2+x^3 (degree 3)",
             %mr_quadraticMatchQ(1 + x + x^2 + x^3, x)),
   /* Rubi: TRUE (a = 1, c = 0 — the absent x^2 term). Unreachable at
      the call sites: the QuadraticQ guard guarantees a real x^2 term. */
   check_not("quadraticMatchQ 1+2*x (Rubi true, c = 0 absent-corner)",
             %mr_quadraticMatchQ(1 + 2*x, x)),
   check_bool("quadraticMatchQ list, all",
              %mr_quadraticMatchQ([1 + 2*x + 3*x^2, x^2], x)),
   check_not("quadraticMatchQ list, one not",
             %mr_quadraticMatchQ([1 + 2*x + 3*x^2, 1 + x + x^2 + x^3], x)),
    /* binomialMatchQ (Rubi :1444) — MatchQ[u, a_.+b_.*x^n_. /;
       FreeQ[{a,b,n},x]]. The orderless partition search plus the
       threaded freeof cond finds the Rubi-faithful binding even when
       Maxima's stored order presents the coefficient-absorbing
       binding first. */
    check_bool("binomialMatchQ 3+5x^2", %mr_binomialMatchQ(3 + 5*x^2, x)),
    check_bool("binomialMatchQ 5x^2 (a = 0)", %mr_binomialMatchQ(5*x^2, x)),
    check_bool("binomialMatchQ 7+2x^(1/3) (fractional n)",
               %mr_binomialMatchQ(7 + 2*x^(1/3), x)),
    check_not("binomialMatchQ 1+x+x^2 (not a binomial)",
              %mr_binomialMatchQ(1 + x + x^2, x)),
    /* Rubi: TRUE (a = 0, b = 1, n = 3). The coefficient-absorbing
       binding (b = x^3, n = 1) fails freeof and is backtracked away;
       the search continues to b = 1, n = 3. */
    check_bool("binomialMatchQ x^3 (b = 1, n = 3)",
               %mr_binomialMatchQ(x^3, x)),
    /* Rubi: TRUE (a = 1, b = 1, n = 3/2) — same unit-coefficient
       corner. */
    check_bool("binomialMatchQ 1+x^(3/2) (b = 1, fractional n)",
               %mr_binomialMatchQ(1 + x^(3/2), x)),
   check_bool("binomialMatchQ list, all",
              %mr_binomialMatchQ([3 + 5*x^2, 5*x^2], x)),
   check_not("binomialMatchQ list, one not",
             %mr_binomialMatchQ([3 + 5*x^2, 1 + x + x^2], x)),
    /* trinomialMatchQ (Rubi :1458) — MatchQ[u, a_.+b_*x^n_.+c_*x^j_.
       /; FreeQ[{a,b,c,n},x] && EqQ[j-2*n,0]]. The orderless
       partition search plus the threaded j = 2*n cond finds the
       Rubi-faithful n/j assignment regardless of Maxima's stored
       term order. */
    check_bool("trinomialMatchQ 1+2x^2+3x^4 (n = 2)",
               %mr_trinomialMatchQ(1 + 2*x^2 + 3*x^4, x)),
    check_bool("trinomialMatchQ 5x^2+7x^4 (a = 0)",
               %mr_trinomialMatchQ(5*x^2 + 7*x^4, x)),
    check_bool("trinomialMatchQ 1+2x+3x^2 (n = 1)",
               %mr_trinomialMatchQ(1 + 2*x + 3*x^2, x)),
    check_not("trinomialMatchQ 1+x^2+x^3 (j # 2*n)",
              %mr_trinomialMatchQ(1 + x^2 + x^3, x)),
    /* Rubi: TRUE (a = 1, b = 1, n = 2, c = 1, j = 4). Unit
       coefficients: the coefficient-absorbing bindings fail freeof
       and are backtracked away; the search continues to b = c = 1
       with the real exponents. */
    check_bool("trinomialMatchQ 1+x^2+x^4 (b = c = 1, n = 2, j = 4)",
               %mr_trinomialMatchQ(1 + x^2 + x^4, x)),
   /* Rubi: TRUE (a = 1, b = 2, n = 1, c = 0, j = 2 — the c = 0
      absent-corner). Unreachable: TrinomialQ[1+2x, x] is false. */
   check_not("trinomialMatchQ 1+2*x (Rubi true, c = 0 absent-corner)",
             %mr_trinomialMatchQ(1 + 2*x, x)),
   check_bool("trinomialMatchQ list, all",
              %mr_trinomialMatchQ([1 + 2*x^2 + 3*x^4, 5*x^2 + 7*x^4], x)),
   check_not("trinomialMatchQ list, one not",
             %mr_trinomialMatchQ([1 + 2*x^2 + 3*x^4, 1 + x^2 + x^3], x)),
   /* trinomial_parts (Rubi :929) — [a, b, c, n] iff u = a + b*x^n +
      c*x^(2*n), else false */
   check("trinomial_parts 3+2x^2+5x^4 (polynomial branch)",
         %mr_trinomial_parts(3 + 2*x^2 + 5*x^4, x), [3, 2, 5, 2]),
   check("trinomial_parts 1+x^(1/2)+2*x (sum branch, n = 1/2)",
         %mr_trinomial_parts(1 + x^(1/2) + 2*x, x), [1, 1, 2, 1/2]),
   check("trinomial_parts (1+x^(1/2))^2 (power branch)",
         %mr_trinomial_parts((1 + x^(1/2))^2, x), [1, 2, 1, 1/2]),
   check("trinomial_parts 2*(1+x^(1/2)+x) (product branch)",
         %mr_trinomial_parts(2*(1 + x^(1/2) + x), x), [2, 2, 2, 1/2]),
   check("trinomial_parts 4+x^(1/2)+7*x (auto-combined sum terms)",
         %mr_trinomial_parts(3 + 2*x + 1 + x^(1/2) + 5*x, x), [4, 1, 7, 1/2]),
   check("trinomial_parts 1+1/x+1/x^2 (reciprocal trinomial, n = -1)",
         %mr_trinomial_parts(1 + 1/x + 1/x^2, x), [1, 1, 1, -1]),
   check_not("trinomial_parts 1+x (coeff list length 2 < 3)",
             %mr_trinomial_parts(1 + x, x)),
   check_not("trinomial_parts 1+x^2 (middle coefficient 0)",
             %mr_trinomial_parts(1 + x^2, x)),
   /* the minus branch (cluster D dependency fix on %mr_binomial_parts:
      Maxima stores -x^(1/2) as a unary "-" node; the .m's Times[-1,
      x^(1/2)] goes through the ProductQ branch with the -1 factor) */
   check("binomial_parts -x^(1/2) (minus branch)",
         %mr_binomial_parts(-x^(1/2), x), [0, -1, 1/2]),
   check("binomial_parts -2(1+x^(1/2)) (minus over product)",
         %mr_binomial_parts(-2*(1 + x^(1/2)), x), [-2, -2, 1/2]),
   check("binomial_parts -(3+5x^2) (sum with minus terms, pre-existing)",
         %mr_binomial_parts(-(3 + 5*x^2), x), [-3, -5, 2]),
   /* trinomialQ (Rubi :568) — ListQ[TrinomialParts[u,x]] &&
      Not[QuadraticQ[u,x]] && Not[MatchQ[u, w_^2 /; BinomialQ[w,x]]] */
   check_bool("trinomialQ 1+x^2+x^4", %mr_trinomialQ(1 + x^2 + x^4, x)),
   check_bool("trinomialQ 3+2x^2+5x^4", %mr_trinomialQ(3 + 2*x^2 + 5*x^4, x)),
   check_bool("trinomialQ x^2+x^4 (a = 0)", %mr_trinomialQ(x^2 + x^4, x)),
   /* the .m Drop chain leaves the x^(n+1) coefficient unchecked —
      Rubi-faithful laxness, pinned */
   check_bool("trinomialQ 1+x^2+x^3+x^4 (Rubi lax scan: x^3 unchecked)",
              %mr_trinomialQ(1 + x^2 + x^3 + x^4, x)),
   check_bool("trinomialQ 1+x^(1/2)+x (fractional, unit coefficients)",
              %mr_trinomialQ(1 + x^(1/2) + x, x)),
   check_bool("trinomialQ 1+1/x+1/x^2 (reciprocal trinomial)",
              %mr_trinomialQ(1 + 1/x + 1/x^2, x)),
   check_not("trinomialQ 1+x (coeff list length 2)",
             %mr_trinomialQ(1 + x, x)),
   check_not("trinomialQ 1+2x+x^2 (a quadratic)",
             %mr_trinomialQ(1 + 2*x + x^2, x)),
   check_not("trinomialQ (1+x^2)^2 (a binomial square)",
             %mr_trinomialQ((1 + x^2)^2, x)),
   check_not("trinomialQ (1+x^(1/2))^2 (a binomial square, power branch)",
             %mr_trinomialQ((1 + x^(1/2))^2, x)),
   check_bool("trinomialQ list, all",
              %mr_trinomialQ([1 + x^2 + x^4, x^2 + x^4], x)),
   check_not("trinomialQ list, one not",
             %mr_trinomialQ([1 + x^2 + x^4, 1 + 2*x + x^2], x)),
   true
  )$

  /* Task 7a cluster E — the generalized binomial/trinomial predicates.
     Expected values hand-computed from the pinned Rubi definitions
     (GeneralizedBinomialParts :1022-1045, GeneralizedTrinomialParts
     :1058-1088, the Q/MatchQ/Degree wrappers at :579-593, :1016-1054,
     :1450-1468). */
  test_cluster_e_predicates() := block([],
    print("--- generalized binomial/trinomial predicates (cluster E) ---"),
    /* generalizedBinomial_parts (Rubi :1022-1045) — [a, b, n, q] iff
       u ~ a*x^q + b*x^n with n - q > 0 */
    check("gbp x+x^2",
          %mr_generalizedBinomial_parts(x + x^2, x), [1, 1, 2, 1]),
    check("gbp x^2+x (orderless)",
          %mr_generalizedBinomial_parts(x^2 + x, x), [1, 1, 2, 1]),
    check("gbp fractional exponents",
          %mr_generalizedBinomial_parts(2*x^(1/3) + 3*x^(2/3), x),
          [2, 3, 2/3, 1/3]),
    check("gbp x^m*(x+x^2) (shift)",
          %mr_generalizedBinomial_parts(x^m*(x + x^2), x),
          [1, 1, m + 2, m + 1]),
    check_not("gbp 3 terms",
              %mr_generalizedBinomial_parts(x + x^2 + x^3, x)),
    check_not("gbp single term",
              %mr_generalizedBinomial_parts(x^2, x)),
    /* generalizedBinomialQ (Rubi :579) */
    check_bool("gbQ x+x^2",
               %mr_generalizedBinomialQ(x + x^2, x)),
    check_bool("gbQ fractional",
               %mr_generalizedBinomialQ(2*x^(1/3) + 3*x^(2/3), x)),
    check_bool("gbQ x^m*(x+x^2) (shift)",
               %mr_generalizedBinomialQ(x^m*(x + x^2), x)),
    check_not("gbQ 3 terms",
              %mr_generalizedBinomialQ(x + x^2 + x^3, x)),
    check_bool("gbQ list, all",
               %mr_generalizedBinomialQ([x + x^2, x^(1/2) + x], x)),
    check_not("gbQ list, one not",
              %mr_generalizedBinomialQ([x + x^2, x + x^2 + x^3], x)),
    /* generalizedBinomialDegree (Rubi :1017) — n - q */
    check("gbDeg x+x^2",
          %mr_generalizedBinomialDegree(x + x^2, x), 1),
    check("gbDeg x^2+x (orderless)",
          %mr_generalizedBinomialDegree(x^2 + x, x), 1),
    check("gbDeg fractional",
          %mr_generalizedBinomialDegree(2*x^(1/3) + 3*x^(2/3), x), 1/3),
    check("gbDeg shift invariant",
          %mr_generalizedBinomialDegree(x^m*(x + x^2), x), 1),
    check_not("gbDeg non-gb",
              %mr_generalizedBinomialDegree(x + x^2 + x^3, x)),
    /* generalizedBinomialMatchQ (Rubi :1451) — the surface two-power
       sum, no PosQ gate */
    check_bool("gbM x+x^2",
               %mr_generalizedBinomialMatchQ(x + x^2, x)),
    check_bool("gbM descending exponents (no PosQ)",
               %mr_generalizedBinomialMatchQ(x^(1/3) + x^(1/2), x)),
    check_not("gbM product surface",
              %mr_generalizedBinomialMatchQ(x^m*(x + x^2), x)),
    check_not("gbM 3 terms",
              %mr_generalizedBinomialMatchQ(x + x^2 + x^3, x)),
    check_bool("gbM list, all",
               %mr_generalizedBinomialMatchQ(
                 [x + x^2, x^(1/3) + x^(1/2)], x)),
    check_not("gbM list, one not",
              %mr_generalizedBinomialMatchQ(
                [x + x^2, x + x^2 + x^3], x)),
    /* generalizedTrinomial_parts (Rubi :1058-1088) — [a, b, c, n, q]
       iff u ~ a*x^q + b*x^n + c*x^(2*n-q) */
    check("gtp x+x^2+x^3",
          %mr_generalizedTrinomial_parts(x + x^2 + x^3, x),
          [1, 1, 1, 2, 1]),
    check("gtp x^3+x^2+x (orderless)",
          %mr_generalizedTrinomial_parts(x^3 + x^2 + x, x),
          [1, 1, 1, 2, 1]),
    check("gtp fractional exponents",
          %mr_generalizedTrinomial_parts(
            2*x^(1/3) + 3*x^(2/3) + 4*x, x),
          [2, 3, 4, 2/3, 1/3]),
    /* q = 0 is the ORDINARY trinomial, not generalized: the .m's
       PolyQ/Expon case carries NeQ[q,0] (usage: n, q, b, c nonzero).
       The x^m shift below is what generalizes it (q := m). */
    check_not("gtp 1+x^2+x^4 (q = 0 is ordinary, NeQ[q,0])",
              %mr_generalizedTrinomial_parts(1 + x^2 + x^4, x)),
    check("gtp x^m*(1+x^2+x^4) (shift of the q = 0 case)",
          %mr_generalizedTrinomial_parts(x^m*(1 + x^2 + x^4), x),
          [1, 1, 1, m + 2, m]),
    check_not("gtp no progression",
              %mr_generalizedTrinomial_parts(x + x^2 + x^4, x)),
    /* generalizedTrinomialQ (Rubi :590) */
    check_bool("gtQ x+x^2+x^3",
               %mr_generalizedTrinomialQ(x + x^2 + x^3, x)),
    check_not("gtQ 1+x^2+x^4 (q = 0 is ordinary)",
              %mr_generalizedTrinomialQ(1 + x^2 + x^4, x)),
    check_bool("gtQ x^m*(1+x^2+x^4) (shift)",
               %mr_generalizedTrinomialQ(x^m*(1 + x^2 + x^4), x)),
    check_not("gtQ no progression",
              %mr_generalizedTrinomialQ(x + x^2 + x^4, x)),
    check_bool("gtQ list, all",
               %mr_generalizedTrinomialQ(
                 [x + x^2 + x^3,
                  2*x^(1/3) + 3*x^(2/3) + 4*x], x)),
    check_not("gtQ list, one not",
              %mr_generalizedTrinomialQ(
                [x + x^2 + x^3, x + x^2 + x^4], x)),
    /* generalizedTrinomialDegree (Rubi :1053) — n - q */
    check("gtDeg x+x^2+x^3",
          %mr_generalizedTrinomialDegree(x + x^2 + x^3, x), 1),
    check_not("gtDeg 1+x^2+x^4 (q = 0 is ordinary)",
              %mr_generalizedTrinomialDegree(1 + x^2 + x^4, x)),
    check("gtDeg shift invariant",
          %mr_generalizedTrinomialDegree(x^m*(1 + x^2 + x^4), x), 2),
    check_not("gtDeg non-gt",
              %mr_generalizedTrinomialDegree(x + x^2 + x^4, x)),
    /* generalizedTrinomialMatchQ (Rubi :1465) — the surface three-power
       sum with the progression gate, no product/PolyQ recursion */
    check_bool("gtM x+x^2+x^3",
               %mr_generalizedTrinomialMatchQ(x + x^2 + x^3, x)),
    check_bool("gtM fractional",
               %mr_generalizedTrinomialMatchQ(
                 2*x^(1/3) + 3*x^(2/3) + 4*x, x)),
    check_not("gtM 1+x^2+x^4 (q = 0 is not a surface power term)",
              %mr_generalizedTrinomialMatchQ(1 + x^2 + x^4, x)),
    check_not("gtM no progression",
              %mr_generalizedTrinomialMatchQ(x + x^2 + x^4, x)),
    check_bool("gtM list, all",
               %mr_generalizedTrinomialMatchQ(
                 [x + x^2 + x^3, 2*x^(1/3) + 3*x^(2/3) + 4*x], x)),
    check_not("gtM list, one not",
              %mr_generalizedTrinomialMatchQ(
                [x + x^2 + x^3, x + x^2 + x^4], x)),
    true
   )$

  test_cluster_f_predicates() := block([],
    print("--- cluster F predicates ---"),
    /* linearPairQ (Rubi :1387) */
    check_bool("lP parallel",
               %mr_linearPairQ(2*x + 1, 4*x + 2, x)),
    check_bool("lP v = x is allowed",
               %mr_linearPairQ(2*x, x, x)),
    check_not("lP u = x is excluded (NeQ[u,x])",
              %mr_linearPairQ(x, 2*x, x)),
    check_not("lP not parallel",
              %mr_linearPairQ(2*x + 1, 3*x + 4, x)),
    check_not("lP nonlinear",
              %mr_linearPairQ(x^2 + 1, 2*x^2 + 2, x)),
    /* perfectSquareQ — clone-gap predicate (no .m definition in the
       pinned clone); the class-1 usage is on numeric discriminants, so
       the port is a factor-exponent square test */
    check_bool("pS 4", %mr_perfectSquareQ(4)),
    check_bool("pS 9/4", %mr_perfectSquareQ(9/4)),
    check_bool("pS a^2", %mr_perfectSquareQ(a^2)),
    check_bool("pS (a+b)^2", %mr_perfectSquareQ((a + b)^2)),
    check_bool("pS pi^2", %mr_perfectSquareQ(%pi^2)),
    check_not("pS 2", %mr_perfectSquareQ(2)),
    check_not("pS -4", %mr_perfectSquareQ(-4)),
    check_not("pS a^2+b^2", %mr_perfectSquareQ(a^2 + b^2)),
    /* rationalFunctionQ (Rubi :1578) */
    check_bool("rFQ poly", %mr_rationalFunctionQ(x^2 + 1, x)),
    check_bool("rFQ quotient", %mr_rationalFunctionQ(1/x, x)),
    check_bool("rFQ power/quotient mix",
               %mr_rationalFunctionQ(x^2/(x + 1), x)),
    check_bool("rFQ param coefficient", %mr_rationalFunctionQ(a*x + b, x)),
    check_not("rFQ sqrt", %mr_rationalFunctionQ(1/sqrt(x), x)),
    check_not("rFQ sin", %mr_rationalFunctionQ(sin(x), x)),
    check_not("rFQ x^x", %mr_rationalFunctionQ(x^x, x)),
    /* splitProduct (Rubi :7658) with the class-1 SumBaseQ argument */
    check("sp sum factor",
          %mr_splitProduct('SumBaseQ, a*(x + 1)), [x + 1, a]),
    check("sp bare sum",
          %mr_splitProduct('SumBaseQ, x + 1), [x + 1, 1]),
    check("sp negative product",
          %mr_splitProduct('SumBaseQ, -a*(x + 1)), [x + 1, -a]),
    check_not("sp no sum factor",
              %mr_splitProduct('SumBaseQ, a*b)),
    /* pseudoBinomialPairQ (Rubi :1507) — both bases
       a + b*(c + d*x)^n with the same [c, d, n] tail */
    check("pBp parts",
          %mr_pseudoBinomial_parts(x^3 + 3*x^2 + 3*x + 2, x),
          [1, 1, 1, 1, 3]),
    check_bool("pBQ same tail",
               %mr_pseudoBinomialPairQ(
                 x^3 + 3*x^2 + 3*x + 2,
                 x^3 + 3*x^2 + 3*x + 3, x)),
    check_not("pBQ different n",
              %mr_pseudoBinomialPairQ(
                x^3 + 3*x^2 + 3*x + 2,
                x^4 + 4*x^3 + 6*x^2 + 4*x + 3, x)),
    check_not("pBQ non-polynomial",
              %mr_pseudoBinomialPairQ(x^3 + 1/x, x^3 + 1/x, x)),
    /* inverseFunctionQ (Rubi :303) */
    check_bool("iFQ log", %mr_inverseFunctionQ(log(x))),
    check_bool("iFQ asin", %mr_inverseFunctionQ(asin(x))),
    check_bool("iFQ atan one-arg", %mr_inverseFunctionQ(atan(x))),
    check_not("iFQ atan2 (two-arg inverse trig)",
              %mr_inverseFunctionQ(atan2(y, x))),
    check_bool("iFQ asinh", %mr_inverseFunctionQ(asinh(x))),
    check_not("iFQ sin", %mr_inverseFunctionQ(sin(x))),
    check_not("iFQ x", %mr_inverseFunctionQ(x)),
    /* algebraicFunctionQ (Rubi :1681, flag = false) */
    check_bool("aFQ x", %mr_algebraicFunctionQ(x, x)),
    check_bool("aFQ sqrt", %mr_algebraicFunctionQ(sqrt(x), x)),
    check_bool("aFQ 1/sqrt", %mr_algebraicFunctionQ(1/sqrt(x), x)),
    check_bool("aFQ rational power",
               %mr_algebraicFunctionQ((x + 1)^(1/3), x)),
    check_bool("aFQ sum", %mr_algebraicFunctionQ(x + sqrt(x), x)),
    check_bool("aFQ list",
               %mr_algebraicFunctionQ([sqrt(x), x^2], x)),
    check_not("aFQ x^x", %mr_algebraicFunctionQ(x^x, x)),
    check_not("aFQ sin", %mr_algebraicFunctionQ(sin(x), x)),
    check_not("aFQ log", %mr_algebraicFunctionQ(log(x), x)),
    true
   )$

  test_cluster_g_shims() := block([],
    print("--- cluster G shims ---"),
    /* rt (Rubi :7513/:7549) */
    check("rt 16 4", %mr_rt(16, 4), 2),
    check("rt 8 3", %mr_rt(8, 3), 2),
    check("rt -8 3", %mr_rt(-8, 3), -2),
    check("rt 4/9 2", %mr_rt(4/9, 2), 2/3),
    check("rt -4 2", %mr_rt(-4, 2), 2*%i),
    check("rt power", %mr_rt(x^4, 2), x^2),
    check("rt sqrt node", %mr_rt(sqrt(x), 2), x^(1/4)),
    check("rt sum square", %mr_rt((a + b)^2, 2), a + b),
    check("rt negative power odd", %mr_rt(-a^2, 3), -a^(2/3)),
    /* A RECIPROCAL IS A POWER. MEASURED 2026-09-16 (this build):
       op(1/a) is "/", NOT "^" -- %mr_rt_power_parts read only "^" and
       sqrt, so PowerQ was false for every reciprocal, where
       Mathematica's 1/q is Power[q, -1] and PowerQ is true. The cost was
       NON-TERMINATION, not a shape difference: with PowerQ false,
       RtAux(1/D, n) fell through to its `oddp(n) and NegQ(u) and
       PosQ(-u)` branch and returned -RtAux(-(1/D), n), whose product
       branch called RtAux(1/D, n) again -- the measured cycle
       -(1/D) -> -1 -> 1 -> 1/D -> -(1/D), 2,189 calls before the control
       stack went. It killed 1.1.3.8 e264/e285 on the ported tree and
       reproduces on the PRE-PORT tree (it is a latent defect the port
       merely reached, not a port regression). */
    check("rt reciprocal atom", %mr_rt(1/a, 3), 1/a^(1/3)),
    check("rt reciprocal power", %mr_rt(1/a^2, 2), 1/a),
    check("rt reciprocal sqrt node", %mr_rt(1/sqrt(a), 2), 1/a^(1/4)),
    /* the property, not the shape: Rubi's RtAux splits the -1 off the
       sum (Times[-1, D]) and answers -(1/D^(1/3)); Maxima ABSORBS the
       minus into the sum's terms, so %mr_product_factors(-D) is the
       one-element [-D] (measured) and the port answers 1/(-D)^(1/3) --
       an equally valid cube root, the pre-existing unary-minus trap the
       cluster header names, not this fix. What this check pins is that
       the call TERMINATES and returns an nth root of its argument. */
    check_bool("rt of a negated reciprocal sum terminates",
               is(ratsimp(%mr_rt(-(1/(10*a^4*f - 7*a^3*b*e
                                      + 4*a^2*b^2*d - a*b^3*c)), 3)^3
                          + 1/(10*a^4*f - 7*a^3*b*e
                               + 4*a^2*b^2*d - a*b^3*c)) = 0)),
    /* LtQ[#, 0] must be a BOOLEAN. MEASURED 2026-09-16: is(u < 0) = true
       builds an EQUATION (`true = true`), so %mr_splitProduct's
       `%mr_split_call(...) = true` test never matched and RtAux's LtQ
       split (utils :2734) was dead code; and the bare is(u < 0) the
       equation hides returns `unknown` for an undecidable u, which at
       the `if oddp(n) and LtQ(u)` site (utils :2820) leaves the WHOLE
       conditional unevaluated (measured: `if unknown then "THEN" else
       "ELSE"` comes back as itself). The outer is() gives the strict
       reading the cluster header documents: unknown -> false. */
    check("rt ltQ negative", %mr_rt_ltQ(-1), true),
    check("rt ltQ positive", %mr_rt_ltQ(1), false),
    check("rt ltQ undecidable is strictly false", %mr_rt_ltQ(a), false),
    /* expon (Rubi :1239) */
    check("expon poly", %mr_expon(x^3 + x, x), 3),
    check("expon param poly", %mr_expon(a*x^2 + b*x^4, x), 4),
    check("expon 1/x", %mr_expon(1/x, x), -1),
    check("expon 0", %mr_expon(0, x), 0),
    /* expandToSum (Rubi :3329/:3343) — 2-arg and 3-arg */
    check("eTS poly",
          %mr_expandToSum((x + 1)^2, x), x^2 + 2*x + 1),
    check("eTS sum", %mr_expandToSum(x + x^2, x), x + x^2),
    check("eTS ordinary trinomial",
          %mr_expandToSum(1 + x^2 + x^4, x), 1 + x^2 + x^4),
    check("eTS generalized binomial",
          %mr_expandToSum(2*x^(1/3) + 3*x^(2/3), x),
          2*x^(1/3) + 3*x^(2/3)),
    check("eTS generalized trinomial",
          %mr_expandToSum(x^m*(1 + x^2 + x^4), x),
          x^m + x^(m + 2) + x^(m + 4)),
    check("eTS 3-arg free",
          %mr_expandToSum(3, 1 + x, x), 3 + 3*x),
    check("eTS 3-arg no free",
          %mr_expandToSum(2, x + 1, x), 2 + 2*x),
    /* intPart (Rubi :2952) */
    check("iP 3/2", %mr_intPart(3/2), 1),
    check("iP -3/2", %mr_intPart(-3/2), -1),
    check("iP 2", %mr_intPart(2), 2),
    check("iP x", %mr_intPart(x), 0),
    check("iP 3/2*x", %mr_intPart(3/2*x), 0),
    check("iP sum", %mr_intPart(3/2 + x), 1),
    /* IntegerPart truncates toward zero (exact seen test design 3.2) */
    check("iP -1/2", %mr_intPart(-1/2), 0),
    check("iP -5/2", %mr_intPart(-5/2), -2),
    check("iP -3/2*x", %mr_intPart(-3/2*x), 0),
    /* fracPart (Rubi :2969) */
    check("fP 3/2", %mr_fracPart(3/2), 1/2),
    check("fP -3/2", %mr_fracPart(-3/2), -1/2),
    check("fP 2", %mr_fracPart(2), 0),
    check("fP x", %mr_fracPart(x), x),
    check("fP 3/2*x", %mr_fracPart(3/2*x), 3/2*x),
    check("fP sum", %mr_fracPart(3/2 + x), 1/2 + x),
    /* FractionalPart carries the sign of its argument (design 3.2) */
    check("fP -1/2", %mr_fracPart(-1/2), -1/2),
    check("fP -5/2", %mr_fracPart(-5/2), -1/2),
    check("fP -3/2*x", %mr_fracPart(-3/2*x), -3/2*x),
    true
   )$

  test_cluster_h_shims() := block([],
    print("--- cluster H shims ---"),
    /* polyQuotient / polyRemainder / polyDivide — the Maxima quotient /
       remainder / divide builtins under the project names */
    check("pQ basic",
          %mr_polyQuotient(x^3 + x, x^2 + 1, x), x),
    check("pQ by x",
          %mr_polyQuotient(x^3 + x, x, x), x^2 + 1),
    check("pR basic",
          %mr_polyRemainder(x^3 + 1, x^2 + 1, x), 1 - x),
    check("pR by x",
          %mr_polyRemainder(x^3 + 1, x, x), 1),
    /* polyDivide returns the ONE expression quo + rem/v (Rubi :3298
       contract, consumed by the generated mr_int repls) */
    /* the unexpanded form is (1-x)/(x^2+1)+x (sum-term order is
       canonical, not source order — a source-order `= check would
       fail); the identity u = v*PolyDivide[u,v,x] is the contract. */
    check("pDiv identity",
          is(ratsimp((x^3 + 1) - (x^2 + 1)*%mr_polyDivide(x^3 + 1, x^2 + 1, x)) = 0), true),
    /* inverse-hyperbolic log shims (unbound in this build) */
    check("atanh 1/2", %mr_atanh(1/2), 1/2*log(3)),
    check("atanh 0", %mr_atanh(0), 0),
    check("asinh 0", %mr_asinh(0), 0),
    check("asinh 1", %mr_asinh(1), log(1 + sqrt(2))),
    check("acosh 1", %mr_acosh(1), 0),
    check("acosh 2", %mr_acosh(2), log(2 + sqrt(3))),
    true
   )$

  test_cluster_i_expandIntegrand() := block([],
    print("--- cluster I expandIntegrand (algebraic surface) ---"),
    /* 2-arg: a positive-integer power of a sum expands */
    check("eI2 power of sum",
          %mr_expandIntegrand((x + 1)^2, x), x^2 + 2*x + 1),
    check("eI2 nonlinear power",
          %mr_expandIntegrand((x^2 + 1)^2, x), x^4 + 2*x^2 + 1),
    check("eI2 rational power stays",
          %mr_expandIntegrand((x + 1)^(1/2), x), (x + 1)^(1/2)),
    /* 2-arg: polynomial * linear-power stays in linear-power form
       (ExpandLinearProduct), not expanded to monomials */
    check("eI2 linear product x",
          %mr_expandIntegrand(x*(x + 1)^2, x),
          (x + 1)^3 - (x + 1)^2),
    check("eI2 linear product const",
          %mr_expandIntegrand(3*(x + 1)^2, x), 3*(x + 1)^2),
    check("eI2 linear product poly",
          %mr_expandIntegrand((x + 2)*(x + 1)^2, x),
          (x + 1)^3 + (x + 1)^2),
    /* 3-arg: distribute over the expanded v WITHOUT expanding the
       power factors (DistributeOverTerms / MergeMonomials surface) */
    check("eI3 distribute power",
          %mr_expandIntegrand(x, (x + 1)^2, x), x^3 + 2*x^2 + x),
    check("eI3 distribute plain",
          %mr_expandIntegrand(x, x + 1, x), x^2 + x),
    check("eI3 distribute const",
          %mr_expandIntegrand(2, x^2 + 2*x + 1, x),
          2*x^2 + 4*x + 2),
    true
   )$

  test_cluster_j_shims() := block([],
    print("--- cluster J shims ---"),
    /* substFor — the algebraic surface (the .m's trig/inverse-function
       branches are not ported) */
    check("substFor x^n",
          %mr_substFor(x^2, x^4 + x^2 + 1, x), x^2 + x + 1),
    check("substFor linear",
          %mr_substFor(x + 1, (x + 1)^2 + 1, x), x^2 + 1),
    check("substFor atom",
          %mr_substFor(t, t^2 + 1, x), x^2 + 1),
    /* by VALUE: since Task 10 (inert-trig substrate) the 4-arg form is
       SimplifyIntegrand[w SubstFor[v,u,x], x] as in Rubi, whose shape is
       the smallest-leaf-count candidate (%mr_sf4_simplify), not a fixed
       form */
    check("substFor 4-arg",
          ratsimp(%mr_substFor(2, x^2, x^4 + 1, x) - 2*(x^2 + 1)), 0),
    /* substPower */
    check("substPower",
          %mr_substPower(x^4 + x^2 + 1, x, 1/2), x^2 + x + 1),
    /* dist — distribute the first argument over a Plus sum, leave a
       noun Sum multiplied */
    check("dist sum", %mr_dist(2, x + x^2, x), 2*x + 2*x^2),
    check("dist noun sum",
          %mr_dist(2, mr_sum(u, k, 1, 3), x), 2*mr_sum(u, k, 1, 3)),
    /* normalizePseudoBinomial */
    check("normalizePB",
          %mr_normalizePseudoBinomial(x^3 + 3*x^2 + 3*x + 2, x),
          1 + (x + 1)^3),
    /* cancel */
    check("cancel",
          %mr_cancel((x + 1)/(x^2 + 2*x + 1)), 1/(x + 1)),
    /* polyGCD — monic, x-dependent factors only */
    check("polyGCD",
          %mr_polyGCD((x + 1)*(x + 2), (x + 1)*x, x), x + 1),
    check("polyGCD none",
          %mr_polyGCD(x + 1, x + 2, x), 1),
    /* rationalFunctionExpand — the algebraic-ExpandIntegrand surface */
    check("rFE power",
          %mr_rationalFunctionExpand((x + 1)^2, x), x^2 + 2*x + 1),
    check("rFE linear product",
          %mr_rationalFunctionExpand(x*(x + 1)^2, x),
          (x + 1)^3 - (x + 1)^2),
    true
   )$

  test_cluster_k_shims() := block([],
    print("--- cluster K shims ---"),
    /* root — the rational k-th root of an explicit-rational polynomial
       (the Mathematica Root object, reduced to the rational reading) */
    check("root k=1",
          %mr_root(x^3 - 6*x^2 + 11*x - 6, 1), 1),
    check("root k=2",
          %mr_root(x^3 - 6*x^2 + 11*x - 6, 2), 2),
    check("root k=3",
          %mr_root(x^3 - 6*x^2 + 11*x - 6, 3), 3),
    check("root non-monic",
          %mr_root(2*x^3 - 3*x^2 - 2*x + 3, 3), 3/2),
    check("root none",
          %mr_root(x^3 - 2, 1), false),
    check("root out of range",
          %mr_root(x - 1, 2), false),
    /* intSum / intTerm */
    check("intSum const", %mr_intSum(3, x), 3*x),
    check("intSum sum", %mr_intSum(x + 1, x), x^2/2 + x),
    check("intSum linear", %mr_intSum(2*x + 1, x), x^2 + x),
    check("intSum power", %mr_intSum((x + 1)^2, x), (x + 1)^3/3),
    check("intSum const power",
          %mr_intSum(2*(x + 1)^2, x), 2*(x + 1)^3/3),
    check("intSum -1 power", %mr_intSum(1/(x + 1), x), log(x + 1)),
    check("intSum const -1 power",
          %mr_intSum(2/(x + 1), x), 2*log(x + 1)),
    check("intSum content -1 power",
          %mr_intSum(1/(2*x + 2), x), log(x + 1)/2),
    check("intSum fallback",
          %mr_intSum(x*(x + 1), x), (2*x^3 + 3*x^2)/6),
    /* hold — the ShowStep wrapper, identity outside ShowStep */
    check("hold", %mr_hold(1 + 1), 2),
    true
   )$

  test_cluster_l_powered_form() := block([],
    print("--- cluster L powered-form coeff/expon ---"),
    check("coeff4 const",
          %mr_coeff(x^4 + 3*x^2 + 5, x, 2, 0), 5),
    check("coeff4 mid",
          %mr_coeff(x^4 + 3*x^2 + 5, x, 2, 1), 3),
    check("coeff4 lead",
          %mr_coeff(x^4 + 3*x^2 + 5, x, 2, 2), 1),
    check("coeff4 absent",
          %mr_coeff(x^4 + 3*x^2 + 5, x, 2, 3), 0),
    check("expon3 even",
          %mr_expon(x^4 + 3*x^2 + 5, x, 2), 2),
    check("expon3 odd",
          %mr_expon(x^3 + x, x, 2), -1),
    check("expon3 const",
          %mr_expon(5, x, 2), 0),
    check("degree algebraic const",
          %mr_degree(%pi/sqrt(16 - %e^2), x), 0),
    check("expon algebraic const",
          %mr_expon(%pi/sqrt(16 - %e^2), x), 0),
    check("polyQ algebraic const",
          %mr_polyQ(%pi/sqrt(16 - %e^2), x), true),
    true
   )$

  test_rules_1_1_1_1_behavior() := block([r],
    print("--- generated 1.1.1.1 (behavioral) ---"),
  /* rule 2: the power rule x^m (m free of x, m # -1) */
  check("x^3", rubi(x^3, x), x^4/4),
  /* 5*x^2 fires no class-1 rule (the 1.1.1.1 family is (a+b x)^m forms
     only; no a*x^n / constant-factor rule in the ported set, measured
     2026-08-24) — this probe pins the integrate fall-through, so it is
     full-coverage. */
  check("5x^2 (full coverage)", rubi_fallback(5*x^2, x, true), 5*x^3/3),
  /* rule 1: 1/x -> log(x) */
  check("1/x", rubi(1/x, x), log(x)),
  /* rule 4: (a+b x)^m, m # -1. BRIEF DEVIATION (measured 2026-08-20):
     the brief's expected (1+2x)^4/12 is not an antiderivative —
     ratsimp(diff((1+2x)^4/12, x) - (1+2x)^3)
       = -((8*x^3+12*x^2+6*x+1)/3) # 0,
     while (1+2x)^4/8 closes (diff - integrand -> 0) and equals
     Maxima's own integrate up to a constant. Expected fixed to /8
     (the value rule 4 emits: (a+b x)^(m+1)/(b (m+1))). */
  check("(1+2x)^3", ratsimp(rubi((1 + 2*x)^3, x)), ratsimp((1 + 2*x)^4/8)),
  /* rule 3: 1/(a+b x) -> log(RemoveContent[a+b x, x])/b */
  check("1/(a+b x)", ratsimp(rubi(1/(a + b*x), x)), ratsimp(log(a + b*x)/b)),
  /* rule 5 shape (a+b u)^m, u linear in x. MEASURED (2026-08-20):
     (1 + 2*(3*x))^2 auto-simplifies to (1 + 6*x)^2, which rule 4
     matches directly — and the emitted rule-5 pattern
     (a + b*u)^m (a product of two pattern variables) matches NOTHING
     in this Maxima build (defmatch warning: "will be matched uniquely
     since sub-parts would otherwise be ambiguous"; all probe inputs
     -> false). So this input exercises rule 4, and rule 5 / the
     %mr_subst-via-rule path is NOT exercised end-to-end here
     (%mr_subst itself has a unit probe above). Generator/matcher
     finding — see task-5 report.
     BRIEF DEVIATION (measured): the brief's expected (1+6x)^3/9 is not
     an antiderivative — ratsimp(diff((1+6x)^3/9, x) - (1+6x)^2)
       = 36*x^2+12*x+1 # 0,
     while (1+6x)^3/18 closes to 0. Expected fixed to /18. */
   r : rubi((1 + 2*(3*x))^2, x),
   check_bool("linear base (1+6x)^2", is(ratsimp(r) = ratsimp((1 + 6*x)^3/18))),
  /* NeQ[m, -1]: the m = -1 case must NOT take the power rule (falls to 1/x) */
   check_bool("NeQ guard honored", is(rubi(1/x, x) = log(x))),
   true
)$

/* The dead-rule name-corruption regression (2026-08-24: drop_optionals
   ran post-translate and a capture named `r` mangled the `_mr_` prefix
   of every renamed capture, killing 138 rules across 17 files) is a
   generator defect. It is covered by the static name-integrity half of
   probes/census/01-generation-vs-inventory. A behavioral defmatch probe
   here would conflate it with the separate Maxima matcher under-match on
   multi-factor products (measured 2026-08-24: 1.1.2.6 r3 declines even
   with intact names). */

/* Census cross-check (T6 Step 4). BRIEF DEVIATION (measured 2026-08-20,
   probes/load_wall/probe-load-wall.out, build
   branch_5_49_base_796_g60186bb22_dirty): the brief's global check
   (length(mr_rule_table) = 2710) cannot run in-process on this build —
   the defmatch budget is exhausted partway through file 8 of 67, so
   2710 patterns cannot be held in one process. The global cross-check
   lives in the static probe probes/census/01-generation-vs-inventory
   (generator per-file counts vs the T1 inventory, all 67 files, total
   2710). Here: the loadable spot checks — 1.1.1.2 (count 40, the T1
   inventory per-file number) loaded with the table saved/restored,
   plus the core count re-verified. */
test_census() := block([saved_table],
  print("--- census cross-check (loadable subset; see docstring) ---"),
  saved_table : mr_rule_table,
  %mr_load_sibling("rules/class1/1_1_1_2.mac", 'mr_witness_1_1_1_2),
  check("1.1.1.2 count = 40 (T1 inventory)", mr_rules_count_1_1_1_2, 40),
  check_bool("1.1.1.2 witness survived", is(mr_witness_1_1_1_2() = true)),
  check("core 1.1.1.1 count still 5", mr_rules_count_1_1_1_1, 5),
  check("table (saved core) length 5", length(saved_table), 5),
  mr_rule_table : saved_table,
  true
)$

/* Class-2 cluster A — the small predicates (milestone-2 plan Task 4). */
test_class2_cluster_a() := block([],
   print("--- class-2 cluster A: small predicates ---"),
   check_bool("trueQ true", is(%mr_trueQ(true) = true)),
   check_bool("trueQ false", is(%mr_trueQ(false) = false)),
   check_bool("trueQ noun", is(%mr_trueQ('f(x)) = false)),
   check("use-gamma flag default", mr_use_gamma_flag, false),
   check_bool("powerQ power", is(%mr_powerQ(x^2) = true)),
   check_bool("powerQ bare x", is(%mr_powerQ(x) = false)),
   check_bool("powerQ sum", is(%mr_powerQ(a + b*x) = false)),
   check_bool("calculusQ integrate noun", is(%mr_calculusQ(integrate(f(x), x)) = true)),
   /* class 8 (2026-09-25): a diff noun of the formal-derivative shape,
      diff(f(x), x), is Mathematica's EVALUATED Derivative[1][f][x] -- not
      calculus (Rubi's $CalculusFunctions has D, not Derivative[n][f]); a
      partial-derivative noun is the shape that stays calculus */
   check_bool("calculusQ diff noun (partial)", is(%mr_calculusQ(diff(f(x, y), x)) = true)),
   check_bool("calculusQ formal derivative is not calculus",
              is(%mr_calculusQ(diff(f(x), x)) = false)),
   check_bool("calculusQ product", is(%mr_calculusQ(f*x) = false)),
   check_bool("hyperbolicQ sinh", is(%mr_hyperbolicQ(sinh(x)) = true)),
   check_bool("hyperbolicQ sin", is(%mr_hyperbolicQ(sin(x)) = false)),
   /* BRIEF DEVIATION (measured): the brief's lambda([q]) : integerp(q)
      is not Maxima syntax (lambda body separator is a comma) — the
      colon form dies the run: "lambda: no body present" (2026-08-28,
      5.50.0/SBCL). Comma form: lambda([q], integerp(q)). */
   check_bool("everyQ all", is(%mr_everyQ(lambda([q], integerp(q)), [1, 2, 3]) = true)),
   check_bool("everyQ one false", is(%mr_everyQ(lambda([q], integerp(q)), [1, %i]) = false)),
   check_bool("powerOfLinearQ linear", is(%mr_powerOfLinearQ(a + b*X, X) = true)),
   check_bool("powerOfLinearQ rational power", is(%mr_powerOfLinearQ((a + b*X)^(3/2), X) = true)),
   check_bool("powerOfLinearQ non-linear base", is(%mr_powerOfLinearQ((a + b*X^2)^(1/2), X) = false)),
   check_bool("powerOfLinearQ free of X", is(%mr_powerOfLinearQ(a*X, X) = true)),
   check_bool("powerOfLinearMatchQ agrees", is(%mr_powerOfLinearMatchQ((a + b*X)^(3/2), X) = true)),
   /* Fix round 1 (2026-08-28 review): regression anchors for the
      atom gate and the sqrt-of-linear branch (deviation 7) — the
      stored (linear)^(1/2) sqrt form, Q/MatchQ duality on it (the
      2.3 r38 firing case: Q true, MatchQ false), and an atom. */
   check_bool("powerOfLinearQ sqrt linear", is(%mr_powerOfLinearQ(sqrt(a + b*X), X) = true)),
   check_bool("powerOfLinearQ atom", is(%mr_powerOfLinearQ(5, X) = false)),
   check_bool("powerOfLinearMatchQ sqrt not a power", is(%mr_powerOfLinearMatchQ(sqrt(a + b*X), X) = false)),
   check("normalizePowerOfLinear identity", %mr_normalizePowerOfLinear((a + b*X)^(3/2), X), (a + b*X)^(3/2)),
   true
)$

/* Class-2 cluster B — the NormalizeIntegrand chain (milestone-2 plan
   Task 5). Shapes are the 2.3 r60 call site: E^z with z a binomial or
   quadratic (Maxima splits %e^z over the sum). */
test_class2_cluster_b() := block([],
  print("--- class-2 cluster B: NormalizeIntegrand chain ---"),
  check_bool("integerPowerQ int", is(%mr_integerPowerQ((a + b*X)^3) = true)),
  check_bool("integerPowerQ frac", is(%mr_integerPowerQ((a + b*X)^(3/2)) = false)),
  check("numericFactor number", %mr_numericFactor(4), 4),
  check("numericFactor neg number", %mr_numericFactor(-6), -6),
  check("numericFactor sum content", %mr_numericFactor(4 + 6*X), 2),
  check_bool("signOfFactor pos", is(%mr_signOfFactor(3*X) = [1, 3*X])),
  check_bool("signOfFactor neg sum", is(%mr_signOfFactor(-4 - 6*X) = [-1, 4 + 6*X])),
  check_bool("absorbMinusSign sum", is(%mr_absorbMinusSign(2*(-a - b*X)) = 2*(a + b*X))),
  check_bool("leadTermSigns identity", is(%mr_normalizeLeadTermSigns(%e^(3*X)) = %e^(3*X))),
  check("monomialExponent", %mr_monomialExponent(5*X^2, X), 2),
  check("monomialExponent free of X", %mr_monomialExponent(5*Y, X), 0),
  check_bool("normalizeIntegrand E^binomial stable",
    is(%mr_normalizeIntegrand(%e^(A + B*X), X) = %e^(A + B*X))),
  check_bool("normalizeIntegrand E^quadratic stable",
    is(%mr_normalizeIntegrand(%e^(A + B*X + C*X^2), X) = %e^(A + B*X + C*X^2))),
  check_bool("mergeMonomials linear cancel",
    is(%mr_mergeMonomials((A + B*X), X) = (A + B*X))),
  /* Fix round 1 (2026-08-28 review): FactorBase last-branch head-
     preserving reconstruction (apply(op(u), …) — the .m's Map keeps
     the head), bare-x monomial exponents (Maxima strips exponent-1
     powers; the .m's x_^n_. matches bare x at n = 1), and the
     signOfFactor minus-wrap branch (smoke-probed only before). */
  check("factorBase power head kept", %mr_normalizeIntegrandFactorBase(x^5, x), x^5),
  /* SHAPE ADJUSTMENT (measured 2026-08-28, 5.50.0/SBCL): the review's
     original shape -(x^2+3*x)^3 is classified a TRINOMIAL by M1's
     %mr_trinomial_parts polynomial branch (zero-check inverted and
     under-ranged vs the .m's TrinomialParts :929-:937 — trinomialQ
     TRUE where the .m says FALSE; pre-existing M1 defect, reported in
     the task-5 report fix-round section) and is routed to the
     trinomial branch (expandToSum) before ever reaching the last
     branch — pinning it would pin that defect. -(x+1)^5 is
     minus-wrapped (op "-"), not binomial/trinomial, and a degree-5
     polynomial (degree>4), so it reaches the last branch: head and
     value preserved. */
  check("factorBase minus wrap kept", %mr_normalizeIntegrandFactorBase(-(x+1)^5, x), -(x+1)^5),
  check("monomialExponent bare x", %mr_monomialExponent(5*X, X), 1),
  check("monomialExponent x itself", %mr_monomialExponent(X, X), 1),
  check_bool("signOfFactor minus wrap", is(%mr_signOfFactor(-3*X) = [-1, 3*X])),
  true
)$

/* Class-2 cluster C — the FunctionOfExponential family (milestone-2
   plan Task 6). F/G/A/… are free symbols; X the variable.
   Two RED-shape corrections vs the brief (task-6 report):
   * the sinh "tests true" check uses listp — the brief's
     `not atom(…)` would PASS at RED, since an undefined-function noun
     is non-atom; listp is false for a noun and true for the
     [flag, F, v] state list, so it RED-fails and GREEN-passes.
   * the x-free check expects Q = false — the .m's Q (:4266) is
     Test && $exponFlag$ and the FreeQ arm (:4308-4309) never sets the
     flag, so Q(x-free u) = false; the brief's `= true` is wrong per
     the .m. */
test_class2_cluster_c() := block([],
  print("--- class-2 cluster C: FunctionOfExponential family ---"),
  check_bool("foE: F^(c (a+b x))", is(%mr_functionOfExponentialQ(F^(C*(A + B*X)), X) = true)),
  check_bool("foE: %e^(a+b x)", is(%mr_functionOfExponentialQ(%e^(A + B*X), X) = true)),
  check_bool("foE: sinh(a+b x) returns a state (list)",
    is(listp(%mr_foE_test(sinh(A + B*X), X)) = true)),
  check_bool("foE: sinh(a+b x) flag false (no explicit power)",
    is(part(%mr_foE_test(sinh(A + B*X), X), 1) = false)),
  check_bool("foE: free of X is not a function-of-exponential (.m Q=false)",
    is(%mr_functionOfExponentialQ(F^C, X) = false)),
  check_bool("foE: two different bases refused",
    is(%mr_functionOfExponentialQ(F^(A + B*X)*G^(C + D*X), X) = false)),
  check_bool("foE: non-exponential refused", is(%mr_functionOfExponentialQ(A*X^2, X) = false)),
  check_bool("foE: the variable itself refused", is(%mr_functionOfExponentialQ(X, X) = false)),
  check("foE: returns F^v (first call keeps full expon)",
    %mr_functionOfExponential(F^(C*(A + B*X)), X), F^(C*(A + B*X))),
  /* Fix round 1: commensurable numeric bases — the .m accepts them
     (FullSimplify reduces Log[4]/Log[2] -> 2; ratsimp does not). The
     stored factor order decides which base is first-seen
     (args(2^X*4^X) = [2^X, 4^X] on this build), and with the IGtQ
     swap dropped the port keeps the first-seen base — 2 here, and
     Denominator[2] = 1, so the stored expon is kept: 2^X (the .m
     returns 2^X for this factor order too; a different order without
     the swap would keep 4 with expon 2 X — form-only difference). */
  check_bool("foE: commensurable numeric bases accepted",
    is(%mr_functionOfExponentialQ(2^X*4^X, X) = true)),
  check("foE: commensurable numeric bases state",
    %mr_functionOfExponential(2^X*4^X, X), 2^X),
  check_bool("foEF: F^(b x) -> X (v through the origin)",
    is(%mr_functionOfExponentialFunction(F^(B*X), X) = X)),
  /* Step 4 (2026-08-28, 5.50.0/SBCL): the emitted form is pinned
     exactly — %mr_functionOfExponentialFunction(sinh(B*X), X) reduces
     under %mr_simp to (X^2 - 1)/(2*X); the A/B corpus comparison relies
     on this form being deterministic. */
  check("foEF: sinh(b x) exact",
    %mr_functionOfExponentialFunction(sinh(B*X), X), (X^2 - 1)/(2*X)),
  /* Fix round 1: the :4303 head-preserving Map — the r104 call site
     is conditioned on Q alone, so any Q-true head must be rewritten
     (the old * / +-only arms would have returned sin(F^(b x))
     unchanged — a silent wrong rewrite). */
  check("foEF: sin head preserved",
    %mr_functionOfExponentialFunction(sin(F^(B*X)), X), sin(X)),
  check_bool("functionExpand: gamma(3) case value",
    is(abs(float(%mr_functionExpand(gamma_incomplete(3, 1.7)))
           - float(gamma_incomplete(3, 1.7))) < 1e-9)),
  check_bool("functionExpand: passthrough", is(%mr_functionExpand(F^X) = F^X)),
  /* is(sym # 0) is unknown (not true) on free symbols — the
     value-equality form is the sound assertion: ratsimp of the
     difference closes iff the quotient survived as a quotient. */
  check_bool("fullSimplify: quotient keeps quotient",
    is(ratsimp(denom(%mr_fullSimplify(G1*H1*log(G2)/(D1*E1*log(F1))))
               - D1*E1*log(F1)) = 0)),
  true
)$

/* Class-2 census cross-check (loadable subset; the full 3,180 table
   lives in the rules core / the TLS-flagged probe — the plain-process
   defmatch budget holds a handful of rules, the load-wall note in
   maxima_rubi.mac). */
test_class2_census() := block([saved_table],
   print("--- class-2 census cross-check (loadable subset) ---"),
   saved_table : mr_rule_table,
   %mr_load_sibling("rules/class2/2_2.mac", 'mr_witness_2_2),
   check("2.2 count = 4 (T1 inventory)", mr_rules_count_2_2, 4),
   check_bool("2.2 witness survived", is(mr_witness_2_2() = true)),
   check("core 1.1.1.1 count still 5", mr_rules_count_1_1_1_1, 5),
   mr_rule_table : saved_table,
   true
)$

/* Class-3 cluster A — the six cond-side predicate ports (milestone-3
   plan Task 4; the .m line refs are against the pinned Rubi clone's
   IntegrationUtilityFunctions.m). Storage facts pinned below were
   measured 2026-08-29 on branch_5_50_base_84_g4204fb669 / SBCL 2.6.7:
   * member(elem, list) is ORDER-REVERSED vs MemberQ[list, elem] and
     returns the boolean true/false (describe("member", exact));
   * false is the boolean atom (atom(false) = true) and
     is('false = false) = true (the quoted symbol compares =-equal);
   * a product's op is the string "*"; the product SIGN lifts to a
     top-level unary "-" node (op(-a*b) = "-"), where MA sees a
     Times head — %mr_productQ declines the lift (recorded);
   * ALL negative integer powers store as QUOTIENT nodes
     (op(x^(-2)) = "/", args [1, x^2]; op((x+1)^(-1)) = "/";
     (a/b)^2 stores as a^2/b^2), so the .m's negative-exponent
     IntegerPowerQ case reaches the port through the "/" branch;
   * a NOUN's op string()s to the head name (string(op) of the
     integrate fall-through noun is "integrate"; of 'unintegrable[.]
     "unintegrable"; of 'mr_int[.] "mr_int") and freeof(<symbol>, .)
     flags each of those head positions;
   * rat() is the Together stand-in (together is a noun in this
     build, M1 ledger); a rat() result is a plain node tree (op "/"
     for a single fraction, part() access is plain — the gcrat
     objects the M1 trap describes appear only behind num()/denom(),
     which the port never calls). */
test_class3_cluster_a() := block([],
  print("--- class-3 cluster A: small predicates ---"),
  /* %mr_memberQ — MemberQ[list, elem] over the order-reversed
     built-in member(elem, list). */
  check_bool("memberQ hit", is(%mr_memberQ([a, b, c], b) = true)),
  check_bool("memberQ first", is(%mr_memberQ([a, b, c], a) = true)),
  check_bool("memberQ last", is(%mr_memberQ([a, b, c], c) = true)),
  check_bool("memberQ miss", is(%mr_memberQ([a, b, c], d) = false)),
  check_bool("memberQ number hit", is(%mr_memberQ([1, 2], 2) = true)),
  check_bool("memberQ number miss", is(%mr_memberQ([1, 2], 3) = false)),
  check_bool("memberQ no part-inspection",
             is(%mr_memberQ([x + 1], x) = false)),
  check_bool("memberQ head-symbol list",
             is(%mr_memberQ(['asin, 'acos], 'asin) = true)),
  check_bool("memberQ head-symbol miss",
             is(%mr_memberQ(['asin, 'acos], 'atan) = false)),
  /* %mr_falseQ — true iff the value is the boolean false (the
     declined-predicate return at the 3.5 r1/r2/r13 call sites). */
  check_bool("falseQ false", is(%mr_falseQ(false) = true)),
  check_bool("falseQ declined result", is(%mr_falseQ(block([], false)) = true)),
  check_bool("falseQ true", is(%mr_falseQ(true) = false)),
  check_bool("falseQ zero", is(%mr_falseQ(0) = false)),
  check_bool("falseQ atom", is(%mr_falseQ(x) = false)),
  check_bool("falseQ noun", is(%mr_falseQ('f(x)) = false)),
  check_bool("falseQ list", is(%mr_falseQ([1, 2]) = false)),
  /* %mr_productQ — the op "*" test (ProductQ[_Times]). */
  check_bool("productQ two-factor", is(%mr_productQ(a*b) = true)),
  check_bool("productQ three-factor", is(%mr_productQ(a*b*c) = true)),
  check_bool("productQ calls", is(%mr_productQ(log(x)*sin(x)) = true)),
  check_bool("productQ atom", is(%mr_productQ(a) = false)),
  check_bool("productQ number", is(%mr_productQ(3) = false)),
  check_bool("productQ sum", is(%mr_productQ(a + b*x) = false)),
  check_bool("productQ monomial", is(%mr_productQ(x^2) = false)),
  check_bool("productQ quotient", is(%mr_productQ(x/(x + 1)) = false)),
  /* the minus-lift storage: op(-a*b) = "-" (measured 2026-08-29) —
     the port declines where MA's Times head would accept */
  check_bool("productQ minus lift declined",
             is(%mr_productQ(-a*b) = false)),
  /* %mr_integralFreeQ — the four .m heads over the package noun
     surface (mr_int / integrate / the mr_unintegrable noun). */
  check_bool("integralFreeQ closed form",
             is(%mr_integralFreeQ(x^2/2 + log(x)) = true)),
  check_bool("integralFreeQ integrate noun",
             is(%mr_integralFreeQ(integrate(tan(x^2), x)) = false)),
  check_bool("integralFreeQ integrate noun nested",
             is(%mr_integralFreeQ(x + integrate(f(x), x)) = false)),
  check_bool("integralFreeQ quoted mr_int",
             is(%mr_integralFreeQ('mr_int[f(x), x]) = false)),
  check_bool("integralFreeQ unintegrable noun",
             is(%mr_integralFreeQ('unintegrable[f(x), x]) = false)),
  check_bool("integralFreeQ mr_unintegrable value",
             is(%mr_integralFreeQ(mr_unintegrable(f(x), x)) = false)),
  check_bool("integralFreeQ answer natives free",
             is(%mr_integralFreeQ(expintegral_ei(x) + polylog(2, x)) = true)),
  /* %mr_inverseFunctionFreeQ — the .m :316-322 recursion over
     InverseFunctionQ / CalculusQ / Hypergeometric2F1 / AppellF1. */
  check_bool("iffQ atom", is(%mr_inverseFunctionFreeQ(5, x) = true)),
  check_bool("iffQ top log of x", is(%mr_inverseFunctionFreeQ(log(x), x) = false)),
  check_bool("iffQ top log x-free", is(%mr_inverseFunctionFreeQ(log(a), x) = true)),
  check_bool("iffQ nested inverse", is(%mr_inverseFunctionFreeQ(x + asin(x), x) = false)),
  check_bool("iffQ nested inverse x-free",
             is(%mr_inverseFunctionFreeQ(x^2 + asin(a), x) = true)),
  check_bool("iffQ power of log", is(%mr_inverseFunctionFreeQ(log(x^2), x) = false)),
  check_bool("iffQ trig arg recursion", is(%mr_inverseFunctionFreeQ(sin(x), x) = true)),
  check_bool("iffQ integrate noun",
             is(%mr_inverseFunctionFreeQ(integrate(f(x), x), x) = false)),
  /* the diff noun is the transparent calculus-head shape: the finite
     PRODUCT noun is a special internal object freeof() cannot see
     through (measured 2026-08-29 on branch_5_50_base_84_g4204fb669:
     freeof(x, product(f(x), x, 1, n)) = true while freeof(x,
     integrate(f(x), x)) = false) — a documented divergence on an
     input no call site produces (the rules emit no product heads,
     mr_int results carry closed forms or the integrate noun). */
  check_bool("iffQ diff noun (partial)",
             is(%mr_inverseFunctionFreeQ(diff(f(x, y), x), x) = false)),
  /* class 8 (2026-09-25): diff(f(x), x) is the formal derivative
     Derivative[1][f][x], which Rubi's InverseFunctionFreeQ walks into (its
     head is not a calculus head): inverse-function-free */
  check_bool("iffQ formal derivative is inverse-function-free",
             is(%mr_inverseFunctionFreeQ(diff(f(x), x), x) = true)),
  check_bool("iffQ evaluated const integral",
             is(%mr_inverseFunctionFreeQ(integrate(f(a), x), x) = true)),
  check_bool("iffQ hypergeometric",
             is(%mr_inverseFunctionFreeQ(hypergeometric([1, 2], [3], x), x) = false)),
  check_bool("iffQ hypergeometric x-free",
             is(%mr_inverseFunctionFreeQ(hypergeometric([1, 2], [3], a), x) = true)),
  check_bool("iffQ AppellF1",
             is(%mr_inverseFunctionFreeQ(AppellF1(1, 2, 3, 4, x), x) = false)),
  check_bool("iffQ AppellF1 x-free",
             is(%mr_inverseFunctionFreeQ(AppellF1(1, 2, 3, 4, a), x) = true)),
  /* %mr_rationalFunctionExponents — the .m :1618-1633 branch ladder.
     Branch 1 (polynomial -> {deg, 0}): */
  check("rfe x^2", %mr_rationalFunctionExponents(x^2, x), [2, 0]),
  check("rfe constant", %mr_rationalFunctionExponents(1, x), [0, 0]),
  check("rfe linear", %mr_rationalFunctionExponents(a*x + b, x), [1, 0]),
  check("rfe rational-coef polynomial", %mr_rationalFunctionExponents(x/2, x), [1, 0]),
  /* Branch 2 (integer power -> scaled recursion): */
  check("rfe (x+1)^3", %mr_rationalFunctionExponents((x + 1)^3, x), [3, 0]),
  check("rfe x^4", %mr_rationalFunctionExponents(x^4, x), [4, 0]),
  /* the .m's negative-exponent arm (u[[2]] < 0) — stored as a "/"
     node in this build, so it arrives through the quotient branch: */
  check("rfe 1/x", %mr_rationalFunctionExponents(1/x, x), [0, 1]),
  check("rfe x^(-2)", %mr_rationalFunctionExponents(x^(-2), x), [0, 2]),
  check("rfe (x+1)^(-1)", %mr_rationalFunctionExponents((x + 1)^(-1), x), [0, 1]),
  /* Branch 3 (product -> list sum): */
  check("rfe x*(x+1)", %mr_rationalFunctionExponents(x*(x + 1), x), [2, 0]),
  check("rfe x^2*(x+1)^3",
        %mr_rationalFunctionExponents(x^2*(x + 1)^3, x), [5, 0]),
  /* the minus-lift storage arm (the .m reads -u as a -1 product): */
  check("rfe -x", %mr_rationalFunctionExponents(-x, x), [1, 0]),
  check("rfe -(x+1)", %mr_rationalFunctionExponents(-(x + 1), x), [1, 0]),
  /* the "/" branch (Maxima storage of the .m's negative-power
     product): */
  check("rfe (x+1)/(x+2)", %mr_rationalFunctionExponents((x + 1)/(x + 2), x), [1, 1]),
  check("rfe x/(x+1)", %mr_rationalFunctionExponents(x/(x + 1), x), [1, 1]),
  check("rfe (x+1)/(x+2)^2",
        %mr_rationalFunctionExponents((x + 1)/(x + 2)^2, x), [1, 2]),
  check("rfe (x/(x+1))^2",
        %mr_rationalFunctionExponents((x/(x + 1))^2, x), [2, 2]),
  /* Branch 4 (sum -> rat-then-recursion; the Max[.,.] lst form when
     rat leaves a sum): */
  check("rfe x + 1/x", %mr_rationalFunctionExponents(x + 1/x, x), [2, 1]),
  check("rfe x + 1/x + 1/(x+1)",
        %mr_rationalFunctionExponents(x + 1/x + 1/(x + 1), x), [3, 2]),
  check("rfe rat corner (x^2+1)/x",
        %mr_rationalFunctionExponents(rat(x + 1/x), x), [2, 1]),
  check("rfe sum lst form x + sin(x)",
        %mr_rationalFunctionExponents(x + sin(x), x), [1, 0]),
  check("rfe sum lst form sin + cos",
        %mr_rationalFunctionExponents(sin(x) + cos(x), x), [0, 0]),
  /* Branch 5 (else {0, 0}): */
  check("rfe sin(x)", %mr_rationalFunctionExponents(sin(x), x), [0, 0]),
  check("rfe symbolic power", %mr_rationalFunctionExponents(x^a, x), [0, 0]),
  check("rfe sqrt", %mr_rationalFunctionExponents(sqrt(x), x), [0, 0]),
  true
)$

/* Class-3 cluster B — the five fractional-power Subst/derivative ports
   (milestone-3 plan Task 5; the .m refs are against the pinned Rubi
   clone's IntegrationUtilityFunctions.m — the block note in
   maxima_rubi_utils.mac carries the full measured session, 2026-08-29
   on branch_5_50_base_84_g4204fb669 / SBCL 2.6.7). Storage facts the
   pinned shapes rely on: log of a PURE power auto-expands
   (log((x+1)^(2/3)) -> (2 log(x+1))/3, log(sqrt(x+1)) -> log(x+1)/2)
   while log of a SUM keeps its argument (log(1 + (x+1)^(2/3)) stays)
    — the 3.5 r16 call site therefore only ever sees the fractional
    linear power inside a log sum, and the end-to-end pin uses that
    shape (the plan's bare log((x+1)^(2/3)) example does not survive
    Maxima simplification — recorded); negative fractional powers store
    as "/" nodes (declined by %mr_fractionalPowerQ — recorded); the
    %mr_simp stage normalizes the substituted integrand, and the
    4-list v slot carries the FACTORED form — the function's own
    rat() call (line 1: %mr_fractionalPowerOfLinear -> %mr_linearQ ->
    %mr_together -> rat) flips the simplifier into rat mode for the
    rest of the enclosing statement, and the in-scope %mr_simp keeps
    x^5*(b*log(x^2+1)+a) factored (measured 2026-08-29, note at the
    sfpol pin below). */
test_class3_cluster_b() := block([lst, lst2, sl],
  /* slot accessor, RED-safe: while the port is absent `lst` is a
     2-arg noun and part(lst, k > 2) hard-errors (measured 2026-08-29
     — the first RED run died at the base-slot pin); errcatch returns
     [value] on success and [] on error (the line-150 note), so the
     [] sentinel stays a clean FAIL, and the [value] unwrap pins the
     slot in the GREEN phase. */
  sl : lambda([l, k], block([p],
    p : errcatch(part(l, k)),
    if is(p = []) then p else part(p, 1))),
  print("--- class-3 cluster B: fractional-power Subst family ---"),
  /* %mr_easyDQ — the .m :7466-7495 ladder. */
  /* rule-1 strip (u_*x_^m_. with FreeQ[m,x]): the distinguishing
     shape — x^2*log(x+1) declines through every later arm (product:
     both factors x-dependent; not a linear-power product; not a
     [1,1] rational) yet is easy once the x^2 is stripped to
     log(x+1) -> x+1 (binomial): */
  check_bool("easyDQ strip arm distinguishes",
             is(%mr_easyDQ(x^2*log(x+1), x) = true)),
  check_bool("easyDQ strip const*x^2",
             is(%mr_easyDQ(a*x^2, x) = true)),
   /* the hard-core counterpin: log(x^x) auto-expands to x*log(x)
      (measured) and THAT product is easy (the strip lands on log
      ground), so the pin uses sqrt(x^x), which keeps its storage form
      (measured 2026-08-29): */
   check_not("easyDQ strip then hard core (sqrt(x^x))",
             %mr_easyDQ(x^2*sqrt(x^x), x)),
  /* the AtomQ || FreeQ || Length==0 True arm (Length==0 is
     unreachable — atoms are gated first, the utils note): */
  check_bool("easyDQ atom true", is(%mr_easyDQ(5, x) = true)),
  check_bool("easyDQ x-free true", is(%mr_easyDQ(a + b, x) = true)),
  /* the CalculusQ False arm: */
  check_not("easyDQ calculus noun false",
            %mr_easyDQ(integrate(f(x), x), x)),
   /* the Length==1 arm (parts of a 1-arg call; the hard counterpin is
      sqrt(x^x) — log(x^x) auto-expands to the x*log(x) product before
      the ladder sees it, measured): */
   check_bool("easyDQ length-1 log(x+1)",
              is(%mr_easyDQ(log(x+1), x) = true)),
   check_not("easyDQ length-1 sqrt(x^x)",
             %mr_easyDQ(sqrt(x^x), x)),
  /* the BinomialQ True arm: */
  check_bool("easyDQ binomial x+1", is(%mr_easyDQ(x + 1, x) = true)),
  /* the ProductOfLinearPowersQ True arm (not a binomial — 4 terms
     expanded; not [1,1] rational; both product factors x-dependent): */
  check_bool("easyDQ linear-power product",
             is(%mr_easyDQ((x+1)^2*(x+2), x) = true)),
  /* the RFE == {1,1} True arm and its [1,2] neighbor: */
  check_bool("easyDQ rational [1,1]",
             is(%mr_easyDQ((x+1)/(x+2), x) = true)),
  check_not("easyDQ rational [1,2] decline",
            %mr_easyDQ((x+1)/(x+2)^2, x)),
  /* the ProductQ arm (one x-free factor -> recurse on the other —
     a*log(x+1) is not a binomial, so the product arm is the true
     path; both x-dependent -> false; the recursion can land on the
     CalculusQ arm): */
  check_bool("easyDQ product one free factor",
             is(%mr_easyDQ(a*log(x+1), x) = true)),
  check_not("easyDQ product both x-factors",
            %mr_easyDQ((x+1)*(x+2)^x, x)),
  check_not("easyDQ product recurse to calculus",
            %mr_easyDQ(a*integrate(f(x), x), x)),
  /* the SumQ arm: */
  check_bool("easyDQ sum both easy",
             is(%mr_easyDQ(x + sin(x), x) = true)),
  check_not("easyDQ sum hard term",
            %mr_easyDQ(x^x + x, x)),
  /* the Length==2 arm (integer_log(x, 10) is the real 2-arg noun
     shape — log() takes 1 arg in this build, measured): */
  check_bool("easyDQ length-2 func free second arg",
             is(%mr_easyDQ(integer_log(x, 10), x) = true)),
  check_not("easyDQ length-2 power x^x",
            %mr_easyDQ(x^x, x)),
  /* the final else (a 3-arg call past every arm): */
  check_not("easyDQ fall-through 3-arg func",
            %mr_easyDQ(hypergeometric([1, 2], [3], x), x)),
  /* %mr_derivativeDivides — the .m :7450-7462 contract. */
  check_not("dd a*x decline", %mr_derivativeDivides(2*x, 5, x)),
  check_not("dd a*b*x decline", %mr_derivativeDivides(a*b*x, 5, x)),
  /* the v = 0 arm is unreachable (the utils note): the constant-y
     decline lands through the Exponent degree test instead: */
  check_not("dd constant y decline", %mr_derivativeDivides(5, 5, x)),
  /* the quotient-return shape (the PolynomialQ degree-test path and
     the EasyDQ path): */
  check("dd quotient over d/dx x^2",
        %mr_derivativeDivides(x^2, a*x, x), a/2),
  check("dd quotient over d/dx log(x+1)",
        %mr_derivativeDivides(log(x+1), 1/(x+1), x), 1),
  /* declines: degree mismatch / the quotient not x-free / an unknown
     function's derivative noun (the freeof walk sees the x in the
     'diff(f(x), x, 1) args): */
  check_not("dd degree mismatch decline",
            %mr_derivativeDivides(x^2, x^2, x)),
  check_not("dd quotient not x-free decline",
            %mr_derivativeDivides(x^2, a*x + b, x)),
  check_not("dd unknown function y decline",
            %mr_derivativeDivides(f(x), 5, x)),
  /* %mr_fractionalPowerOfLinear — the .m :6067-6076 contract in the
     (u, 1, false, x) call shape. */
  check("fpl (x+1)^(2/3)",
        %mr_fractionalPowerOfLinear((x+1)^(2/3), 1, false, x), [3, x+1]),
  check("fpl sqrt storage form",
        %mr_fractionalPowerOfLinear(sqrt(x+1), 1, false, x), [2, x+1]),
  /* the LCM accumulation over the SAME base (the sqrt survives only
     inside a log sum — log(sqrt(x+1)) auto-expands, measured): */
  check("fpl lcm accumulate same base",
        %mr_fractionalPowerOfLinear(a*(x+1)^(2/3)*log(1 + sqrt(x+1)), 1, false, x),
        [6, x+1]),
  /* the v-equality guard: a different linear base does not accumulate: */
  check("fpl different base ignored",
        %mr_fractionalPowerOfLinear((x+1)^(2/3)*(x+2)^(1/2), 1, false, x),
        [3, x+1]),
  /* the n > 1 guard: an integer exponent is not a fractional power
     (the {n, v} identity returns): */
  check("fpl integer exponent no match",
        %mr_fractionalPowerOfLinear((x+1)^2, 1, false, x), [1, false]),
  /* the LinearQ guard: a quadratic base declines: */
  check("fpl quadratic base no match",
        %mr_fractionalPowerOfLinear(sqrt(x^2 + 1), 1, false, x), [1, false]),
  /* the atom identity and the CalculusQ throw: */
  check("fpl atom identity",
        %mr_fractionalPowerOfLinear(a, 1, false, x), [1, false]),
  check("fpl calculus decline",
        %mr_fractionalPowerOfLinear(integrate(f(x), x)*(x+1)^(1/3), 1, false, x),
        false),
  /* %mr_substForFractionalPower — the .m :1873-1881 walk. */
  check("sfp atom x -> w",
        %mr_substForFractionalPower(x, x+1, 3, w, x), w),
  check("sfp atom non-x unchanged",
        %mr_substForFractionalPower(a, x+1, 3, w, x), a),
  check("sfp power of v -> x^m",
        %mr_substForFractionalPower((x+1)^(2/3), x+1, 3, w, x), x^2),
  check("sfp sqrt of v -> x",
        %mr_substForFractionalPower(sqrt(x+1), x+1, 2, w, x), x),
   /* a non-matching base maps over the parts (x -> w, 2 -> 2 — the
      sum re-canonicalizes to 2 + w, NOT 1 + w: the base's constant is
      part of the base, so it stays): */
   check("sfp wrong base walks",
         %mr_substForFractionalPower((x+2)^(2/3), x+1, 3, w, x),
         (2 + w)^(2/3)),
  /* the nested shape the call site actually sees (a log of a SUM
     keeps the fractional power — log of a pure power auto-expands): */
  check("sfp nested log sum",
        %mr_substForFractionalPower(log(1 + (x+1)^(2/3)), x+1, 3, w, x),
        log(x^2 + 1)),
   /* %mr_substForFractionalPowerOfLinear — the .m :6056-6063 4-list
      contract. The 3.5 r16 call-site shape end to end: the integrand
      (x+1)*(a + b*log(1 + (x+1)^(2/3))) — v is the integrand with
      (x+1)^(2/3) -> x^2, x -> x^3 - 1, times x^(3-1), %mr_simp'd.
      MEASURED 2026-08-29 (branch_5_50_base_84_g4204fb669/SBCL 2.6.7):
      the v slot is the FACTORED form, not the expanded sum — line 1's
      %mr_fractionalPowerOfLinear runs %mr_together (rat), and rat()
      flips the simplifier into rat mode for the REST of the enclosing
      statement: a rat-mode ratsimp keeps x^5*(b*log(x^2+1)+a)
      factored, while the same ratsimp without a rat call in the
      statement expands it (pure Maxima quirk, no project code in the
      loop — block([], rat(x+1), ratsimp(x^5*(b*log(x^2+1)+a))) is
      factored, the rat-free line expands; the mode does not leak into
      the next statement; bisect session probes v2-v24 +
      probe-rat-mode.mac T0-T6, 2026-08-29). Every real call carries
      the rat -> %mr_simp pair inside one statement, so the factored
      form is the stable contract and the pin uses it — is(factored =
      expanded) is FALSE in this build (measured), so the expanded
      spelling would fail despite algebraic equality. */
   lst : %mr_substForFractionalPowerOfLinear((x+1)*(a + b*log(1 + (x+1)^(2/3))), x),
   check("sfpol e2e v slot", sl(lst, 1),
         x^5*(b*log(x^2 + 1) + a)),
  check("sfpol e2e n slot", sl(lst, 2), 3),
  check("sfpol e2e base slot", sl(lst, 3), x + 1),
  check("sfpol e2e ff/b slot", sl(lst, 4), 1),
   /* the b != 1 slope pins the 1/b slot (w = -a/b + x^n/b =
      -1/2 + x^3/2); the v slot is factored per the rat-mode note
      above: */
   lst2 : %mr_substForFractionalPowerOfLinear((2*x+1)*(c + d*log(1 + (2*x+1)^(2/3))), x),
   check("sfpol slope-2 v slot", sl(lst2, 1),
         x^5*(d*log(x^2 + 1) + c)),
  check("sfpol slope-2 n slot", sl(lst2, 2), 3),
  check("sfpol slope-2 base slot", sl(lst2, 3), 2*x + 1),
  check("sfpol slope-2 ff/b slot", sl(lst2, 4), 1/2),
  /* the False decline: no fractional linear power anywhere: */
  check_bool("sfpol no fractional power decline",
             is(%mr_substForFractionalPowerOfLinear(x^2 + x + 1, x) = false)),
  check_bool("sfpol non-linear base decline",
             is(%mr_substForFractionalPowerOfLinear((a + b*log(x^2 + 1))*sqrt(x^2 + 1), x) = false)),
  true
)$

/* Matcher translation fixes (design docs/superpowers/specs/2026-09-14-
   matcher-translation-fixes-design.md 3.6; probes/matcher/12-translation-
   defects). PosQ/NegQ expectations are Rubi's PosAux
   (IntegrationUtilityFunctions.m :605-:642) worked by hand on Rubi's form;
   the factored inputs watch the normalizer deviation (design 3.2). */
t_disp_77(mm, x) := 77$
test_translation_fixes_seen() := block([saved_table, saved_seen, h77],
  print("--- the exact seen test (exact seen test design 3.1) ---"),
  /* mr_int: exact member only, on every call */
  h77 : %mr_defrule("layerA", 6, "(Int (Pattern |_t_u| (Blank)) (Pattern x (Blank Symbol)))",
                    t_disp_true, t_disp_77),
  saved_table : mr_rule_table,
  saved_seen : %mr_seen,
  mr_rule_table : [h77],
  %mr_seen : [x^2 + 2*x + 1],
  check("mr_int: a ratsimp-equal seen form in another stored form dispatches",
        mr_int((x + 1)^2, x), 77),
  %mr_seen : [(x + 1)^2],
  check("mr_int: an exact repeat takes the fall-through",
        mr_int((x + 1)^2, x), integrate((x + 1)^2, x)),
  %mr_seen : saved_seen,
  mr_rule_table : saved_table,
  check_not("%mr_seenp deleted", member('%mr_seenp, map(op, functions))),
  check_not("mr_int_exact deleted", member('mr_int_exact, map(op, functions))),
  check_not("rubi_hybrid deleted", member('rubi_hybrid, map(op, functions))),
  check_not("rubi_hybrid_exact deleted", member('rubi_hybrid_exact, map(op, functions))),
  true
)$

/* The two run switches and the depth-cap census (exact seen test design
   3.3). mr_nested_fallback decides what a nested call with no route
   returns; mr_max_depth is the cap mr_top counts against, and every cap
   hit is counted in mr_depth_cap_hits, which the driver writes to the
   run's .caps sidecar. The nesting rule below calls mr_int from its
   replacement, so a cap of 1 is hit one level down. */
t_disp_nest(mm, x) := mr_int(x^3, x)$
/* Re-dispatches its OWN integrand, so the nested call hits the seen test:
   the shape of a rule whose rewrite reproduces its integrand (the measured
   case is 1_2_1_9b r5, whose repl is mr_int(%mr_expandIntegrand(...), x)
   with %mr_expandIntegrand a no-op on that integrand). */
t_disp_self(mm, x) := mr_int(geteqR(mm, '_t_u), x)$
test_run_switches() := block(
  [saved_table, saved_seen, saved_fb, saved_cap, saved_hits, hnest],
  print("--- the run switches and the depth-cap census (exact seen test design 3.3) ---"),
  saved_table : mr_rule_table,
  saved_seen : %mr_seen,
  saved_fb : mr_nested_fallback,
  saved_cap : mr_max_depth,
  saved_hits : mr_depth_cap_hits,

  /* defaults: rules-only, cap 16 (the dispatcher's defmvars). The
     fall-through default is the value captured at load, before the suite
     bound it true for the behavioural checks (see the comment there). */
  check("mr_nested_fallback defaults to false", mr_default_nested_fallback, false),
  check("mr_max_depth defaults to 16", saved_cap, 16),
  /* the give-up reordering: on by default, the other half of the pair with
     the seen-cut fall-through (test_seen_cut_fallthrough below) */
  check("mr_giveup_last defaults to true", mr_default_giveup_last, true),

  /* an EMPTY table: every nested call finds no rule */
  mr_rule_table : [],
  %mr_seen : [],
  mr_nested_fallback : false,
  check("rules-only: a no-rule nested call returns the unintegrable noun",
        mr_int(x^2, x), mr_unintegrable(x^2, x)),
  mr_nested_fallback : true,
  check("fall-through: the same call goes to integrate",
        mr_int(x^2, x), integrate(x^2, x)),

  /* the depth cap and its census, on a rule that re-dispatches */
  hnest : %mr_defrule("layerA", 7,
                      "(Int (Pattern |_t_u| (Blank)) (Pattern x (Blank Symbol)))",
                      t_disp_true, t_disp_nest),
  mr_rule_table : [hnest],
  %mr_seen : [],
  mr_nested_fallback : false,
  mr_max_depth : 1,
  mr_depth_cap_hits : 0,
  check("a cap of 1 stops the nested dispatch at the unintegrable noun",
        mr_int(x^2, x), mr_unintegrable(x^3, x)),
  check("the census counted the cap hit", mr_depth_cap_hits, 1),
  mr_max_depth : 16,
  %mr_seen : [],
  mr_depth_cap_hits : 0,
  check("no cap hit is counted below the cap", mr_depth_cap_hits, 0),

  %mr_seen : saved_seen,
  mr_rule_table : saved_table,
  mr_nested_fallback : saved_fb,
  mr_max_depth : saved_cap,
  mr_depth_cap_hits : saved_hits,
  check_not("%mr_max_depth deleted", member('%mr_max_depth, values)),
  true
)$

/* The seen-cut fall-through (%mr_top_body). A nested re-dispatch of an
   integrand already on the dispatch path is a PORT artifact -- Rubi has no
   seen test -- so with fb = false it declines the rule (raises, which
   mr-apply-rule's errcatch reads as a repl misfire) and the dispatcher
   carries on down the table, instead of ending the whole dispatch on one
   rule's dead end. The fb = TRUE branch is untouched: its integrate
   fall-through is load-bearing (the 2026-08-25 measurement recorded there).
   Half of the faithful pair with mr_giveup_last. */
test_seen_cut_fallthrough() := block(
  [saved_table, saved_seen, saved_fb, hself, h42, pu2],
  print("--- the seen-cut fall-through (%mr_top_body) ---"),
  saved_table : mr_rule_table,
  saved_seen : %mr_seen,
  saved_fb : mr_nested_fallback,
  pu2 : "(Int (Pattern |_t_u| (Blank)) (Pattern x (Blank Symbol)))",
  hself : %mr_defrule("layerA", 8, pu2, t_disp_true, t_disp_self),
  h42 : %mr_defrule("layerA", 9, pu2, t_disp_true, t_disp_42),

  /* rules-only: the self-recursive rule declines and the NEXT rule answers.
     Before the fall-through this returned the unintegrable noun. */
  mr_rule_table : [hself, h42],
  %mr_seen : [],
  mr_nested_fallback : false,
  check("rules-only: a seen cut declines the rule and the dispatch continues",
        mr_int(x^2, x), 42),
  check("the seen list is balanced after the decline", %mr_seen, []),

  /* with no rule after it, the dispatch still ends on the noun -- the cut
     declines ONE rule, it does not invent an answer */
  mr_rule_table : [hself],
  %mr_seen : [],
  check("a seen cut with no rule below still answers the noun",
        mr_int(x^2, x), mr_unintegrable(x^2, x)),

  /* fb = true: unchanged -- the seen guard returns the integrate result,
     so the self-recursive rule ANSWERS and the rule below never runs */
  mr_rule_table : [hself, h42],
  %mr_seen : [],
  mr_nested_fallback : true,
  check("fall-through: the seen guard still returns the integrate result",
        mr_int(x^2, x), integrate(x^2, x)),

  %mr_seen : saved_seen,
  mr_rule_table : saved_table,
  mr_nested_fallback : saved_fb,
  true
)$

/* The ExpandExpression / SmartApart port (exact seen test design 3.4).
   Values measured 2026-09-16 on this build; the zero oracle for the
   radical shapes is radcan, NOT ratsimp: ratsimp cannot prove the
   difference zero once %mr_simplifyTerm has rewritten two conjugate
   radical denominators (nested sqrt(1+sqrt(a)) differs by
   (sqrt(a)+1)^2 - a - 2 sqrt(a) - 1, which is 0), while radcan and a
   numeric substitution both close it. */
mr_zero_radcan(e) := block([r],
  r : errcatch(ratsimp(radcan(e))),
  if r = [] then false else is(first(r) = 0))$
mr_nterms(e) := if %mr_sumQ(e) then length(args(e)) else 0$
test_expand_expression() := block([e4, ex, v, w],
  print("--- ExpandExpression / SmartApart (exact seen test design 3.4) ---"),
  e4 : (a+b*x)/((c+d*x)*(e+f*x)*(g+h*x)),
  /* the catch-all now partial-fractions instead of expanding the
     denominator: 1.1.1.4 e4, the entry that dispatched >= 794 declines */
  check("e4 splits into 3 partial fractions", mr_nterms(%mr_expandIntegrand(e4, x)), 3),
  check_bool("e4 split is value-preserving",
             mr_zero_radcan(%mr_expandIntegrand(e4, x) - e4)),
  ex : (a+b*x)/expand((c+d*x)*(e+f*x)*(g+h*x)),
  check("the expanded-denominator form splits too", mr_nterms(%mr_expandIntegrand(ex, x)), 3),
  check_bool("expanded-denominator split is value-preserving",
             mr_zero_radcan(%mr_expandIntegrand(ex, x) - ex)),
  check("a repeated linear factor splits", mr_nterms(%mr_expandIntegrand(1/((x+1)^2*(x+2)), x)), 3),
  check("a polynomial part splits off", mr_nterms(%mr_expandIntegrand((x^3+1)/(x+2), x)), 4),
  /* kept, as in Rubi: partfrac does not split these */
  check("an irreducible quadratic is kept as 2 terms",
        mr_nterms(%mr_expandIntegrand((x+1)/((x^2+x+1)*(x-2)), x)), 2),
  check("1/(a+b x^2) is unchanged", %mr_expandIntegrand(1/(a+b*x^2), x), 1/(a+b*x^2)),
  check("a symbolic exponent is unchanged",
        %mr_expandIntegrand(1/((x+a)^m*(x+b)), x), 1/((x+a)^m*(x+b))),
  /* radicals: value-preserving, oracle radcan (see the header) */
  check_bool("a nested-radical parameter is value-preserving",
             mr_zero_radcan(%mr_expandIntegrand(
               1/((x-sqrt(1+sqrt(a)))*(x+sqrt(1+sqrt(a)))), x)
               - 1/((x-sqrt(1+sqrt(a)))*(x+sqrt(1+sqrt(a)))))),
  check_bool("a radical coefficient is value-preserving",
             mr_zero_radcan(%mr_expandIntegrand(x/((x+sqrt(2))*(x-1)), x)
                            - x/((x+sqrt(2))*(x-1)))),
  /* the non-rational factor is split off and multiplied back */
  check("a non-rational factor splits around sqrt(x)",
        mr_nterms(%mr_expandIntegrand(sqrt(x)/((x+1)*(x+2)), x)), 2),
  check_bool("the non-rational split is value-preserving",
             mr_zero_radcan(%mr_expandIntegrand(sqrt(x)/((x+1)*(x+2)), x)
                            - sqrt(x)/((x+1)*(x+2)))),
  check("rationalFunctionFactors keeps the rational part",
        %mr_rationalFunctionFactors(sqrt(x)/((x+1)*(x+2)), x), 1/((x+1)*(x+2))),
  check("nonrationalFunctionFactors keeps the rest",
        %mr_nonrationalFunctionFactors(sqrt(x)/((x+1)*(x+2)), x), sqrt(x)),
  /* ExpandAlgebraicFunction, the cascade's first branch */
  check("expandAlgebraicFunction: (u_Plus) v",
        %mr_expandAlgebraicFunction((x+1)*sqrt(y), x), x*sqrt(y) + sqrt(y)),
  check("expandAlgebraicFunction: (u_Plus)^n v",
        %mr_expandAlgebraicFunction((x+1)^2*sqrt(y), x),
        x^2*sqrt(y) + 2*x*sqrt(y) + sqrt(y)),
  check("expandAlgebraicFunction declines a plain product",
        %mr_expandAlgebraicFunction(x*sqrt(y), x), false),
  /* Expand[u, x]: the x-free factors are KEPT unmultiplied */
  check("expand_x keeps the x-free factor",
        %mr_expand_x((a+b)^2*(x+1)^2, x),
        (a+b)^2*x^2 + 2*(a+b)^2*x + (a+b)^2),
  /* CollectReciprocals: the pair collapses, a non-pair does not */
  check("collectReciprocals collapses the reciprocal pair",
        %mr_collectReciprocals(1/(a+b*x) + 1/(a-b*x), x), 2*a/(a^2-b^2*x^2)),
  check("collectReciprocals leaves a non-pair alone",
        mr_nterms(%mr_collectReciprocals(1/(x+1) + 1/(x+2), x)), 2),
  /* ExpandCleanup must not recombine the terms: %mr_simplifyTerm returns
     a CRE and Maxima's "+" combines CRE operands into one fraction (the
     ratdisrep in %mr_expandCleanup) */
  check("expandCleanup keeps a 3-term split a sum",
        mr_nterms(%mr_expandCleanup(partfrac(e4, x), x)), 3),
  /* the two specific branches are unchanged */
  check("a positive-integer power of a sum still expands",
        %mr_expandIntegrand((x+1)^2, x), x^2 + 2*x + 1),
  check_bool("smartApart 2-arg and 3-arg agree",
             is(%mr_smartApart(e4, x) = %mr_smartApart(e4, x, x))),
  /* The cleanup cascade must be BOUNDED. %mr_simp's third stage is
     Maxima's multivariate factor(), and the cascade (SimplifyTerm,
     UnifyTerm) reaches it with the dense coefficients a wide product of
     binomial powers expands into. MEASURED 2026-09-16 (this build, one
     process per call, marker flushed before the call): factor() of the
     x^6 coefficient of the integrand below (9 kernels, 521 leaves,
     nterms 34) exhausts SBCL's 1 GiB dynamic space -- "Heap exhausted,
     game over", a FATAL runtime error errcatch cannot see, so the entry
     subprocess dies instead of declining. 1.2.3.2 e637/e660 died on it
     (both verified pre-port). No cheap metric predicts the blow-up
     (nterms 34 fatal, nterms 231 safe in 6 ms -- the cliff is
     reducibility, not size), so the cascade drops the factor stage
     rather than guarding it. */
  v : x^2*(a+b*x)^3*(c+d*x)^4*(e+f*x)^5*(g+h*x)^6*log(x),
  w : %mr_expandIntegrand(v, x),
  check("a wide binomial product expands into its 19 terms",
        mr_nterms(w), 19),
  check_bool("the wide-product expansion is value-preserving",
             mr_zero_radcan(w - v)),
  true
)$

test_translation_fixes_generator() := block([pairs],
  print("--- matcher translation fixes: integer comparisons, notequal, juxtaposition ---"),
  /* integer comparisons (Rubi :379-:395): IntegerQ[u] && u op n */
  check("iGtQ 3 0", %mr_iGtQ(3, 0), true),
  check("iGtQ 1/2 0 (fraction)", %mr_iGtQ(1/2, 0), false),
  check("iGtQ 2.0 0 (float)", %mr_iGtQ(2.0, 0), false),
  check("iGtQ n 0 (symbol)", %mr_iGtQ(n, 0), false),
  check("iGtQ 0 0", %mr_iGtQ(0, 0), false),
  check("iLtQ -1 0", %mr_iLtQ(-1, 0), true),
  check("iLtQ -1/2 0 (fraction)", %mr_iLtQ(-1/2, 0), false),
  check("iLeQ 0 0", %mr_iLeQ(0, 0), true),
  check("iLeQ -3/2 0 (fraction)", %mr_iLeQ(-3/2, 0), false),
  check("iGeQ 0 0", %mr_iGeQ(0, 0), true),
  check("iGeQ 1/2 0 (fraction)", %mr_iGeQ(1/2, 0), false),
  /* != -> notequal: numbers by value, a symbol undecided */
  check("notequal 2 1", is(notequal(2, 1)), true),
  check("notequal 1 1", is(notequal(1, 1)), false),
  check("notequal a 1 (symbol)", is(notequal(a, 1)), unknown),
  %mr_load_sibling("rules/class1/1_1_3_2.mac", 'mr_witness_1_1_3_2),
  %mr_load_sibling("rules/class1/1_1_4_1.mac", 'mr_witness_1_1_4_1),
  pairs : lambda([key, n, l], map(lambda([pr], concat('_mr_, key, "_r", n, "_", first(pr)) = second(pr)), l)),
  check("1_1_3_2 r17 cond: gcd(m+1, n) = 2, k != 1 holds",
        _mr_cond_1_1_3_2_r17(pairs("1_1_3_2", 17, [[a, a], [b, b], [p, p], [n, 2], [m, 1]]), x), true),
  check("1_1_3_2 r17 cond: gcd(m+1, n) = 1, k != 1 fails",
        _mr_cond_1_1_3_2_r17(pairs("1_1_3_2", 17, [[a, a], [b, b], [p, p], [n, 3], [m, 1]]), x), false),
  /* juxtaposition -> product: (a x^j + b x^n)^(p+1) / (b (n-j) (p+1) x^(n-1)) */
  /* errcatch: on an unfixed rule file the repl is an evaluation error */
  check("1_1_4_1 r1 repl on numbers",
        errcatch(ratsimp(_mr_repl_1_1_4_1_r1(pairs("1_1_4_1", 1, [[a, 1], [b, 2], [j, 1], [n, 3], [p, 2]]), x)
                         - (x + 2*x^3)^3/(12*x^2))), [0]),
  true
)$

test_translation_fixes_posaux() := block([],
  print("--- matcher translation fixes: the PosAux port and the First/Rest siblings ---"),
  /* PosQ / NegQ: PosAux branch by branch */
  check("negQ a/c", %mr_negQ(a/c), false),
  check("negQ e^2 b^2", %mr_negQ(e^2*b^2), false),
  check("negQ 4 a c e^2", %mr_negQ(4*a*c*e^2), false),
  check("negQ 2 (a+b)", %mr_negQ(2*(a + b)), false),
  check("negQ b^2-4ac", %mr_negQ(b^2 - 4*a*c), false),
  check("negQ -a", %mr_negQ(-a), true),
  check("negQ -4 e^2", %mr_negQ(-4*e^2), true),
  check("negQ 0", %mr_negQ(0), false),
  check("posQ -2/3 (number)", %mr_posQ(-2/3), false),
  check("posQ 0.5 (number)", %mr_posQ(0.5), true),
  check("posQ %pi-4 (numeric constant)", %mr_posQ(%pi - 4), false),
  check("posQ %pi-3 (numeric constant)", %mr_posQ(%pi - 3), true),
  /* errcatch: the strict sign() reading these replace errors on %i */
  check("posQ %i (complex, Re 0 -> Im)", errcatch(%mr_posQ(%i)), [true]),
  check("posQ -%i (complex, Re 0 -> Im)", errcatch(%mr_posQ(-%i)), [false]),
  check("posQ 2-3%i (complex, Re)", errcatch(%mr_posQ(2 - 3*%i)), [true]),
  check("posQ %i a (%i left to the structural branches)", errcatch(%mr_posQ(%i*a)), [true]),
  check("posQ (-1)^(1/4) (PosAux branch 2: N gives 0.707+0.707 I)", errcatch(%mr_posQ((-1)^(1/4))), [true]),
  check("posQ -(1+%i)/sqrt(2) (PosAux branch 2: N gives -0.707-0.707 I)", errcatch(%mr_posQ(-(1 + %i)/sqrt(2))), [false]),
  check("posQ exp(a) (non-integer power)", %mr_posQ(exp(a)), true),
  check("posQ -a^2 (decided by is)", %mr_posQ(-a^2), false),
  check("posQ log(a) (function)", %mr_posQ(log(a)), true),
  check("posQ 1/c (power -1)", %mr_posQ(1/c), true),
  /* the normalizer deviation: factored inputs */
  check("negQ (b-a)(c+d)", %mr_negQ((b - a)*(c + d)), true),
  check("negQ -(a-b)^2", %mr_negQ(-(a - b)^2), true),
  check("negQ (x-1)(x+2)", %mr_negQ((x - 1)*(x + 2)), true),
  check("posQ (a-b)^3", %mr_posQ((a - b)^3), true),
  check("posQ (a-b)^3 c", %mr_posQ((a - b)^3*c), true),
  check("posQ a/c-b/c", %mr_posQ(a/c - b/c), true),
  check("posQ sqrt(a-b)(c-d)", %mr_posQ(sqrt(a - b)*(c - d)), true),
  /* the First/Rest siblings read the internal order */
  check("negSumBaseQ a-b (First = a)", %mr_rt_negSumBaseQ(a - b), false),
  check("negSumBaseQ b-a (First = -a)", %mr_rt_negSumBaseQ(b - a), true),
  check("someNegTermQ a+b", %mr_rt_someNegTermQ(a + b), false),
  check("splitSum takes the first term (internal order)", %mr_splitSum(lambda([t], [t]), b - a), [[-a], b]),
  check("product_factors a/b", %mr_product_factors(a/b), [a, 1/b]),
  check("product_factors -a*b", %mr_product_factors(-a*b), [-1, a, b]),
  check("removeContentAux -1+x (NegQ[First] -> -u)", %mr_removeContentAux(x - 1, x), 1 - x),
  check("removeContentAux a-b (First = a)", %mr_removeContentAux(a - b, x), a - b),
  true
)$

/* ---- class 6 (hyperbolic) cluster A: the small predicates ----
   docs/class-porting.md Step 4. Census groups D (partial):
   HyperbolicQ 11 rules, IndependentQ 6, MemberQ 1 (already ported —
   the checks here verify it covers the head-LIST call shape class 6
   introduces, MemberQ[{Sinh, Cosh}, F], which no class-1-3 rule used).

   Rubi (reference/rubi/Rubi/IntegrationUtilityFunctions.m):
     L255-256  $HyperbolicFunctions = {Sinh,Cosh,Tanh,Coth,Sech,Csch};
               HyperbolicQ[u_] := MemberQ[$HyperbolicFunctions,
                                          If[AtomQ[u],u,Head[u]]]
     L149-150  IndependentQ[u_,x_] := FreeQ[u,x]

   The AtomQ branch is not decoration: class 6 calls HyperbolicQ[F] on a
   BOUND HEAD SYMBOL from a head-position capture (6.7.7, 6.7.9), where u
   is the atom sinh, not an application. Both branches are checked.
   MEASURED 2026-09-20 (branch_5_50_base_84_g4204fb669 / SBCL 2.6.7):
   atom(sinh) = true, atom(sinh(x)) = false, op(sinh(x)) = sinh and
   is(op(sinh(x)) = sinh) = true, is(member(sinh, [sinh, cosh]) = true)
   = true. */
test_class6_cluster_a() := block([],
  print("--- class 6 cluster A: hyperbolicQ / independentQ / memberQ head list ---"),
  /* HyperbolicQ, the AtomQ branch: a bound head symbol */
  check("hyperbolicQ sinh (atom)", %mr_hyperbolicQ(sinh), true),
  check("hyperbolicQ cosh (atom)", %mr_hyperbolicQ(cosh), true),
  check("hyperbolicQ tanh (atom)", %mr_hyperbolicQ(tanh), true),
  check("hyperbolicQ coth (atom)", %mr_hyperbolicQ(coth), true),
  check("hyperbolicQ sech (atom)", %mr_hyperbolicQ(sech), true),
  check("hyperbolicQ csch (atom)", %mr_hyperbolicQ(csch), true),
  /* HyperbolicQ, the Head branch: an application */
  check("hyperbolicQ sinh(x)", %mr_hyperbolicQ(sinh(x)), true),
  check("hyperbolicQ cosh(a+b*x)", %mr_hyperbolicQ(cosh(a + b*x)), true),
  check("hyperbolicQ csch(2*x)", %mr_hyperbolicQ(csch(2*x)), true),
  /* negatives: the circular heads are a DIFFERENT list, and a
     non-hyperbolic atom or expression declines */
  check("hyperbolicQ sin (atom) declines", %mr_hyperbolicQ(sin), false),
  check("hyperbolicQ sin(x) declines", %mr_hyperbolicQ(sin(x)), false),
  check("hyperbolicQ asinh (atom) declines", %mr_hyperbolicQ(asinh), false),
  check("hyperbolicQ log(x) declines", %mr_hyperbolicQ(log(x)), false),
  check("hyperbolicQ x declines", %mr_hyperbolicQ(x), false),
  check("hyperbolicQ 3 declines", %mr_hyperbolicQ(3), false),
  /* a hyperbolic POWER is not itself a hyperbolic: Head is "^" */
  check("hyperbolicQ sinh(x)^2 declines (head is the power)",
        %mr_hyperbolicQ(sinh(x)^2), false),
  /* IndependentQ = FreeQ */
  check("independentQ 3*a free of x", %mr_independentQ(3*a, x), true),
  check("independentQ 3*x not free of x", %mr_independentQ(3*x, x), false),
  check("independentQ x itself", %mr_independentQ(x, x), false),
  check("independentQ a constant", %mr_independentQ(7, x), true),
  check("independentQ sinh(a) free of x", %mr_independentQ(sinh(a), x), true),
  check("independentQ sinh(x) not free", %mr_independentQ(sinh(x), x), false),
  /* MemberQ already exists (maxima_rubi_utils.mac L4753); these verify
     the head-LIST shape 6.7.6 r28 emits, %mr_memberQ([sinh, cosh], F) */
  check("memberQ head list [sinh,cosh] has sinh", %mr_memberQ([sinh, cosh], sinh), true),
  check("memberQ head list [sinh,cosh] has cosh", %mr_memberQ([sinh, cosh], cosh), true),
  check("memberQ head list [sech,csch] lacks sinh", %mr_memberQ([sech, csch], sinh), false),
  check("memberQ head list lacks a circular head", %mr_memberQ([sinh, cosh], sin), false),
  true
)$

/* ---- class 6 cluster B: the QuotientOfLinears family ----
   docs/class-porting.md Step 4. Census group D/E: QuotientOfLinearsQ 2
   rules, QuotientOfLinearsParts 2 rules (6.7.9 r53/r54, Int[Sinh[u]^n]
   and Int[Cosh[u]^n] where u is a quotient of linears).

   Rubi (IntegrationUtilityFunctions.m L1729-1795):
     QuotientOfLinearsParts[u,x] returns {a,b,c,d} with u == (a+b x)/(c+d x)
       a_*u_ /; FreeQ[a,x] -> {a #1, a #2, #3, #4}
       a_+u_ /; FreeQ[a,x] -> {#1+a #3, #2+a #4, #3, #4}
       1/u_                -> {#3, #4, #1, #2}
       u_ /; LinearQ       -> {Coefficient[u,x,0], Coefficient[u,x,1], 1, 0}
       u_/v_ /; both linear-> {u0, u1, v0, v1}
       else  u===x -> {0,1,1,0};  FreeQ -> {u,0,1,0}
     QuotientOfLinearsQ[u,x] := QuotientOfLinearsP[u,x]
                                && NeQ[parts[[2]],0] && NeQ[parts[[4]],0]
     (and a ListQ branch: every element must satisfy it)

   The b!=0 && d!=0 clause is what makes Q strictly NARROWER than "has
   the shape": a bare linear (d = 0) and a bare reciprocal (b = 0) both
   have Parts but are NOT quotients of linears.

   The generated call sites pin the contract — rules/class6/6_7_9.mac
   L429 reads the result as (lst[1] + lst[2]*x)/(lst[3] + lst[4]*x). */
test_class6_cluster_b() := block([],
  print("--- class 6 cluster B: quotientOfLinears Q / Parts ---"),
  /* Parts: the LinearQ clause */
  check("qolParts linear 2+3x", %mr_quotientOfLinearsParts(2 + 3*x, x), [2, 3, 1, 0]),
  /* Parts: the u/v clause */
  check("qolParts (2+3x)/(4+5x)",
        %mr_quotientOfLinearsParts((2 + 3*x)/(4 + 5*x), x), [2, 3, 4, 5]),
  /* Parts: the 1/u clause swaps the pairs */
  check("qolParts 1/(4+5x)", %mr_quotientOfLinearsParts(1/(4 + 5*x), x), [1, 0, 4, 5]),
  /* Parts: x itself, and an expression free of x */
  check("qolParts x", %mr_quotientOfLinearsParts(x, x), [0, 1, 1, 0]),
  check("qolParts a (free of x)", %mr_quotientOfLinearsParts(a, x), [a, 0, 1, 0]),
  /* Parts: a free multiplicative factor scales the numerator pair */
  check("qolParts 7*(2+3x)/(4+5x)",
        %mr_quotientOfLinearsParts(7*(2 + 3*x)/(4 + 5*x), x), [14, 21, 4, 5]),
  /* Parts: a free additive term folds into the numerator */
  check("qolParts 2 + (1+x)/(3+4x)",
        %mr_quotientOfLinearsParts(2 + (1 + x)/(3 + 4*x), x), [7, 9, 3, 4]),
  /* Q: the b!=0 && d!=0 gate */
  check("qolQ (2+3x)/(4+5x)", %mr_quotientOfLinearsQ((2 + 3*x)/(4 + 5*x), x), true),
  check("qolQ x/(1+x)", %mr_quotientOfLinearsQ(x/(1 + x), x), true),
  check("qolQ bare linear declines (d = 0)",
        %mr_quotientOfLinearsQ(2 + 3*x, x), false),
  check("qolQ bare reciprocal declines (b = 0)",
        %mr_quotientOfLinearsQ(1/(4 + 5*x), x), false),
  check("qolQ free of x declines", %mr_quotientOfLinearsQ(a, x), false),
  check("qolQ x alone declines (d = 0)", %mr_quotientOfLinearsQ(x, x), false),
  /* Q: a non-shape declines */
  check("qolQ x^2/(1+x) declines", %mr_quotientOfLinearsQ(x^2/(1 + x), x), false),
  check("qolQ sinh(x)/(1+x) declines", %mr_quotientOfLinearsQ(sinh(x)/(1 + x), x), false),
  /* Q: the ListQ branch — every element must satisfy it */
  check("qolQ list all good",
        %mr_quotientOfLinearsQ([(2 + 3*x)/(4 + 5*x), x/(1 + x)], x), true),
  check("qolQ list with one bad member",
        %mr_quotientOfLinearsQ([(2 + 3*x)/(4 + 5*x), x^2], x), false),
  true
)$

/* ---- class 6 cluster C: the ExpandTrig family ----
   docs/class-porting.md Step 4. Census group E, the class's biggest
   porting item: ExpandTrigReduce 26 rules, ExpandTrigToExp 4,
   ExpandTrigExpand 1. The generated call arities, counted over the
   class-6 rule files, are 2-arg Reduce x9, 3-arg Reduce x17, 3-arg
   ToExp x4, 6-arg Expand x1. (A glob path is deliberately NOT written
   in this comment: Maxima NESTS block comments, so a directory name
   followed by slash-star opens one that never closes. Measured
   2026-09-20 — it cost a run, "incorrect syntax: end of file in
   comment", with no Results line at all.)

   Rubi (IntegrationUtilityFunctions.m L4030-4092):
     ExpandTrigReduce[u,v,x] := u * ExpandTrigReduce[v,x], distributed
       over the terms when the inner result is a Sum
     ExpandTrigReduce[u,x]  := ExpandTrigReduceAux = Expand[TrigReduce[u]],
       then NormalizeTrigReduce over the terms
     NormalizeTrigReduce[a_.*F_[u_]^n_.,x] := a*F[ExpandToSum[u,x]]^n
       /; PolynomialQ[u,x] && Exponent[u,x]>0
     ExpandTrigToExp[u,v,x]  := TrigToExp, SimplifyIntegrand per term,
       then ExpandIntegrand[FreeFactors, NonfreeFactors, x]
     ExpandTrigExpand[u,F,v,m,n,x] := Expand[TrigExpand[F[n x]]^m] /. x->v,
       times u, distributed over a Sum

   Substrate MEASURED 2026-09-20 (branch_5_50_base_84_g4204fb669):
   expand(trigreduce(sinh(x)^3)) = sinh(3*x)/4-3*sinh(x)/4;
   expand(trigreduce(sinh(a+b*x)^2)) = cosh(2*b*x+2*a)/2-1/2;
   trigexpand(cosh(2*x)) = sinh(x)^2+cosh(x)^2;
   exponentialize(sinh(x)) = (%e^x-%e^-x)/2, op "/" (NOT a sum — MMA's
   TrigToExp returns the distributed form, so the port expands). */
test_class6_cluster_c() := block([w],
  print("--- class 6 cluster C: expandTrigReduce / ToExp / Expand ---"),
  /* The value checks go through exponentialize() BEFORE ratsimp.
     ratsimp alone treats sinh(3*x) and sinh(x) as unrelated atoms, so it
     cannot close a multiple-angle identity and reports a nonzero
     residual for a CORRECT reduction — measured 2026-09-20, and it cost
     a green cycle. Verified independently at x = 0.713: all four
     residuals are ~1e-16. Exponential form makes the identity rational
     and ratsimp closes it. */
  /* 2-arg Reduce: the product-to-sum reduction the 26 rules exist for */
  check("etr sinh^3 reduces to multiple angles",
        %mr_expandTrigReduce(sinh(x)^3, x), sinh(3*x)/4 - 3*sinh(x)/4),
  check("etr sinh^3 preserves value",
        ratsimp(exponentialize(%mr_expandTrigReduce(sinh(x)^3, x))
                - exponentialize(sinh(x)^3)), 0),
  /* 2-arg Reduce: NormalizeTrigReduce expands the inner argument to a
     sum — 2*(a+b*x) must come back as 2*b*x+2*a, not stay factored */
  check("etr sinh(a+b x)^2 normalizes the inner argument",
        %mr_expandTrigReduce(sinh(a + b*x)^2, x), cosh(2*b*x + 2*a)/2 - 1/2),
  /* 3-arg Reduce distributes u over the reduced SUM */
  check("etr 3-arg distributes over the sum",
        %mr_expandTrigReduce(x^2, sinh(x)^3, x),
        x^2*sinh(3*x)/4 - 3*x^2*sinh(x)/4),
  /* 3-arg Reduce, inner result NOT a sum: plain multiplication */
  check("etr 3-arg non-sum multiplies",
        %mr_expandTrigReduce(x, sinh(x)*cosh(x), x), x*sinh(2*x)/2),
  check("etr 3-arg non-sum preserves value",
        ratsimp(exponentialize(%mr_expandTrigReduce(x, sinh(x)*cosh(x), x))
                - exponentialize(x*sinh(x)*cosh(x))), 0),
  /* ToExp: the hyperbolic head is gone and the value is preserved */
  w : %mr_expandTrigToExp(1, sinh(x), x),
  check("ette sinh -> exponentials, no sinh left", freeof(sinh, w), true),
  check("ette sinh preserves value",
        ratsimp(exponentialize(w) - exponentialize(sinh(x))), 0),
  check("ette carries the u factor",
        ratsimp(exponentialize(%mr_expandTrigToExp(x, cosh(x), x))
                - exponentialize(x*cosh(x))), 0),
  check("ette cosh -> exponentials, no cosh left",
        freeof(cosh, %mr_expandTrigToExp(x, cosh(x), x)), true),
  /* Expand: TrigExpand of F[n x], then x -> v, then times u */
  check("ete cosh(2x) expands then substitutes v",
        %mr_expandTrigExpand(1, cosh, v, 1, 2, x), sinh(v)^2 + cosh(v)^2),
  check("ete distributes u over the sum",
        %mr_expandTrigExpand(x, cosh, v, 1, 2, x),
        x*sinh(v)^2 + x*cosh(v)^2),
  check("ete preserves value (cosh(2v))",
        ratsimp(exponentialize(%mr_expandTrigExpand(1, cosh, v, 1, 2, x))
                - exponentialize(cosh(2*v))), 0),
  true
)$

/* Inert-trig rewrite tables (inert-trig substrate design 3.2). One fired
 * clause and one non-matching input per table, so a table that loads empty
 * or matches everything both fail. The table file is loaded under errcatch
 * and the length checks test listp first, so a missing table is a counted
 * FAIL, never a run that dies without its Results line.
 *
 * FixInertTrigFunction[csc[v_]^m_.*(c_.*sin[w_])^n_., x] :=
 *     sin[v]^(-m)*(c*sin[w])^n /; FreeQ[{c,n},x] && IntegerQ[m]
 * (IntegrationUtilityFunctions.m L6237, clause 3) so csc(x)^2*sin(x) ->
 * sin(x)^(-2)*(1*sin(x))^1, with INERT heads throughout. It is the FIRST
 * clause that accepts: clause 1 (a_*u_ /; FreeQ[a,x]) binds but every split
 * of the two factors leaves x in a, and clause 2 (u_.*(a_*(b_+v_))^n_) needs
 * a power whose base is a product with a sum — neither factor is one. Both
 * sides of check simplify, so the expected value is the clause's replacement
 * as Maxima writes it back: %mr_isin(x)^(-2)*%mr_isin(x) = 1/%mr_isin(x). */
test_inert_trig_rewrites() := block([],
  print("--- inert-trig rewrite tables ---"),
  errcatch(%mr_load_sibling("rules/utils/inert_trig_rewrites.mac",
                            'mr_witness_inert_trig_rewrites)),
  check("fitf: csc^m (c sin)^n clause fires",
        %mr_fixInertTrigFunction(%mr_icsc(x)^2 * %mr_isin(x), x),
        %mr_isin(x)^(-2) * %mr_isin(x)),
  /* FixInertTrigFunction[a_*u_, x] := a*FixInertTrigFunction[u,x] /; FreeQ[a,x]
   * (L6228, clause 1) is the self-recursive clause and the first one that
   * accepts 3*csc(x)^2*sin(x): a = 3, u = csc(x)^2*sin(x). The constant
   * comes out and the walk re-enters, where clause 3 fires as above. */
  check("fitf: free factor comes out, recursion re-enters",
        %mr_fixInertTrigFunction(3 * %mr_icsc(x)^2 * %mr_isin(x), x),
        3 * %mr_isin(x)^(-2) * %mr_isin(x)),
  /* log(x): no structured clause binds, so the answer comes from the
   * unconditioned catch-all u_ (fitf clause 61, uitf clause 68, both
   * registered with the literal cond true). A walk that found no clause
   * would also return log(x), so these two checks do not by themselves
   * tell the catch-all from table exhaustion. */
  check("fitf: an expression no clause matches is returned unchanged",
        %mr_fixInertTrigFunction(log(x), x), log(x)),
  check("uitf: an expression no clause matches is returned unchanged",
        %mr_unifyInertTrigFunction(log(x), x), log(x)),
  check_bool("uitf table is not empty",
             is(listp(mr_rw_uitf) and length(mr_rw_uitf) = 75)),
  check_bool("fitf table is not empty",
             is(listp(mr_rw_fitf) and length(mr_rw_fitf) = 61)),
  check_bool("rit table is not empty",
             is(listp(mr_rw_rit) and length(mr_rw_rit) = 4)),
  true
)$

/* Task 4 fix round 1: the 3-argument ReduceInertTrig and
 * PowerOfInertTrigSumQ (Rubi IntegrationUtilityFunctions.m L6509 and
 * L6487). Every expected value is derived by hand from the .m text; the
 * derivations are in the fix report
 * (.superpowers/sdd/2026-09-20-inert-trig-substrate/task-4-report.md). A
 * call is wrapped in errcatch so a missing arity counts as a failure
 * instead of killing the run. */
_t_rit(_t_rit_args) := block([_t_rit_r],
  _t_rit_r : errcatch(apply(%mr_reduceInertTrig, _t_rit_args)),
  if _t_rit_r = [] then 'rit_error else first(_t_rit_r))$

test_inert_trig_reduce_powersum() := block([_t_fitf_u, _t_fitf_first],
  print("--- ReduceInertTrig 3-arg / PowerOfInertTrigSumQ ---"),
  /* clause 1: x+Pi binds m*n = 1, m*u+v = x; 3-arg m = 1: m>=1, sin arm
   * -> -RIT[sin, 0, x]; m = 0 falls to func[0*Pi+x] = sin(x). */
  check("rit: sin(x+pi) = -sin(x)",
        _t_rit([%mr_isin, x + %pi]), -%mr_isin(x)),
  /* m = 1, tan arm -> +RIT[tan, 0, x] = tan(x). */
  check("rit: tan(x+pi) = tan(x)",
        _t_rit([%mr_itan, x + %pi]), %mr_itan(x)),
  /* m*n = 1/2: m>=1/2, cos arm -> -RIT[sin, 0, x] = -sin(x). */
  check("rit: cos(x+pi/2) = -sin(x)",
        _t_rit([%mr_icos, x + %pi/2]), -%mr_isin(x)),
  check("rit 3-arg: cos, 1/2, x = -sin(x)",
        _t_rit([%mr_icos, 1/2, x]), -%mr_isin(x)),
  /* m = 5/2: m>=2 -> RIT[sin, Mod[5/2,2] = 1/2, x]; m>=1/2, sin arm
   * -> +RIT[cos, 0, x] = cos(x). */
  check("rit 3-arg: sin, 5/2, x = cos(x) (Mod branch)",
        _t_rit([%mr_isin, 5/2, x]), %mr_icos(x)),
  check("rit: sin(x+5*pi/2) = cos(x) (Mod branch via clause 1)",
        _t_rit([%mr_isin, x + 5*%pi/2]), %mr_icos(x)),
  /* m = -1/2: m<0, not m>=-1/4, sin arm -> -RIT[sin, 1/2, -x]; m = 1/2,
   * sin arm -> +RIT[cos, 0, -x] = cos(-x). Inert heads do not simplify
   * parity, so cos(-x) stays. */
  check("rit 3-arg: sin, -1/2, x = -cos(-x) (sign-flip Switch)",
        _t_rit([%mr_isin, -1/2, x]), -%mr_icos(-x)),
  check("rit: sin(x-pi/2) = -cos(-x) (sign flip via clause 1)",
        _t_rit([%mr_isin, x - %pi/2]), -%mr_icos(-x)),
  /* m = -1/4: m<0 and m>=-1/4 -> func[m*Pi+u] = tan(x - pi/4). */
  check("rit 3-arg: tan, -1/4, x = tan(x-pi/4) (small negative m kept)",
        _t_rit([%mr_itan, -1/4, x]), %mr_itan(x - %pi/4)),
  /* RationalQ[m] fails: the definition does not apply, so the call stays
   * unevaluated -- the noun form. */
  check("rit 3-arg: non-rational m stays unevaluated",
        _t_rit([%mr_isin, k, x]), '%mr_reduceInertTrig(%mr_isin, k, x)),
  /* clause 2 (L6500), the hyperbolic side: an IMAGINARY multiple of Pi.
   * i*(x + i*Pi/2): mr-tree gives (Times #C(0 1) (Plus x (Times #C(0 1/2)
   * Pi))), so Complex[0,mz] binds mz = 1, m = 1, Complex[0,nz] binds
   * nz = 1/2, n = 1, u = x, v = 0. RIT[sin, -m*mz*n*nz = -1/2,
   * m*mz*I*u+v = i*x]; 3-arg m = -1/2: sin arm -> -RIT[sin, 1/2, -i*x]
   * -> -RIT[cos, 0, -i*x] = -cos(-i*x). (Check: sin(i*x - Pi/2) =
   * -cos(i*x).) */
  check("rit r2: sin(i*(x+i*pi/2)) = -cos(-i*x)",
        _t_rit([%mr_isin, %i*(x + %i*%pi/2)]), -%mr_icos(-%i*x)),
  check("rit r2 alone gives it",
        %mr_rewrite("ReduceInertTrig", [_mr_rw_rit_r2], %mr_isin,
                    %i*(x + %i*%pi/2)),
        -%mr_icos(-%i*x)),
  /* ... and r1 declines it (n would bind the complex 1/2*i, which fails
   * RationalQ), so r2 is the first clause that fires. %mr_rewrite returns
   * its first argument when no clause fires. */
  check("rit r1 declines the imaginary multiple",
        %mr_rewrite("ReduceInertTrig", [_mr_rw_rit_r1], %mr_isin,
                    %i*(x + %i*%pi/2)),
        %mr_isin),
  /* 2*i*(x + i*Pi): -m*mz*n*nz = -2, u -> 2*i*x. 3-arg m = -2: sin arm
   * -> -RIT[sin, 2, -2*i*x] -> Mod[2,2] = 0 -> -sin(-2*i*x).
   * (Check: sin(2*i*x - 2*Pi) = sin(2*i*x).) */
  check("rit r2: sin(2*i*(x+i*pi)) = -sin(-2*i*x)",
        _t_rit([%mr_isin, 2*%i*(x + %i*%pi)]), -%mr_isin(-2*%i*x)),
  /* PowerOfInertTrigSumQ[u, func, x], L6487. */
  check_bool("powersumQ: a+b*sin(x) (first MatchQ, a /= 0)",
             is(%mr_powerOfInertTrigSumQ(a + b*%mr_isin(x), %mr_isin, x) = true)),
  check_bool("powersumQ: (a+b*(c*sin(x))^2)^(1/2) (first MatchQ)",
             is(%mr_powerOfInertTrigSumQ((a + b*(c*%mr_isin(x))^2)^(1/2),
                                          %mr_isin, x) = true)),
  check_bool("powersumQ: a+b*sin(x)^2+c*sin(x)^4 (second MatchQ only)",
             is(%mr_powerOfInertTrigSumQ(a + b*%mr_isin(x)^2 + c*%mr_isin(x)^4,
                                          %mr_isin, x) = true)),
  check_bool("powersumQ: a+b*cos(x) is not a sin power sum",
             is(%mr_powerOfInertTrigSumQ(a + b*%mr_icos(x), %mr_isin, x) = false)),
  /* sin(x)^2: a = 0 with p = 1 integer (or n = 1): the Not[...] excludes it,
   * and the second pattern needs two func terms. */
  check_bool("powersumQ: bare sin(x)^2 is excluded by the Not clause",
             is(%mr_powerOfInertTrigSumQ(%mr_isin(x)^2, %mr_isin, x) = false)),
  /* fitf clause 37 (L6380): u_.*sec[v_]^n_.*w_ := cos[v]^(-n)*
   * FixInertTrigFunction[u*w,x] /; PowerOfInertTrigSumQ[w,sin,x] &&
   * IntegerQ[n]. sec(x)^2*(a+b*sin(x)): u = 1, v = x, n = 2,
   * w = a+b*sin(x); the inner walk leaves a+b*sin(x) unchanged. */
  _t_fitf_u : %mr_isec(x)^2 * (a + b*%mr_isin(x)),
  check("fitf r37 (PowerOfInertTrigSumQ cond) fires",
        %mr_fixInertTrigFunction(_t_fitf_u, x),
        %mr_icos(x)^(-2) * (a + b*%mr_isin(x))),
  check("fitf r37 alone rewrites the input",
        %mr_rewrite("FixInertTrigFunction", [_mr_rw_fitf_r37], _t_fitf_u, x),
        %mr_icos(x)^(-2) * (a + b*%mr_isin(x))),
  /* ... and it is the FIRST clause that does: every handle ahead of it in
   * table order leaves the input alone. */
  _t_fitf_first : true,
  for _t_fitf_i : 1 thru 36 do
    if %mr_rewrite("FixInertTrigFunction", [part(mr_rw_fitf, _t_fitf_i)],
                   _t_fitf_u, x) # _t_fitf_u
    then _t_fitf_first : false,
  check_bool("fitf: no clause before r37 claims sec(x)^2*(a+b*sin(x))",
             _t_fitf_first),
  /* ActivateTrig and the inert predicates (inert-trig substrate design 3.2).
   * %mr_activateTrig is the inverse of the head map of design 3.1. */
  check("activateTrig: one head", %mr_activateTrig(%mr_isin(x)), sin(x)),
  check("activateTrig: all six",
        %mr_activateTrig(%mr_isin(x) + %mr_icos(x) + %mr_itan(x)
                         + %mr_icot(x) + %mr_isec(x) + %mr_icsc(x)),
        sin(x) + cos(x) + tan(x) + cot(x) + sec(x) + csc(x)),
  check("activateTrig: nested, and leaves the rest alone",
        %mr_activateTrig(log(%mr_isin(2*x)^3 + y)), log(sin(2*x)^3 + y)),
  check("activateTrig: an already-active expression is unchanged",
        %mr_activateTrig(sin(x) + log(y)), sin(x) + log(y)),
  check_bool("inertTrigQ: an inert head", %mr_inertTrigQ(%mr_isin)),
  check_not("inertTrigQ: an active head", %mr_inertTrigQ(sin)),
  check_not("inertTrigQ: not a trig head at all", %mr_inertTrigQ(log)),
  check_bool("inertTrigFreeQ: no inert head present",
             %mr_inertTrigFreeQ(sin(x) + log(y))),
  check_not("inertTrigFreeQ: an inert head is present",
            %mr_inertTrigFreeQ(log(%mr_isin(x)))),
  check_bool("trigQ: an active trig head", %mr_trigQ(sin)),
  check_not("trigQ: an inert head is not an active one", %mr_trigQ(%mr_isin)),
  true
)$

/* Task 6: DeactivateTrig (IntegrationUtilityFunctions.m L6189-6226).
 * The six hyperbolic identities individually -- these are the class-6 unlock
 * and each is worth its own target:
 *   Sinh -> -I sin[I z]   Cosh ->   cos[I z]   Tanh -> -I tan[I z]
 *   Coth ->  I cot[I z]   Sech ->   sec[I z]   Csch ->  I csc[I z]
 * Each expected value is derived by hand from the .m Switch at L6210-6218,
 * with the argument routed through ExpandToSum and ReduceInertTrig exactly
 * as the .m does. For u[[1]] = x (a bare linear argument with no Pi term),
 * ExpandToSum[I*x,x] gives back I*x unexpanded, and ReduceInertTrig's only
 * firing clause for an argument with no Pi term is the plain identity
 * func[u] -- MEASURED directly this task (build
 * branch_5_50_base_84_g4204fb669): %mr_reduceInertTrig(%mr_isin, %i*x) =
 * %mr_isin(%i*x), and likewise for the other five heads. So each identity
 * below is the Switch's sign/I-factor applied to inert-head(%i*x), which is
 * literally what the brief's Step 1 targets already state. */
test_deactivate_trig() := block([],
  print("--- DeactivateTrig ---"),
  check("deactivate: Sinh", %mr_deactivateTrigAux(sinh(x), x),
        -%i*%mr_isin(%i*x)),
  check("deactivate: Cosh", %mr_deactivateTrigAux(cosh(x), x),
        %mr_icos(%i*x)),
  check("deactivate: Tanh", %mr_deactivateTrigAux(tanh(x), x),
        -%i*%mr_itan(%i*x)),
  check("deactivate: Coth", %mr_deactivateTrigAux(coth(x), x),
        %i*%mr_icot(%i*x)),
  check("deactivate: Sech", %mr_deactivateTrigAux(sech(x), x),
        %mr_isec(%i*x)),
  check("deactivate: Csch", %mr_deactivateTrigAux(csch(x), x),
        %i*%mr_icsc(%i*x)),
  /* The trig branch: head for head, argument untouched (same identity
   * clause, same measurement). */
  check("deactivate: Sin", %mr_deactivateTrigAux(sin(x), x), %mr_isin(x)),
  check("deactivate: Cos", %mr_deactivateTrigAux(cos(x), x), %mr_icos(x)),
  /* Non-linear argument: the LinearQ guard leaves the head ACTIVE, and the
   * fall-through map branch recurses into x^2, which is itself neither
   * atom-free nor trig/hyperbolic-headed at the top and so is rebuilt
   * unchanged via the same map/apply walk. */
  check("deactivate: a non-linear argument is left active",
        %mr_deactivateTrigAux(sin(x^2), x), sin(x^2)),
  /* Structural: it maps over a compound expression, keeping the head. */
  check("deactivate: maps over a product",
        %mr_deactivateTrigAux(sin(x)*cos(x), x), %mr_isin(x)*%mr_icos(x)),
  /* The round trip both ways -- the invariant of design 3.1. */
  check("round trip: trig",
        %mr_activateTrig(%mr_deactivateTrig(sin(x)^2, x)), sin(x)^2),
  /* The hyperbolic round trip: ratsimp cannot close a hyperbolic identity
   * (AGENTS.md class-6 trap), but core trigrat can -- MEASURED this task:
   * trigrat(-%i*sin(%i*x) - sinh(x)) reduces to exactly 0. That is a
   * stronger, symbolic close (resolution 2), used instead of the brief's
   * numeric-at-a-point check. */
  check_bool("round trip: hyperbolic closes symbolically via trigrat",
    is(trigrat(%mr_activateTrig(%mr_deactivateTrig(sinh(x), x)) - sinh(x))
       = 0)),
  true
)$

/* Task 7: FunctionOfTrigOfLinearQ and FunctionOfTrig
 * (IntegrationUtilityFunctions.m L4357-4392) -- the bridge rule's
 * condition and the substitution records' locator. The bridge rule is a
 * bare u_ at the END of section 4's table (Int[u_,x_Symbol] :=
 * Int[DeactivateTrig[u,x],x] /; FunctionOfTrigOfLinearQ[u,x]), so a wrong
 * TRUE is a deactivation loop or a swallowed integrand, not a wrong
 * answer -- the negative targets matter most.
 *
 * AMENDED 2026-09-21: a trig head MIXED with a hyperbolic head is FALSE
 * in Rubi. FunctionOfTrig carries a HYPERBOLIC argument as I*u[[1]]
 * (utils 4381-4385) and a TRIG argument bare (utils 4374-4379), so
 * merging one against the other gives b/d = 1/I = -I, and the merge
 * clause requires RationalQ[b/d]. A trig head and a hyperbolic head in
 * the same integrand are therefore NEVER both admitted -- which is the
 * whole reason DeactivateTrig exists: it moves the hyperbolic side onto
 * the inert TRIG heads FIRST, so by the time the rules match, nothing is
 * mixed. */
test_function_of_trig_of_linear() := block([],
  print("--- FunctionOfTrigOfLinearQ / FunctionOfTrig ---"),
  check_bool("fotlq: trig of a linear argument",
             %mr_functionOfTrigOfLinearQ(sin(2*x+1), x)),
  check_bool("fotlq: hyperbolic of a linear argument",
             %mr_functionOfTrigOfLinearQ(sinh(2*x+1), x)),
  check_bool("fotlq: a product of trig",
             %mr_functionOfTrigOfLinearQ(sin(x)^4*(1+sin(x)^2), x)),
  check_bool("fotlq: a product of hyperbolic",
             %mr_functionOfTrigOfLinearQ(sinh(x)^4*(1+sinh(x)^2), x)),
  check_not("fotlq: trig MIXED with hyperbolic",
            %mr_functionOfTrigOfLinearQ(sin(x)^4*(1+sinh(x)^2), x)),
  check_not("fotlq: no trig at all",
            %mr_functionOfTrigOfLinearQ((1+x)^3, x)),
  check_not("fotlq: trig of a NON-linear argument",
            %mr_functionOfTrigOfLinearQ(sin(x^2), x)),
  check_not("fotlq: two different linear arguments",
            /* Rubi requires ONE linear argument throughout */
            %mr_functionOfTrigOfLinearQ(sin(x)*cos(2*x+1), x)),
  check_not("fotlq: an inert expression is not deactivated twice",
            %mr_functionOfTrigOfLinearQ(%mr_isin(x), x)),
  check("fot: returns the linear argument",
        %mr_functionOfTrig(sin(2*x+1), x), 2*x+1),
  check("fot: false when there is none",
        %mr_functionOfTrig((1+x)^3, x), false),
  true
)$

/* FunctionOfQ (circular-trig branches) and SubstFor's trig branch (inert-
 * trig substrate plan, Task 9): the utilities the bridge's 4.7.5
 * substitution records call (maxima_rubi_utils.mac, which states the three
 * deviations). The cos pair below is the 6.1.7 acceptance chain's own
 * step: after deactivation 4.7.5 r48 asks whether u/Sin[v] is a function
 * of Cos[v], and substitutes Cos[v] -> x. */
test_function_of_q() := block([],
  print("--- FunctionOfQ / SubstFor (trig) ---"),
  check_bool("foq: an even sin power is a function of cos",
             %mr_functionOfQ(cos(x), a - b*sin(x)^2, x)),
  check_not("foq: an odd sin power is not a function of cos",
            %mr_functionOfQ(cos(x), sin(x)*(a - b*sin(x)^2), x)),
  check_not("foq: a 1/cos factor is not a function of sin",
            %mr_functionOfQ(sin(x), sin(x)*(a - b*sin(x)^2)/cos(x), x)),
  check_bool("foq: an inert u is activated first",
             %mr_functionOfQ(cos(x), a - b*%mr_isin(x)^2, x)),
  check_bool("foq: a free factor of v is dropped",
             %mr_functionOfQ(2*cos(x), sin(x)^2, x)),
  check_not("foq: u free of x", %mr_functionOfQ(cos(x), a, x)),
  check_bool("foq: tan (not pure) accepts sec^2",
             %mr_functionOfQ(tan(x), sec(x)^2, x)),
  check_bool("foq: pure tan accepts a polynomial in tan",
             %mr_functionOfQ(tan(x), 1 + tan(x)^2, x, true)),
  check_not("foq: pure tan rejects sec^2",
            %mr_functionOfQ(tan(x), sec(x)^2, x, true)),
  check_not("foq: a hyperbolic v declines (deviation (a), not ported)",
            %mr_functionOfQ(cosh(x), sinh(x)^2, x)),
  /* SubstFor[v,u,x]: x is BOTH the integration variable v is a function
     of and the symbol v is replaced by (Rubi's own convention). */
  check("sft: cos(x) -> x takes sin^2 to 1-x^2",
        ratsimp(%mr_substFor(cos(x), a - b*sin(x)^2, x) - (a - b*(1 - x^2))), 0),
  check("sft: an inert u is activated first",
        ratsimp(%mr_substFor(cos(x), a - b*%mr_isin(x)^2, x) - (a - b*(1 - x^2))), 0),
  check("sft: a multiple angle is expanded first",
        ratsimp(%mr_substFor(sin(x), cos(2*x), x) - (1 - 2*x^2)), 0),
  check("sft: a free factor of v scales the variable",
        ratsimp(%mr_substFor(2*sin(x), sin(x)^2, x) - x^2/4), 0),
  check("sft: tan(x) -> x takes sin^2/cos^2 to x^2",
        ratsimp(%mr_substFor(tan(x), sin(x)^2/cos(x)^2, x) - x^2), 0),
  true
)$

/* The inert-trig bridge, end to end (inert-trig substrate design 3.5, 5.2).
 * A 6.1.7 integrand: a power of one hyperbolic times a binomial in another.
 * Rubi has NO section-6 rule for this shape -- it answers it through section
 * 4's rules via the inert bridge, and before this plan the package reached no
 * rule at all for the whole 1,173-entry family (1,166 deferred, zero PASS).
 *
 * Corpus entry, 6.1 Hyperbolic sine/6.1.7 hyper^m (a+b sinh^n)^p.mac:
 *   [sinh(c+d*x)*(a+b*sinh(c+d*x)^2), x, 2,
 *    (a-b)*cosh(c+d*x)/d + 1/3*b*cosh(c+d*x)^3/d]
 * Verified by DIFFERENTIATION, not by comparing to the expected text: the
 * package's form may differ and still be right. The zero test is
 * ratsimp(exponentialize(.)) -- plain ratsimp cannot close a hyperbolic
 * identity (the class-6 lesson); it closes this residual to 0 symbolically
 * (core trigrat does too, measured). The answer must also carry no noun
 * (unintegrable, mr_int) and no inert %mr_i* head.
 *
 * The chain (traced with rubi_verbose on the full mr_load_all table, and the
 * same here): 4.1.0.1 r1 (the bridge: FunctionOfTrigOfLinearQ, then
 * Int[DeactivateTrig[u,x],x]) -> 9.1 r11 (Int[Complex[0,a] u] ->
 * Complex[0,a] Int[u], a = -1: the -%i the sinh identity brings) ->
 * 4.7.5 r48 (Cos derivative-divides: u/Sin[v] is a function of Cos[v],
 * v = %i d x + %i c; Subst[Int[a - b (1-x^2), x], x, Cos[v]]) -> 1.4.1 r7
 * (the polynomial sum, term by term) -> back-substitution and Dist by
 * -1/(%i d).
 *
 * What it loads, and why: Layer A never calls mr_load_all() (later targets
 * depend on the table's contents at their point), so the target builds the
 * table the chain consults itself, and restores the old one: the rewrite
 * tables DeactivateTrig walks; 1.4.1 and 9.1, the two class-1 files the
 * chain's algebraic steps fire from; and the two class-4 files. The order
 * is the real table's -- every body list first, the class-4 _tail lists
 * LAST -- so the bridge is only tried after every body rule has declined.
 * The loads are under errcatch: a missing file is a counted FAIL, not a run
 * that dies without its Results line. */
test_inert_bridge() := block([mr_ib_saved, mr_ib_ok, mr_ib_f, mr_ib_r],
  print("--- the inert-trig bridge, end to end (6.1.7) ---"),
  mr_ib_ok : errcatch(
    %mr_load_sibling("rules/utils/inert_trig_rewrites.mac",
                     'mr_witness_inert_trig_rewrites),
    %mr_load_sibling("rules/class1/1_4_1.mac", 'mr_witness_1_4_1),
    %mr_load_sibling("rules/class1/9_1.mac", 'mr_witness_9_1),
    %mr_load_sibling("rules/class4/4_1_0_1.mac", 'mr_witness_4_1_0_1),
    %mr_load_sibling("rules/class4/4_7_5.mac", 'mr_witness_4_7_5),
    true),
  mr_ib_f : sinh(c + d*x)*(a + b*sinh(c + d*x)^2),
  mr_ib_saved : mr_rule_table,
  mr_ib_r : false,
  if mr_ib_ok # [] then (
    mr_rule_table : flatten([mr_rule_table, mr_rules_1_4_1, mr_rules_9_1,
                             mr_rules_4_1_0_1, mr_rules_4_7_5,
                             mr_rules_4_1_0_1_tail, mr_rules_4_7_5_tail]),
    mr_ib_r : rubi(mr_ib_f, x)),
  mr_rule_table : mr_ib_saved,
  check_bool("6.1.7: the bridge answers a hyperbolic .7 integrand",
    is(mr_ib_r # false)
    and freeof('unintegrable, 'mr_int, mr_ib_r)
    and %mr_inertTrigFreeQ(mr_ib_r)
    and is(ratsimp(exponentialize(diff(mr_ib_r, x) - mr_ib_f)) = 0)),
  true
)$

/* Task 10 (inert-trig substrate): TryPureTanSubst, CalculusFreeQ and the
 * 4-argument SubstFor's SimplifyIntegrand -- the utilities 4.7.5 r21/r22
 * (TryPureTanSubst, live from this port on) and r71 (the Weierstrass
 * record: CalculusFreeQ on its trial integral, SubstFor[w,v,u,x]'s
 * SimplifyIntegrand) call. */
test_try_pure_tan_subst() := block([],
  print("--- TryPureTanSubst / CalculusFreeQ / SubstFor[w,v,u,x] ---"),
  /* TryPureTanSubst is Not[MatchQ[u, F_[c_.*(a_.+b_.*G_[v_])] /; ...]] */
  check_not("tpt: ArcTan[a+b Tan[linear]] matches, so false",
            %mr_tryPureTanSubst(atan(a + b*tan(c + d*x)), x)),
  check_not("tpt: ArcCot[c (a - b Cot[2x])] matches (c_. absorbs k)",
            %mr_tryPureTanSubst(acot(k*(a - b*cot(2*x))), x)),
  check_not("tpt: ArcTanh[Tanh[x]/2] matches (a = 0, b = 1/2)",
            %mr_tryPureTanSubst(atanh(tanh(x)/2), x)),
  check_bool("tpt: a factor outside the ArcTan is no match",
             %mr_tryPureTanSubst(3*atan(a + b*tan(c + d*x)), x)),
  check_bool("tpt: a nonlinear v is no match",
             %mr_tryPureTanSubst(atan(tan(x^2)), x)),
  check_bool("tpt: an x-dependent a is no match",
             %mr_tryPureTanSubst(atan(x + tan(x)), x)),
  check_bool("tpt: a Sin inside ArcTan is no match",
             %mr_tryPureTanSubst(atan(2*sin(x)), x)),
  check_bool("tpt: 4.7.5 r22 is live: a pure-tan u accepts",
             _mr_cond_4_7_5_r22([_mr_4_7_5_r22_u = %mr_itan(x)^3], x)),
  check_bool("cfq: no calculus head", %mr_calculusFreeQ(a*x + sin(x), x)),
  check_not("cfq: the unintegrable noun in x",
            %mr_calculusFreeQ(1 + 'unintegrable[f(x), x], x)),
  check_bool("cfq: an integrate noun in another variable",
             %mr_calculusFreeQ(1 + 'integrate(f(y), y), x)),
  check_not("cfq: a (partial) diff noun nested under exp",
            %mr_calculusFreeQ(exp('diff(f(x, y), x)), x)),
  /* class 8 (2026-09-25): the formal derivative Derivative[1][f][x] is no
     calculus head */
  check_bool("cfq: a formal derivative under exp is calculus-free",
             %mr_calculusFreeQ(exp('diff(f(x), x)), x)),
  /* SubstFor[w,v,u,x] = SimplifyIntegrand[w SubstFor[v,u,x], x]: the
     half-angle integrand reaches Int normalized (without the
     SimplifyIntegrand it was 1/((x^2+1)*(3+2*(1/(x^2+1)-x^2/(x^2+1))))). */
  check("sf4: the half-angle integrand is simplified",
        %mr_substFor(1/(1 + x^2), tan(x/2), 1/(3 + 2*cos(x)), x), 1/(x^2 + 5)),
  /* ... but a form already simplest is kept: ratsimp would re-expand this
     denominator (6.1.5 e6's r58 integrand, measured 2026-09-21) */
  check("sf4: a factored denominator is not re-expanded",
        %mr_substFor(1/(1 + x^2), tan(x), sin(x)^6, x), x^6/(x^2 + 1)^4),
  true
)$

/* The rule table test_inert_bridge builds (every body list, then the
 * class-4 _tail lists LAST), plus 1.1.2.1 -- the class-1 file whose r10
 * answers the Weierstrass record's rational integrand 1/(x^2+5). The loads
 * are under errcatch: a missing file is a counted FAIL. Returns false when
 * a load failed, else the table. */
mr_t10_bridge_table() := block([mr_t10_ok],
  mr_t10_ok : errcatch(
    %mr_load_sibling("rules/utils/inert_trig_rewrites.mac",
                     'mr_witness_inert_trig_rewrites),
    %mr_load_sibling("rules/class1/1_4_1.mac", 'mr_witness_1_4_1),
    %mr_load_sibling("rules/class1/9_1.mac", 'mr_witness_9_1),
    %mr_load_sibling("rules/class1/1_1_2_1.mac", 'mr_witness_1_1_2_1),
    %mr_load_sibling("rules/class4/4_1_0_1.mac", 'mr_witness_4_1_0_1),
    %mr_load_sibling("rules/class4/4_7_5.mac", 'mr_witness_4_7_5),
    true),
  if mr_t10_ok = [] then false
  else flatten([mr_rule_table, mr_rules_1_4_1, mr_rules_9_1, mr_rules_1_1_2_1,
                mr_rules_4_1_0_1, mr_rules_4_7_5,
                mr_rules_4_1_0_1_tail, mr_rules_4_7_5_tail]))$

/* The Weierstrass record end to end (4.7.5.m L74, r71). 1/(3+2 Cos[x]) is
 * no function of Sin, Cos or Tan alone for the five earlier records (r47/
 * r48 need an odd Sin/Cos factor, r21/r22/r58 a function of Tan), so the
 * chain is 4.1.0.1 r1 (the bridge) -> 4.7.5 r71: its trial Int of
 * SubstFor[1/(1+x^2), Tan[x/2], u, x] = 1/(x^2+5) is calculus-free (1.1.2.1
 * r10 answers it), so Dist[2, Subst[Int[1/(x^2+5)], x, Tan[x/2]]] -- traced
 * with rubi_verbose on the full mr_load_all table. The hyperbolic
 * 1/(3+2 Cosh[c+d x]) takes the same record through the inert argument
 * %i d x + %i c. Zero test: radcan(exponentialize(.)) -- ratsimp leaves the
 * e^(i x) / e^(3 i x) kernels uncombined on these residuals (measured). */
test_weierstrass() := block([mr_t10_saved, mr_t10_tab, mr_t10_f1, mr_t10_r1,
                             mr_t10_f2, mr_t10_r2],
  print("--- the Weierstrass record (4.7.5 r71), end to end ---"),
  mr_t10_saved : mr_rule_table,
  mr_t10_tab : mr_t10_bridge_table(),
  mr_t10_f1 : 1/(3 + 2*cos(x)),
  mr_t10_f2 : 1/(3 + 2*cosh(c + d*x)),
  mr_t10_r1 : false, mr_t10_r2 : false,
  if mr_t10_tab # false then (
    mr_rule_table : mr_t10_tab,
    mr_t10_r1 : rubi(mr_t10_f1, x),
    mr_t10_r2 : rubi(mr_t10_f2, x)),
  mr_rule_table : mr_t10_saved,
  check_bool("r71: 1/(3+2 cos x) answers by the half-angle substitution",
    is(mr_t10_r1 # false)
    and freeof('unintegrable, 'mr_int, mr_t10_r1)
    and %mr_inertTrigFreeQ(mr_t10_r1)
    and is(radcan(exponentialize(diff(mr_t10_r1, x) - mr_t10_f1)) = 0)),
  check_bool("r71: 1/(3+2 cosh(c+d x)) answers through the inert argument",
    is(mr_t10_r2 # false)
    and freeof('unintegrable, 'mr_int, mr_t10_r2)
    and %mr_inertTrigFreeQ(mr_t10_r2)
    and is(radcan(exponentialize(diff(mr_t10_r2, x) - mr_t10_f2)) = 0)),
  true
)$

/* The inert-head leak guard (inert-trig substrate design 3.1 invariant, 3.4).
 * An inert head exists only between the bridge rule and activation. A rule
 * that forgot its %mr_activateTrig would otherwise return junk that
 * differentiates to nothing recognisable and lands in a deferred mass. Run
 * on the bridge table (the default Layer A table has no bridge, so the
 * check would be vacuous there). Both pass on first run -- no rule leaks on
 * these inputs; the driver's own guard (test/test_driver_inert_leak.py) is
 * the one that was red first. */
test_inert_leak_guard() := block([mr_t10_saved, mr_t10_tab, mr_t10_r1, mr_t10_r2],
  print("--- the inert-head leak guard ---"),
  mr_t10_saved : mr_rule_table,
  mr_t10_tab : mr_t10_bridge_table(),
  mr_t10_r1 : 'mr_t10_noload, mr_t10_r2 : 'mr_t10_noload,
  if mr_t10_tab # false then (
    mr_rule_table : mr_t10_tab,
    mr_t10_r1 : rubi(sin(x)^2, x),
    mr_t10_r2 : rubi(sinh(c + d*x)*(a + b*sinh(c + d*x)^2), x)),
  mr_rule_table : mr_t10_saved,
  check_not("no inert head leaks from a trig answer",
            is(mr_t10_r1 = 'mr_t10_noload)
            or is(%mr_inertTrigFreeQ(mr_t10_r1) = false)),
  check_not("no inert head leaks from a hyperbolic answer",
            is(mr_t10_r2 = 'mr_t10_noload)
            or is(%mr_inertTrigFreeQ(mr_t10_r2) = false)),
  true
)$

/* 4.7.5 r72 (4.7.5.m L76, Task 10 fix round 1, ruling R26) -- the file's
 * last record and the tail's last:
 *   Int[u_,x_Symbol] := With[{v=ActivateTrig[u]}, CannotIntegrate[v,x]] /;
 *     Not[InertTrigFreeQ[u]]
 * An integrand the bridge (4.1.0.1 r1) deactivates and no later record
 * finishes is given up RE-ACTIVATED. Before r72 the port answered
 * unintegrable(<the INERT integrand>), which the driver's leak guard reads
 * as error (2,604 class-6 entries at Task 10, 114 of them no-answer ->
 * error). The integrands are real class-6 entries whose corpus answer is
 * Unintegrable(<integrand>, x): 6.1.1 e26 csch(a+b x)/(c+d x) and 6.2.1 e29
 * sech(a+b x)/(c+d x). Expected from the source: CannotIntegrate[v,x] is the
 * top-level noun (the driver's no-answer), v = ActivateTrig[DeactivateTrig
 * [f]] carries no inert head, and is f in VALUE. The port does not return f
 * in FORM: ActivateTrig restores circular heads of an imaginary argument
 * (csc(%i b x + %i a)), which Mathematica would auto-simplify to Csch and
 * Maxima does not -- so the value check is radcan(exponentialize(.)).
 * The noun test is string(op(.)) = "unintegrable", the driver's own: op()
 * of the subscripted marker is the NOUN %unintegrable, so op(.) =
 * 'unintegrable is false on it. */
test_inert_giveup() := block([mr_t10_saved, mr_t10_tab, mr_t10_f1, mr_t10_r1,
                              mr_t10_f2, mr_t10_r2],
  print("--- the re-activating give-up (4.7.5 r72) ---"),
  mr_t10_saved : mr_rule_table,
  mr_t10_tab : mr_t10_bridge_table(),
  mr_t10_f1 : csch(a + b*x)/(c + d*x),
  mr_t10_f2 : sech(a + b*x)/(c + d*x),
  mr_t10_r1 : 'mr_t10_noload, mr_t10_r2 : 'mr_t10_noload,
  if mr_t10_tab # false then (
    mr_rule_table : mr_t10_tab,
    mr_t10_r1 : rubi(mr_t10_f1, x),
    mr_t10_r2 : rubi(mr_t10_f2, x)),
  mr_rule_table : mr_t10_saved,
  check_bool("r72: csch(a+b x)/(c+d x) gives up as a top-level unintegrable noun in x",
    not(atom(mr_t10_r1)) and is(string(op(mr_t10_r1)) = "unintegrable")
    and is(length(args(mr_t10_r1)) = 2) and is(second(args(mr_t10_r1)) = x)),
  check_bool("r72: the given-up integrand carries no inert head (re-activated)",
    not(atom(mr_t10_r1)) and %mr_inertTrigFreeQ(mr_t10_r1)
    and freeof('%mr_isin, '%mr_icos, '%mr_itan, '%mr_icot, '%mr_isec,
               '%mr_icsc, mr_t10_r1)),
  check_bool("r72: the given-up integrand is the input in value",
    not(atom(mr_t10_r1)) and is(string(op(mr_t10_r1)) = "unintegrable")
    and is(radcan(exponentialize(first(args(mr_t10_r1)) - mr_t10_f1)) = 0)),
  check_bool("r72: sech(a+b x)/(c+d x) gives up re-activated, in value",
    not(atom(mr_t10_r2)) and is(string(op(mr_t10_r2)) = "unintegrable")
    and %mr_inertTrigFreeQ(mr_t10_r2)
    and is(second(args(mr_t10_r2)) = x)
    and is(radcan(exponentialize(first(args(mr_t10_r2)) - mr_t10_f2)) = 0)),
  true
)$

/* The class-4 With-local capture trap (final fix wave I2, ruling R28).
 * The 4.7.5 repls bind their With/Module locals in a Maxima block and
 * run a nested mr_int INSIDE it. Maxima binds block locals dynamically,
 * so a local named like a corpus symbol (d, v, w) leaks into every
 * re-evaluation the nested integration does: mr_sum's
 * ev(subst(i, var, ev(fun))) (maxima_rubi_utils.mac, the Sum handler)
 * re-evaluates the summand, and with 4.7.5 r47's block([d], d : 1)
 * live the d of 1/(d x^7 + 1) became 1 in part of the answer. Measured
 * before the fix (final-review probes capture3/capture4): cos(x)/(d
 * sin(x)^7 + 1) answered with residual 1.08e-3 at x = 0.37, d = 0.7,
 * sin(x)/(c + d cos(x)^5) with -0.020; the same integrands with d
 * renamed q gave 0. The fix: the generator prefixes class 4's With/
 * Module locals _mr_<key>_r<n>_ (ticket 08 carries the all-class fix).
 *
 * The table: the bridge table (mr_t10_bridge_table) plus the class-1
 * files the nested 1/(d x^7 + 1) and 1/(c + d x^5) chains fire from
 * (traced with rubi_verbose on the full mr_load_all table: 1.1.3.1 r13,
 * the Sum over the quadratic factors; 1.2.1.2 r3/r9 and 1.2.1.1 r12 the
 * quadratic pieces; 1.1.2.1 r11 and 1.1.1.1 r3 the linear ones).
 *
 * The zero test is numeric, at two points: the answers carry
 * cos(k %pi/7) / cos(k %pi/5) constants, and ratsimp/radcan leave the
 * residual as an unreduced polynomial in them (measured; see the fix
 * wave report). |residual| < 1e-12 at two points is far below the
 * 1e-3 / 2e-2 the trap produced. The renaming check is the trap's own
 * signature: d -> q -> d must give back the SAME answer. */
mr_i2_resid(f, r, pts) := block([mr_i2_z],
  mr_i2_z : errcatch(float(abs(rectform(
              subst(pts, diff(r, x) - f))))),
  if mr_i2_z = [] then 1.0 else first(mr_i2_z))$
test_class4_with_capture() := block([mr_i2_saved, mr_i2_tab, mr_i2_ok,
                                     mr_i2_f1, mr_i2_r1, mr_i2_q1,
                                     mr_i2_f2, mr_i2_r2, mr_i2_q2],
  print("--- the class-4 With-local capture trap (I2) ---"),
  mr_i2_saved : mr_rule_table,
  mr_i2_tab : mr_t10_bridge_table(),
  mr_i2_ok : errcatch(
    %mr_load_sibling("rules/class1/1_1_1_1.mac", 'mr_witness_1_1_1_1),
    %mr_load_sibling("rules/class1/1_1_3_1.mac", 'mr_witness_1_1_3_1),
    %mr_load_sibling("rules/class1/1_2_1_1.mac", 'mr_witness_1_2_1_1),
    %mr_load_sibling("rules/class1/1_2_1_2.mac", 'mr_witness_1_2_1_2),
    true),
  mr_i2_f1 : cos(x)/(d*sin(x)^7 + 1),
  mr_i2_f2 : sin(x)/(c + d*cos(x)^5),
  mr_i2_r1 : false, mr_i2_q1 : false, mr_i2_r2 : false, mr_i2_q2 : false,
  if mr_i2_tab # false and mr_i2_ok # [] then (
    mr_rule_table : append(
      [mr_rules_1_1_1_1, mr_rules_1_1_3_1, mr_rules_1_2_1_1, mr_rules_1_2_1_2],
      mr_i2_tab),
    mr_rule_table : flatten(mr_rule_table),
    mr_i2_r1 : rubi(mr_i2_f1, x),
    mr_i2_q1 : subst(q = d, rubi(subst(d = q, mr_i2_f1), x)),
    mr_i2_r2 : rubi(mr_i2_f2, x),
    mr_i2_q2 : subst(q = d, rubi(subst(d = q, mr_i2_f2), x))),
  mr_rule_table : mr_i2_saved,
  check_bool("I2: cos(x)/(d sin(x)^7+1) answers and verifies (|resid| < 1e-12 at two points)",
    is(mr_i2_r1 # false)
    and freeof('unintegrable, 'mr_int, mr_i2_r1)
    and %mr_inertTrigFreeQ(mr_i2_r1)
    and is(mr_i2_resid(mr_i2_f1, mr_i2_r1, [x = 0.37, d = 0.7]) < 1.0e-12)
    and is(mr_i2_resid(mr_i2_f1, mr_i2_r1, [x = 1.1, d = 1.9]) < 1.0e-12)),
  check_bool("I2: cos(x)/(d sin(x)^7+1) is the same answer with d renamed q",
    is(mr_i2_r1 # false) and is(mr_i2_r1 = mr_i2_q1)),
  check_bool("I2: sin(x)/(c+d cos(x)^5) answers and verifies (|resid| < 1e-12 at two points)",
    is(mr_i2_r2 # false)
    and freeof('unintegrable, 'mr_int, mr_i2_r2)
    and %mr_inertTrigFreeQ(mr_i2_r2)
    and is(mr_i2_resid(mr_i2_f2, mr_i2_r2, [x = 0.37, c = 1.3, d = 0.7]) < 1.0e-12)
    and is(mr_i2_resid(mr_i2_f2, mr_i2_r2, [x = 1.1, c = 2.2, d = 1.9]) < 1.0e-12)),
  check_bool("I2: sin(x)/(c+d cos(x)^5) is the same answer with d renamed q",
    is(mr_i2_r2 # false) and is(mr_i2_r2 = mr_i2_q2)),
  true
)$

/* mr_sum's own capture trap (ticket 08, section D). mr_sum was
 * block([a, b, i, s, t], ...) and re-evaluates its summand with ev
 * while those locals are live, so an integrand symbol named a, b, i, s
 * or t read mr_sum's bounds / running sum instead of itself; a lambda
 * summand naming an enclosing With local s read the running sum.
 * Measured before the fix (probes/maxima/probe-class4-with-capture,
 * section D): rubi(1/(a+b*x^5), x) answered with residual 0.035. */
test_mr_sum_capture() := block([mr_sc_saved, mr_sc_ok, mr_sc_f, mr_sc_r,
                                mr_sc_q, mr_sc_u],
  print("--- mr_sum's own capture trap (ticket 08 D) ---"),
  check("mr_sum: expression summand keeps a, b, s, t, i",
    mr_sum(a + b + s + t + i*k, k, 1, 2), 2*a + 2*b + 2*s + 2*t + 3*i),
  mr_sc_u : a*k,
  check("mr_sum: identifier summand keeps a",
    mr_sum('mr_sc_u, k, 1, 2), 3*a),
  check("mr_sum: a lambda body reads the enclosing s, not the running sum",
    block([s], s : 10, mr_sum(lambda([k], s*k), k, 1, 2)), 30),
  mr_sc_saved : mr_rule_table,
  mr_sc_ok : errcatch(
    %mr_load_sibling("rules/class1/1_1_1_1.mac", 'mr_witness_1_1_1_1),
    %mr_load_sibling("rules/class1/1_1_3_1.mac", 'mr_witness_1_1_3_1),
    %mr_load_sibling("rules/class1/1_2_1_1.mac", 'mr_witness_1_2_1_1),
    %mr_load_sibling("rules/class1/1_2_1_2.mac", 'mr_witness_1_2_1_2),
    true),
  mr_sc_f : 1/(a + b*x^5),
  mr_sc_r : false, mr_sc_q : false,
  if mr_sc_ok # [] then (
    mr_rule_table : flatten([mr_rules_1_1_1_1, mr_rules_1_1_3_1,
                             mr_rules_1_2_1_1, mr_rules_1_2_1_2]),
    mr_sc_r : rubi(mr_sc_f, x),
    mr_sc_q : subst([p = a, q = b], rubi(subst([a = p, b = q], mr_sc_f), x))),
  mr_rule_table : mr_sc_saved,
  check_bool("mr_sum: 1/(a+b x^5) answers and verifies (|resid| < 1e-12 at two points)",
    is(mr_sc_r # false)
    and freeof('unintegrable, 'mr_int, mr_sc_r)
    and is(mr_i2_resid(mr_sc_f, mr_sc_r, [x = 0.37, a = 1.3, b = 0.7]) < 1.0e-12)
    and is(mr_i2_resid(mr_sc_f, mr_sc_r, [x = 1.1, a = 2.2, b = 1.9]) < 1.0e-12)),
  check_bool("mr_sum: 1/(a+b x^5) is the same answer with a, b renamed p, q",
    is(mr_sc_r # false) and is(mr_sc_r = mr_sc_q)),
  true
)$

/* Section 9 (spec 2026-09-22 A2.3): Rubi's UnsameQ (=!=), a SYNTACTIC
   test -- 9.3's NormalizeIntegrand record, v=!=u. */
test_section9_unsameQ() := block([],
  print("--- section 9: UnsameQ ---"),
  check_bool("unsameQ: different expressions", %mr_unsameQ(x + 1, x + 2)),
  check_not("unsameQ: identical after simplification", %mr_unsameQ(x + 1, 1 + x)),
  true)$

/* Section 9, G1 (spec 2026-09-22 A1): PiecewiseLinearQ (Rubi :7430-7440)
   and Divides (:7443). atan(tan(x)) and friends are NOT auto-simplified
   in this build (probes/rubi/06), which is why 9.2 exists at all. */
test_section9_g1() := block([],
  print("--- section 9 G1: PiecewiseLinearQ / Divides ---"),
  check_bool("plq: a linear function", %mr_piecewiseLinearQ(2*x + 3, x)),
  check_not("plq: a quadratic", %mr_piecewiseLinearQ(x^2, x)),
  check_bool("plq: log(c F^v), c = 2, F = e", %mr_piecewiseLinearQ(log(2*%e^x), x)),
  check_bool("plq: log(c F^v), F = 2, v linear", %mr_piecewiseLinearQ(log(3*2^(2*x + 1)), x)),
  check_not("plq: log(c F^v) with v not linear", %mr_piecewiseLinearQ(log(3*2^(x^2)), x)),
  check_not("plq: log(c F^v) with c not free", %mr_piecewiseLinearQ(log(x*%e^x), x)),
  check_bool("plq: atan(tan(linear))", %mr_piecewiseLinearQ(atan(tan(2*x + 1)), x)),
  check_bool("plq: acot(tan(x)), a listed pair", %mr_piecewiseLinearQ(acot(tan(x)), x)),
  check_not("plq: atan(sin(x)), not a listed pair", %mr_piecewiseLinearQ(atan(sin(x)), x)),
  check_not("plq: atan(tan(x^2)), argument not linear", %mr_piecewiseLinearQ(atan(tan(x^2)), x)),
  check_bool("plq 3-arg: both piecewise linear",
             %mr_piecewiseLinearQ(atan(tan(x)), 2*x + 1, x)),
  check_not("plq 3-arg: the second is not",
            %mr_piecewiseLinearQ(atan(tan(x)), x^2, x)),
  check("divides: (x+1)/(2x+2) is free of x", %mr_divides(2*x + 2, x + 1, x), 1/2),
  check("divides: x^2/x is not free of x", %mr_divides(x, x^2, x), false),
  check("divides: 3x/(a x)", %mr_divides(a*x, 3*x, x), 3/a),
  true)$

/* Section 9, G2a (spec 2026-09-22 A1). EulerIntegrandQ (Rubi :5017-5039)
   is five Name[pattern] := True/False /; cond clauses, generated into
   rules/utils/inert_trig_rewrites.mac as mr_rw_eiq (the inert-trig
   rewrite machinery, design 3.2). SimplerIntegrandQ :804,
   CancelCommonFactors :821. */
test_section9_g2a() := block([],
  print("--- section 9 G2a: EulerIntegrandQ / SimplerIntegrandQ ---"),
  errcatch(%mr_load_sibling("rules/utils/inert_trig_rewrites.mac",
                            'mr_witness_inert_trig_rewrites)),
  check_bool("eiq: (x+sqrt(Q))^-1, Q quadratic not binomial",
             %mr_eulerIntegrandQ(1/(x + sqrt(x^2 + 2*x + 3)), x)),
  check_not("eiq: (x+sqrt(x^2+1))^-1, Q binomial and p rational",
            %mr_eulerIntegrandQ(1/(x + sqrt(x^2 + 1)), x)),
  check_bool("eiq: (x+sqrt(x^2+1))^q, p not rational",
             %mr_eulerIntegrandQ((x + sqrt(x^2 + 1))^q, x)),
  check_bool("eiq: sqrt(Q)*(x+sqrt(Q))^-2, clause 2",
             %mr_eulerIntegrandQ(sqrt(x^2 + 2*x + 3)/(x + sqrt(x^2 + 2*x + 3))^2, x)),
  check_bool("eiq: sqrt(x^2+1)/(x^2+x+1), clause 4",
             %mr_eulerIntegrandQ(sqrt(x^2 + 1)/(x^2 + x + 1), x)),
  check_not("eiq: x^2, the catch-all False", %mr_eulerIntegrandQ(x^2, x)),
  check("ccf: a common factor x cancels",
        %mr_cancelCommonFactors(2*x*sin(x), x*cos(x)), [2*sin(x), cos(x)]),
  check("ccf: a negative numeric coefficient survives the cancellation",
        %mr_cancelCommonFactors(-2*x*sin(x), x*cos(x)), [-2*sin(x), cos(x)]),
  check("ccf: u is a factor of v", %mr_cancelCommonFactors(x, x*cos(x)), [1, cos(x)]),
  check("ccf: v is a factor of u", %mr_cancelCommonFactors(x*sin(x), x), [sin(x), 1]),
  check("ccf: nothing in common", %mr_cancelCommonFactors(sin(x), cos(x)), [sin(x), cos(x)]),
  check_bool("sic: x is simpler than a large product",
             %mr_simplerIntegrandQ(x, (x^5 + x^4 + x^3 + x^2 + x + 1)^3*sin(x), x)),
  check_not("sic: the large product is not simpler than x",
            %mr_simplerIntegrandQ((x^5 + x^4 + x^3 + x^2 + x + 1)^3*sin(x), x, x)),
  check_bool("sic: rational functions compare by exponent sums (2 < 4)",
             %mr_simplerIntegrandQ(1/(x^2 + 1), x/(x^3 + 1), x)),
  true)$

/* Section 9, G2b (spec 2026-09-22 A1): SubstForFractionalPowerQ (Rubi
   :1815, AuxQ :1822), PolynomialInQ (:3223, AuxQ :3227), PolynomialInSubst
   (:3275, Aux :3280). */
test_section9_g2b() := block([],
  print("--- section 9 G2b: SubstForFractionalPowerQ / PolynomialIn ---"),
  check_bool("sffpq: the only fractional power has base v",
             %mr_substForFractionalPowerQ(x*sqrt(2 + 3*x), 2 + 3*x, x)),
  check_not("sffpq: a fractional power of another base",
            %mr_substForFractionalPowerQ(x*sqrt(1 + x^2), 2 + 3*x, x)),
  check_bool("sffpq: no fractional power at all",
             %mr_substForFractionalPowerQ(x^2 + 1, 2 + 3*x, x)),
  check_bool("piq: a polynomial in log(x)",
             %mr_polynomialInQ(log(x)^2 + 3*log(x) + 1, log(x), x)),
  check_not("piq: a bare x is not", %mr_polynomialInQ(x*log(x), log(x), x)),
  check_bool("piq: a polynomial in x^2 through 1+2x^2",
             %mr_polynomialInQ(x^4 + x^2, 1 + 2*x^2, x)),
  check_not("piq: x^3 is not a power of x^2",
            %mr_polynomialInQ(x^3 + x^2, x^2 + 1, x)),
  check("pis: x^4+x^2 in t = 1+2x^2",
        ratsimp(%mr_polynomialInSubst(x^4 + x^2, 1 + 2*x^2, x)
                - (((x - 1)/2)^2 + (x - 1)/2)), 0),
  check("pis: a polynomial in log(x)",
        ratsimp(%mr_polynomialInSubst(log(x)^2 + 3*log(x), log(x), x) - (x^2 + 3*x)), 0),
  true)$

/* Section 9, G3 (spec 2026-09-22 A1): PowerVariableExpn (Rubi :4976),
   PowerVariableDegree (:4985), PowerVariableSubst (:5001). (2*x)^4
   auto-simplifies to 16*x^4 in this build (measured), so c = 1 throughout. */
test_section9_g3() := block([],
  print("--- section 9 G3: PowerVariableExpn ---"),
  check("pvd: m = 0 takes the first power's degree",
        %mr_powerVariableDegree(sin(x^4), 0, 1, x), [4, 1]),
  check("pve: sin(x^4), m = 2 -> x sin(x^2)",
        %mr_powerVariableExpn(sin(x^4), 2, x), [x*sin(x^2), 2, 1]),
  check("pve: two powers with a common gcd",
        %mr_powerVariableExpn(sin(x^4)*cos(x^6), 2, x), [x*sin(x^2)*cos(x^3), 2, 1]),
  check("pve: gcd(2,3) = 1 declines", %mr_powerVariableExpn(sin(x^3), 2, x), false),
  check("pve: m not an integer declines", %mr_powerVariableExpn(sin(x^4), 1/2, x), false),
  true)$

/* Section 9, G4 (spec 2026-09-22 A1): FunctionOfSquareRootOfQuadratic
   (Rubi :5071, its 3-arg overload :5102), SquareRootOfQuadraticSubst
   (:5119). The expected values are hand-derived from the upstream
   definition (plan Task 6). */
test_section9_g4() := block([r],
  print("--- section 9 G4: FunctionOfSquareRootOfQuadratic ---"),
  check("fosq: x^m (a+b x^n)^p is excluded",
        %mr_functionOfSquareRootOfQuadratic(x^2*sqrt(x^2 + 1), x), false),
  check("fosq: two different quadratics under roots",
        %mr_functionOfSquareRootOfQuadratic(sqrt(x^2 + x + 1)*sqrt(x^2 + 2), x), false),
  check("fosq: a zero discriminant declines",
        %mr_functionOfSquareRootOfQuadratic(1/sqrt(x^2 + 2*x + 1), x), false),
  /* c > 0 branch: a = b = c = 1, sqrt = 1, q = 1+x+x^2, r = 1+2x */
  r : %mr_functionOfSquareRootOfQuadratic(1/(x*sqrt(x^2 + x + 1)), x),
  check("fosq c>0: the substituted integrand", ratsimp(first(r) - 1/(x^2 - 1)), 0),
  check("fosq c>0: the substitution", second(r), x + sqrt(x^2 + x + 1)),
  check("fosq c>0: the branch tag", third(r), 2),
  /* a > 0 branch: a = 1, b = 1, c = -1, sqrt = 1, r = -1-x^2 */
  r : %mr_functionOfSquareRootOfQuadratic(1/(x*sqrt(1 + x - x^2)), x),
  check("fosq a>0: the substituted integrand", ratsimp(first(r) - 1/(2*x - 1)), 0),
  check("fosq a>0: the substitution",
        ratsimp(second(r) - (sqrt(-x^2 + x + 1) - 1)/x), 0),
  check("fosq a>0: the branch tag", third(r), 1),
  /* else branch (neither PosQ(c) nor PosQ(a)): a=-1, b=3, c=-1,
     discriminant = b^2-4ac = 5, sqrt = sqrt(5), r = c-x^2 = -1-x^2.
     Hand-derived from Rubi :5071 (fix round 1, task-6 review finding 1):
     SquareRootOfQuadraticSubst[u,-sqrt*x/r,-(b*c+c*sqrt+(-b+sqrt)*x^2)/(2*c*r),x]
     splits u = x^(-1)*tmp^(-1/2) into xx^(-1)*vv^(-1) as in the other two
     branches; xx*vv = sqrt(5)*x*(3+sqrt(5)+(3-sqrt(5))*x^2)/(2*(1+x^2)^2),
     so -sqrt*(1/(xx*vv))*x/r^2 collapses to -2/(3+sqrt(5)+(3-sqrt(5))*x^2). */
  r : %mr_functionOfSquareRootOfQuadratic(1/(x*sqrt(-1 + 3*x - x^2)), x),
  check("fosq else: the substituted integrand",
        ratsimp(first(r) - (-2/(3 + sqrt(5) + (3 - sqrt(5))*x^2))), 0),
  check("fosq else: the substitution",
        ratsimp(second(r) - 2*sqrt(-x^2 + 3*x - 1)/(2*x + sqrt(5) - 3)), 0),
  check("fosq else: the branch tag", third(r), 3),
  true)$

/* Section 9, G5 (spec 2026-09-22 A1): SubstForFractionalPowerOfQuotient-
   OfLinears (Rubi :1801), FractionalPowerOfQuotientOfLinears (:1831).
   Single powers only: Maxima splits a PRODUCT of two powers of one
   quotient into separate numerator and denominator powers (measured). */
test_section9_g5() := block([r],
  print("--- section 9 G5: SubstForFractionalPowerOfQuotientOfLinears ---"),
  check("fpql: the square root of a quotient of linears",
        %mr_fractionalPowerOfQuotientOfLinears(x*sqrt((1 + x)/(1 - x)), 1, false, x),
        [2, (x + 1)/(1 - x)]),
  check("fpql: a root of a LINEAR base is not one",
        %mr_fractionalPowerOfQuotientOfLinears(x*sqrt(1 + x), 1, false, x), [1, false]),
  r : %mr_substForFractionalPowerOfQuotientOfLinears(1/(x + sqrt((1 + x)/(1 - x))), x),
  check("sffpoql: the substituted integrand",
        ratsimp(first(r) - x/((x^2 + 1)*(x^3 + x^2 + x - 1))), 0),
  check("sffpoql: n", second(r), 2),
  check("sffpoql: the quotient", ratsimp(third(r) - (1 + x)/(1 - x)), 0),
  check("sffpoql: b c - a d times the free factors", fourth(r), 2),
  check("sffpoql: no quotient of linears declines",
        %mr_substForFractionalPowerOfQuotientOfLinears(x*sqrt(1 + x), x), false),
  true)$

/* Section 9, G6a (spec 2026-09-22 A1): the helpers under FunctionOfLinear.
   LeadFactor :1281, RemainingFactors :1296, LeadBase :1311, LeadDegree
   :1323, MonomialFactor :3112, MinimumDegree :3138, DivideDegreesOfFactors
   :4224, the absurd-number family :1905-1975, Smallest :3092/:3101,
   FactorOrder :3082, MostMainFactorPosition :3076, CommonFactors :3025.
   Maxima's internal factor order (inpart) stands in for Mathematica's
   canonical order; measured 2026-09-22: inpart(3*x^2*y,1) = 3,
   inpart(x^2*y,1) = x^2, orderlessp(b,x) = true. */
test_section9_g6a() := block([],
  print("--- section 9 G6a: factor utilities / CommonFactors ---"),
  check("leadFactor: the numeric factor leads", %mr_leadFactor(3*x^2*y), 3),
  check("remainingFactors: the rest", %mr_remainingFactors(3*x^2*y), x^2*y),
  check("leadBase: x^2 y -> x", %mr_leadBase(x^2*y), x),
  check("leadDegree: x^2 y -> 2", %mr_leadDegree(x^2*y), 2),
  check("leadFactor: 2 %i -> 2 (Re = 0, Im = 2)", %mr_leadFactor(2*%i), 2),
  check("remainingFactors: 2 %i -> %i", %mr_remainingFactors(2*%i), %i),
  check("monomialFactor: x^3 (1+x)", %mr_monomialFactor(x^3*(1 + x), x), [3, x + 1]),
  check("monomialFactor: x^2 + x^3", %mr_monomialFactor(x^2 + x^3, x), [2, x + 1]),
  check("monomialFactor: sin(x)", %mr_monomialFactor(sin(x), x), [0, sin(x)]),
  check("monomialFactor: x^n", %mr_monomialFactor(x^n, x), [n, 1]),
  check("monomialFactor: 2 sqrt(x)", %mr_monomialFactor(2*sqrt(x), x), [1/2, 2]),
  check("minimumDegree: two numbers", %mr_minimumDegree(3, 5), 3),
  check("minimumDegree: a symbol and a number", %mr_minimumDegree(n, 2), 2),
  check("minimumDegree: n+1 vs n", %mr_minimumDegree(n + 1, n), n),
  check("minimumDegree: n vs m, canonical order", %mr_minimumDegree(n, m), m),
  check("divideDegreesOfFactors: x^4 y^2 / 2", %mr_divideDegreesOfFactors(x^4*y^2, 2), x^2*y),
  check("divideDegreesOfFactors: x^3 / 3", %mr_divideDegreesOfFactors(x^3, 3), x),
  check_bool("absurdNumberQ: 2", %mr_absurdNumberQ(2)),
  check_bool("absurdNumberQ: sqrt(2)", %mr_absurdNumberQ(sqrt(2))),
  check_bool("absurdNumberQ: 3 sqrt(2)", %mr_absurdNumberQ(3*sqrt(2))),
  check_not("absurdNumberQ: x", %mr_absurdNumberQ(x)),
  check_not("absurdNumberQ: sqrt(x)", %mr_absurdNumberQ(sqrt(x))),
  check("absurdNumberGCD: 6, 4", %mr_absurdNumberGCD([6, 4]), 2),
  check("absurdNumberGCD: 2 sqrt(2), 4", %mr_absurdNumberGCD([2*sqrt(2), 4]), 2^(3/2)),
  check("smallest: two positives", %mr_smallest(2, 3), 2),
  check("smallest: mixed signs", %mr_smallest(-2, 3), 0),
  check("smallest: two negatives", %mr_smallest(-2, -3), -2),
  check("smallest: a list", %mr_smallestList([3, 5, 2]), 2),
  check("factorOrder: 1, 1", %mr_factorOrder(1, 1), 0),
  check("factorOrder: 1 before anything", %mr_factorOrder(1, x), -1),
  check("factorOrder: anything after 1", %mr_factorOrder(x, 1), 1),
  check("commonFactors: 6x^2, 4x^3", %mr_commonFactors([6*x^2, 4*x^3]), [2*x^2, 3, 2*x]),
  check("commonFactors: b, 2b", %mr_commonFactors([b, 2*b]), [b, 1, 2]),
  check("commonFactors: a x, b x (the MostMainFactorPosition path)",
        %mr_commonFactors([a*x, b*x]), [x, a, b]),
  /* Task 8 fix round 1: the Log branch (upstream :3029-3033), reached
     when every LeadFactor is Log of a positive integer and the pairwise
     ratios are rational. Hand-derived from upstream: for
     [log(4),log(8)], lst3 = [log(4),log(8)], ratios = [1, log(8)/log(4)]
     = [1, 3/2] under FullSimplify (log(8) = 3 log(2), log(4) = 2 log(2));
     GCD([1,3/2]) = 1/2; common = Log[4^(1/2)] = log(2); the quotients
     are ratio*2/num = [2,3]. For the three-way case the ratios are
     [1,3/2,2] (log(16) = 4 log(2)), GCD = 1/2 again, quotients [2,3,4].
     MEASURED 2026-09-22: ratsimp(log(8)/log(4)) stays the unsimplified
     quotient (the brief's "FullSimplify there is ratsimp" is wrong for
     this ratio specifically -- source comment, %mr_commonFactors). */
  check("commonFactors: log(4), log(8) (the log-ratio branch)",
        %mr_commonFactors([log(4), log(8)]), [log(2), 2, 3]),
  check("commonFactors: log(4), log(8), log(16) (three-way log-ratio gcd)",
        %mr_commonFactors([log(4), log(8), log(16)]), [log(2), 2, 3, 4]),
  true)$

/* Section 9, G6b (spec 2026-09-22 A1): FunctionOfLinear (Rubi :4169, the
   5-arg overload :4176), FunctionOfLinearSubst (:4206). Expected values
   are hand-traced through the upstream definition (plan Task 9). */
test_section9_g6b() := block([],
  print("--- section 9 G6b: FunctionOfLinear ---"),
  check("fol: sin(2x+1)^2 + cos(2x+1) -> x, a = 1, b = 2",
        %mr_functionOfLinear(sin(2*x + 1)^2 + cos(2*x + 1), x),
        [sin(x)^2 + cos(x), 1, 2]),
  check("fol: sin(2x) cos(2x) -> a = 0, b = 2",
        %mr_functionOfLinear(sin(2*x)*cos(2*x), x), [cos(x)*sin(x), 0, 2]),
  check("fol: already in x (a = 0, b = 1) declines", %mr_functionOfLinear(sin(x), x), false),
  check("fol: two unrelated linears reduce to x itself, declines",
        %mr_functionOfLinear(sin(x)*cos(2*x), x), false),
  check("fols: a linear term", %mr_functionOfLinearSubst(2*x + 3, 1, 2, x), x + 2),
  /* Fix round 1 (ticket .scratch/class-ports/issues/10): the PowerQ/
     %e^... branch, a non-%e base with a nonzero exponent constant.
     Hand-derived from upstream (u(X) = 4^(2X+1) = e^(log(4)+2log(4)X),
     so a = log(4), b = 2 log(4), f(x) = e^x; u(X) itself is f(a+bX) =
     e^(log(4)+2log(4)X) = 4^(2X+1), confirming the triple): before the
     ratcoef workaround, %mr_coeff(u,x,0) dropped the log(4) constant
     term of log(4)*(2x+1) and this returned [%e^x,0,2*log(4)]. */
  check("fol: 4^(2x+1), non-%e base, nonzero exponent constant",
        %mr_functionOfLinear(4^(2*x + 1), x), [%e^x, log(4), 2*log(4)]),
  check("fols: 4^(2x+1) at its own [a,b] = [log(4), 2 log(4)]",
        %mr_functionOfLinearSubst(4^(2*x + 1), log(4), 2*log(4), x), %e^x),
  true)$

/* Rubi's condition-assignment idiom, on the generated records that carry
   it (9.3 .m :145/:177/:185/:193 -> 9_3 r18/r22/r23/r24; the only four
   sites in the pinned clone). Upstream r18:

     Int[u_.*v_^m_.*(a_.+b_.*y_^n_)^p_.,x_Symbol] :=
       Module[{q,r}, q*r*Subst[Int[x^m*(a+b*x^n)^p,x],x,y] /;
         Not[FalseQ[r=Divides[y^m,v^m,x]]] &&
         Not[FalseQ[q=DerivativeDivides[y,u,x]]]] /; FreeQ[{a,b,m,n,p},x]

   The `/;` test BINDS r and q and the replacement multiplies by them.
   Maxima's `=` is EQUALITY, so emitted verbatim the guard tests an
   equation object -- never false, so the record fires unguarded -- and
   the replacement's q, r stay unbound symbols in the answer
   (.scratch/class-ports/issues/13). The generator emits `:`.

   Expected values hand-derived from upstream (Rubi :7443 Divides,
   :6947 DerivativeDivides), y = v = x^2+1, m = 1 throughout:
     Divides[y^m,v^m,x] = (x^2+1)/(x^2+1) = 1, free of x;
     u = x  : DerivativeDivides[x^2+1,x,x] = x/D[x^2+1,x] = 1/2, so the
              record fires and its q*r factor is 1/2 exactly;
     u = x^3: Exponent[u,x] = 3 =/= Exponent[y,x]-1 = 1, so
              DerivativeDivides = False and the record must decline;
     v = x  : Divides[x^2+1,x,x] = x/(x^2+1), not free of x, so
              Divides = False and the record must decline -- and the
              condition must not even reach DerivativeDivides. */
test_section9_condassign() := block(
    [mr_ca_saved, mr_ca_ok, mr_ca_fire, mr_ca_nodd, mr_ca_nodiv,
     mr_ca_r22, mr_ca_res, mr_ca_ref],
  print("--- section 9: the condition-assignment idiom (9.3 r18/r22) ---"),
  mr_ca_saved : mr_rule_table,
  mr_ca_ok : errcatch(
    %mr_load_sibling("rules/class9/9_3.mac", 'mr_witness_9_3), true),
  mr_rule_table : mr_ca_saved,
  check_bool("condassign: rules/class9/9_3.mac loads", is(mr_ca_ok # [])),
  mr_ca_fire : ['_mr_9_3_r18_a = 1, '_mr_9_3_r18_b = 1, '_mr_9_3_r18_m = 1,
                '_mr_9_3_r18_n = 1, '_mr_9_3_r18_p = 1, '_mr_9_3_r18_u = x,
                '_mr_9_3_r18_v = x^2 + 1, '_mr_9_3_r18_y = x^2 + 1],
  mr_ca_nodd : ['_mr_9_3_r18_a = 1, '_mr_9_3_r18_b = 1, '_mr_9_3_r18_m = 1,
                '_mr_9_3_r18_n = 1, '_mr_9_3_r18_p = 1, '_mr_9_3_r18_u = x^3,
                '_mr_9_3_r18_v = x^2 + 1, '_mr_9_3_r18_y = x^2 + 1],
  mr_ca_nodiv : ['_mr_9_3_r18_a = 1, '_mr_9_3_r18_b = 1, '_mr_9_3_r18_m = 1,
                 '_mr_9_3_r18_n = 1, '_mr_9_3_r18_p = 1, '_mr_9_3_r18_u = x,
                 '_mr_9_3_r18_v = x, '_mr_9_3_r18_y = x^2 + 1],
  /* r22 is the same idiom on the trinomial LHS; n2 = 2 n and w = y are
     its extra outer tests, satisfied here, so only the idiom decides. */
  mr_ca_r22 : ['_mr_9_3_r22_a = 1, '_mr_9_3_r22_b = 1, '_mr_9_3_r22_c = 1,
               '_mr_9_3_r22_m = 1, '_mr_9_3_r22_n = 1, '_mr_9_3_r22_n2 = 2,
               '_mr_9_3_r22_p = 1, '_mr_9_3_r22_u = x^3,
               '_mr_9_3_r22_v = x^2 + 1, '_mr_9_3_r22_w = x^2 + 1,
               '_mr_9_3_r22_y = x^2 + 1],
  check_bool("condassign: 9_3 r18 cond fires when Divides and DerivativeDivides both answer",
             _mr_cond_9_3_r18(mr_ca_fire, x)),
  check_not("condassign: 9_3 r18 cond declines when DerivativeDivides is False",
            _mr_cond_9_3_r18(mr_ca_nodd, x)),
  check_not("condassign: 9_3 r18 cond declines when Divides is False",
            _mr_cond_9_3_r18(mr_ca_nodiv, x)),
  check_not("condassign: 9_3 r22 cond declines when DerivativeDivides is False",
            _mr_cond_9_3_r22(mr_ca_r22, x)),
  mr_ca_res : _mr_repl_9_3_r18(mr_ca_fire, x),
  mr_ca_ref : %mr_subst(mr_int(x*(x + 1), x), x, x^2 + 1),
  check_bool("condassign: 9_3 r18 repl answer is free of the rule locals q and r",
             freeof('_mr_9_3_r18_q, '_mr_9_3_r18_r, mr_ca_res)),
  check("condassign: 9_3 r18 repl multiplies by q*r = 1/2",
        ratsimp(mr_ca_res / mr_ca_ref), 1/2),
  true)$

/* The generated With/Module locals, every class (ticket 08, section C).
 * 1.1.3.1 r13 binds block([r, s, k, u]) and runs its nested mr_int and
 * mr_sum inside it; mr_sum re-evaluates the summand while that block is
 * live, so unprefixed, an integrand spelled with r and s read the
 * locals' values (r : num(Rt(a/b, n)) is then r^(1/5)). The generator
 * now names every With/Module local _mr_<key>_r<n>_<name>. */
test_with_local_capture_all() := block([mr_wl_saved, mr_wl_ok, mr_wl_f,
                                        mr_wl_r, mr_wl_q],
  print("--- generated With/Module locals, every class (ticket 08 C) ---"),
  mr_wl_saved : mr_rule_table,
  mr_wl_ok : errcatch(
    %mr_load_sibling("rules/class1/1_1_1_1.mac", 'mr_witness_1_1_1_1),
    %mr_load_sibling("rules/class1/1_1_3_1.mac", 'mr_witness_1_1_3_1),
    %mr_load_sibling("rules/class1/1_2_1_1.mac", 'mr_witness_1_2_1_1),
    %mr_load_sibling("rules/class1/1_2_1_2.mac", 'mr_witness_1_2_1_2),
    true),
  mr_wl_f : 1/(r + s*x^5),
  mr_wl_r : false, mr_wl_q : false,
  if mr_wl_ok # [] then (
    mr_rule_table : flatten([mr_rules_1_1_1_1, mr_rules_1_1_3_1,
                             mr_rules_1_2_1_1, mr_rules_1_2_1_2]),
    mr_wl_r : rubi(mr_wl_f, x),
    mr_wl_q : subst([p = r, q = s], rubi(subst([r = p, s = q], mr_wl_f), x))),
  mr_rule_table : mr_wl_saved,
  check_bool("With locals: 1/(r+s x^5) answers and verifies (|resid| < 1e-12 at two points)",
    is(mr_wl_r # false)
    and freeof('unintegrable, 'mr_int, mr_wl_r)
    and is(mr_i2_resid(mr_wl_f, mr_wl_r, [x = 0.37, r = 1.3, s = 0.7]) < 1.0e-12)
    and is(mr_i2_resid(mr_wl_f, mr_wl_r, [x = 1.1, r = 2.2, s = 1.9]) < 1.0e-12)),
  check_bool("With locals: 1/(r+s x^5) is the same answer with r, s renamed p, q",
    is(mr_wl_r # false) and is(mr_wl_r = mr_wl_q)),
  true
)$

/* ---- class 8 cluster A: the formal derivative, %mr_derivative ----
   docs/class-porting.md Step 4. Rubi's Derivative[n][f][u] (9.1
   Derivative integration rules, 21 rules, now part of the class-8 port) is
   Maxima's own derivative noun 'diff(f(u), u, n), order 0 being f(u)
   (.scratch/class-ports/issues/01, "DESIGN";
   probes/answer-side/04-class8-answer-side-identities.out N1-N17). The
   generator emits %mr_derivative(n, f, u) for every Derivative[a][b][c]
   in a condition or replacement (rules/class8/9_1d.mac, 23 sites). */
test_class8_cluster_a() := block([],
  print("--- class 8 cluster A: %mr_derivative (Derivative[n][f][u]) ---"),
  check_bool("deriv: order 1 is Maxima's own noun 'diff(f(x),x,1)",
             is(%mr_derivative(1, f, x) = 'diff(f(x), x, 1))),
  check_bool("deriv: order 1 is what diff(f(x), x) returns",
             is(%mr_derivative(1, f, x) = diff(f(x), x))),
  check_bool("deriv: order 0 is f(x) itself", is(%mr_derivative(0, f, x) = f(x))),
  check_bool("deriv: a symbolic order m-1 stays a noun",
             is(%mr_derivative(m - 1, f, x) = 'diff(f(x), x, m - 1))),
  check_bool("deriv: a negative order (a formal antiderivative) is holdable",
             is(%mr_derivative(-1, f, x) = 'diff(f(x), x, -1))),
  check_bool("deriv: a composite point is Maxima's own subst spelling",
             is(%mr_derivative(1, F, f(x)*g(x))
                = subst(f(x)*g(x), x, 'diff(F(x), x, 1)))),
  check("deriv: d/dx of order 1 is order 2",
        ratsimp(diff(%mr_derivative(1, f, x), x) - %mr_derivative(2, f, x)), 0),
  check("deriv: d/dx of order m-1 is order m",
        ratsimp(diff(%mr_derivative(m - 1, f, x), x) - %mr_derivative(m, f, x)), 0),
  check("deriv: d/dx of order -1 is f(x)",
        ratsimp(diff(%mr_derivative(-1, f, x), x) - f(x)), 0),
  /* 8.1 r52/r68/r69 and 8.2 r53 compare a bound head capture with a head
     list: the list's bare names read as the same noun operators the
     dispatcher binds (the class-6 memberQ precedent) */
  check_bool("memberQ: erf(u)'s operator is in the 8.1 head list",
             %mr_memberQ([erf, erfc, erfi, fresnel_s, fresnel_c, expintegral_ei,
                          expintegral_si, expintegral_ci, expintegral_shi,
                          expintegral_chi], op(erf(x)))),
  check_bool("memberQ: fresnel_c(u)'s operator is in the 8.2 head list",
             %mr_memberQ([fresnel_s, fresnel_c], op(fresnel_c(x)))),
  check_not("memberQ: erf(u)'s operator is not in the Fresnel list",
            %mr_memberQ([fresnel_s, fresnel_c], op(erf(x)))),
  true
)$

/* ---- class 8 cluster B: FunctionOfExpnQ, and FunctionOfQ's `_` arm ----
   Rubi FunctionOfQ[v, u, x] (IntegrationUtilityFunctions.m L4443-4481)
   switches on Head[v]: the circular and hyperbolic heads go to their own
   tests, EVERYTHING ELSE to FunctionOfExpnQ[u, v, x] =!= False
   (L4486-4516). The port answered false for that `_` arm (deviation (a)),
   and every class-8 v takes it: ProductLog[x] (8.9 r44), f[x]*g[x] and
   Derivative[n-1][f][x] (9.1 r8-r18). FunctionOfExpnQ returns the degree
   of u in v (1 for v itself, the gcd over a sum or function's arguments,
   0 for a v-free atom) or False. The hyperbolic arms stay unported. */
test_class8_cluster_b() := block([],
  print("--- class 8 cluster B: FunctionOfExpnQ / FunctionOfQ's general arm ---"),
  check("foe: v itself is degree 1", %mr_functionOfExpnQ(f(x)*g(x), f(x)*g(x), x), 1),
  check("foe: an atom other than x is degree 0", %mr_functionOfExpnQ(a, f(x), x), 0),
  check("foe: x itself is not a function of v", %mr_functionOfExpnQ(x, f(x), x), false),
  check("foe: a power of v", %mr_functionOfExpnQ(lambert_w(x)^3, lambert_w(x), x), 3),
  check("foe: a product of powers matching v's factors",
        %mr_functionOfExpnQ(f(x)^2*g(x)^2, f(x)*g(x), x), 2),
  check("foe: a sum takes the gcd of its terms' degrees",
        %mr_functionOfExpnQ(1 + f(x)^2*g(x)^2, f(x)*g(x), x), 2),
  check("foe: 1/(1+f^2 g^2) is a function of f g",
        %mr_functionOfExpnQ(1/(1 + f(x)^2*g(x)^2), f(x)*g(x), x), 2),
  check("foe: a stray x makes it False",
        %mr_functionOfExpnQ(x/(1 + f(x)^2*g(x)^2), f(x)*g(x), x), false),
  check("foe: a free factor is dropped",
        %mr_functionOfExpnQ(3*lambert_w(x)^2, lambert_w(x), x), 2),
  check("foe: a formal derivative is a function of itself",
        %mr_functionOfExpnQ(cos('diff(f(x), x, 1)), 'diff(f(x), x, 1), x), 1),
  check("foe: f(x) is not a function of f'(x)",
        %mr_functionOfExpnQ(f(x)*'diff(f(x), x, 1), 'diff(f(x), x, 1), x), false),
  check_bool("foq: 1/(1+f^2 g^2) is a function of f g (the `_` arm)",
             %mr_functionOfQ(f(x)*g(x), 1/(1 + f(x)^2*g(x)^2), x)),
  check_not("foq: x/(1+f^2 g^2) is not",
            %mr_functionOfQ(f(x)*g(x), x/(1 + f(x)^2*g(x)^2), x)),
  check_bool("foq: a polynomial in ProductLog(x) is a function of it (8.9 r44)",
             %mr_functionOfQ(lambert_w(x), 1 + lambert_w(x)^2, x)),
  /* CalculusQ: the formal-derivative noun is Mathematica's evaluated
     Derivative[n][f][v], not an unevaluated D */
  check_not("calculusQ: the formal derivative 'diff(f(x),x,1) is not calculus",
            %mr_calculusQ('diff(f(x), x, 1))),
  check_not("calculusQ: nor at a composite point",
            %mr_calculusQ(%mr_derivative(1, F, f(x)*g(x)))),
  check_bool("calculusQ: an integrate noun still is", %mr_calculusQ('integrate(f(x), x))),
  check_bool("calculusQ: a mixed diff noun still is", %mr_calculusQ('diff(f(x, y), x, 1))),
  check("foe: F'(f g) is a function of f g (its point)",
        %mr_functionOfExpnQ(%mr_derivative(1, F, f(x)*g(x)), f(x)*g(x), x), 1),
  check_bool("foq: F'(f g) (g f' + f g') -- u = F'(f g) -- is a function of f g (9.1 r9)",
             %mr_functionOfQ(f(x)*g(x), %mr_derivative(1, F, f(x)*g(x)), x)),
  check_bool("foq: cos(f'(x)) is a function of f'(x) (9.1 r8)",
             %mr_functionOfQ(%mr_derivative(1, f, x), cos(%mr_derivative(1, f, x)), x)),
  check_not("foq: the trig arm is unchanged (odd sin power vs cos)",
            %mr_functionOfQ(cos(x), sin(x)*(a - b*sin(x)^2), x)),
  check_not("foq: the hyperbolic arm still declines (unported)",
            %mr_functionOfQ(cosh(x), sinh(x)^2, x)),
  true
)$

/* ---- class 8 cluster C: SubstForAux, SubstFor's general fallback ----
   Rubi SubstFor[v, u, x] (L5980-6002) ends, after its atom / inert / free-
   factor / trig / hyperbolic arms, in SubstForAux[u, v, x] (L6004-6023):
   v -> x structurally, a power of v -> the power of x, a product u matched
   factor-for-factor against a product v. The port's last arm was
   subst(x, v, u), which cannot see a product v inside a power of it
   (probe 04 N17: f(x)*g(x) is not found in f(x)^2*g(x)^2). The fallback
   now takes SubstForAux (after the free-factor step) when u IS a function
   of v (FunctionOfExpnQ not False), and keeps subst otherwise. */
test_class8_cluster_c() := block([],
  print("--- class 8 cluster C: SubstForAux / SubstFor's general fallback ---"),
  check("sfa: v itself -> x", %mr_substForAux(f(x)*g(x), f(x)*g(x), x), x),
  check("sfa: a power of a product v -> the power of x",
        %mr_substForAux(f(x)^2*g(x)^2, f(x)*g(x), x), x^2),
  check("sfa: inside a sum and a reciprocal",
        ratsimp(%mr_substForAux(1/(1 + f(x)^2*g(x)^2), f(x)*g(x), x) - 1/(1 + x^2)), 0),
  check("sfa: a free factor is kept",
        %mr_substForAux(3*lambert_w(x)^2, lambert_w(x), x), 3*x^2),
  check("sfa: a formal derivative -> x inside a function",
        %mr_substForAux(cos('diff(f(x), x, 1)), 'diff(f(x), x, 1), x), cos(x)),
  check_bool("sf: F'(f g) for v = f g is F'(x) (9.1 r9's chain rule)",
        is(%mr_substFor(f(x)*g(x), %mr_derivative(1, F, f(x)*g(x)), x)
           = %mr_derivative(1, F, x))),
  check("sf: 1/(1+f^2 g^2) for v = f g is 1/(1+x^2)",
        ratsimp(%mr_substFor(f(x)*g(x), 1/(1 + f(x)^2*g(x)^2), x) - 1/(1 + x^2)), 0),
  check("sf: a polynomial in ProductLog(x)",
        ratsimp(%mr_substFor(lambert_w(x), 1 + lambert_w(x)^3, x) - (1 + x^3)), 0),
  check("sf: a free factor of v scales the variable",
        ratsimp(%mr_substFor(2*f(x)*g(x), f(x)^2*g(x)^2, x) - x^2/4), 0),
  check("sf: the power branch is unchanged (x^2 -> x)",
        ratsimp(%mr_substFor(x^2, x^4 + 1, x) - (x^2 + 1)), 0),
  true
)$

/* ---- class 8 end to end: 9.1 Derivative rules on a local table ----
   The 8.10 Formal derivatives integrands through rules/class8/9_1d.mac
   (and 1.1.1.1 for Int[1/x]), on a table built here and restored after
   (Layer A never calls mr_load_all). What each target exercises:
     r1   Int[Derivative[n][f][x]] -- the curried tree, order n-1 back;
     r19  f' g + f g' -- ONE capture f_ bound as a value (Derivative[1][f_])
          and as a head (f_[x_]): mr-tree's user-function heads;
     r9   F'(f g) (g f' + f g') -> F(f g): FunctionOfQ's general arm
          through the formal-derivative noun at a composite point, SubstFor
          -> SubstForAux, then r1 on F'(x); and the capture fix -- the
          repl applies the bound head F, which rubi's own parameter f once
          shadowed ((integrand)(x) came back);
     r4   sin(a+b x) f'' -- the IGtQ[n,0] integration by parts, twice.
   On the FULL table the f' g + f g' target does NOT reach r19: 1.4.1 r7 (a
   bare-u_ body exception, issue 07) splits the sum first, where Rubi's
   specificity order would try r19 -- recorded on
   .scratch/class-ports/issues/01, not asserted here. */
/* mr_nested_fallback is bound false here: Layer A runs with the nested
   integrate fall-through on (see the note after run_all_tests), and a
   nested give-up must read as the unintegrable marker the corpus's
   CannotIntegrate answers are, as in the driver's rules-only default. */
test_class8_e2e() := block([mr_c8_saved, mr_c8_ok, mr_c8_r, mr_c8_e,
                            mr_nested_fallback : false],
  print("--- class 8 end to end: 9.1 Derivative rules ---"),
  mr_c8_saved : mr_rule_table,
  mr_c8_ok : errcatch(
    %mr_load_sibling("rules/class1/1_1_1_1.mac", 'mr_witness_1_1_1_1),
    %mr_load_sibling("rules/class8/9_1d.mac", 'mr_witness_9_1d),
    true),
  check_bool("9_1d e2e: rule files load", is(mr_c8_ok # [])),
  if mr_c8_ok # [] then (
    mr_rule_table : flatten([mr_rules_1_1_1_1, mr_rules_9_1d]),
    check_bool("9_1d r1: Int f'(x) = f(x)",
               is(rubi(%mr_derivative(1, f, x), x) = f(x))),
    check_bool("9_1d r1: Int f^(n)(x) = f^(n-1)(x)",
               is(rubi(%mr_derivative(n, f, x), x) = %mr_derivative(n - 1, f, x))),
    check_bool("9_1d r1: Int f^(-1)(x) = f^(-2)(x) (a formal antiderivative)",
               is(rubi(%mr_derivative(-1, f, x), x) = %mr_derivative(-2, f, x))),
    check_bool("9_1d + 1.1.1.1: Int f'/f = log(f(x))",
               is(rubi(%mr_derivative(1, f, x)/f(x), x) = log(f(x)))),
    check_bool("9_1d r19: Int g f' + f g' = f(x) g(x)",
               is(rubi(g(x)*%mr_derivative(1, f, x) + f(x)*%mr_derivative(1, g, x), x)
                  = f(x)*g(x))),
    check_bool("9_1d r20: Int (g f' - f g')/g^2 = f(x)/g(x)",
               is(rubi((g(x)*%mr_derivative(1, f, x) - f(x)*%mr_derivative(1, g, x))/g(x)^2, x)
                  = f(x)/g(x))),
    check_bool("9_1d r9 + r1: Int F'(f g) (g f' + f g') = F(f(x) g(x))",
               is(rubi(%mr_derivative(1, F, f(x)*g(x))
                       *(g(x)*%mr_derivative(1, f, x) + f(x)*%mr_derivative(1, g, x)), x)
                  = F(f(x)*g(x)))),
    mr_c8_r : rubi(sin(a + b*x)*%mr_derivative(2, f, x), x),
    mr_c8_e : sin(a + b*x)*%mr_derivative(1, f, x) - b*f(x)*cos(a + b*x)
              - b^2*mr_unintegrable(f(x)*sin(a + b*x), x),
    /* expand, not ratsimp: ratsimp leaves the two subscripted
       'unintegrable kernels uncancelled, expand cancels them (measured) */
    check("9_1d r4 twice: Int sin(a+b x) f''(x), the corpus's answer",
          expand(mr_c8_r - mr_c8_e), 0)),
  mr_rule_table : mr_c8_saved,
  true
)$

/* ---- class 5 cluster A: HalfIntegerQ, Head ----------------------------
   docs/class-porting.md Step 4; the class-5 census's unlisted tokens
   (.scratch/class-ports/issues/02, Step 1). HalfIntegerQ (Rubi L80, 8
   rules of 5.1.3/5.1.4): every argument an explicit rational with
   denominator 2. Head (5.3.7 r27/r28's EqQ[Head[tmp], ArcTan]): a call's
   operator is the native symbol the table emits for the bare head atom
   (probes/answer-side/05-class5-answer-side-identities.out H1-H3). */
test_class5_cluster_a() := block([],
  print("--- class 5 cluster A: HalfIntegerQ, Head ---"),
  check_bool("halfIntegerQ: 1/2", %mr_halfIntegerQ(1/2)),
  check_bool("halfIntegerQ: 3/2 and -1/2 (both)", %mr_halfIntegerQ(3/2, -1/2)),
  check_not("halfIntegerQ: 1/2 and 1 (an integer is not)", %mr_halfIntegerQ(1/2, 1)),
  check_not("halfIntegerQ: 3", %mr_halfIntegerQ(3)),
  check_not("halfIntegerQ: 1/3", %mr_halfIntegerQ(1/3)),
  check_not("halfIntegerQ: 0.5 (a float is not explicit)", %mr_halfIntegerQ(0.5)),
  check_not("halfIntegerQ: a symbol p", %mr_halfIntegerQ(p)),
  check_not("halfIntegerQ: p/2 (symbolic)", %mr_halfIntegerQ(p/2)),
  check("head: atan(1+2*x) is atan", %mr_head(atan(1 + 2*x)), 'atan),
  check("head: acot(x) is acot", %mr_head(acot(x)), 'acot),
  check_bool("head: EqQ[Head[atan(..)], ArcTan] as the rule emits it",
             %mr_eqQ(%mr_head(atan(1 + 2*x)), atan)),
  check_not("head: EqQ[Head[acot(..)], ArcTan] is false",
            %mr_eqQ(%mr_head(acot(1 + 2*x)), atan)),
  check_not("head: a sum's head is not atan", %mr_eqQ(%mr_head(a + atan(x)), atan)),
  check("head: a/b is a product (the stored head)", %mr_head(a/b), "*"),
  check("head: an integer atom is Integer", %mr_head(3), 'Integer),
  check("head: a symbol atom is Symbol", %mr_head(a), 'Symbol),
  true
)$

/* ---- class 5 cluster B: InverseFunctionOfLinear, SubstForInverseFunction
   Rubi L6084 / L6085-6096, the 5.3.7 r27/r28 pair (Int[u_*v_^n_., x] with
   v a quadratic of negative discriminant and u carrying ArcTan/ArcCot of a
   linear argument). */
test_class5_cluster_b() := block([],
  print("--- class 5 cluster B: InverseFunctionOfLinear, SubstForInverseFunction ---"),
  check("ifl: the inverse function of a linear argument inside a power",
        %mr_inverseFunctionOfLinear(%e^atan(1 + 2*x), x), atan(1 + 2*x)),
  check("ifl: depth first, inside a product",
        %mr_inverseFunctionOfLinear(x^2*%e^acot(3*x), x), acot(3*x)),
  check("ifl: log is an inverse function too (InverseFunctionQ)",
        %mr_inverseFunctionOfLinear(x*log(1 + x), x), log(1 + x)),
  check("ifl: a non-linear argument is not (and nothing below it is)",
        %mr_inverseFunctionOfLinear(%e^atan(x^2), x), false),
  check("ifl: a trig call is not an inverse function",
        %mr_inverseFunctionOfLinear(sin(1 + 2*x), x), false),
  check("ifl: x-free is false", %mr_inverseFunctionOfLinear(%e^atan(a), x), false),
  check("ifl: an atom is false", %mr_inverseFunctionOfLinear(x, x), false),
  check("sfi 4-arg: v -> x and x -> w",
        %mr_substForInverseFunction(x*%e^atan(1 + 2*x), atan(1 + 2*x), w, x),
        w*%e^x),
  check("sfi 3-arg, atan: w = (tan(x) - 1)/2",
        ratsimp(%mr_substForInverseFunction(x*%e^atan(1 + 2*x), atan(1 + 2*x), x)
                - (tan(x) - 1)/2*%e^x), 0),
  check("sfi 3-arg, acot: w = cot(x)/3",
        ratsimp(%mr_substForInverseFunction(x^2*atan(3*x)*acot(3*x), acot(3*x), x)
                - (cot(x)/3)^2*atan(cot(x))*x), 0),
  check("sfi: an x-free factor is kept as is",
        %mr_substForInverseFunction(a*%e^atan(x), atan(x), x), a*%e^x),
  true
)$

/* ---- class 5 end to end ------------------------------------------------
   Generated class-5 files through the dispatcher, on a sibling table (the
   class-8 e2e shape), with the nested integrate fall-through Layer A binds
   on: 5.3.7 r27/r28 (the ports above), 5.5.1 r1/r2 (the asec/acsc rows),
   5.1.5 r9 (the ExpandExpression row). Each answer is checked by its
   derivative. NOTE: r27/r28 reach only quadratics whose discriminant
   identity closes syntactically (1+x^2 here): %mr_eqQ does not expand
   (.scratch/matcher-translation-fixes/issues/03), so a shifted quadratic
   such as 4x^2+4x+2 declines -- recorded on ticket 02, not pinned here. */
test_class5_e2e() := block([mr_c5_saved, mr_c5_ok, mr_c5_r],
  print("--- class 5 end to end: 5.3.7 r27/r28, 5.5.1, 5.1.5 r9 ---"),
  mr_c5_saved : mr_rule_table,
  mr_c5_ok : errcatch(
    %mr_load_sibling("rules/class1/1_1_1_1.mac", 'mr_witness_1_1_1_1),
    %mr_load_sibling("rules/class5/5_1_5.mac", 'mr_witness_5_1_5),
    %mr_load_sibling("rules/class5/5_3_7.mac", 'mr_witness_5_3_7),
    %mr_load_sibling("rules/class5/5_5_1.mac", 'mr_witness_5_5_1),
    true),
  check_bool("class 5 e2e: rule files load", is(mr_c5_ok # [])),
  if mr_c5_ok # [] then (
    mr_rule_table : flatten([mr_rules_1_1_1_1, mr_rules_5_3_7]),
    check_bool("5_3_7 r27: Int e^atan(x)/(1+x^2) = e^atan(x)",
               is(rubi(%e^atan(x)/(1 + x^2), x) = %e^atan(x))),
    check_bool("5_3_7 r28: Int e^acot(x)/(1+x^2) = -e^acot(x)",
               is(rubi(%e^acot(x)/(1 + x^2), x) = -%e^acot(x))),
    mr_c5_r : rubi(x*%e^atan(x)/(1 + x^2)^2, x),
    /* the answer carries sin(2*atan(x)), which ratsimp does not close:
       the derivative is checked at two points instead */
    check_bool("5_3_7 r27, n = -2 with an x factor: no noun",
               freeof('unintegrable, mr_c5_r)),
    check_bool("5_3_7 r27, n = -2 with an x factor: the derivative at x = 0.3, 0.7",
               every(lambda([mr_c5_p],
                        is(abs(float(subst(x = mr_c5_p, diff(mr_c5_r, x)
                                        - x*%e^atan(x)/(1 + x^2)^2))) < 1.0e-12)),
                     [0.3, 0.7])),
    mr_rule_table : flatten([mr_rules_1_1_1_1, mr_rules_5_5_1]),
    mr_c5_r : rubi(asec(x), x),
    check_bool("5_5_1 r1: Int asec(x) has no noun", freeof('unintegrable, mr_c5_r)),
    check_bool("5_5_1 r1: Int asec(x), the derivative at x = 2.3",
               is(abs(float(subst(x = 2.3, diff(mr_c5_r, x) - asec(x)))) < 1.0e-12)),
    mr_c5_r : rubi(acsc(3*x), x),
    check_bool("5_5_1 r2: Int acsc(3x), the derivative at x = 2.3",
               is(abs(float(subst(x = 2.3, diff(mr_c5_r, x) - acsc(3*x)))) < 1.0e-12)),
    mr_rule_table : flatten([mr_rules_1_1_1_1, mr_rules_5_1_5]),
    mr_c5_r : rubi((1 + x + x^2)*asin(x), x),
    check_bool("5_1_5 r9: Int (1+x+x^2) asin(x) has no noun",
               freeof('unintegrable, mr_c5_r)),
    check_bool("5_1_5 r9: Int (1+x+x^2) asin(x), the derivative at x = 0.3",
               is(abs(float(subst(x = 0.3, diff(mr_c5_r, x) - (1 + x + x^2)*asin(x))))
                  < 1.0e-12))),
  mr_rule_table : mr_c5_saved,
  true
)$

/* ---- class 4, Step 4 cluster (a): the inert-representation utilities ----
   docs/class-porting.md Step 4; .scratch/class-ports/issues/05 (Step 1's
   adjudication). The utilities the class-4 rule files call and the
   inert-trig substrate did not port:
   - ComplexFreeQ (4.1.10 r9-r11, L226);
   - InertTrigQ's MemberQ reading (L6160): a HEAD is inert-trig, an
     application of one is not (MemberQ[{sin,...}, sin[x]] is False);
   - ExpandTrig, 2- and 3-argument (50 rules, L3362-3370);
   - Known{Sine,Secant,Tangent,Cotangent}IntegrandQ over KnownTrigIntegrandQ
     (the 4.7.1-4.7.3 normalization rules, L7368-7391);
   - TrigSimplifyQ / TrigSimplify / TrigSimplifyRecur and TrigSimplifyAux's
     31 clauses, a generated rewrite table (mr_rw_tsa) walked with the
     3-argument %mr_rewrite (4.7.5 r66, L2702-2946). */
test_class4_cluster_a() := block([mr_c4a_r],
  print("--- class 4 cluster (a): inert-representation utilities ---"),
  errcatch(%mr_load_sibling("rules/utils/inert_trig_rewrites.mac",
                            'mr_witness_inert_trig_rewrites)),
  /* ComplexFreeQ */
  check_bool("complexFreeQ: a real product", %mr_complexFreeQ(2*a*x)),
  check_bool("complexFreeQ: an integer", %mr_complexFreeQ(3)),
  check_not("complexFreeQ: %i", %mr_complexFreeQ(%i)),
  check_not("complexFreeQ: an imaginary coefficient", %mr_complexFreeQ(2*%i*f)),
  check_not("complexFreeQ: a complex sum inside a call", %mr_complexFreeQ(sin(a + %i*b))),
  /* InertTrigQ, MemberQ semantics */
  check_bool("inertTrigQ: the head %mr_icsc", %mr_inertTrigQ(%mr_icsc)),
  check_not("inertTrigQ: an APPLICATION of an inert head is not a member",
            %mr_inertTrigQ(%mr_isin(x))),
  /* ExpandTrig */
  mr_c4a_r : %mr_expandTrig(%mr_isin(x)^2*(a*%mr_icos(x) + b*%mr_isin(x)), x),
  check_bool("expandTrig: expanded to a sum, activated",
             %mr_sumQ(mr_c4a_r) and %mr_inertTrigFreeQ(mr_c4a_r)
             and is(ratsimp(mr_c4a_r - sin(x)^2*(a*cos(x) + b*sin(x))) = 0)),
  mr_c4a_r : %mr_expandTrig(%mr_icsc(x), (a + b*%mr_isin(x))^2, x),
  check_bool("expandTrig (3 args): the activated factor distributed over the expansion",
             %mr_sumQ(mr_c4a_r) and is(length(mr_c4a_r) = 3)
             and %mr_inertTrigFreeQ(mr_c4a_r)
             and is(ratsimp(mr_c4a_r - csc(x)*(a + b*sin(x))^2) = 0)),
  check("expandTrig (3 args): a non-sum expansion is multiplied",
        %mr_expandTrig(%mr_icsc(x), 2*%mr_isin(x), x), 2*csc(x)*sin(x)),
  /* KnownTrigIntegrandQ and its four wrappers */
  check_bool("knownSine: 1", %mr_knownSineIntegrandQ(1, x)),
  check_bool("knownSine: (a+b sin(e+f x))^m",
             %mr_knownSineIntegrandQ((a + b*%mr_isin(e + f*x))^m, x)),
  check_bool("knownSine: (a+b cos)^m (A+B cos)",
             %mr_knownSineIntegrandQ((a + b*%mr_icos(2*x))^m*(3 + 4*%mr_icos(2*x)), x)),
  check_bool("knownSine: A + C sin^2",
             %mr_knownSineIntegrandQ(3 + 5*%mr_isin(x)^2, x)),
  check_bool("knownSine: A + B cos + C cos^2",
             %mr_knownSineIntegrandQ(1 + 2*%mr_icos(x) + 5*%mr_icos(x)^2, x)),
  check_not("knownSine: a tan integrand is not a sine integrand",
            %mr_knownSineIntegrandQ((a + b*%mr_itan(x))^m, x)),
  check_not("knownSine: x sin(x) is not known",
            %mr_knownSineIntegrandQ(x*%mr_isin(x), x)),
  check_not("knownSine: two different arguments",
            %mr_knownSineIntegrandQ((a + b*%mr_isin(x))^m*(3 + 4*%mr_isin(2*x)), x)),
  check_bool("knownTangent: (a+b tan)^m", %mr_knownTangentIntegrandQ((a + b*%mr_itan(x))^m, x)),
  check_not("knownTangent: not cot", %mr_knownTangentIntegrandQ((a + b*%mr_icot(x))^m, x)),
  check_bool("knownCotangent: (a+b cot)^m", %mr_knownCotangentIntegrandQ((a + b*%mr_icot(x))^m, x)),
  check_bool("knownSecant: csc", %mr_knownSecantIntegrandQ((a + b*%mr_icsc(x))^(-2), x)),
  check_not("knownSecant: an active sec is not inert",
            %mr_knownSecantIntegrandQ((a + b*sec(x))^m, x)),
  /* TrigSimplify */
  check("trigSimplifyAux: a cos^2 + a sin^2 + v = a + v (clause 2)",
        %mr_trigSimplifyAux(a*%mr_icos(z)^2 + a*%mr_isin(z)^2 + v), a + v),
  check("trigSimplifyAux: 1 - sin^2 = cos^2, activated (clause 6)",
        %mr_trigSimplifyAux(1 - %mr_isin(z)^2), cos(z)^2),
  check("trigSimplifyAux: 1 + tan^2 = sec^2 (clause 8)",
        %mr_trigSimplifyAux(1 + %mr_itan(z)^2), sec(z)^2),
  check("trigSimplifyAux: no clause applies -> unchanged (the catch-all, clause 30)",
        %mr_trigSimplifyAux(x^2 + 1), x^2 + 1),
  check("trigSimplify: bottom-up, then activated",
        %mr_trigSimplify(%mr_isin(x)^3*(1 - %mr_isin(x)^2)), sin(x)^3*cos(x)^2),
  check_bool("trigSimplifyQ: it simplifies",
             %mr_trigSimplifyQ(%mr_isin(x)^3*(1 - %mr_isin(x)^2))),
  check_not("trigSimplifyQ: nothing to simplify",
            %mr_trigSimplifyQ(%mr_isin(x)^3*(2 - %mr_isin(x)^2))),
  check_bool("tsa table has the 31 clauses",
             is(listp(mr_rw_tsa) and length(mr_rw_tsa) = 31)),
  /* Carried from the inert-trig substrate (ticket 05): DeactivateTrig on a
     SUM and on a QUOTIENT of trig calls (no committed target before), and
     WHICH FixInertTrigFunction clause fires -- a walk over the one-record
     table answers exactly what the full table answers. */
  check("deactivateTrig: a sum maps head for head",
        %mr_deactivateTrig(sin(x) + cos(x), x), %mr_isin(x) + %mr_icos(x)),
  mr_c4a_r : %mr_deactivateTrig((sin(x) + cos(x))/(1 + tan(x)), x),
  check_bool("deactivateTrig: a quotient is inert and round-trips",
             freeof(sin, cos, tan, mr_c4a_r) and not %mr_inertTrigFreeQ(mr_c4a_r)
             and is(%mr_activateTrig(mr_c4a_r) = (sin(x) + cos(x))/(1 + tan(x)))),
  check("fitf: csc^2 sin -> 1/sin is fitf clause 3 alone",
        %mr_rewrite("FixInertTrigFunction", [_mr_rw_fitf_r3], %mr_icsc(x)^2*%mr_isin(x), x),
        %mr_fixInertTrigFunction(%mr_icsc(x)^2*%mr_isin(x), x)),
  check("fitf: the free factor is clause 1 alone (its recursion re-enters the full table)",
        %mr_rewrite("FixInertTrigFunction", [_mr_rw_fitf_r1], 3*%mr_icsc(x)^2*%mr_isin(x), x),
        3/%mr_isin(x)),
  true
)$

/* ---- class 7 end to end ------------------------------------------------
   docs/class-porting.md Step 4. Class 7's token closure left no utility to
   port (.scratch/class-ports/issues/04, Step 1: the class-5 ports cover
   7.3.7's ShowSteps pair), so this section pins the class's two table
   decisions on generated class-7 files through the dispatcher, on sibling
   tables (the class-5 e2e shape), with the nested integrate fall-through
   Layer A binds on:
   - ArcTanh/ArcSinh/ArcCosh emit the NATIVE heads in class 7
     (generator/translation_table.py CLASS_RENAME): a rule that recurses on
     its own head (7.1.1 -> 7.1.4, 7.3.1 -> 7.3.4, 7.3.2 -> class 1)
     reaches the next class-7 rule, and the answer keeps the head (no log
     form); 7.3.7 r25/r26 compare op() of the call with the bare head atom
     (EqQ[Head[tmp], ArcTanh]). With the %mr_ shims these RED (measured
     2026-09-25: the class-7 files regenerated with CLASS_RENAME emptied);
   - the ArcSech/ArcCsch rows (7.5.1).
   Each answer is checked by its derivative, at two points where the
   answer carries a polylog. */
test_class7_e2e() := block([mr_c7_saved, mr_c7_ok, mr_c7_r, mr_c7_d],
  print("--- class 7 end to end: native inverse-hyperbolic heads, asech/acsch ---"),
  mr_c7_saved : mr_rule_table,
  /* the derivative residual of mr_c7_r against f, at each point */
  mr_c7_d(f, pts) := every(lambda([mr_c7_p],
      is(abs(float(rectform(subst(x = mr_c7_p, diff(mr_c7_r, x) - f)))) < 1.0e-10)),
    pts),
  mr_c7_ok : errcatch(
    %mr_load_sibling("rules/class1/1_1_1_1.mac", 'mr_witness_1_1_1_1),
    %mr_load_sibling("rules/class7/7_1_1.mac", 'mr_witness_7_1_1),
    %mr_load_sibling("rules/class7/7_1_2.mac", 'mr_witness_7_1_2),
    %mr_load_sibling("rules/class7/7_1_3.mac", 'mr_witness_7_1_3),
    %mr_load_sibling("rules/class7/7_1_4.mac", 'mr_witness_7_1_4),
    %mr_load_sibling("rules/class7/7_2_1.mac", 'mr_witness_7_2_1),
    %mr_load_sibling("rules/class7/7_3_1.mac", 'mr_witness_7_3_1),
    %mr_load_sibling("rules/class7/7_3_2.mac", 'mr_witness_7_3_2),
    %mr_load_sibling("rules/class7/7_3_4.mac", 'mr_witness_7_3_4),
    %mr_load_sibling("rules/class7/7_3_7.mac", 'mr_witness_7_3_7),
    %mr_load_sibling("rules/class7/7_5_1.mac", 'mr_witness_7_5_1),
    true),
  check_bool("class 7 e2e: rule files load", is(mr_c7_ok # [])),
  if mr_c7_ok # [] then (
    check_bool("class 7 files emit no %mr_atanh/%mr_asinh/%mr_acosh shim (7_1_1 r1's replacement)",
               freeof('%mr_asinh, fundef(_mr_repl_7_1_1_r1))
               and not freeof('asinh, fundef(_mr_repl_7_1_1_r1))),
    mr_rule_table : flatten([mr_rules_1_1_1_1, mr_rules_7_1_1, mr_rules_7_1_2,
                             mr_rules_7_1_3, mr_rules_7_1_4]),
    mr_c7_r : rubi(asinh(x)^2, x),
    check_bool("7_1_1 -> 7_1_4: Int asinh(x)^2 keeps asinh, no log form, no noun",
               not freeof('asinh, mr_c7_r) and freeof('log, mr_c7_r)
               and freeof('unintegrable, mr_c7_r)),
    check("7_1_1 -> 7_1_4: Int asinh(x)^2, the derivative",
          ratsimp(diff(mr_c7_r, x) - asinh(x)^2), 0),
    mr_c7_r : rubi(asinh(2*x)^3, x),
    check_bool("7_1_1 twice: Int asinh(2x)^3, the derivative at x = 0.3, 0.7",
               freeof('unintegrable, mr_c7_r) and mr_c7_d(asinh(2*x)^3, [0.3, 0.7])),
    mr_rule_table : flatten([mr_rules_1_1_1_1, mr_rules_7_3_1, mr_rules_7_3_2,
                             mr_rules_7_3_4]),
    mr_c7_r : rubi(x*atanh(x), x),
    check_bool("7_3_2: Int x atanh(x) keeps atanh, the derivative at x = 0.3, 0.7",
               not freeof('atanh, mr_c7_r) and freeof('unintegrable, mr_c7_r)
               and mr_c7_d(x*atanh(x), [0.3, 0.7])),
    mr_c7_r : rubi(atanh(x)^2, x),
    check_bool("7_3_1 -> 7_3_4: Int atanh(x)^2, the derivative at x = 0.3, 0.7",
               freeof('unintegrable, mr_c7_r) and mr_c7_d(atanh(x)^2, [0.3, 0.7])),
    mr_rule_table : flatten([mr_rules_1_1_1_1, mr_rules_7_2_1]),
    check("7_2_1: Int acosh(x) = x acosh(x) - sqrt(x^2-1)",
          rubi(acosh(x), x), x*acosh(x) - sqrt(x^2 - 1)),
    mr_rule_table : flatten([mr_rules_1_1_1_1, mr_rules_7_5_1]),
    mr_c7_r : rubi(asech(x), x),
    check_bool("7_5_1 (the asech row): Int asech(x) keeps asech, the derivative at x = 0.3, 0.7",
               not freeof('asech, mr_c7_r) and freeof('unintegrable, mr_c7_r)
               and mr_c7_d(asech(x), [0.3, 0.7])),
    mr_c7_r : rubi(acsch(3*x), x),
    check_bool("7_5_1 (the acsch row): Int acsch(3x) keeps acsch, the derivative at x = 0.3, 0.7",
               not freeof('acsch, mr_c7_r) and freeof('unintegrable, mr_c7_r)
               and mr_c7_d(acsch(3*x), [0.3, 0.7])),
    mr_rule_table : flatten([mr_rules_1_1_1_1, mr_rules_7_3_7]),
    check_bool("7_3_7 r25 (EqQ[Head[tmp], ArcTanh]): Int e^atanh(x)/(1-x^2) = e^atanh(x)",
               is(rubi(%e^atanh(x)/(1 - x^2), x) = %e^atanh(x))),
    check_bool("7_3_7 r26 (EqQ[Head[tmp], ArcCoth]): Int e^acoth(x)/(1-x^2) = e^acoth(x)",
               is(rubi(%e^acoth(x)/(1 - x^2), x) = %e^acoth(x))),
    mr_c7_r : rubi(x*%e^atanh(x)/(1 - x^2)^2, x),
    check_bool("7_3_7 r25, n = -2 with an x factor: the derivative at x = 0.3, 0.7",
               freeof('unintegrable, mr_c7_r)
               and mr_c7_d(x*%e^atanh(x)/(1 - x^2)^2, [0.3, 0.7]))),
  mr_rule_table : mr_c7_saved,
  true
)$

/* $ not ; — the function's value (tests_failed = 0) would otherwise
   print right under the Results: line, the line the reading protocol
   exists to be read. */
run_all_tests()$
quit();
