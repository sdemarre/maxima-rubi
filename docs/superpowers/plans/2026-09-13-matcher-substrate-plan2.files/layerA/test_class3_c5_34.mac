    /* Task 4C-C5 — the 3_4 slotted inner exponents (128 entries):
    x^m (a+b log(c (d+e x^n)^p))^q with a sqrt / cbrt / reciprocal inner
    exponent on the stored forms. The defmatch runner needed the mly / m1b
    slot re-emission with %mr_lpfac_parse recovery; MR-MATCH binds the
    faithful r8 / r4 patterns, so the checks read the captures directly
    (plan-2 pre-validation, probe_layerA_bind2.mac, 2026-09-13). A 5*x^2
    head declines: the x_^m_. item cannot absorb the 5. The answer-level
    reps run on the default 1.1.1.1 + 3_1_x + 3_3 + 3_4 in production order:
    without the 3_1_x files the reduction's sub-integral reaches the 3_3 r61
    Unintegrable catch-all first (probe_tables.mac). */
    test_class3_c5_34() := block([saved_table, mm, f, ans, z],
      print("--- c5: 3_4 slotted inner exponent ---"),
      %mr_load_sibling("rules/class3/3_1_1.mac", 'mr_witness_3_1_1),
      %mr_load_sibling("rules/class3/3_1_2.mac", 'mr_witness_3_1_2),
      %mr_load_sibling("rules/class3/3_1_3.mac", 'mr_witness_3_1_3),
      %mr_load_sibling("rules/class3/3_1_4.mac", 'mr_witness_3_1_4),
      %mr_load_sibling("rules/class3/3_1_5.mac", 'mr_witness_3_1_5),
      %mr_load_sibling("rules/class3/3_3.mac", 'mr_witness_3_3),
      %mr_load_sibling("rules/class3/3_4.mac", 'mr_witness_3_4),
      saved_table : mr_rule_table,
      mr_rule_table : flatten([mr_rule_table, mr_rules_3_1_1, mr_rules_3_1_2, mr_rules_3_1_3,
                               mr_rules_3_1_4, mr_rules_3_1_5, mr_rules_3_3, mr_rules_3_4]),
      /* r8 (head x^m): sqrt inner exponent */
      mm : %mr_rule_bindings(_mr_rule_3_4_r8, x^2*(a+b*log(c*(d+e*sqrt(x))^n))^2, x),
      check_bool("c5 r8 binds sqrt-inner head x^2", listp(mm)),
      check_bool("c5 r8 head exponent m=2", binds(mm, ['_mr_3_4_r8_m = 2])),
      check_bool("c5 r8 binds (a,b,c,d,e, inner n=1/2, p=n, q=2)",
                 binds(mm, ['_mr_3_4_r8_a = a, '_mr_3_4_r8_b = b, '_mr_3_4_r8_c = c,
                            '_mr_3_4_r8_d = d, '_mr_3_4_r8_e = e, '_mr_3_4_r8_n = 1/2,
                            '_mr_3_4_r8_p = n, '_mr_3_4_r8_q = 2])),
      /* reciprocal inner exponent: 1/sqrt(x) -> n = -1/2 */
      check_bool("c5 r8 recip-inner binds n=-1/2",
                 binds(%mr_rule_bindings(_mr_rule_3_4_r8, x*(a+b*log(c*(d+e*(1/sqrt(x)))^n))^2, x),
                       ['_mr_3_4_r8_n = -1/2, '_mr_3_4_r8_m = 1])),
      /* r4 (no head) */
      mm : %mr_rule_bindings(_mr_rule_3_4_r4, (a+b*log(c*(d+e*sqrt(x))^n))^2, x),
      check_bool("c5 r4 binds bare sqrt-inner (q=2)",
                 binds(mm, ['_mr_3_4_r4_n = 1/2, '_mr_3_4_r4_q = 2])),
      check_not("c5 r8 does not bind the 5*x^2 head",
                %mr_rule_bindings(_mr_rule_3_4_r8, 5*x^2*(a+b*log(c*(d+e*sqrt(x))^n))^2, x)),
      /* the reduction fires on the row-408 rep */
      check_bool("c5 r8 reduction fires on row-408 rep",
                 is(%mr_rule_apply(_mr_rule_3_4_r8, x^2*(a+b*log(c*(d+e*sqrt(x))^n))^2, x) # false)),
      /* answer-level zero-chain 1: row 408 (sqrt, head x^2, q=2) */
      f : x^2*(a+b*log(c*(d+e*sqrt(x))^n))^2,
      ans : rubi(f, x),
      check_not("c5 row-408 not a top noun",
                is(atom(ans)) or is(op(ans) = 'integrate)
                or is(string(op(ans)) = "unintegrable")),
      z : errcatch(factor(diff(ans, x) - f)),
      check_bool("c5 row-408 self-diff zero (factor)",
                 is(z # []) and is(part(z, 1) = 0)),
      /* answer-level zero-chain 2: row 450 (cbrt, head x, q=2) */
      f : x*(a+b*log(c*(d+e*x^(1/3))^n))^2,
      ans : rubi(f, x),
      check_not("c5 row-450 not a top noun",
                is(atom(ans)) or is(op(ans) = 'integrate)
                or is(string(op(ans)) = "unintegrable")),
      z : errcatch(factor(diff(ans, x) - f)),
      check_bool("c5 row-450 self-diff zero (factor)",
                 is(z # []) and is(part(z, 1) = 0)),
       mr_rule_table : saved_table,
       true
     )$
