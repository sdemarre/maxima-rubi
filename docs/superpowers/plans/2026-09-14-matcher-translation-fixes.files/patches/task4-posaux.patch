+  check("negQ a/c", %mr_negQ(a/c), false),
+  check("negQ e^2 b^2", %mr_negQ(e^2*b^2), false),
+  check("negQ 4 a c e^2", %mr_negQ(4*a*c*e^2), false),
+  check("negQ 2 (a+b)", %mr_negQ(2*(a + b)), false),
+  check("negQ b^2-4ac", %mr_negQ(b^2 - 4*a*c), false),
+  check("negQ -a", %mr_negQ(-a), true),
