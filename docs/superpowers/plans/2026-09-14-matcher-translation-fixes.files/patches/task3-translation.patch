+def _relation_items(s):
+    """Partition the depth-0 text of s into a complete item sequence
+    [start, end, kind]: relational ops ("op": = <= >= < > == #= !=), chain
+    terminators ("stop": ';', ',', ' and ', ' or '), and the term runs
+    between them ("term")."""
+    items = []
+    i = 0
+    n = len(s)
+    depth = 0
+    cur = None
+    while i < n:
+        ch = s[i]
+        if ch in "([{":
+            depth += 1
+            if cur is None:
+                cur = i
+            i += 1
+            continue
+        if ch in ")]}":
+            depth -= 1
+            if cur is None:
+                cur = i
+            i += 1
+            continue
+        if depth == 0:
+            two = s[i:i+2]
+            hit = None
+            if two in ("==", "#=", "<=", ">=", "!="):
+                hit = (i, i + 2, "op")
+            elif ch in "<>=" and s[i-1:i] != ":":
+                hit = (i, i + 1, "op")
+            elif ch in ";,":
+                hit = (i, i + 1, "stop")
+            elif ch == "a" and i > 0 and s[i-1] == " " and s[i:i+3] == "and" \
+                    and s[i+3:i+4] == " ":
+                hit = (i - 1, i + 4, "stop")
+            elif ch == "o" and i > 0 and s[i-1] == " " and s[i:i+2] == "or" \
+                    and s[i+2:i+3] == " ":
+                hit = (i - 1, i + 3, "stop")
+            if hit is not None:
+                if cur is not None:
+                    items.append([cur, hit[0], "term"])
+                    cur = None
+                items.append([hit[0], hit[1], hit[2]])
+                i = hit[1]
+                continue
+        if cur is None:
+            cur = i
+        i += 1
+    if cur is not None:
+        items.append([cur, n, "term"])
+    return items
+
