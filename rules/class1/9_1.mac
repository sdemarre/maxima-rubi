  _mr_9_1_r10_a : geteqR(mm, '_mr_9_1_r10_a), _mr_9_1_r10_b : geteqR(mm, '_mr_9_1_r10_b), _mr_9_1_r10_c : geteqR(mm, '_mr_9_1_r10_c),
  freeof(x, _mr_9_1_r10_a) and freeof(x, _mr_9_1_r10_b) and freeof(x, _mr_9_1_r10_c))$
_mr_repl_9_1_r10(mm, x) := block([_mr_9_1_r10_a__s, _mr_9_1_r10_b__s, _mr_9_1_r10_c__s],
  _mr_9_1_r10_a__s : geteqR(mm, '_mr_9_1_r10_a), _mr_9_1_r10_b__s : geteqR(mm, '_mr_9_1_r10_b), _mr_9_1_r10_c__s : geteqR(mm, '_mr_9_1_r10_c),
  _mr_9_1_r10_a__s*(_mr_9_1_r10_b__s + _mr_9_1_r10_c__s*x)^2/(2*_mr_9_1_r10_c__s))$
_mr_rule_9_1_r10(f, x) := block([mm, ok],
  mm : _mr_pat_9_1_r10(f, x),
  if mm = false then return(false),
  if %mr_containsBoolean(mm) then return(false),
  ok : _mr_cond_9_1_r10(mm, x),
  if is(ok) = true then _mr_repl_9_1_r10(mm, x) else false)$

/* L14: the negative-sign rule. The -u_ pattern also matches positive
 * targets by synthesizing u := -f (measured 2026-08-27: on
 * (e x)^m(A+B x^2)(c+d x^2)^3/(a+b x^2)^2 it binds u := -f stored as
 * a UNARY MINUS NODE, op = "-" — an mtimes-leading--1 guard misses it,
 * and the -rubi_hybrid(-f) re-dispatch re-fires r11 on -f (u := f) and
 * cycles to a seen-guard noun). A real negative target binds u clean
 * (measured: -5*x -> u := 5*x op "*"; -x^2 -> u := x^2 op "^";
 * -(a+b x) does not match at all; -5 -> false). The guard op(u) # "-"
 * keeps exactly the clean bindings: the synthesized u is always a
 * minus node (or a negative atom, also op "-"), a clean u never.
 * TOP-LEVEL ONLY (depth_level = 1): in a NESTED dispatch the .m's
 * L14 peels the sign and the full .m table handles the stripped
 * form; our partial table demonstrably mishandles stripped
 * mid-cascade forms (measured 2026-08-27 on the full-run A/B:
 * 1.2.1.2 e313 — the stripped form hits the 1.1.1.4 slot catch-all
 * and embeds the Unintegrable marker; 1.2.1.2 e825 — an unverified
 * radical form; 1.1.3.8 e156 — the cascade terminates in a
 * CONSTANT: the sub-answer differentiates to exactly 0, numerically
 * wrong). Unpeeled, the negated form 0-fires to the native
 * fall-through — the verifiable explicit-integral residue the
 * run-5/Phase-A runs build verified answers from. */
matchdeclare(_mr_9_1_r11_u, true)$
defmatch(_mr_pat_9_1_r11, -_mr_9_1_r11_u, x)$
_mr_cond_9_1_r11(mm, x) := block([_mr_9_1_r11_u],
  _mr_9_1_r11_u : geteqR(mm, '_mr_9_1_r11_u),
  op(_mr_9_1_r11_u) # "-"  and  is(depth_level = 1))$
_mr_repl_9_1_r11(mm, x) := block([_mr_9_1_r11_u__s],
  _mr_9_1_r11_u__s : geteqR(mm, '_mr_9_1_r11_u),
  -rubi_hybrid(_mr_9_1_r11_u__s, x))$
_mr_rule_9_1_r11(f, x) := block([mm, ok],
  mm : _mr_pat_9_1_r11(f, x),
  if mm = false then return(false),
  if %mr_containsBoolean(mm) then return(false),
  ok : _mr_cond_9_1_r11(mm, x),
  if is(ok) = true then _mr_repl_9_1_r11(mm, x) else false)$

/* L15: the complex-const rule. Maxima has no Complex[0,a] structure —
 * the %i factor IS the a = +/-1 — so the pattern is %i*u_ with the
 * synthesized-%i guard freeof(%i, u) (measured: on 5*x the pattern
 * binds u := -5*%i*x; a real %i target binds u %i-free). */
matchdeclare(_mr_9_1_r12_u, true)$
defmatch(_mr_pat_9_1_r12, %i*_mr_9_1_r12_u, x)$
_mr_cond_9_1_r12(mm, x) := block([_mr_9_1_r12_u],
  _mr_9_1_r12_u : geteqR(mm, '_mr_9_1_r12_u),
  freeof(%i, _mr_9_1_r12_u))$
_mr_repl_9_1_r12(mm, x) := block([_mr_9_1_r12_u__s],
  _mr_9_1_r12_u__s : geteqR(mm, '_mr_9_1_r12_u),
  %i*rubi_hybrid(_mr_9_1_r12_u__s, x))$
_mr_rule_9_1_r12(f, x) := block([mm, ok],
  mm : _mr_pat_9_1_r12(f, x),
  if mm = false then return(false),
  if %mr_containsBoolean(mm) then return(false),
  ok : _mr_cond_9_1_r12(mm, x),
  if is(ok) = true then _mr_repl_9_1_r12(mm, x) else false)$

/* L16: const-factor extraction (structural — see header r13 note).
 * A = product of the freeof(x) factors, U = the rest; the .m's
 * Not[MatchQ[u, b_*v_ /; FreeQ[b,x]]] guard is vacuous by
 * construction (U has no free factor) and the one-shot extraction
 * equals the .m's repeated application. */
_mr_rule_9_1_r13(f, x) := block([L, i, A, U],
  if op(f) # "*" or length(f) < 2 then return(false),
  L : %mr_product_factors(f),
  A : 1, U : 1,
  for i : 1 thru length(L) do (
    if freeof(x, part(L, i)) then A : A*part(L, i) else U : U*part(L, i)),
  if is(A = 1) then return(false),
  if is(U = 1) then return(false),
  A*rubi_hybrid(U, x))$

/* L17: sum linearity — the catch-all for genuine multi-term sums
 * (every other rule 0-fired first, so this is a terminal simplifier:
 * free terms to t*x, the rest to the cascade). */
matchdeclare(_mr_9_1_r14_u, true)$
defmatch(_mr_pat_9_1_r14, _mr_9_1_r14_u, x)$
_mr_cond_9_1_r14(mm, x) := block([_mr_9_1_r14_u],
  _mr_9_1_r14_u : geteqR(mm, '_mr_9_1_r14_u),
  %mr_sumQ(_mr_9_1_r14_u))$
_mr_repl_9_1_r14(mm, x) := block([_mr_9_1_r14_u__s],
  _mr_9_1_r14_u__s : geteqR(mm, '_mr_9_1_r14_u),
  %mr_intSum(_mr_9_1_r14_u__s, x))$
_mr_rule_9_1_r14(f, x) := block([mm, ok],
  mm : _mr_pat_9_1_r14(f, x),
  if mm = false then return(false),
  if %mr_containsBoolean(mm) then return(false),
  ok : _mr_cond_9_1_r14(mm, x),
  if is(ok) = true then _mr_repl_9_1_r14(mm, x) else false)$

/* L18: (c x)^m u with u a sum (structural — see header r15 note):
 * find a monomial power factor (c*x)^m, u := the remaining factors,
 * then ExpandIntegrand distributes (c x)^m over u and the cascade
 * integrates the resulting monomial sum (r14 IntSum + family rules). */
matchdeclare(_mr_9_1_r15mq1_a, freeof(x))$
matchdeclare(_mr_9_1_r15mq1_b, freeof(x))$
matchdeclare(_mr_9_1_r15mq1_v, true)$
_mr_rule_9_1_r15(f, x) := block([L, i, j, n, fac, base, c, m, u, found],
  if op(f) # "*" then return(false),
  L : %mr_product_factors(f),
  n : length(L),
  found : false, c : 0, m : 1, u : 1,
  for i : 1 thru n do (
    if is(found = false) and is(op(part(L, i)) = "^") then (
      base : part(part(L, i), 1),
      m : part(part(L, i), 2),
      if freeof(x, m) then (
        c : 0,
        if is(base = x) then c : 1
        else if is(op(base) = "*") and is(length(base) = 2) then (
          if is(part(base, 1) = x) then c : part(base, 2)
          else if is(part(base, 2) = x) then c : part(base, 1)),
        if is(c # 0) and freeof(x, c) then (
          u : 1,
          for j : 1 thru n do
            if is(j # i) then u : u*part(L, j),
          found : true)))),
  if is(found = false) then return(false),
  if is(%mr_sumQ(u) and not %mr_linearQ(u, x) and not %mr_matchQ(u, _mr_9_1_r15mq1_a + _mr_9_1_r15mq1_b*_mr_9_1_r15mq1_v, lambda([%mr_mqb], freeof(x, %mr_mk(_mr_9_1_r15mq1_a, %mr_mqb)) and freeof(x, %mr_mk(_mr_9_1_r15mq1_b, %mr_mqb))  and  %mr_inverseFunctionQ(%mr_mk(_mr_9_1_r15mq1_v, %mr_mqb))))) = true
  then rubi_hybrid(%mr_expandIntegrand((c*x)^m*u, x), x)
  else false)$

/* L19: u (a x^n)^m — measured to bind cleanly (on (x+1)*(2 x^3)^(1/4):
 * the matcher's a := 1, n := 1, m := 3/4, u := 2^(1/4)*(x+1) is a
 * different but valid decomposition — the repl is algebraically
 * correct for any binding that keeps u*(a x^n)^m = f). */
matchdeclare(_mr_9_1_r16_a, freeof(x))$
matchdeclare(_mr_9_1_r16_m, freeof(x))$
matchdeclare(_mr_9_1_r16_n, freeof(x))$
matchdeclare(_mr_9_1_r16_u, true)$
defmatch(_mr_pat_9_1_r16, _mr_9_1_r16_u*(_mr_9_1_r16_a*x^_mr_9_1_r16_n)^_mr_9_1_r16_m, x)$
_mr_cond_9_1_r16(mm, x) := block([_mr_9_1_r16_a, _mr_9_1_r16_m, _mr_9_1_r16_n, _mr_9_1_r16_u],
  _mr_9_1_r16_a : geteqR(mm, '_mr_9_1_r16_a), _mr_9_1_r16_m : geteqR(mm, '_mr_9_1_r16_m), _mr_9_1_r16_n : geteqR(mm, '_mr_9_1_r16_n), _mr_9_1_r16_u : geteqR(mm, '_mr_9_1_r16_u),
  freeof(x, _mr_9_1_r16_a) and freeof(x, _mr_9_1_r16_m) and freeof(x, _mr_9_1_r16_n)  and  not %mr_integerQ(_mr_9_1_r16_m))$
_mr_repl_9_1_r16(mm, x) := block([_mr_9_1_r16_a__s, _mr_9_1_r16_m__s, _mr_9_1_r16_n__s, _mr_9_1_r16_u__s],
  _mr_9_1_r16_a__s : geteqR(mm, '_mr_9_1_r16_a), _mr_9_1_r16_m__s : geteqR(mm, '_mr_9_1_r16_m), _mr_9_1_r16_n__s : geteqR(mm, '_mr_9_1_r16_n), _mr_9_1_r16_u__s : geteqR(mm, '_mr_9_1_r16_u),
  _mr_9_1_r16_a__s^%mr_intPart(_mr_9_1_r16_m__s)*(_mr_9_1_r16_a__s*x^_mr_9_1_r16_n__s)^%mr_fracPart(_mr_9_1_r16_m__s)/x^(_mr_9_1_r16_n__s*%mr_fracPart(_mr_9_1_r16_m__s))*rubi_hybrid(_mr_9_1_r16_u__s*x^(_mr_9_1_r16_m__s*_mr_9_1_r16_n__s), x))$
_mr_rule_9_1_r16(f, x) := block([mm, ok],
  mm : _mr_pat_9_1_r16(f, x),
  if mm = false then return(false),
  if %mr_containsBoolean(mm) then return(false),
  ok : _mr_cond_9_1_r16(mm, x),
  if is(ok) = true then _mr_repl_9_1_r16(mm, x) else false)$

/* L20: u v^m (b v)^n — shared-v slots: clean false on every probed
 * target (header r17 note). Faithful dead. */
matchdeclare(_mr_9_1_r17_b, freeof(x))$
matchdeclare(_mr_9_1_r17_n, freeof(x))$
matchdeclare(_mr_9_1_r17_u, true)$
matchdeclare(_mr_9_1_r17_v, true)$
