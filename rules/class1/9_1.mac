  freeof(x, _mr_9_1_r7_a) and freeof(x, _mr_9_1_r7_b)  and  not freeof(x, _mr_9_1_r7_v))$
_mr_repl_9_1_r7(mm, x) := block([_mr_9_1_r7_a__s, _mr_9_1_r7_b__s, _mr_9_1_r7_u__s, _mr_9_1_r7_v__s, _mr_9_1_r7_w__s, _mr_9_1_r7_p__s],
  _mr_9_1_r7_a__s : geteqR(mm, '_mr_9_1_r7_a), _mr_9_1_r7_b__s : geteqR(mm, '_mr_9_1_r7_b), _mr_9_1_r7_u__s : geteqR(mm, '_mr_9_1_r7_u), _mr_9_1_r7_v__s : geteqR(mm, '_mr_9_1_r7_v), _mr_9_1_r7_w__s : geteqR(mm, '_mr_9_1_r7_w), _mr_9_1_r7_p__s : geteqR(mm, '_mr_9_1_r7_p),
  rubi_hybrid_exact(_mr_9_1_r7_u__s*((_mr_9_1_r7_a__s + _mr_9_1_r7_b__s)*_mr_9_1_r7_v__s + _mr_9_1_r7_w__s)^_mr_9_1_r7_p__s, x))$
_mr_rule_9_1_r7(f, x) := block([mm, ok],
  mm : _mr_pat_9_1_r7(f, x),
  if mm = false then return(false),
  if %mr_containsBoolean(mm) then return(false),
  ok : _mr_cond_9_1_r7(mm, x),
  if is(ok) = true then _mr_repl_9_1_r7(mm, x) else false)$

/* L11: rational-exponent fold Px^p -> Px^Simplify[p]. Effectively dead
 * (a stored p is already simplified; measured reading: ratsimp). */
matchdeclare(_mr_9_1_r8_p, freeof(x))$
matchdeclare(_mr_9_1_r8_u, true)$
matchdeclare(_mr_9_1_r8_Px, true)$
defmatch(_mr_pat_9_1_r8, _mr_9_1_r8_u*_mr_9_1_r8_Px^_mr_9_1_r8_p, x)$
_mr_cond_9_1_r8(mm, x) := block([_mr_9_1_r8_p, _mr_9_1_r8_u, _mr_9_1_r8_Px],
  _mr_9_1_r8_p : geteqR(mm, '_mr_9_1_r8_p), _mr_9_1_r8_u : geteqR(mm, '_mr_9_1_r8_u), _mr_9_1_r8_Px : geteqR(mm, '_mr_9_1_r8_Px),
  %mr_polyQ(_mr_9_1_r8_Px, x)  and  not %mr_rationalQ(_mr_9_1_r8_p)  and  freeof(x, _mr_9_1_r8_p)  and  %mr_rationalQ(ratsimp(_mr_9_1_r8_p)))$
_mr_repl_9_1_r8(mm, x) := block([_mr_9_1_r8_p__s, _mr_9_1_r8_u__s, _mr_9_1_r8_Px__s],
  _mr_9_1_r8_p__s : geteqR(mm, '_mr_9_1_r8_p), _mr_9_1_r8_u__s : geteqR(mm, '_mr_9_1_r8_u), _mr_9_1_r8_Px__s : geteqR(mm, '_mr_9_1_r8_Px),
  rubi_hybrid(_mr_9_1_r8_u__s*_mr_9_1_r8_Px__s^ratsimp(_mr_9_1_r8_p__s), x))$
_mr_rule_9_1_r8(f, x) := block([mm, ok],
  mm : _mr_pat_9_1_r8(f, x),
  if mm = false then return(false),
  if %mr_containsBoolean(mm) then return(false),
  ok : _mr_cond_9_1_r8(mm, x),
  if is(ok) = true then _mr_repl_9_1_r8(mm, x) else false)$

/* L12: the constant rule — the corpus's 9 A-constant entries need it.
 * Measured: a bare freeof-var pattern matches any x-free integrand and
 * declines x-dependent ones. */
matchdeclare(_mr_9_1_r9_a, freeof(x))$
defmatch(_mr_pat_9_1_r9, _mr_9_1_r9_a, x)$
