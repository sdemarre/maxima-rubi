/* rules/class1/9_1.mac — MANUAL port; do not edit ad hoc.
 *
 * Source: Rubi 4 pin 61e9c18ea248061cd83c67882f7c91a73cef912d
 *          Rubi/IntegrationRules/9 Miscellaneous/9.1 Integrand
 *          simplification rules.m  (the on-disk legacy file; line
 *          numbers cited per rule below)
 *
 * This file is ABSENT from the pinned Rubi.m's LoadRules (dropped
 * 2023-12, f7fa0fd; only self-references remain) — it is not
 * generator-regenerable (generate_class1.py emits only the 67+5 files
 * Rubi.m actually loads). The 2018 Maxima-syntax corpus was generated
 * with it loaded (2018 Rubi.m LoadRules order, after the 1.x class
 * files), so its behavior is acceptance-critical and the port appends
 * to the end of mr_rule_table — the same relative position.
 *
 * Re-dispatch entry: rubi_hybrid (maxima_rubi_utils.mac) — the
 * mr_top mirror with the pass gates lifted and the integrate
 * fall-through on both the seen-guard hit and the 0-firing. No
 * existing entry has both halves the .m's nested Int had: mr_int
 * (fb=true) has the native fall-through (the run-5 load-bearing
 * answers on stuck mquot sub-integrals — the 1.4.3 r19 T4-cascade
 * x^(n-1)/(2e), and the 1.1.2.6 e43 r16 re-dispatch that regressed
 * to contains-noun on rubi's noun fall-through, measured
 * 2026-08-27) but runs passes 2-3 OFF (a bare-factor sub-integral
 * loses the lift — 1.1.2.6 e20 regresses exactly that way); rubi
 * (fb=false) keeps passes 2-3 but yields the mr_unintegrable
 * noun. rubi_hybrid keeps whatever rescue the sub-integral had in
 * either nesting context. (The .m's Int was self-contained —
 * Rubi.m:490 CannotIntegrate := Defer[Int][u, x], no native
 * fall-through — but the 2018 corpus's acceptance standard is the
 * run-5 pipeline, whose nested native answers are load-bearing, so
 * the hybrid follows the corpus, not the .m residue.) r14 keeps
 * %mr_intSum (shared with the 1.4.1 family port, whose fb=true
 * re-dispatch semantics are the accepted status quo).
 *
 * Maxima-specific readings (measured 2026-08-27, Maxima 5.50.0 /
 * SBCL 2.6.7; disposable probes /tmp/opencode/p1probe5.out,
 * /tmp/opencode/p6.out — the per-rule notes state each fact):
 *   r1  the matcher also offers the degenerate reading v := 0 with
 *       w := the WHOLE 2-term sum (no backtracking); that reading
 *       passes EqQ[v,0] and the repl is the integrand verbatim — the
 *       .m's $IntMaxSteps -> CannotIntegrate loop case. An extra
 *       is(v # 0) guard rejects it (stored bases never carry a
 *       literal 0 term, so the rule stays faithful-dead).
 *   r4  the EqQ[a,0] binding arises only from a degenerate 0-fill of a
 *       missing term (3-term pattern on a 2-term base), so the repl
 *       reproduces the stored integrand verbatim — a rule loop in 2018
 *       Mathematica too ($IntMaxSteps -> CannotIntegrate). In the .m
 *       world the 1.2.3 family catches this shape first; here the
 *       family's equivalent is the pass-3 lift rescan, which a pass-1
 *       terminal would block — so r4 DECLINES (the lifted family or
 *       the fall-through noun then decides, matching the .m residue).
 *   r11 the -u_ pattern matches positive targets too, synthesizing
 *       u := -f as a UNARY MINUS NODE (op "-"; the -rubi_hybrid(-f)
 *       re-dispatch re-fires r11 on -f — a loop). Guard: op(u) # "-"
 *       keeps only the clean bindings of real negative targets.
 *   r12 the %i*u_ pattern matches %i-free targets too, synthesizing
 *       u := -%i*f (loop hazard: the %i re-fires r12). Guard:
 *       freeof(%i, u) — a real %i target binds u %i-free.
 *   r13 the a_*u_ pattern cannot be defmatch'd: the matcher fills an
 *       unfilled factor slot with 1 and hands the WHOLE product to the
 *       generic slot (on 5*(a+b*x): a := 1, u := 5*(a+b*x)); the .m
 *       Not[MatchQ] guard then rejects the a := 1 binding anyway.
 *       Ported as a factor split (A = product of the freeof(x)
 *       factors, U = the rest); the .m guard is vacuous by
 *       construction and the one-shot extraction equals the .m's
 *       repeated application.
 *   r15 the (c_*x_)^m_*u_ defmatch 0-fires systematically: bare x^m
 *       base binds c := false; a (k x)^m base is coefficient-split
 *       into u with c := 1, so SumQ[u] never sees a sum. Ported as a
 *       factor scan.
 *   r17-r25 the shared-v power slots (v^m * (b v)^n, (a+b v)^m *
 *       (c+d v)^n, ...) return a clean false on every probed target —
 *       dead in Maxima but ported 1:1 (zero-fire, zero risk).
 *
 * Copyright (c) 2018 Rule-Based-Integration Organization (MIT).
 */

/* L4: Int[u.*(v_+w_)^p_., x] — the v=0 degenerate binomial. A stored
 * 1-term base has no plus node, so this 0-fires; a 2-term base binds
 * v to a nonzero stored term and EqQ[v,0] rejects. MEASURED 2026-08-27:
 * the Maxima matcher ALSO offers the degenerate reading v := 0 with w
 * := the WHOLE 2-term sum (no backtracking; (c+d x^2)^3 on
 * 1.1.2.6 e20 bound v := 0, w := c+d x^2, p := 3) — that reading
 * passes EqQ[v,0] and the repl is the integrand verbatim (a self-
 * loop, the .m's $IntMaxSteps -> CannotIntegrate case). The extra
 * is(v # 0) guard rejects the zero-fill reading only; stored bases
 * never carry a literal 0 term, so the rule stays faithful-dead. */
matchdeclare(_mr_9_1_r1_p, freeof(x))$
matchdeclare(_mr_9_1_r1_u, true)$
matchdeclare(_mr_9_1_r1_v, true)$
matchdeclare(_mr_9_1_r1_w, true)$
defmatch(_mr_pat_9_1_r1, _mr_9_1_r1_u*(_mr_9_1_r1_v + _mr_9_1_r1_w)^_mr_9_1_r1_p, x)$
_mr_cond_9_1_r1(mm, x) := block([_mr_9_1_r1_p, _mr_9_1_r1_u, _mr_9_1_r1_v, _mr_9_1_r1_w],
  _mr_9_1_r1_p : geteqR(mm, '_mr_9_1_r1_p), _mr_9_1_r1_u : geteqR(mm, '_mr_9_1_r1_u), _mr_9_1_r1_v : geteqR(mm, '_mr_9_1_r1_v), _mr_9_1_r1_w : geteqR(mm, '_mr_9_1_r1_w),
  freeof(x, _mr_9_1_r1_p)  and  %mr_eqQ(_mr_9_1_r1_v, 0)  and  is(_mr_9_1_r1_v # 0))$
_mr_repl_9_1_r1(mm, x) := block([_mr_9_1_r1_p__s, _mr_9_1_r1_u__s, _mr_9_1_r1_v__s, _mr_9_1_r1_w__s],
  _mr_9_1_r1_p__s : geteqR(mm, '_mr_9_1_r1_p), _mr_9_1_r1_u__s : geteqR(mm, '_mr_9_1_r1_u), _mr_9_1_r1_v__s : geteqR(mm, '_mr_9_1_r1_v), _mr_9_1_r1_w__s : geteqR(mm, '_mr_9_1_r1_w),
  rubi_hybrid(_mr_9_1_r1_u__s*_mr_9_1_r1_w__s^_mr_9_1_r1_p__s, x))$
_mr_rule_9_1_r1(f, x) := block([mm, ok],
  mm : _mr_pat_9_1_r1(f, x),
  if mm = false then return(false),
  if %mr_containsBoolean(mm) then return(false),
  ok : _mr_cond_9_1_r1(mm, x),
  if is(ok) = true then _mr_repl_9_1_r1(mm, x) else false)$

/* L5: (a + b x^n)^p with a=0. The .m's purpose (a stored base with a
 * literal 0 term) is UNREPRESENTABLE in Maxima — a+b*x^n with a=0 is
 * simplified to b*x^n at construction, and a stored 2-term base binds
 * a to a nonzero term (EqQ[a,0] rejects). The only reachable reading
 * is the degenerate atomic-base one — the mirror of the MEASURED
 * 2026-08-27 r3 reading (reverse scan on x^(n-1)/(2e), T4 cascade:
 * the plus pattern vs an ATOMIC base binds a := <base>, b := 0,
 * n := 0; here the slots swap: a := 0, b := <base>, n := 0) — the
 * repl (b x^n)^p is the factor verbatim (a self-loop, the .m's
 * CannotIntegrate case), and it would block the load-bearing native
 * fall-through on mquot sub-integrals the family 0-fires (the
 * factor-order gap; nested dispatches run pass 1 only). The op(+)
 * guard rejects the atomic reading; the rule stays faithful-dead. */
matchdeclare(_mr_9_1_r2_a, freeof(x))$
matchdeclare(_mr_9_1_r2_b, freeof(x))$
matchdeclare(_mr_9_1_r2_n, freeof(x))$
matchdeclare(_mr_9_1_r2_p, freeof(x))$
matchdeclare(_mr_9_1_r2_u, true)$
defmatch(_mr_pat_9_1_r2, _mr_9_1_r2_u*(_mr_9_1_r2_a + _mr_9_1_r2_b*x^_mr_9_1_r2_n)^_mr_9_1_r2_p, x)$
_mr_cond_9_1_r2(mm, x) := block([_mr_9_1_r2_a, _mr_9_1_r2_b, _mr_9_1_r2_n, _mr_9_1_r2_p, _mr_9_1_r2_u],
  _mr_9_1_r2_a : geteqR(mm, '_mr_9_1_r2_a), _mr_9_1_r2_b : geteqR(mm, '_mr_9_1_r2_b), _mr_9_1_r2_n : geteqR(mm, '_mr_9_1_r2_n), _mr_9_1_r2_p : geteqR(mm, '_mr_9_1_r2_p), _mr_9_1_r2_u : geteqR(mm, '_mr_9_1_r2_u),
  freeof(x, _mr_9_1_r2_a) and freeof(x, _mr_9_1_r2_b) and freeof(x, _mr_9_1_r2_n) and freeof(x, _mr_9_1_r2_p)  and  %mr_eqQ(_mr_9_1_r2_a, 0)  and  is(op(_mr_9_1_r2_a + _mr_9_1_r2_b*x^_mr_9_1_r2_n) = "+"))$
_mr_repl_9_1_r2(mm, x) := block([_mr_9_1_r2_a__s, _mr_9_1_r2_b__s, _mr_9_1_r2_n__s, _mr_9_1_r2_p__s, _mr_9_1_r2_u__s],
  _mr_9_1_r2_a__s : geteqR(mm, '_mr_9_1_r2_a), _mr_9_1_r2_b__s : geteqR(mm, '_mr_9_1_r2_b), _mr_9_1_r2_n__s : geteqR(mm, '_mr_9_1_r2_n), _mr_9_1_r2_p__s : geteqR(mm, '_mr_9_1_r2_p), _mr_9_1_r2_u__s : geteqR(mm, '_mr_9_1_r2_u),
  rubi_hybrid(_mr_9_1_r2_u__s*(_mr_9_1_r2_b__s*x^_mr_9_1_r2_n__s)^_mr_9_1_r2_p__s, x))$
_mr_rule_9_1_r2(f, x) := block([mm, ok],
  mm : _mr_pat_9_1_r2(f, x),
  if mm = false then return(false),
  if %mr_containsBoolean(mm) then return(false),
  ok : _mr_cond_9_1_r2(mm, x),
  if is(ok) = true then _mr_repl_9_1_r2(mm, x) else false)$

/* L6: (a + b x^n)^p with b=0. Same analysis as L5 (r2 above): the
 * .m's purpose (a stored base with a literal 0 x-term) is
 * unrepresentable in Maxima; the only reachable reading is the
 * degenerate atomic-base one, MEASURED 2026-08-27 (reverse scan on
 * x^(n-1)/(2e), the 1.4.3 r19 T4-cascade sub-integral): a := e,
 * b := 0, n := 0 (slot a swallows the atomic base, product slot
 * 0-fills) — cond passes, the repl u*a^p is the integrand verbatim
 * (self-loop), and the firing blocks the load-bearing native
 * fall-through. The op(+) guard rejects the atomic reading; the
 * rule stays faithful-dead. */
matchdeclare(_mr_9_1_r3_a, freeof(x))$
matchdeclare(_mr_9_1_r3_b, freeof(x))$
matchdeclare(_mr_9_1_r3_n, freeof(x))$
matchdeclare(_mr_9_1_r3_p, freeof(x))$
matchdeclare(_mr_9_1_r3_u, true)$
defmatch(_mr_pat_9_1_r3, _mr_9_1_r3_u*(_mr_9_1_r3_a + _mr_9_1_r3_b*x^_mr_9_1_r3_n)^_mr_9_1_r3_p, x)$
_mr_cond_9_1_r3(mm, x) := block([_mr_9_1_r3_a, _mr_9_1_r3_b, _mr_9_1_r3_n, _mr_9_1_r3_p, _mr_9_1_r3_u],
  _mr_9_1_r3_a : geteqR(mm, '_mr_9_1_r3_a), _mr_9_1_r3_b : geteqR(mm, '_mr_9_1_r3_b), _mr_9_1_r3_n : geteqR(mm, '_mr_9_1_r3_n), _mr_9_1_r3_p : geteqR(mm, '_mr_9_1_r3_p), _mr_9_1_r3_u : geteqR(mm, '_mr_9_1_r3_u),
  freeof(x, _mr_9_1_r3_a) and freeof(x, _mr_9_1_r3_b) and freeof(x, _mr_9_1_r3_n) and freeof(x, _mr_9_1_r3_p)  and  %mr_eqQ(_mr_9_1_r3_b, 0)  and  is(op(_mr_9_1_r3_a + _mr_9_1_r3_b*x^_mr_9_1_r3_n) = "+"))$
_mr_repl_9_1_r3(mm, x) := block([_mr_9_1_r3_a__s, _mr_9_1_r3_b__s, _mr_9_1_r3_n__s, _mr_9_1_r3_p__s, _mr_9_1_r3_u__s],
  _mr_9_1_r3_a__s : geteqR(mm, '_mr_9_1_r3_a), _mr_9_1_r3_b__s : geteqR(mm, '_mr_9_1_r3_b), _mr_9_1_r3_n__s : geteqR(mm, '_mr_9_1_r3_n), _mr_9_1_r3_p__s : geteqR(mm, '_mr_9_1_r3_p), _mr_9_1_r3_u__s : geteqR(mm, '_mr_9_1_r3_u),
  rubi_hybrid(_mr_9_1_r3_u__s*_mr_9_1_r3_a__s^_mr_9_1_r3_p__s, x))$
_mr_rule_9_1_r3(f, x) := block([mm, ok],
  mm : _mr_pat_9_1_r3(f, x),
  if mm = false then return(false),
  if %mr_containsBoolean(mm) then return(false),
  ok : _mr_cond_9_1_r3(mm, x),
  if is(ok) = true then _mr_repl_9_1_r3(mm, x) else false)$

/* L7: trinomial with a=0, j=2n. Fires on a stored 2-term base via the
 * degenerate 0-fill (measured: (2 x^2 + 3 x)^2 binds a := 0, b := 3,
 * n := 1, c := 2, j := 2) — and then the repl (b x^n + c x^(2n))^p
 * IS the stored integrand: a loop in 2018 Mathematica too (the $Int
 * step budget ends in CannotIntegrate). In the .m world the 1.2.3
 * family rules (loaded earlier, optional-exponent patterns) catch
 * this shape FIRST, so L7's loop is the .m's residue on shapes the
 * family missed. Here the family's equivalent is the pass-3 lift
 * rescan — a terminal (mr_unintegrable OR the .m self-repl seen-guard
 * cycle) would fire in pass 1 and block it. The faithful behavior is
 * therefore to DECLINE: the cascade proceeds to the lift, and if the
 * lifted family still misses, the fall-through noun matches the .m's
 * CannotIntegrate. The cond is kept 1:1 for provenance. */
matchdeclare(_mr_9_1_r4_a, freeof(x))$
matchdeclare(_mr_9_1_r4_b, freeof(x))$
matchdeclare(_mr_9_1_r4_c, freeof(x))$
matchdeclare(_mr_9_1_r4_n, freeof(x))$
matchdeclare(_mr_9_1_r4_p, freeof(x))$
matchdeclare(_mr_9_1_r4_u, true)$
matchdeclare(_mr_9_1_r4_j, true)$
defmatch(_mr_pat_9_1_r4, _mr_9_1_r4_u*(_mr_9_1_r4_a + _mr_9_1_r4_b*x^_mr_9_1_r4_n + _mr_9_1_r4_c*x^_mr_9_1_r4_j)^_mr_9_1_r4_p, x)$
_mr_cond_9_1_r4(mm, x) := block([_mr_9_1_r4_a, _mr_9_1_r4_b, _mr_9_1_r4_c, _mr_9_1_r4_n, _mr_9_1_r4_p, _mr_9_1_r4_u, _mr_9_1_r4_j],
  _mr_9_1_r4_a : geteqR(mm, '_mr_9_1_r4_a), _mr_9_1_r4_b : geteqR(mm, '_mr_9_1_r4_b), _mr_9_1_r4_c : geteqR(mm, '_mr_9_1_r4_c), _mr_9_1_r4_n : geteqR(mm, '_mr_9_1_r4_n), _mr_9_1_r4_p : geteqR(mm, '_mr_9_1_r4_p), _mr_9_1_r4_u : geteqR(mm, '_mr_9_1_r4_u), _mr_9_1_r4_j : geteqR(mm, '_mr_9_1_r4_j),
  freeof(x, _mr_9_1_r4_a) and freeof(x, _mr_9_1_r4_b) and freeof(x, _mr_9_1_r4_c) and freeof(x, _mr_9_1_r4_n) and freeof(x, _mr_9_1_r4_p)  and  %mr_eqQ(_mr_9_1_r4_j, 2*_mr_9_1_r4_n)  and  %mr_eqQ(_mr_9_1_r4_a, 0))$
_mr_rule_9_1_r4(f, x) := block([mm, ok],
  mm : _mr_pat_9_1_r4(f, x),
  if mm = false then return(false),
  if %mr_containsBoolean(mm) then return(false),
  ok : _mr_cond_9_1_r4(mm, x),
  false)$

/* L8: trinomial with b=0, j=2n. The trinomial base pattern vs an
 * ATOMIC base 0-fills the product slots (inferred from the measured
 * binary reading, r3: reverse scan on x^(n-1)/(2e), T4 cascade,
 * binds a := <base>, b := 0, n := 0 — the trinomial extends that to
 * c := 0, j := 0, where EqQ[j,2n] and EqQ[b,0] both pass on 0=0 and
 * the repl u*(a + c x^(2n))^p = u*a^p is the integrand verbatim, a
 * self-loop). Same analysis as L5/L6: the .m's literal-0-term
 * purpose is unrepresentable in Maxima, so the op(+) guard rejects
 * the atomic reading and the rule stays faithful-dead. */
matchdeclare(_mr_9_1_r5_a, freeof(x))$
matchdeclare(_mr_9_1_r5_b, freeof(x))$
matchdeclare(_mr_9_1_r5_c, freeof(x))$
matchdeclare(_mr_9_1_r5_n, freeof(x))$
matchdeclare(_mr_9_1_r5_p, freeof(x))$
matchdeclare(_mr_9_1_r5_u, true)$
matchdeclare(_mr_9_1_r5_j, true)$
defmatch(_mr_pat_9_1_r5, _mr_9_1_r5_u*(_mr_9_1_r5_a + _mr_9_1_r5_b*x^_mr_9_1_r5_n + _mr_9_1_r5_c*x^_mr_9_1_r5_j)^_mr_9_1_r5_p, x)$
_mr_cond_9_1_r5(mm, x) := block([_mr_9_1_r5_a, _mr_9_1_r5_b, _mr_9_1_r5_c, _mr_9_1_r5_n, _mr_9_1_r5_p, _mr_9_1_r5_u, _mr_9_1_r5_j],
  _mr_9_1_r5_a : geteqR(mm, '_mr_9_1_r5_a), _mr_9_1_r5_b : geteqR(mm, '_mr_9_1_r5_b), _mr_9_1_r5_c : geteqR(mm, '_mr_9_1_r5_c), _mr_9_1_r5_n : geteqR(mm, '_mr_9_1_r5_n), _mr_9_1_r5_p : geteqR(mm, '_mr_9_1_r5_p), _mr_9_1_r5_u : geteqR(mm, '_mr_9_1_r5_u), _mr_9_1_r5_j : geteqR(mm, '_mr_9_1_r5_j),
  freeof(x, _mr_9_1_r5_a) and freeof(x, _mr_9_1_r5_b) and freeof(x, _mr_9_1_r5_c) and freeof(x, _mr_9_1_r5_n) and freeof(x, _mr_9_1_r5_p)  and  %mr_eqQ(_mr_9_1_r5_j, 2*_mr_9_1_r5_n)  and  %mr_eqQ(_mr_9_1_r5_b, 0)  and  is(op(_mr_9_1_r5_a + _mr_9_1_r5_b*x^_mr_9_1_r5_n + _mr_9_1_r5_c*x^_mr_9_1_r5_j) = "+"))$
_mr_repl_9_1_r5(mm, x) := block([_mr_9_1_r5_a__s, _mr_9_1_r5_b__s, _mr_9_1_r5_c__s, _mr_9_1_r5_n__s, _mr_9_1_r5_p__s, _mr_9_1_r5_u__s, _mr_9_1_r5_j__s],
  _mr_9_1_r5_a__s : geteqR(mm, '_mr_9_1_r5_a), _mr_9_1_r5_b__s : geteqR(mm, '_mr_9_1_r5_b), _mr_9_1_r5_c__s : geteqR(mm, '_mr_9_1_r5_c), _mr_9_1_r5_n__s : geteqR(mm, '_mr_9_1_r5_n), _mr_9_1_r5_p__s : geteqR(mm, '_mr_9_1_r5_p), _mr_9_1_r5_u__s : geteqR(mm, '_mr_9_1_r5_u), _mr_9_1_r5_j__s : geteqR(mm, '_mr_9_1_r5_j),
  rubi_hybrid(_mr_9_1_r5_u__s*(_mr_9_1_r5_a__s + _mr_9_1_r5_c__s*x^(2*_mr_9_1_r5_n__s))^_mr_9_1_r5_p__s, x))$
_mr_rule_9_1_r5(f, x) := block([mm, ok],
  mm : _mr_pat_9_1_r5(f, x),
  if mm = false then return(false),
  if %mr_containsBoolean(mm) then return(false),
  ok : _mr_cond_9_1_r5(mm, x),
  if is(ok) = true then _mr_repl_9_1_r5(mm, x) else false)$

/* L9: trinomial with c=0, j=2n — same atomic-base 0-fill mechanism
 * as L8 (r5 above); the op(+) guard is applied identically. */
matchdeclare(_mr_9_1_r6_a, freeof(x))$
matchdeclare(_mr_9_1_r6_b, freeof(x))$
matchdeclare(_mr_9_1_r6_c, freeof(x))$
matchdeclare(_mr_9_1_r6_n, freeof(x))$
matchdeclare(_mr_9_1_r6_p, freeof(x))$
matchdeclare(_mr_9_1_r6_u, true)$
matchdeclare(_mr_9_1_r6_j, true)$
defmatch(_mr_pat_9_1_r6, _mr_9_1_r6_u*(_mr_9_1_r6_a + _mr_9_1_r6_b*x^_mr_9_1_r6_n + _mr_9_1_r6_c*x^_mr_9_1_r6_j)^_mr_9_1_r6_p, x)$
_mr_cond_9_1_r6(mm, x) := block([_mr_9_1_r6_a, _mr_9_1_r6_b, _mr_9_1_r6_c, _mr_9_1_r6_n, _mr_9_1_r6_p, _mr_9_1_r6_u, _mr_9_1_r6_j],
  _mr_9_1_r6_a : geteqR(mm, '_mr_9_1_r6_a), _mr_9_1_r6_b : geteqR(mm, '_mr_9_1_r6_b), _mr_9_1_r6_c : geteqR(mm, '_mr_9_1_r6_c), _mr_9_1_r6_n : geteqR(mm, '_mr_9_1_r6_n), _mr_9_1_r6_p : geteqR(mm, '_mr_9_1_r6_p), _mr_9_1_r6_u : geteqR(mm, '_mr_9_1_r6_u), _mr_9_1_r6_j : geteqR(mm, '_mr_9_1_r6_j),
  freeof(x, _mr_9_1_r6_a) and freeof(x, _mr_9_1_r6_b) and freeof(x, _mr_9_1_r6_c) and freeof(x, _mr_9_1_r6_n) and freeof(x, _mr_9_1_r6_p)  and  %mr_eqQ(_mr_9_1_r6_j, 2*_mr_9_1_r6_n)  and  %mr_eqQ(_mr_9_1_r6_c, 0)  and  is(op(_mr_9_1_r6_a + _mr_9_1_r6_b*x^_mr_9_1_r6_n + _mr_9_1_r6_c*x^_mr_9_1_r6_j) = "+"))$
_mr_repl_9_1_r6(mm, x) := block([_mr_9_1_r6_a__s, _mr_9_1_r6_b__s, _mr_9_1_r6_c__s, _mr_9_1_r6_n__s, _mr_9_1_r6_p__s, _mr_9_1_r6_u__s, _mr_9_1_r6_j__s],
  _mr_9_1_r6_a__s : geteqR(mm, '_mr_9_1_r6_a), _mr_9_1_r6_b__s : geteqR(mm, '_mr_9_1_r6_b), _mr_9_1_r6_c__s : geteqR(mm, '_mr_9_1_r6_c), _mr_9_1_r6_n__s : geteqR(mm, '_mr_9_1_r6_n), _mr_9_1_r6_p__s : geteqR(mm, '_mr_9_1_r6_p), _mr_9_1_r6_u__s : geteqR(mm, '_mr_9_1_r6_u), _mr_9_1_r6_j__s : geteqR(mm, '_mr_9_1_r6_j),
  rubi_hybrid(_mr_9_1_r6_u__s*(_mr_9_1_r6_a__s + _mr_9_1_r6_b__s*x^_mr_9_1_r6_n__s)^_mr_9_1_r6_p__s, x))$
