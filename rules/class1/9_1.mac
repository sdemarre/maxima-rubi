/* L13: const x linear — the sum slot forces the clean binding
 * (measured: on 5*(a+b*x), a := 5, b := a, c := b). */
matchdeclare(_mr_9_1_r10_a, freeof(x))$
matchdeclare(_mr_9_1_r10_b, freeof(x))$
matchdeclare(_mr_9_1_r10_c, freeof(x))$
defmatch(_mr_pat_9_1_r10, _mr_9_1_r10_a*(_mr_9_1_r10_b + _mr_9_1_r10_c*x), x)$
