_mr_repl_9_1_r28(mm, x) := block([_mr_9_1_r28_a__s, _mr_9_1_r28_b__s, _mr_9_1_r28_c__s, _mr_9_1_r28_u__s, _mr_9_1_r28_p__s],
  _mr_9_1_r28_a__s : geteqR(mm, '_mr_9_1_r28_a), _mr_9_1_r28_b__s : geteqR(mm, '_mr_9_1_r28_b), _mr_9_1_r28_c__s : geteqR(mm, '_mr_9_1_r28_c), _mr_9_1_r28_u__s : geteqR(mm, '_mr_9_1_r28_u), _mr_9_1_r28_p__s : geteqR(mm, '_mr_9_1_r28_p),
  rubi_hybrid_exact(_mr_9_1_r28_u__s*%mr_cancel((_mr_9_1_r28_b__s/2 + _mr_9_1_r28_c__s*x)^(2*_mr_9_1_r28_p__s)/_mr_9_1_r28_c__s^_mr_9_1_r28_p__s), x))$
_mr_rule_9_1_r28(f, x) := block([mm, ok],
  mm : _mr_pat_9_1_r28(f, x),
  if mm = false then return(false),
  if %mr_containsBoolean(mm) then return(false),
  ok : _mr_cond_9_1_r28(mm, x),
  if is(ok) = true then _mr_repl_9_1_r28(mm, x) else false)$

