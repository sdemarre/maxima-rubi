/* Full table load (Rubi.m LoadRules order): class 1 (the 73-term
   flatten above) then class 2 — the first $LoadElementaryFunctionRules
   block (3 files, 125 rules; measured 2026-08-28) then class 3 — the
   "3 Logarithms" LoadRules block (11 files, 333 rules; Rubi.m
   :211-221 order, verified against the pinned clone 2026-08-29 —
   3.3 and 3.4 load BEFORE the 3.2.x files: that is Rubi's LoadRules
   order, not numeric order). The table is the 3-class load: the
   87-term flatten (3,513 rules). MR: the driver and the rules core
   call this; Layer A still loads only the 1.1.1.1 core file above (the
   defmatch budget of a plain process holds a handful of rules — see
   the load-wall note above). */
mr_load_all() := block([],
  mr_load_class1_all(),
  %mr_load_sibling("rules/class2/2_1.mac", 'mr_witness_2_1),
  %mr_load_sibling("rules/class2/2_2.mac", 'mr_witness_2_2),
  %mr_load_sibling("rules/class2/2_3.mac", 'mr_witness_2_3),
  mr_rule_table : flatten([mr_rule_table, mr_rules_2_1,
                           mr_rules_2_2, mr_rules_2_3]),
  %mr_load_sibling("rules/class3/3_1_1.mac", 'mr_witness_3_1_1),
  %mr_load_sibling("rules/class3/3_1_2.mac", 'mr_witness_3_1_2),
  %mr_load_sibling("rules/class3/3_1_3.mac", 'mr_witness_3_1_3),
  %mr_load_sibling("rules/class3/3_1_4.mac", 'mr_witness_3_1_4),
  %mr_load_sibling("rules/class3/3_1_5.mac", 'mr_witness_3_1_5),
  %mr_load_sibling("rules/class3/3_3.mac", 'mr_witness_3_3),
  %mr_load_sibling("rules/class3/3_4.mac", 'mr_witness_3_4),
  %mr_load_sibling("rules/class3/3_2_1.mac", 'mr_witness_3_2_1),
  %mr_load_sibling("rules/class3/3_2_2.mac", 'mr_witness_3_2_2),
  %mr_load_sibling("rules/class3/3_2_3.mac", 'mr_witness_3_2_3),
  %mr_load_sibling("rules/class3/3_5.mac", 'mr_witness_3_5),
  mr_rule_table : flatten([mr_rule_table, mr_rules_3_1_1,
                           mr_rules_3_1_2, mr_rules_3_1_3, mr_rules_3_1_4,
                           mr_rules_3_1_5, mr_rules_3_3, mr_rules_3_4,
                           mr_rules_3_2_1, mr_rules_3_2_2, mr_rules_3_2_3,
                           mr_rules_3_5])
)$

mr_witness_maxima_rubi() := true$
