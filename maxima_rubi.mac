  %mr_load_sibling("rules/class1/1_2_4_4.mac", 'mr_witness_1_2_4_4),
  %mr_load_sibling("rules/class1/1_4_1.mac", 'mr_witness_1_4_1),
  %mr_load_sibling("rules/class1/1_4_2.mac", 'mr_witness_1_4_2),
  %mr_load_sibling("rules/class1/1_1_1_7.mac", 'mr_witness_1_1_1_7),
  %mr_load_sibling("rules/class1/1_1_1_6.mac", 'mr_witness_1_1_1_6),
  %mr_load_sibling("rules/class1/1_1_1_5.mac", 'mr_witness_1_1_1_5),
  %mr_load_sibling("rules/class1/1_2_1_9.mac", 'mr_witness_1_2_1_9),
  %mr_load_sibling("rules/class1/1_2_1_9b.mac", 'mr_witness_1_2_1_9b),
  %mr_load_sibling("rules/class1/1_2_1_8.mac", 'mr_witness_1_2_1_8),
  %mr_load_sibling("rules/class1/1_2_1_7.mac", 'mr_witness_1_2_1_7),
  %mr_load_sibling("rules/class1/1_2_1_6.mac", 'mr_witness_1_2_1_6),
  %mr_load_sibling("rules/class1/1_2_1_6b.mac", 'mr_witness_1_2_1_6b),
