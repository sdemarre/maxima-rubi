  %mr_load_sibling("rules/class1/1_1_2_2.mac", 'mr_witness_1_1_2_2),
  %mr_load_sibling("rules/class1/1_1_2_3.mac", 'mr_witness_1_1_2_3),
  %mr_load_sibling("rules/class1/1_1_2_4.mac", 'mr_witness_1_1_2_4),
  %mr_load_sibling("rules/class1/1_1_2_5.mac", 'mr_witness_1_1_2_5),
  %mr_load_sibling("rules/class1/1_1_2_6.mac", 'mr_witness_1_1_2_6),
  %mr_load_sibling("rules/class1/1_1_2_7.mac", 'mr_witness_1_1_2_7),
  %mr_load_sibling("rules/class1/1_1_2_8.mac", 'mr_witness_1_1_2_8),
  %mr_load_sibling("rules/class1/1_1_2_9.mac", 'mr_witness_1_1_2_9),
  %mr_load_sibling("rules/class1/1_1_3_1.mac", 'mr_witness_1_1_3_1),
  %mr_load_sibling("rules/class1/1_1_3_2.mac", 'mr_witness_1_1_3_2),
  %mr_load_sibling("rules/class1/1_1_3_3.mac", 'mr_witness_1_1_3_3),
  %mr_load_sibling("rules/class1/1_1_3_4.mac", 'mr_witness_1_1_3_4),
  %mr_load_sibling("rules/class1/1_1_3_5.mac", 'mr_witness_1_1_3_5),
  %mr_load_sibling("rules/class1/1_1_3_6.mac", 'mr_witness_1_1_3_6),
  %mr_load_sibling("rules/class1/1_2_1_1.mac", 'mr_witness_1_2_1_1),
  %mr_load_sibling("rules/class1/1_2_1_2.mac", 'mr_witness_1_2_1_2),
  %mr_load_sibling("rules/class1/1_2_1_3.mac", 'mr_witness_1_2_1_3),
  %mr_load_sibling("rules/class1/1_2_1_3b.mac", 'mr_witness_1_2_1_3b),
  %mr_load_sibling("rules/class1/1_2_1_4.mac", 'mr_witness_1_2_1_4),
  %mr_load_sibling("rules/class1/1_2_1_4b.mac", 'mr_witness_1_2_1_4b),
  %mr_load_sibling("rules/class1/1_2_1_5.mac", 'mr_witness_1_2_1_5),
  %mr_load_sibling("rules/class1/1_2_1_5b.mac", 'mr_witness_1_2_1_5b),
  %mr_load_sibling("rules/class1/1_2_2_1.mac", 'mr_witness_1_2_2_1),
  %mr_load_sibling("rules/class1/1_2_2_2.mac", 'mr_witness_1_2_2_2),
  %mr_load_sibling("rules/class1/1_2_2_3.mac", 'mr_witness_1_2_2_3),
  %mr_load_sibling("rules/class1/1_2_2_4.mac", 'mr_witness_1_2_2_4),
  %mr_load_sibling("rules/class1/1_2_3_1.mac", 'mr_witness_1_2_3_1),
  %mr_load_sibling("rules/class1/1_2_3_2.mac", 'mr_witness_1_2_3_2),
  %mr_load_sibling("rules/class1/1_2_3_3.mac", 'mr_witness_1_2_3_3),
