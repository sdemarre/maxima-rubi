  %mr_load_sibling("rules/class1/1_1_2_13.mac", 'mr_witness_1_1_2_13),
  %mr_load_sibling("rules/class1/1_1_2_12.mac", 'mr_witness_1_1_2_12),
  %mr_load_sibling("rules/class1/1_1_3_8.mac", 'mr_witness_1_1_3_8),
  %mr_load_sibling("rules/class1/1_1_3_7.mac", 'mr_witness_1_1_3_7),
  %mr_load_sibling("rules/class1/1_1_4_4.mac", 'mr_witness_1_1_4_4),
  %mr_load_sibling("rules/class1/1_3_3.mac", 'mr_witness_1_3_3),
  %mr_load_sibling("rules/class1/1_3_1.mac", 'mr_witness_1_3_1),
  %mr_load_sibling("rules/class1/1_3_2.mac", 'mr_witness_1_3_2),
  %mr_load_sibling("rules/class1/1_3_4.mac", 'mr_witness_1_3_4),
  %mr_load_sibling("rules/class1/1_4_3.mac", 'mr_witness_1_4_3),
  %mr_load_sibling("rules/class1/9_1.mac", 'mr_witness_9_1),
   mr_rule_table : flatten([mr_rules_1_1_1_1, mr_rules_1_1_1_2, mr_rules_1_1_1_3, mr_rules_1_1_1_4, mr_rules_1_1_2_1, mr_rules_1_1_2_2, mr_rules_1_1_2_3, mr_rules_1_1_2_4, mr_rules_1_1_2_5, mr_rules_1_1_2_6, mr_rules_1_1_2_7, mr_rules_1_1_2_8, mr_rules_1_1_2_9, mr_rules_1_1_3_1, mr_rules_1_1_3_2, mr_rules_1_1_3_3, mr_rules_1_1_3_4, mr_rules_1_1_3_5, mr_rules_1_1_3_6, mr_rules_1_2_1_1, mr_rules_1_2_1_2, mr_rules_1_2_1_3, mr_rules_1_2_1_3b, mr_rules_1_2_1_4, mr_rules_1_2_1_4b, mr_rules_1_2_1_5, mr_rules_1_2_1_5b, mr_rules_1_2_2_1, mr_rules_1_2_2_2, mr_rules_1_2_2_3, mr_rules_1_2_2_4, mr_rules_1_2_3_1, mr_rules_1_2_3_2, mr_rules_1_2_3_3, mr_rules_1_2_3_4, mr_rules_1_1_4_1, mr_rules_1_1_4_2, mr_rules_1_1_4_3, mr_rules_1_2_4_1, mr_rules_1_2_4_2, mr_rules_1_2_4_3, mr_rules_1_2_4_4, mr_rules_1_4_1, mr_rules_1_4_2, mr_rules_1_1_1_7, mr_rules_1_1_1_6, mr_rules_1_1_1_5, mr_rules_1_2_1_9, mr_rules_1_2_1_9b, mr_rules_1_2_1_8, mr_rules_1_2_1_7, mr_rules_1_2_1_6, mr_rules_1_2_1_6b, mr_rules_1_2_2_6, mr_rules_1_2_2_5, mr_rules_1_2_2_7, mr_rules_1_2_2_8, mr_rules_1_2_3_6, mr_rules_1_2_3_5, mr_rules_1_1_2_11, mr_rules_1_1_2_10, mr_rules_1_1_2_14, mr_rules_1_1_2_13, mr_rules_1_1_2_12, mr_rules_1_1_3_8, mr_rules_1_1_3_7, mr_rules_1_1_4_4, mr_rules_1_3_3, mr_rules_1_3_1, mr_rules_1_3_2, mr_rules_1_3_4, mr_rules_1_4_3, mr_rules_9_1])
)$

/* Full table load (Rubi.m LoadRules order): class 1 (the 73-term
   flatten above, 9.1 included as its last list) then 9.2 (19 rules,
   Rubi.m L204, section-9 spec 3.2) then class 2 — the first
   $LoadElementaryFunctionRules block (3 files, 125 rules; measured
   2026-08-28) then class 3 — the "3 Logarithms" LoadRules block (11
   files, 334 rules; Rubi.m :211-221 order, verified against the pinned
   clone 2026-08-29 — 3.3 and 3.4 load BEFORE the 3.2.x files: that is
   Rubi's LoadRules order, not numeric order) then class 4 (2,080 rules,
   Rubi.m L223-281: 2,070 body + 10 tail) then class 5 (667 rules,
   Rubi.m L283-299) then class 6 (390 rules) then
   class 7 (712 rules, Rubi.m L318-341) then
   class 8 and 9.1 Derivative (307 + 21 rules; 8.9 r44 in the tail) then
   9.3 last (67 rules: 56 body + 11 tail, Rubi.m L356, section-9 spec
   A3). The table is the full load: 7,776 rules (measured 2026-09-25,
   test/test_rule_table_order.mac prints length(mr_rule_table) after
   mr_load_all(); 5,704 before class 4's body + its 2,072 -- the 2,080
   rules less the 8 bridge records already counted; 4,992 before class 7 + its 712; 4,325 before class 5 +
   its 667; 3,997 before class 8 +
   its 328). The 3,997 was 3,513
   classes 1-3 +
   390 class 6 + 8 class-4 bridge + 19 9.2 + 67 9.3; each term measured
   2026-09-22 against the loaded lists directly -- 3,513 is
   length(mr_rule_table) after class 1 (via mr_load_class1_all(), 3,054,
   9.1 included) plus class 2's 125 plus class 3's 334; 8 is
   length(mr_rules_4_1_0_1_tail) + length(mr_rules_4_7_5_tail) (both
   bodies are empty); 67 is length(mr_rules_9_3) (56 body) +
   length(mr_rules_9_3_tail) (11); the whole total is
   length(mr_rule_table) after mr_load_all() -- rather than carried over
   from an earlier comment, which is how this paragraph's previous
   class-4 term (6, one Task short of the real 8) went stale). The
   driver and the rules core call this; Layer A loads the 1.1.1.1 core
   file above and the sibling files its sections pin. */
mr_load_all() := block([],
  /* The inert-trig rewrite tables (inert-trig substrate design 3.2) load
     FIRST: nothing in the file is an Int rule, and the utilities it backs
     must exist before a rule body calls them. */
  %mr_load_sibling("rules/utils/inert_trig_rewrites.mac",
                   'mr_witness_inert_trig_rewrites),
  mr_load_class1_all(),
  /* 9.2 Piecewise linear functions (19): Rubi.m L204 loads it right
     after class 1 and before the $LoadElementaryFunctionRules block,
     ALWAYS (section-9 spec 3.2). */
  %mr_load_sibling("rules/class9/9_2.mac", 'mr_witness_9_2),
  mr_rule_table : flatten([mr_rule_table, mr_rules_9_2]),
  %mr_load_sibling("rules/class2/2_1.mac", 'mr_witness_2_1),
  %mr_load_sibling("rules/class2/2_2.mac", 'mr_witness_2_2),
  %mr_load_sibling("rules/class2/2_3.mac", 'mr_witness_2_3),
  mr_rule_table : flatten([mr_rule_table, mr_rules_2_1,
                           mr_rules_2_2, mr_rules_2_3]),
  %mr_load_sibling("rules/class3/3_1_1.mac", 'mr_witness_3_1_1),
  %mr_load_sibling("rules/class3/3_1_2.mac", 'mr_witness_3_1_2),
  %mr_load_sibling("rules/class3/3_1_3.mac", 'mr_witness_3_1_3),
  %mr_load_sibling("rules/class3/3_1_4.mac", 'mr_witness_3_1_4),
  %mr_load_sibling("rules/class3/3_1_5.mac", 'mr_witness_3_1_5),
  %mr_load_sibling("rules/class3/3_3.mac", 'mr_witness_3_3),
  %mr_load_sibling("rules/class3/3_4.mac", 'mr_witness_3_4),
  %mr_load_sibling("rules/class3/3_2_1.mac", 'mr_witness_3_2_1),
  %mr_load_sibling("rules/class3/3_2_2.mac", 'mr_witness_3_2_2),
  %mr_load_sibling("rules/class3/3_2_3.mac", 'mr_witness_3_2_3),
  %mr_load_sibling("rules/class3/3_5.mac", 'mr_witness_3_5),
  mr_rule_table : flatten([mr_rule_table, mr_rules_3_1_1,
                           mr_rules_3_1_2, mr_rules_3_1_3, mr_rules_3_1_4,
                           mr_rules_3_1_5, mr_rules_3_3, mr_rules_3_4,
                           mr_rules_3_2_1, mr_rules_3_2_2, mr_rules_3_2_3,
                           mr_rules_3_5]),
  /* class 4 (trig), 2,080 rules over 56 files (4.1 Sine, 4.3 Tangent, 4.5
     Secant, 4.7 Miscellaneous; Rubi.m L223-281, the "4 " LoadRules block)
     -- Rubi.m LoadRules order is rule PRIORITY: section 4 loads after
     section 3 and before sections 5 and 6 (.scratch/class-ports/issues/05,
     the inert-trig substrate's carried item). Its ten bare-u_ records --
     4.1.0.1 r1 (the DeactivateTrig bridge) and 4.7.5 r21/r22/r47/r48/r58/
     r66/r70/r71/r72 -- are in the two files' _tail lists, named in the tail
     flatten below; every other class-4 record is a body record here. */
  %mr_load_sibling("rules/class4/4_1_0_1.mac", 'mr_witness_4_1_0_1),
  %mr_load_sibling("rules/class4/4_1_0_2.mac", 'mr_witness_4_1_0_2),
