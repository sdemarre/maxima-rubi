  %mr_load_sibling("rules/class1/1_1_3_5.mac", 'mr_witness_1_1_3_5),
  %mr_load_sibling("rules/class1/1_1_3_6.mac", 'mr_witness_1_1_3_6),
  %mr_load_sibling("rules/class1/1_2_1_1.mac", 'mr_witness_1_2_1_1),
  %mr_load_sibling("rules/class1/1_2_1_2.mac", 'mr_witness_1_2_1_2),
