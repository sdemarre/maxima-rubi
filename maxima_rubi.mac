  %mr_load_sibling("rules/class4/4_7_9.mac", 'mr_witness_4_7_9),
  mr_rule_table : flatten([mr_rule_table, mr_rules_4_1_0_1, mr_rules_4_1_0_2,
                           mr_rules_4_1_0_3, mr_rules_4_1_1_1,
                           mr_rules_4_1_1_2, mr_rules_4_1_1_3,
                           mr_rules_4_1_2_1, mr_rules_4_1_2_2,
                           mr_rules_4_1_2_3, mr_rules_4_1_3_1,
                           mr_rules_4_1_4_1, mr_rules_4_1_4_2,
                           mr_rules_4_1_5, mr_rules_4_1_6, mr_rules_4_1_7,
                           mr_rules_4_1_8, mr_rules_4_1_9, mr_rules_4_1_10,
                           mr_rules_4_1_11, mr_rules_4_1_12,
                           mr_rules_4_1_13, mr_rules_4_3_1_1,
                           mr_rules_4_3_1_2, mr_rules_4_3_1_3,
                           mr_rules_4_3_2_1, mr_rules_4_3_2_3,
                           mr_rules_4_3_3_1, mr_rules_4_3_4_1,
                           mr_rules_4_3_4_2, mr_rules_4_3_7, mr_rules_4_3_9,
                           mr_rules_4_3_10, mr_rules_4_3_11,
                           mr_rules_4_3_12, mr_rules_4_5_1_1,
                           mr_rules_4_5_1_2, mr_rules_4_5_1_3,
                           mr_rules_4_5_1_4, mr_rules_4_5_2_1,
                           mr_rules_4_5_2_2, mr_rules_4_5_3_1,
                           mr_rules_4_5_4_1, mr_rules_4_5_4_2,
                           mr_rules_4_5_7, mr_rules_4_5_9, mr_rules_4_5_10,
                           mr_rules_4_5_11, mr_rules_4_7_1, mr_rules_4_7_2,
                           mr_rules_4_7_3, mr_rules_4_7_4, mr_rules_4_7_5,
                           mr_rules_4_7_6, mr_rules_4_7_7, mr_rules_4_7_8,
                           mr_rules_4_7_9]),
  /* class 5 (inverse trig), 667 rules over 15 files (5.1 Inverse sine,
     5.3 Inverse tangent, 5.5 Inverse secant; Rubi.m L283-299) — Rubi.m
     LoadRules order is rule PRIORITY: section 5 loads after section 4 and
     before section 6, so class 5's bodies follow class 4's and precede
     class 6's. Class 5 has no bare-u_ record, so no _tail list. */
  %mr_load_sibling("rules/class5/5_1_1.mac", 'mr_witness_5_1_1),
  %mr_load_sibling("rules/class5/5_1_2.mac", 'mr_witness_5_1_2),
  %mr_load_sibling("rules/class5/5_1_3.mac", 'mr_witness_5_1_3),
  %mr_load_sibling("rules/class5/5_1_4.mac", 'mr_witness_5_1_4),
  %mr_load_sibling("rules/class5/5_1_5.mac", 'mr_witness_5_1_5),
  %mr_load_sibling("rules/class5/5_1_6.mac", 'mr_witness_5_1_6),
  %mr_load_sibling("rules/class5/5_3_1.mac", 'mr_witness_5_3_1),
  %mr_load_sibling("rules/class5/5_3_2.mac", 'mr_witness_5_3_2),
  %mr_load_sibling("rules/class5/5_3_3.mac", 'mr_witness_5_3_3),
  %mr_load_sibling("rules/class5/5_3_4.mac", 'mr_witness_5_3_4),
  %mr_load_sibling("rules/class5/5_3_5.mac", 'mr_witness_5_3_5),
  %mr_load_sibling("rules/class5/5_3_6.mac", 'mr_witness_5_3_6),
  %mr_load_sibling("rules/class5/5_3_7.mac", 'mr_witness_5_3_7),
  %mr_load_sibling("rules/class5/5_5_1.mac", 'mr_witness_5_5_1),
  %mr_load_sibling("rules/class5/5_5_2.mac", 'mr_witness_5_5_2),
  mr_rule_table : flatten([mr_rule_table, mr_rules_5_1_1, mr_rules_5_1_2,
                           mr_rules_5_1_3, mr_rules_5_1_4, mr_rules_5_1_5,
                           mr_rules_5_1_6, mr_rules_5_3_1, mr_rules_5_3_2,
                           mr_rules_5_3_3, mr_rules_5_3_4, mr_rules_5_3_5,
                           mr_rules_5_3_6, mr_rules_5_3_7, mr_rules_5_5_1,
                           mr_rules_5_5_2]),
  /* class 6 (hyperbolic), 390 rules over 13 files — Rubi.m LoadRules
     order, which is rule PRIORITY: it loads after all of classes 1-5,
     exactly as class 2 loads after class 1. */
  %mr_load_sibling("rules/class6/6_1_10.mac", 'mr_witness_6_1_10),
  %mr_load_sibling("rules/class6/6_1_11.mac", 'mr_witness_6_1_11),
  %mr_load_sibling("rules/class6/6_1_12.mac", 'mr_witness_6_1_12),
  %mr_load_sibling("rules/class6/6_1_13.mac", 'mr_witness_6_1_13),
  %mr_load_sibling("rules/class6/6_3_10.mac", 'mr_witness_6_3_10),
  %mr_load_sibling("rules/class6/6_3_11.mac", 'mr_witness_6_3_11),
  %mr_load_sibling("rules/class6/6_3_12.mac", 'mr_witness_6_3_12),
  %mr_load_sibling("rules/class6/6_5_10.mac", 'mr_witness_6_5_10),
  %mr_load_sibling("rules/class6/6_5_11.mac", 'mr_witness_6_5_11),
  %mr_load_sibling("rules/class6/6_7_6.mac", 'mr_witness_6_7_6),
  %mr_load_sibling("rules/class6/6_7_7.mac", 'mr_witness_6_7_7),
  %mr_load_sibling("rules/class6/6_7_8.mac", 'mr_witness_6_7_8),
  %mr_load_sibling("rules/class6/6_7_9.mac", 'mr_witness_6_7_9),
  mr_rule_table : flatten([mr_rule_table, mr_rules_6_1_10,
                           mr_rules_6_1_11, mr_rules_6_1_12, mr_rules_6_1_13,
                           mr_rules_6_3_10, mr_rules_6_3_11, mr_rules_6_3_12,
                           mr_rules_6_5_10, mr_rules_6_5_11, mr_rules_6_7_6,
                           mr_rules_6_7_7, mr_rules_6_7_8, mr_rules_6_7_9]),
  /* class 7 (inverse hyperbolic), 712 rules over 21 files (7.1 Inverse
     hyperbolic sine, 7.2 cosine, 7.3 tangent, 7.5 secant; Rubi.m L318-341;
     the four .m files of 7.3's tree that Rubi.m does not load are not
     generated, .scratch/class-ports/issues/04) — Rubi.m LoadRules order
     is rule PRIORITY: section 7 loads after section 6 and before section 8.
     Class 7's bodies follow class 6's directly and precede class 8's.
     Class 7 has no bare-u_ record, so no _tail list. */
  %mr_load_sibling("rules/class7/7_1_1.mac", 'mr_witness_7_1_1),
  %mr_load_sibling("rules/class7/7_1_2.mac", 'mr_witness_7_1_2),
  %mr_load_sibling("rules/class7/7_1_3.mac", 'mr_witness_7_1_3),
  %mr_load_sibling("rules/class7/7_1_4.mac", 'mr_witness_7_1_4),
  %mr_load_sibling("rules/class7/7_1_5.mac", 'mr_witness_7_1_5),
  %mr_load_sibling("rules/class7/7_1_6.mac", 'mr_witness_7_1_6),
  %mr_load_sibling("rules/class7/7_2_1.mac", 'mr_witness_7_2_1),
  %mr_load_sibling("rules/class7/7_2_2.mac", 'mr_witness_7_2_2),
  %mr_load_sibling("rules/class7/7_2_3.mac", 'mr_witness_7_2_3),
  %mr_load_sibling("rules/class7/7_2_4.mac", 'mr_witness_7_2_4),
  %mr_load_sibling("rules/class7/7_2_5.mac", 'mr_witness_7_2_5),
  %mr_load_sibling("rules/class7/7_2_6.mac", 'mr_witness_7_2_6),
  %mr_load_sibling("rules/class7/7_3_1.mac", 'mr_witness_7_3_1),
  %mr_load_sibling("rules/class7/7_3_2.mac", 'mr_witness_7_3_2),
  %mr_load_sibling("rules/class7/7_3_3.mac", 'mr_witness_7_3_3),
  %mr_load_sibling("rules/class7/7_3_4.mac", 'mr_witness_7_3_4),
  %mr_load_sibling("rules/class7/7_3_5.mac", 'mr_witness_7_3_5),
  %mr_load_sibling("rules/class7/7_3_6.mac", 'mr_witness_7_3_6),
  %mr_load_sibling("rules/class7/7_3_7.mac", 'mr_witness_7_3_7),
  %mr_load_sibling("rules/class7/7_5_1.mac", 'mr_witness_7_5_1),
  %mr_load_sibling("rules/class7/7_5_2.mac", 'mr_witness_7_5_2),
  mr_rule_table : flatten([mr_rule_table, mr_rules_7_1_1, mr_rules_7_1_2,
                           mr_rules_7_1_3, mr_rules_7_1_4, mr_rules_7_1_5,
                           mr_rules_7_1_6, mr_rules_7_2_1, mr_rules_7_2_2,
                           mr_rules_7_2_3, mr_rules_7_2_4, mr_rules_7_2_5,
                           mr_rules_7_2_6, mr_rules_7_3_1, mr_rules_7_3_2,
                           mr_rules_7_3_3, mr_rules_7_3_4, mr_rules_7_3_5,
                           mr_rules_7_3_6, mr_rules_7_3_7, mr_rules_7_5_1,
                           mr_rules_7_5_2]),
  /* class 8 (special functions), 307 rules over 9 files (8.10 Bessel is
     commented out of Rubi.m's LoadRules, L352), then 9.1 Derivative
     integration rules (21, Rubi.m L354: the last file of the
     $LoadElementaryFunctionRules block, right after class 8; generated
     with class 8 under the key 9_1d, since the legacy class-1 file owns
     9_1). Rubi.m LoadRules order is rule PRIORITY: sections 4-7 come
     before 8, and all four are ported, so class 8 follows them; 9.3's
     body stays last (spec A3).
     8.9's bare-u_ record (r44, the ProductLog Subst) is in
     mr_rules_8_9_tail, named in the tail flatten below. */
  %mr_load_sibling("rules/class8/8_1.mac", 'mr_witness_8_1),
  %mr_load_sibling("rules/class8/8_2.mac", 'mr_witness_8_2),
  %mr_load_sibling("rules/class8/8_3.mac", 'mr_witness_8_3),
  %mr_load_sibling("rules/class8/8_4.mac", 'mr_witness_8_4),
  %mr_load_sibling("rules/class8/8_5.mac", 'mr_witness_8_5),
  %mr_load_sibling("rules/class8/8_6.mac", 'mr_witness_8_6),
  %mr_load_sibling("rules/class8/8_7.mac", 'mr_witness_8_7),
  %mr_load_sibling("rules/class8/8_8.mac", 'mr_witness_8_8),
  %mr_load_sibling("rules/class8/8_9.mac", 'mr_witness_8_9),
  %mr_load_sibling("rules/class8/9_1d.mac", 'mr_witness_9_1d),
  mr_rule_table : flatten([mr_rule_table, mr_rules_8_1, mr_rules_8_2,
                           mr_rules_8_3, mr_rules_8_4, mr_rules_8_5,
                           mr_rules_8_6, mr_rules_8_7, mr_rules_8_8,
                           mr_rules_8_9, mr_rules_9_1d]),
  /* 9.3 Miscellaneous integration rules (67): Rubi.m L356 loads it LAST.
     Its body stays the last body entry as classes 5, 7 and 8 are ported
     (spec A3); its eleven bare-u_ records are the end of the tail. */
  %mr_load_sibling("rules/class9/9_3.mac", 'mr_witness_9_3),
  mr_rule_table : flatten([mr_rule_table, mr_rules_9_3]),
  /* Tail rule lists (inert-trig substrate design 3.3, Task 8). A
     generated file may define mr_rules_<key>_tail beside mr_rules_<key>
     for a bare-u_ Int record (the most general Int pattern there is);
     our dispatcher walks mr_rule_table in load order and stops at the
     first rule that answers, so such a record has to be tried LAST
     (Mathematica gets there by pattern specificity instead). The six
     legacy bare-u_ records in classes 1/2/3 are a closed, named exception
     kept in their bodies (generator/generate_rules.py
     BARE_U_BODY_EXCEPTIONS,
     .scratch/class-ports/issues/07-bare-u-records-mid-table.md). There
     is NO automatic collector: every _tail list is NAMED here by hand, in
     Rubi LoadRules order, exactly as every body list is named above -- a
     new file with a _tail list must be added to this flatten (the
     real-table gate test/test_rule_table_order.mac fails if a bare-u_
     record reaches neither the tail nor the exception list).
     mr_rule_table_body_handles / _tail_handles are exposed so the
     ordering is assertable rather than inspected by eye. */
  mr_rule_table_body_handles : mr_rule_table,
  mr_rule_table_tail_handles : flatten([mr_rules_4_1_0_1_tail,
                                        mr_rules_4_7_5_tail,
                                        mr_rules_8_9_tail,
                                        mr_rules_9_3_tail]),
  mr_rule_table : flatten([mr_rule_table_body_handles,
                           mr_rule_table_tail_handles]),
  /* the dispatcher's last-resort tier (mr_last_resort_tier, ticket 14)
     reads the mark, not the list */
  %mr_mark_tail(mr_rule_table_tail_handles),
  /* 9.3's body: general patterns (mr_general_after_giveups, ticket 14) */
  %mr_mark_general(mr_rules_9_3)
)$

mr_witness_maxima_rubi() := true$
