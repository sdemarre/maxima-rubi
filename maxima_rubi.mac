/* maxima_rubi.mac — public loader (diophantine mould, T5 §2).
 *
 * Four load paths must work: by full path, from the directory, via
 * file_search push, batched (load("maxima_rubi.mac") from the package
 * dir). The witness check is the point: a missed or truncated sibling
 * load must fail loudly here, not silently later.
 *
 * load_pathname in this build is the file currently executing — inside
 * a load() that is the loaded file (resolved absolute path, even for a
 * relative load), at top level the BATCH file (measured 2026-08-20,
 * probes/maxima/probe-load-pathname.out). So the library dir is captured
 * ONCE at definition time below, never read at %mr_load_sibling call
 * time (a top-level caller's batch dir would otherwise seed the first
 * load attempt and print a spurious file_search1 miss per sibling).
 *
 * Witness idiom for .mac siblings (measured 2026-08-20): ?fboundp only
 * sees Lisp functions, so the witness is a Maxima FUNCTION defined at the
 * end of the sibling; an undefined function call stays a noun, so
 * is(apply(witness, []) = true) is true iff the sibling fully loaded. */
%mr_lib_dir : if load_pathname = false then "" else pathname_directory(load_pathname)$

%mr_load_sibling(fname, witness) := block([ok, w],
  /* errcatch in THIS build returns [RESULT] on success and [] on error
     (measured — probes/maxima/probe-errcatch-semantics.out). The by-name
     fallback fires when the sibling-dir load FAILED (ok = []); when
     %mr_lib_dir is "" it is the primary path, not a retry. */
  ok : errcatch(load(sconcat(%mr_lib_dir, fname))),
  if ok = [] then ok : errcatch(load(fname)),
  w : apply(witness, []),
  /* Keep the rule-record globals off `values` (every variable binding
     walks that list twice): %mr_trim_rule_values, maxima_rubi_dispatch.lisp.
     Only once the dispatcher is loaded -- the utils load precedes it.
     ?fboundp returns the FUNCTION OBJECT, not true (measured 2026-09-25),
     so it is compared with false. */
  if ?fboundp('%mr_trim_rule_values) # false then %mr_trim_rule_values(),
  if is(w = true) = false then
    error("maxima_rubi: could not load the sibling file ", fname,
          " (witness ", string(witness), " did not return true; the load ",
          "missed or truncated). Make it findable: (1) load this library ",
          "by full path, (2) run from its directory, (3) push its dir onto ",
          "file_search_maxima, or (4) install under ~/.maxima/."))$

%mr_load_sibling("maxima_rubi_utils.mac", 'mr_witness_utils)$

/* Mathematica's Expand[u, x] — the ExpandExpression cascade's
 * %mr_expand_x (exact seen test design 3.4) is format(u, %poly(x)) from
 * the SHARE package `format`, so it is loaded by name (not a sibling of
 * this library) right after the utils that call it.
 *
 * The witness is not optional bookkeeping: MEASURED 2026-09-16 (this
 * build), without the load format(u, %poly(x)) evaluates to the
 * unevaluated NOUN format((x+1)^2*sin(x), %poly(x)) (op = format) — no
 * error, no warning — and that noun would flow into an integrand and out
 * into an answer. A witness whose result must be a real sum turns the
 * silent failure into a loud one, as for every sibling above. */
mr_witness_format() := block([mr_fx, r],
  r : format((mr_fx + 1)^2, %poly(mr_fx)),
  is(not atom(r) and is(op(r) = "+")))$
load("format")$
if mr_witness_format() = false then
  error("maxima_rubi: the share package `format` did not load, so ",
        "format(u, %poly(x)) stays a noun (see %mr_expand_x in ",
        "maxima_rubi_utils.mac). Install Maxima's share/contrib/format.")$

/* Native-integrate prompt design (measured 2026-08-25): integrate's
   sign prompts are answered from the batch input stream — the test
   harness pre-queues pos/no answer lines (see the mr_top comment in
   maxima_rubi_utils.mac). An earlier iteration replaced the prompt
   with a noninteractive throw (maxima_rubi_ni.lisp, since deleted):
   it suppressed the assumption-conditional answers the harness
   verifies and regressed 10 broad-canary targets, so the prompt is
   kept native. The answer-exhaustion process death
   ("RETRIEVE: End of file encountered.") occurs only in batches
   that queue no answers; vanilla Maxima integrate dies identically
   there, so it is not a package regression. */

/* The matcher substrate (spec
 * docs/superpowers/specs/2026-09-12-matcher-substrate-design.md): the
 * matcher MR-MATCH and the Maxima <-> tree converter MR-TREE. Neither
 * defines a Maxima function, so each witness asks Lisp for its package
 * (?find_package returns the package object or NIL = false). */
mr_witness_match() := is(?find\-package("MR-MATCH") # false)$
%mr_load_sibling("maxima_rubi_match.lisp", 'mr_witness_match)$
mr_witness_tree() := is(?find\-package("MR-TREE") # false)$
%mr_load_sibling("maxima_rubi_tree.lisp", 'mr_witness_tree)$

/* The rule records, the dispatcher and the MatchQ entries
 * (maxima_rubi_dispatch.lisp), plus the Lisp arity dispatchers
 * %mr_binomialQ (2/3) and %mr_intBinomialQ (7/8/10) — the two
 * predicates Rubi overloads by arity (class-1 census 2026-08-23:
 * binomialQ 2/3 = 40/1, intBinomialQ 7/8/10 = 21/10/44). The witness
 * CALLS the defined names: a missed load leaves them nouns and fails
 * loudly here (the dispatcher on an EMPTY table answers false). */
mr_witness_dispatch() := is(%mr_binomialQ(1 + x, x) = true)
  and is(%mr_intBinomialQ(1, 1, 1, 1, 1, 1, x) = true)
  and is(%mr_dispatch_tree(1, x, [], 1) = false)$

%mr_load_sibling("maxima_rubi_dispatch.lisp", 'mr_witness_dispatch)$

/* Milestone-1 core (eager): the 1.1.1.1 rule file — what the Layer A
 * suite verifies behaviorally; 5 rules, safe on any build. */
%mr_load_sibling("rules/class1/1_1_1_1.mac", 'mr_witness_1_1_1_1)$
mr_rule_table : mr_rules_1_1_1_1$
/* Tail rule lists (inert-trig substrate design 3.3, Task 8) -- set here
   too, not only at the end of mr_load_all below, because Layer A's own
   suite (test_maxima_rubi.mac) loads only this eager core and never
   calls mr_load_all(); mr_load_all recomputes both after the full load.
   See the mr_load_all comment for the mechanism. */
mr_rule_table_body_handles : mr_rule_table$
mr_rule_table_tail_handles : []$

/* Full class-1 load — the 73-file list in Rubi LoadRules order (67
 * LoadRules files + the five corpus-matched `b`-suffixed 1.2.1
 * siblings + the 9.1 legacy file, generated from its .m source at the
 * end of the class-1 table; matcher substrate spec section 3.4).
 * The table becomes the 73-term flatten (3,054 rules: the pinned 9.1
 * source's first rule is commented out, so 9.1 generates 28 rules — the
 * manual port carried it as a 29th, dead rule, 3,055 before plan 2).
 *
 * TLS: the defmatch/matchdeclare slots that exhausted SBCL's
 * special-variable pool (probes/load_wall/probe-load-wall.out) are gone
 * with the matcher substrate; probe 08 (probes/matcher/08-runtime-load.out)
 * measured the flagless load (no TLS message) and a green flagless Layer
 * A, and AGENTS.md no longer requires -X "--tls-limit 100000". */
mr_load_class1_all() := block([],
  %mr_load_sibling("rules/class1/1_1_1_1.mac", 'mr_witness_1_1_1_1),
  %mr_load_sibling("rules/class1/1_1_1_2.mac", 'mr_witness_1_1_1_2),
