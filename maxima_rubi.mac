  %mr_load_sibling("rules/class1/1_2_2_5.mac", 'mr_witness_1_2_2_5),
  %mr_load_sibling("rules/class1/1_2_2_7.mac", 'mr_witness_1_2_2_7),
  %mr_load_sibling("rules/class1/1_2_2_8.mac", 'mr_witness_1_2_2_8),
