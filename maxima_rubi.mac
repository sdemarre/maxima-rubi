/* maxima_rubi.mac — public loader (diophantine mould, T5 §2).
 *
 * Four load paths must work: by full path, from the directory, via
 * file_search push, batched (load("maxima_rubi.mac") from the package
 * dir). The witness check is the point: a missed or truncated sibling
 * load must fail loudly here, not silently later.
 *
 * load_pathname in this build is the file currently executing — inside
 * a load() that is the loaded file (resolved absolute path, even for a
 * relative load), at top level the BATCH file (measured 2026-08-20,
 * probes/maxima/probe-load-pathname.out). So the library dir is captured
 * ONCE at definition time below, never read at %mr_load_sibling call
 * time (a top-level caller's batch dir would otherwise seed the first
 * load attempt and print a spurious file_search1 miss per sibling).
 *
 * Witness idiom for .mac siblings (measured 2026-08-20): ?fboundp only
 * sees Lisp functions, so the witness is a Maxima FUNCTION defined at the
 * end of the sibling; an undefined function call stays a noun, so
 * is(apply(witness, []) = true) is true iff the sibling fully loaded. */
%mr_lib_dir : if load_pathname = false then "" else pathname_directory(load_pathname)$

%mr_load_sibling(fname, witness) := block([ok, w],
  /* errcatch in THIS build returns [RESULT] on success and [] on error
     (measured — probes/maxima/probe-errcatch-semantics.out). The by-name
     fallback fires when the sibling-dir load FAILED (ok = []); when
     %mr_lib_dir is "" it is the primary path, not a retry. */
  ok : errcatch(load(sconcat(%mr_lib_dir, fname))),
  if ok = [] then ok : errcatch(load(fname)),
  w : apply(witness, []),
  if is(w = true) = false then
    error("maxima_rubi: could not load the sibling file ", fname,
          " (witness ", string(witness), " did not return true; the load ",
          "missed or truncated). Make it findable: (1) load this library ",
          "by full path, (2) run from its directory, (3) push its dir onto ",
          "file_search_maxima, or (4) install under ~/.maxima/."))$

%mr_load_sibling("maxima_rubi_utils.mac", 'mr_witness_utils)$

/* Native-integrate prompt design (measured 2026-08-25): integrate's
   sign prompts are answered from the batch input stream — the test
   harness pre-queues pos/no answer lines (see the mr_top comment in
   maxima_rubi_utils.mac). An earlier iteration replaced the prompt
   with a noninteractive throw (maxima_rubi_ni.lisp, since deleted):
   it suppressed the assumption-conditional answers the harness
   verifies and regressed 10 broad-canary targets, so the prompt is
   kept native. The answer-exhaustion process death
   ("RETRIEVE: End of file encountered.") occurs only in batches
   that queue no answers; vanilla Maxima integrate dies identically
   there, so it is not a package regression. */

/* The Lisp arity dispatchers (maxima_rubi_dispatch.lisp): %mr_binomialQ
 * (2/3) and %mr_intBinomialQ (7/8/10) — the two predicates Rubi
 * overloads by arity (class-1 census 2026-08-23: binomialQ 2/3 =
 * 40/1, intBinomialQ 7/8/10 = 21/10/44; every other predicate is
 * 1-arg or fixed-arity). The witness CALLS the dispatched names: a
 * missed load leaves them nouns and fails loudly here. */
mr_witness_dispatch() := is(%mr_binomialQ(1 + x, x) = true)
  and is(%mr_intBinomialQ(1, 1, 1, 1, 1, 1, x) = true)$

%mr_load_sibling("maxima_rubi_dispatch.lisp", 'mr_witness_dispatch)$

/* Milestone-1 core (eager): the 1.1.1.1 rule file — what the Layer A
 * suite verifies behaviorally; 5 rules, safe on any build. */
%mr_load_sibling("rules/class1/1_1_1_1.mac", 'mr_witness_1_1_1_1)$
mr_rule_table : mr_rules_1_1_1_1$

/* Full class-1 load — the 67-file list in Rubi LoadRules order,
 * generated by the generator (do not hand-edit the list).
 *
 * MEASURED 2026-08-20 (probes/load_wall/probe-load-wall.out, build
 * branch_5_49_base_796_g60186bb22_dirty): this build cannot hold all
 * 2710 class-1 patterns in one process. The defmatch budget (between
 * 1200 and 1600 plain patterns — a real class-1 rule costs between
 * about 3.3 and about 5.4 of them) holds files 1-7 of the load list
 * (294 rules) but dies on file 8 (361 cumulative) with SBCL's fatal
 * "Thread local storage exhausted" — errcatch cannot catch it. So the
 * loader does NOT call this. On a build with the headroom (5.50 is
 * expected to improve pattern matching), call mr_load_class1_all();
 * the table then becomes the full 72-term flatten (67 LoadRules files
 * + the five corpus-matched dead siblings, the `b`-suffixed 1.2.1
 * families — measured 2026-08-25) per the T5 §2
 * interface. For single files on this build:
 *     %mr_load_sibling("rules/class1/<key>.mac", 'mr_witness_<key>);
 *     mr_rule_table : mr_rule_table concat mr_rules_<key>$
 * (measured: unload("rules/class1/<key>.mac") releases that file's
 * patterns from the budget, so files can be swapped.) */
mr_load_class1_all() := block([],
  %mr_load_sibling("rules/class1/1_1_1_1.mac", 'mr_witness_1_1_1_1),
  %mr_load_sibling("rules/class1/1_1_1_2.mac", 'mr_witness_1_1_1_2),
