/* maxima_rubi_utils.mac — runner + noun forms + (later) shims and ported
 * predicates. Loaded by maxima_rubi.mac. House rules: AGENTS.md + T5 §4;
 * the measured traps of T2 §3 are the reason for %mr_b, the block-local
 * rebind in the rule shape, and the never-kill naming policy. */

rubi_verbose : false$

/* Port of ShowStepRoutines.m :3  SimplifyFlag = True; — the class-1
 * rule 1.4.1's ShowStep guard references it; the default is on, and
 * the harness never switches it. */
mr_simplify_flag : true$

/* Capture lookup on the [var = value] equation list (order unspecified,
 * measured T2 §3.6). Quoted symbol on both sides (house rule 1). */
geteqR(mm, nm) := block([],
  if length(mm) = 0 then false
    else if is(part(part(mm, 1), 1) = nm) then part(part(mm, 1), 2)
         else geteqR(rest(mm), nm))$

/* Boolean resolver (house rule 2): is()'s third value unknown is not true. */
%mr_b(e) := block([v],
  v : is(e),
  if v = true then true else false)$

/* Package noun forms (house rule 10 — distinct from the fall-through
 * integrate noun and from corpus-expected nouns). */
mr_unintegrable(f, x) := 'unintegrable[f, x]$

/* Rubi's finite Sum, concretized (2026-08-25 divergence fix). Maxima
   evaluates function arguments eagerly, so the generator hands the
   summand over in held form: a NON-identifier summand arrives as
   lambda([var], <summand>) and is applied per index (the body then
   evaluates the total package functions, e.g. %mr_coeff(Pq, x, 2*k),
   at a CONCRETE index — the eager call with k free returns 0 and
   destroyed every even/odd-split sum, leaving degenerate
   mr_sum[0,k,0,0] nouns in answers); a bare IDENTIFIER summand (the
   Rubi Module-local-u shape, 1.1.3.1 r13 family) is resolved through
   its value, which carries the index: ev(subst(i, var, ev(fun))). A
   lambda body of one bare symbol does NOT get the index bound into
   the value (measured 2026-08-25, probe mech_decisive D1) — hence the
   two paths. Numeric bounds: per-integer i over ceiling(lo)..floor(hi);
   an empty range is 0. Non-numeric bounds keep the noun. A plain
    (already-evaluated, non-lambda) expression summand — hand-written
    call sites only, never the generator's — gets the index substituted
    and re-evaluated. The lambda test must compare against the UNQUOTED
    symbol: in this build op() on a lambda form only compares true with
    `lambda` — `op(lam) = "lambda"` is false, while for ordinary
    operators the string idiom is the one that holds; symbols and
    strings never compare equal here (measured 2026-08-25, probes
    op_cmp_probe / op_typeof_probe, Maxima 5.50.0 SBCL). A dead lambda
    branch is worse than an error: subst then descends into the lambda
    and fatals replacing its parameter. The locals are prefixed: ev
    re-evaluates the summand while they are live, and Maxima binds block
    locals dynamically, so a local named a, b, i, s or t captured the
    integrand's own symbol (ticket 08 D: rubi(1/(a+b*x^5), x) answered
    with residual 0.035) and a lambda body's With local s. */
mr_sum(fun, var, lo, hi) := block([%mr_sum_a, %mr_sum_b, %mr_sum_i,
                                    %mr_sum_s, %mr_sum_t],
  if numberp(lo) and numberp(hi) then (
    %mr_sum_a : ceiling(lo),
    %mr_sum_b : floor(hi),
    if %mr_sum_a > %mr_sum_b then 0
    else (
      %mr_sum_s : 0,
      for %mr_sum_i : %mr_sum_a thru %mr_sum_b do (
        if atom(fun) then %mr_sum_t : ev(subst(%mr_sum_i, var, ev(fun)))
        else if (op(fun) = lambda or op(fun) = "lambda") then
          %mr_sum_t : apply(fun, [%mr_sum_i])
        else %mr_sum_t : ev(subst(%mr_sum_i, var, fun)),
        %mr_sum_s : %mr_sum_s + %mr_sum_t
      ),
      %mr_sum_s
    )
  )
  else 'mr_sum[fun, var, lo, hi])$

/* Recursion cap (T5 §1 candidate; re-tuned in Task 9). A runaway
 * replacement becomes the fall-through noun, not a stack overflow.
 * The cap itself is now the run switch mr_max_depth (the defmvar of
 * maxima_rubi_dispatch.lisp; exact seen test design 3.3), so a run can
 * set it without editing this file. This counter records how often the
 * cap branch was taken: the driver resets it per entry and writes the
 * per-entry count to the run's .caps census (test/merge_caps.py), which
 * is how the default is judged against Rubi's own step counts. */
mr_depth_cap_hits : 0$

/* Kill-switch for the boolean-leak misfire check (debug). */
%mr_boolcheck : true$

/* MEASURED Maxima gotcha (2026-08-20): a `return(value)` inside a `for` loop
   does NOT return from the enclosing block in this build — it is loop-level,
   so the block fell through to the trailing `false` and dispatch ALWAYS
   returned false (rubi() was a silent pass-through to integrate). The fix:
   track the firing result in `ans`, use a BARE `return()` to break the `for`
   loop, and return `ans` after the loop. */
/* A boolean (true/false) anywhere in a replacement is a port bug, not a
   result: it means a predicate's `false` sentinel (e.g.
   %mr_polyRemainder on a non-polynomial) flowed into the repl's
   arithmetic, where Maxima booleans do NOT collapse to 0/1 — 126*false
   stays 126*false (measured 2026-08-25, 5.50.0/SBCL: 1.2.2.6 r8 on
   1.2.2.6 e123, m = -2, x^m*Pq non-polynomial -> the .m rule is
   vacuous there in Mathematica — PolynomialRemainder stays a noun and
   the firing dead-ends — but the port computed d = %mr_coeff(false, x,
   0) = false and the corrupted terms reached the final answer as
   `false` factors under a deferred integrate noun). The faithful
   port behavior for a vacuous firing is a DECLINE, so any boolean in
   the replacement downgrades the fire to a misfire and lets the next
   rule (or the integrate fall-through) handle the integrand. No
   early exit: `return` inside a `for` is loop-level in this build
   (measured 2026-08-20; recorded with the defmatch-era %mr_dispatch,
   deleted with the matcher substrate). */
/* The boolean test is by STRING, not by = (measured 2026-08-25,
   5.50.0/SBCL): a `false` factor inside a Times node is retrieved by
   part() as an atom whose string is "false" but which is NEITHER
   =-nor # -equal to the boolean false NOR to the symbol 'false
   (a distinct reified object — identical() is an unevaluated noun
   here, featurep misses it, is(p = false)/is(p = 'false) both
   false, is(string(p) = "false") true) — so only the name test
   catches all three presentations (literal boolean, symbol, and the
   part()-reified factor). Atoms are cheap; the non-atom arm never
   calls string(). */
/* Control structures are OPAQUE leaves (measured 2026-08-25): generated
   replacements legally CONTAIN booleans as code — e.g. the 1.4.1 r70
   repl carries an (if is(...) = true then (...) else false) that
   evaluates away when the condition decides, and stays boolean-bearing
   when it does not. Walking into if/block/lambda bodies misfired every
   such rule (1.2.1.3 e1058 verified -> unverified). A leaked boolean
   instead sits under arithmetic (+ * / ^) or a list/noun — descending
   everything EXCEPT the control heads is the right cut. */
%mr_containsBoolean(e) := block([i, hit],
  if atom(e) then is(string(e) = "true") or is(string(e) = "false")
  else if op(e) = "if" or op(e) = "block" or op(e) = "lambda"
    or op(e) = "let" or op(e) = "letf" or op(e) = "do"
    or op(e) = "for" or op(e) = "while" or op(e) = "when"
  then false
  else if op(e) = "-" then (
    /* a negation node: length() reports 2 but part(e, 2) ERRORS in
       this build (measured 2026-08-25: part(-(1/2), 2) killed the
       walk on the 1.2.2.1 r13 repl's elliptic_f(atan(x), -1/2) — the
       1.2.1.3 e1058 cascade silently derailed). Only part 1 exists. */
    %mr_containsBoolean(part(e, 1))
  )
  else (
    hit : false,
    for i : 1 thru length(e) do (
      if %mr_containsBoolean(part(e, i)) then hit : true
    ),
    hit))$

/* The recursion counter increments on the way in and decrements on the way
 * out, so nested mr_int calls share one depth budget. A runaway replacement
 * becomes the fall-through noun, not a stack overflow. */
depth_level : 0$

/* No-op / self-match loop guard (2026-08-24, divergence loop). A rule whose
   replacement re-dispatches the SAME integrand — e.g. the 1.4.2
   normalization rules, whose repl is Px*ExpandToSum[z]^q*ExpandToSum[u]^p,
   the identity when z,u are already a binomial/trinomial, so the term
   re-matches the rule forever — would spin to the depth cap, a full ~2705-
   rule scan per level, before the integrate fall-through. The expanded
   single-term rationals the linearity split produces for 1.1.1.3
   (a+bx)^m(c+dx)^n(e+fx)^p hit this and blew the 30s canary cap (1.1.1.3
   e1276: the 500 x^5/(3x+2)^8 term cycled 14x identically). Cut the cycle at
   the first repeat and fall through now. member/ = is the membership test
   (isequal and identical do NOT evaluate to a boolean in this build —
   measured 2026-08-24, they stay unevaluated nouns). */
%mr_seen : []$

/* The top-level entry. fb gates the two top-level fall-throughs
 * (recursion cap, no rule fired). fb = false — the default `rubi(f, x)` —
 * returns the package no-answer noun instead of calling integrate: a
 * top-level 0-firing is a port/matcher-gap signal (2026-08-24 divergence
 * loop), not a job for Maxima's integrate, which is slow on generic
 * parameters and prompts for sign assumptions (one standalone run 92 s
 * before EOF, measured 2026-08-24). fb = true restores the status-quo
 * integrate fall-through.
 *
 * The flag governs ONLY the top level. mr_int — the entry the generated
 * rule replacements call for NESTED sub-integrals — keeps the status-quo
 * integrate fall-through: a nested 0-firing is a different case, and
 * corpus entries currently verified through nested fallback must not
 * regress (2026-08-24 design decision, handoff Step 1 open question). */
/* Native-integrate fall-through design (measured 2026-08-25): the
   integrate call in the fb=true branches below is BARE — deliberately
   not errcatched. (a) Sign prompts are a designed input channel: the
   test harness (corpus_class1_driver.build_text) runs with
   batch_answers_from_file true and pre-queues prompt answers (six
   "pos" + six "no" lines; the flag must be set via -p preload, not in
   the batch) — retrieve() reads the next batch line as the answer, so
   integrate returns an assumption-conditional result the harness's
   formal diff check verifies. (b) An ERRORING integrate (a Lisp-level
   crash, or the uncatchable RETRIEVE input-EOF when the 12 queued
   answers are exhausted) must PROPAGATE: it kills the rule's
   replacement, the dispatcher's errcatch (maxima_rubi_dispatch.lisp
   mr-apply-rule) turns that into a misfire, and
   the next rule gets the integrand. errcatching it instead bakes the
   no-answer noun into the answer and regresses targets that the
   declining rule's successor handles (measured 2026-08-25: broad
   canary 88/32 -> 86/34, five expected/no-answer -> unverified
   flips, e.g. 1.1.4.3 e119 A/B'd against the bare call). The
   seen-guard branch below is the SAME bare call — the productive
   loop resolution, not a fall-through (see there). */
/* The dispatch body of mr_top (exact seen test design,
   docs/superpowers/specs/2026-09-15-matcher-seen-test-intpart-design.md
   3.1). The seen test is exact membership on every call. A rule's rewrite
   of its integrand to an algebraically EQUAL form in a different stored
   form (9.1's collapses, the ExpandIntegrand / PolyQuotient / ExpandToSum
   normalizers, the linear-product and trinomial expansions) is a new
   dispatch, as in Rubi, which has no seen test of its own; probe 16
   (probes/matcher/16-seen-guard-trace.out, .class1.out) measured the
   ratsimp comparison this replaces cutting those rewrites in 40 groups.
   An exact repeat is still cut; two rules alternating between different
   equal forms stop at the depth cap (the run switch mr_max_depth) and take
   the fb branch. The float/rational drift cycle the ratsimp comparison
   guarded (891240b) was measured on the defmatch runner; probe 17
   (probes/matcher/17-exact-seen-intpart.out) re-runs its targets on the
   substrate.

   fb is the caller's fall-through: false = return the unintegrable noun
   (rubi, and mr_int under the rules-only default), true = hand the
   integrand to Maxima's integrate (mr_int under mr_nested_fallback,
   rubi_fallback). Every cap hit is counted in mr_depth_cap_hits for the
   run's .caps census (exact seen test design 3.3). */
%mr_top_body(f, x, fb) := block([ans],
  depth_level : depth_level + 1,
  if depth_level > mr_max_depth then (
    depth_level : depth_level - 1,
    mr_depth_cap_hits : mr_depth_cap_hits + 1,
    if fb then return(integrate(f, x))
    else return(mr_unintegrable(f, x))
  ),
  if member(f, %mr_seen) then (
    depth_level : depth_level - 1,
    /* A re-dispatch of an integrand already on the dispatch path is
       a pure rule loop (static table, deterministic matcher -> the
       same rule re-fires; e.g. the 1.1.1.2 r12 ExpandIntegrand-
       identity repl). MEASURED 2026-08-25: the fb fall-through to
       bare integrate(f, x) is LOAD-BEARING, not a bug — targets
       whose nested sub-integrals loop (1.1.4.3 e119: ten seen-guard
       hits on its productive 1.3.3/1.4.1/1.3.2 cascade) build their
       VERIFIED answer from those integrate results (assumption-
       conditional, from the driver's queued prompt answers). The
       seen guard fires once per cycle (it returns the integrate
       result instead of re-dispatching), so there is no per-cycle
       re-entry to cut. An ERROR here instead (measured same day)
       declines the outer rule and drops those targets to unverified
       (broad canary 88/32 -> 86/34). The manual-batch prompt-EOF
       death ("RETRIEVE: End of file encountered." when no answer
       lines are queued) is inherent to bare integrate in a batch —
       vanilla Maxima integrate dies identically — and is not
       regressed or fixed here. */
    if fb then return(integrate(f, x))
    /* fb = false (the rules-only default): DECLINE THE RULE instead of
       answering the noun -- the seen-cut fall-through, half of the pair
       with mr_giveup_last (maxima_rubi_dispatch.lisp).

       The seen test is a PORT artifact: Rubi has no seen test of its own,
       so a rule whose rewrite reproduces its own integrand simply is not a
       result in Rubi, and answering mr_unintegrable here ends the whole
       dispatch on what is really one rule's dead end. MEASURED 2026-09-17,
       2*x/(b^(3/4) x^2 + sqrt(2) a^(1/4) sqrt(b) sqrt(d) x + sqrt(a)
       b^(1/4) d): 1_2_1_9b r5 wins (cond PolyQ(Pq,x) and IGtQ(p,-2), with
       Pq = 2 a degree-0 polynomial), its replacement is
       mr_int(%mr_expandIntegrand(...), x), and %mr_expandIntegrand is a
       NO-OP on that integrand -- so it recurses on the SAME integrand, the
       seen test catches the repeat, and the noun ends the run. Deleting
       that one handle from mr_rule_table makes the integrand ANSWER, which
       is the proof it is a dispatch artifact and not missing coverage.

       Raising instead makes mr-apply-rule's errcatch read it as a repl
       misfire, decline that rule and continue down the table. The error is
       always caught: a frame can only reach this branch at depth >= 2, and
       every frame beyond the first was entered from a replacement running
       under mr-call's errcatch, so it never escapes to the top level (at
       depth 1 %mr_seen is empty and member() is false). %mr_seen stays
       balanced too -- this branch raises BEFORE the cons below, and each
       unwound frame has already decremented depth_level.

       This is NOT the 2026-08-25 measurement above: that one made the
       fb = TRUE branch an error and lost the productive integrate results
       the seen guard returns. That branch is untouched. */
    else error("mr_seen_cut")
  ),
  %mr_seen : cons(f, %mr_seen),
  /* One dispatch on MR-MATCH (maxima_rubi_dispatch.lisp
     %mr_dispatch_tree): Mathematica matching semantics, so the
     compensating rescans of the defmatch runner (passes 2-4) are gone
     (matcher substrate spec section 3.5). mr_model_flags (spec 3.6,
     the G-5 arm) binds radexpand:false and logexpand:false around the
     dispatch, so the intermediate integrands keep Mathematica's shape. */
  ans : if mr_model_flags
        then block([radexpand : false, logexpand : false],
                   %mr_dispatch_tree(f, x, mr_rule_table, depth_level))
        else %mr_dispatch_tree(f, x, mr_rule_table, depth_level),
  %mr_seen : rest(%mr_seen),
  depth_level : depth_level - 1,
  if ans = false then (
    if fb then integrate(f, x)
    else mr_unintegrable(f, x)
  ) else ans)$

mr_top(f, x, fb) := %mr_top_body(f, x, fb)$

/* Nested sub-integral entry: every generated replacement calls mr_int by
 * name. What a nested call with no route (no rule, the seen test, the
 * depth cap) returns is the run switch mr_nested_fallback (exact seen
 * test design 3.3): false (the default) returns the unintegrable noun, so
 * the run answers with Rubi's rules only and the driver classes such an
 * answer contains-noun; true restores the integrate fall-through this
 * entry had before. The pre-validation measured ~1,300 class-1 PASS
 * entries that were answered by integrate on a nested call the old
 * ratsimp seen comparison had declared a loop — the rules-only arm is
 * the new baseline, the fall-through arm is the like-for-like comparison
 * with P0/P5b. */
mr_int(f, x) := mr_top(f, x, mr_nested_fallback)$

/* Two-arg rubi is the rules-only entry (fast no-answer noun on a
 * 0-firing). The integrate fall-through is the separate explicit entry
 * rubi_fallback(f, x, fb). MEASURED (2026-08-24, this build): Maxima
 * has NO arity overloading — a second same-name definition with a
 * different arg count REPLACES the first (the 2-arg call then errors
 * "Too few arguments supplied to rubi(f, x, fb)") — and no variadic
 * syntax (`b...` is a parse error; `argc`/`arglist` have no manual
 * entries), so the two modes must have distinct names. */
rubi(f, x) := mr_top(f, x, false)$
rubi_fallback(f, x, fb) := mr_top(f, x, fb)$

/* ===================== predicate cluster 1 (T5) =====================
 * Ports of Rubi IntegrationUtilityFunctions.m (pinned clone, read-only)
 * under the house rules. Each cites its .m source line; deviations from
 * the source are noted per function. */

/* ---- clone-gap equality pair --------------------------------------
 * PossibleZeroQ is referenced by EqQ/NeQ (IntegrationUtilityFunctions.m
 * :365/:370) but defined NOWHERE in the pinned clone (clone-gap note,
 * measured 2026-08-20); the contract is derived from usage: "possibly
 * zero" = "could be zero" (loose — the harness derivative check catches
 * over-firing).
 * MEASURED (2026-08-20, this build): is(e # 0) DECIDES true for any
 * expression containing a bare symbol (is(a # 0) -> true, is(a+b # 0)
 * -> true) — Maxima's is() assumes symbols are generically nonzero, so
 * `not is(e # 0)` (the plan's formula) would return false for the
 * symbol a, contradicting the unit probe "possible_zero a -> true".
 * The operational contract instead: substitute 0 for every variable
 * symbol of e; the result 0 (or a diverging substitution, caught) is
 * the "possibly zero" witness. */
%mr_isVarSym(a) := block([],
  if atom(a) and not numberp(a)
    and a # '%pi and a # '%e and a # '%i and a # 'inf and a # 'minf
    and a # 'true and a # 'false and a # 'unknown
    and a # '%lambda and a # 'undefined and a # 'und
  then true else false)$

%mr_symbols(e) := block([i, lst],
  if atom(e) then (
    if %mr_isVarSym(e) then [e] else []
  )
  /* MEASURED (2026-08-23): a rational is NOT an atom, and a negative
     rational has length 2 but only ONE part (the unary-minus quirk) —
     numberp is the exact-number guard, and op "-" recurses on its
     operand before the parts loop. */
  else if numberp(e) then []
  else if op(e) = "-" then %mr_symbols(part(e, 1))
  else (
    lst : [],
    for i : 1 thru length(e) do
      lst : append(lst, %mr_symbols(part(e, i))),
    lst
  ))$

/* MEASURED (2026-08-20): the LIST form of subst is a silent NO-OP in
   this build (subst([0], [a], a+b) -> a+b) — scalar form in a loop. */
%mr_zeroSubst(e, syms) := block([i, z],
  z : e,
  for i : 1 thru length(syms) do
    z : subst(0, part(syms, i), z),
  z)$

%mr_possible_zeroQ(e) := block([syms, z],
  syms : %mr_symbols(e),
  /* errcatch: a zero-substitution that diverges (1/x at x=0) is not a
     zero-witness -> not possibly zero */
  z : errcatch(%mr_zeroSubst(e, syms)),
  if is(z = []) then false
  else if is(part(z, 1) = 0) then true else false)$

 /* EqQ is the STRICT equality guard: u-v must simplify to 0. The earlier
  * loose reading (%mr_eqQ := %mr_possible_zeroQ(u-v), the clone-gap
  * "fire when the condition could hold" philosophy) over-fired at scale:
  * %mr_possible_zeroQ zero-substitutes EVERY variable symbol, so a generic
  * parameter product like -10*a*b*c read as "possibly zero" and the EqQ
  * guards of the 1.1.1.x/1.2.x rules fired on integrands they did not
  * cover (the 2026-08-24 full class-1 run: 19,454 FAILs, many of them
  * this). The harness derivative check cannot recover a wrong answer that
  * a misfired rule already returned. NeQ stays "not provably zero" (a
  * symbolic m must let the power rule fire), which is independent of the
  * EqQ reading. */
%mr_eqQ(u, v) := %mr_b(u - v = 0)$
%mr_neQ(u, v) := block([z],
  z : is(u - v = 0),
  if z = true then false else true)$

/* ---- simp / together shims ----------------------------------------
 * simplify and together are UNBOUND in this build (measured, T2/T4;
 * probes/translation/02-support-surface.mac S4). */
%mr_together(e) := block([r],
  r : errcatch(rat(e)),
  if is(r = []) then e
  else num(part(r, 1))/denom(part(r, 1)))$

/* the zero-chain (Q3, docs/corpus-baseline.md): apply in order, return
   the last stage. Rubi's 2-arg Simp[u_,x_] (IntegrationUtilityFunctions.m
   :2265) is TimeConstrained[NormalizeSumFactors[SimpHelp[u,x]],$TimeLimit,u]
   — a value-preserving sum-factor sign/content normalization. DEVIATION:
   the port accepts the variable argument (Maxima optional-arg idiom,
   [v] collects it as a list, [] when absent — MEASURED 2026-08-25) but
   ignores it and runs the same zero-chain; value-preserving is the hard
   requirement, shape parity is not. MEASURED 2026-08-25: with a
   1-arg-only definition every 2-arg call site fatal'd
   "Too many arguments" at repl evaluation — errcatched, so the 32 rules
   carrying a 2-arg %mr_simp (39 call sites: 1.1.1.4, 1.1.2.7, 1.1.2.9,
   1.2.1.1, 1.2.1.2, 1.2.1.3, 1.2.1.5, 1.2.2.3, 1.2.2.4, 1.2.3.4, 1.4.1)
   silently DECLINED. */
%mr_simp(e, [v]) := block([a],
  a : ratsimp(e),
  a : ratsimp(expand(a)),
  a : factor(a),
  ratsimp(a))$

/* ---- sign / posQ / negQ -------------------------------------------
 * Sign (Maxima sign() is bound; it returns the five-valued
 * pos/neg/zero/pnz/pz — pz = "positive or zero", measured). */
%mr_sign(e) := block([s],
  s : sign(e),
  if s = 'pos then 1
  elseif s = 'neg then -1
  elseif s = 'zero then 0
  else s)$

/* Rest[u] and the argument list in Maxima's internal order (inflag :
   true), the canonical order orderlessp tests: the order the ports of
   Rubi's First/Rest read (matcher translation fixes design 3.2;
   probes/matcher/14-mma-order-agreement measures its agreement with
   Mathematica's stored order). inflag is bound only around the
   extraction, so it never reaches a callee (the display-order ports read
   op/part under the default). inpart(u, k) is the k-th internal part. */
%mr_rest_in(u) := block([inflag : true], rest(u))$
%mr_args_in(u) := block([inflag : true], args(u))$

/* Rubi :605-:634  PosQ[u] := PosAux[TogetherSimplify[u]] — the port of
 * PosAux (matcher translation fixes design 3.2; the strict reading
 * "undecidable sign -> false" is retired). Branches in the .m's order:
 *   1 NumberQ: a real number -> u > 0; an explicit complex number ->
 *     PosAux of Im when Re is 0, else of Re;
 *   2 NumericQ (constantp): Simplify[Re[u]]; a number decides (on the
 *     simplified Im when it is 0); otherwise w = N[u] (float) must be an
 *     explicit number and PosAux[w];
 *   3 Refine[u > 0] decided -> that value;
 *   4 PowerQ: an integer exponent -> EvenQ[exponent] || PosAux[base];
 *     otherwise True;
 *   5 ProductQ: PosAux[First] -> PosAux[Rest], else Not[PosAux[Rest]];
 *   6 SumQ: PosAux[First];
 *   7 anything else (a symbol, a function call): True.
 * First/Rest read the internal order (inpart, %mr_rest_in); a unary minus
 * and a quotient are products there, sqrt and 1/c are powers.
 * Stated deviations (design 3.2): (assumptions) is() treats symbols as
 * real and reads the assume database where Refine assumes nothing; an
 * expression containing %i is left to the structural branches, where
 * is() answers false (is(%i*a > 0) = false, probes/matcher/12 NEGQ);
 * (normalizer) %mr_togetherSimplify expands products Rubi's
 * TogetherSimplify keeps factored — the first-term sign PosAux reads
 * survives the expansion on term-order shapes (probe 12 NORM, the Layer A
 * factored-input checks). */
%mr_posAux(u) := block([v, w],
  if numberp(u) then is(u > 0)
  else if %mr_complexNumberQ(u) then (
    if is(realpart(u) = 0) then %mr_posAux(imagpart(u))
    else %mr_posAux(realpart(u)))
  else if constantp(u) then (
    v : %mr_simp(realpart(u)),
    if numberp(v) then (
      if %mr_eqQ(v, 0) then %mr_posAux(%mr_simp(imagpart(u)))
      else is(v > 0))
    else (
      w : float(rectform(u)),
      if numberp(w) or %mr_complexNumberQ(w) then %mr_posAux(w) else false))
  else (
    v : if freeof(%i, u) then errcatch(is(u > 0)) else [],
    if v = [true] then true
    else if v = [false] then false
    else if atom(u) then true
    else if inpart(u, 0) = "^" then (
      if integerp(inpart(u, 2))
      then (evenp(inpart(u, 2)) or %mr_posAux(inpart(u, 1)))
      else true)
    else if inpart(u, 0) = "*" then (
      if %mr_posAux(inpart(u, 1)) then %mr_posAux(%mr_rest_in(u))
      else not %mr_posAux(%mr_rest_in(u)))
    else if inpart(u, 0) = "+" then %mr_posAux(inpart(u, 1))
    else true))$
%mr_posQ(u) := block([t],
  t : errcatch(%mr_togetherSimplify(u)),
  %mr_posAux(if t = [] then u else first(t)))$
/* Rubi :642  NegQ[u] := Not[PosQ[u]] && NeQ[u, 0] */
%mr_negQ(e) := block([v],
  v : (not %mr_posQ(e)) and %mr_neQ(e, 0),
  if is(v) = true then true else false)$

/* ---- explicit-number predicates (Task 7a) ----------------------------
 * Rubi's IntegerQ/FractionQ/IntegersQ/RationalQ test EXPLICIT numbers
 * (Head === Integer / Rational — a captured symbolic expression is
 * never "explicit" no matter what it could become). Maxima keeps
 * rationals in reduced form, so the structural test for an explicit
 * rational is op = "/" with integer num/denom — plus the "-" wrapper,
 * because MEASURED (2026-08-23) a negative rational is op "-" in this
 * build (op(-1/2) = "-", num(-1/2) = -1, denom = 2). rationalp is a
 * NOUN in this build (measured, 02-support-surface S1a).
 *
 * Call shape (generate_class1.py :877-884): the generator emits a 1-arg
 * call — the scalar for one Rubi arg, a LIST for several (Rubi's
 * IntegersQ[u__]/RationalQ[u__] are variadic) — so the ports accept
 * scalar-or-list. FractionQ is NOT in the list-packing branch: its 83
 * class-1 uses are all scalar. */

/* scalar half of %mr_rationalQ — one explicit integer or fraction */
%mr_rationalQ_scalar(e) := block([],
  if integerp(e) then true
  else if not atom(e) and (op(e) = "/" or op(e) = "-")
    and integerp(num(e)) and integerp(denom(e))
    then true else false)$

/* Rubi :97  RationalQ[u__]. Task 7a update: the committed 1-arg port
 * answered false on the LIST calls the generator emits (49 class-1
 * sites — silent dead rules) and on negative rationals (the "/"-only
 * test missed the "-" wrapper); both fixed here. */
%mr_rationalQ(e) := block([i, v],
  if atom(e) then %mr_rationalQ_scalar(e)
  /* a non-list non-atom (x/2, sqrt(1/2), ...) takes the scalar test —
     the list walk must not misread a "/" node's num/denom as elements.
     MEASURED (2026-08-23): the list op is the string "[" (not "list"). */
  else if op(e) = "[" then (
    v : true,
    for i : 1 thru length(e) do
      if %mr_rationalQ_scalar(part(e, i)) = false then v : false,
    v
  )
  else %mr_rationalQ_scalar(e))$

/* Rubi :70  IntegersQ[u__] — all args explicit integers */
%mr_integersQ(u) := block([i, v],
  if atom(u) then integerp(u)
  else if op(u) = "[" then (
    if length(u) = 0 then false
    else (
      v : true,
      for i : 1 thru length(u) do
        if integerp(part(u, i)) = false then v : false,
      v)
  )
  else false)$

/* Rubi :87  FractionQ[u__] — all args explicit PROPER fractions
 * (Rational head, not Integer): a reduced rational in this build is a
 * "/" or "-" node with integer num/denom and is never an integer, so
 * the explicit-rational test minus integerp IS the proper-fraction
 * test. */
%mr_fractionQ(e) := block([],
  if integerp(e) then false
  else if not atom(e) and (op(e) = "/" or op(e) = "-")
    and integerp(num(e)) and integerp(denom(e))
    then true else false)$

/* ---- structural shape predicates (Task 7a cluster A2) ----------------
 * PolynomialQ / AtomQ / MonomialQ / LeafCount — the Mathematica builtins
 * the census tiered C (no .m source; semantics from the manual entries
 * and, for MonomialQ, the .m usage comment). */

/* PolynomialQ[u, x] — u is MANIFESTLY a polynomial in x. STRICTER than
 * %mr_polyQ (Rubi's PolyQ, the Together route): no cancellation. MEASURED
 * (2026-08-23): this build keeps (x^2+x)/(x+1) as a "/" node (no
 * auto-cancel) while rat() DOES cancel it — so the %mr_polyQ route would
 * over-accept, and %mr_polyformQ under-accepts (its else branch rejects
 * every quotient, even x/2 whose denominator is x-free). The walker
 * below differs from %mr_polyformQ in exactly that one branch: a
 * quotient is polynomial in x iff the denominator is x-free and the
 * numerator is (x/2 -> true; 1/x -> false), at any depth — Maxima does
 * not auto-combine x/2 + 1 (measured). A nonnegative-INTEGER-exponent
 * power is required, as in %mr_polyformQ (x^a with symbolic a is not a
 * polynomial). */
%mr_polystrictQ(e, x) := block([i, ok],
  if atom(e) then (
    is(e = x) or freeof(x, e)
  )
  elseif op(e) = "-" then %mr_polystrictQ(part(e, 1), x)
  elseif op(e) = "+" then (
    ok : true,
    for i : 1 thru length(e) do
      if is(%mr_polystrictQ(part(e, i), x)) = false then ok : false,
    ok
  )
  elseif op(e) = "*" then (
    ok : true,
    for i : 1 thru length(e) do
      if is(%mr_polystrictQ(part(e, i), x)) = false then ok : false,
    ok
  )
  elseif op(e) = "/" then
    freeof(x, part(e, 2)) and %mr_polystrictQ(part(e, 1), x)
  elseif op(e) = "^" then
    if integerp(part(e, 2)) and is(part(e, 2) >= 0)
      and freeof(x, part(e, 2))
    then %mr_polystrictQ(part(e, 1), x)
    else false
  else freeof(x, e))$

%mr_polynomialQ(u, x) := %mr_polystrictQ(u, x)$

/* AtomQ[e] — e has no subparts (Mathematica builtin). Maxima's atom()
 * is the direct analog (measured: atom([1,2]) = false). */
%mr_atomQ(e) := block([], atom(e))$

/* Rubi :1391  MonomialQ[u, x] — "u is of the form a*x^n where n!=0 and
 * a!=0". The .m definition is MatchQ[u, a_.*x^n_. /; FreeQ[{a,n},x]]:
 * the OPTIONAL pattern args make bare x (n -> 1, a -> empty/1) and bare
 * x^k match. The class-1 call sites (1.3.3 x2, 1.4.1) feed PolyQ-
 * confirmed polynomials, so the operational test is structural: exactly
 * one x-power (x, or x^n with n x-free and not 0 — integer for a
 * polynomial; the lone-power case is the bare-x^n reading of the usage)
 * and every other factor x-free. DEVIATION (documented): a lone x^a
 * with SYMBOLIC a returns true here, where the .m MatchQ (Power head
 * vs the Times pattern) returns false — unreachable at the call sites
 * (PolynomialQ-guarded). a = 0 needs no test: a zero product is the
 * atom 0 in this build. */
%mr_monomialQ(u, x) := block([i, f, nx, ok],
  if atom(u) then is(u = x)
  elseif op(u) = "-" then %mr_monomialQ(part(u, 1), x)
  elseif op(u) = "^" then
    is(part(u, 1) = x) and freeof(x, part(u, 2))
      and not is(part(u, 2) = 0)
  elseif op(u) = "*" then (
    /* atom-first: op() is a hard error on atoms in this build */
    nx : 0, ok : true,
    for i : 1 thru length(u) do (
      f : part(u, i),
      if atom(f) then (
        if is(f = x) then nx : nx + 1
        elseif freeof(x, f) then true
        else ok : false
      )
      elseif op(f) = "^" and is(part(f, 1) = x)
        and freeof(x, part(f, 2)) and not is(part(f, 2) = 0)
      then nx : nx + 1
      elseif freeof(x, f) then true
      else ok : false
    ),
    ok and is(nx = 1)
  )
  else false)$

/* LeafCount[e] — the number of leaves in the expression tree
 * (Mathematica builtin: a leaf is a part with no subparts — the head
 * of a non-atom is a symbol, hence a leaf; LeafCount[1+x] = 3). */
%mr_leafCount(e) := block([i, s],
  if atom(e) then 1
  else (
    s : 1,
    for i : 1 thru length(e) do
      s : s + %mr_leafCount(part(e, i)),
    s))$

/* lookup a marker's bound value in the binding list
 * [m1 = v1, m2 = v2, ...]; false if absent (a cond that references
 * an unmatched marker fails closed) */
%mr_mk(m, B) := block([i, r, found],
  i : 1, r : false, found : false,
  while i <= length(B) and not found do
    if is(part(part(B, i), 1) = m) then block([],
      r : part(part(B, i), 2), found : true)
    else i : i + 1,
  r)$

/* ---- int-family + binomial predicates (Task 7a cluster B) -----------
 * Rubi's integrability guards (IntLinearQ / IntQuadraticQ /
 * IntBinomialQ — True iff the product integrates in terms of
 * non-hypergeometric / non-Appell functions) and the BinomialQ shape
 * test (a + b*x^n). Line-ports of the pinned Rubi definitions
 * (provenance in each comment); the .m IntegerQ / IGtQ / ILtQ /
 * RationalQ / IntegersQ / EqQ map onto the A1 ports — IntegerQ is
 * integerp on an exact value (Maxima auto-simplifies exact rational
 * arithmetic, MEASURED 2026-08-23: 1/2 + 1/2 -> 1, so IntegerQ[m+n]
 * is integerp(m+n)). Arity (class-1 census 2026-08-23): binomialQ
 * 2/3 and intBinomialQ 7/8/10 are the two multi-arity names — the Lisp
 * dispatchers in maxima_rubi_dispatch.lisp re-dispatch onto the
 * fixed-arity bodies here, named <name><arity>; intLinearQ (7) and
 * intQuadraticQ (8) are fixed-arity and need no dispatcher. */

/* Rubi :70/:379/:384 — IntegerQ, IGtQ[u,n] := IntegerQ[u] && u>n,
 * ILtQ[u,n] := IntegerQ[u] && u<n. Exact integers only (floats and
 * symbols fail, as in Mathematica). */
%mr_integerQ(e) := integerp(e)$
%mr_IGtQ(u, n) := %mr_integerQ(u) and is(u > n)$
%mr_ILtQ(u, n) := %mr_integerQ(u) and is(u < n)$

/* Rubi :379-:395  IGtQ[u_,n_] := IntegerQ[u] && u>n; likewise ILtQ, IGeQ,
   ILeQ — the generator's translation of the four heads (matcher
   translation fixes design 3.1; the bare is(u > n) dropped the integer
   test). IntegerQ is an explicit integer (integerp); u is evaluated once;
   the result is true or false, never unknown (the hand ports above, used
   by the IntLinearQ / IntBinomialQ / IntQuadraticQ ports, can answer
   unknown on a symbolic n). */
%mr_iGtQ(u, n) := if integerp(u) and is(u > n) = true then true else false$
%mr_iLtQ(u, n) := if integerp(u) and is(u < n) = true then true else false$
%mr_iGeQ(u, n) := if integerp(u) and is(u >= n) = true then true else false$
%mr_iLeQ(u, n) := if integerp(u) and is(u <= n) = true then true else false$

/* the distinct x-exponents of a CONFIRMED polynomial (callers gate on
 * %mr_polynomialQ), ascending — MEASURED 2026-08-23: sort() orders
 * exact rationals, member() on numbers returns a boolean, and op()
 * hard-errors on ATOMS (symbols included) in this build, so the
 * single-term case is gated on atom() first (expand(x) = x). */
%mr_exp_list(u, x) := block([e, i, p, L],
  e : expand(u),
  L : [],
  if atom(e) then (
    p : %mr_term_xexp(e, x),
    if p # false then L : append(L, [p])
  )
  else if op(e) = "+" then (
    for i : 1 thru length(e) do
      (
        p : %mr_term_xexp(part(e, i), x),
        if p # false and not member(p, L) then L : append(L, [p])
      )
  )
  else (
    p : %mr_term_xexp(e, x),
    if p # false then L : append(L, [p])),
  sort(L))$

/* Rubi :851  BinomialParts[u, x] — [a, b, n] iff u is equivalent to
 * a + b*x^n (n, b nonzero), else false. LINE port; the branches follow
 * the .m If-chain (polynomial / power / product / sum; First/Rest
 * split as first factor-or-term over the rest). DEVIATIONS, both
 * forced by Maxima's surface, documented:
 *  - 1/x stores as a "/" node [1, x], NOT a power x^(-1) (MEASURED
 *    2026-08-23), so the power branch also accepts the num = 1
 *    reciprocal shape (1/x -> [0, 1, -1]; 1/x^k -> [0, 1, -k]);
 *  - c/x (Mathematica's Times[c, x^(-1)] — the .m ProductQ branch)
 *    stores as ONE "/" node [c, x] and is NOT accepted; no class-1
 *    call site passes that shape (the factors of the (cx)^m (a+bx^n)^p
 *    products are powers and binomials, never bare reciprocals). */
%mr_binomial_parts(u, x) := block([d, L, i, f1, r1, L1, L2],
  if %mr_polynomialQ(u, x) then (
    d : %mr_degree(u, x),
    if d = 0 then false
    else (
      L : %mr_exp_list(u, x),
      if length(L) = 1 then [0, %mr_coeff(u, x, d), d]
      else if length(L) = 2 and is(part(L, 1) = 0)
      then [%mr_coeff(u, x, 0), %mr_coeff(u, x, d), d]
      else false
    )
  )
  elseif op(u) = "^" and is(part(u, 1) = x) and freeof(x, part(u, 2))
  then [0, 1, part(u, 2)]
  elseif op(u) = 'sqrt and is(part(u, 1) = x)
  /* Mathematica stores Sqrt[x] AS x^(1/2) (PowerQ is true); this
     Maxima build collapses exactly the 1/2 power to a sqrt node
     (MEASURED 2026-08-23: op(x^(1/2)) = 'sqrt, op(x^(3/2)) = "^") —
     accept the collapsed shape with the same reading (b = 1, n = 1/2).
     NOTE: op() in this build returns the SYMBOL 'sqrt for the sqrt
     head (is(op(sqrt(x)) = 'sqrt) is true; the string "sqrt" never
     matches) while special heads (^, +, *, /, -, [) stay strings. */
  then [0, 1, 1/2]
   elseif op(u) = "/" and is(num(u) = 1) then (
     if is(denom(u) = x) then [0, 1, -1]
     else if op(denom(u)) = "^" and is(part(denom(u), 1) = x)
       and freeof(x, part(denom(u), 2))
     then [0, 1, -part(denom(u), 2)]
     else false
   )
   /* unary minus: Maxima stores -x^(1/2) / -2*(1+x^(1/2)) as a "-"
      node (the .m's Times[-1, ...] goes through the ProductQ branch
      with the -1 factor: {-1*a, -1*b, n}). Polynomial minus terms
      (-x^2) never reach this branch — the polynomial branch above
      handles them. Cluster D dependency: %mr_trinomial_parts sum
      branch passes unary-minus terms (1 - x^(1/2) + ...). */
   elseif op(u) = "-" then (
     L : %mr_binomial_parts(part(u, 1), x),
     if atom(L) then false else [-part(L, 1), -part(L, 2), part(L, 3)]
   )
   elseif op(u) = "*" then (
    f1 : part(u, 1),
    r1 : part(u, 2),
    for i : 3 thru length(u) do r1 : r1 * part(u, i),
    if freeof(x, f1) then (
      L2 : %mr_binomial_parts(r1, x),
      if atom(L2) then false
      else [f1*part(L2, 1), f1*part(L2, 2), part(L2, 3)]
    )
    else if freeof(x, r1) then (
      L1 : %mr_binomial_parts(f1, x),
      if atom(L1) then false
      else [r1*part(L1, 1), r1*part(L1, 2), part(L1, 3)]
    )
    else (
      L1 : %mr_binomial_parts(f1, x),
      if atom(L1) then false
      else (
        L2 : %mr_binomial_parts(r1, x),
        if atom(L2) then false
        else if %mr_eqQ(part(L1, 1), 0) then (
          if %mr_eqQ(part(L2, 1), 0)
          then [0, part(L1, 2)*part(L2, 2), part(L1, 3) + part(L2, 3)]
          else if %mr_eqQ(part(L1, 3) + part(L2, 3), 0)
          then [part(L1, 2)*part(L2, 2), part(L1, 2)*part(L2, 1), part(L1, 3)]
          else false
        )
        else if %mr_eqQ(part(L2, 1), 0) then (
          if %mr_eqQ(part(L1, 3) + part(L2, 3), 0)
          then [part(L1, 2)*part(L2, 2), part(L1, 1)*part(L2, 2), part(L2, 3)]
          else false
        )
        else if is(part(L1, 3) = part(L2, 3))
          and %mr_eqQ(part(L1, 1)*part(L2, 2) + part(L1, 2)*part(L2, 1), 0)
        then [part(L1, 1)*part(L2, 1), part(L1, 2)*part(L2, 2), 2*part(L1, 3)]
        else false
      )
    )
  )
  elseif op(u) = "+" then (
    f1 : part(u, 1),
    r1 : part(u, 2),
    for i : 3 thru length(u) do r1 : r1 + part(u, i),
    if freeof(x, f1) then (
      L2 : %mr_binomial_parts(r1, x),
      if atom(L2) then false
      else [f1 + part(L2, 1), part(L2, 2), part(L2, 3)]
    )
    else if freeof(x, r1) then (
      L1 : %mr_binomial_parts(f1, x),
      if atom(L1) then false
      else [r1 + part(L1, 1), part(L1, 2), part(L1, 3)]
    )
    else (
      L1 : %mr_binomial_parts(f1, x),
      if atom(L1) then false
      else (
        L2 : %mr_binomial_parts(r1, x),
        if atom(L2) then false
        else if is(part(L1, 3) = part(L2, 3))
        then [part(L1, 1) + part(L2, 1), part(L1, 2) + part(L2, 2), part(L1, 3)]
        else false
      )
    )
  )
  else false)$

/* Rubi :549/:555  BinomialQ[u, x] / BinomialQ[u, x, n] — the 2/3-arg
 * dispatch targets (maxima_rubi_dispatch.lisp); the list-first-arg arm
 * is the .m ListQ[u] branch (the generator's list-packing). */
%mr_binomialQ2(u, x) := block([i, v],
  if not atom(u) and is(op(u) = "[") then (
    v : true,
    for i : 1 thru length(u) do
      if not %mr_binomialQ2(part(u, i), x) then v : false,
    v
  )
  else not atom(%mr_binomial_parts(u, x)))$

%mr_binomialQ3(u, x, n) := block([L, i, v],
  if not atom(u) and is(op(u) = "[") then (
    v : true,
    for i : 1 thru length(u) do
      if not %mr_binomialQ3(part(u, i), x, n) then v : false,
    v
  )
  else (
    L : %mr_binomial_parts(u, x),
    if atom(L) then false else is(part(L, 3) = n)))$

/* Rubi 1.1.1.2:44  IntLinearQ[a, b, c, d, m, n, x] — True iff
 * (a+b*x)^m (c+d*x)^n integrates in non-hypergeometric terms.
 * Fixed 7-arg (census: 4 call sites, all 7-arg); a-d unused by the
 * body, as in the .m. */
%mr_intLinearQ(a, b, c, d, m, n, x) :=
  %mr_IGtQ(m, 0) or %mr_IGtQ(n, 0)
  or %mr_integersQ([3*m, 3*n]) or %mr_integersQ([4*m, 4*n])
  or %mr_integersQ([2*m, 6*n]) or %mr_integersQ([6*m, 2*n])
  or %mr_ILtQ(m + n, -1)
  or %mr_integerQ(m + n) and %mr_rationalQ(m)$

/* Rubi 1.2.1.2:151  IntQuadraticQ[a, b, c, d, e, m, p, x] — True iff
 * (d+e*x)^m (a+b*x+c*x^2)^p integrates in non-Appell terms.
 * Fixed 8-arg (census: 21 call sites, all 8-arg). */
%mr_intQuadraticQ(a, b, c, d, e, m, p, x) :=
  %mr_integerQ(p) or %mr_IGtQ(m, 0)
  or %mr_integersQ([2*m, 2*p]) or %mr_integersQ([m, 4*p])
  or %mr_integersQ([m, p + 1/3])
     and (%mr_eqQ(c^2*d^2 - b*c*d*e + b^2*e^2 - 3*a*c*e^2, 0)
          or %mr_eqQ(c^2*d^2 - b*c*d*e - 2*b^2*e^2 + 9*a*c*e^2, 0))$

/* Rubi 1.1.3.2:118  IntBinomialQ[a, b, c, n, m, p, x] — True iff
 * (c*x)^m (a+b*x^n)^p integrates in non-hypergeometric terms. The
 * 7-arg dispatch target. The (m+1)/n disjunct is guarded on n # 0:
 * Maxima hard-errors 3/0 ("expt: undefined: 0 to a negative exponent",
 * MEASURED 2026-08-23) where Mathematica's Infinity answers
 * IntegerQ -> false. */
%mr_intBinomialQ7(a, b, c, n, m, p, x) :=
  %mr_IGtQ(p, 0)
  or (%mr_rationalQ(m) and %mr_integersQ([n, 2*p]))
  or is(n # 0) and %mr_integerQ((m + 1)/n + p)
  or (is(n = 2) or is(n = 4)) and %mr_integersQ([2*m, 4*p])
  or is(n = 2) and %mr_integerQ(6*p)
     and (%mr_integerQ(m) or %mr_integerQ(m - p))$

/* Rubi 1.1.3.3:73  IntBinomialQ[a, b, c, d, n, p, q, x] — True iff
 * (a+b*x^n)^p (c+d*x^n)^q integrates in non-Appell terms.
 * The 8-arg dispatch target. */
%mr_intBinomialQ8(a, b, c, d, n, p, q, x) :=
  %mr_integersQ([p, q])
  or %mr_IGtQ(p, 0) or %mr_IGtQ(q, 0)
  or (is(n = 2) or is(n = 4))
     and (%mr_integersQ([p, 4*q]) or %mr_integersQ([4*p, q]))
  or is(n = 2)
     and (%mr_integersQ([2*p, 2*q])
          or (%mr_integersQ([3*p, q]) and %mr_eqQ(b*c + 3*a*d, 0))
          or (%mr_integersQ([p, 3*q]) and %mr_eqQ(3*b*c + a*d, 0)))
  or is(n = 3) and (%mr_integersQ([p + 1/3, q]) or %mr_integersQ([q + 1/3, p]))
  or is(n = 3) and (%mr_integersQ([p + 2/3, q]) or %mr_integersQ([q + 2/3, p]))
     and %mr_eqQ(b*c + a*d, 0)$

/* Rubi 1.1.3.4:89  IntBinomialQ[a, b, c, d, e, m, n, p, q, x] —
 * True iff (e*x)^m (a+b*x^n)^p (c+d*x^n)^q integrates in non-Appell
 * terms. The 10-arg dispatch target. */
%mr_intBinomialQ10(a, b, c, d, e, m, n, p, q, x) :=
  %mr_integersQ([p, q])
  or %mr_IGtQ(p, 0) or %mr_IGtQ(q, 0)
  or is(n = 2)
     and (%mr_integersQ([m, 2*p, 2*q])
          or %mr_integersQ([2*m, p, 2*q])
          or %mr_integersQ([2*m, 2*p, q]))
  or is(n = 4) and (%mr_integersQ([m, p, 2*q]) or %mr_integersQ([m, 2*p, q]))
  or is(n = 2) and %mr_integersQ([m/2, p + 1/3, q])
     and (%mr_eqQ(b*c + 3*a*d, 0) or %mr_eqQ(b*c - 9*a*d, 0))
  or is(n = 2) and %mr_integersQ([m/2, q + 1/3, p])
     and (%mr_eqQ(a*d + 3*b*c, 0) or %mr_eqQ(a*d - 9*b*c, 0))
  or is(n = 3) and %mr_integersQ([(m - 1)/3, q, p - 1/2])
     and (%mr_eqQ(b*c - 4*a*d, 0) or %mr_eqQ(b*c + 8*a*d, 0)
          or %mr_eqQ(b^2*c^2 - 20*a*b*c*d - 8*a^2*d^2, 0))
  or is(n = 3) and %mr_integersQ([(m - 1)/3, p, q - 1/2])
     and (%mr_eqQ(4*b*c - a*d, 0) or %mr_eqQ(8*b*c + a*d, 0)
          or %mr_eqQ(8*b^2*c^2 + 20*a*b*c*d - a^2*d^2, 0))
  or is(n = 3)
     and (%mr_integersQ([m, q, 3*p]) or %mr_integersQ([m, p, 3*q]))
     and %mr_eqQ(b*c + a*d, 0)
   or is(n = 3)
      and (%mr_integersQ([(m + 2)/3, p + 2/3, q])
           or %mr_integersQ([m/3, q + 1/3, p]))$

 /* ---- sum / simpler predicates (Task 7a cluster C) -------------------
  * SumQ (:176) · SumSimplerQ (:774) + SumSimplerAuxQ (:784, the three
  * .m definitions: split-v, split-u, base) · SimplerQ (:677) ·
  * SimplerSqrtQ (:732) · NiceSqrtQ (:647) · FractionalPowerFactorQ
  * (:658 — the NiceSqrtQ dependency, pulled forward from cluster F) ·
  * NumericFactor (:1096) / NonnumericFactors (:1125) + the rest-of-sum
  * helper the SumSimplerAuxQ splits need.
  *
  * 5.50.0 representation traps pinned here (measured 2026-08-23):
  *  - is() returns the SYMBOL unknown for an undecidable relation and
  *    `if <unknown>` stays unevaluated — every relation is therefore
  *    `is(a op b) = true` (the bare `(a op b) = true` is NOT evaluated:
  *    it stays an equation);
  *  - complexp is a NOUN; the only atomic complex value is %i (-%i is
  *    a unary "-" node, not an atom) — the "Head === Complex" test is
  *    is(u = %i) plus its unary-minus form;
  *  - numberp covers exactly the real explicit numbers (integers,
  *    rationals — 1/2 is a "/" node and numberp is TRUE — and floats);
  *    %i / %pi / E / %inf are not numberp, and neither is a symbol;
  *  - sqrt normalizes aggressively where Mathematica holds:
  *    sqrt(x^2) -> abs(x) (Rubi: Sqrt[x^2] stays a power — the
  *    FractionalPowerFactorQ/niceSqrtQ x^2 probes pin the divergence),
  *    sqrt(2*x) -> sqrt(2)*sqrt(x), sqrt(1/(2*x)) ->
  *    1/(sqrt(2)*sqrt(x)), x^(1/2) -> a 'sqrt node, x^(-1/2) ->
  *    1/sqrt(x). Hence FractionalPowerFactorQ carries 'sqrt, "/" and
  *    unary "-" branches (the .m PowerQ branch alone cannot see the
  *    Maxima shapes);
  *  - Map[f, expr] keeps a non-list head in Mathematica — the
  *    NumericFactor/NonnumericFactors product branches are for-loops
  *    over the parts;
  *  - SimplerSqrtQ's LtQ sign tests stay pending on symbolic args in
  *    Rubi (the whole If declines, the rule does not fire) — the port
  *    reproduces the decline by answering false (never true) when
  *    either sign is unknown;
  *  - NumericFactor/NonnumericFactors sum branches take the .m's GCD
  *    fallback path; the LeafCount<50 ContentFactor kludge is omitted
  *    (a sum only reaches them through a product-of-sums inside a
  *    captured exponent — no class-1 corpus site has one), and the
  *    rational-denominator corner of the power branch (Maxima stores
  *    (1/2)^(1/2) as 1/sqrt(2), a "/" node the .m sees as the power
  *    2^(-1/2)) is unreachable at the 36 call sites (v is always an
  *    integer constant, u a symbol/number/monomial/integer-power).
  */

 /* Rubi :176  SumQ[_Plus] = True; SumQ[_] = False. A Maxima "+" node
    always has >= 2 parts (Mathematica's Plus flattens single terms). */
 %mr_sumQ(u) := block([],
   if atom(u) then false else is(op(u) = "+"))$

 /* NumberQ (Mathematica builtin) — explicit numbers only. numberp
    covers the reals (integer/rational/float, incl. the non-atom "/"
    node); %pi/E/symbols are not numbers (NumberQ[Pi] is false in
    Mathematica too); the complex forms are %i, -%i, a + b*i with both
    parts explicit reals. */
 %mr_numberQ(u) := block([],
   if numberp(u) then true
   else if is(u = %i) then true
   else if atom(u) then false
   else if is(op(u) = "-") then is(part(u, 1) = %i)
   else if is(op(u) = "+")
    then numberp(realpart(u)) and numberp(imagpart(u))
     and is(imagpart(u) # 0)
   else false)$

 /* ComplexNumberQ (Mathematica builtin) — an explicit complex with a
    nonzero imaginary part. complexp is a noun in this build. */
 %mr_complexNumberQ(u) := block([],
   if is(u = %i) then true
   else if atom(u) then false
   else if is(op(u) = "-") then is(part(u, 1) = %i)
   else if numberp(u) then is(imagpart(u) # 0) = true
   else if is(op(u) = "+")
    then numberp(realpart(u)) and numberp(imagpart(u))
     and is(imagpart(u) # 0) = true
   else false)$

  /* OrderedQ[{u, v}] — u and v in canonical order. Maxima's canonical
     order is the one orderlessp / ordergreatp test (describe("ordergreatp",
     exact); inpart / inflag : true read it — the matcher translation fixes'
     First/Rest ports, probes/matcher/14-mma-order-agreement); sort() is a
     total canonical order here (numbers first, %pi before bare symbols,
     x before 2*x — measured 2026-08-23). UPSTREAM-BUG NOTE (measured 2026-08-25): OrderedQ is
     never defined anywhere in the pinned Rubi 4 clone (whole-clone and
     whole-git-history grep; its only uses are the SimplerQ :710/:716/:727
     tie-breaks and SimplerSqrtQ :764 of IntegrationUtilityFunctions.m),
     so in the pinned Rubi those tie-breaks are unevaluated nouns and
     rules like 1.1.1.4's Not[SimplerQ[...]]-guarded rule decline on
     every symbolic binding. The acceptance corpus
     (MaximaSyntaxTestSuite) was generated by a Rubi build with a
     WORKING OrderedQ: e.g. 1.1.1.7 e4's expected elliptic answer
     exists only if the 1.1.1.4 rule 1/((a+b x) Sqrt[c+d x] Sqrt[e+f x]
     Sqrt[g+h x]) /; Not[SimplerQ[e+f x, c+d x]] && Not[SimplerQ[g+h x,
     c+d x]] FIRES on the sub-integral (it is the rule's binding
     guard — the .m derivation assumes the (c+d x) slot holds the
     first sqrt factor; the guard declines the swapped binding, which
     would make the Subst repl algebraically wrong). The sort() total
     order is the corpus-target reading, not the pinned-Rubi reading —
     the corpus is the acceptance target. sort() failure
     (errcatch -> []) fails closed. */
  %mr_orderedQ(u, v) := block([s],
    s : errcatch(sort([u, v])),
    if is(s = []) then false
    else is(part(s, 1) = [u, v]))$

 /* Rest[u] for a sum — Maxima has no Rest; the sum of parts 2..n. A
    one-part "sum" cannot occur ("+" nodes have >= 2 parts). */
 %mr_rest_sum(u) := block([i, n, lst],
   n : length(u),
   if is(n = 1) then part(u, 1)
   else (
     lst : [],
     for i : 2 thru n do lst : append(lst, [part(u, i)]),
     apply("+", lst)))$

 /* Rubi :1096  NumericFactor[u] — the real numeric factor. */
 %mr_numericFactor(u) := block([i, n, r, b, ex],
   if %mr_numberQ(u) then (
     if is(imagpart(u) = 0) then u
     else if is(realpart(u) = 0) then imagpart(u)
     else 1
   )
   /* a non-numeric atom (a symbol) has no numeric factor — the .m's
      final else */
   else if atom(u) then 1
   else if is(op(u) = "^") or is(op(u) = 'sqrt) then (
     b : part(u, 1),
     ex : if is(op(u) = 'sqrt) then 1/2 else part(u, 2),
     if %mr_rationalQ(b) and %mr_fractionQ(ex)
     then (
       if is(ex > 0) = true then 1/denom(b) else 1/denom(1/b)
     )
     else 1
   )
   else if is(op(u) = "*") then (
     n : length(u),
     r : 1,
     for i : 1 thru n do r : r * %mr_numericFactor(part(u, i)),
     r
   )
   /* a unary minus wraps the (non-numeric) product: the .m reads it as
      a product with a -1 factor, whose NumericFactor is -1 */
   else if is(op(u) = "-") then -%mr_numericFactor(part(u, 1))
   else if %mr_sumQ(u) then
     block([m, nst],
       m : %mr_numericFactor(part(u, 1)),
       nst : %mr_numericFactor(%mr_rest_sum(u)),
       if is(m < 0) = true and is(nst < 0) = true
       then -gcd(-m, -nst) else gcd(m, nst))
   else 1)$

 /* Rubi :1125  NonnumericFactors[u] — the product of the factors that
    are not real numbers. The .m's GCD-path sum shape keeps the Plus
    head (a sum of term/NF[u] — Map preserves non-list heads). */
 %mr_nonnumericFactors(u) := block([i, n, r, d, lst],
   if %mr_numberQ(u) then (
     if is(imagpart(u) = 0) then 1
     else if is(realpart(u) = 0) then %i
     else u
   )
   /* a non-numeric atom (a symbol) is its own nonnumeric factor */
   else if atom(u) then u
   /* a unary minus wraps the product: the .m's -1 factor has
      NonnumericFactors 1, so the nonnumeric factors pass through */
   else if is(op(u) = "-") then %mr_nonnumericFactors(part(u, 1))
   else if is(op(u) = "^") or is(op(u) = 'sqrt) then (
     if %mr_rationalQ(part(u, 1))
    and %mr_fractionQ(if is(op(u) = 'sqrt) then 1/2 else part(u, 2))
     then u / %mr_numericFactor(u)
     else u
   )
   else if is(op(u) = "*") then (
     n : length(u),
     r : 1,
     for i : 1 thru n do r : r * %mr_nonnumericFactors(part(u, i)),
     r
   )
   else if %mr_sumQ(u) then (
     d : %mr_numericFactor(u),
     lst : [],
     n : length(u),
     for i : 1 thru n do lst : append(lst, [part(u, i)/d]),
     apply("+", lst)
   )
   else u)$

 /* Rubi :658  FractionalPowerFactorQ — a factor is a complex constant
    or a fractional power. The 'sqrt / "/" / "-" branches are the Maxima
    shape adaptations (see the section note). */
 %mr_fractionalPowerFactorQ(u) := block([i, n, r],
   if atom(u) then is(u = %i)
   else if is(op(u) = "^") then %mr_fractionQ(part(u, 2))
   else if is(op(u) = 'sqrt) then true
   else if is(op(u) = "*") then (
     n : length(u),
     i : 0,
     r : false,
     while is(r = false) and i < n do (
       i : i + 1,
       r : %mr_fractionalPowerFactorQ(part(u, i))),
     r
   )
   else if is(op(u) = "/")
    then %mr_fractionalPowerFactorQ(num(u))
     or %mr_fractionalPowerFactorQ(denom(u))
   else if is(op(u) = "-") then %mr_fractionalPowerFactorQ(part(u, 1))
   else false)$

 /* Rubi :647  NiceSqrtQ — positive rational, or a squareroot without
    fractional-power / complex factors. Rt[u, 2] is sqrt(u) here;
    sqrt(x^2) -> abs(x) is the documented divergence corner (Rubi says
    false for x^2, the port says true — unreachable at the class-1
    discriminant sites). */
 %mr_niceSqrtQ(u) := block([],
   /* u is an explicit rational here — decidable, clean boolean */
   if %mr_rationalQ(u) then is(u > 0)
   else not(%mr_fractionalPowerFactorQ(sqrt(u))))$

 /* the SimplerQ part scan — Catch[Do[If[eq, Null, Throw[SimplerQ]]];
    False]: SimplerQ of the FIRST differing part pair, false if none
    (a return()/break() is loop-scoped in this build — the Task 4 trap —
    hence the found-flag while loop). */
 %mr_simplerQ_scan(u, v) := block([i, n, r, found],
   n : length(u),
   i : 0,
   r : false,
   found : false,
   while is(found = false) and i < n do (
     i : i + 1,
     if is(part(u, i) = part(v, i)) = false then (
       r : %mr_simplerQ(part(u, i), part(v, i)),
       found : true)),
   r)$

 /* Rubi :677  SimplerQ[u, v] — the structural simplicity order. The
    Re/Im, ComplexNumberQ, NumberQ, OrderedQ readings are the Maxima
    stand-ins pinned in the section note. */
 %mr_simplerQ(u, v) := block([],
   if integerp(u) then (
     if integerp(v) then (
       if is(u = v) then false
       /* value position: u, v are concrete integers, so the comparison
          is decidable — return the clean boolean (is(X) = true would
          leak the equation false = true on a false answer). */
       else if is(u = -v) then is(v < 0)
       else is(abs(u) < abs(v))
     )
     else true
   )
   else if integerp(v) then false
   else if %mr_fractionQ(u) then (
     if %mr_fractionQ(v) then (
       if is(denom(u) = denom(v))
       then %mr_simplerQ(num(u), num(v))
       else is(denom(u) < denom(v))
     )
     else true
   )
   else if %mr_fractionQ(v) then false
   else if is(realpart(u) = 0) and is(realpart(v) = 0)
    then %mr_simplerQ(imagpart(u), imagpart(v))
   else if %mr_complexNumberQ(u) then (
     if %mr_complexNumberQ(v) then (
       if is(realpart(u) = realpart(v))
       then %mr_simplerQ(imagpart(u), imagpart(v))
       else %mr_simplerQ(realpart(u), realpart(v))
     )
     else false
   )
   else if %mr_numberQ(u) then (
     if %mr_numberQ(v) then %mr_orderedQ(u, v) else true
   )
   else if %mr_numberQ(v) then false
   else if atom(u) then (
     if atom(v) then %mr_orderedQ(u, v) else true
   )
   else if atom(v) then false
   else if is(op(u) = op(v)) then (
     if is(length(u) = length(v)) then (
       if is(%mr_leafCount(u) = %mr_leafCount(v))
       then %mr_simplerQ_scan(u, v)
       /* leafcounts are concrete integers — decidable */
       else is(%mr_leafCount(u) < %mr_leafCount(v))
     )
     else is(length(u) < length(v))
   )
   else (
     if is(%mr_leafCount(u) = %mr_leafCount(v))
     then not(%mr_orderedQ(v, u))
     else is(%mr_leafCount(u) < %mr_leafCount(v))))$

 /* Rubi :732  SimplerSqrtQ[u, v] — Rt[u,2] simpler than Rt[v,2]. The
    pending-sign decline (Rubi's If unevaluated on undecidable LtQ) is
    reproduced by the unknown guard: undecidable sign -> false. */
 %mr_simplerSqrtQ(u, v) := block([sqrtu, sqrtv, zu, zv],
   zu : is(u < 0),
   zv : is(v < 0),
   if is(zv = true) and is(zu = false) then true
   else if is(zu = true) and is(zv = false) then false
   else if is(zv = 'unknown) or is(zu = 'unknown) then false
   else (
     sqrtu : sqrt(u),
     sqrtv : sqrt(v),
     if integerp(sqrtu) then (
       /* concrete integers / rationals / integer leafcounts — the
          comparisons are decidable, so a clean boolean is returned
          (the .m's PosQ[u]&&PosQ[v] branch is the BARE LeafCount
          comparison: a tie answers false, no OrderedQ tiebreak) */
       if integerp(sqrtv) then is(sqrtu < sqrtv) else true
     )
     else if integerp(sqrtv) then false
     else if %mr_rationalQ(sqrtu) then (
       if %mr_rationalQ(sqrtv) then is(sqrtu < sqrtv)
       else true
     )
     else if %mr_rationalQ(sqrtv) then false
     else if %mr_posQ(u) then (
       if %mr_posQ(v)
       then is(%mr_leafCount(sqrtu) < %mr_leafCount(sqrtv))
       else true
     )
     else if %mr_posQ(v) then false
     else if is(%mr_leafCount(sqrtu) < %mr_leafCount(sqrtv)) = true
      then true
     else if is(%mr_leafCount(sqrtv) < %mr_leafCount(sqrtu)) = true
      then false
     else not(%mr_orderedQ(v, u))))$

 /* Rubi :784  SumSimplerAuxQ — the three .m definitions in dispatch
    order: v a sum -> AND over v's terms (rational or aux(u, term)); u
    a sum -> OR over u's terms; base -> v # 0, equal NonnumericFactors,
    NF[u]/NF[v] < -1/2 (or = -1/2 with NF[u] < 0). */
 %mr_sumSimplerAuxQ(u, v) := block([i, n, r, m, nf],
   if %mr_sumQ(v) then (
     r : true,
     i : 0,
     n : length(v),
     while is(r = true) and i < n do (
       i : i + 1,
       if not(%mr_rationalQ(part(v, i)))
       and not(%mr_sumSimplerAuxQ(u, part(v, i)))
       then r : false),
     r
   )
   else if %mr_sumQ(u) then (
     r : false,
     i : 0,
     n : length(u),
     while is(r = false) and i < n do (
       i : i + 1,
       if is(%mr_sumSimplerAuxQ(part(u, i), v) = true) then r : true),
     r
   )
   else (
     m : %mr_numericFactor(u),
     nf : %mr_numericFactor(v),
     if is(v # 0) = true
    and is(%mr_nonnumericFactors(u) = %mr_nonnumericFactors(v)) = true
    and (is(m/nf < -1/2) = true
    or (is(m/nf = -1/2) = true and is(m < 0) = true))
     then true else false))$

 /* Rubi :774  SumSimplerQ[u, v] — is u + v simpler than u. The 36
    class-1 sites pass (exponent-parameter, integer-constant). */
 %mr_sumSimplerQ(u, v) := block([],
   if %mr_rationalQ(u) and %mr_rationalQ(v) then (
     if is(v = 0) then false
     else if is(v > 0) = true then is(u < -1) = true
     else is(u >= -v) = true
   )
   else %mr_sumSimplerAuxQ(expand(u), expand(v)))$

 /* ---- coefficient / degree machinery --------------------------------
 * Maxima's coefficient/degree/maxexpt are NOUNS in this build (T4 §6,
 * re-measured 2026-08-20), so %mr_coeff and the degree-based %mr_polyQ
 * are implemented over the term structure of the expanded numerator
 * (Rubi's Coeff :1246 works on Together[expr] too — same reduction). */

/* exponent of x in one monomial term of an expanded expression, or
   false if the term is not a monomial in x (x inside a function, a
   sum, a fraction, or a fractional/negative power) */
/* MEASURED (2026-08-20): op() and length() are hard errors on atoms in
   this build, so every structural walk tests atom() first. */
%mr_term_xexp(t, x) := block([i, f, p, ok],
  if atom(t) then (
    if is(t = x) then 1 else 0
  )
  elseif op(t) = "-" then %mr_term_xexp(part(t, 1), x)
  elseif op(t) = "*" then (
    p : 0,
    ok : true,
    for i : 1 thru length(t) do (
      f : part(t, i),
      if freeof(x, f) then true
      elseif is(f = x) then p : p + 1
      elseif op(f) = "^" and is(part(f, 1) = x)
        and integerp(part(f, 2)) and part(f, 2) > 0 then p : p + part(f, 2)
      else ok : false
    ),
    if ok then p else false
  )
  elseif op(t) = "/" then (
    /* a rational-coefficient term: Maxima stores 3/4*x^3 as the
       QUOTIENT node 3*x^3/4 (expand(3/4*x^3) = 3*x^3/4, measured
       2026-08-25 on 5.50.0/SBCL — this is what sent %mr_degree of
       (3/4)*x^3 to -1, derailing the 1.2.1.6 r5 reduction on 1.2.1.3
       e1058). The x-exponent lives entirely in the numerator; an
       x-bearing denominator makes the term a fraction, not a
       polynomial monomial. */
    if freeof(x, part(t, 2))
    then %mr_term_xexp(part(t, 1), x)
    else false
  )
  elseif op(t) = "^" then (
    /* a bare-power term as a WHOLE term after expand. base x with a
       positive integer exponent -> that exponent; x^(-1) is 1/x (a
       fraction) and x^(1/2)/x^a are not polynomial powers (review fix
       2026-08-20, bug B). A power with an x-FREE base (d^2, c^3, ...)
       is a degree-0 monomial — returning false here DROPPED every
       symbol-power constant term from coefficient/degree walks
       (measured 2026-08-25, 5.50.0/SBCL: %mr_coeff(d^2 - a*e^2/c, x, 0)
       lost the d^2, breaking 1.2.1.6 r4 on (e*x+d)^4 — 1.2.1.2 e2202
       wrong answer, resid 3.19). An x-bearing base that is not x
       itself ((a+b*x)^2) is not a monomial -> false. */
    if is(part(t, 1) = x) then (
      if integerp(part(t, 2)) and part(t, 2) > 0 then part(t, 2) else false
    )
    else if freeof(x, part(t, 1)) then 0
         else false
  )
  else false)$

/* the x-free coefficient of x^n in one monomial term (caller ensures
   %mr_term_xexp(t, x) = n) */
%mr_term_coeff(t, x, n) := block([i, f, c],
  if atom(t) then (
    /* the atom being x itself has coefficient 1 at n = 1 (the atom
       branch of %mr_term_xexp already knows x has exponent 1 — mirror
       it here; review fix 2026-08-20, bug A) */
    if is(t = x) then (if n = 1 then 1 else 0)
    else (if n = 0 then t else 0)
  )
  elseif op(t) = "-" then -%mr_term_coeff(part(t, 1), x, n)
  elseif op(t) = "*" then (
    c : 1,
    for i : 1 thru length(t) do (
      f : part(t, i),
      if freeof(x, f) then c : c * f
      elseif is(f = x) then n : n - 1
      elseif op(f) = "^" and is(part(f, 1) = x) then n : n - part(f, 2)
    ),
    c
  )
  elseif op(t) = "/" then (
    /* quotient node (3*x^3/4 — see the %mr_term_xexp /-case note);
       the caller ensures %mr_term_xexp(t, x) = n, which for an
       x-free denominator is the numerator's x-exponent */
    if freeof(x, part(t, 2))
    then %mr_term_coeff(part(t, 1), x, n)/part(t, 2)
    else 0
  )
  elseif op(t) = "^" then (
    /* a bare-power term (the caller ensures %mr_term_xexp(t, x) = n).
       A pure x-power has coefficient 1; an x-free-base power (d^2 —
       see the %mr_term_xexp /-note sibling fix) is its own constant
       coefficient at n = 0 and nothing elsewhere. */
    if is(part(t, 1) = x) then 1
    else if freeof(x, part(t, 1)) then (if n = 0 then t else 0)
         else 0
  )
  else 0)$

/* w : expand(u) — NOT expand(num(rat(u))) (measured 2026-08-25,
   5.50.0/SBCL): rat() on a symbolic polynomial EXTRACTS the symbolic
   content into the denominator (rat((2abc e^4 + ...)*x + ...) put c^3
   below the line), so num(rat(u)) was a c^3-RESCALED copy of u and
   every coefficient came back wrong (EQ_f/EQ_g false against the
   built-in coeff; 1.2.1.6 r4 on 1.2.1.2 e2202). Rubi's Coeff is
   Coefficient[expr, x, n] directly (Rubi.m, Together only as the
   fallback when the direct and Together values disagree) — no
   content manipulation — and every %mr_coeff call site feeds a
   PolyQ-confirmed polynomial, for which expand(u) is exact. A
   non-polynomial u yields fraction terms whose %mr_term_xexp is
   false -> 0 (conservative, matches the no-monomial reading). */
%mr_coeff3(u, x, n) := block([w, i, t, c, p],
  w : expand(u),
  if atom(w) then (
    p : %mr_term_xexp(w, x),
    if p # false and p = n then %mr_term_coeff(w, x, n) else 0
  )
  elseif op(w) = "+" then (
    c : 0,
    for i : 1 thru length(w) do (
      t : part(w, i),
      p : %mr_term_xexp(t, x),
      if p # false and p = n then c : c + %mr_term_coeff(t, x, n)
    ),
    c
  )
  else (
    p : %mr_term_xexp(w, x),
    if p # false and p = n then %mr_term_coeff(w, x, n) else 0
  ))$

/* The generator's powered-form Coeff: Coeff[u, base^power, n] is the
   coefficient of x^(power*n) when base is the integration variable. */
%mr_coeff4(u, base, power, n) := %mr_coeff3(u, base, power*n)$

%mr_coeff : lambda([u, base, a, [b]],
  if length(b) = 0 then %mr_coeff3(u, base, a)
  else %mr_coeff4(u, base, a, part(b, 1)))$

/* degree in x of a (confirmed) polynomial; degree(0) := 0 by contract
   (the 3-arg PolyQ's NeQ[Coeff[...],0] guard is what rejects 0).
   TOTAL (review fix 2026-08-20, bug B): never leaks a boolean — a term
   that is not a pure x-power (fraction, fractional/symbolic power, x
   inside a function) contributes the sentinel -1, so a non-polynomial
   whole yields -1 (Mathematica Degree parity: Degree[1/x, x] -> -1) */
%mr_degree(u, x) := block([e, i, d, p],
  e : expand(u),
  if is(e = 0) then 0
  elseif freeof(x, e) then 0
  elseif atom(e) then %mr_term_xexp(e, x)
  elseif op(e) = "+" then (
    d : -1,
    for i : 1 thru length(e) do (
      p : %mr_term_xexp(part(e, i), x),
      if p # false and p > d then d : p
    ),
    d
  )
  else (
    p : %mr_term_xexp(e, x),
    if p # false then p else -1))$

/* ---- PolyQ / LinearQ ------------------------------------------------
 * Maxima has no function overloading and no ... rest args in this
 * build (both measured 2026-08-20), and a wrong-arity call is a hard
 * error (measured) — so the 2-arg form (the probed form, and Rubi's
 * PolyQ[u,x]) owns the %mr_polyQ name; the 3-arg form (Rubi's
 * PolyQ[u,x,n], :505) is the internal %mr_polyDegQ. The generator's
 * table maps both arities to %mr_polyQ (1:1 rename) — an open
 * generator/gap for the Task 6 full-class generation (82 3-arg uses in
 * class 1); see the task-5 report. */
%mr_polyformQ(e, x) := block([i, ok],
  if atom(e) then (
    is(e = x) or freeof(x, e)
  )
  elseif op(e) = "-" then %mr_polyformQ(part(e, 1), x)
  elseif op(e) = "+" then (
    ok : true,
    for i : 1 thru length(e) do
      if is(%mr_polyformQ(part(e, i), x)) = false then ok : false,
    ok
  )
  elseif op(e) = "*" then (
    ok : true,
    for i : 1 thru length(e) do
      if is(%mr_polyformQ(part(e, i), x)) = false then ok : false,
    ok
  )
  elseif op(e) = "^" then (
    /* a polynomial power needs an explicit nonnegative integer exponent
       (x^a with symbolic a is not a polynomial, as in Mathematica's
       PolynomialQ) */
    if integerp(part(e, 2)) and is(part(e, 2) >= 0)
      and freeof(x, part(e, 2))
    then %mr_polyformQ(part(e, 1), x)
    else false
  )
  else freeof(x, e))$

/* Rubi :501  PolyQ[u,x] := PolynomialQ[u,x] || PolynomialQ[Together[u],x]
   For a rational u the two disjuncts coincide (Together changes only
   the num/den split), so one together + a structural numerator check.
   The denominator-free check catches the pseudo-polynomial case the
   .m comment warns about (PolynomialQ on an uncancelled pseudo-rat). */
%mr_polyQ(u, x) := block([v],
  v : %mr_together(u),
  freeof(x, denom(v)) and %mr_polyformQ(num(v), x))$

/* Rubi :505  PolyQ[u,x,n] := PolyQ[u,x] && EqQ[Exponent[u,x],n]
                        && NeQ[Coefficient[u,x,n],0]
   (the If/With split in the source is equivalent once v = Together[u]
   is computed once) */
%mr_polyDegQ(u, x, n) := block([v],
  v : %mr_together(u),
  %mr_polyQ(v, x) and %mr_eqQ(%mr_degree(v, x), n)
    and %mr_neQ(%mr_coeff(v, x, n), 0))$

/* ---- PolyQ power forms (Task 6 Step 0) ------------------------------
 * Rubi :512/:522/:533  PolyQ[u, x^n] / PolyQ[u, x^v] / PolyQ[u, x^v, n].
 * The base is an EXPRESSION B (x, or a capture value such as a + b*x —
 * the class-1 uses PolyQ[Pq, v^n] pass the capture v as base): u is a
 * polynomial in B^v iff, with t a fresh symbol,
 *   r = expand(subst(t, B, u))
 * has no t in any denominator and every term is a t-monomial whose t-
 * exponent k is a non-negative multiple of v. For B = x this is exactly
 * the brief's contract (no x in a denominator, every term's x-exponent
 * a non-negative multiple of v). The degree form matches Rubi :533
 * exactly: EqQ[Expon[u,x^v],n] is max k/v = n (strict). The
 * NeQ[Coeff[u,x^v,n],0] clause is subsumed — when d = n some term has
 * k/v = n, and its coefficient is structurally nonzero after expand
 * (a zero coefficient would drop the term). u = 0 is rejected by
 * guard (Rubi's Expon[0,x^v] is -Infinity, so no degree form holds). */
%mr_polyPowerQ(u, B, v) := block([t, r, i, term, k, ok],
  t : gensym("mrp"),
  r : expand(subst(t, B, u)),
  if is(freeof(t, denom(r))) = false then false
  else if not numberp(v) or v < 0 then false
  else (
    if v = 0 then is(freeof(t, r))
    else (
      /* %mr_term_xexp returns false (never negative) on a term that is
         not a pure non-negative power of the variable, so k >= 0 holds
         whenever k # false */
      ok : true,
      if atom(r) then (
        k : %mr_term_xexp(r, t),
        if k = false or not integerp(k/v) then ok : false
      )
      else (
        for i : 1 thru length(r) do (
          term : part(r, i),
          k : %mr_term_xexp(term, t),
          if k = false or not integerp(k/v) then ok : false
        )
      ),
      ok
    )
  ))$

%mr_polyDegPowerQ(u, B, v, n) := block([t, r, i, term, k, d],
  if is(%mr_polyPowerQ(u, B, v)) = false then false
  else (
    /* recompute r identically to %mr_polyPowerQ and take the maximum
       k/v (the degree in B^v); a non-monomial term cannot occur here
       (polyPowerQ true), so k # false for every term */
     t : gensym("mrp"),
     r : expand(subst(t, B, u)),
     /* u = 0: Rubi's Expon[0, x^v] is -Infinity, so no degree form
        holds (the atom-0 term would read as a degree-0 monomial and
        over-fire at n = 0) */
     if is(r = 0) = true then false
     else (
       d : 0,
       if atom(r) then (
         k : %mr_term_xexp(r, t),
         if k # false and k/v > d then d : k/v
       )
       else (
         for i : 1 thru length(r) do (
           term : part(r, i),
           k : %mr_term_xexp(term, t),
           if k # false and k/v > d then d : k/v
         )
       ),
       is(d = n)
     )
   ))$

/* Rubi :1373-1376  LinearQ[u,x] — the .m's ListQ arm restored
   (FIX B2, 2026-09-01, class-3 deferred campaign): a list is linear
   iff every member is (the .m Catch[Scan[...]] = all-or-none). The
   old "list form dropped" claim held for class 1/2 only — the
   class-3 emitted conds DO emit list calls (%mr_linearQ([u, v], x)
   from .m LinearQ[{u, v}] — 3.2.1 r5/r6/r23/r24, 3.2.2 r13/r14/r15),
   which the scalar-only port 0-guarded (the list reached
   %mr_polyDegQ, which fails closed on a non-polynomial). */
%mr_linearQ(u, x) := block([i, v],
  if not atom(u) and is(op(u) = "[") then (
    v : true,
    for i : 1 thru length(u) do
      if not %mr_linearQ(part(u, i), x) then v : false,
    v
  )
  else %mr_polyDegQ(u, x, 1))$

/* ---- trinomial/quadratic/binomial-degree predicates (Task 7a
 * cluster D) ----------------------------------------------------------
 * The shape predicates of the 1.3/1.4 normalization rule families:
 * QuadraticQ, TrinomialQ (+ TrinomialParts), BinomialDegree, and the
 * four *MatchQ "simple shape" tests. Line-ports of the pinned Rubi
 * definitions (provenance per function); the .m ListQ[u] arm is the
 * generator's list-packing. The *MatchQ ports call %mr_matchQ
 * (MR-MATCH, maxima_rubi_dispatch.lisp) with a pattern string whose
 * pattern variables are fresh marker names and whose (MRArg k) parts are
 * x / x^2; the cond is a lambda over the binding list, run on every
 * complete binding, so a unit-coefficient term (a bare x^n / x^(2n)
 * summand) whose coefficient-absorbing binding fails the freeof cond
 * goes on to the next binding. The defmatch-era cluster-A3 matcher and
 * its divergence notes are gone; these predicates follow MR-MATCH's
 * semantics (matcher regression suite, test/matcher/). */

/* Rubi :846  BinomialDegree[u,x] := BinomialParts[u,x][[3]]. The .m
   False[[3]] hard-errors on a non-binomial; the port fails closed
   with false (every class-1 call site gates on BinomialQ[u,x] first). */
%mr_binomialDegree(u, x) := block([L],
  L : %mr_binomial_parts(u, x),
  if atom(L) then false else part(L, 3))$

/* Rubi :1380  QuadraticQ[u,x] — a degree-2 polynomial that is not the
   a*x^2 monomial. The .m ===0 (IdentityQ) maps onto is(c = 0): this
   build's is(a = b) is true/false, never unknown (RC1), and
   is(e = 0) = true iff e simplifies to the structural 0. */
%mr_quadraticQ(u, x) := block([i, v],
  if not atom(u) and is(op(u) = "[") then (
    v : true,
    for i : 1 thru length(u) do
      if not %mr_quadraticQ(part(u, i), x) then v : false,
    v
  )
  else %mr_polyDegQ(u, x, 2)
       and not (is(%mr_coeff(u, x, 0) = 0)
                and is(%mr_coeff(u, x, 1) = 0)))$

/* Rubi :929  TrinomialParts[u,x] — [a, b, c, n] iff u is equivalent
   to a + b*x^n + c*x^(2*n) (n, b, c nonzero), else false. LINE port
   of the .m If-chain (polynomial / power / product / sum; First/Rest
   split as first term-or-factor over the rest). CoefficientList is
   the [c0..cd] walk over %mr_coeff (degree-gated; %mr_coeff is exact
   on a confirmed polynomial). DEVIATIONS, documented:
    - the .m's Drop chain Drop[Drop[lst,{m}],1],-1 (m = (Length+1)/2)
     scans coefficients x^(n+2)..x^(2n-1) ONLY — the coefficients
     x^(n-1) and x^(n+1) (the ones adjacent to the middle term) are
     UNCHECKED; the port reproduces the scan exactly (the 1+x^2+x^3+x^4
     probe pins the Rubi-faithful laxness);
   - the .m's :994 b-slot (lst3[[2]] where the reconstruction says
     lst2[[2]] — a typo in the pinned clone, the branch reachable only
     through a binomial-first/trinomial-rest sum split that
     auto-combining makes unreachable) is ported as written. */
%mr_trinomial_parts(u, x) := block([d, L, i, m, ok, f1, r1, L1, L2, L3, L4],
  if %mr_polynomialQ(u, x) then (
    d : %mr_degree(u, x),
    L : [],
    for i : 0 thru d do L : append(L, [%mr_coeff(u, x, i)]),
    if is(length(L) < 3) or evenp(length(L))
    or %mr_eqQ(part(L, (length(L) + 1)/2), 0)
    then false
    else (
      m : (length(L) + 1)/2,
      ok : true,
      for i : m + 2 thru 2*m - 2 do
        if %mr_eqQ(part(L, i), 0) then ok : false,
      if ok
      then [part(L, 1), part(L, m), part(L, length(L)), (length(L) - 1)/2]
      else false
    )
  )
  elseif not atom(u) and op(u) = "^" then (
    /* PowerQ[u] && EqQ[u[[2]], 2]: the square of a binomial */
    if %mr_eqQ(part(u, 2), 2) then (
      L1 : %mr_binomial_parts(part(u, 1), x),
      if atom(L1) or %mr_eqQ(part(L1, 1), 0) then false
      else [part(L1, 1)^2, 2*part(L1, 1)*part(L1, 2), part(L1, 2)^2, part(L1, 3)]
    )
    else false
  )
  elseif op(u) = "-" then (
    /* the .m's Times[-1, u] goes through the ProductQ branch with
       the -1 factor: {-1*a, -1*b, -1*c, n} */
    L : %mr_trinomial_parts(part(u, 1), x),
    if atom(L) then false
    else [-part(L, 1), -part(L, 2), -part(L, 3), part(L, 4)]
  )
  elseif not atom(u) and op(u) = "*" then (
    f1 : part(u, 1),
    r1 : part(u, 2),
    for i : 3 thru length(u) do r1 : r1 * part(u, i),
    if freeof(x, f1) then (
      L2 : %mr_trinomial_parts(r1, x),
      if atom(L2) then false
      else [f1*part(L2, 1), f1*part(L2, 2), f1*part(L2, 3), part(L2, 4)]
    )
    else if freeof(x, r1) then (
      L1 : %mr_trinomial_parts(f1, x),
      if atom(L1) then false
      else [r1*part(L1, 1), r1*part(L1, 2), r1*part(L1, 3), part(L1, 4)]
    )
    else (
      L1 : %mr_binomial_parts(f1, x),
      if atom(L1) then false
      else (
        L2 : %mr_binomial_parts(r1, x),
        if atom(L2) then false
        else if %mr_eqQ(part(L1, 3), part(L2, 3))
          and %mr_neQ(part(L1, 1)*part(L2, 2) + part(L1, 2)*part(L2, 1), 0)
        then [part(L1, 1)*part(L2, 1),
              part(L1, 1)*part(L2, 2) + part(L1, 2)*part(L2, 1),
              part(L1, 2)*part(L2, 2), part(L1, 3)]
        else false
      )
    )
  )
  elseif %mr_sumQ(u) then (
    f1 : part(u, 1),
    r1 : %mr_rest_sum(u),
    if freeof(x, f1) then (
      L2 : %mr_trinomial_parts(r1, x),
      if atom(L2) then false
      else [f1 + part(L2, 1), part(L2, 2), part(L2, 3), part(L2, 4)]
    )
    else if freeof(x, r1) then (
      L1 : %mr_trinomial_parts(f1, x),
      if atom(L1) then false
      else [r1 + part(L1, 1), part(L1, 2), part(L1, 3), part(L1, 4)]
    )
    else (
      L1 : %mr_trinomial_parts(f1, x),
      if atom(L1) then (
        L3 : %mr_binomial_parts(f1, x),
        if atom(L3) then false
        else (
          L2 : %mr_trinomial_parts(r1, x),
          if atom(L2) then (
            L4 : %mr_binomial_parts(r1, x),
            if atom(L4) then false
            else if %mr_eqQ(part(L3, 3), 2*part(L4, 3))
              then [part(L3, 1) + part(L4, 1), part(L4, 2),
                    part(L3, 2), part(L4, 3)]
              else if %mr_eqQ(part(L4, 3), 2*part(L3, 3))
              then [part(L3, 1) + part(L4, 1), part(L3, 2),
                    part(L4, 2), part(L3, 3)]
              else false
          )
          else if %mr_eqQ(part(L3, 3), part(L2, 4))
            and %mr_neQ(part(L3, 2) + part(L2, 2), 0)
          then [part(L3, 1) + part(L2, 1), part(L3, 2) + part(L2, 2),
                part(L2, 3), part(L2, 4)]
          /* the .m :994 b-slot as written (see the DEVIATIONS note) */
          else if %mr_eqQ(part(L3, 3), 2*part(L2, 4))
            and %mr_neQ(part(L3, 2) + part(L2, 3), 0)
          then [part(L3, 1) + part(L2, 1), part(L3, 2),
                part(L3, 2) + part(L2, 3), part(L2, 4)]
          else false
        )
      )
      else (
        L2 : %mr_trinomial_parts(r1, x),
        if atom(L2) then (
          L4 : %mr_binomial_parts(r1, x),
          if atom(L4) then false
          else if %mr_eqQ(part(L4, 3), part(L1, 4))
            and %mr_neQ(part(L1, 2) + part(L4, 2), 0)
          then [part(L1, 1) + part(L4, 1), part(L1, 2) + part(L4, 2),
                part(L1, 3), part(L1, 4)]
          else if %mr_eqQ(part(L4, 3), 2*part(L1, 4))
            and %mr_neQ(part(L1, 3) + part(L4, 2), 0)
          then [part(L1, 1) + part(L4, 1), part(L1, 2),
                part(L1, 3) + part(L4, 2), part(L1, 4)]
          else false
        )
        else if %mr_eqQ(part(L1, 4), part(L2, 4))
          and %mr_neQ(part(L1, 2) + part(L2, 2), 0)
          and %mr_neQ(part(L1, 3) + part(L2, 3), 0)
        then [part(L1, 1) + part(L2, 1), part(L1, 2) + part(L2, 2),
              part(L1, 3) + part(L2, 3), part(L1, 4)]
        else false
      )
    )
  )
  else false)$

/* Rubi :568  TrinomialQ[u,x] — ListQ[TrinomialParts[u,x]] &&
   Not[QuadraticQ[u,x]] && Not[MatchQ[u, w_^2 /; BinomialQ[w,x]]]: a
   trinomial that is neither a quadratic (the n = 1 corner) nor the
   square of a binomial (the perfect-square corner the Chebyshev
   rules handle separately). */
%mr_trinomialQ(u, x) := block([i, v, L],
  if not atom(u) and is(op(u) = "[") then (
    v : true,
    for i : 1 thru length(u) do
      if not %mr_trinomialQ(part(u, i), x) then v : false,
    v
  )
  else (
    L : %mr_trinomial_parts(u, x),
    not atom(L) and not %mr_quadraticQ(u, x)
    and not %mr_matchQ(u, "(Power (Pattern |_mr_triQ_r1mq1_w| (Blank)) 2)", [],
      lambda([%mr_mqb],
        %mr_binomialQ2(%mr_mk(_mr_triQ_r1mq1_w, %mr_mqb), x)))))$

/* Rubi :1420  LinearMatchQ[u,x] — MatchQ[u, a_.+b_.*x /; FreeQ[{a,b},x]].
   The x literal in the product factor cannot be absent (see the
   section note for the corner where the WHOLE b_*x term is absent —
   unreachable at the call sites, LinearQ-guarded). */
%mr_linearMatchQ(u, x) := block([i, v],
  if not atom(u) and is(op(u) = "[") then (
    v : true,
    for i : 1 thru length(u) do
      if not %mr_linearMatchQ(part(u, i), x) then v : false,
    v
  )
  else %mr_matchQ(u, "(Plus (Optional (Pattern |_mr_linMq_r1mq1_a| (Blank))) (Times (MRArg 1) (Optional (Pattern |_mr_linMq_r1mq1_b| (Blank)))))", [x],
    lambda([%mr_mqb],
      freeof(x, %mr_mk(_mr_linMq_r1mq1_a, %mr_mqb))
      and freeof(x, %mr_mk(_mr_linMq_r1mq1_b, %mr_mqb)))))$

/* Rubi :1427  QuadraticMatchQ[u,x] — MatchQ[u, a_.+b_.*x+c_.*x^2 /;
   FreeQ[{a,b,c},x]] || MatchQ[u, a_.+c_.*x^2 /; FreeQ[{a,c},x]]. The
   literal x / x^2 powers cannot be absent (the a + b*x corner is the
   2nd pattern's absent x^2 term — unreachable at the call sites,
   QuadraticQ-guarded). */
%mr_quadraticMatchQ(u, x) := block([i, v],
  if not atom(u) and is(op(u) = "[") then (
    v : true,
    for i : 1 thru length(u) do
      if not %mr_quadraticMatchQ(part(u, i), x) then v : false,
    v
  )
  else %mr_matchQ(u,
    "(Plus (Optional (Pattern |_mr_quadMq_r1mq1_a| (Blank))) (Times (MRArg 1) (Optional (Pattern |_mr_quadMq_r1mq1_b| (Blank)))) (Times (Optional (Pattern |_mr_quadMq_r1mq1_c| (Blank))) (MRArg 2)))", [x, x^2],
    lambda([%mr_mqb],
      freeof(x, %mr_mk(_mr_quadMq_r1mq1_a, %mr_mqb))
      and freeof(x, %mr_mk(_mr_quadMq_r1mq1_b, %mr_mqb))
      and freeof(x, %mr_mk(_mr_quadMq_r1mq1_c, %mr_mqb))))
  or %mr_matchQ(u, "(Plus (Optional (Pattern |_mr_quadMq_r2mq1_a| (Blank))) (Times (Optional (Pattern |_mr_quadMq_r2mq1_c| (Blank))) (MRArg 1)))", [x^2],
    lambda([%mr_mqb],
      freeof(x, %mr_mk(_mr_quadMq_r2mq1_a, %mr_mqb))
      and freeof(x, %mr_mk(_mr_quadMq_r2mq1_c, %mr_mqb)))))$

/* Rubi :1444  BinomialMatchQ[u,x] — MatchQ[u, a_.+b_.*x^n_. /;
   FreeQ[{a,b,n},x]]. The orderless partition search tries every
   stored order of the pattern factors, and the freeof cond is
   threaded through the search, so a bare x^n term binds b = 1 and
   the real n (the coefficient-absorbing binding fails freeof and is
   backtracked away). */
%mr_binomialMatchQ(u, x) := block([i, v],
  if not atom(u) and is(op(u) = "[") then (
    v : true,
    for i : 1 thru length(u) do
      if not %mr_binomialMatchQ(part(u, i), x) then v : false,
    v
  )
  else %mr_matchQ(u, "(Plus (Optional (Pattern |_mr_binMq_r1mq1_a| (Blank))) (Times (Optional (Pattern |_mr_binMq_r1mq1_b| (Blank))) (Power (MRArg 1) (Optional (Pattern |_mr_binMq_r1mq1_n| (Blank))))))", [x],
    lambda([%mr_mqb],
      freeof(x, %mr_mk(_mr_binMq_r1mq1_a, %mr_mqb))
      and freeof(x, %mr_mk(_mr_binMq_r1mq1_b, %mr_mqb))
      and freeof(x, %mr_mk(_mr_binMq_r1mq1_n, %mr_mqb)))))$

/* Rubi :1458  TrinomialMatchQ[u,x] — MatchQ[u, a_.+b_.*x^n_.+c_.*x^j_.
   /; FreeQ[{a,b,c,n},x] && EqQ[j-2*n,0]] (j is not FreeQ'd: j = 2n
   and n x-free implies it). The orderless partition search tries
   every stored order of the three pattern factors, and the j = 2*n
   cond is threaded through the search, so the Rubi-faithful n/j
   assignment is found even when Maxima's stored order presents the
   other assignment first (and a unit-coefficient term no longer
   traps the search on the coefficient-absorbing binding). */
%mr_trinomialMatchQ(u, x) := block([i, v],
   if not atom(u) and is(op(u) = "[") then (
    v : true,
    for i : 1 thru length(u) do
      if not %mr_trinomialMatchQ(part(u, i), x) then v : false,
    v
  )
  else %mr_matchQ(u,
    "(Plus (Optional (Pattern |_mr_triMq_r1mq1_a| (Blank))) (Times (Optional (Pattern |_mr_triMq_r1mq1_b| (Blank))) (Power (MRArg 1) (Optional (Pattern |_mr_triMq_r1mq1_n| (Blank))))) (Times (Optional (Pattern |_mr_triMq_r1mq1_c| (Blank))) (Power (MRArg 2) (Optional (Pattern |_mr_triMq_r1mq1_j| (Blank))))))", [x, x],
    lambda([%mr_mqb],
      freeof(x, %mr_mk(_mr_triMq_r1mq1_a, %mr_mqb))
      and freeof(x, %mr_mk(_mr_triMq_r1mq1_b, %mr_mqb))
      and freeof(x, %mr_mk(_mr_triMq_r1mq1_c, %mr_mqb))
      and freeof(x, %mr_mk(_mr_triMq_r1mq1_n, %mr_mqb))
      and %mr_eqQ(%mr_mk(_mr_triMq_r1mq1_j, %mr_mqb)
            - 2*%mr_mk(_mr_triMq_r1mq1_n, %mr_mqb), 0))))$

/* ---- generalized binomial/trinomial predicates (Task 7a cluster E) --
 * The six Generalized* shapes of the 1.4.2 normalization rules:
 * GeneralizedBinomialQ/MatchQ/Degree and GeneralizedTrinomialQ/MatchQ/
 * Degree (pinned Rubi :579-593, :1016-1088, :1450-1468). The .m Parts
 * definitions are pattern rules, so the ports match their patterns with
 * %mr_matchQ_bindings (maxima_rubi_dispatch.lisp) and read the accepted
 * binding list back with %mr_mk.
 *
 * The product cases (a_*u_, x^m_*u_) keep the port's guard against the
 * no-progress binding (a := 1 / u := u itself): the recursion on the
 * unchanged u would not terminate. The cond lambda reads the caller's u
 * (Maxima's dynamic scope: the matcher calls the lambda while the
 * function that holds u is running).
 *
 * GeneralizedTrinomialParts pins the POSITIVE orientation (n - q > 0)
 * in the sum-pattern cond: the .m's EqQ[r, 2*n-q] is satisfied by
 * either endpoint as q, while the GeneralizedTrinomialDegree use at the
 * 1.4.2 call sites (EqQ against a BinomialDegree) can only see the
 * positive gap. The boolean GeneralizedTrinomialQ / MatchQ answers are
 * unchanged (a 3-term progression always has a positive orientation). */

/* Rubi :1022-1045  GeneralizedBinomialParts[u,x] — [a, b, n, q] iff
   u ~ a*x^q + b*x^n with n - q > 0 (the .m's PosQ[n-q]), else false.
   Branch order: unary minus / sum pattern / a_*u_ (scale) /
   x^m_*u_ over a generalized binomial (shift) / x^m_*u_ over an
   ordinary binomial (the q := m shift of a + b*x^n). */
%mr_generalizedBinomial_parts(u, x) := block([r, B, A, U, L, M],
  if not atom(u) and is(op(u) = "-") then (
    L : %mr_generalizedBinomial_parts(part(u, 1), x),
    if atom(L) then false
    else [-part(L, 1), -part(L, 2), part(L, 3), part(L, 4)]
  )
  else (
    r : false,
    if not atom(u) and is(op(u) = "+") then (
      B : %mr_matchQ_bindings(
        u,
        "(Plus (Times (Optional (Pattern |_mr_gbp1_r1mq1_a| (Blank))) (Power (MRArg 1) (Optional (Pattern |_mr_gbp1_r1mq1_q| (Blank))))) (Times (Optional (Pattern |_mr_gbp1_r1mq1_b| (Blank))) (Power (MRArg 2) (Optional (Pattern |_mr_gbp1_r1mq1_n| (Blank))))))", [x, x],
        lambda([%mr_mqb],
          freeof(x, %mr_mk(_mr_gbp1_r1mq1_a, %mr_mqb))
          and freeof(x, %mr_mk(_mr_gbp1_r1mq1_b, %mr_mqb))
          and freeof(x, %mr_mk(_mr_gbp1_r1mq1_n, %mr_mqb))
          and freeof(x, %mr_mk(_mr_gbp1_r1mq1_q, %mr_mqb))
          and %mr_posQ(
            %mr_mk(_mr_gbp1_r1mq1_n, %mr_mqb)
            - %mr_mk(_mr_gbp1_r1mq1_q, %mr_mqb)))
      ),
      if not atom(B) then r : [
        %mr_mk(_mr_gbp1_r1mq1_a, B),
        %mr_mk(_mr_gbp1_r1mq1_b, B),
        %mr_mk(_mr_gbp1_r1mq1_n, B),
        %mr_mk(_mr_gbp1_r1mq1_q, B)
      ]
    ),
    if atom(r) and not atom(u) and is(op(u) = "*") then (
      B : %mr_matchQ_bindings(
        u,
        "(Times (Pattern |_mr_gbp2_r1mq1_a| (Blank)) (Pattern |_mr_gbp2_r1mq1_u| (Blank)))", [],
        lambda([%mr_mqb],
          freeof(x, %mr_mk(_mr_gbp2_r1mq1_a, %mr_mqb))
          and not is(%mr_mk(_mr_gbp2_r1mq1_a, %mr_mqb) = 1)
          and not is(
            %mr_mk(_mr_gbp2_r1mq1_u, %mr_mqb) = u))
      ),
      if not atom(B) then (
        A : %mr_mk(_mr_gbp2_r1mq1_a, B),
        U : %mr_mk(_mr_gbp2_r1mq1_u, B),
        L : %mr_generalizedBinomial_parts(U, x),
        if atom(L) then false
        else r : [A*part(L, 1), A*part(L, 2), part(L, 3), part(L, 4)]
      )
    ),
    if atom(r) and not atom(u) and is(op(u) = "*") then (
      B : %mr_matchQ_bindings(
        u,
        "(Times (Pattern |_mr_gbp3_r1mq1_u| (Blank)) (Power (MRArg 1) (Optional (Pattern |_mr_gbp3_r1mq1_m| (Blank)))))", [x],
        lambda([%mr_mqb],
          freeof(x, %mr_mk(_mr_gbp3_r1mq1_m, %mr_mqb))
          and not is(
            %mr_mk(_mr_gbp3_r1mq1_u, %mr_mqb) = u))
      ),
      if not atom(B) then (
        M : %mr_mk(_mr_gbp3_r1mq1_m, B),
        U : %mr_mk(_mr_gbp3_r1mq1_u, B),
        L : %mr_generalizedBinomial_parts(U, x),
        if atom(L) then false
        else if %mr_neQ(M + part(L, 3), 0)
          and %mr_neQ(M + part(L, 4), 0)
        then r : [part(L, 1), part(L, 2),
                  M + part(L, 3), M + part(L, 4)]
      )
    ),
    if atom(r) and not atom(u) and is(op(u) = "*") then (
      B : %mr_matchQ_bindings(
        u,
        "(Times (Pattern |_mr_gbp4_r1mq1_u| (Blank)) (Power (MRArg 1) (Optional (Pattern |_mr_gbp4_r1mq1_m| (Blank)))))", [x],
        lambda([%mr_mqb],
          freeof(x, %mr_mk(_mr_gbp4_r1mq1_m, %mr_mqb))
          and not is(
            %mr_mk(_mr_gbp4_r1mq1_u, %mr_mqb) = u))
      ),
      if not atom(B) then (
        M : %mr_mk(_mr_gbp4_r1mq1_m, B),
        U : %mr_mk(_mr_gbp4_r1mq1_u, B),
        L : %mr_binomial_parts(U, x),
        if atom(L) then false
        else if %mr_neQ(M + part(L, 3), 0)
        then r : [part(L, 1), part(L, 2), M + part(L, 3), M]
      )
    ),
    if atom(r) then false else r
  ))$

/* Rubi :579  GeneralizedBinomialQ[u,x] — ListQ[GeneralizedBinomialParts]
   (the ListQ[u] arm is the generator's list-packing). */
%mr_generalizedBinomialQ(u, x) := block([i, v],
  if not atom(u) and is(op(u) = "[") then (
    v : true,
    for i : 1 thru length(u) do
      if not %mr_generalizedBinomialQ(part(u, i), x) then v : false,
    v
  )
  else not atom(%mr_generalizedBinomial_parts(u, x)))$

/* Rubi :1017  GeneralizedBinomialDegree[u,x] := Parts[[3]] - Parts[[4]]
   (n - q). The .m False[[3]] hard-errors on a non-generalized-binomial;
   the port fails closed with false (every class-1 call site gates on
   GeneralizedBinomialQ first). */
%mr_generalizedBinomialDegree(u, x) := block([L],
  L : %mr_generalizedBinomial_parts(u, x),
  if atom(L) then false else part(L, 3) - part(L, 4))$

/* Rubi :1451  GeneralizedBinomialMatchQ[u,x] — MatchQ[u,
   a_.*x^q_.+b_.*x^n_. /; FreeQ[{a,b,n,q},x]]: the SURFACE two-power
   sum, no PosQ gate and no product/PolyQ recursion. */
%mr_generalizedBinomialMatchQ(u, x) := block([i, v],
  if not atom(u) and is(op(u) = "[") then (
    v : true,
    for i : 1 thru length(u) do
      if not %mr_generalizedBinomialMatchQ(part(u, i), x) then v : false,
    v
  )
  else %mr_matchQ(
    u,
    "(Plus (Times (Optional (Pattern |_mr_gbm1_r1mq1_a| (Blank))) (Power (MRArg 1) (Optional (Pattern |_mr_gbm1_r1mq1_q| (Blank))))) (Times (Optional (Pattern |_mr_gbm1_r1mq1_b| (Blank))) (Power (MRArg 2) (Optional (Pattern |_mr_gbm1_r1mq1_n| (Blank))))))", [x, x],
    lambda([%mr_mqb],
      freeof(x, %mr_mk(_mr_gbm1_r1mq1_a, %mr_mqb))
      and freeof(x, %mr_mk(_mr_gbm1_r1mq1_b, %mr_mqb))
      and freeof(x, %mr_mk(_mr_gbm1_r1mq1_n, %mr_mqb))
      and freeof(x, %mr_mk(_mr_gbm1_r1mq1_q, %mr_mqb)))))$

/* Rubi :1058-1088  GeneralizedTrinomialParts[u,x] — [a, b, c, n, q]
   iff u ~ a*x^q + b*x^n + c*x^(2*n-q), else false. Branch order:
   unary minus / sum pattern (positive orientation, section note) /
    a_*u_ (scale) / the PolyQ+Expon List case (the .m's polynomial
    fallback; NeQ[q,0] — the q := 0 form is the ORDINARY trinomial,
    NOT generalized) / x^m_*u_ over a generalized trinomial (shift) /
    x^m_*u_ over an ordinary trinomial (the q := m shift of
    a + b*x^n + c*x^(2n), which is what generalizes the q := 0 form). */
%mr_generalizedTrinomial_parts(u, x) := block([r, B, A, U, L, M, EL],
  if not atom(u) and is(op(u) = "-") then (
    L : %mr_generalizedTrinomial_parts(part(u, 1), x),
    if atom(L) then false
    else [-part(L, 1), -part(L, 2), -part(L, 3),
          part(L, 4), part(L, 5)]
  )
  else (
    r : false,
    if not atom(u) and is(op(u) = "+") then (
      B : %mr_matchQ_bindings(
        u,
        "(Plus (Times (Optional (Pattern |_mr_gtp1_r1mq1_a| (Blank))) (Power (MRArg 1) (Optional (Pattern |_mr_gtp1_r1mq1_q| (Blank))))) (Times (Optional (Pattern |_mr_gtp1_r1mq1_b| (Blank))) (Power (MRArg 2) (Optional (Pattern |_mr_gtp1_r1mq1_n| (Blank))))) (Times (Optional (Pattern |_mr_gtp1_r1mq1_c| (Blank))) (Power (MRArg 3) (Optional (Pattern |_mr_gtp1_r1mq1_r| (Blank))))))", [x, x, x],
        lambda([%mr_mqb],
          freeof(x, %mr_mk(_mr_gtp1_r1mq1_a, %mr_mqb))
          and freeof(x, %mr_mk(_mr_gtp1_r1mq1_b, %mr_mqb))
          and freeof(x, %mr_mk(_mr_gtp1_r1mq1_c, %mr_mqb))
          and freeof(x, %mr_mk(_mr_gtp1_r1mq1_n, %mr_mqb))
          and freeof(x, %mr_mk(_mr_gtp1_r1mq1_q, %mr_mqb))
          and %mr_posQ(
            %mr_mk(_mr_gtp1_r1mq1_n, %mr_mqb)
            - %mr_mk(_mr_gtp1_r1mq1_q, %mr_mqb))
          and %mr_eqQ(
            %mr_mk(_mr_gtp1_r1mq1_r, %mr_mqb)
            - (2*%mr_mk(_mr_gtp1_r1mq1_n, %mr_mqb)
               - %mr_mk(_mr_gtp1_r1mq1_q, %mr_mqb)),
            0))
      ),
      if not atom(B) then r : [
        %mr_mk(_mr_gtp1_r1mq1_a, B),
        %mr_mk(_mr_gtp1_r1mq1_b, B),
        %mr_mk(_mr_gtp1_r1mq1_c, B),
        %mr_mk(_mr_gtp1_r1mq1_n, B),
        %mr_mk(_mr_gtp1_r1mq1_q, B)
      ]
    ),
    if atom(r) and not atom(u) and is(op(u) = "*") then (
      B : %mr_matchQ_bindings(
        u,
        "(Times (Pattern |_mr_gtp2_r1mq1_a| (Blank)) (Pattern |_mr_gtp2_r1mq1_u| (Blank)))", [],
        lambda([%mr_mqb],
          freeof(x, %mr_mk(_mr_gtp2_r1mq1_a, %mr_mqb))
          and not is(%mr_mk(_mr_gtp2_r1mq1_a, %mr_mqb) = 1)
          and not is(
            %mr_mk(_mr_gtp2_r1mq1_u, %mr_mqb) = u))
      ),
      if not atom(B) then (
        A : %mr_mk(_mr_gtp2_r1mq1_a, B),
        U : %mr_mk(_mr_gtp2_r1mq1_u, B),
        L : %mr_generalizedTrinomial_parts(U, x),
        if atom(L) then false
        else r : [A*part(L, 1), A*part(L, 2), A*part(L, 3),
                  part(L, 4), part(L, 5)]
      )
    ),
    if atom(r) and %mr_polynomialQ(u, x) then (
      EL : %mr_exp_list(u, x),
      if length(EL) = 3
        and %mr_neQ(part(EL, 1), 0)
        and %mr_eqQ(
          part(EL, 3),
          2*part(EL, 2) - part(EL, 1))
      then r : [
        %mr_coeff(u, x, part(EL, 1)),
        %mr_coeff(u, x, part(EL, 2)),
        %mr_coeff(u, x, part(EL, 3)),
        part(EL, 2),
        part(EL, 1)
      ]
    ),
    if atom(r) and not atom(u) and is(op(u) = "*") then (
      B : %mr_matchQ_bindings(
        u,
        "(Times (Pattern |_mr_gtp3_r1mq1_u| (Blank)) (Power (MRArg 1) (Optional (Pattern |_mr_gtp3_r1mq1_m| (Blank)))))", [x],
        lambda([%mr_mqb],
          freeof(x, %mr_mk(_mr_gtp3_r1mq1_m, %mr_mqb))
          and not is(
            %mr_mk(_mr_gtp3_r1mq1_u, %mr_mqb) = u))
      ),
      if not atom(B) then (
        M : %mr_mk(_mr_gtp3_r1mq1_m, B),
        U : %mr_mk(_mr_gtp3_r1mq1_u, B),
        L : %mr_generalizedTrinomial_parts(U, x),
        if atom(L) then false
        else if %mr_neQ(M + part(L, 4), 0)
          and %mr_neQ(M + part(L, 5), 0)
        then r : [part(L, 1), part(L, 2), part(L, 3),
                  M + part(L, 4), M + part(L, 5)]
      )
    ),
    if atom(r) and not atom(u) and is(op(u) = "*") then (
      B : %mr_matchQ_bindings(
        u,
        "(Times (Pattern |_mr_gtp4_r1mq1_u| (Blank)) (Power (MRArg 1) (Optional (Pattern |_mr_gtp4_r1mq1_m| (Blank)))))", [x],
        lambda([%mr_mqb],
          freeof(x, %mr_mk(_mr_gtp4_r1mq1_m, %mr_mqb))
          and not is(
            %mr_mk(_mr_gtp4_r1mq1_u, %mr_mqb) = u))
      ),
      if not atom(B) then (
        M : %mr_mk(_mr_gtp4_r1mq1_m, B),
        U : %mr_mk(_mr_gtp4_r1mq1_u, B),
        L : %mr_trinomial_parts(U, x),
        if atom(L) then false
        else if %mr_neQ(M + part(L, 4), 0)
        then r : [part(L, 1), part(L, 2), part(L, 3),
                  M + part(L, 4), M]
      )
    ),
    if atom(r) then false else r
  ))$

/* Rubi :590  GeneralizedTrinomialQ[u,x] — ListQ[GeneralizedTrinomialParts]. */
%mr_generalizedTrinomialQ(u, x) := block([i, v],
  if not atom(u) and is(op(u) = "[") then (
    v : true,
    for i : 1 thru length(u) do
      if not %mr_generalizedTrinomialQ(part(u, i), x) then v : false,
    v
  )
  else not atom(%mr_generalizedTrinomial_parts(u, x)))$

/* Rubi :1053  GeneralizedTrinomialDegree[u,x] := Parts[[4]] - Parts[[5]]
   (n - q). Fails closed with false on a non-generalized-trinomial
   (the .m False[[4]] hard-errors; the call sites gate on Q first). */
%mr_generalizedTrinomialDegree(u, x) := block([L],
  L : %mr_generalizedTrinomial_parts(u, x),
  if atom(L) then false else part(L, 4) - part(L, 5))$

/* Rubi :1465  GeneralizedTrinomialMatchQ[u,x] — MatchQ[u,
   a_.*x^q_.+b_.*x^n_.+c_.*x^r_. /;
   FreeQ[{a,b,c,n,q},x] && EqQ[r-(2*n-q),0]]: the SURFACE three-power
   sum, no product/PolyQ recursion and (unlike the Parts port) no
   PosQ orientation gate. */
%mr_generalizedTrinomialMatchQ(u, x) := block([i, v],
  if not atom(u) and is(op(u) = "[") then (
    v : true,
    for i : 1 thru length(u) do
      if not %mr_generalizedTrinomialMatchQ(part(u, i), x) then v : false,
    v
  )
  else %mr_matchQ(
    u,
    "(Plus (Times (Optional (Pattern |_mr_gtm1_r1mq1_a| (Blank))) (Power (MRArg 1) (Optional (Pattern |_mr_gtm1_r1mq1_q| (Blank))))) (Times (Optional (Pattern |_mr_gtm1_r1mq1_b| (Blank))) (Power (MRArg 2) (Optional (Pattern |_mr_gtm1_r1mq1_n| (Blank))))) (Times (Optional (Pattern |_mr_gtm1_r1mq1_c| (Blank))) (Power (MRArg 3) (Optional (Pattern |_mr_gtm1_r1mq1_r| (Blank))))))", [x, x, x],
    lambda([%mr_mqb],
      freeof(x, %mr_mk(_mr_gtm1_r1mq1_a, %mr_mqb))
      and freeof(x, %mr_mk(_mr_gtm1_r1mq1_b, %mr_mqb))
      and freeof(x, %mr_mk(_mr_gtm1_r1mq1_c, %mr_mqb))
      and freeof(x, %mr_mk(_mr_gtm1_r1mq1_n, %mr_mqb))
      and freeof(x, %mr_mk(_mr_gtm1_r1mq1_q, %mr_mqb))
      and %mr_eqQ(
        %mr_mk(_mr_gtm1_r1mq1_r, %mr_mqb)
        - (2*%mr_mk(_mr_gtm1_r1mq1_n, %mr_mqb)
           - %mr_mk(_mr_gtm1_r1mq1_q, %mr_mqb)),
        0))))$

/* ---- RemoveContent family ------------------------------------------
 * Rubi :1152  RemoveContent[u,x] := with v = NonfreeFactors[u,x],
 *   w = Together[v]: if EqQ[FreeFactors[w,x],1] then Aux[v,x]
 *   else Aux[NonfreeFactors[w,x],x] */
%mr_nonfreeFactors(u, x) := block([r, i, t],
  if atom(u) then (
    if freeof(x, u) then 1 else u
  )
  /* a leading minus is dropped with the x-free content (the .m
     ProductQ factor map replaces x-free factors by 1, -1 included) */
  elseif op(u) = "-" then %mr_nonfreeFactors(part(u, 1), x)
  elseif op(u) = "*" then (
    r : 1,
    for i : 1 thru length(u) do (
      t : part(u, i),
      if is(freeof(x, t)) = false then r : r * t
    ),
    r
  )
  else if freeof(x, u) then 1 else u)$

%mr_freeFactors(u, x) := block([r, i, t],
  if atom(u) then (
    if freeof(x, u) then u else 1
  )
  elseif op(u) = "-" then -%mr_freeFactors(part(u, 1), x)
  elseif op(u) = "*" then (
    r : 1,
    for i : 1 thru length(u) do (
      t : part(u, i),
      if freeof(x, t) then r : r * t
    ),
    r
  )
  else if freeof(x, u) then u else 1)$

/* one monomial term as [base, exponent, rest] with base free of x:
   a literal power factor (a^k) is the base candidate first (the .m
   pattern a_^m_. binds the power), else the first free factor (base^1).
   false if no x-free factor exists (x^2, x, sin(x)*x, ...). */
%mr_termPower(t, x) := block([i, f, base, e, bi, rest, s],
  s : 1,
  if not atom(t) and op(t) = "-" then (s : -1, t : part(t, 1)),
  if atom(t) then (
    if freeof(x, t) then [t, 1, s] else false
  )
  elseif op(t) = "^" then (
    /* a bare power: base candidate iff x-free (the .m a_^m_ binding);
       a symbolic exponent is fine here — the %mr_rationalQ guard in
       %mr_rcAuxCommon rejects it, as Rubi's RationalQ[m] would */
    if freeof(x, t) then [part(t, 1), part(t, 2), s]
    else false
  )
  elseif op(t) = "*" then (
    base : false, e : 1, bi : 0,
    for i : 1 thru length(t) do (
      f : part(t, i),
      if bi = 0 and not atom(f) and op(f) = "^" and freeof(x, f) then (
        base : part(f, 1), e : part(f, 2), bi : i
      )
    ),
    if bi = 0 then
      for i : 1 thru length(t) do (
        f : part(t, i),
        if bi = 0 and freeof(x, f) then (
          base : f, e : 1, bi : i
        )
      ),
    if base = false then false
    else (
      rest : s,
      for i : 1 thru length(t) do (
        if i # bi then rest : rest * part(t, i)
      ),
      [base, e, rest]
    )
  )
  else false)$

/* the two/three-term RemoveContentAux pattern a^m u + a^n v (+ a^p w):
   one shared x-free base, rational exponents, all >= the minimum ->
   factor a^m out and recurse. DEVIATION (documented): the .m pattern
   also matches a NUMERIC base hiding in an integer (4 + 2*x: base 2
   with 4 = 2^2); Maxima integers are not Power-headed and this build
   has no integer factorizer, so 4 and 2x resolve to different bases
   and no factoring happens. The answer is unchanged up to an additive
   constant (it is consumed inside a Log by the rule), which the
   harness derivative check verifies. */
%mr_rcAuxCommon(s, x) := block([i, d, a, m, ok, r, nterms, ds],
  if atom(s) or op(s) # "+" then false
  else (
    nterms : length(s),
    if nterms = 2 or nterms = 3 then (
    ok : true,
    a : false,
    m : false,
    ds : [],
    for i : 1 thru nterms do (
      d : %mr_termPower(part(s, i), x),
      if is(d = false) then ok : false
      else (
        if a = false then (
          a : part(d, 1), m : part(d, 2)
        ) else (
          if is(part(d, 1) = a) = false then ok : false,
          if part(d, 2) < m then m : part(d, 2)
        ),
        /* [d]: append flattens one level — ds must stay a list of the
           [base, exponent, rest] triples */
        ds : append(ds, [d])
      )
    ),
    if ok and a # false and freeof(x, a)
      and %mr_rationalQ(part(part(ds, 1), 2))
      and (nterms < 3 or %mr_rationalQ(part(part(ds, 2), 2)))
      and (nterms # 3 or %mr_rationalQ(part(part(ds, 3), 2)))
    then (
      r : 0,
      for i : 1 thru nterms do
        r : r + part(part(ds, i), 3) * a^(part(part(ds, i), 2) - m),
      %mr_removeContentAux(r, x)
    )
    else false
    )
    else false
  ))$

/* RemoveContentAux (:1160-:1180): the shared-base patterns above, then
   the .m's sign fallback If[SumQ[u] && NegQ[First[u]], -u, u], First in
   Maxima's internal order (matcher translation fixes design 3.2: the
   PosAux port replaces the strict %mr_sign reading used here before). */
%mr_removeContentAux(u, x) := block([c],
  c : %mr_rcAuxCommon(u, x),
  if is(c # false) then c
  else if not atom(u) and op(u) = "+" and %mr_negQ(inpart(u, 1)) then -u
  else u)$

%mr_removeContent(u, x) := block([v, w],
  v : %mr_nonfreeFactors(u, x),
  w : %mr_together(v),
  if %mr_eqQ(%mr_freeFactors(w, x), 1) then %mr_removeContentAux(v, x)
  else %mr_removeContentAux(%mr_nonfreeFactors(w, x), x))$

/* ---- Subst ----------------------------------------------------------
 * Rubi :5140  Subst[u,x,v] — back-substitution. CLUSTER SCOPE: the
 * core "replace all occurrences of x by v, then simplify" (SubstAux's
 * final simp stage). SubstAux's special cases (trig-identity folding,
 * Defer'd dummy variables inside integrate/sum nouns, the binomial
 * flag) are Task 7 scope; a dummy x inside a noun WOULD be replaced by
 * this port — the 1.1.1.1 rule-5 antiderivative is a closed form, so
 * no dummy occurs in this cluster's usage. */
%mr_subst(u, x, v) := block([r],
  r : subst(v, x, u),
  %mr_simp(r))$

/* ===================== predicate cluster F (Task 7a) ====================
 * LinearPairQ / PerfectSquareQ / RationalFunctionQ / SplitProduct /
 * PseudoBinomialPairQ / InverseFunctionQ / AlgebraicFunctionQ. Each cites
 * its .m source line; PerfectSquareQ is a clone-gap predicate (referenced
 * by class-1 rules but defined nowhere in the pinned clone). */

/* Rubi :1387  LinearPairQ[u, v, x] — both linear in x, u not the bare
   variable, and the two slope/offset pairs proportional. The .m guard is
   NeQ[u, x] (u only, not v); the port keeps that asymmetry. */
%mr_linearPairQ(u, v, x) := block([],
  %mr_linearQ(u, x) and %mr_linearQ(v, x) and %mr_neQ(u, x)
    and %mr_eqQ(
      %mr_coeff(u, x, 0)*%mr_coeff(v, x, 1)
        - %mr_coeff(u, x, 1)*%mr_coeff(v, x, 0), 0))$

/* Clone-gap predicate (no .m definition in the pinned clone). The class-1
   uses are PerfectSquareQ[b^2 - 4*a*c] and PerfectSquareQ[a^2 + b^2] on
   x-free constants, so the port is a factor-exponent square test: after
   factor(), every factor's exponent is an even integer (a quotient needs
   both sides square; a negative content is not a real square). Exact
   rationals are a special case: this build's factor(9/4) stays the
   rational 9/4, so the numerator and denominator are tested as integer
   squares. */
%mr_integer_squareQ(n) := block([r],
  if n < 0 then false
  else if n = 0 or n = 1 then true
  else (
    r : sqrt(n),
    integerp(r) and is(r^2 = n)))$

%mr_perfectSquareQ_factor(e) := block([i, ok],
  if is(e = 0) then true
  else if is(e = 1) then true
  else if atom(e) then false
  else if op(e) = "-" then false
  else if op(e) = "*" then (
    ok : true,
    for i : 1 thru length(e) do
      if %mr_perfectSquareQ_factor(part(e, i)) = false then ok : false,
    ok
  )
  else if op(e) = "/"
    and numberp(part(e, 1)) and numberp(part(e, 2))
  then %mr_integer_squareQ(abs(part(e, 1)))
       and %mr_integer_squareQ(part(e, 2))
  else if op(e) = "/"
  then %mr_perfectSquareQ_factor(part(e, 1))
       and %mr_perfectSquareQ_factor(part(e, 2))
  else if op(e) = "^"
  then integerp(part(e, 2)) and evenp(part(e, 2))
  else false)$

%mr_perfectSquareQ(u) := block([f],
  u : ratsimp(u),
  if is(u = 0) then true
  else (
    f : factor(u),
    if atom(f) then is(f = 1)
    else %mr_perfectSquareQ_factor(f)))$

/* Rubi :1578  RationalFunctionQ[u, x]. Maxima stores x^(-1) as a "/" node
   and x^(1/2) as a 'sqrt node, so the IntegerPowerQ branch reads "/" as a
   rational step and rejects 'sqrt (and every other function head). */
%mr_rationalFunctionQ(u, x) := block([i, ok],
  if %mr_atomQ(u) or freeof(x, u) then true
  else if op(u) = "/"
  then %mr_rationalFunctionQ(part(u, 1), x)
       and %mr_rationalFunctionQ(part(u, 2), x)
  else if op(u) = "-"
  then %mr_rationalFunctionQ(part(u, 1), x)
  else if op(u) = "^"
  then %mr_rationalFunctionQ(part(u, 1), x) and integerp(part(u, 2))
  else if op(u) = "*" or op(u) = "+" then (
    ok : true,
    for i : 1 thru length(u) do
      if %mr_rationalFunctionQ(part(u, i), x) = false then ok : false,
    ok
  )
  else false)$

/* Rubi :7617  SumBaseQ[u] — a sum, or a sum raised to an odd power. The
   generated class-1 call passes the bare Rubi name as the SplitProduct
   function argument (Maxima has no first-class Rubi predicates here), so
   %mr_split_call special-cases that one name. */
%mr_sumBaseQ(u) := block([],
  if not atom(u) and op(u) = "+" then true
  else if not atom(u) and op(u) = "^"
    and integerp(part(u, 2)) and oddp(part(u, 2))
    and %mr_sumBaseQ(part(u, 1))
  then true
  else false)$

%mr_split_call(func, v) := block([],
  if atom(func) and is(func = 'SumBaseQ)
  then %mr_sumBaseQ(v)
  else apply(func, [v]))$

%mr_parts_list(e) := block([i, L],
  L : [],
  for i : 1 thru length(e) do
    L : append(L, [part(e, i)]),
  L)$

/* The factor list of u in Maxima's internal order (Rubi's First/Rest of
   a product, SplitProduct :7658 and RtAux's RtAux[-First[v],n]; design
   3.2): a unary minus and a quotient are products there (-a*b ->
   [-1, a, b], a/b -> [a, 1/b]); anything else is one factor. */
%mr_product_factors(u) :=
  if not atom(u) and inpart(u, 0) = "*" then %mr_args_in(u) else [u]$

%mr_product_from_list(L) := block([p, i],
  p : 1,
  for i : 1 thru length(L) do
    p : p*part(L, i),
  p)$

/* Rubi :7658  SplitProduct[func, u] — the first factor v of u with
   func[v] true, as [v, u/v]; false when no factor qualifies. A unary minus
   is read as the leading -1 factor (Mathematica's Times[-1, ...]). */
%mr_splitProduct_aux(func, u) := block([F, p, r],
  F : %mr_product_factors(u),
  if length(F) > 1 then (
    if %mr_split_call(func, part(F, 1)) = true
    then [part(F, 1), %mr_product_from_list(rest(F))]
    else (
      p : %mr_product_from_list(rest(F)),
      r : %mr_splitProduct_aux(func, p),
      if r # false
      then [part(r, 1), part(F, 1)*part(r, 2)]
      else false
    )
  )
  else if %mr_split_call(func, u) = true then [u, 1]
  else false)$

%mr_splitProduct(func, u) := %mr_splitProduct_aux(func, u)$

/* Local real-root form for PseudoBinomialParts. This is deliberately NOT
   the public %mr_rt port (a later cluster): it only supplies the [c, d, n]
   tail that PseudoBinomialPairQ compares. */
%mr_pseudoRoot(u, n) := block([],
  if n = 2 then sqrt(u)
  else if oddp(n) and is(u < 0) then -(-u)^(1/n)
  else u^(1/n))$

/* Rubi :1524  PseudoBinomialParts[u, x] — [a, 1, c, d, n] iff u is a
   polynomial of degree n > 2 of the form a + b*(c + d*x)^n with a, b
   nonzero. Expon is read by %mr_degree under the %mr_polynomialQ gate
   (the only form this helper accepts). */
%mr_pseudoBinomial_parts(u, x) := block([n, d, c, a],
  if %mr_polynomialQ(u, x) then (
    n : %mr_degree(u, x),
    if is(n > 2) then (
      d : %mr_pseudoRoot(%mr_coeff(u, x, n), n),
      c : %mr_coeff(u, x, n - 1)/(n*d^(n - 1)),
      a : %mr_simp(u - expand((c + d*x)^n)),
      if %mr_neQ(a, 0) and freeof(x, a)
      then [a, 1, c, d, n]
      else false
    )
    else false
  )
  else false)$

/* Rubi :1507  PseudoBinomialPairQ[u, v, x] — both have PseudoBinomialParts
   and the same [c, d, n] tail. The .m uses IdentityQ on the tail; the port
   keeps the exact-structure reading (loose %mr_eqQ would over-accept
   distinct symbolic constants). */
%mr_pseudoBinomialPairQ(u, v, x) := block([l1, l2],
  l1 : %mr_pseudoBinomial_parts(u, x),
  if l1 = false then false
  else (
    l2 : %mr_pseudoBinomial_parts(v, x),
    if l2 = false then false
    else %mr_b(part(l1, 3) = part(l2, 3))
         and %mr_b(part(l1, 4) = part(l2, 4))
         and %mr_b(part(l1, 5) = part(l2, 5))
  ))$

/* Rubi :303  InverseFunctionQ[u]. The Maxima head set follows the .m
   $InverseTrigFunctions / $InverseHyperbolicFunctions lists; the two-arg
   inverse tangent is atan2 (absent from the one-arg list, so the .m
   Length[u] <= 1 gate is met structurally). */
%mr_inverseFunctionQ(u) := block([v],
  v : if %mr_atomQ(u) then u else op(u),
  if is(v = 'log) then true
  else if not %mr_atomQ(u) and length(u) <= 1
    and member(v, ['asin, 'acos, 'atan, 'acot, 'asec, 'acsc]) # false
  then true
  else if not %mr_atomQ(u)
    and member(v, ['asinh, 'acosh, 'atanh, 'acoth, 'asech, 'acsch]) # false
  then true
  else if not %mr_atomQ(u)
    and (is(v = 'mod) or is(v = 'polylog) or is(v = 'productlog))
  then true
  else false)$

/* Rubi :1681  AlgebraicFunctionQ[u, x, flag_ = False]. flag false: a
   power counts only with an explicit rational exponent (the 'sqrt node is
   the collapsed 1/2 power); flag true: also with an x-free exponent. The
   3-arg form (flag = true) is called by 3_1_5 r30 and 3_3 r32/r61, whose
   conds the matcher substrate first makes reachable (plan-2
   pre-validation, 2026-09-13). */
%mr_algebraicFunctionQ(u, x, [flag]) := block([fl, i, ok],
  if length(flag) > 1
  then error("%mr_algebraicFunctionQ: expected 2 or 3 args"),
  fl : if flag = [] then false else is(first(flag) = true),
  if %mr_atomQ(u) or freeof(x, u) then true
  else if op(u) = "/"
  then %mr_algebraicFunctionQ(part(u, 1), x, fl)
       and %mr_algebraicFunctionQ(part(u, 2), x, fl)
  else if op(u) = "-"
  then %mr_algebraicFunctionQ(part(u, 1), x, fl)
  else if op(u) = "^"
  then %mr_algebraicFunctionQ(part(u, 1), x, fl)
       and (%mr_rationalQ(part(u, 2)) or (fl and freeof(x, part(u, 2))))
  else if op(u) = 'sqrt
  then %mr_algebraicFunctionQ(part(u, 1), x, fl)
  else if op(u) = "*" or op(u) = "+" then (
    ok : true,
    for i : 1 thru length(u) do
      if %mr_algebraicFunctionQ(part(u, i), x, fl) = false then ok : false,
    ok
  )
  else if op(u) = "[" then (
    ok : true,
    for i : 1 thru length(u) do
      if %mr_algebraicFunctionQ(part(u, i), x, fl) = false then ok : false,
    ok
  )
  else false)$

/* ---- cluster G: the first B-tier shims -------------------------------
 * Rt (:7513/:7549) · Expon (:1239) · ExpandToSum (:3329/:3343) ·
 * IntPart (:2952) · FracPart (:2969).
 *
 * 5.50.0 representation traps pinned here (measured 2026-08-23):
 *  - lambda([a, b, [c]], ...) is this build's variable-arity form;
 *    generated rules call ExpandToSum with 2 and 3 args under one name;
 *  - the .m's TogetherSimplify is NOT ported into %mr_rt: Maxima's
 *    ratsimp/factor expand or factor the argument ((a+b)^2 ->
 *    a^2+2*a*b+b^2, x^2-1 -> (x-1)*(x+1)), destroying the PowerQ /
 *    non-product reading. The port feeds the argument to RtAux as stored;
 *  - Maxima's sign() answers pz for a^2, so the .m's LtQ[#,0] split is
 *    the strict is(# < 0) reading (Rubi's PosQ/NegQ remain sign-based). */

%mr_sum_from_list(L) := block([s, i],
  s : 0,
  for i : 1 thru length(L) do
    s : s + part(L, i),
  s)$

%mr_rt_power_parts(u) := block([q],
  if atom(u) then false
  else if op(u) = "^"
  then [part(u, 1), part(u, 2)]
  else if op(u) = 'sqrt
  /* the collapsed 1/2 power node (see the %mr_binomial_parts note) */
  then [part(u, 1), 1/2]
  /* A RECIPROCAL IS A POWER. MEASURED 2026-09-16 (this build): op(1/a)
     is "/", NOT "^" -- this build keeps a quotient as its own node, so
     reading only "^" and sqrt made PowerQ FALSE for every 1/q, where
     Mathematica stores 1/q as Power[q, -1] and PowerQ is true.
     The cost was NON-TERMINATION: with PowerQ false, RtAux(1/D, n) fell
     past its power branch to `oddp(n) and NegQ(u) and PosQ(-u)` and
     returned -RtAux(-(1/D), n), whose product branch (F = [-1, 1/D])
     called RtAux(1/D, n) again -- the measured cycle
     -(1/D) -> -1 -> 1 -> 1/D -> -(1/D), 2,189 calls before the control
     stack went, on D = 10 a^4 f - 7 a^3 b e + 4 a^2 b^2 d - a b^3 c.
     It killed 1.1.3.8 e264/e285 and reproduces on the pre-port tree, so
     it is a latent defect the ExpandExpression port merely REACHED, not
     a port regression. Only a bare reciprocal qualifies: Mathematica's
     p/q with p # 1 is Times[p, Power[q, -1]], a product, PowerQ false.
     MEASURED consequence: %mr_rt(1/a^2, 2) is now Rubi's 1/a, where the
     fall-through gave Maxima's 1/abs(a). */
  else if op(u) = "/" and is(part(u, 1) = 1) then (
    q : part(u, 2),
    if atom(q) then [q, -1]
    else if op(q) = "^" then [part(q, 1), -part(q, 2)]
    else if op(q) = 'sqrt then [part(q, 1), -1/2]
    else [q, -1])
  else false)$

%mr_rt_powerQ(u) := not atom(%mr_rt_power_parts(u))$

%mr_rt_power_base(u) := part(%mr_rt_power_parts(u), 1)$

%mr_rt_power_exp(u) := part(%mr_rt_power_parts(u), 2)$

/* the .m's LtQ[#,0] — strict, unknown -> false (NOT Rubi's NegQ).
   The outer is() is LOAD-BEARING, not decoration. MEASURED 2026-09-16
   (this build): the inner `is(u < 0) = true` alone builds an EQUATION
   (`true = true`, `unknown = true`), not a boolean, and BOTH call sites
   misread it -- %mr_splitProduct compares %mr_split_call(...) = true,
   which an equation never equals, so RtAux's LtQ split (:2734) was dead
   code; and dropping the `= true` instead (leaving a bare is(u < 0))
   returns `unknown` for an undecidable u, which at `if oddp(n) and
   LtQ(u)` (:2820) leaves the WHOLE conditional unevaluated (measured:
   `if unknown then "THEN" else "ELSE"` comes back as itself and would
   flow into RtAux's answer). is(is(u < 0) = true) is true/false/false. */
%mr_rt_ltQ(u) := is(is(u < 0) = true)$

/* Rubi :7612  AtomBaseQ[u] */
%mr_rt_atomBaseQ(u) := block([],
  if %mr_atomQ(u) then true
  else if %mr_rt_powerQ(u) then block([e],
    e : %mr_rt_power_exp(u),
    integerp(e) and oddp(e)
    and %mr_rt_atomBaseQ(%mr_rt_power_base(u)))
  else false)$

/* Rubi :7622  NegSumBaseQ[u] — First in Maxima's internal order (design
   3.2) */
%mr_rt_negSumBaseQ(u) := block([],
  if not atom(u) and op(u) = "+"
  then %mr_negQ(inpart(u, 1))
  else if %mr_rt_powerQ(u) then block([e],
    e : %mr_rt_power_exp(u),
    integerp(e) and oddp(e)
    and %mr_rt_negSumBaseQ(%mr_rt_power_base(u)))
  else false)$

/* Rubi :7627  AllNegTermQ[u] */
%mr_rt_allNegTermQ(u) := block([],
  if %mr_rt_powerQ(u) then block([e],
    e : %mr_rt_power_exp(u),
    if integerp(e) and oddp(e)
    then %mr_rt_allNegTermQ(%mr_rt_power_base(u))
    else false)
  else if not atom(u) and op(u) = "+"
  then %mr_negQ(part(u, 1)) and %mr_rt_allNegTermQ(rest(u))
  else %mr_negQ(u))$

/* Rubi :7636  SomeNegTermQ[u] */
%mr_rt_someNegTermQ(u) := block([],
  if %mr_rt_powerQ(u) then block([e],
    e : %mr_rt_power_exp(u),
    if integerp(e) and oddp(e)
    then %mr_rt_someNegTermQ(%mr_rt_power_base(u))
    else false)
  else if not atom(u) and op(u) = "+"
  then %mr_negQ(part(u, 1)) or %mr_rt_someNegTermQ(rest(u))
  else %mr_negQ(u))$

/* Rubi :7676  SplitSum[func, u] — the first TERM v of u for which
   func[v] is nonatomic, as [func[v], u-v]; false otherwise. First/Rest in
   Maxima's internal order (design 3.2); the rest of a sum is the
   remaining sum (or the last term), matching the .m Rest[u] reading. */
%mr_splitSum_aux(func, u) := block([r],
  if not atom(u) and op(u) = "+" then (
    r : apply(func, [inpart(u, 1)]),
    if not atom(r)
    then [r, %mr_rest_in(u)]
    else (
      r : %mr_splitSum_aux(func, %mr_rest_in(u)),
      if r # false
      then [part(r, 1), inpart(u, 1) + part(r, 2)]
      else false
    )
  )
  else (
    r : apply(func, [u]),
    if not atom(r) then [r, 0] else false
  ))$

%mr_splitSum(func, u) := %mr_splitSum_aux(func, u)$

/* Rubi :7649  TrigSquareQ[u] — Sin[z]^2 or Cos[z]^2 */
%mr_trigSquareQ(u) := block([b],
  if %mr_rt_powerQ(u) and is(%mr_rt_power_exp(u) = 2)
  then (
    b : %mr_rt_power_base(u),
    not atom(b) and (is(op(b) = 'sin) or is(op(b) = 'cos))
  )
  else false)$

/* Rubi :7530  TrigSquare[u] — a-a*Sin[z]^2 -> a*Cos[z]^2 (and the Cos
   twin); false when the non-trig parts do not cancel. */
%mr_trigSquare(u) := block([lst, tr, z],
  if not atom(u) and op(u) = "+" then (
    lst : %mr_splitSum(
      lambda([z],
        %mr_splitProduct(lambda([w], %mr_trigSquareQ(w)), z)),
      u),
    if lst # false
      and %mr_eqQ(part(part(lst, 1), 2) + part(lst, 2), 0)
    then (
      tr : part(part(part(lst, 1), 1), 1),
      if is(op(tr) = 'sin)
      then part(lst, 2)*cos(part(tr, 1))^2
      else part(lst, 2)*sin(part(tr, 1))^2
    )
    else false
  )
  else false)$

/* Rubi :7549  RtAux[u, n] — the structural nth-root split. See the
   cluster note on the omitted TogetherSimplify. */
%mr_rt_aux(u, n) := block([F, lst, v, Fv, p, i],
  F : %mr_product_factors(u),
  if %mr_rt_powerQ(u)
  then %mr_rt_power_base(u)^(%mr_rt_power_exp(u)/n)
  else if length(F) > 1 then (
    lst : %mr_splitProduct(lambda([z], %mr_posQ(z)), u),
    if lst # false
    then %mr_rt_aux(part(lst, 1), n)*%mr_rt_aux(part(lst, 2), n)
    else (
      lst : %mr_splitProduct(lambda([z], %mr_rt_ltQ(z)), u),
      if lst # false then (
        if %mr_eqQ(part(lst, 1), -1) then (
          v : part(lst, 2),
          if %mr_rt_powerQ(v) and is(%mr_rt_power_exp(v) < 0)
          then 1/%mr_rt_aux(
            -%mr_rt_power_base(v)^(-%mr_rt_power_exp(v)), n)
          else (
            Fv : %mr_product_factors(v),
            if length(Fv) > 1 then (
              if %mr_splitProduct(
                    lambda([z], %mr_sumBaseQ(z)), v) # false
              then (
                lst : %mr_splitProduct(
                  lambda([z], %mr_rt_allNegTermQ(z)), v),
                if lst # false
                then %mr_rt_aux(-part(lst, 1), n)
                     *%mr_rt_aux(part(lst, 2), n)
                else (
                  lst : %mr_splitProduct(
                    lambda([z], %mr_rt_negSumBaseQ(z)), v),
                  if lst # false
                  then %mr_rt_aux(-part(lst, 1), n)
                       *%mr_rt_aux(part(lst, 2), n)
                  else (
                    lst : %mr_splitProduct(
                      lambda([z], %mr_rt_someNegTermQ(z)), v),
                    if lst # false
                    then %mr_rt_aux(-part(lst, 1), n)
                         *%mr_rt_aux(part(lst, 2), n)
                    else (
                      lst : %mr_splitProduct(
                        lambda([z], %mr_sumBaseQ(z)), v),
                      %mr_rt_aux(-part(lst, 1), n)
                           *%mr_rt_aux(part(lst, 2), n)
                    )
                  )
                )
              )
              else (
                lst : %mr_splitProduct(
                  lambda([z], %mr_rt_atomBaseQ(z)), v),
                if lst # false
                then %mr_rt_aux(-part(lst, 1), n)
                     *%mr_rt_aux(part(lst, 2), n)
                else %mr_rt_aux(-part(Fv, 1), n)
                     *%mr_rt_aux(%mr_product_from_list(rest(Fv)), n)
              )
            )
            else if oddp(n) then -%mr_rt_aux(v, n)
            else u^(1/n)
          )
        )
        else %mr_rt_aux(-part(lst, 1), n)
             *%mr_rt_aux(-part(lst, 2), n)
      )
      else (
        lst : %mr_splitProduct(
          lambda([z], %mr_rt_allNegTermQ(z)), u),
        if lst # false
          and %mr_splitProduct(
                lambda([z], %mr_sumBaseQ(z)), part(lst, 2)) # false
        then %mr_rt_aux(-part(lst, 1), n)
             *%mr_rt_aux(-part(lst, 2), n)
        else (
          lst : %mr_splitProduct(
            lambda([z], %mr_rt_negSumBaseQ(z)), u),
          if lst # false
            and %mr_splitProduct(
                  lambda([z], %mr_rt_negSumBaseQ(z)),
                  part(lst, 2)) # false
          then %mr_rt_aux(-part(lst, 1), n)
               *%mr_rt_aux(-part(lst, 2), n)
          else (
            p : 1,
            for i : 1 thru length(F) do
              p : p*%mr_rt_aux(part(F, i), n),
            p
          )
        )
      )
    )
  )
  else (
    lst : %mr_trigSquare(u),
    if lst # false then %mr_rt_aux(lst, n)
    else if oddp(n) and %mr_rt_ltQ(u) then -%mr_rt_aux(-u, n)
    else if oddp(n) and %mr_negQ(u) and %mr_posQ(-u)
    then -%mr_rt_aux(-u, n)
    else u^(1/n)
  ))$

/* Rubi :7513  Rt[u, n] — the simplest nth root of u. */
%mr_rt(u, n) := %mr_rt_aux(u, n)$

/* Rubi :1239  Expon[expr, form] := Exponent[Together[expr], form].
   The 3-arg form is declared (the generator's Expon mapping allows it)
   but fails closed: no class-1 call site uses the exponent-list form. */
%mr_expon2(u, x) := %mr_degree(%mr_together(u), x)$

/* The generator's powered-form Expon: Expon[u, base^power] is the degree
   in base^power (the degree in base divided by power, when that is an
   integer; -1 otherwise, the Exponent parity). */
%mr_expon3(u, base, power) := block([d],
  d : %mr_degree(%mr_together(u), base),
  if integerp(power) and is(power > 0) and d >= 0
    and is(mod(d, power) = 0)
  then d/power
  else -1)$

%mr_expon : lambda([u, form, [h]],
  if length(h) = 0 then %mr_expon2(u, form)
  else %mr_expon3(u, form, part(h, 1)))$

/* Rubi :1242  Expon[expr, form, Min] — the MINIMUM x-exponent of
   Together[expr] (Mathematica Exponent[_, _, Min]). The generator maps
   it to %mr_exponMin (1.3.3 r17 / 1.4.1 r25 — the Px minimum-power
   split). %mr_degree's term walker cannot be reused: %mr_term_xexp
   returns FALSE on x-bearing denominators (1/x -> false, the
   polynomial-monomial reading), which DROPS exactly the terms the
   minimum is about — a local walker below handles negative powers
   (1/x -> -1, x^2/x^5 -> -3) and x-free bases (d^2 -> 0), mirroring
   %mr_term_xexp's atom/minus/times/quote cases. Edge parity with
   %mr_degree: 0 -> 0, x-free -> 0, no x-power term at all -> -1. */
%mr_exponMin_term(t, x) := block([i, f, p, ok],
  if atom(t) then (
    if is(t = x) then 1 else 0
  )
  elseif op(t) = "-" then %mr_exponMin_term(part(t, 1), x)
  elseif op(t) = "*" then (
    p : 0,
    ok : true,
    for i : 1 thru length(t) do (
      f : part(t, i),
      if freeof(x, f) then true
      elseif is(f = x) then p : p + 1
      elseif op(f) = "^" and is(part(f, 1) = x)
        and integerp(part(f, 2)) then p : p + part(f, 2)
      else ok : false
    ),
    if ok then p else false
  )
  elseif op(t) = "/" then block([n, d],
    n : %mr_exponMin_term(part(t, 1), x),
    d : %mr_exponMin_term(part(t, 2), x),
    if n # false and d # false then n - d else false
  )
  elseif op(t) = "^" then (
    if is(part(t, 1) = x) and integerp(part(t, 2))
    then part(t, 2)
    else if freeof(x, part(t, 1)) then 0 else false
  )
  else false)$

%mr_exponMin(u, x) := block([e, i, m, p, found],
  e : expand(%mr_together(u)),
  if is(e = 0) then 0
  elseif freeof(x, e) then 0
  elseif atom(e) then %mr_exponMin_term(e, x)
  elseif op(e) = "+" then (
    m : -1, found : false,
    for i : 1 thru length(e) do (
      p : %mr_exponMin_term(part(e, i), x),
      if p # false then (
        if not found then (m : p, found : true)
        elseif p < m then m : p
      )
    ),
    if found then m else -1
  )
  else (
    p : %mr_exponMin_term(e, x),
    if p # false then p else -1))$

/* Rubi :3343  ExpandToSum[u, x] — u expanded into a sum of monomials of
   x. The .m's Simp is NOT %mr_simp here: %mr_simp factors (the cluster's
   whole point is the MONOMIAL-SUM shape, so (x+1)^2 must stay
   x^2+2*x+1). Rubi :3329  ExpandToSum[u, v, x] is the distribute form. */
%mr_expandToSum2(u, x) := block([L],
  if %mr_polyQ(u, x) then expand(u)
  else if %mr_binomialQ(u, x) then (
    L : %mr_binomial_parts(u, x),
    if atom(L) then expand(u)
    else part(L, 1) + part(L, 2)*x^part(L, 3)
  )
  else if %mr_trinomialQ(u, x) then (
    L : %mr_trinomial_parts(u, x),
    if atom(L) then expand(u)
    else part(L, 1) + part(L, 2)*x^part(L, 4)
         + part(L, 3)*x^(2*part(L, 4))
  )
  else if %mr_generalizedBinomialQ(u, x) then (
    L : %mr_generalizedBinomial_parts(u, x),
    if atom(L) then expand(u)
    else part(L, 1)*x^part(L, 4) + part(L, 2)*x^part(L, 3)
  )
  else if %mr_generalizedTrinomialQ(u, x) then (
    L : %mr_generalizedTrinomial_parts(u, x),
    if atom(L) then expand(u)
    else part(L, 1)*x^part(L, 5) + part(L, 2)*x^part(L, 4)
         + part(L, 3)*x^expand(2*part(L, 4) - part(L, 5))
  )
  else expand(u))$

%mr_expandToSum : lambda([a, b, [c]],
  if length(c) = 0
  then %mr_expandToSum2(a, b)
  else expand(a*%mr_expandToSum2(b, part(c, 1))))$

/* Rubi :2952  IntPart[u, n_ = 1] — the sum of the integer terms of u.
   The m_*u_ arm absorbs an EXPLICIT rational leading factor into n.
   IntegerPart truncates toward zero (IntegerPart[-3/2] = -1): the rational
   branch is truncate, not floor (exact seen test design 3.2; class 1 g27,
   1_2_3_2_r34 on p = -1/2 and -3/2). IntPart + FracPart = u. */
%mr_intPart_aux(u, n) := block([F, m],
  /* a Rational is atomic in the .m (no m_*u_ match): RationalQ first —
     %mr_product_factors reads the internal form, where -3/2 is one number,
     not the display "-" node (matcher translation fixes design 3.2) */
  if %mr_rationalQ(u) then truncate(n*u)
  else if not atom(u) and (op(u) = "*" or op(u) = "-")
  then (
    F : %mr_product_factors(u),
    m : part(F, 1),
    if length(F) > 1 and %mr_rationalQ(m)
    then %mr_intPart_aux(%mr_product_from_list(rest(F)), m*n)
    else 0
  )
  else if not atom(u) and op(u) = "+"
  then apply("+", map(
    lambda([z], %mr_intPart_aux(z, n)), %mr_parts_list(u)))
  else 0)$

%mr_intPart : lambda([u, [n]],
  %mr_intPart_aux(u, if length(n) = 0 then 1 else part(n, 1)))$

/* Rubi :2969  FracPart[u, n_ = 1] — the sum of the non-integer terms of
   u. FractionalPart carries the sign of its argument
   (FractionalPart[-3/2] = -1/2): r - truncate(r) (exact seen test design
   3.2). */
%mr_fracPart_aux(u, n) := block([F, m, r],
  /* RationalQ first, as in %mr_intPart_aux */
  if %mr_rationalQ(u) then (
    r : n*u,
    r - truncate(r)
  )
  else if not atom(u) and (op(u) = "*" or op(u) = "-")
  then (
    F : %mr_product_factors(u),
    m : part(F, 1),
    if length(F) > 1 and %mr_rationalQ(m)
    then %mr_fracPart_aux(%mr_product_from_list(rest(F)), m*n)
    else n*u
  )
  else if not atom(u) and op(u) = "+"
  then apply("+", map(
    lambda([z], %mr_fracPart_aux(z, n)), %mr_parts_list(u)))
  else n*u)$

%mr_fracPart : lambda([u, [n]],
  %mr_fracPart_aux(u, if length(n) = 0 then 1 else part(n, 1)))$

/* ---- cluster H: the small remaining B-tier shims --------------------
 * PolyQuotient / PolyRemainder / PolyDivide are the Maxima quotient /
 * remainder / divide builtins under the project names (the fail-closed
 * guard is the %mr_polynomialQ pair — a non-polynomial argument is a
 * rule-condition bug, not a division). ArcTanh / ArcSinh / ArcCosh are
 * unbound in this build and get the log forms. */

/* expand() on the result is LOAD-BEARING (measured 2026-08-25,
   5.50.0/SBCL): for a NON-MONIC divisor with symbolic coefficients
   (v = a+b*x+c*x^2), the built-in quotient/remainder/divide return
   the parts as FRACTIONS — the symbolic content (c^3 here) rides in
   the denominator: op(remainder((e*x+d)^4, a+b*x+c*x^2, x)) = "/"
   with denom = c^3. Rubi's PolynomialQuotient/Remainder contract is a
   true polynomial (Mathematica does exact symbolic division); the
   fraction form corrupts every downstream Coeff/Expon/EqQ consumer
   (1.2.1.6 r4's f,g came back c^3-scaled -> 1.2.1.2 e2202 wrong
   answer, resid 3.19). expand() over an x-free denominator restores
   the true monomial sum (qu*expand(Q) + expand(R) = Pq re-verified). */
%mr_polyQuotient(u, v, x) := block([r],
  if %mr_polynomialQ(u, x) and %mr_polynomialQ(v, x)
  then (
    r : errcatch(quotient(u, v, x)),
    if is(r = []) then false else expand(part(r, 1))
  )
  else false)$

%mr_polyRemainder(u, v, x) := block([r],
  if %mr_polynomialQ(u, x) and %mr_polynomialQ(v, x)
  then (
    r : errcatch(remainder(u, v, x)),
    if is(r = []) then false else expand(part(r, 1))
  )
  else false)$

/* Rubi :3298  PolynomialDivide[u, v, x] — the POLYNOMIAL quotient PLUS
   the remainder over v, as ONE expression: quo + rem/v. The generated
   repls call mr_int(%mr_polyDivide(...), x) and integrate that single
   expression (Rubi: Int[PolynomialDivide[u, v, x], x]); the earlier
   [Q, R] list contract integrated the LIST (a noun/garbage answer —
   measured 2026-08-25: 1.1.3.3 e5, resid ~0.33/1.6). `divide(u, v, x)`
   is NOT used: in this build it divides by a RECIPROCAL by multiplying
   and dropping the remainder (divide(a+b*x^3, 1/(c+d*x^3), x) =
   [[b*d*x^6 + ..., 0]] — the "remainder" is a sum, not a < v-degree
   remainder, measured 2026-08-25). */
%mr_polyDivide(u, v, x) := block([q, r],
  if %mr_polynomialQ(u, x) and %mr_polynomialQ(v, x)
  then (
    q : errcatch(quotient(u, v, x)),
    if is(q = []) then false
    else (
      r : errcatch(remainder(u, v, x)),
      if is(r = []) then false
      /* no expand(): this build's expand DISTRIBUTES a sum over a
         denominator term (expand(Q + R/v) = Q + R1/v - R2/... per
         summand, measured 2026-08-25: x + (1-x)/(x^2+1) became
         -(x/(x^2+1)) + 1/(x^2+1) + x) — the unexpanded form is the
         canonical one the cascade and the zero-tests expect. */
      else part(q, 1) + part(r, 1)/v
    )
  )
  else false)$

%mr_atanh(u) := 1/2*log((1 + u)/(1 - u))$

%mr_asinh(u) := log(u + sqrt(u^2 + 1))$

/* sqrt(z-1)*sqrt(z+1) (not sqrt(z^2-1)): the branch reading the .m's
   ArcCosh wants on the real axis, and the acosh(1) probe pins the
   sqrt(0) corner. */
%mr_acosh(u) := log(u + sqrt(u - 1)*sqrt(u + 1))$

/* ---- cluster I: the algebraic surface of ExpandIntegrand ------------
 * The .m's ExpandIntegrand is a large pattern set (log/trig/smart-apart
 * branches included); this port is the ALGEBRAIC surface the class-1
 * call sites need:
 *   - a positive-integer power of a sum expands,
 *   - polynomial * (a+b*x)^m is kept in linear-power form by
 *     ExpandLinearProduct (the .m's u_*(a+b*x)^m rule),
 *   - the 3-arg form distributes over the expanded v without expanding
 *     the power factors (the DistributeOverTerms / MergeMonomials
 *     surface).
 * The catch-all ExpandExpression / SmartApart branch (.m :3762/:3780) IS
 * ported, in cluster I(b) below (exact seen test design 3.4): it is what
 * the 2-arg form falls back to instead of a plain expand(). The remaining
 * .m branches (CollectRecipTerms, ExpandBinomial, the F^u and Log rules,
 * :3379-:3757) are still unported and are ticketed. */

%mr_coefficientList(u, x) := block([d, i, L],
  if %mr_polynomialQ(u, x) then (
    d : %mr_degree(u, x),
    L : [],
    for i : 0 thru d do
      L : append(L, [%mr_coeff(u, x, i)]),
    L
  )
  else false)$

/* Rubi :4023  ExpandLinearProduct[v, u, a, b, x] — v*u as a sum of
   c*v*(a+b*x)^n terms (u read in the shifted variable (x-a)/b). */
/* The shifted form w may carry a constant (x-free) denominator (e.g. the
   b^-k from (x-a)/b). rat() isolates it so the coefficient list of the
   numerator is scaled back by 1/den — the .m CoefficientList[Expand[w], x]
   reading, which keeps the factor (the MEASURED 2026-08-25 243x error came
   from num(rat(u)) dropping it). NOTE: together() is a NOUN in this build
   (MEASURED 2026-08-25: op(together(x/2+x/3)) = 'together with no preload),
   so rat() is the combining step. */
%mr_expandLinearProduct(v, u, a, b, x) := block([w, r, den, L, s, i],
  if freeof(x, a) and freeof(x, b) and %mr_neQ(b, 0)
    and %mr_polynomialQ(u, x)
  then (
    w : subst((x - a)/b, x, u),
    r : rat(w),
    /* expand() reifies the gcrat constant to a plain number — MEASURED
       2026-08-25: dividing by the raw denom(rat(...)) object (is(d = 243)
       true, yet distinct) makes Maxima run the rat simplifier and expand
       (3*x+2)^k into its polynomial, destroying the term structure. */
    den : expand(denom(r)),
    L : %mr_coefficientList(expand(num(r)), x),
    if atom(L) then false
    else (
      s : 0,
      for i : 1 thru length(L) do
        s : s + v*part(L, i)*(a + b*x)^(i - 1)/den,
      s
    )
  )
  else false)$

/* A positive-integer power of a sum (the .m's u_^p_. rule with
   SumQ[u] && IGtQ[p,0]). */
%mr_ei_pos_power_sum(u, x) :=
  not atom(u) and op(u) = "^"
  and %mr_sumQ(part(u, 1))
  and integerp(part(u, 2))
  and is(part(u, 2) > 0)$

/* Local factor scan for the ExpandIntegrand linear-power search. Same as
   %mr_product_factors but a "/" node is split into its numerator factors
   plus each denominator factor as a reciprocal (MEASURED 2026-08-25:
   (3*x+2)^-8 stores as the "/" node 1/(3*x+2)^8, so the (a+b*x)^-m factor
   of a quotient is invisible to the opaque-op read). Kept separate from
   %mr_product_factors so no other predicate's behaviour changes. */
%mr_ei_factors(u) := block([],
  if atom(u) then [u]
  else if op(u) = "-" then append([-1], %mr_ei_factors(part(u, 1)))
  else if op(u) = "*" then %mr_parts_list(u)
  else if op(u) = "/" then append(
      %mr_ei_factors(part(u, 1)),
      map(lambda([z],
        if not atom(z) and op(z) = "^" then part(z, 1)^-part(z, 2)
        else z^-1),
        %mr_ei_factors(part(u, 2))))
  else [u])$

/* The linear-power factor of a product at position i, as
   [power, a, b, rest] or false. mode "power" reads an actual
   (a+b*x)^m node, or the reciprocal quotient 1/(a+b*x)^m (m a positive
   integer — the MEASURED 2026-08-25 storage of (a+b*x)^-m as a "/" node,
   which the opaque-op read of %mr_product_factors cannot see); mode
   "bare" reads a bare linear factor (the .m's m_. default — a Power is
   preferred over the bare reading). MEASURED 2026-08-23: return() does
   not escape a for-loop body in this build, so the scan is a flag loop
   over this helper. */
%mr_ei_linear_power_at(F, i, x, mode) :=
  block([f, base, ok, L, R, j, rest],
    f : part(F, i),
    ok : false,
    if mode = "power" then (
      if not atom(f) and op(f) = "^"
      then (base : part(f, 1), ok : true)
      else if not atom(f) and op(f) = "/" and is(num(f) = 1)
        and op(denom(f)) = "^"
        and integerp(part(denom(f), 2))
        and is(part(denom(f), 2) > 0)
      then (base : part(denom(f), 1), ok : true)
    )
    else if not atom(f) and op(f) # "^"
    then (base : f, ok : true),
    if ok = false then false
    else (
      if %mr_linearQ(base, x) then (
        L : %mr_binomial_parts(base, x),
        if not atom(L) and is(part(L, 3) = 1)
          and %mr_neQ(part(L, 2), 0)
        then (
          R : [],
          for j : 1 thru length(F) do
            if j # i then R : append(R, [part(F, j)]),
          rest : %mr_product_from_list(R),
          if %mr_polynomialQ(rest, x)
          then [f, part(L, 1), part(L, 2), rest]
          else false
        )
        else false
      )
      else false
    ))$

/* The linear-power factor of a product, as [power, a, b, rest]: an
   actual (a+b*x)^m node is preferred over a bare linear factor (the
   .m's (a+b*x)^m_. pattern matches a Power first in the class-1 term
   order). */
%mr_ei_linear_power(u, x) := block([F, i, r],
  F : %mr_ei_factors(u),
  r : false,
  for i : 1 thru length(F) do
    if r = false then
      r : %mr_ei_linear_power_at(F, i, x, "power"),
  if r # false then r
  else (
    for i : 1 thru length(F) do
      if r = false then
        r : %mr_ei_linear_power_at(F, i, x, "bare"),
    r
  ))$

/* Distribute u over a sum v term-by-term WITHOUT expanding the terms
   (the MergeMonomials surface: a plain product is left as a product). */
%mr_ei_distribute(u, v, x) := block([],
  if not atom(v) and op(v) = "+"
  then apply("+", map(lambda([z], u*z), %mr_parts_list(v)))
  else u*v)$

%mr_expandIntegrand2(u, x) := block([L, v],
  if %mr_ei_pos_power_sum(u, x)
  then expand(u)
  else (
    L : %mr_ei_linear_power(u, x),
    if L # false
    then %mr_expandLinearProduct(
      part(L, 1), part(L, 4), part(L, 2), part(L, 3), x)
    else (
      /* Rubi :3762, the catch-all:
           ExpandIntegrand[u_,x_Symbol] :=
             With[{v=ExpandExpression[u,x]}, v /; SumQ[v]]
         The rule applies only when the expansion is a sum; where it does
         not, ExpandIntegrand has no rule and the integrand is handed on
         unchanged. This replaces the plain expand(u) fallback (exact seen
         test design 3.4) — expand() multiplied the denominator out, which
         under the exact seen test dispatches instead of falling through
         to integrate (1.1.1.4 e4). */
      v : %mr_expandExpression(u, x),
      if %mr_sumQ(v) then v else u
    )
  ))$

%mr_expandIntegrand3(u, v, x) :=
  %mr_ei_distribute(u, %mr_expandIntegrand2(v, x), x)$

%mr_expandIntegrand : lambda([a, b, [c]],
  if length(c) = 0
  then %mr_expandIntegrand2(a, b)
  else %mr_expandIntegrand3(a, b, part(c, 1)))$

/* ---- cluster I(b): ExpandExpression / SmartApart --------------------
 * The catch-all ExpandIntegrand (Rubi :3762,
 * ExpandIntegrand[u_,x_Symbol] := With[{v=ExpandExpression[u,x]}, v /; SumQ[v]])
 * and the cascade it calls. Ported for the exact seen test design 3.4:
 * with the exact seen test a rule that rewrites its integrand to an
 * algebraically equal form re-dispatches instead of falling through to
 * integrate, so ExpandIntegrand's PARTIAL-FRACTION split (which this port
 * previously lacked — the fallback was a plain expand()) decides whether
 * such a rewrite terminates. Measured: 1.1.1.4 e4 dispatched >= 794
 * declines in 60 s on the expanded-denominator form the old fallback
 * produced. 291 generated lines call %mr_expandIntegrand.
 * The .m's remaining ExpandIntegrand branches (the log, exponential,
 * binomial and trinomial rules at :3379-:3757, CollectRecipTerms,
 * ExpandBinomial) stay unported and are ticketed. */

/* L without its i-th element (the .m's Drop/Delete on a factor list). */
%mr_list_without(L, i) := block([R, k],
  R : [],
  for k : 1 thru length(L) do
    if k # i then R : append(R, [part(L, k)]),
  R)$

/* Rubi :1593  RationalFunctionFactors[u, x] — the product of the factors
   of u that are rational functions of x (1 when none is). */
%mr_rationalFunctionFactors(u, x) := block([F],
  if not atom(u) and inpart(u, 0) = "*" then (
    F : %mr_product_factors(u),
    %mr_product_from_list(map(lambda([z],
      if %mr_rationalFunctionQ(z, x) then z else 1), F))
  )
  else if %mr_rationalFunctionQ(u, x) then u
  else 1)$

/* Rubi :1606  NonrationalFunctionFactors[u, x] — the complement. */
%mr_nonrationalFunctionFactors(u, x) := block([F],
  if not atom(u) and inpart(u, 0) = "*" then (
    F : %mr_product_factors(u),
    %mr_product_from_list(map(lambda([z],
      if %mr_rationalFunctionQ(z, x) then 1 else z), F))
  )
  else if %mr_rationalFunctionQ(u, x) then 1
  else u)$

/* Rubi :3897/:3902  SmartApart[u, x] and SmartApart[u, v, x] — Apart with
   the x-free kernels gensym-substituted, because Mathematica's Apart
   RATIONALIZES denominators holding fractional powers.
   Maxima's partfrac needs no substitution (MEASURED 2026-09-16, this
   build): it splits over a radical parameter 1/((x-sqrt(a))(x+sqrt(a))),
   a radical coefficient, a nested radical and a non-rational factor
   (sqrt(x)/((x+1)(x+2)) -> sqrt(x)/(x+1) - sqrt(x)/(x+2)); it keeps an
   irreducible quadratic and a symbolic exponent; and when it cannot split
   (a log, sqrt, exp or trig denominator, or an x-free one) it returns its
   ARGUMENT unchanged — a non-sum, which is exactly what the cascade's
   SumQ test reads as "this branch did not apply". It raises no error and
   has no Indeterminate value, so the .m's MakeAssocList / GensymSubst /
   KernelSubst round trip and its Indeterminate guard have no counterpart
   here (stated deviation; a nested-radical parameter is watched by a unit
   check). Both .m arities take the partial fraction in x — the 3-argument
   call site (ExpandExpression) passes the variable twice.
   Stated deviation: partfrac may order or group the terms differently
   from Apart. */
%mr_smartApart(u, x, [v]) := block([],
  if length(v) > 1
  then error("%mr_smartApart: expected 2 or 3 args"),
  partfrac(u, x))$

/* [e, a, b] when the term t is e/(a+b x) with e free of x, else false —
   the shape CollectReciprocals pairs up. */
%mr_cr_part(t, x) := block([n, d, L],
  d : denom(t),
  n : num(t),
  if freeof(x, n) and %mr_linearQ(d, x) then (
    L : %mr_binomial_parts(d, x),
    if not atom(L) and is(part(L, 3) = 1) and %mr_neQ(part(L, 2), 0)
    then [n, part(L, 1), part(L, 2)]
    else false
  )
  else false)$

/* Rubi :3824-:3832  CollectReciprocals[u, x] — with b c + a d = 0 the pair
   e/(a+b x) + f/(c+d x) collapses: to (c e + a f)/(a c + b d x^2) when
   d e + b f = 0, and to (d e + b f) x/(a c + b d x^2) when c e + a f = 0.
   The .m recurses until no pair matches; the port scans the term list for
   the first matching pair, rebuilds the sum and recurses. */
%mr_collectReciprocals(u, x) := block(
  [T, P, i, j, n, hit, e, f, a, b, c, d, rest, k],
  if not %mr_sumQ(u) then return(u),
  T : %mr_parts_list(u),
  n : length(T),
  P : map(lambda([z], %mr_cr_part(z, x)), T),
  hit : false,
  for i : 1 thru n do
    if hit = false then
      for j : i + 1 thru n do
        if hit = false and part(P, i) # false and part(P, j) # false then (
          e : part(part(P, i), 1), a : part(part(P, i), 2), b : part(part(P, i), 3),
          f : part(part(P, j), 1), c : part(part(P, j), 2), d : part(part(P, j), 3),
          if %mr_eqQ(b*c + a*d, 0) then (
            if %mr_eqQ(d*e + b*f, 0)
            then hit : [i, j, (c*e + a*f)/(a*c + b*d*x^2)]
            else if %mr_eqQ(c*e + a*f, 0)
            then hit : [i, j, (d*e + b*f)*x/(a*c + b*d*x^2)]
          )
        ),
  if hit = false then u
  else (
    rest : 0,
    for k : 1 thru n do
      if k # part(hit, 1) and k # part(hit, 2) then rest : rest + part(T, k),
    %mr_collectReciprocals(rest + part(hit, 3), x)
  ))$

/* Rubi :3805/:3810  ExpandCleanup[u, x] — CollectReciprocals, then
   SimplifyTerm on every term, then UnifySum.
   The .m's first clause (:3805) collapses one reciprocal pair directly
   before the general branch; its pattern and conditions are a special
   case of the CollectReciprocals scan the general branch runs, so the
   port runs the general branch only (stated deviation: same result, one
   pass fewer). */
%mr_expandCleanup(u, x) := block([v],
  v : %mr_collectReciprocals(u, x),
  if %mr_sumQ(v) then (
    /* ratdisrep is LOAD-BEARING, not tidying. MEASURED 2026-09-16 (this
       build): %mr_simplifyTerm returns a CRE — it calls %mr_together,
       whose rat() (line 372) makes the term an MRAT object, and
       num(r)/denom(r) of a CRE is still a CRE (?caar = MRAT, where the
       term itself is MTIMES). Maxima's "+" on CRE operands COMBINES them
       into one canonical fraction, so mapping SimplifyTerm over the three
       partial fractions of 1.1.1.4 e4 and adding them back rebuilt the
       single quotient (b x + a)/(cubic) — SumQ false, the whole cascade a
       no-op, the expanded-denominator form the port exists to avoid.
       Mathematica's Plus never recombines, which is why the .m can map
       SimplifyTerm directly. ratdisrep returns each term to a general
       expression, and the sum stays a 3-term sum (ratsimp difference 0).
       The CRE is not removed from %mr_together itself: 200+ call sites
       depend on its current behaviour. */
    v : apply("+", map(lambda([z], ratdisrep(%mr_simplifyTerm(z, x))),
                       %mr_parts_list(v))),
    if %mr_sumQ(v) then %mr_unifySum(v, x) else v
  )
  else v)$

/* Mathematica Expand[u, x] — expand the x-dependent structure, KEEPING the
   x-free factors unmultiplied (Maxima's expand and ratexpand multiply
   those out too). The share package `format` has exactly this reading.
   MEASURED 2026-09-16 (this build): format((a+b)^2*(x+1)^2, %poly(x)) ->
   (b+a)^2*x^2 + 2*(b+a)^2*x + (b+a)^2; sqrt(x)*(x+1)^2 -> x^(5/2) +
   2*x^(3/2) + sqrt(x); (a+b)*(c+d) unchanged.
   Stated deviation: format COLLECTS the coefficient of each power of x
   ((a d + b c) x) where Expand keeps the like-power terms separate
   (a d x + b c x); ExpandCleanup's UnifySum collects them anyway.
   The package must be loaded: without it format(u, %poly(x)) stays a NOUN
   (measured — op = format) and would flow silently into an integrand, so
   maxima_rubi.mac loads it and checks a witness. */
%mr_expand_x(u, x) := format(u, %poly(x))$

/* Rubi :3980/:3984  ExpandAlgebraicFunction[u, x]:
     u_Plus * v_      -> Map[#*v, u]              when u is not free of x;
     u_Plus^n_ * v_.  -> Map[#*v, Expand[u^n, x]] when n is a positive
                         integer, u is not free of x and the expansion is
                         a sum.
   No .m rule applies otherwise; the port answers false there, which the
   cascade reads as "this branch did not apply" (the .m's v = 0). */
%mr_expandAlgebraicFunction(u, x) := block([F, i, z, hit, w, rest],
  if atom(u) then false
  else (
    F : %mr_product_factors(u),
    hit : false,
    for i : 1 thru length(F) do
      if hit = false then (
        z : part(F, i),
        if %mr_sumQ(z) and not freeof(x, z) then hit : [i, z]
      ),
    if hit # false then (
      rest : %mr_product_from_list(%mr_list_without(F, part(hit, 1))),
      apply("+", map(lambda([t], t*rest), %mr_parts_list(part(hit, 2))))
    )
    else (
      for i : 1 thru length(F) do
        if hit = false then (
          z : part(F, i),
          if not atom(z) and op(z) = "^" and %mr_sumQ(part(z, 1))
             and integerp(part(z, 2)) and is(part(z, 2) > 0)
             and not freeof(x, part(z, 1))
          then hit : [i, z]
        ),
      if hit = false then false
      else (
        w : %mr_expand_x(part(hit, 2), x),
        if not %mr_sumQ(w) then false
        else (
          rest : %mr_product_from_list(%mr_list_without(F, part(hit, 1))),
          apply("+", map(lambda([t], t*rest), %mr_parts_list(w)))
        )
      )
    )
  ))$

/* Rubi :3780  ExpandExpression[u, x] — the cascade, in the .m's order:
   ExpandAlgebraicFunction (algebraic but not rational), SmartApart,
   SmartApart of the rational factors times the non-rational ones,
   Expand[u, x], Expand[u]; every sum result through ExpandCleanup, and
   SimplifyTerm as the last resort. */
%mr_expandExpression(u, x) := block([v, w],
  v : if %mr_algebraicFunctionQ(u, x) and not %mr_rationalFunctionQ(u, x)
      then %mr_expandAlgebraicFunction(u, x)
      else 0,
  if v # false and %mr_sumQ(v) then return(%mr_expandCleanup(v, x)),
  v : %mr_smartApart(u, x),
  if %mr_sumQ(v) then return(%mr_expandCleanup(v, x)),
  v : %mr_smartApart(%mr_rationalFunctionFactors(u, x), x, x),
  if %mr_sumQ(v) then (
    w : %mr_nonrationalFunctionFactors(u, x),
    return(%mr_expandCleanup(
      apply("+", map(lambda([z], z*w), %mr_parts_list(v))), x))
  ),
  v : %mr_expand_x(u, x),
  if %mr_sumQ(v) then return(%mr_expandCleanup(v, x)),
  v : expand(u),
  if %mr_sumQ(v) then return(%mr_expandCleanup(v, x)),
  %mr_simplifyTerm(u, x))$

/* ---- cluster J: the remaining high-usage B-tier shims ---------------
 * SubstFor / SubstPower are the ALGEBRAIC surface: x^n and linear-v
 * substitutions (the .m's trig / inverse-function branches are not
 * ported). Dist is the DistributeOverTerms surface. Cancel is factor()
 * (the unbound builtin, measured). PolyGCD is the monic x-dependent
 * gcd. RationalFunctionExpand is the algebraic-ExpandIntegrand surface
 * (the .m's RationalFunctionFactors / NonrationalFunctionFactors split
 * is deferred). */

/* Rubi :6142  SubstPower[F[x], x, n] — x^m -> x^(m*n), x -> x^n. */
%mr_substPower(u, x, n) := block([],
  if atom(u) then (
    if is(u = x) then x^n else u
  )
  else if numberp(u) then u
  else if not atom(u) and op(u) = "^" then (
    if is(part(u, 1) = x) and freeof(x, part(u, 2))
    then x^(n*part(u, 2))
    else %mr_substPower(part(u, 1), x, n)
         ^%mr_substPower(part(u, 2), x, n)
  )
  else if not atom(u) and op(u) = "*"
  then apply("*", map(lambda([z], %mr_substPower(z, x, n)),
    %mr_parts_list(u)))
  else if not atom(u) and op(u) = "+"
  then apply("+", map(lambda([z], %mr_substPower(z, x, n)),
    %mr_parts_list(u)))
  else if not atom(u) and op(u) = "/"
  then %mr_substPower(part(u, 1), x, n)
       /%mr_substPower(part(u, 2), x, n)
  else if not atom(u) and op(u) = "-"
  then -%mr_substPower(part(u, 1), x, n)
  else if not atom(u) and op(u) = "["
  then map(lambda([z], %mr_substPower(z, x, n)), %mr_parts_list(u))
  else (
    /* generic head — MEASURED 2026-08-25 on 5.50.0/SBCL: sqrt(e) is
       its OWN head (op = "sqrt", NOT "^"), so the explicit cases
       above miss it and the old `else u` left sqrt(3*x^2+5*x+2)
       untouched under SubstPower[., x, 2] (derailing 1.4.1 r34 on
       1.2.1.3 e1058: the inner integrand kept a quadratic radical
       where the substitution needs the quartic). Rubi's SubstPower
       is Map over every subpart (IntegrationUtilityFunctions.m:6142),
       so walk args generically. */
    apply(op(u), map(lambda([z], %mr_substPower(z, x, n)), args(u)))))$

/* Rubi :5980  SubstFor[v, u, x] — u (a function of v) with v replaced
   by x. The algebraic surface: an atom is a plain subst, x^n is the
   SubstPower reading with factor 1/n, a linear v is the shifted
   variable (x-a)/b, and the fallback is the plain subst. */
%mr_substFor3(v, u, x) := block([L],
  if %mr_atomQ(v)
  then subst(x, v, u)
  /* Task 9 (inert-trig substrate): the .m's InertTrigFreeQ arm and its
     circular-trig Switch arms (Sin/Cos/Tan/Cot only -- %mr_substForTrigHead,
     defined with FunctionOfQ at the end of this file, which states the
     deviations). No class-1 call site reaches either: class-1 u carries no
     inert head and class-1 v no trig factor. */
  else if not %mr_inertTrigFreeQ(u)
  then %mr_substFor3(v, %mr_activateTrig(u), x)
  else if not atom(%mr_nonfreeFactors(v, x))
    and is(member(op(%mr_nonfreeFactors(v, x)), [sin, cos, tan, cot]) = true)
  then %mr_substForTrigHead(v, u, x)
  else if not atom(v) and op(v) = "^"
    and is(part(v, 1) = x) and freeof(x, part(v, 2))
  then %mr_substPower(u, x, 1/part(v, 2))
  else if %mr_linearQ(v, x) then (
    L : %mr_binomial_parts(v, x),
    if not atom(L) and is(part(L, 3) = 1)
    then subst((x - part(L, 1))/part(L, 2), x, u)
    else subst(x, v, u)
  )
  else subst(x, v, u))$

/* Rubi :5976  SubstFor[w,v,u,x] := SimplifyIntegrand[w*SubstFor[v,u,x],x].
   Task 10 (inert-trig substrate) restores the SimplifyIntegrand the old
   port omitted (it read w*SubstFor[v,u,x] bare). Only class 4's 4.7.5
   records call the 4-argument form (grep of rules/, 2026-09-21: every
   class-1 call site passes 3). The Weierstrass record (r71) needs it:
   without it the half-angle integrand reached its trial Int as
   1/((x^2+1)*(3+2*(1/(x^2+1)-x^2/(x^2+1)))) -- an unnormalized rational no
   rule matches -- instead of Rubi's 1/(x^2+5).

   SimplifyIntegrand (L2148-2155) is NormalizeLeadTermSigns[
   NormalizeIntegrandAux[Simplify[u],x]], and what matters here is its
   Simplify. DEVIATION (stamped; a SHAPE approximation). It is
   value-preserving, but it CAN move a record's accept/decline: r71's
   condition is CalculusFreeQ of a trial Int of exactly this simplified
   shape, and any record that tests a nested Int result's shape is in the
   same position -- the shape decides which rules the nested Int meets, so
   whether it comes back calculus-free (r71 declined without this; that is
   why it was added). The approximation may therefore accept or decline
   where Rubi's Simplify would not. Mathematica's Simplify returns the smallest form
   (by its LeafCount-based complexity) among the transformations it tries,
   never one larger than its input. The port takes the smallest by
   %mr_leafCount of three candidates -- u itself, ratsimp(u) and
   factor(ratsimp(u)) -- preferring them in that order on a tie. The
   house %mr_simp (the table's SimplifyIntegrand) is NOT used: it ends in
   ratsimp, which re-expands a factored denominator -- MEASURED 2026-09-21,
   6.1.5 e6 sinh(a+b*x)^6: 4.7.5 r58's integrand x^6/(x^2+1)^4 became
   x^6/(x^8+4*x^6+6*x^4+4*x^2+1), the nested Int left an unintegrable
   piece, and a verified entry fell to contains-noun. With u a candidate a
   form that is already simplest (that one, and the Task-9 records'
   integrands) reaches Int unchanged. */
%mr_sf4_simplify(%mr_sf4_u) := block([%mr_sf4_best, %mr_sf4_r, %mr_sf4_f],
  %mr_sf4_best : %mr_sf4_u,
  %mr_sf4_r : errcatch(ratsimp(%mr_sf4_u)),
  if %mr_sf4_r # [] then (
    %mr_sf4_r : first(%mr_sf4_r),
    if %mr_leafCount(%mr_sf4_r) < %mr_leafCount(%mr_sf4_best)
    then %mr_sf4_best : %mr_sf4_r,
    %mr_sf4_f : errcatch(factor(%mr_sf4_r)),
    if %mr_sf4_f # [] then (
      %mr_sf4_f : first(%mr_sf4_f),
      if %mr_leafCount(%mr_sf4_f) < %mr_leafCount(%mr_sf4_best)
      then %mr_sf4_best : %mr_sf4_f)),
  %mr_sf4_best)$

%mr_substFor4(w, v, u, x) := %mr_sf4_simplify(w*%mr_substFor3(v, u, x))$

%mr_substFor : lambda([a, b, c, [d]],
  if length(d) = 0
  then %mr_substFor3(a, b, c)
  else %mr_substFor4(a, b, c, part(d, 1)))$

/* Rubi's Dist — distribute the first argument over a Plus sum, leave
   everything else (a noun Sum in particular) multiplied. */
%mr_dist : lambda([a, b, [c]],
  %mr_ei_distribute(a, b, 0))$

/* Rubi :1518  NormalizePseudoBinomial[u, x] — a + b*(c+d*x)^n. Fails
   closed to u (the .m's False[[1]] hard-errors; the class-1 call sites
   gate on PseudoBinomialPairQ first). */
%mr_normalizePseudoBinomial(u, x) := block([L],
  L : %mr_pseudoBinomial_parts(u, x),
  if atom(L) then u
  else part(L, 1) + part(L, 2)*(part(L, 3) + part(L, 4)*x)^part(L, 5))$

/* Rubi's Cancel — the builtin is unbound in this build (measured);
   factor() is the closest cancel-without-expand reading. */
%mr_cancel(u) := block([r],
  r : errcatch(factor(u)),
  if is(r = []) then u else part(r, 1))$

/* Rubi :1668  PolyGCD[u, v, x] — the monic x-dependent gcd. The .m's
   PolynomialGCD is monic; Maxima's gcd carries the content, so the
   leading coefficient is divided out (the NonfreeFactors reading then
   drops any surviving free factor). */
%mr_polyGCD(u, v, x) := block([g, d, lc],
  if %mr_polynomialQ(u, x) and %mr_polynomialQ(v, x)
  then (
    g : errcatch(gcd(u, v, x)),
    if is(g = []) then false
    else (
      g : part(g, 1),
      if freeof(x, g) then 1
      else (
        d : %mr_degree(g, x),
        lc : %mr_coeff(g, x, d),
        g/lc
      )
    )
  )
  else false)$

/* Rubi :1644  RationalFunctionExpand[u, x] — the algebraic
   ExpandIntegrand surface (the .m's RationalFunctionFactors /
   NonrationalFunctionFactors split is deferred). */
%mr_rationalFunctionExpand(u, x) := %mr_expandIntegrand2(u, x)$

/* ---- cluster K: the last B-tier names --------------------------------
 * Root is the rational reading of the Mathematica Root object (the
 * k-th root, in ascending real-part order, when it is an explicit
 * rational). IntSum / IntTerm are the .m definitions (:7694/:7699) over
 * the already-ported FreeFactors / NonfreeFactors / RemoveContent
 * surface. Hold is the ShowStep wrapper — identity outside the
 * (unported) ShowStep machinery. */

%mr_freeTerms(u, x) := block([],
  if %mr_sumQ(u)
  then apply("+", map(
    lambda([z], if freeof(x, z) then z else 0), %mr_parts_list(u)))
  else if freeof(x, u) then u else 0)$

%mr_nonfreeTerms(u, x) := block([],
  if %mr_sumQ(u)
  then apply("+", map(
    lambda([z], if freeof(x, z) then 0 else z), %mr_parts_list(u)))
  else if freeof(x, u) then 0 else u)$

%mr_intTerm_linear_at(F, i, x, mode) :=
  block([f, base, m, R, j, rest],
    f : part(F, i),
    if mode = "power" then (
      if not atom(f) and op(f) = "^" then (
        base : part(f, 1),
        m : part(f, 2),
        if %mr_linearQ(base, x) and freeof(x, m)
        then (
          R : [],
          for j : 1 thru length(F) do
            if j # i then R : append(R, [part(F, j)]),
          rest : %mr_product_from_list(R),
          if freeof(x, rest) then [rest, base, m] else false
        )
        else false
      )
      else false
    )
    else (
      if not atom(f) and op(f) # "^" and %mr_linearQ(f, x)
      then (
        R : [],
        for j : 1 thru length(F) do
          if j # i then R : append(R, [part(F, j)]),
        rest : %mr_product_from_list(R),
        if freeof(x, rest) then [rest, f, 1] else false
      )
      else false
    ))$

/* c*v^m (v linear in x, c and m free of x) as [c, v, m], or false. A
   quotient is read as the negative-power form (Maxima stores c/v^m as
   a / node, not a ProductQ). */
%mr_intTerm_linear(u, x) := block([F, i, r, num, den],
  if not atom(u) and op(u) = "/" then (
    num : part(u, 1),
    den : part(u, 2),
    if freeof(x, num)
    then (
      if %mr_linearQ(den, x) then [num, den, -1]
      else if not atom(den) and op(den) = "^"
        and %mr_linearQ(part(den, 1), x)
        and freeof(x, part(den, 2))
      then [num, part(den, 1), -part(den, 2)]
      else false
    )
    else false
  )
  else (
    F : %mr_product_factors(u),
    r : false,
    for i : 1 thru length(F) do
      if r = false then
        r : %mr_intTerm_linear_at(F, i, x, "power"),
    if r # false then r
    else (
      for i : 1 thru length(F) do
        if r = false then
          r : %mr_intTerm_linear_at(F, i, x, "bare"),
      r
    )
  ))$

/* Rubi :7699  IntTerm[u, x] */
%mr_intTerm(u, x) := block([L, c, base, m, u1, ff, nf],
  if %mr_sumQ(u)
  then apply("+", map(lambda([z], %mr_intTerm(z, x)),
    %mr_parts_list(u)))
  else (
    L : %mr_intTerm_linear(u, x),
    if L # false
    then (
      c : part(L, 1),
      base : part(L, 2),
      m : part(L, 3),
      u1 : %mr_cancel(base),
      if is(m = -1)
      then c*log(%mr_removeContent(u1, x))/%mr_coeff(u1, x, 1)
      else if is(m = 1) and %mr_eqQ(c, 1) and %mr_sumQ(u1)
      then %mr_intSum(u1, x)
      else c*u1^(m + 1)/(%mr_coeff(u1, x, 1)*(m + 1))
    )
    else (
      ff : %mr_freeFactors(u, x),
      nf : %mr_nonfreeFactors(u, x),
      ff*mr_int(nf, x)
    )
  ))$

/* Rubi :7694  IntSum[u, x] */
%mr_intSum(u, x) :=
  %mr_freeTerms(u, x)*x + %mr_intTerm(%mr_nonfreeTerms(u, x), x)$

/* The rational-root reading of the Mathematica Root object: the k-th
   root of an explicit-rational polynomial (ascending, with multiplicity)
   when it is an explicit rational, else false (the rule declines). */
%mr_root_roots(e, var, acc) := block([base, exp, i],
  if atom(e) then acc
  else if numberp(e) then acc
  else if op(e) = "^" then (
    base : part(e, 1),
    exp : part(e, 2),
    if integerp(exp) and is(exp > 0)
    then (
      for i : 1 thru exp do
        acc : %mr_root_roots(base, var, acc),
      acc
    )
    else acc
  )
  else if op(e) = "*" then (
    for i : 1 thru length(e) do
      acc : %mr_root_roots(part(e, i), var, acc),
    acc
  )
  else if %mr_polynomialQ(e, var) and is(%mr_degree(e, var) = 1)
  then append(acc,
    [-%mr_coeff(e, var, 0)/%mr_coeff(e, var, 1)])
  else acc)$

%mr_root(poly, k) := block([d, i, ok, r, roots],
  if integerp(k) and %mr_polynomialQ(poly, x)
  then (
    d : %mr_degree(poly, x),
    ok : true,
    for i : 0 thru d do
      if not %mr_rationalQ(%mr_coeff(poly, x, i)) then ok : false,
    if ok
    then (
      r : errcatch(factor(poly)),
      if is(r = []) then false
      else (
        roots : %mr_root_roots(part(r, 1), x, []),
        roots : sort(roots),
        if length(roots) >= k
          and %mr_rationalQ(part(roots, k))
        then part(roots, k)
        else false
      )
    )
    else false
  )
  else false)$

/* Rubi's ShowStep Hold wrapper — identity outside the (unported)
   ShowStep machinery. */
%mr_hold(u) := u$

/* ---- class-2 (exponentials) cluster A: the small predicates -------- */

/* Rubi TrueQ — true iff the value is literally true (Mathematica
   builtin; used in class 2 only on the $UseGamma control flag).
   is() gives the true/false/unknown trichotomy; unknown is not true. */
%mr_trueQ(v) := block([], is(is(v) = true))$

/* The package home of Rubi's $UseGamma control variable. Undefined in
   the pinned Rubi 4 (grep 2026-08-28: absent from Rubi.m and the
   utility files); the class-2 corpus file headers state the optimal
   antiderivatives assume $UseGamma = false, so the default is false —
   the gamma-form rules decline by default and fire only if the flag is
   set true explicitly. A variable, not a function (the
   mr_simplify_flag precedent, this file's line 11). */
mr_use_gamma_flag : false$

/* Rubi PowerQ (:162) — the Power-head test. MEASURED 2026-08-28
   (5.50.0/SBCL): a power's op is the STRING "^" (stringp(op(x^2))
   true, symbolp false; is(op(x^2) = "^") true — this file's house
   idiom, e.g. line 624; is(op(x^2) = power) false, the symbol
   power # the string "^"). Maxima strips the exponent-1 Power head
   (x^1 -> x), so a bare linear form reaches this as an atom/sum —
   the %mr_linearQ branch of the PowerOfLinear family covers that
   case; and x^(1/2) is stored as a 'sqrt node (the line-1242 note),
   so PowerQ(sqrt(x)) is false by design — this predicate sees only
   kept power nodes. */
%mr_powerQ(u) := block([],
  if atom(u) then false
  else is(op(u) = "^"))$

/* Rubi CalculusQ — head in the calculus list ($CalculusFunctions =
   {D, Integrate, Sum, Product, Int, Unintegrable, CannotIntegrate,
   Dif, Subst}). The package nouns stand in: the diff/integrate/
   sum/product nouns, and the 'unintegrable[f, x] noun (the catch-all
   marker, mr_unintegrable, this file's line 27); mr_int and %mr_subst
   are evaluated functions (no noun forms) but their names stay in the
   list for the stand-in mapping. Dif and CannotIntegrate have no
   package counterpart.
   MEASURED 2026-08-28 (5.50.0/SBCL): a NOUN's op is an internal
   symbol whose string() is the head name — NOT the function symbol
   (is(op('integrate[f(x),x]) = 'integrate) false, likewise for
   'diff/'sum/'product/'unintegrable), so a member() over function
   symbols never matches; the test runs on string(op(u)) — a member
   over the string list (is(string(op('diff[f(x),x])) = "diff")
   true; the diff noun's internal symbol DISPLAYS as `derivative` in
   math mode but string()s to "diff"). For operator heads op()
   already returns a string (op(f*x) is "*"), and string() of a
   string is the identity, so one test covers both. member() returns
   a boolean in this build (note at line 758). Also measured:
   integrate/sum of an x-INDEPENDENT summand EVALUATE to an ordinary
   product (integrate(f, x) = f*x, sum(f, x, 1, n) = f*n even at
   symbolic bound, op "*"), so a calculus noun only exists when the
   summed/integrated object depends on the variable. */
%mr_calculusQ(u) := block([s],
  if atom(u) then false
  else (
    s : string(op(u)),
    is(member(s, ["integrate", "diff", "sum", "product",
                  "mr_int", "mr_subst", "unintegrable"]) = true)
  ))$

/* Rubi HyperbolicQ — the six hyperbolic heads (the
   FunctionOfExponential machinery's explicit-exponential detection).
   All six are native in this build (5.50.0). MEASURED 2026-08-28: an
   ordinary function application's op IS the function symbol
   (is(op(sinh(x)) = sinh) true — unlike the noun heads above), so
   member() over the symbol list matches directly.

   ATOM BRANCH ADDED 2026-09-20 (class-6 Step 4, cluster A). The .m is
     HyperbolicQ[u_] := MemberQ[$HyperbolicFunctions,
                                If[AtomQ[u], u, Head[u]]]
   (IntegrationUtilityFunctions.m L255-256) — for an ATOM the test is on
   the symbol ITSELF, not on its head. This port read `atom(u) -> false`,
   which was invisible for class 2 (its only two call sites, the
   %mr_foE_ ones below, always hold an application) and WRONG for class 6,
   whose 6.7.7 / 6.7.9 rules call HyperbolicQ[F] on a head symbol bound by
   a head-position capture — 11 rules, where F is the atom sinh, not
   sinh(...). Found by the cluster-A red test, not by inspection.
   MEASURED 2026-09-20 (branch_5_50_base_84_g4204fb669 / SBCL 2.6.7):
   atom(sinh) = true, atom(sinh(x)) = false,
   is(member(sinh, [sinh, cosh]) = true) = true. */
%mr_hyperbolicQ(u) := block([],
  is(member(if atom(u) then u else op(u),
            [sinh, cosh, tanh, coth, sech, csch]) = true))$

/* Rubi IndependentQ[u,x] := FreeQ[u,x] (IntegrationUtilityFunctions.m
   L149-150) — a one-line alias upstream, and the same here: the
   argument order flips, as it does for every FreeQ port in this file
   (freeof takes the variable first). Class 6 group D, 6 rules. */
%mr_independentQ(u, x) := block([], is(freeof(x, u) = true))$

/* Rubi QuotientOfLinearsP / QuotientOfLinearsParts / QuotientOfLinearsQ
   (IntegrationUtilityFunctions.m L1729-1795). Class 6 group D/E: 6.7.9
   r53/r54, Int[Sinh[u]^n]/Int[Cosh[u]^n] with u a quotient of linears.

   Parts[u,x] returns [a, b, c, d] with u == (a + b x)/(c + d x); the
   generated call sites read it exactly that way (rules/class6/6_7_9.mac
   L429). The clause ORDER is the .m's and is load-bearing: the free
   multiplicative factor and the free additive term are peeled BEFORE the
   linear / quotient tests, so 7*(2+3x)/(4+5x) and 2+(1+x)/(3+4x) reduce
   to the inner quotient and then scale/fold.

   Q is strictly NARROWER than "has the shape": the .m ends
   ... && NeQ[parts[[2]],0] && NeQ[parts[[4]],0], so a bare linear
   (d = 0) and a bare reciprocal (b = 0) both HAVE Parts and are NOT
   quotients of linears.

   Maxima notes (measured 2026-09-20, branch_5_50_base_84_g4204fb669):
   %mr_freeFactors returns 1 when no factor is free, %mr_freeTerms 0 when
   no term is; `return` inside a `for` exits the LOOP, not the block, so
   the ListQ branch carries a flag instead. */
%mr_quotientOfLinearsP(u, x) := block([n, d],
  if %mr_productQ(u) and not is(%mr_freeFactors(u, x) = 1)
    then return(%mr_quotientOfLinearsP(%mr_nonfreeFactors(u, x), x)),
  if not %mr_nonsumQ(u) and not is(%mr_freeTerms(u, x) = 0)
    then return(%mr_quotientOfLinearsP(%mr_nonfreeTerms(u, x), x)),
  /* the .m's 1/u_ clause. MEASURED 2026-09-20
     (branch_5_50_base_84_g4204fb669): Maxima stores 1/(4+5*x) with
     op "/" and args [1, 5*x+4] — NOT a power with exponent -1 and not a
     product, so a powerQ/part(u,2)=-1 test never fires. num/denom is
     the representation-independent read and also covers a (..)^-1 form.
     The clause must stay AHEAD of the u_/v_ one: %mr_linearQ(1, x) is
     false (faithfully — Rubi's LinearQ[1,x] is False too), so a bare
     reciprocal would otherwise fall all the way through to the final
     clause and report the wrong shape. */
  n : num(u), d : denom(u),
  if not is(d = 1) and is(n = 1)
    then return(%mr_quotientOfLinearsP(d, x)),
  if %mr_linearQ(u, x) then return(true),
  if not is(d = 1) and %mr_linearQ(n, x) and %mr_linearQ(d, x)
    then return(true),
  is(u = x) or is(freeof(x, u) = true))$

%mr_quotientOfLinearsParts(u, x) := block([a, p, n, d],
  if %mr_productQ(u) then (
    a : %mr_freeFactors(u, x),
    if not is(a = 1) then (
      p : %mr_quotientOfLinearsParts(%mr_nonfreeFactors(u, x), x),
      return([a*part(p, 1), a*part(p, 2), part(p, 3), part(p, 4)]))),
  if not %mr_nonsumQ(u) then (
    a : %mr_freeTerms(u, x),
    if not is(a = 0) then (
      p : %mr_quotientOfLinearsParts(%mr_nonfreeTerms(u, x), x),
      return([part(p, 1) + a*part(p, 3), part(p, 2) + a*part(p, 4),
              part(p, 3), part(p, 4)]))),
  /* the .m's 1/u_ clause — swaps the pairs. See the note in
     %mr_quotientOfLinearsP on why this reads num/denom and why it must
     precede the linear and u_/v_ clauses. */
  n : num(u), d : denom(u),
  if not is(d = 1) and is(n = 1) then (
    p : %mr_quotientOfLinearsParts(d, x),
    return([part(p, 3), part(p, 4), part(p, 1), part(p, 2)])),
  if %mr_linearQ(u, x)
    then return([%mr_coeff(u, x, 0), %mr_coeff(u, x, 1), 1, 0]),
  if not is(d = 1) and %mr_linearQ(n, x) and %mr_linearQ(d, x)
    then return([%mr_coeff(n, x, 0), %mr_coeff(n, x, 1),
                 %mr_coeff(d, x, 0), %mr_coeff(d, x, 1)]),
  /* the .m's last clause: x -> {0,1,1,0}; free of x -> {u,0,1,0}; and
     the unexpected form takes the SAME value after a Message, which
     this port does not emit (nothing reads it). */
  if is(u = x) then [0, 1, 1, 0] else [u, 0, 1, 0])$

%mr_quotientOfLinearsQ(u, x) := block([p, r, e],
  if listp(u) then (
    r : true,
    for e in u do (if not %mr_quotientOfLinearsQ(e, x) then r : false),
    return(r)),
  if not %mr_quotientOfLinearsP(u, x) then return(false),
  p : %mr_quotientOfLinearsParts(u, x),
  is(%mr_neQ(part(p, 2), 0) and %mr_neQ(part(p, 4), 0)))$

/* ---- class 6 cluster C: the ExpandTrig family -----------------------
 * Rubi IntegrationUtilityFunctions.m L4030-4092. The class's biggest
 * porting item: ExpandTrigReduce 26 rules, ExpandTrigToExp 4,
 * ExpandTrigExpand 1.
 *
 * Substrate map, MEASURED 2026-09-20 (branch_5_50_base_84_g4204fb669):
 *   TrigReduce  -> trigreduce      (handles the hyperbolics:
 *                  trigreduce(sinh(x)*cosh(x)) = sinh(2*x)/2)
 *   TrigExpand  -> trigexpand      (trigexpand(cosh(2*x)) =
 *                  sinh(x)^2+cosh(x)^2)
 *   TrigToExp   -> exponentialize
 *   ReplaceAll[.., x->v] -> subst(v, x, ..)   (subst is new, old, expr)
 *
 * TWO DOCUMENTED DEVIATIONS from the .m, both forced by the substrate:
 *
 * 1. The .m carries a THIRD ExpandTrigReduce clause,
 *      u_.*F_[n_+v_.]^m_. /; MemberQ[{Sinh,Cosh},F] && IntegerQ[m]
 *                          && RationalQ[n]
 *    whose own comment says it exists "because TrigReduce expands
 *    Sinh[n+v] and Cosh[n+v] to exponential form if n is a number"; it
 *    substitutes a fresh symbol for n and puts it back afterwards.
 *    Maxima's trigreduce has NO such behaviour — measured,
 *    trigreduce(sinh(2+v)) = sinh(v+2) and trigreduce(sinh(2+v)^2) =
 *    (cosh(2*(v+2))-1)/2, both staying hyperbolic — so the clause is a
 *    workaround for a problem this build does not have and is NOT
 *    ported. If trigreduce ever starts exponentializing, this is the
 *    note to come back to.
 *
 * 2. exponentialize(sinh(x)) = (%e^x-%e^-x)/2, whose op is "/" — NOT a
 *    sum — while Mathematica's TrigToExp returns the distributed
 *    -E^-x/2 + E^x/2. The .m's SumQ branch therefore fires upstream and
 *    would not here, changing whether SimplifyIntegrand is mapped per
 *    term. expand() restores the upstream shape (measured:
 *    expand(exponentialize(sinh(x))) = %e^x/2-%e^-x/2, op "+").
 */

/* NormalizeTrigReduce[a_.*F_[u_]^n_.,x] := a*F[ExpandToSum[u,x]]^n
   /; FreeQ[{F,a,n},x] && PolynomialQ[u,x] && Exponent[u,x]>0 — the
   trig/hyperbolic argument comes back as a SUM rather than a factored
   product, so trigreduce's cosh(2*(a+b*x)) reads cosh(2*a+2*b*x). */
%mr_ntrHeads : [sinh, cosh, tanh, coth, sech, csch,
                sin, cos, tan, cot, sec, csc]$

%mr_normalizeTrigReduceFactor(f, x) := block([b, e, h, u],
  b : f, e : 1,
  if %mr_powerQ(f) then (b : part(f, 1), e : part(f, 2)),
  if atom(b) then return(f),
  h : op(b),
  if not is(member(h, %mr_ntrHeads) = true) then return(f),
  if not is(length(args(b)) = 1) then return(f),
  u : part(b, 1),
  /* PolynomialQ[u,x] && Exponent[u,x] > 0 */
  if freeof(x, u) or not %mr_polyQ(u, x) then return(f),
  apply(h, [%mr_expandToSum(u, x)])^e)$

%mr_normalizeTrigReduce(t, x) := block([L, r, f],
  L : if %mr_productQ(t) then args(t) else [t],
  r : 1,
  for f in L do r : r * %mr_normalizeTrigReduceFactor(f, x),
  r)$

%mr_expandTrigReduceAux(u, x) := block([v],
  v : expand(trigreduce(u)),
  if %mr_nonsumQ(v) then %mr_normalizeTrigReduce(v, x)
  else map(lambda([t], %mr_normalizeTrigReduce(t, x)), v))$

%mr_expandTrigReduce3(u, v, x) := block([w],
  w : %mr_expandTrigReduceAux(v, x),
  if %mr_nonsumQ(w) then u*w else map(lambda([t], u*t), w))$

/* arity dispatch, the %mr_expandToSum idiom: (u,x) and (u,v,x) */
%mr_expandTrigReduce : lambda([a, b, [c]],
  if length(c) = 0
  then %mr_expandTrigReduceAux(a, b)
  else %mr_expandTrigReduce3(a, b, part(c, 1)))$

%mr_expandTrigToExp3(u, v, x) := block([w],
  w : expand(exponentialize(v)),   /* deviation 2 above */
  w : if %mr_nonsumQ(w) then %mr_simp(u*w, x)
      else map(lambda([t], %mr_simp(u*t, x)), w),
  %mr_expandIntegrand(%mr_freeFactors(w, x), %mr_nonfreeFactors(w, x), x))$

/* the .m's ExpandTrigToExp[u,x] := ExpandTrigToExp[1,u,x] */
%mr_expandTrigToExp : lambda([a, b, [c]],
  if length(c) = 0
  then %mr_expandTrigToExp3(1, a, b)
  else %mr_expandTrigToExp3(a, b, part(c, 1)))$

%mr_expandTrigExpand(u, F, v, m, n, x) := block([w],
  w : subst(v, x, expand(trigexpand(apply(F, [n*x]))^m)),
  if %mr_nonsumQ(w) then u*w else map(lambda([t], u*t), w))$

/* Rubi EveryQ — func over every element, true iff all true.
   MEASURED 2026-08-28 (5.50.0/SBCL): list iteration is `for e in
   lst` — `for e : lst` parses as `for e from lst` (the definition
   echo shows it), which iterates the whole list as ONE element and
   made everyQ([1,2,3]) false. f(e) applies the lambda parameter
   directly (measured equal to apply(f, [e])). */
%mr_everyQ(f, lst) := block([r],
  r : true,
  for e in lst while r do r : is(f(e)),
  r)$

/* PowerOfLinearQ / PowerOfLinearMatchQ / NormalizePowerOfLinear —
   UNDEFINED in the pinned Rubi 4 clone (measured 2026-08-28: no
   definition in IntegrationUtilityFunctions.m or anywhere in the
   clone; absent from the Rubi-5 stub too), yet called by 2.1 r17/r18
   and 2.3 r8/r9/r10/r38 (upstream numbers; the generated call sites
   are 2.1 r12/r13 and 2.3 r5/r6/r7/r35). Ported from the call-site
   contract: u is a rational power of a linear form in x.
   Storage adaptations, MEASURED 2026-08-28 (5.50.0/SBCL):
   * Maxima strips the exponent-1 Power head (x^1 -> x), so a bare
     linear form counts (the %mr_linearQ branch is the exponent-1
     case);
   * (linear)^(1/2) is stored as a 'sqrt node (the op string of
     (a+b*X)^(1/2) is "sqrt"), so the sqrt-of-linear branch is the
     exponent-1/2 case;
   * the EXONENT is the part that must be x-free (freeof(x,
     part(u, 2))): the base is linear in x by construction, and the
     generated replacement code itself tests freeof(x, part(uu, 2))
     (rules/class2/2_1.mac r13, 2.3 r7).
   The MatchQ variant is the same test WITHOUT the implicit-exponent
   branches — the strict stored-power structure (%mr_powerQ, x-free
   rational exponent, linear base). It must not be identical to the
   value test: the 2.3 r35 condition
   %mr_powerOfLinearQ(v, x) and not(%mr_powerOfLinearMatchQ(v, x))
   is unsatisfiable (Q and not Q) if the two coincide, which would
   kill the rule; the strict reading fires exactly for the
   implicit-exponent v (bare linear / sqrt-linear), whose
   replacement re-dispatches into the F^(linear) rules.
   NormalizePowerOfLinear is the identity: the progress the recursion
   needs (u^m combining into a simpler power) comes from Maxima's own
   power combining — ((a+b x)^(p/q))^m -> (a+b x)^(p m/q) — which the
   specialized 2.1 r1-r16 patterns then re-match. A pathological
   no-progress self-refire is bounded by the runner depth cap (no
   wrong answers; bounded cost) — revisit if the class-2 run shows
   timeout mass in these shapes (ledger: milestone-2). */
%mr_powerOfLinearQ(u, x) := block([],
  if atom(u) then false
  else if %mr_linearQ(u, x) then true
  else if string(op(u)) = "sqrt" and %mr_linearQ(part(u, 1), x) then true
  else if %mr_powerQ(u) and freeof(x, part(u, 2))
       and %mr_linearQ(part(u, 1), x) and %mr_rationalQ(part(u, 2))
  then true
  else false)$

%mr_powerOfLinearMatchQ(u, x) := block([],
  if atom(u) then false
  else if %mr_powerQ(u) and freeof(x, part(u, 2))
       and %mr_linearQ(part(u, 1), x) and %mr_rationalQ(part(u, 2))
  then true
  else false)$

%mr_normalizePowerOfLinear(u, x) := u$

/* ---- class-2 cluster B: the NormalizeIntegrand chain ---------------
 * Pinned definitions (IntegrationUtilityFunctions.m @
 * 61e9c18ea248061cd83c67882f7c91a73cef912d): :1988 (NormalizeIntegrand),
 * :1999 (Aux), :2007 (Factor), :2025/:2030 (FactorBase),
 * :2060 (NormalizeLeadTermSigns), :2068-:2075 (AbsorbMinusSign),
 * :2093 (SignOfFactor), :2111-:2133 (MergeMonomials), :2168
 * (SimplifyTerm), :2178 (TogetherSimplify), :1399 (MinimumMonomial-
 * Exponent), :1406-:1410 (MonomialExponent), :3996-:4009 (UnifySum /
 * UnifyTerms / UnifyTerm), :2995 (ContentFactorAux), :162 (PowerQ),
 * :198 (IntegerPowerQ).
 * The only class-2 call site is 2.3 r60 (upstream number; generated
 * 2.3 r101, rules/class2/2_3.mac:2231): Int[u*F^v*G^w, x] ->
 * Int[u*NormalizeIntegrand[E^z, x], x] with z binomial or quadratic —
 * the FactorBase base reaching this chain is %e (atom) or a
 * linear/quadratic sum.
 * Documented deviations:
 *   (a) TogetherSimplify drops TimeConstrained/$TimeLimit (Maxima has
 *       no time-constrained evaluator) and FixSimplify (its GCD power
 *       combining is subsumed by Maxima's own power combining on
 *       re-simplification) — the ratsimp/together chain is the
 *       measured Maxima equivalent.
 *   (b) ContentFactorAux's product-branch negative-sum-factor sign
 *       extraction and the UnifyNegativeBaseFactors deep branch
 *       (:3016, negative-base factor unification) are unreachable on
 *       the r60 shape — the port keeps the atom/integer-power/
 *       product/sum surface (the sum branch factors out the GCD of the
 *       term contents) and returns its input in the deep case.
 *   (c) %mr_numericFactor is NOT redefined here: the M1 definition
 *       (this file's line 1547, Rubi :1100) already IS the .m's
 *       NumericFactor, with the .m's leafCount<50 ContentFactor-
 *       round-trip kludge replaced by the direct GCD-of-term-factors
 *       sum branch. The kludge cannot work in Maxima: MEASURED
 *       2026-08-28 (5.50.0/SBCL) 2*((4+6*x)/2) -> 6*x+4 — the factored
 *       sum does not survive the quotient round-trip, so the kludge
 *       would always return 1 for a sum, contradicting this cluster's
 *       own test %mr_numericFactor(4 + 6*X) = 2. M1's version
 *       additionally carries the sqrt-node and unary-minus branches
 *       Maxima's storage needs; redefining it would shadow the M1
 *       consumers (%mr_nonnumericFactors, the sumSimplerQ family).
 * SignOfFactor's ProductQ branch: the .m's Map[SignOfFactor, u] over a
 * product yields a product of {n, v} pairs whose Part extraction
 * (NormalizeLeadTermSigns takes lst[[1]]/lst[[2]]) only composes when
 * the pairs are multiplied out; the port returns the COMPOSED pair
 * [n_total, v_total], which satisfies the usage contract ("n*v equals
 * u") and matches the .m on every r60-reachable shape (all factors
 * {1, f}).
 * Storage adaptations, MEASURED 2026-08-28 (5.50.0/SBCL 2.6.7):
 *   * a power's op is the STRING "^" — every power head test goes
 *     through %mr_powerQ (Task 4, this file's line 4548);
 *   * list iteration is `for t in args(u)` — `for t : args(u)` parses
 *     as `for t from args(u)` and iterates the whole list as ONE
 *     element (the Task-4 everyQ note, this file's line 4594);
 *   * return() inside a for-loop does not escape the block (probe:
 *     block([r], r:0, for i thru 3 while r=0 do if i=2 then return(99),
 *     r) -> 0, not 99) — monomialExponent's first-match scan is a
 *     for-thru guarded by is(r = 0);
 *   * while is(m - k >= 0) ERRORS ("Unable to evaluate predicate m - k
 *     >= 0") on symbolic exponents, but if is(m - k >= 0) stays a no-op
 *     NOUN — minimumMonomialExponent's scan is therefore a for-thru
 *     with an `if is(n - e > 0) then n : e` guard (the .m's PosQ is
 *     strict and false on undecidable; the zero-difference case is a
 *     no-op update either way, so the strict and >= readings agree on
 *     every decidable input);
 *   * Maxima has no Prepend — cons(x, lst) puts x FIRST (measured:
 *     cons(9,[1,2]) = [9,1,2]); prepend is a NOUN in this build;
 *   * 2*((6*X+4)/2) -> 6*X+4 at evaluation — contentFactor's sum
 *     branch c*(u/c) evaluates back to the input sum, the identity
 *     there being the decline-safe behavior;
 *   * 2*(-a-b*X) STAYS a 2-factor product at evaluation (op "*",
 *     args [2, -a-b*X]) — absorbMinusSign's 2-factor structural
 *     branch is reachable (and -u distributes anyway, so the arms
 *     agree in value);
 *   * A+B*X is a binomial (binomialMatchQ TRUE at n = 1), while
 *     A+B*X+C*X^2 is NOT a trinomial — the .m's QuadraticQ is true on
 *     symbolic coefficients (Coefficient[u,x,0]===0 is FALSE for a
 *     symbol), so the .m's own TrinomialQ is false — and the
 *     quadratic base reaches the PolynomialQ/degree<=4 ->
 *     ExpandToSum branch, exactly as in the .m's FactorBase;
 *   * M1 %mr_monomialQ(4, X) is false (a constant is not a monomial —
 *     M1 test "monomialQ 5"), unlike the .m's MonomialQ (a_ = 4,
 *     n_ defaulting to 0); in the normalizeIntegrandFactor monomial-
 *     sum branches the difference is a no-op: a constant term makes
 *     the minimum exponent 0, where x^min*(t/x^min) is the identity;
 *   * the .m's active SimplifyTerm returns w in BOTH branches (the
 *     LeafCount choice is commented out upstream at :2160-:2167);
 *     ported as written, with %mr_simp (the value-preserving
 *     zero-chain, this file's line 498) standing in for Simplify.
 */

/* Rubi :198  IntegerPowerQ — Head === Power && IntegerQ[exponent].
   Maxima: a kept power node (%mr_powerQ — the op is the string "^")
   with an explicit integer exponent; Maxima strips exponent-1 powers
   and stores exponent-1/2 as a sqrt node (the Task-4 notes), neither
   of which is an IntegerPower in the .m either. */
%mr_integerPowerQ(u) := block([],
  if atom(u) then false
  else if %mr_powerQ(u) and integerp(part(u, 2)) then true
  else false)$

/* Rubi :2995  ContentFactorAux (ContentFactor :2992 minus its
   TimeConstrained wrapper — the identity on timeout is decline-safe
   and Maxima has no time-constrained evaluator). Deviation (b): the
   product branch drops the .m's negative-sum-factor sign extraction
   (num=-num; ContentFactorAux[-#]) and the UnifyNegativeBaseFactors
   deep branch (:3016) — both unreachable on the r60 shape; the
   identity there is decline-safe. The sum branch factors out the GCD
   of the terms' numeric factors directly (the .m's sum branch goes
   through CommonFactors; the GCD reading is the numeric-content
   subset the r60 shapes need — and the numericFactor call is on each
   TERM, so it cannot cycle). The c*(u/c) result: MEASURED 2026-08-28
   (5.50.0/SBCL) 2*((6*X+4)/2) -> 6*X+4 — Maxima auto-expands the
   factored sum over the quotient round-trip, so the branch returns
   the input sum (the identity, decline-safe). */
%mr_contentFactor(u) := block([c, t],
  if atom(u) then u
  else if %mr_integerPowerQ(u) then
    /* the .m's expn[[1,1]]: the base's first term, internal order (design 3.2) */
    if %mr_sumQ(part(u, 1)) and is(%mr_numericFactor(inpart(part(u, 1), 1)) < 0)
    then (-1)^part(u, 2)*%mr_contentFactor(-part(u, 1))^part(u, 2)
    else %mr_contentFactor(part(u, 1))^part(u, 2)
  else if not atom(u) and is(op(u) = "*") then
    apply("*", map(lambda([f], %mr_contentFactor(f)), args(u)))
  else if %mr_sumQ(u) then (
    c : 0,
    for t in args(u) do c : gcd(c, %mr_numericFactor(t)),
    if is(c # 1) and is(c # 0) then c*(u/c) else u
  )
  else u)$

/* Rubi :2093  SignOfFactor — the pair [n, v] with n*v = u and
   n^2 = 1. Storage adaptation, MEASURED 2026-08-28 (5.50.0/SBCL):
   the ProductQ branch returns the COMPOSED pair (the .m's
   Map[SignOfFactor, u] leaves a product of pairs — see the cluster
   header). First[u] of a sum is the first term in Maxima's internal order
   (design 3.2: the inflag order, args_in(-4-6*X) = [-4, -6*X]; the display
   order read before gave [-6*X, -4]); for the r60 shapes the lead-term
   sign is undecidable anyway (symbolic coefficients, numericFactor of a
   symbolic monomial is 1). */
%mr_signOfFactor(u) := block([],
  if (if %mr_rationalQ(u) then is(u < 0) else false)
     or (if %mr_sumQ(u) then is(%mr_numericFactor(inpart(u, 1)) < 0) else false)
  then [-1, -u]
  else if %mr_integerPowerQ(u) and %mr_sumQ(part(u, 1))
        and is(%mr_numericFactor(inpart(part(u, 1), 1)) < 0)
  then [(-1)^part(u, 2), (-part(u, 1))^part(u, 2)]
  else if not atom(u) and is(op(u) = "*") then
    block([ns, vs, p, f],
      ns : 1, vs : 1,
      for f in args(u) do (
        p : %mr_signOfFactor(f),
        ns : ns*part(p, 1),
        vs : vs*part(p, 2)),
      [ns, vs])
  else if not atom(u) and is(op(u) = "-") then
    /* a unary minus wraps the product: the .m reads -u as a product
       with a -1 factor (SignOfFactor[-1] = {-1, 1}); the minus-wrap
       is Maxima's storage of that — MEASURED 2026-08-28 (5.50.0/SBCL):
       op(-3*X) = "-", args(-3*X) = [3 X] (likewise -2*(a+b*X) — the
       bare sum case auto-distributes to a sum node and is caught by
       the first condition above). M1 precedent: the numericFactor
       "-" branch, this file's line 1573. */
    block([p],
      p : %mr_signOfFactor(part(u, 1)),
      [-part(p, 1), part(p, 2)])
  else [1, u])$

/* Rubi :2068-:2075  AbsorbMinusSign — an expression equal to -u with
   the minus pushed into a sum factor where possible. The .m's
   odd-power branch (u_*v_Plus^m /; OddQ[m]) is dropped: for the r60
   shapes the value -u is the normalized form. The 2-factor
   structural branch IS reachable — MEASURED 2026-08-28
   (5.50.0/SBCL): 2*(-a-b*X) stays a 2-factor product at evaluation
   (op "*", args [2, -a-b*X]); -u distributes anyway, so the arms
   agree in value. */
%mr_absorbMinusSign(u) := block([f1, f2],
  if not atom(u) and is(op(u) = "*") and is(length(args(u)) = 2) then (
    f1 : part(args(u), 1), f2 : part(args(u), 2),
    if %mr_sumQ(f1) then -f1*f2
    else if %mr_sumQ(f2) then -f2*f1
    else -u
  )
  else -u)$

/* Rubi :2060  NormalizeLeadTermSigns — the .m's
   With[{lst=If[ProductQ[u], Map[SignOfFactor,u], SignOfFactor[u]]},
   If[lst[[1]]==1, lst[[2]], AbsorbMinusSign[lst[[2]]]]]: in the port
   %mr_signOfFactor already returns the COMPOSED pair for products
   (the .m's Map leaves a product of pairs — see the cluster header),
   so the single signOfFactor call is the faithful structure for both
   .m branches. */
%mr_normalizeLeadTermSigns(u) := block([lst],
  lst : %mr_signOfFactor(u),
  if is(part(lst, 1) = 1) then part(lst, 2)
  else %mr_absorbMinusSign(part(lst, 2)))$

/* Rubi :1406-:1410  MonomialExponent — the exponent of x in the
   monomial u (the first x-power factor in the product scan).
   MEASURED 2026-08-28 (5.50.0/SBCL): return() inside a for-loop does
   not escape the block (probe: block([r], r:0, for i thru 3 while
   r=0 do if i=2 then return(99), r) -> 0, not 99), so the first-
   match scan is a for-thru guarded by is(r = 0) — the guard also
   stays a no-op NOUN if a symbolic exponent was captured (the .m's
   n_ may be x-free symbolic). The .m's x_^n_. matches BARE x (n
   defaulting to 1); Maxima strips exponent-1 powers, so a bare-x
   factor is an ATOM — the scan's powerQ test misses it (fix round 1,
   2026-08-28 review; measured before the fix on 5.50.0/SBCL:
   monomialExponent(5*X, X) = 0, monomialExponent(X, X) = 0, where
   the .m gives 1) — the atom(f) and is(f = x) scan arm and the
   is(u = x) whole-u arm are that default. M1 precedent: the
   monomialQ product scan counts bare x the same way (this file's
   line 661). */
%mr_monomialExponent(u, x) := block([f, r, i, n],
  if freeof(x, u) then 0
  else if not atom(u) and is(op(u) = "*") then (
    r : 0,
    n : length(args(u)),
    for i : 1 thru n do (
      f : part(args(u), i),
      if is(r = 0) then (
        if %mr_powerQ(f) and is(part(f, 1) = x) and freeof(x, part(f, 2))
        then r : part(f, 2)
        else if atom(f) and is(f = x) then r : 1)),
    r
  )
  else if %mr_powerQ(u) and is(part(u, 1) = x) and freeof(x, part(u, 2))
  then part(u, 2)
  else if is(u = x) then 1
  else 0)$

/* Rubi :1399  MinimumMonomialExponent — u is a sum whose terms are
   monomials; the smallest x-exponent. The .m's Scan/PosQ update
   (PosQ strict, false on undecidable) is a for-thru with an if-
   guard: MEASURED 2026-08-28 (5.50.0/SBCL) while is(m - k >= 0)
   ERRORS ("Unable to evaluate predicate m - k >= 0") on symbolic
   exponents, but if is(m - k >= 0) stays a no-op NOUN — the guard
   form is safe in both cases and implements the strict reading (the
   zero-difference case is a no-op update either way, so the .m's
   PosQ and a >= 0 reading agree on every decidable input). */
%mr_minimumMonomialExponent(u, x) := block([n, t, e],
  n : %mr_monomialExponent(part(u, 1), x),
  for t in args(u) do (
    e : %mr_monomialExponent(t, x),
    if is(n - e > 0) then n : e),
  n)$

/* Rubi :2111-:2133  MergeMonomials. Rules 1-2 (the proportional-
   linear-power merge, :2111; the (c*(a+b x)^n)^p merge, :2120) are
   unreachable on the r60 shape (the factors are %e, %e^(linear),
   %e^(quadratic) — no linear powers); deferred with the identity
   (decline-safe). Rule 3 (a_*u_^m_ -> a*u^Simplify[m], :2129) is a
   Maxima no-op: a*u^m is already the simplified form for x-free m.
   Rule 4 (linear -> Cancel, :2133) is ported. */
%mr_mergeMonomials(u, x) := block([],
  if atom(u) then u
  else if %mr_linearQ(u, x) then %mr_cancel(u)
  else u)$

/* Rubi :2178  TogetherSimplify — the .m's
   TimeConstrained[With[{v=Together[Simplify[Together[u]]]},
   TimeConstrained[FixSimplify[v],$TimeLimit/3,v]],$TimeLimit,u]:
   deviation (a) — Maxima has no time-constrained evaluator and
   FixSimplify's GCD power combining is subsumed by Maxima's own
   power combining on re-simplification; the ratsimp/together chain
   is the measured Maxima equivalent (value-preserving). */
%mr_togetherSimplify(u) := ratsimp(%mr_together(ratsimp(%mr_together(u))))$

/* The .m's MatchQ[v, x^m_.*w_ /; FreeQ[m, x] && SumQ[w]] (the
   :2046 FactorBase sum-branch condition) — a 2-factor product with
   one x-power factor (exponent x-free) and one sum factor, either
   order. In the .m pattern the w_ slot absorbs the remaining
   product, so extra factors make w a product, not a sum — the
   2-factor test is the faithful reading. */
%mr_xpwsumP(v, x) := block([f1, f2],
  if atom(v) or not is(op(v) = "*") or is(length(args(v)) # 2) then false
  else (
    f1 : part(args(v), 1), f2 : part(args(v), 2),
    if %mr_powerQ(f1) and is(part(f1, 1) = x) and freeof(x, part(f1, 2))
       and %mr_sumQ(f2) then true
    else if %mr_powerQ(f2) and is(part(f2, 1) = x) and freeof(x, part(f2, 2))
         and %mr_sumQ(f1) then true
    else false))$

/* ---- the cleanup cascade's Simplify: %mr_simp WITHOUT factor -------
 * STATED DEVIATION (2026-09-16), forced by a MEASURED defect.
 * %mr_simp's third stage is Maxima's multivariate factor(), and the
 * ExpandExpression cleanup cascade (SimplifyTerm on every term,
 * UnifyTerm on every pair) reaches it with the dense coefficient
 * polynomials a wide product of binomial powers expands into.
 * MEASURED (this build, one process per call, the marker flushed BEFORE
 * the call): for x^2 (a+b x)^3 (c+d x)^4 (e+f x)^5 (g+h x)^6 log(x),
 * factor() of the x^6 coefficient (9 kernels, 521 leaves, nterms 34)
 * exhausts SBCL's 1 GiB dynamic space -- "Heap exhausted, game over".
 * That is a FATAL runtime error: errcatch never runs and the entry's
 * subprocess DIES (1.2.3.2 e637/e660, both verified pre-port, died on
 * it; %mr_unifySum over the same expansion dies from k = 10 terms, the
 * ladder being 0.002 s at k=3, 0.045 at k=5, 0.402 at k=8).
 * The stage is DROPPED, not guarded, because no cheap metric predicts
 * the blow-up: measured on this build, nterms 34 / 8 kernels is fatal
 * while nterms 231 / 8 variables factors in 6 ms and nterms 1451 / 10
 * variables in 26 ms -- the cliff is the polynomial's reducibility
 * (the survivors come back as 2-4 factors), which is exactly what
 * factor() has to run to find out.
 * Value is preserved: the dropped stage is a SHAPE operation, ratsimp
 * having already done every cancellation. The cascade's terms therefore
 * come back expanded rather than factored -- which is the form
 * ExpandIntegrand exists to produce. MEASURED: the integrand above
 * expands to its 19 terms in 7.8 s with ratsimp(radcan(sum - u)) = 0.
 * The .m's own Simplify is bounded the same way in spirit (Mathematica
 * Simplify carries a TimeConstraint); Maxima has no catchable bound,
 * and a heap death cannot be caught at all. */
%mr_simpCleanup(e, x) := block([a],
  a : ratsimp(e),
  ratsimp(expand(a)))$

/* Rubi :4009  UnifyTerm — the .m's Prepend[lst, x] puts x FIRST;
   Maxima has no Prepend (it is a NOUN in this build) — MEASURED
   2026-08-28 (5.50.0/SBCL): cons(x, lst) is the equivalent
   (cons(9,[1,2]) = [9,1,2]). */
%mr_unifyTerm(term, lst, x) := block([tmp],
  if length(lst) = 0 then [term]
  else (
    tmp : %mr_simpCleanup(part(lst, 1)/term, x),
    if freeof(x, tmp) then cons((1 + tmp)*term, rest(lst))
    else cons(part(lst, 1), %mr_unifyTerm(term, rest(lst), x))))$

/* Rubi :4003  UnifyTerms */
%mr_unifyTerms(lst, x) := block([],
  if length(lst) = 0 then lst
  else %mr_unifyTerm(part(lst, 1), %mr_unifyTerms(rest(lst), x), x))$

/* Rubi :3996  UnifySum */
%mr_unifySum(u, x) := block([],
  /* Apply[List, u]: the term list in Maxima's internal order (design 3.2) */
  if %mr_sumQ(u) then apply("+", %mr_unifyTerms(%mr_args_in(u), x))
  else %mr_simplifyTerm(u, x))$

/* Rubi :2168  SimplifyTerm — the .m's ACTIVE definition returns w in
   BOTH branches (the LeafCount[v]<LeafCount[w] choice is commented
   out upstream at :2160-:2167); ported as written. Maxima has no
   Simplify — %mr_simp (the value-preserving zero-chain, this file's
   line 498) stands in. */
%mr_simplifyTerm(u, x) := block([v, w],
  v : %mr_simpCleanup(u, x),
  w : %mr_together(v),
  %mr_normalizeIntegrand(w, x))$

/* Rubi :2030  NormalizeIntegrandFactorBase (the :2025 x^m_*u_
   pre-distribution rule is unreachable on the r60 shape — deferred
   with the fall-through, decline-safe). Branch order is the .m's:
   binomial, trinomial, product, polynomial of degree <= 4, sum,
   (last) Map over parts. MEASURED 2026-08-28 (5.50.0/SBCL): A+B*X
   is a binomial (binomialMatchQ TRUE at n = 1) so the linear base
   returns as-is; A+B*X+C*X^2 is NOT a trinomial (the .m's
   QuadraticQ is true on symbolic coefficients — Coefficient[u,x,0]
   === 0 is FALSE for a symbol — so the .m's own TrinomialQ is
   false), and the quadratic base reaches the polynomial/degree<=4 ->
   ExpandToSum branch, exactly as in the .m. The last branch is the
   .m's Map-over-parts (:2048) — Map KEEPS THE HEAD, so the port
   reconstructs with apply(op(u), …) (Maxima's op/args decomposition
   round-trips any non-list expression: "^", "sqrt", "-", function
   heads). Fix round 1 (2026-08-28 review): the branch previously
   read apply("+", …), destroying the head (measured on this build
   5.50.0/SBCL: sqrt(a+b*x) -> a+b*x, -(x^2+3*x)^3 -> the expanded
   -x^6-9*x^5-27*x^4-27*x^3). Reachable domain (sums never reach it —
   the sumQ branch above catches them; products and degree<=4
   polynomials are caught earlier): powers with x in the base whose
   degree exceeds 4 or whose base is not a (match) binomial/trinomial
   ((x+1)^5 — x^5 is a binomial, a = 0), sqrt nodes, minus-wrapped
   powers, other function heads. Quotients are stored as products of
   an inverse-power factor, which the product branch above handles. */
%mr_normalizeIntegrandFactorBase(u, x) := block([v],
  if atom(u) then u
  else if %mr_binomialQ(u, x) then
    if %mr_binomialMatchQ(u, x) then u else %mr_expandToSum(u, x)
  else if %mr_trinomialQ(u, x) then
    if %mr_trinomialMatchQ(u, x) then u else %mr_expandToSum(u, x)
  else if not atom(u) and is(op(u) = "*") then
    apply("*", map(lambda([f], %mr_normalizeIntegrandFactor(f, x)), args(u)))
  else if %mr_polynomialQ(u, x) and is(%mr_degree(u, x) <= 4) then
    %mr_expandToSum(u, x)
  else if %mr_sumQ(u) then (
    v : %mr_togetherSimplify(u),
    if %mr_sumQ(v) or %mr_xpwsumP(v, x)
       or is(%mr_leafCount(v) > %mr_leafCount(u) + 2)
    then %mr_unifySum(u, x)
    else %mr_normalizeIntegrandFactorBase(v, x)
  )
  else apply(op(u), map(lambda([f], %mr_normalizeIntegrandFactor(f, x)), args(u))))$

/* Rubi :2007  NormalizeIntegrandFactor. The .m's last branch maps
   #/x^min without Simplify while the integer-power branch maps
   Simplify[#/x^min] — the port uses %mr_simp in both (value-
   preserving zero-chain; the non-power case differs only by the
   simplification). The monomial-sum gate uses M1 %mr_monomialQ,
   false on constant terms (M1 test "monomialQ 5"), unlike the .m's
   MonomialQ (a_ = constant, n_ defaulting to 0); the skip is a
   no-op — a constant term makes the minimum exponent 0, where
   x^min*(t/x^min) is the identity. */
%mr_normalizeIntegrandFactor(u, x) := block([bas, deg, min],
  if atom(u) then u
  else if %mr_powerQ(u) and freeof(x, part(u, 2)) then (
    bas : %mr_normalizeIntegrandFactorBase(part(u, 1), x),
    deg : part(u, 2),
    if integerp(deg) and %mr_sumQ(bas)
       and %mr_everyQ(lambda([t], %mr_monomialQ(t, x)), args(bas))
    then (
      min : %mr_minimumMonomialExponent(bas, x),
      x^(min*deg)*apply("+",
        map(lambda([t], %mr_simp(t/x^min, [x])), args(bas)))^deg
    )
    else bas^deg
  )
  else if %mr_powerQ(u) and freeof(x, part(u, 1)) then
    part(u, 1)^%mr_normalizeIntegrandFactorBase(part(u, 2), x)
  else (
    bas : %mr_normalizeIntegrandFactorBase(u, x),
    if %mr_sumQ(bas)
       and %mr_everyQ(lambda([t], %mr_monomialQ(t, x)), args(bas))
    then (
      min : %mr_minimumMonomialExponent(bas, x),
      x^min*apply("+", map(lambda([t], %mr_simp(t/x^min, [x])), args(bas)))
    )
    else bas))$

/* Rubi :1999  NormalizeIntegrandAux */
%mr_normalizeIntegrandAux(u, x) := block([mm],
  if %mr_sumQ(u) then
    apply("+", map(lambda([t], %mr_normalizeIntegrandAux(t, x)), args(u)))
  else (
    mm : %mr_mergeMonomials(u, x),
    if not atom(mm) and is(op(mm) = "*") then
      apply("*", map(lambda([f], %mr_normalizeIntegrandFactor(f, x)), args(mm)))
    else %mr_normalizeIntegrandFactor(mm, x)))$

/* Rubi :1988  NormalizeIntegrand. The .m's v===NormalizeLeadTermSigns[u]
   test is syntactic identity; Maxima's structural = is the available
   (weaker) comparison — the chain is value-preserving on the r60
   shapes, so the weaker comparison only risks returning v instead of
   u on an equal-but-different rewrite, which a next call
   re-normalizes to the same form. */
%mr_normalizeIntegrand(u, x) := block([v],
  v : %mr_normalizeLeadTermSigns(%mr_normalizeIntegrandAux(u, x)),
  if is(v = %mr_normalizeLeadTermSigns(u)) then u else v)$

/* ---- class-2 cluster C: the FunctionOfExponential family ----------
 * Pinned definitions (IntegrationUtilityFunctions.m @
 * 61e9c18ea248061cd83c67882f7c91a73cef912d): :4264 (Q), :4270
 * (FunctionOfExponential), :4277 (FunctionOfExponentialFunction),
 * :4284 (FunctionOfExponentialFunctionAux), :4307 (Test), :4322
 * (TestAux). The .m threads three FLUID variables ($base$, $expon$,
 * $exponFlag$) set inside Block; Maxima has no dynamic variables, so the
 * state is threaded explicitly as [flag, F, v] (flag = $exponFlag$,
 * F = $base$, v = $expon$) — the same information, no globals, safe
 * under the runner's re-entrant rule evaluation.
 *
 * Name collision (MEASURED 2026-08-28, 5.50.0/SBCL): the internal
 * exponent variable is named exn, NOT expon — `expon` is a Maxima OPTION
 * variable (the auto-expand cutoff for negative powers, default 0), so
 * `expon : <non-integer>` hard-errors "assignment: 'expon must be a
 * non-negative integer". describe("expon", exact) confirms it.
 *
 * FreeQ short-circuit (.m Test :4308-4309): an x-free u passes the test
 * with the state UNCHANGED (the .m returns True without touching
 * $exponFlag$). Consequences, verified against the .m at the pinned
 * commit (2026-08-28):
 *   * Q :4266 is `Test[u,x] && $exponFlag$`; the FreeQ arm never sets
 *     the flag, so Q(x-free u) = FALSE. The brief's `= true` test
 *     expectation is wrong per the .m — the test is corrected to
 *     `= false` (task-6 report).
 *   * FunctionOfExponential :4273 returns $base$^$expon$ (= Null^Null,
 *     garbage) for x-free u, and FunctionOfExponentialFunction
 *     :4279-4280 is likewise garbage. Both are Q-gated in the .m (Q
 *     false for x-free), so the port returns u (clean decline) for an
 *     x-free u before consulting the state.
 *
 * Factored exponent (MEASURED 2026-08-28, 5.50.0/SBCL): Maxima keeps
 * F^(C*(A+B*X))'s exponent as the PRODUCT node C*(A+B*X) (op "*"), not
 * an expanded sum. M1's %mr_linearQ ACCEPTS the factored linear form
 * (is(%mr_linearQ(C*(A+B*X), X) = true) true; %mr_coeff(C*(A+B*X), X, 1)
 * = B*C) — it expands internally via together/coeff/degree — so no
 * expansion adaptation is needed; the ORIGINAL (factored) expon is what
 * the state stores and what %mr_functionOfExponential returns (the
 * brief's "first call keeps full expon").
 *
 * Exponent sum-split (.m Test :4317-4318, Aux :4301-4302): F^(v1+v2)
 * splits into F^First * F^Rest. Maxima sum storage is degree-descending
 * (args(a+b*X) = [b*X, a]; part(a+b*X, 1) = b*X; rest(a+b*X) = a;
 * MEASURED 2026-08-28 (5.50.0/SBCL)), so part(sum, 1) is the
 * highest-degree term and
 * rest(sum) the remainder — a disjoint partition mirroring the .m's
 * First/Rest in stored order. The %mr_linearQ branch fires BEFORE the
 * sum-split branch, so only NON-linear sum exponents reach the split,
 * and those are refused downstream (F^(A+B*X^2): the X^2 factor defeats
 * %mr_linearQ), so the stored-v difference between split orders is
 * unobservable in the pilot.
 *
 * TestAux fidelity (verified against the .m :4322-4350, 2026-08-28):
 *   * Branch A (:4331-4340) sets $expon$ from the STORED $expon$'s
 *     x-coefficient (:4336 Coefficient[$expon$,x,1]) and the sign flip
 *     (:4337) reads the same — the port uses %mr_coeff(v, x, 1) (v = the
 *     stored expon), correcting the brief (which used the NEW expon's
 *     coefficient). The stored coefficient is what keeps the integrand an
 *     integer power of the returned F^v. The flip's NegQ is the house
 *     %mr_negQ port (Rubi :642) over the PosAux port (matcher translation
 *     fixes design 3.2).
 *   * Commensurable bases (fix round 1): the .m's :4328/:4331
 *     Log[base]/Log[$base$] factor reduces under FullSimplify to a
 *     rational for commensurable bases (Log[4]/Log[2] -> 2); ratsimp
 *     does NOT (see the FullSimplify note), so %mr_logRatio(base, F)
 *     supplies the exact rational r with base = F^r — 1 for base = F,
 *     false otherwise — for positive-integer bases whose prime
 *     supports match with proportional exponent vectors (factor
 *     prime-power decomposition, cross-multiplied in exact integers:
 *     e_b_i * e_F_1 = e_F_i * e_b_1). ifactor is UNBOUND in this build
 *     (describe: no exact match; MEASURED 2026-08-28 (5.50.0/SBCL)) —
 *     factor(n) is the decomposition (a prime with exponent 1 stays a
 *     bare atom; the factors come out in canonical order). Scope:
 *     positive integers only — positive rationals and other
 *     commensurable shapes remain declined at the RationalQ gate (flag
 *     for layer B / future classes; the class-2 corpus is
 *     integer-base in this pattern).
 *   * The .m's IGtQ base-swap (:4332-4335 / :4341-4344 — adopt the
 *     smaller of two positive-integer bases, then tmp = 1/tmp) is
 *     DROPPED per the brief. Pre fix round 1, commensurable numeric
 *     bases never reached the swap decision: the RationalQ gate
 *     declined them outright (the ratsimp gap above). Now
 *     %mr_logRatio supplies the ratio, so commensurable numeric bases
 *     DO reach the reconciliation; without the swap the port keeps the
 *     FIRST-SEEN base — 2^X*4^X -> 2^X here: args(2^X*4^X) =
 *     [2^X, 4^X] (MEASURED 2026-08-28 (5.50.0/SBCL)) so 2 is
 *     first-seen, and the .m's construction
 *     Coefficient[$expon$,x,1]*x/Denominator[tmp] with tmp = 2 keeps
 *     the stored expon (Denominator[2] = 1) — the same answer the .m
 *     gives for this factor order (its swap fires only on a LATER
 *     smaller base); where a larger base is stored first the .m would
 *     re-base onto the smaller one — a form-only difference, flagged
 *     for layer B (task-6 report).
 *
 * If/or safety (MEASURED 2026-08-28, 5.50.0/SBCL): an if whose condition
 * is `unknown` STAYS A NOUN in this build (it does not take the else
 * arm), so every if/or condition below is a structurally-decidable
 * boolean. is(u = x) is true/false only for structurally distinct forms
 * (is(x^2 = x) = is(a*x = x) = is(x+1 = x) = false; is(x = x) = true);
 * is(part(st, 2) = false) is likewise decidable; is(tmp < 0) sits under
 * the %mr_rationalQ(tmp) gate, so tmp is an explicit rational when it is
 * reached (decidable); the flag is always the literal true/false;
 * is(k # false) is decidable because k is the atom false or an explicit
 * rational (an atom), MEASURED 2026-08-28 (5.50.0/SBCL); the
 * %mr_logRatio guards (is(base = F), is(base > 0), ...) are evaluated
 * only after integerp(base) and integerp(F) short-circuit the and-chain,
 * so they see explicit integers.
 *
 * FunctionExpand: the .m calls it only on Gamma[p, z] with p a positive
 * integer; Maxima does not auto-expand gamma_incomplete(n, z) — for a
 * symbolic z the noun survives (op stays gamma_incomplete; expand and
 * diff leave it, MEASURED 2026-08-28 (5.50.0/SBCL)) — so the port
 * expands Gamma[n, z] = gamma(n) %e^-z sum_{k=0}^{n-1} z^k/k! via the
 * concretizing mr_sum (this file's line 53) and returns other shapes
 * unchanged (decline-safe).
 * FullSimplify: ratsimp — on the Aux shapes (quotients of
 * coefficients) ratsimp preserves the quotient and cancels common
 * factors; the unit test pins the denom behavior. ratsimp does NOT
 * reduce log identities (ratsimp(log(4)/log(2)) stays log(4)/log(2),
 * MEASURED 2026-08-28 (5.50.0/SBCL)) — that gap is what %mr_logRatio
 * covers for commensurable positive-integer bases (see above). */

%mr_fullSimplify(u) := ratsimp(u)$

/* One prime-power factor of factor output as [prime, exponent]. factor
   stores the same prime-power inconsistently (MEASURED 2026-08-28
   (5.50.0/SBCL): factor(4) is the power node 2^2, while the 2^2 factor
   of factor(12) is the ATOM 4, and factor(400)'s factors are the atoms
   16 and 25) — an atom factor is re-factored to recover the prime and
   exponent. A factor of factor(n) is always a single prime power, so
   the re-factoring yields an atom (a prime) or one power node. */
%mr_logFactorExp(p) := block([g],
  if %mr_powerQ(p) then [part(p, 1), part(p, 2)]
  else (
    g : factor(p),
    if atom(g) then [g, 1]
    else [part(g, 1), part(g, 2)]))$

/* The factor prime-power decomposition of an explicit integer n > 1 as
   [[prime, exponent], ...] (factor; ifactor is unbound in this build).
   The factors come out in canonical (ascending-prime) order, so
   position-wise comparison of two decompositions is sound. */
%mr_logFactorPairs(n) := block([g],
  g : factor(n),
  if atom(g) then [[g, 1]]
  else if %mr_powerQ(g) then [[part(g, 1), part(g, 2)]]
  else map(%mr_logFactorExp, args(g)))$

/* The exact rational r with base = F^r, for commensurable positive-
   integer bases; false otherwise (the .m's Log[base]/Log[$base$]
   factor at :4328/:4331, which FullSimplify reduces but ratsimp does
   not). base = F -> 1 before any factorization. The exponent vectors
   must be proportional: with r = e_b_1/e_F_1, cross-multiply in exact
   integers (e_b_i * e_F_1 = e_F_i * e_b_1 for every i). */
%mr_logRatio(base, F) := block([pb, pf, i, ok, r],
  if is(base = F) then 1
  else if not (integerp(base) and integerp(F)
              and is(base > 0) and is(F > 0)
              and not is(base = 1) and not is(F = 1)) then false
  else (
    pb : %mr_logFactorPairs(base),
    pf : %mr_logFactorPairs(F),
    if length(pb) # length(pf) then false
    else (
      ok : true,
      for i : 1 thru length(pb) do
        if not is(part(part(pb, i), 1) = part(part(pf, i), 1))
        then ok : false,
      if not ok then false
      else (
        r : part(part(pb, 1), 2)/part(part(pf, 1), 2),
        ok : true,
        for i : 1 thru length(pb) do
          if not is(part(part(pb, i), 2)*part(part(pf, 1), 2)
                    = part(part(pf, i), 2)*part(part(pb, 1), 2))
          then ok : false,
        if ok then r else false))))$

%mr_foE_test(u, x) := block([], %mr_foE_test2(u, x, [false, false, false]))$

%mr_foE_test2(u, x, st) := block([base, exn, r],
  if freeof(x, u) then st
  else if is(u = x) or %mr_calculusQ(u) then false
  else if %mr_powerQ(u) and freeof(x, part(u, 1))
        and %mr_linearQ(part(u, 2), x) then (
    base : part(u, 1), exn : part(u, 2),
    /* :4313 — $exponFlag$ = True: an explicit F^v power occurred. */
    r : %mr_foE_testAux(base, exn, x, [true, part(st, 2), part(st, 3)]),
    if atom(r) then false else r
  )
  /* not atom(u): part(u, 1) below errors on an atom ("part: argument
     must be a non-atomic expression", measured 2026-09-20), and Maxima's
     `and` evaluates its right side once the left is true. Until
     2026-09-20 %mr_hyperbolicQ answered false for EVERY atom, which
     shielded this site by accident; the atom branch is now faithful to
     the .m, so the assumption this site always had is stated. */
  else if not atom(u) and %mr_hyperbolicQ(u)
        and %mr_linearQ(part(u, 1), x) then (
    /* :4315-4316 — hyperbolic of a linear form: base %e, flag
       UNCHANGED (no explicit power). */
    r : %mr_foE_testAux(%e, part(u, 1), x, st),
    if atom(r) then false else r
  )
  else if %mr_powerQ(u) and freeof(x, part(u, 1))
        and %mr_sumQ(part(u, 2)) then (
    /* :4317-4318 — F^(v1 + v2 + …) = F^v1 F^v2 …: test the split
       factors, thread the state. */
    r : %mr_foE_test2(part(u, 1)^part(part(u, 2), 1), x, st),
    if atom(r) then false
    else %mr_foE_test2(part(u, 1)^rest(part(u, 2)), x, r)
  )
  else (
    /* :4319 — Catch[Scan[If[Not[Test[#,x]],Throw[False]],u]; True:
       every subpart must test, state threaded through. `for p in` is the
       list idiom (`for p : lst` parses as `from`, MEASURED
       2026-08-28 (5.50.0/SBCL)). */
    block([st2, p],
      st2 : st,
      for p in args(u) while not atom(st2) do
        st2 : %mr_foE_test2(p, x, st2),
      st2)))$

%mr_foE_testAux(base, exn, x, st) := block([F, v, tmp, e, k],
  if is(part(st, 2) = false) then
    /* :4323-4326 — $base$ === Null: first base seen; take it, keep the
       full expon. */
    [part(st, 1), base, exn]
  else (
    F : part(st, 2), v : part(st, 3),
    /* :4328 — the Log[base]/Log[$base$] factor: the exact rational
       log-ratio for commensurable positive-integer bases, else the
       symbolic ratsimp quotient (which stays a log-quotient for
       distinct numeric bases — the RationalQ gate below declines it).
       is(k # false) is decidable: k is the atom false or an explicit
       rational (an atom), MEASURED 2026-08-28 (5.50.0/SBCL). */
    k : %mr_logRatio(base, F),
    if is(k # false) then
      tmp : k*%mr_coeff(exn, x, 1)/%mr_coeff(v, x, 1)
    else
      tmp : %mr_fullSimplify(log(base)*%mr_coeff(exn, x, 1)
                             /(log(F)*%mr_coeff(v, x, 1))),
    if not %mr_rationalQ(tmp) then false
    else if %mr_eqQ(%mr_coeff(v, x, 0), 0)
           /* :4331 — the constant-term ratio carries the same log
              factor, so the same exact-rational treatment. Its second
              operand divides by %mr_coeff(v, x, 0) — `or`
              short-circuits in this build (MEASURED 2026-08-28
              (5.50.0/SBCL)), so it is evaluated only when that
              coefficient is nonzero. */
           or %mr_neQ(tmp, if is(k # false) then
                          k*%mr_coeff(exn, x, 0)/%mr_coeff(v, x, 0)
                        else
                          %mr_fullSimplify(log(base)*%mr_coeff(exn, x, 0)
                                           /(log(F)*%mr_coeff(v, x, 0))))
    then (
      /* :4331-4340 — the constant-term ratio is inconsistent (or the
         stored expon has no constant term): the common expon is through
         the origin. :4336 reads the STORED expon's x-coefficient. */
      e : %mr_coeff(v, x, 1)*x/denom(tmp),
      /* :4337-4340 — sign flip: tmp < 0 and the stored coefficient < 0
         -> -v. */
      if is(tmp < 0) and %mr_negQ(%mr_coeff(v, x, 1))
      then [part(st, 1), F, -e]
      else [part(st, 1), F, e]
    )
    else (
      /* :4346-4349 — consistent: fold both expons to v/denom(tmp),
         then the :4347-4349 sign flip (tmp < 0 and the stored
         coefficient < 0 -> -v) — the SAME stored-value test as branch
         A (Maxima rational denominators are positive, so the folded
         value carries the stored coefficient's sign). The :4341-4344
         swap is dropped (see header). */
      if is(tmp < 0) and %mr_negQ(%mr_coeff(v, x, 1))
      then [part(st, 1), F, -(v/denom(tmp))]
      else [part(st, 1), F, v/denom(tmp)])))$

%mr_functionOfExponentialQ(u, x) := block([st],
  st : %mr_foE_test(u, x),
  is(not atom(st) and part(st, 1) = true))$

%mr_functionOfExponential(u, x) := block([st],
  if freeof(x, u) then u
  else (
    st : %mr_foE_test(u, x),
    if atom(st) then u
    else part(st, 2)^part(st, 3)))$

%mr_functionOfExponentialFunction(u, x) := block([st],
  if freeof(x, u) then u
  else (
    st : %mr_foE_test(u, x),
    if atom(st) then u
    else %mr_simp(%mr_foEFunctionAux(u, x, st), [x])))$

%mr_foEFunctionAux(u, x, st) := block([F, v, tmp],
  F : part(st, 2), v : part(st, 3),
  if atom(u) then u
  else if %mr_powerQ(u) and freeof(x, part(u, 1))
        and %mr_linearQ(part(u, 2), x) then (
    /* :4287-4290 — u = F0^(m x + c0) -> (F0/F)^… X^ratio: the .m's two
       branches on EqQ[Coefficient[$expon$, x, 0], 0]. */
    if %mr_eqQ(%mr_coeff(v, x, 0), 0) then
      part(u, 1)^%mr_coeff(part(u, 2), x, 0)
      *x^%mr_fullSimplify(log(part(u, 1))*%mr_coeff(part(u, 2), x, 1)
                          /(log(F)*%mr_coeff(v, x, 1)))
    else
      x^%mr_fullSimplify(log(part(u, 1))*%mr_coeff(part(u, 2), x, 1)
                         /(log(F)*%mr_coeff(v, x, 1)))
  )
  /* not atom(u): part(u, 1) below errors on an atom ("part: argument
     must be a non-atomic expression", measured 2026-09-20), and Maxima's
     `and` evaluates its right side once the left is true. Until
     2026-09-20 %mr_hyperbolicQ answered false for EVERY atom, which
     shielded this site by accident; the atom branch is now faithful to
     the .m, so the assumption this site always had is stated. */
  else if not atom(u) and %mr_hyperbolicQ(u)
        and %mr_linearQ(part(u, 1), x) then (
    /* :4291-4300 — the .m's Switch on Head[u]: sinh/cosh/tanh/coth/sech/
       csch of the tmp = X^(coeff ratio) form. */
    tmp : x^%mr_fullSimplify(%mr_coeff(part(u, 1), x, 1)
                             /(log(F)*%mr_coeff(v, x, 1))),
    if is(op(u) = sinh) then tmp/2 - 1/(2*tmp)
    else if is(op(u) = cosh) then tmp/2 + 1/(2*tmp)
    else if is(op(u) = tanh) then (tmp - 1/tmp)/(tmp + 1/tmp)
    else if is(op(u) = coth) then (tmp + 1/tmp)/(tmp - 1/tmp)
    else if is(op(u) = sech) then 2/(tmp + 1/tmp)
    else if is(op(u) = csch) then 2/(tmp - 1/tmp)
    else u
  )
  else if %mr_powerQ(u) and freeof(x, part(u, 1))
        and %mr_sumQ(part(u, 2)) then (
    /* :4301-4302 — F^(v1+v2) -> the product of the rewrites. */
    %mr_foEFunctionAux(part(u, 1)^part(part(u, 2), 1), x, st)
    *%mr_foEFunctionAux(part(u, 1)^rest(part(u, 2)), x, st)
  )
  else (
    /* :4303 — Map[Function[FunctionOfExponentialFunctionAux[#,x]],u]
       preserves the head over ANY non-atomic head; op/args
       round-trips it (M1 precedent maxima_rubi_utils.mac:3811, the
       Task-5 FactorBase fix). The r104 call site is conditioned on
       FunctionOfExponentialQ[u,x] alone, so a Q-true input with any
       head must be rewritten — the old * / +-only arms returned u
       unchanged for other heads, a silent wrong rewrite (sin(F^(b x))
       must become sin(x)). Comma-form lambda (the colon form is a
       parse error) and no slash-star opener sequence inside a comment
       (Maxima nests comments), MEASURED 2026-08-28 (5.50.0/SBCL). */
    apply(op(u), map(lambda([p], %mr_foEFunctionAux(p, x, st)), args(u)))))$

%mr_functionExpand(u) := block([n, z],
  if not atom(u) and is(op(u) = gamma_incomplete)
     and length(args(u)) = 2 then (
    n : part(args(u), 1), z : part(args(u), 2),
    if integerp(n) and is(n > 0) then
      /* Gamma[n, z] = gamma(n) %e^-z sum_{k=0}^{n-1} z^k/k! — mr_sum
         concretizes the numeric bounds (this file's line 53). */
      gamma(n)*exp(-z)*mr_sum(z^k/factorial(k), 'k, 0, n - 1)
    else u
  )
  else u)$

  /* ---- class-3 cluster A: the small cond-side predicates (Task 4) --- */

/* MemberQ (Mathematica builtin) — MemberQ[list, elem]. The built-in is
   ORDER-REVERSED and boolean-valued: describe("member", exact) reads
   "Returns 'true' if is(expr_1 = a) for some element a in
   args(expr_2), otherwise 'false'". MEASURED 2026-08-29 on
   branch_5_50_base_84_g4204fb669 / SBCL 2.6.7: member(b, [a, b, c])
   = true, member(4, [1, 2, 3]) = false, the result IS the boolean
   (is(member(b, [a, b, c]) = true) = true — the line-758 note), and
   member does not inspect parts of elements (member(x, [x + 1]) =
   false). The = test is the MA MatchQ reading for atom elements
   (member('asin, ['asin, 'acos]) = true). */
%mr_memberQ(l, e) := block([], is(member(e, l) = true))$

/* FalseQ (Mathematica builtin) — true iff the value is the boolean
   false (the declined-predicate return at the 3.5 r1/r2/r13 call
   sites, where the value is a direct function return, not a
   part()-reified factor). MEASURED 2026-08-29 (branch_5_50_base_84_g4204fb669
   / SBCL 2.6.7): false is the boolean ATOM (atom(false) = true;
   booleanp(false) stays an unevaluated noun — do not use it),
   is(false = false) = true, is(0 = false) = false, and
   is('false = false) = true — the QUOTED SYMBOL compares =-equal to
   the boolean in this build, a corner the .m's IdentityQ reading
   could not express (harmless: no rule capture produces a quoted
   'false as a value). */
%mr_falseQ(u) := block([], is(u = false))$

/* Rubi :170-172  ProductQ — ProductQ[_Times] = True; ProductQ[_] =
   False. MEASURED 2026-08-29 (branch_5_50_base_84_g4204fb669 /
   SBCL 2.6.7): a times node's op is the string "*" (is(op(a*b) =
   "*") = true), an unparenthesized TWO-factor product IS a times
   node (op(a*b) = "*", length(a*b) = 2), a monomial is a "^" node,
   a quotient is a "/" node, a sum is a "+" node. STORAGE DIVERGENCE
   (recorded, task-4 report): the product sign lifts to a top-level
   unary "-" node (op(-a*b) = "-", args(-a*b) = [a*b]) where MA sees
   the Times head of Times[-1, a, b] — the port declines the lift
   (decline direction, the Task-3 matcher strictness precedent); the
   class-3 call sites (3.5 r32/r38, the log argument) lose only the
   negative-product corner. */
%mr_productQ(u) := block([],
  if atom(u) then false
  else is(op(u) = "*"))$

/* Rubi :351-353  IntegralFreeQ — FreeQ over the four heads Int /
   Integral / Unintegrable / CannotIntegrate. The package
   noun-surface mapping (recorded, task-4 report):
   * Int / IntHide -> the mr_int dispatcher name: freeof('mr_int, u)
     flags an unevaluated mr_int[...] node;
   * Unintegrable AND CannotIntegrate -> the SAME package noun: the
     emitter maps both to the mr_unintegrable(f, x) call
     (generator/generate_rules.py:1393-1394) whose value is the
     'unintegrable[f, x] node (this file's line 27); one
     freeof('unintegrable, u) covers both;
   * Integral -> NO package surface: the MA typeset integral form has
     no table row and no emitted noun (grep of the table: absent) —
     omitted;
   * plus the native integrate fall-through noun: mr_int's 0-firing
     residue (mr_top with fb = true returns the bare integrate(f, x)
     noun, this file's line 323) — the evaluated image of an .m Int
     call that did not fire; the brief's surface lists it first, and
     without it the 3.3 r60 cond would accept an unresolved
     sub-integral and let the Subst rule fire on a residue.
   MEASURED 2026-08-29 (branch_5_50_base_84_g4204fb669 / SBCL 2.6.7):
   a NOUN's op is an internal symbol whose string() is the head name
   (the %mr_calculusQ note, this file's line 4560) and freeof of the
   function symbol flags every one of the head positions —
   freeof('integrate, integrate(tan(x^2), x)) = false on the REAL
   fall-through noun, freeof('unintegrable, 'unintegrable[f(x), x])
   = false, freeof('mr_int, 'mr_int[f(x), x]) = false — and freeof
   recurses through nested calls (freeof('sin, f(sin(x))) = false),
   so one freeof per symbol is the whole walk. */
%mr_integralFreeQ(u) := block([],
  is(freeof('mr_int, u) and freeof('integrate, u)
     and freeof('unintegrable, u)))$

/* Rubi :316-322  InverseFunctionFreeQ — the recursion: atom ->
   true (the .m's AtomQ arm, TRUE even for the variable itself);
   a head in InverseFunctionQ / CalculusQ / Hypergeometric2F1 /
   AppellF1 -> FreeQ[u, x]; else every part free (the .m's
   Catch[Scan[...]] over the parts). The two special-function head
   tests are string(op) checks on the GENERATED head spellings
   (Hypergeometric2F1 emits the hypergeometric list-form call,
   AppellF1 emits the AppellF1 noun — the table rows); one
   string(op) test covers operator heads too (string of a string is
   the identity, the %mr_calculusQ note). MEASURED 2026-08-29 on
   branch_5_50_base_84_g4204fb669 / SBCL 2.6.7:
   string(op(hypergeometric([1, 2], [3], x))) = "hypergeometric"
   (the call stays a noun), string(op(AppellF1(1, 2, 3, 4, x))) =
   "AppellF1". The FreeQ[u, x] arm is freeof(x, u), measured to see
   through every noun form the call sites produce (the integrate
   fall-through noun, the diff noun, 'unintegrable[.] bracket nodes,
   nested calls). MEASURED DIVERGENCE (recorded, task-4 report): the
   finite PRODUCT noun is a special internal object freeof() cannot
   see through — freeof(x, product(f(x), x, 1, n)) = true, and the
   same opacity holds for a QUOTED bracket list on a bound head
   (freeof(x, 'product[f(x), x, 1, n]) = true) — so such a node
   reports x-free where MA's FreeQ would not; no call site can
   produce either shape (the rules emit no product heads; an mr_int
   result carries a closed form or the integrate noun). */
%mr_inverseFunctionFreeQ(u, x) := block([i, ok],
  if atom(u) then true
  else if %mr_inverseFunctionQ(u) or %mr_calculusQ(u)
       or is(string(op(u)) = "hypergeometric")
       or is(string(op(u)) = "AppellF1")
  then freeof(x, u)
  else (
    ok : true,
    for i : 1 thru length(u) do
      if %mr_inverseFunctionFreeQ(part(u, i), x) = false
      then ok : false,
    ok))$

/* Rest[u] for the RFE product branch — the product of parts 2..n
   (MA's Rest reconstructs the flat Times head; a times node has
   >= 2 parts, so part(u, 2) always exists). The SUM branch uses the
   existing %mr_rest_sum (the head-preserving Plus reconstruction)
   instead. */
%mr_rfe_rest(u) := block([i, r],
  r : part(u, 2),
  for i : 3 thru length(u) do r : r * part(u, i),
  r)$

/* Rubi :1618-1636  RationalFunctionExponents — the branch ladder,
   line-ported. The .m's five arms:
     PolynomialQ[u,x]        -> {Exponent[u,x], 0}
     IntegerPowerQ[u]        -> u[[2]] > 0 ? u[[2]]*RFE[u[[1]]]
                                : (-u[[2]])*Reverse[RFE[u[[1]]]]
     ProductQ[u]             -> RFE[First[u]] + RFE[Rest[u]]
     SumQ[u]                 -> v = Together[u]; SumQ[v]
                                ? {Max[lst1.1+lst2.2, lst2.1+lst1.2],
                                   lst1.2+lst2.2}   (lst1 = RFE[First[u]],
                                   lst2 = RFE[Rest[u]])
                                : RFE[v]
     else                    -> {0, 0}
   Storage adaptations, MEASURED 2026-08-29 on
   branch_5_50_base_84_g4204fb669 / SBCL 2.6.7 (two arms the .m
   never writes, both storage-only):
   * the MINUS arm: the product sign lifts to a top-level unary "-"
     node (op(-x) = "-"); the .m reads -u as the product with a -1
     factor whose own exponents are {0, 0}, so the arm is the
     identity on the wrapped value (house precedent: the
     SignOfFactor minus-wrap note);
   * the QUOTIENT arm: this build stores EVERY quotient and every
     negative integer power as a "/" node — op(x^(-2)) = "/" with
     args(x^(-2)) = [1, x^2], op((x+1)^(-1)) = "/", op(a*(b/c)) =
     "/" with args [a*b, c], (a/b)^2 stores as a^2/b^2 — so the .m's
     u[[2]] < 0 arm of the IntegerPowerQ branch is unreachable
     through a "^" node and the quotient arm carries it: num/den is
     num * den^(-1), the numerator list plus the denominator list
     SWAPPED. An x-free denominator makes the node a polynomial and
     is caught by arm 1 first (x/2 -> [1, 0]).
   The .m's Together is rat here (together is a NOUN in this build
   without preload — M1 ledger): a rat() result is a PLAIN node tree
   (op(rat(x + 1/x)) = "/" with args [x^2+1, x]; op(rat(sin(x) + x))
   = "+"), so the SumQ[v] gate and the v-recursion read it directly;
   part() access on the combined quotient is plain too — the gcrat
   objects of the M1 denom(rat(…)) trap appear only behind num() /
   denom(), which this port never calls. List arithmetic is native
   in this build: k * [a, b] = [a*k, b*k], [a, b] + [c, d] =
   [c+a, d+b], reverse([a, b]) = [b, a] (symbolic k included), and
   max of undecided symbolic args stays the max(…) noun — the MA
   Max reading. Termination mirrors the .m: every arm recurses on
   proper subparts (the product Rest and the sum Rest shrink the
   factor/term count, the quotient arm splits num/den, the rat arm
   either takes the closed lst form or recurses on the strictly
   smaller combined parts). */
%mr_rationalFunctionExponents(u, x) := block([k, v, lst1, lst2, n1, dn],
  if %mr_polynomialQ(u, x) then [%mr_degree(u, x), 0]
  else if %mr_integerPowerQ(u) then (
    k : part(u, 2),
    if is(k > 0) then k * %mr_rationalFunctionExponents(part(u, 1), x)
    else (-k) * reverse(%mr_rationalFunctionExponents(part(u, 1), x)))
  else if %mr_productQ(u) then
    %mr_rationalFunctionExponents(part(u, 1), x)
      + %mr_rationalFunctionExponents(%mr_rfe_rest(u), x)
  else if not atom(u) and is(op(u) = "-") then
    %mr_rationalFunctionExponents(part(u, 1), x)
  else if not atom(u) and is(op(u) = "/") then (
    n1 : %mr_rationalFunctionExponents(part(u, 1), x),
    dn : %mr_rationalFunctionExponents(part(u, 2), x),
    [part(n1, 1) + part(dn, 2), part(n1, 2) + part(dn, 1)])
  else if %mr_sumQ(u) then (
    v : rat(u),
    if %mr_sumQ(v) then (
      lst1 : %mr_rationalFunctionExponents(part(u, 1), x),
      lst2 : %mr_rationalFunctionExponents(%mr_rest_sum(u), x),
      [max(part(lst1, 1) + part(lst2, 2), part(lst2, 1) + part(lst1, 2)),
       part(lst1, 2) + part(lst2, 2)])
    else %mr_rationalFunctionExponents(v, x))
  else [0, 0])$

/* ================= class-3 cluster B: fractional-power Subst family ====
 * Milestone-3 plan Task 5 — the heavy substitution/derivative utilities
 * (Rubi IntegrationUtilityFunctions.m, pinned clone):
 *   EasyDQ :7466-7495 (rule-1 strip :7466-7468)
 *   DerivativeDivides :7450-7462
 *   SubstForFractionalPower :1873-1881
 *   SubstForFractionalPowerOfLinear :6056-6063 (the 4-list contract)
 *   FractionalPowerOfLinear :6067-6076
 * plus the small predicate ports they call:
 *   FractionalPowerQ :206 (with this build's sqrt-head storage arm)
 *   ProductOfLinearPowersQ :7498-7502.
 * Reused, not duplicated: %mr_simp (the Simplify reading), %mr_polynomialQ,
 * %mr_degree (the Exponent reading), %mr_linearQ, %mr_binomialQ2 (the
 * BinomialQ[u,x] reading), %mr_rationalFunctionQ,
 * %mr_rationalFunctionExponents, %mr_productQ, %mr_sumQ, %mr_rest_sum,
 * %mr_rfe_rest (the product Rest), %mr_calculusQ, %mr_eqQ, %mr_falseQ,
 * %mr_fractionQ, %mr_nonfreeFactors, %mr_freeFactors.
 *
 * MEASURED 2026-08-29 on branch_5_50_base_84_g4204fb669 / SBCL 2.6.7
 * (fresh TLS-flagged process; the full session is in the task-5 report):
 *  - lcm(2,3) STAYS A NOUN; the working LCM id is abs(d*n)/gcd(d, n)
 *    (gcd(4,6) = 2 evaluates, abs(2*3)/gcd(2,3) = 6);
 *  - denominator(3/2) STAYS A NOUN while denom(3/2) = 2 / denom(2/3) = 3
 *    / denom(1/2) = 2 / denom(-2/3) = 3 evaluate — denom is the
 *    Denominator reading (the negative-rational "-" wrapper included);
 *  - degree(x^2, x) STAYS A NOUN — %mr_degree is the Exponent reading;
 *  - coeff(a+b*x, x, 0) = a / coeff(a+b*x, x, 1) = b evaluate — native
 *    coeff is the Coefficient reading for the linear-base slots;
 *  - op() returns the SYMBOL 'sqrt for the sqrt head (is(op(sqrt(x)) =
 *    'sqrt) true; the string "sqrt" never matches — the %mr_binomial_parts
 *    note at this file's line 1244 re-confirmed on the 2026-08-29 build)
 *    while operator heads (^, +, *, /, -, [) stay strings; sinc is its
 *    own head too (op(sinc(x)) = 'sinc);
 *  - (x+1)^(1/2) stores as the sqrt node (args [x+1]); (x+1)^(2/3) and
 *    x^(2/3) store as "^" nodes whose rational exponent is a non-atom
 *    "/" node (args [x+1, 2/3]; op(2/3) = "/", atom(2/3) = false);
 *  - EVERY negative power stores as a "/" node: op((x+1)^(-2/3)) = "/"
 *    args [1, (x+1)^(2/3)], op((x+1)^(-1/2)) = "/" args [1, sqrt(x+1)]
 *    — the .m's Power-head FractionalPowerQ is unreachable for them and
 *    the ports decline that corner (the %mr_productQ minus-lift
 *    precedent); the 3.5 r16 call site (the only consumer) guards
 *    RationalFunctionQ on the RFx slot, so a negative fractional power
 *    can only reach the scan inside u, where the .m would find it —
 *    recorded divergence, decline direction;
 *  - log of a PURE power AUTO-EXPANDS: log((x+1)^(2/3)) ->
 *    (2 log(x+1))/3, log(sqrt(x+1)) -> log(x+1)/2, while log of a SUM
 *    keeps its argument (log(1 + (x+1)^(2/3)) stays, measured) — the 3.5
 *    r16 call site therefore only ever sees the fractional linear power
 *    inside a log sum, and the end-to-end pin uses that shape (the
 *    plan's bare log((x+1)^(2/3)) example does not survive Maxima
 *    simplification — recorded);
  *  - 1 + 2*(-1/2 + x^3/2) does NOT auto-distribute (stays
  *    2*(x^3/2 - 1/2) + 1) — the %mr_simp stage (expand) is what
  *    normalizes the substituted integrand;
  *  - factor() RE-extracts a common power from a sum carrying a log
  *    term in BOTH plain and rat mode (factor(a*x^5 + b*x^5*log(x^2+1))
  *    -> x^5*(b*log(x^2+1)+a) — measured); the plain-vs-rat difference
  *    is decided by the ratsimp stages of %mr_simp (the same-statement
  *    rat() quirk, the :6268 note), so the 4-list v slot carries the
  *    FACTORED form x^5*(b*log(x^2+1)+a) in every call context (the
  *    call site integrates v, so the form is inert for the answer);
 *  - length() is a HARD ERROR on atoms ("length: argument cannot be a
 *    symbol") — every length() read is atom-gated;
 *  - is([1,1] = [1,1]) = true / is([3, x+1] = [3, x+1]) = true — list
 *    equality through is() is the RFE == {1,1} reading;
 *  - diff never emits the sinc head for the pinned test shapes:
 *    diff(sin(x)/x, x) = cos(x)/x - sin(x)/x^2, diff(sin(2*x), x) =
 *    2*cos(2*x), diff(log(x+1), x) = 1/(x+1), diff(sqrt(x+1), x) =
 *    1/(2 sqrt(x+1)) — the .m's ReplaceAll[Sinc[z_], Sin[z]/z] is a
 *    no-op on every reachable D[y, x] in this build; the replacement is
 *    ported as the faithful walk anyway (dead arm, recorded);
 *  - diff(f(x), x) on an unknown function stays the noun
 *    'diff(f(x), x, 1), and %mr_simp (ratsimp/expand/factor) passes it
 *    through untouched (measured), so the DerivativeDivides decline on
 *    unknown-function y lands through the freeof() walk seeing the x in
 *    the noun's args — the .m's f'[x] reading;
 *  - x^(3*(2/3)) -> x^2 (the n*exponent collapse evaluates);
 *  - part() on a QUOTED noun call is structural (part('g(a,b), 1) = a)
 *    — the Layer A RED-phase pins are death-safe through it.
 */

/* Rubi :206  FractionalPowerQ = Function[Head[#]===Power &&
   Head[#[[2]]]===Rational]. The proper-fraction test is %mr_fractionQ
   (this file's line 582): a reduced rational in this build is a "/" or
   "-" node with integer num/denom, and integerp is the Integer-head
   stand-in, so %mr_fractionQ(part(u,2)) is exactly
   Head[#[[2]]]===Rational. The SQUARED-HEAD arm is the sqrt storage:
   (x+1)^(1/2) stores as its own head (measured 2026-08-29, note above)
   and the .m's Power-only test would MISS the n = 2 case the
   SubstForFractionalPowerOfLinear contract exists for — the sqrt reading
   takes the exponent as 1/2. */
%mr_fractionalPowerQ(u) := block([],
  if atom(u) then false
  else if is(op(u) = 'sqrt) then true
  else if is(op(u) = "^") then %mr_fractionQ(part(u, 2))
  else false)$

/* the exponent of a fractional power — 1/2 for the sqrt head (the
   1-part sqrt node has no part(u, 2): part(sqrt(x+1), 2) hard-errors
   "part: fell off the end" — measured 2026-08-29). */
%mr_fractionalPowerExpon(u) := block([],
  if is(op(u) = 'sqrt) then 1/2 else part(u, 2))$

/* Rubi :7498-7502  ProductOfLinearPowersQ — FreeQ[u,x] ||
   MatchQ[u, v_^n_. /; LinearQ[v,x] && FreeQ[n,x]] ||
   ProductQ[u] && ProductOfLinearPowersQ[First[u],x] &&
   ProductOfLinearPowersQ[Rest[u],x]. The .m's OPTIONAL exponent (n_.)
   reads a BARE linear factor as n = 1 — the final %mr_linearQ arm; a
   power factor matches v_^n_. through the "^"/sqrt arm with the
   FreeQ[n,x] guard. The Maxima-flat product loop replaces the .m's
   First/Rest recursion (a times node's factors are flat — measured).
   The minus-lift corner (-a*b stores as a "-" node in this build —
   measured) declines, as in %mr_productQ. */
%mr_productOfLinearPowersQ(u, x) := block([i, ok, e],
  if freeof(x, u) then true
  else if atom(u) then %mr_linearQ(u, x)
  else if is(op(u) = "*") then (
    ok : true,
    for i : 1 thru length(u) do
      if %mr_productOfLinearPowersQ(part(u, i), x) = false
      then (ok : false, return()),
    ok
  )
  else if is(op(u) = "^") or is(op(u) = 'sqrt) then (
    e : %mr_fractionalPowerExpon(u),
    %mr_linearQ(part(u, 1), x) and freeof(x, e)
  )
  else %mr_linearQ(u, x))$

/* the .m rule-1 strip: EasyDQ[u_.*x_^m_., x] := EasyDQ[u, x] /;
   FreeQ[m, x] — the product's x-power factor (a bare x reads m = 1)
   removed, the product of the remaining factors returned; false if no
   such factor. A Maxima product carries at most one x-power factor
   (like powers auto-combine — x^2*x^(1/3) stores as x^(7/3)), so the
   first hit is the .m's unique binding. return(value) is loop-level in
   this build (measured 2026-08-20), so the bare return() break + flag
   idiom. */
%mr_easyDQ_strip(u, x) := block([i, m, f, r, found],
  found : false,
  for i : 1 thru length(u) do (
    f : part(u, i),
    if (atom(f) and is(f = x))
      or (not atom(f) and is(op(f) = "^")
          and is(part(f, 1) = x) and freeof(x, part(f, 2))) then (
      r : 1,
      for m : 1 thru length(u) do
        if m # i then r : r * part(u, m),
      found : true,
      return()
    )
  ),
  if found then r else false)$

/* Rubi :7466-7495  EasyDQ — the ladder, line-ported:
   rule-1 strip / AtomQ-||-FreeQ-||-Length==0 True / CalculusQ False /
   Length==1 recurse / BinomialQ||ProductOfLinearPowersQ True /
   RationalFunctionQ&&RFE=={1,1} True / ProductQ one-x-factor recurse /
   SumQ both recurse / Length==2 one-free recurse / else False.
   The Length==0 arm is unreachable in this build (atoms are gated
   first — no call site produces an empty expression) and is folded
   into the atom arm. Storage: a function call's parts() are its
   ARGUMENTS (part(log(x+1), 1) = x+1, length 1 — measured), a power's
   parts are base/exponent (length 2), a quotient's parts are num/den,
   so the .m's Length/[[1]]/First/Rest read as length()/part()/
   part(u,1)/%mr_rest_sum/%mr_rfe_rest. */
%mr_easyDQ(u, x) := block([r],
  if not atom(u) and is(op(u) = "*") then (
    r : %mr_easyDQ_strip(u, x),
    if not %mr_falseQ(r) then return(%mr_easyDQ(r, x))
  ),
  if atom(u) or freeof(x, u) then true
  else if %mr_calculusQ(u) then false
  else if is(length(u) = 1) then %mr_easyDQ(part(u, 1), x)
  else if %mr_binomialQ2(u, x) or %mr_productOfLinearPowersQ(u, x) then true
  else if %mr_rationalFunctionQ(u, x)
        and is(%mr_rationalFunctionExponents(u, x) = [1, 1]) then true
  else if %mr_productQ(u) then (
    if freeof(x, part(u, 1)) then %mr_easyDQ(%mr_rfe_rest(u), x)
    else if freeof(x, %mr_rfe_rest(u)) then %mr_easyDQ(part(u, 1), x)
    else false
  )
  else if %mr_sumQ(u) then
    %mr_easyDQ(part(u, 1), x) and %mr_easyDQ(%mr_rest_sum(u), x)
  else if is(length(u) = 2) then (
    if freeof(x, part(u, 1)) then %mr_easyDQ(part(u, 2), x)
    else if freeof(x, part(u, 2)) then %mr_easyDQ(part(u, 1), x)
    else false
  )
  else false)$

/* MatchQ[y, a_.*x /; FreeQ[a, x]] — y a times node with one x factor
   and every other factor x-free (a bare x does NOT match: the .m's
   a_.*x requires >= 2 factors). The minus-lift corner (-a*x stores as
   a "-" node in this build — measured) misses the match where MA's
   Times head would take it; the decline still lands through the
   FreeQ[v, x] arm (same false, different path — recorded). */
%mr_xmonomialMatch(y, x) := block([i, j, ok, found],
  found : false,
  if not atom(y) and is(op(y) = "*") then (
    for i : 1 thru length(y) do (
      if is(part(y, i) = x) then (
        ok : true,
        for j : 1 thru length(y) do
          if j # i and not freeof(x, part(y, j)) then ok : false,
        if ok then (found : true, return())
      )
    )
  ),
  found)$

/* the .m's ReplaceAll[D[y,x], Sinc[z_]->Sin[z]/z] — the faithful walk
   (sinc is its own head in this build — measured 2026-08-29). DEAD ARM
   on every reachable diff result in this build (diff never emits the
   sinc head for the pinned shapes — note above); ported for line
   fidelity. */
%mr_sincReplace(v) := block([],
  if atom(v) then v
  else if is(op(v) = 'sinc) then sin(part(v, 1))/part(v, 1)
  else if is(op(v) = "[") then
    map(lambda([z], %mr_sincReplace(z)), %mr_parts_list(v))
  else apply(op(v), map(lambda([z], %mr_sincReplace(z)), args(v))))$

/* Rubi :7450-7462  DerivativeDivides[y, u, x] — if y is not a*x (a
   x-free), y is easy to differentiate (PolynomialQ[y,x] ? the
   PolynomialQ[u,x] && Exponent[u,x]==Exponent[y,x]-1 degree test :
   EasyDQ[y,x]), and u divided by D[y,x] is x-free, the quotient
   Simplify[u/v]; else False. Storage: Exponent = %mr_degree (degree
   is a noun — measured); Simplify = %mr_simp. The v = 0 arm is
   UNREACHABLE: a polynomial y passing the degree test has degree >= 1
   (D[y,x] # 0), and a non-polynomial EasyDQ y (log-like) has a
   nonzero derivative — the constant-y decline lands through the
   degree test instead (recorded).
   FIX B4 (2026-09-01, class-3 deferred campaign): y is expanded at
   the binding, before the ladder (the .m's a_.*x guard runs on y as
   bound, .m order). Maxima stores P/x^m as a "/" node where MA
   stores the Times P*x^(-m) that the .m EasyDQ rule-1 strip
   (EasyDQ[u_.*x_^m_., x] /; FreeQ[m, x]) matches; the line-ported
   %mr_easyDQ declines the "/" shape (no strip arm, and the
   RationalFunctionExponents=={1,1} arm reads [0,0] on a symbolic
   m), so 3_5 r1/r2's e392 shape (3.4 file L509; v = (a+x^n)/x^n,
   integrand log((a+x^n)/x^n)/x) 0-fired while the algebraic twin
   log(1+a*x^-n)/x (Plus storage) fired. MEASURED 2026-09-01 (t4b4
   probe 1, branch_5_50_base_84_g4204fb669): the decline is the
   EasyDQ cond (easyDQ((a+x^n)/x^n, x) = false), NOT the u/v step
   (%mr_simp(u/diff(y,x)) = 1/n pre-fix — the ratsimp stage alone
   closes it); expand maps the stored quotient to the distributed
   sum the ladder reads (expand((a+x^n)/x^n) = a*x^(-n) + 1) and is
   the identity on every other form the ladder accepts (plus /
   binomial / monomial / power / product-of-linears / log shapes
   measured unchanged, t4b4 probe 2). The Simplify[u/v] line is
   untouched. */
%mr_derivativeDivides(y, u, x) := block([v, cond],
  if %mr_xmonomialMatch(y, x) then false
  else (
    y : expand(y),
    cond : if %mr_polynomialQ(y, x)
      then %mr_polynomialQ(u, x)
           and is(%mr_degree(u, x) = %mr_degree(y, x) - 1)
      else %mr_easyDQ(y, x),
    if is(cond) = true then (
      v : %mr_sincReplace(diff(y, x)),
      if is(v = 0) then false
      else (
        v : %mr_simp(u/v),
        if freeof(x, v) then v else false
      )
    )
    else false))$

/* Rubi :6067-6076  FractionalPowerOfLinear[u, n, v, x] — the first
   (depth-first, parts order) fractional power of a LINEAR base found
   in u: {LCM[Denominator[exponent], n], base}; the {n, v} identity on
   atom/x-free; the v-equality guard (the LCM accumulates only for the
   SAME base); the CalculusQ decline; else the parts scan. The scan's
   Throw[False] is the flag + bare return() idiom (return(value) is
   loop-level — the line-81 note). LCM = abs(d*n)/gcd(d, n) (lcm is a
   noun — measured); Denominator = denom (denominator is a noun —
   measured). */
%mr_fractionalPowerOfLinear(u, n, v, x) := block([i, e, d, lst],
  if atom(u) or freeof(x, u) then [n, v]
  else if %mr_calculusQ(u) then false
  else if %mr_fractionalPowerQ(u) then (
    e : %mr_fractionalPowerExpon(u),
    if %mr_linearQ(part(u, 1), x)
       and (%mr_falseQ(v) or %mr_eqQ(part(u, 1), v)) then (
      d : denom(e),
      [abs(d*n)/gcd(d, n), part(u, 1)]
    )
    else (
      lst : [n, v],
      for i : 1 thru length(u) do (
        lst : %mr_fractionalPowerOfLinear(part(u, i), part(lst, 1), part(lst, 2), x),
        if atom(lst) then return()
      ),
      if atom(lst) then false else lst
    )
  )
  else (
    lst : [n, v],
    for i : 1 thru length(u) do (
      lst : %mr_fractionalPowerOfLinear(part(u, i), part(lst, 1), part(lst, 2), x),
      if atom(lst) then return()
    ),
    if atom(lst) then false else lst))$

/* Rubi :1873-1881  SubstForFractionalPower[u, v, n, w, x] — u with the
   subexpressions v^(m/n) (and the sqrt(v) storage form) replaced by
   x^(n*(m/n)) and the variable x replaced by w; everything else maps
   over the parts with the head rebuilt (the .m's Map[Function[...], u]
   — the house generic-head idiom, the %mr_substPower line 3811). The
   5th argument is the ORIGINAL variable, which is also the new
   variable's symbol — the .m's substitution convention reuses the
   integration variable's name for the substituted-in variable (the
   caller builds w = -a/b + x^n/b over that same symbol). */
%mr_substForFractionalPower(u, v, n, w, x) := block([e],
  if atom(u) then (
    if is(u = x) then w else u
  )
  else if %mr_fractionalPowerQ(u) and %mr_eqQ(part(u, 1), v) then (
    e : %mr_fractionalPowerExpon(u),
    x^(n*e)
  )
  else if is(op(u) = "[") then
    map(lambda([z], %mr_substForFractionalPower(z, v, n, w, x)),
      %mr_parts_list(u))
  else apply(op(u), map(lambda([z], %mr_substForFractionalPower(z, v, n, w, x)),
    args(u))))$

/* Rubi :6056-6063  SubstForFractionalPowerOfLinear[u, x] — the 4-list
   contract: {v, n, a+b*x, 1/b} where v is u with every (a+b*x)^(m/n)
   replaced by x^m and x by -a/b + x^n/b, times x^(n-1), all
   Simplify'd (= %mr_simp); NonfreeFactors/FreeFactors split v.
   Coefficient = native coeff (coeff(a+b*x, x, 0/1) evaluate —
   measured). False decline when FractionalPowerOfLinear finds no
   fractional linear power (the {n, False} identity or a thrown
   False).

   MEASURED 2026-08-29 (branch_5_50_base_84_g4204fb669/SBCL 2.6.7):
   the v slot comes back FACTORED (x^5*(b*log(x^2+1)+a) on the 3.5 r16
   shape), not the expanded sum the .m's Simplify would print — line 1
   (%mr_fractionalPowerOfLinear -> %mr_linearQ -> %mr_together) runs
   rat(), and rat() flips the simplifier into rat mode for the REST of
   the enclosing statement: a rat-mode ratsimp no longer expands a
   product over a sum factor (plain-statement ratsimp does; the quirk
   is pure Maxima — block([], rat(x+1), ratsimp(x^5*(b*log(x^2+1)+a)))
   stays factored, the rat-free twin expands, and the mode does not
   leak into the next statement; bisect session probes v2-v24 +
   probe-rat-mode.mac T0-T6). Every real call of this function carries
   the rat -> %mr_simp pair inside one statement, so the factored form
   is the stable output contract; the unit pin uses it (is(factored =
   expanded) is false in this build — measured). */
%mr_substForFractionalPowerOfLinear(u, x) := block([lst, n, a, b, tmp],
  lst : %mr_fractionalPowerOfLinear(u, 1, false, x),
  if atom(lst) or %mr_falseQ(part(lst, 2)) then false
  else (
    n : part(lst, 1),
    a : coeff(part(lst, 2), x, 0),
    b : coeff(part(lst, 2), x, 1),
    tmp : %mr_simp(x^(n-1)*%mr_substForFractionalPower(u, part(lst, 2), n, -a/b + x^n/b, x)),
    [%mr_nonfreeFactors(tmp, x), n, part(lst, 2), %mr_freeFactors(tmp, x)/b]))$

/* Rubi :188-190  NonsumQ[u] — true iff u is NOT a sum (the two upvalues
   NonsumQ[_Plus] = False; NonsumQ[_] = True). The head test is op = "+"
   (MEASURED 2026-09-04 on branch_5_50_base_84_g4204fb669 / SBCL 2.6.7:
   is(op(1+x) = "+") = true; a unary-minus node is NOT a Plus and keeps
   NonsumQ true, the MA head reading). The 3.5 L46 catch-all's outer
   cond; the .m's two-branch form has no other class-3 call site. */
%mr_nonsumQ(u) := block([],
   if atom(u) then true
   else not is(op(u) = "+"))$

/* Rubi :238  LogQ[u] — Head[u] === Log. The bound log head is the
   symbol 'log (MEASURED 2026-09-04, branch_5_50_base_84_g4204fb669 /
   SBCL 2.6.7: is(op(log(x)) = 'log) = true, string(op(log(x))) =
   "log"; a power over a log (log(x)^2, op "^") and the collapsed sqrt
   head (symbol 'sqrt) are NOT logs — the FunctionOfLog walk recurses
   into their parts instead). */
%mr_logQ(u) := block([],
   if atom(u) then false
   else is(op(u) = 'log))$

/* Rubi :4945-4949  FunctionOfLog[u, x] — {f, a*x^n, n} iff u is a
   function of Log[a*x^n] with the log argument replaced by x in f;
   false if u is not (the thrown False or the no-log-found v = False
   tail). The 3.5 L46 catch-all's decomposition: the repl integrates
   f in x and Subst's the log argument back. */
%mr_functionOfLog(u, x) := block([lst],
   lst : %mr_functionOfLog_aux(u, false, false, x),
   if atom(lst) or %mr_falseQ(part(lst, 2)) then false
   else lst)$

/* Rubi :4952-4968  FunctionOfLog[u, v, n, x] — the 4-arg recursion:
   (a) atom: {u, v, n} unless u === x (the variable itself is not a
   function of a log -> False); (b) CalculusQ: False (a pending
   integrate/sum node cannot be a log function); (c) LogQ with
   BinomialParts[u[[1]], x] = [0, b, n0] (a pure power a*x^n, a = 0
   part zero): {x, u[[1]], n0} iff v is the not-yet-set False or the
   SAME log argument (a second, different log argument -> False), else
   False; (d) else: the parts walk with the running (v, n) state.
   The .m's Catch[Map[Function[lst=FunctionOfLog[#, lst[[2]],
   lst[[3]], x]; If[AtomQ[lst], Throw[False], lst[[1]]]], u], v, n]
   is the %mr_mofl_walk: each part recurses with the RUNNING v/n (a
   matched log part sets them for the later parts), a thrown False
   aborts the whole result, and the mapped first components are
   reassembled under u's own head (the .m's Map keeps the head; the
   apply(op(u), ...) rebuild is the house generic-head idiom, the
   %mr_substForFractionalPower line 7263). Maxima adaptations: the
   Throw[False] flag is a first-component false sentinel (return(value)
   is loop-level, the line-7230 idiom); u === x / u[[1]] === v read as
   is(=) per the house IdentityQ reading (the %mr_substForFractional-
   Power line 7254). */
%mr_functionOfLog_aux(u, v, n, x) := block([bp, i, r, res],
   if atom(u) then (
     if is(u = x) then false
     else [u, v, n]
   )
   else if %mr_calculusQ(u) then false
   else if %mr_logQ(u) then (
     bp : %mr_binomial_parts(part(u, 1), x),
     if not atom(bp) and %mr_eqQ(part(bp, 1), 0) then (
       if %mr_falseQ(v) or is(part(u, 1) = v)
       then [x, part(u, 1), part(bp, 3)]
       else false
     )
     else %mr_mofl_walk(u, v, n, x)
   )
   else %mr_mofl_walk(u, v, n, x))$

/* The FunctionOfLog else-branch parts walk (the .m's Catch/Map):
   recurse into every part with the running (v, n); a thrown False from
   any part aborts the whole result (the .m's Throw[False]); reassemble
   the first components under u's head. The list branch mirrors the
   .m's Map-over-list result. The abort is the dead flag + BARE
   return() idiom: a return(value) inside a for loop is loop-level in
   this build, not function-level (the line-81 note; %mr_mofl_walk
   would fall through to the apply and hard-error on the partial res). */
%mr_mofl_walk(u, v, n, x) := block([i, r, res, dead],
   res : [],
   dead : false,
   for i : 1 thru length(u) do (
     r : %mr_functionOfLog_aux(part(u, i), v, n, x),
     if atom(r) then (
       dead : true,
       return()
     ),
     v : part(r, 2),
     n : part(r, 3),
     res : append(res, [part(r, 1)])
   ),
   if is(dead = true) then false
   else if is(op(u) = "[") then [res, v, n]
   else [apply(op(u), res), v, n])$

/* Rubi's inert-trig rewrite functions, ported as generated rewrite tables
   (inert-trig substrate design 3.2): every one of their clauses --
   UnifyInertTrigFunction's 75, FixInertTrigFunction's 61 and
   ReduceInertTrig's 4, 140 in the generated tables, 137 of them
   conditioned (uitf r68, fitf r61 and rit r3 register `true`) -- is
   Name[pattern] := rhs [/; cond], so they compile through the same emitter
   as an Int rule instead of being hand-written. The tables live in
   rules/utils/inert_trig_rewrites.mac. Recursion is Rubi's own — a clause
   that calls itself re-enters through these wrappers, and there is no depth
   guard by design decision (spec 3.2). */
%mr_unifyInertTrigFunction(u, x) :=
  %mr_rewrite("UnifyInertTrigFunction", mr_rw_uitf, u, x)$
%mr_fixInertTrigFunction(u, x) :=
  %mr_rewrite("FixInertTrigFunction", mr_rw_fitf, u, x)$
/* f is a BARE inert head (Rubi's ReduceInertTrig[sin, v]), passed as the
   operator symbol %mr_isin, not as an application. mr-tree converts that
   symbol to a plain tree atom (it is not an applied head, so +functions+ is
   not consulted), every rit clause captures it with a plain func_ Blank,
   and the generated repl gets back the same Maxima symbol: func[u] is
   apply(func, [u]) = %mr_isin(u), and a Switch form `sin` is emitted as the
   symbol %mr_isin and compared with `=`. No tree head is involved.

   Rubi's ReduceInertTrig has TWO arities, and Maxima functions are
   fixed-arity, so this entry is variadic and dispatches on the count:
   - 2 arguments (func, u): the generated table mr_rw_rit, walked by
     %mr_rewrite. Its clauses 1 and 2 (L6496, L6500) pull the multiple of Pi
     out of u and recurse with 3 arguments.
   - 3 arguments (func, m, u): %mr_reduceInertTrig3, the hand port of the
     single L6509 clause that reduces the multiple m of Pi.
   The table's clause 4 is the same L6509 clause as a generated record; its
   pattern has 3 arguments, so it never binds the 2-argument walk and is
   inert there (it is kept so the table count matches the source). */
%mr_reduceInertTrig([%mr_rit_args]) :=
  if length(%mr_rit_args) = 2 then
    %mr_rewrite("ReduceInertTrig", mr_rw_rit,
                first(%mr_rit_args), second(%mr_rit_args))
  else if length(%mr_rit_args) = 3 then
    %mr_reduceInertTrig3(first(%mr_rit_args), second(%mr_rit_args),
                         third(%mr_rit_args))
  else error("%mr_reduceInertTrig: expected 2 or 3 arguments, found",
             length(%mr_rit_args))$

/* Rubi IntegrationUtilityFunctions.m L6509, ported as written:
     ReduceInertTrig[func_,m_,u_] := If[m<0, ..., If[m>=2, ...Mod[m,2]...,
       If[m>=1, Switch[...], If[m>=1/2, Switch[...], func[m*Pi+u]]]]] /;
     RationalQ[m]
   returns func[m*Pi+u] with m reduced to -1/4 <= m < 1/2.
   - The /; RationalQ[m] guard failing means the definition does not apply;
     Mathematica then leaves the call unevaluated, and so does this port: it
     returns the noun '%mr_reduceInertTrig(func, m, u). Unreachable from the
     table, whose clauses 1/2 only call it with a product of rationals.
   - A Switch whose func is none of the six inert heads is likewise left
     unevaluated in Mathematica; the port returns the same noun (also
     unreachable: every caller passes one of the six).
   - The bare Switch atoms sin ... csc are the symbols %mr_isin ... %mr_icsc,
     compared with = (syntactic, as Switch is).
   Locals are %mr_rt_-prefixed (a bound m/u would capture the corpus
   symbols of the same name inside u). */
%mr_reduceInertTrig3(%mr_rt_f, %mr_rt_m, %mr_rt_u) := block(
  [%mr_rt_unev],
  %mr_rt_unev : '%mr_reduceInertTrig(%mr_rt_f, %mr_rt_m, %mr_rt_u),
  if not %mr_rationalQ(%mr_rt_m) then %mr_rt_unev
  else if %mr_rt_m < 0 then (
    if %mr_rt_m >= -1/4 then apply(%mr_rt_f, [%mr_rt_m*%pi + %mr_rt_u])
    else if %mr_rt_f = '%mr_isin then
      -%mr_reduceInertTrig('%mr_isin, -%mr_rt_m, -%mr_rt_u)
    else if %mr_rt_f = '%mr_icos then
      %mr_reduceInertTrig('%mr_icos, -%mr_rt_m, -%mr_rt_u)
    else if %mr_rt_f = '%mr_itan then
      -%mr_reduceInertTrig('%mr_itan, -%mr_rt_m, -%mr_rt_u)
    else if %mr_rt_f = '%mr_icot then
      -%mr_reduceInertTrig('%mr_icot, -%mr_rt_m, -%mr_rt_u)
    else if %mr_rt_f = '%mr_isec then
      %mr_reduceInertTrig('%mr_isec, -%mr_rt_m, -%mr_rt_u)
    else if %mr_rt_f = '%mr_icsc then
      -%mr_reduceInertTrig('%mr_icsc, -%mr_rt_m, -%mr_rt_u)
    else %mr_rt_unev)
  else if %mr_rt_m >= 2 then
    %mr_reduceInertTrig(%mr_rt_f, mod(%mr_rt_m, 2), %mr_rt_u)
  else if %mr_rt_m >= 1 then (
    if %mr_rt_f = '%mr_isin then
      -%mr_reduceInertTrig('%mr_isin, %mr_rt_m - 1, %mr_rt_u)
    else if %mr_rt_f = '%mr_icos then
      -%mr_reduceInertTrig('%mr_icos, %mr_rt_m - 1, %mr_rt_u)
    else if %mr_rt_f = '%mr_itan then
      %mr_reduceInertTrig('%mr_itan, %mr_rt_m - 1, %mr_rt_u)
    else if %mr_rt_f = '%mr_icot then
      %mr_reduceInertTrig('%mr_icot, %mr_rt_m - 1, %mr_rt_u)
    else if %mr_rt_f = '%mr_isec then
      -%mr_reduceInertTrig('%mr_isec, %mr_rt_m - 1, %mr_rt_u)
    else if %mr_rt_f = '%mr_icsc then
      -%mr_reduceInertTrig('%mr_icsc, %mr_rt_m - 1, %mr_rt_u)
    else %mr_rt_unev)
  else if %mr_rt_m >= 1/2 then (
    if %mr_rt_f = '%mr_isin then
      %mr_reduceInertTrig('%mr_icos, %mr_rt_m - 1/2, %mr_rt_u)
    else if %mr_rt_f = '%mr_icos then
      -%mr_reduceInertTrig('%mr_isin, %mr_rt_m - 1/2, %mr_rt_u)
    else if %mr_rt_f = '%mr_itan then
      -%mr_reduceInertTrig('%mr_icot, %mr_rt_m - 1/2, %mr_rt_u)
    else if %mr_rt_f = '%mr_icot then
      -%mr_reduceInertTrig('%mr_itan, %mr_rt_m - 1/2, %mr_rt_u)
    else if %mr_rt_f = '%mr_isec then
      -%mr_reduceInertTrig('%mr_icsc, %mr_rt_m - 1/2, %mr_rt_u)
    else if %mr_rt_f = '%mr_icsc then
      %mr_reduceInertTrig('%mr_isec, %mr_rt_m - 1/2, %mr_rt_u)
    else %mr_rt_unev)
  else apply(%mr_rt_f, [%mr_rt_m*%pi + %mr_rt_u]))$

/* Rubi IntegrationUtilityFunctions.m L6487:
     PowerOfInertTrigSumQ[u_,func_,x_] :=
       MatchQ[u, (a_.+b_.*(c_.*func[w_])^n_.)^p_. /;
                 FreeQ[{a,b,c,n,p},x] && Not[EqQ[a,0] && (IntegerQ[p] || EqQ[n,1])]] ||
       MatchQ[u, (a_.+b_.*(d_.*func[w_])^p_.+c_.*(d_.*func[w_])^q_.)^n_. /;
                 FreeQ[{a,b,c,d,n,p,q},x]]
   func is a BARE inert head (%mr_isin ...), and in the pattern it is in
   HEAD position, func[w_]. An (MRArg k) part cannot stand there: a part is
   converted with max->tree, which turns the bare symbol %mr_isin into a
   plain atom, not the tree head sin that %mr_isin(w) becomes. So the head's
   tree name (sin ... csc, the +functions+ rows) is spliced into the pattern
   TEXT; each of the six texts is part-free and is prepared once and cached
   by %mr_matchQ. A func outside the six is false (Rubi's MatchQ against a
   pattern whose head no expression here carries). Optional defaults (a 0,
   b/c/d 1, exponents 1) are bound by MR-MATCH, so EqQ[a,0] sees the 0 of an
   absent a. */
%mr_powerOfInertTrigSumQ(%mr_pts_u, %mr_pts_f, %mr_pts_x) := block(
  [%mr_pts_h],
  %mr_pts_h : assoc(%mr_pts_f,
                    ['%mr_isin = "sin", '%mr_icos = "cos", '%mr_itan = "tan",
                     '%mr_icot = "cot", '%mr_isec = "sec", '%mr_icsc = "csc"]),
  if %mr_pts_h = false then false
  else
    %mr_matchQ(%mr_pts_u,
      sconcat("(Power (Plus (Optional (Pattern |_mr_poits_r1mq1_a| (Blank))) ",
              "(Times (Optional (Pattern |_mr_poits_r1mq1_b| (Blank))) ",
              "(Power (Times (Optional (Pattern |_mr_poits_r1mq1_c| (Blank))) ",
              "(", %mr_pts_h, " (Pattern |_mr_poits_r1mq1_w| (Blank)))) ",
              "(Optional (Pattern |_mr_poits_r1mq1_n| (Blank)))))) ",
              "(Optional (Pattern |_mr_poits_r1mq1_p| (Blank))))"),
      [],
      lambda([%mr_mqb],
        freeof(%mr_pts_x, %mr_mk(_mr_poits_r1mq1_a, %mr_mqb))
        and freeof(%mr_pts_x, %mr_mk(_mr_poits_r1mq1_b, %mr_mqb))
        and freeof(%mr_pts_x, %mr_mk(_mr_poits_r1mq1_c, %mr_mqb))
        and freeof(%mr_pts_x, %mr_mk(_mr_poits_r1mq1_n, %mr_mqb))
        and freeof(%mr_pts_x, %mr_mk(_mr_poits_r1mq1_p, %mr_mqb))
        and not (%mr_eqQ(%mr_mk(_mr_poits_r1mq1_a, %mr_mqb), 0)
                 and (%mr_integerQ(%mr_mk(_mr_poits_r1mq1_p, %mr_mqb))
                      or %mr_eqQ(%mr_mk(_mr_poits_r1mq1_n, %mr_mqb), 1)))))
    or %mr_matchQ(%mr_pts_u,
      sconcat("(Power (Plus (Optional (Pattern |_mr_poits_r2mq1_a| (Blank))) ",
              "(Times (Optional (Pattern |_mr_poits_r2mq1_b| (Blank))) ",
              "(Power (Times (Optional (Pattern |_mr_poits_r2mq1_d| (Blank))) ",
              "(", %mr_pts_h, " (Pattern |_mr_poits_r2mq1_w| (Blank)))) ",
              "(Optional (Pattern |_mr_poits_r2mq1_p| (Blank))))) ",
              "(Times (Optional (Pattern |_mr_poits_r2mq1_c| (Blank))) ",
              "(Power (Times (Optional (Pattern |_mr_poits_r2mq1_d| (Blank))) ",
              "(", %mr_pts_h, " (Pattern |_mr_poits_r2mq1_w| (Blank)))) ",
              "(Optional (Pattern |_mr_poits_r2mq1_q| (Blank)))))) ",
              "(Optional (Pattern |_mr_poits_r2mq1_n| (Blank))))"),
      [],
      lambda([%mr_mqb],
        freeof(%mr_pts_x, %mr_mk(_mr_poits_r2mq1_a, %mr_mqb))
        and freeof(%mr_pts_x, %mr_mk(_mr_poits_r2mq1_b, %mr_mqb))
        and freeof(%mr_pts_x, %mr_mk(_mr_poits_r2mq1_c, %mr_mqb))
        and freeof(%mr_pts_x, %mr_mk(_mr_poits_r2mq1_d, %mr_mqb))
        and freeof(%mr_pts_x, %mr_mk(_mr_poits_r2mq1_n, %mr_mqb))
        and freeof(%mr_pts_x, %mr_mk(_mr_poits_r2mq1_p, %mr_mqb))
        and freeof(%mr_pts_x, %mr_mk(_mr_poits_r2mq1_q, %mr_mqb)))))$

/* Rubi IntegrationUtilityFunctions.m L6170:
     InertReciprocalQ[f_,g_] := f===sin && g===csc || f===cos && g===sec ||
                                f===tan && g===cot
   f and g are head captures, which the dispatcher binds to the %mr_i*
   operator SYMBOL (maxima_rubi_dispatch.lisp mr-binding-value), so SameQ on
   the inert head is `=` on that symbol. Called from the conds of
   FixInertTrigFunction's four f_[v_]^m_ clauses. */
%mr_inertReciprocalQ(f, g) :=
  is((f = '%mr_isin and g = '%mr_icsc) or (f = '%mr_icos and g = '%mr_isec)
     or (f = '%mr_itan and g = '%mr_icot))$

/* Rubi InertTrigQ[f_] := MemberQ[{sin,cos,tan,cot,sec,csc},f]
   (IntegrationUtilityFunctions.m L6160). Takes a HEAD, as upstream does:
   rules bind F_ over an inert head and test this on the binding. The
   %mr_hyperbolicQ shape (atom u -> u, else op(u)) is deliberate — the atom
   branch was wrong there until 2026-09-20 and this one is faithful from the
   start. */
%mr_inertTrigQ(u) := block([],
  is(member(if atom(u) then u else op(u),
            [%mr_isin, %mr_icos, %mr_itan, %mr_icot, %mr_isec, %mr_icsc]) = true))$

/* Rubi InertTrigFreeQ[u_] := FreeQ[u,sin] && ... && FreeQ[u,csc] (L6173).
   An EXPRESSION test, unlike InertTrigQ. */
%mr_inertTrigFreeQ(u) := block([],
  is(freeof(%mr_isin, %mr_icos, %mr_itan, %mr_icot, %mr_isec, %mr_icsc, u) = true))$

/* Rubi TrigQ[f_] — the ACTIVE heads. Deliberately disjoint from
   %mr_inertTrigQ: a deactivated expression must not satisfy both. */
%mr_trigQ(u) := block([],
  is(member(if atom(u) then u else op(u),
            [sin, cos, tan, cot, sec, csc]) = true))$

/* Rubi ActivateTrig[u_] (L6180): the inverse of the inert head map of the
   inert-trig substrate design 3.1. MEASURED 2026-09-21
   (branch_5_50_base_84_g4204fb669 / SBCL 2.6.7): subst on the operator
   name rewrites every occurrence at any depth, including under a nested
   noun-arithmetic head (log(%mr_isin(2*x)^3+y) -> log(sin(2*x)^3+y)),
   both against a bare declare(noun) test and against the loaded package —
   so the flat subst chain below is faithful and no op/args recursion is
   needed. */
%mr_activateTrig(u) := block([mr_r],
  mr_r : u,
  mr_r : subst(sin, %mr_isin, mr_r), mr_r : subst(cos, %mr_icos, mr_r),
  mr_r : subst(tan, %mr_itan, mr_r), mr_r : subst(cot, %mr_icot, mr_r),
  mr_r : subst(sec, %mr_isec, mr_r), mr_r : subst(csc, %mr_icsc, mr_r),
  mr_r)$

/* Rubi DeactivateTrigAux[u,x] (IntegrationUtilityFunctions.m L6198-6218).
   Both branches. The hyperbolic branch is the cross-section bridge: it maps
   the six hyperbolic heads onto the six INERT TRIG heads by the
   imaginary-argument identities, with the argument multiplied by %i. This is
   how Rubi answers the class-6 shapes that have no section-6 rule file
   (probes/rubi/02-hyperbolic-inert-trig-bridge). op(u) on a function
   application (sin(x), sinh(x), ...) returns the bare symbol (sin, sinh,
   ...), not a string (measured this task; contrast the "+"/"*"/"^" string
   ops of the else branch's rebuild, trap (b)). The block local is
   %mr_dta_-prefixed and the else-branch lambda parameter is %mr_dta_t: a
   local or lambda parameter named like a corpus symbol (v, t, u, x, ...)
   can capture that symbol inside the walked expression (trap (a)). */
%mr_deactivateTrigAux(u, x) := block([%mr_dta_v],
  if atom(u) then u
  elseif %mr_trigQ(u) and %mr_linearQ([part(u, 1)], x) then (
    %mr_dta_v : %mr_expandToSum(part(u, 1), x),
    if op(u) = sin then %mr_reduceInertTrig(%mr_isin, %mr_dta_v)
    elseif op(u) = cos then %mr_reduceInertTrig(%mr_icos, %mr_dta_v)
    elseif op(u) = tan then %mr_reduceInertTrig(%mr_itan, %mr_dta_v)
    elseif op(u) = cot then %mr_reduceInertTrig(%mr_icot, %mr_dta_v)
    elseif op(u) = sec then %mr_reduceInertTrig(%mr_isec, %mr_dta_v)
    else %mr_reduceInertTrig(%mr_icsc, %mr_dta_v))
  elseif %mr_hyperbolicQ(u) and %mr_linearQ([part(u, 1)], x) then (
    %mr_dta_v : %mr_expandToSum(%i * part(u, 1), x),
    if op(u) = sinh then -%i * %mr_reduceInertTrig(%mr_isin, %mr_dta_v)
    elseif op(u) = cosh then %mr_reduceInertTrig(%mr_icos, %mr_dta_v)
    elseif op(u) = tanh then -%i * %mr_reduceInertTrig(%mr_itan, %mr_dta_v)
    elseif op(u) = coth then %i * %mr_reduceInertTrig(%mr_icot, %mr_dta_v)
    elseif op(u) = sech then %mr_reduceInertTrig(%mr_isec, %mr_dta_v)
    else %i * %mr_reduceInertTrig(%mr_icsc, %mr_dta_v))
  else apply(op(u),
             map(lambda([%mr_dta_t], %mr_deactivateTrigAux(%mr_dta_t, x)),
                 args(u))))$

/* Rubi DeactivateTrig[u,x] (L6189-6195): UnifyInertTrigFunction o
   FixInertTrigFunction o DeactivateTrigAux. The upstream file also carries
   a fast-path clause ahead of this one, for (c+d x)^m (a+b trig[e+f x])^n,
   that recurses DeactivateTrig into the trig factor alone rather than
   walking the whole product through DeactivateTrigAux. It is NOT ported
   here: no Layer A target distinguishes it from the general clause below,
   which subsumes it (map/apply already walks into a product's trig factor
   the same way), so it would be an optimisation this plan does not need
   (brief resolution 3). */
%mr_deactivateTrig(u, x) := block([],
  %mr_unifyInertTrigFunction(%mr_fixInertTrigFunction(
    %mr_deactivateTrigAux(u, x), x), x))$

/* ---- Task 7: FunctionOfTrigOfLinearQ + FunctionOfTrig -----------------
 * IntegrationUtilityFunctions.m L4357-4407 -- the bridge rule's condition
 * and its helper. '%mr_fot_null stands for Mathematica's Null: a value
 * distinct both from a returned linear form and from Maxima's `false`
 * (Mathematica's False), needed because the 3-arg walk below tracks THREE
 * states -- "nothing found yet" (Null, keep looking), "found and
 * consistent" (a linear form), "found and INCONSISTENT" (False, abort).
 * Faithful line-ports of the reference port in
 * probes/rubi/03-hyperbolic-miscellany-bridge.py's CLASSIFIER (23-case
 * SELFTEST, both controls holding over the class-6 corpus), with the
 * probe's three measured Maxima traps carried over: every bound name is
 * %mr_-prefixed (a block local or `for` variable named like the corpus's
 * own a/b/d/v/w captures it); `inflag:true` is bound around the two
 * recursive walks below so `op`/`args` read the internal Times/Power form
 * Rubi's own clauses are written against (op(2/(1+x)) is "/" without it,
 * and a walk keyed on "+"/"*"/"^" misses the Power[-1] structure); and
 * EqQ/coefficient tests go through the house %mr_eqQ/%mr_rationalQ ports
 * rather than a bare `is(... = 0)`, which is `unknown` (not false) for a
 * free symbolic coefficient and would make an `and` silently pass. */

/* Rubi FunctionOfTrig[u_,v_,x_] (L4374-4392), the 3-arg recursive walk.
 * The trig/hyperbolic merge branches read Coefficient[v,x,0/1] and
 * Coefficient[u[[1]],x,0/1] through %mr_coeff (the house Coefficient
 * port); the hyperbolic branch carries its argument as I*u[[1]] (the
 * imaginary-argument identity DeactivateTrig itself later undoes), the
 * trig branch bare -- merging a trig occurrence against a hyperbolic one
 * therefore gives b/d = 1/I = -I, which RationalQ rejects (the 2026-09-21
 * amendment's point: a trig head MIXED with a hyperbolic head is never
 * admitted). The generic recursion (CalculusQ excluded, else Scan into
 * args) uses a bare `return()` to break the `for` loop early once w has
 * gone False -- `return(value)` does not escape the enclosing block in
 * this build (2026-08-20 measurement, noted where %mr_rest_in et al. are
 * defined), but a BARE `return()` does break the loop, which is exactly
 * Rubi's Catch[Scan[...;Throw[False]]] short-circuit: once w is False, no
 * further argument may revive it (a later merge against a False `v` is
 * not a Rubi state that can occur, since the loop never reaches it). */
%mr_functionOfTrig3(%mr_fot_u, %mr_fot_v, %mr_fot_x) := block(
  [inflag : true, %mr_fot_w, %mr_fot_k,
   %mr_fot_a, %mr_fot_b, %mr_fot_c, %mr_fot_d, %mr_fot_q],
  if atom(%mr_fot_u) then
    (if is(%mr_fot_u = %mr_fot_x) then false else %mr_fot_v)
  elseif %mr_trigQ(%mr_fot_u) and %mr_linearQ(part(%mr_fot_u, 1), %mr_fot_x) then
    (if is(%mr_fot_v = '%mr_fot_null) then part(%mr_fot_u, 1)
     else (
       %mr_fot_a : %mr_coeff(%mr_fot_v, %mr_fot_x, 0),
       %mr_fot_b : %mr_coeff(%mr_fot_v, %mr_fot_x, 1),
       %mr_fot_c : %mr_coeff(part(%mr_fot_u, 1), %mr_fot_x, 0),
       %mr_fot_d : %mr_coeff(part(%mr_fot_u, 1), %mr_fot_x, 1),
       %mr_fot_q : %mr_fot_b / %mr_fot_d,
       if %mr_eqQ(%mr_fot_a*%mr_fot_d - %mr_fot_b*%mr_fot_c, 0)
           and %mr_rationalQ(%mr_fot_q)
         then %mr_fot_a/num(%mr_fot_q) + %mr_fot_b*%mr_fot_x/num(%mr_fot_q)
         else false))
  elseif %mr_hyperbolicQ(%mr_fot_u) and %mr_linearQ(part(%mr_fot_u, 1), %mr_fot_x) then
    (if is(%mr_fot_v = '%mr_fot_null) then %i*part(%mr_fot_u, 1)
     else (
       %mr_fot_a : %mr_coeff(%mr_fot_v, %mr_fot_x, 0),
       %mr_fot_b : %mr_coeff(%mr_fot_v, %mr_fot_x, 1),
       %mr_fot_c : %i*%mr_coeff(part(%mr_fot_u, 1), %mr_fot_x, 0),
       %mr_fot_d : %i*%mr_coeff(part(%mr_fot_u, 1), %mr_fot_x, 1),
       %mr_fot_q : %mr_fot_b / %mr_fot_d,
       if %mr_eqQ(%mr_fot_a*%mr_fot_d - %mr_fot_b*%mr_fot_c, 0)
           and %mr_rationalQ(%mr_fot_q)
         then %mr_fot_a/num(%mr_fot_q) + %mr_fot_b*%mr_fot_x/num(%mr_fot_q)
         else false))
  elseif %mr_calculusQ(%mr_fot_u) then false
  else (
    %mr_fot_w : %mr_fot_v,
    for %mr_fot_k in args(%mr_fot_u) do (
      %mr_fot_w : %mr_functionOfTrig3(%mr_fot_k, %mr_fot_w, %mr_fot_x),
      if is(%mr_fot_w = false) then return()
    ),
    %mr_fot_w))$

/* Rubi AlgebraicTrigFunctionQ[u_,x_Symbol] (L4396-4407): u built from
 * atoms, trig/hyperbolic functions of a linear argument, a power whose
 * exponent is free of x, and Times/Plus over such pieces. */
%mr_algebraicTrigFunctionQ(%mr_atfq_u, %mr_atfq_x) := block(
  [inflag : true, %mr_atfq_k, %mr_atfq_r],
  if atom(%mr_atfq_u) then true
  elseif %mr_trigQ(%mr_atfq_u) and %mr_linearQ(part(%mr_atfq_u, 1), %mr_atfq_x) then true
  elseif %mr_hyperbolicQ(%mr_atfq_u) and %mr_linearQ(part(%mr_atfq_u, 1), %mr_atfq_x) then true
  elseif op(%mr_atfq_u) = "^" and freeof(%mr_atfq_x, part(%mr_atfq_u, 2)) then
    %mr_algebraicTrigFunctionQ(part(%mr_atfq_u, 1), %mr_atfq_x)
  elseif op(%mr_atfq_u) = "*" or op(%mr_atfq_u) = "+" then (
    %mr_atfq_r : true,
    for %mr_atfq_k in args(%mr_atfq_u) do
      if not %mr_algebraicTrigFunctionQ(%mr_atfq_k, %mr_atfq_x) then %mr_atfq_r : false,
    %mr_atfq_r)
  else false)$

/* Rubi FunctionOfTrigOfLinearQ branch 1 (L4358-4361), the MatchQ half:
 *   MatchQ[u, (c_.+d_.*x)^m_.*(a_.+b_.*trig_[e_.+f_.*x])^n_.
 *     /; FreeQ[{a,b,c,d,e,f,m,n},x] && (TrigQ[trig] || HyperbolicQ[trig])]
 * trig_ is a HEAD-position pattern variable: MR-MATCH supports this
 * directly -- a pattern's own head may itself be a (Pattern ...) node,
 * and mr-match:m1's generic clause recurses the pattern head against
 * (car expr), the same mechanism the 6.7.6/6.7.7/6.7.9 F_[v_] rules
 * already exercise (grep '((Pattern' rules/). The bound value comes back
 * through mr-binding-value/%mr_mk as the MAXIMA VERB the matched head
 * reads as: `sin`, `cosh`, ... for an ACTIVE call, or `%mr_isin`, ... for
 * an INERT one -- the tree's head table keeps the inert names disjoint
 * from the active ones (maxima_rubi_tree.lisp +functions+: "Sin" -> sin
 * for an active call vs "sin" -> %mr_isin for the inert tree head), so an
 * inert head can never satisfy TrigQ or HyperbolicQ here and this branch
 * cannot make deactivation recurse. */
%mr_fotlq_branch1(%mr_fotlq1_u, %mr_fotlq1_x) := %mr_matchQ(%mr_fotlq1_u,
  sconcat("(Times ",
          "(Power (Plus (Optional (Pattern |_mr_fotlq1_c| (Blank))) ",
          "(Times (Optional (Pattern |_mr_fotlq1_d| (Blank))) (MRArg 1))) ",
          "(Optional (Pattern |_mr_fotlq1_m| (Blank)))) ",
          "(Power (Plus (Optional (Pattern |_mr_fotlq1_a| (Blank))) ",
          "(Times (Optional (Pattern |_mr_fotlq1_b| (Blank))) ",
          "((Pattern |_mr_fotlq1_trig| (Blank)) ",
          "(Plus (Optional (Pattern |_mr_fotlq1_e| (Blank))) ",
          "(Times (Optional (Pattern |_mr_fotlq1_f| (Blank))) (MRArg 1)))))) ",
          "(Optional (Pattern |_mr_fotlq1_n| (Blank)))))"),
  [%mr_fotlq1_x],
  lambda([%mr_mqb],
    freeof(%mr_fotlq1_x, %mr_mk(_mr_fotlq1_a, %mr_mqb))
    and freeof(%mr_fotlq1_x, %mr_mk(_mr_fotlq1_b, %mr_mqb))
    and freeof(%mr_fotlq1_x, %mr_mk(_mr_fotlq1_c, %mr_mqb))
    and freeof(%mr_fotlq1_x, %mr_mk(_mr_fotlq1_d, %mr_mqb))
    and freeof(%mr_fotlq1_x, %mr_mk(_mr_fotlq1_e, %mr_mqb))
    and freeof(%mr_fotlq1_x, %mr_mk(_mr_fotlq1_f, %mr_mqb))
    and freeof(%mr_fotlq1_x, %mr_mk(_mr_fotlq1_m, %mr_mqb))
    and freeof(%mr_fotlq1_x, %mr_mk(_mr_fotlq1_n, %mr_mqb))
    and (%mr_trigQ(%mr_mk(_mr_fotlq1_trig, %mr_mqb))
         or %mr_hyperbolicQ(%mr_mk(_mr_fotlq1_trig, %mr_mqb)))))$

/* Rubi FunctionOfTrigOfLinearQ[u_,x_Symbol] (L4358-4361): branch 1 above,
 * or branch 2 -- FunctionOfTrig[u,Null,x] finds a consistent linear
 * argument AND u is algebraic in the trig functions of it. This is the
 * bridge rule's condition (Int[u_,x_Symbol] := Int[DeactivateTrig[u,x],x]
 * /; FunctionOfTrigOfLinearQ[u,x]), a bare u_ at the END of section 4's
 * table -- a wrong TRUE here is a deactivation loop or a swallowed
 * integrand, not a wrong answer.
 *
 * Branch 2 calls the 3-arg FunctionOfTrig DIRECTLY on the RAW u, WITHOUT
 * activating it first (contrast %mr_functionOfTrig below, which does
 * activate). Tracing why through the source: for u = %mr_isin(x) (an
 * inert call, already deactivated), %mr_isin is neither TrigQ nor
 * HyperbolicQ (the ACTIVE-head lists), nor CalculusQ, so the walk falls
 * to the generic Scan over u's own args -- here just {x}. Recursing into
 * the bare argument x hits the walk's FIRST clause, AtomQ[u] with
 * u===x, which is False by definition (L4375: `If[u===x, False, v]`) --
 * independent of what v was. That False poisons the Scan (the early-exit
 * `return()` above) and %mr_functionOfTrigOfLinearQ(%mr_isin(x), x) comes
 * back false: an already-inert expression can never satisfy the bridge's
 * condition a second time, whatever its argument. */
%mr_functionOfTrigOfLinearQ(%mr_fotlq_u, %mr_fotlq_x) := block([%mr_fotlq_v],
  if %mr_fotlq_branch1(%mr_fotlq_u, %mr_fotlq_x) then true
  else (
    %mr_fotlq_v : %mr_functionOfTrig3(%mr_fotlq_u, '%mr_fot_null, %mr_fotlq_x),
    not (is(%mr_fotlq_v = '%mr_fot_null) or is(%mr_fotlq_v = false))
      and %mr_algebraicTrigFunctionQ(%mr_fotlq_u, %mr_fotlq_x)))$

/* Rubi FunctionOfTrig[u_,x_Symbol] (L4365-4367): ActivateTrig[u] FIRST,
 * then the 3-arg walk with v = Null; Null maps to False. This is the
 * substitution records' locator (Tasks 9-10), used AFTER deactivation, on
 * expressions that may already carry a just-deactivated (now
 * re-activated) trig factor -- distinct from FunctionOfTrigOfLinearQ's
 * own 3-arg call above, which must not itself activate: the bridge
 * condition runs BEFORE anything has been deactivated. */
%mr_functionOfTrig(%mr_fot2_u, %mr_fot2_x) := block([%mr_fot2_v],
  %mr_fot2_v : %mr_functionOfTrig3(%mr_activateTrig(%mr_fot2_u),
                                    '%mr_fot_null, %mr_fot2_x),
  if is(%mr_fot2_v = '%mr_fot_null) then false else %mr_fot2_v)$

/* ---- Task 9: FunctionOfQ (circular-trig branches) and SubstFor's trig
 * branch -- the utilities the bridge's 4.7.5 substitution records CALL.
 * IntegrationUtilityFunctions.m L4443-4700 (FunctionOfQ and its trig
 * predicates), L4895-4924 (FindTrigFactor and the quotient tests),
 * L5980-6038 (SubstFor, SubstForTrig). The plan's Task 9 interface list
 * named only DeactivateTrig/FunctionOfTrig/FreeFactors/Subst; the five
 * emitted 4.7.5 records' conds also call FunctionOfQ and their repls
 * SubstFor[.., Trig[v]/d, ..] -- without these two the records can never
 * accept and the bridge's deactivated integrand has nowhere to go
 * (measured: rubi returned -%i*'unintegrable[%mr_isin(..)*..] for the
 * 6.1.7 acceptance integrand). Ported under the plan's own rule: the
 * records' callees come with the records.
 *
 * DEVIATIONS (stamped; (a) declines, (b) is unreachable, (c) accepts):
 *  (a) FunctionOfQ's HYPERBOLIC head branches (Sinh..Csch ->
 *      FunctionOfSinhQ.. / PureFunctionOfSinhQ..) and its default branch
 *      (FunctionOfExpnQ) are NOT ported: FunctionOfQ answers false there,
 *      so the calling record declines. The 4.7.5 records only ever pass
 *      NonfreeFactors[Trig[v],x] with a circular head -- EXCEPT where
 *      Maxima's own simplifier turns the head hyperbolic: cos(%i*z) ->
 *      cosh(z), sin(%i*z) -> %i*sinh(z) (an argument that is a single
 *      %i*product, i.e. a hyperbolic integrand with NO constant term, c=0).
 *      Those integrands decline here; Mathematica takes the same turn and
 *      Rubi answers them through the hyperbolic branches.
 *  (b) SubstFor's trig branch covers Sin/Cos/Tan/Cot -- the four heads
 *      the six bridge records pass. Sec/Csc and the six hyperbolic heads
 *      fall through to the pre-existing algebraic port below. UNREACHABLE
 *      from the ported records (none passes such a head); if it were
 *      reached it would NOT decline -- it would mis-substitute, through
 *      the algebraic port's plain subst.
 *  (c) FunctionOfSinQ's and SubstForTrig's "u[[1]] is Cos[v/2], u[[2]] is
 *      Sin[v/2]" test reads the FIRST TWO factors of Mathematica's
 *      canonical product order; Maxima orders factors differently, so the
 *      port looks for the pair ANYWHERE among the product's factors. This
 *      is an ACCEPT direction: it can admit a product Rubi's positional
 *      test would not, and the result is value-correct (Cos[v/2] Sin[v/2]
 *      = Sin[v]/2 wherever the pair sits).
 *
 * Every bound name is %mr_-prefixed (the capture trap: a block local
 * named like a corpus symbol -- the acceptance integrand's own a, b, c, d
 * -- captures it). inflag:true is bound where op/args/part walk the
 * expression, so a quotient reads as Times[.., Power[.., -1]] as in the
 * .m (the Task-7 note above). */

/* Rubi IntegerQuotientQ / OddQuotientQ / EvenQuotientQ (L4911-4922):
   IntegerQ/OddQ/EvenQ of Simplify[u/v]; ratsimp is the house Simplify
   for a quotient of two linear forms. */
%mr_integerQuotientQ(%mr_iqq_u, %mr_iqq_v) :=
  integerp(ratsimp(%mr_iqq_u/%mr_iqq_v))$
%mr_oddQuotientQ(%mr_iqq_u, %mr_iqq_v) := block([%mr_iqq_q],
  %mr_iqq_q : ratsimp(%mr_iqq_u/%mr_iqq_v),
  integerp(%mr_iqq_q) and oddp(%mr_iqq_q))$
%mr_evenQuotientQ(%mr_iqq_u, %mr_iqq_v) := block([%mr_iqq_q],
  %mr_iqq_q : ratsimp(%mr_iqq_u/%mr_iqq_v),
  integerp(%mr_iqq_q) and evenp(%mr_iqq_q))$

/* Rubi FindTrigFactor[func1,func2,u,v,flag] (L4896-4906): the first
   factor func[w]^m of u (m odd, w an integer multiple of v, and w # v
   unless flag) as [w, u/func[w]^m]; false if none. The .m walks
   LeadFactor/RemainingFactors, i.e. the product's factors in order. A
   non-product u is its own single factor: when it is func[w]^m itself the
   answer is [w, 1] (the .m's {LeadBase[u][[1]], RemainingFactors[u]},
   RemainingFactors of a non-product being 1; the port's u/u), otherwise
   False (the .m recurses on RemainingFactors[u] = 1, which is False). */
%mr_findTrigFactor(%mr_ftf_f1, %mr_ftf_f2, %mr_ftf_u, %mr_ftf_v, %mr_ftf_flag) :=
  block([inflag : true, %mr_ftf_k, %mr_ftf_b, %mr_ftf_e, %mr_ftf_r],
  %mr_ftf_r : false,
  for %mr_ftf_k in (if not atom(%mr_ftf_u) and op(%mr_ftf_u) = "*"
                    then args(%mr_ftf_u) else [%mr_ftf_u]) do (
    if %mr_ftf_r = false then (
      if not atom(%mr_ftf_k) and op(%mr_ftf_k) = "^"
      then (%mr_ftf_b : part(%mr_ftf_k, 1), %mr_ftf_e : part(%mr_ftf_k, 2))
      else (%mr_ftf_b : %mr_ftf_k, %mr_ftf_e : 1),
      if not atom(%mr_ftf_b)
         and (op(%mr_ftf_b) = %mr_ftf_f1 or op(%mr_ftf_b) = %mr_ftf_f2)
         and integerp(%mr_ftf_e) and oddp(%mr_ftf_e)
         and %mr_integerQuotientQ(part(%mr_ftf_b, 1), %mr_ftf_v)
         and (%mr_ftf_flag or %mr_neQ(part(%mr_ftf_b, 1), %mr_ftf_v))
      then %mr_ftf_r : [part(%mr_ftf_b, 1), %mr_ftf_u/%mr_ftf_k])),
  %mr_ftf_r)$

/* Rubi's Catch[Scan[If[Not[P[#,v,x]], Throw[False]]], u]; True] -- P over
   every level-1 part of u (a Power's base AND exponent included). */
%mr_foq_all(%mr_foq_p, %mr_foq_u, %mr_foq_v, %mr_foq_x) :=
  block([inflag : true, %mr_foq_k, %mr_foq_r],
  %mr_foq_r : true,
  for %mr_foq_k in args(%mr_foq_u) do
    if %mr_foq_r and not %mr_foq_p(%mr_foq_k, %mr_foq_v, %mr_foq_x)
    then %mr_foq_r : false,
  %mr_foq_r)$

/* The (Cos[v/2], Sin[v/2]) factor pair of FunctionOfSinQ / SubstForTrig:
   u with the pair removed, or false (deviation (c) above). */
%mr_foq_halfPair(%mr_hp_u, %mr_hp_v) := block([inflag : true, %mr_hp_c, %mr_hp_s, %mr_hp_k],
  %mr_hp_c : false, %mr_hp_s : false,
  if atom(%mr_hp_u) or op(%mr_hp_u) # "*" then false
  else (
    for %mr_hp_k in args(%mr_hp_u) do (
      if not atom(%mr_hp_k) and op(%mr_hp_k) = cos and %mr_hp_c = false
         and %mr_eqQ(part(%mr_hp_k, 1), %mr_hp_v/2) then %mr_hp_c : %mr_hp_k,
      if not atom(%mr_hp_k) and op(%mr_hp_k) = sin and %mr_hp_s = false
         and %mr_eqQ(part(%mr_hp_k, 1), %mr_hp_v/2) then %mr_hp_s : %mr_hp_k),
    if %mr_hp_c = false or %mr_hp_s = false then false
    else %mr_hp_u/(%mr_hp_c*%mr_hp_s)))$

/* Rubi PureFunctionOfSinQ/CosQ/TanQ/CotQ (L4524-4565): u built only from
   Trig[v] with the named heads (EqQ on the argument, not a multiple). */
%mr_pureFunctionOfTrigQ(%mr_pft_heads, %mr_pft_u, %mr_pft_v, %mr_pft_x) :=
  block([inflag : true, %mr_pft_k, %mr_pft_r],
  if atom(%mr_pft_u) then is(not(%mr_pft_u = %mr_pft_x))
  elseif %mr_calculusQ(%mr_pft_u) then false
  elseif %mr_trigQ(%mr_pft_u) and %mr_eqQ(part(%mr_pft_u, 1), %mr_pft_v)
  then is(member(op(%mr_pft_u), %mr_pft_heads) = true)
  else (
    %mr_pft_r : true,
    for %mr_pft_k in args(%mr_pft_u) do
      if %mr_pft_r and not %mr_pureFunctionOfTrigQ(%mr_pft_heads, %mr_pft_k,
                                                   %mr_pft_v, %mr_pft_x)
      then %mr_pft_r : false,
    %mr_pft_r))$

/* Rubi FunctionOfSinQ[u,v,x] (L4572-4606). */
%mr_functionOfSinQ(%mr_fsq_u, %mr_fsq_v, %mr_fsq_x) :=
  block([inflag : true, %mr_fsq_l, %mr_fsq_h],
  if atom(%mr_fsq_u) then is(not(%mr_fsq_u = %mr_fsq_x))
  elseif %mr_calculusQ(%mr_fsq_u) then false
  elseif %mr_trigQ(%mr_fsq_u) and %mr_integerQuotientQ(part(%mr_fsq_u, 1), %mr_fsq_v) then (
    if %mr_oddQuotientQ(part(%mr_fsq_u, 1), %mr_fsq_v)
    then is(member(op(%mr_fsq_u), [sin, csc]) = true)
    else is(member(op(%mr_fsq_u), [cos, sec]) = true))
  elseif %mr_integerPowerQ(%mr_fsq_u) and %mr_trigQ(part(%mr_fsq_u, 1))
         and %mr_integerQuotientQ(part(%mr_fsq_u, 1, 1), %mr_fsq_v) then (
    if evenp(part(%mr_fsq_u, 2)) then true
    else %mr_functionOfSinQ(part(%mr_fsq_u, 1), %mr_fsq_v, %mr_fsq_x))
  elseif %mr_productQ(%mr_fsq_u) then (
    %mr_fsq_h : %mr_foq_halfPair(%mr_fsq_u, %mr_fsq_v),
    if %mr_fsq_h # false then %mr_functionOfSinQ(%mr_fsq_h, %mr_fsq_v, %mr_fsq_x)
    else (
      %mr_fsq_l : %mr_findTrigFactor(sin, csc, %mr_fsq_u, %mr_fsq_v, false),
      if listp(%mr_fsq_l) and %mr_evenQuotientQ(first(%mr_fsq_l), %mr_fsq_v)
      then %mr_functionOfSinQ(cos(%mr_fsq_v)*second(%mr_fsq_l), %mr_fsq_v, %mr_fsq_x)
      else (
        %mr_fsq_l : %mr_findTrigFactor(cos, sec, %mr_fsq_u, %mr_fsq_v, false),
        if listp(%mr_fsq_l) and %mr_oddQuotientQ(first(%mr_fsq_l), %mr_fsq_v)
        then %mr_functionOfSinQ(cos(%mr_fsq_v)*second(%mr_fsq_l), %mr_fsq_v, %mr_fsq_x)
        else (
          %mr_fsq_l : %mr_findTrigFactor(tan, cot, %mr_fsq_u, %mr_fsq_v, true),
          if listp(%mr_fsq_l)
          then %mr_functionOfSinQ(cos(%mr_fsq_v)*second(%mr_fsq_l), %mr_fsq_v, %mr_fsq_x)
          else %mr_foq_all(%mr_functionOfSinQ, %mr_fsq_u, %mr_fsq_v, %mr_fsq_x)))))
  else %mr_foq_all(%mr_functionOfSinQ, %mr_fsq_u, %mr_fsq_v, %mr_fsq_x))$

/* Rubi FunctionOfCosQ[u,v,x] (L4609-4634). */
%mr_functionOfCosQ(%mr_fcq_u, %mr_fcq_v, %mr_fcq_x) :=
  block([inflag : true, %mr_fcq_l],
  if atom(%mr_fcq_u) then is(not(%mr_fcq_u = %mr_fcq_x))
  elseif %mr_calculusQ(%mr_fcq_u) then false
  elseif %mr_trigQ(%mr_fcq_u) and %mr_integerQuotientQ(part(%mr_fcq_u, 1), %mr_fcq_v)
  then is(member(op(%mr_fcq_u), [cos, sec]) = true)
  elseif %mr_integerPowerQ(%mr_fcq_u) and %mr_trigQ(part(%mr_fcq_u, 1))
         and %mr_integerQuotientQ(part(%mr_fcq_u, 1, 1), %mr_fcq_v) then (
    if evenp(part(%mr_fcq_u, 2)) then true
    else %mr_functionOfCosQ(part(%mr_fcq_u, 1), %mr_fcq_v, %mr_fcq_x))
  elseif %mr_productQ(%mr_fcq_u) then (
    %mr_fcq_l : %mr_findTrigFactor(sin, csc, %mr_fcq_u, %mr_fcq_v, false),
    if listp(%mr_fcq_l)
    then %mr_functionOfCosQ(sin(%mr_fcq_v)*second(%mr_fcq_l), %mr_fcq_v, %mr_fcq_x)
    else (
      %mr_fcq_l : %mr_findTrigFactor(tan, cot, %mr_fcq_u, %mr_fcq_v, true),
      if listp(%mr_fcq_l)
      then %mr_functionOfCosQ(sin(%mr_fcq_v)*second(%mr_fcq_l), %mr_fcq_v, %mr_fcq_x)
      else %mr_foq_all(%mr_functionOfCosQ, %mr_fcq_u, %mr_fcq_v, %mr_fcq_x)))
  else %mr_foq_all(%mr_functionOfCosQ, %mr_fcq_u, %mr_fcq_v, %mr_fcq_x))$

/* Rubi FunctionOfTanQ[u,v,x] (L4637-4652). */
%mr_functionOfTanQ(%mr_ftq_u, %mr_ftq_v, %mr_ftq_x) :=
  block([inflag : true, %mr_ftq_l, %mr_ftq_k],
  if atom(%mr_ftq_u) then is(not(%mr_ftq_u = %mr_ftq_x))
  elseif %mr_calculusQ(%mr_ftq_u) then false
  elseif %mr_trigQ(%mr_ftq_u) and %mr_integerQuotientQ(part(%mr_ftq_u, 1), %mr_ftq_v)
  then is(member(op(%mr_ftq_u), [tan, cot]) = true)
       or %mr_evenQuotientQ(part(%mr_ftq_u, 1), %mr_ftq_v)
  elseif %mr_powerQ(%mr_ftq_u) and evenp(part(%mr_ftq_u, 2))
         and %mr_trigQ(part(%mr_ftq_u, 1))
         and %mr_integerQuotientQ(part(%mr_ftq_u, 1, 1), %mr_ftq_v) then true
  elseif %mr_powerQ(%mr_ftq_u) and evenp(part(%mr_ftq_u, 2))
         and %mr_sumQ(part(%mr_ftq_u, 1))
  then %mr_functionOfTanQ(expand(part(%mr_ftq_u, 1)^2), %mr_ftq_v, %mr_ftq_x)
  elseif %mr_productQ(%mr_ftq_u) then (
    %mr_ftq_l : sublist(args(%mr_ftq_u),
                        lambda([%mr_ftq_k],
                               not %mr_functionOfTanQ(%mr_ftq_k, %mr_ftq_v, %mr_ftq_x))),
    if %mr_ftq_l = [] then true
    else is(length(%mr_ftq_l) = 2)
         and %mr_oddTrigPowerQ(first(%mr_ftq_l), %mr_ftq_v, %mr_ftq_x)
         and %mr_oddTrigPowerQ(second(%mr_ftq_l), %mr_ftq_v, %mr_ftq_x))
  else %mr_foq_all(%mr_functionOfTanQ, %mr_ftq_u, %mr_ftq_v, %mr_ftq_x))$

/* Rubi OddTrigPowerQ[u,v,x] (L4655-4669). */
%mr_oddTrigPowerQ(%mr_otp_u, %mr_otp_v, %mr_otp_x) :=
  block([inflag : true, %mr_otp_l, %mr_otp_k],
  if atom(%mr_otp_u) then false
  elseif is(member(op(%mr_otp_u), [sin, cos, sec, csc]) = true)
  then %mr_oddQuotientQ(part(%mr_otp_u, 1), %mr_otp_v)
  elseif %mr_powerQ(%mr_otp_u)
  then integerp(part(%mr_otp_u, 2)) and oddp(part(%mr_otp_u, 2))
       and %mr_oddTrigPowerQ(part(%mr_otp_u, 1), %mr_otp_v, %mr_otp_x)
  elseif %mr_productQ(%mr_otp_u) then (
    if %mr_neQ(%mr_freeFactors(%mr_otp_u, %mr_otp_x), 1)
    then %mr_oddTrigPowerQ(%mr_nonfreeFactors(%mr_otp_u, %mr_otp_x), %mr_otp_v, %mr_otp_x)
    else (
      %mr_otp_l : sublist(args(%mr_otp_u),
                          lambda([%mr_otp_k],
                                 not %mr_functionOfTanQ(%mr_otp_k, %mr_otp_v, %mr_otp_x))),
      if %mr_otp_l = [] then true
      else is(length(%mr_otp_l) = 1)
           and %mr_oddTrigPowerQ(first(%mr_otp_l), %mr_otp_v, %mr_otp_x)))
  elseif %mr_sumQ(%mr_otp_u)
  then %mr_foq_all(%mr_oddTrigPowerQ, %mr_otp_u, %mr_otp_v, %mr_otp_x)
  else false)$

/* Rubi FunctionOfQ[v,u,x,PureFlag:False] (L4443-4481): is u a function
   of v? The optional 4th argument is PureFlag. Circular-trig heads only
   (deviation (a) above). */
%mr_functionOfQ(%mr_foq_v, %mr_foq_u, %mr_foq_x, [%mr_foq_opt]) :=
  block([inflag : true, %mr_foq_pure, %mr_foq_h, %mr_foq_w],
  %mr_foq_pure : is(length(%mr_foq_opt) > 0 and first(%mr_foq_opt) = true),
  if freeof(%mr_foq_x, %mr_foq_u) then false
  elseif atom(%mr_foq_v) then true
  elseif not %mr_inertTrigFreeQ(%mr_foq_u)
  then %mr_functionOfQ(%mr_foq_v, %mr_activateTrig(%mr_foq_u), %mr_foq_x, %mr_foq_pure)
  elseif %mr_productQ(%mr_foq_v) and %mr_neQ(%mr_freeFactors(%mr_foq_v, %mr_foq_x), 1)
  then %mr_functionOfQ(%mr_nonfreeFactors(%mr_foq_v, %mr_foq_x), %mr_foq_u, %mr_foq_x,
                       %mr_foq_pure)
  elseif not %mr_trigQ(%mr_foq_v) then false
  else (
    %mr_foq_h : op(%mr_foq_v),
    %mr_foq_w : part(%mr_foq_v, 1),
    if %mr_foq_pure then (
      if %mr_foq_h = sin or %mr_foq_h = csc
      then %mr_pureFunctionOfTrigQ([sin, csc], %mr_foq_u, %mr_foq_w, %mr_foq_x)
      elseif %mr_foq_h = cos or %mr_foq_h = sec
      then %mr_pureFunctionOfTrigQ([cos, sec], %mr_foq_u, %mr_foq_w, %mr_foq_x)
      elseif %mr_foq_h = tan
      then %mr_pureFunctionOfTrigQ([tan, cot], %mr_foq_u, %mr_foq_w, %mr_foq_x)
      else %mr_pureFunctionOfTrigQ([cot], %mr_foq_u, %mr_foq_w, %mr_foq_x))
    else (
      if %mr_foq_h = sin or %mr_foq_h = csc
      then %mr_functionOfSinQ(%mr_foq_u, %mr_foq_w, %mr_foq_x)
      elseif %mr_foq_h = cos or %mr_foq_h = sec
      then %mr_functionOfCosQ(%mr_foq_u, %mr_foq_w, %mr_foq_x)
      else %mr_functionOfTanQ(%mr_foq_u, %mr_foq_w, %mr_foq_x))))$

/* Rubi SubstForTrig[u,sin,cos,v,x] (L6019-6029): u, a function of
   Trig[v], with Sin[v] -> sin, Cos[v] -> cos. A multiple angle
   Trig[k v] is TrigExpand'ed first (%mr_sft_y is the expansion's dummy
   variable, the .m's x). */
%mr_substForTrig(%mr_sft_u, %mr_sft_s, %mr_sft_c, %mr_sft_v) :=
  block([inflag : true, %mr_sft_h, %mr_sft_t, %mr_sft_p],
  if atom(%mr_sft_u) then %mr_sft_u
  elseif %mr_trigQ(%mr_sft_u) and %mr_integerQuotientQ(part(%mr_sft_u, 1), %mr_sft_v) then (
    %mr_sft_h : op(%mr_sft_u),
    if %mr_eqQ(part(%mr_sft_u, 1), %mr_sft_v) then (
      if %mr_sft_h = sin then %mr_sft_s
      elseif %mr_sft_h = cos then %mr_sft_c
      elseif %mr_sft_h = tan then %mr_sft_s/%mr_sft_c
      elseif %mr_sft_h = cot then %mr_sft_c/%mr_sft_s
      elseif %mr_sft_h = sec then 1/%mr_sft_c
      else 1/%mr_sft_s)
    else (
      %mr_sft_t : subst(%mr_sft_v, '%mr_sft_y,
                        trigexpand(apply(%mr_sft_h,
                          [ratsimp(part(%mr_sft_u, 1)/%mr_sft_v)*'%mr_sft_y]))),
      if atom(%mr_sft_t) then %mr_sft_t
      else apply(op(%mr_sft_t),
                 map(lambda([%mr_sft_p],
                            %mr_substForTrig(%mr_sft_p, %mr_sft_s, %mr_sft_c, %mr_sft_v)),
                     args(%mr_sft_t)))))
  else (
    %mr_sft_t : %mr_foq_halfPair(%mr_sft_u, %mr_sft_v),
    if %mr_sft_t # false
    then %mr_sft_s/2*%mr_substForTrig(%mr_sft_t, %mr_sft_s, %mr_sft_c, %mr_sft_v)
    else apply(op(%mr_sft_u),
               map(lambda([%mr_sft_p],
                          %mr_substForTrig(%mr_sft_p, %mr_sft_s, %mr_sft_c, %mr_sft_v)),
                   args(%mr_sft_u)))))$

/* Rubi SubstFor[v,u,x]'s FreeFactors + Switch[Head[v], Sin|Cos|Tan|Cot]
   arms (L5980-5998), for v whose non-free part is one of those four heads
   (deviation (b)): SubstFor[NonfreeFactors[v,x], u, x/FreeFactors[v,x]]
   with the head's (sin, cos) pair in that scaled variable. */
%mr_substForTrigHead(%mr_sfh_v, %mr_sfh_u, %mr_sfh_x) :=
  block([inflag : true, %mr_sfh_w, %mr_sfh_y, %mr_sfh_h, %mr_sfh_a],
  %mr_sfh_w : %mr_nonfreeFactors(%mr_sfh_v, %mr_sfh_x),
  %mr_sfh_y : %mr_sfh_x/%mr_freeFactors(%mr_sfh_v, %mr_sfh_x),
  %mr_sfh_h : op(%mr_sfh_w),
  %mr_sfh_a : part(%mr_sfh_w, 1),
  if %mr_sfh_h = sin
  then %mr_substForTrig(%mr_sfh_u, %mr_sfh_y, sqrt(1 - %mr_sfh_y^2), %mr_sfh_a)
  elseif %mr_sfh_h = cos
  then %mr_substForTrig(%mr_sfh_u, sqrt(1 - %mr_sfh_y^2), %mr_sfh_y, %mr_sfh_a)
  elseif %mr_sfh_h = tan
  then %mr_substForTrig(%mr_sfh_u, %mr_sfh_y/sqrt(1 + %mr_sfh_y^2),
                        1/sqrt(1 + %mr_sfh_y^2), %mr_sfh_a)
  else %mr_substForTrig(%mr_sfh_u, 1/sqrt(1 + %mr_sfh_y^2),
                        %mr_sfh_y/sqrt(1 + %mr_sfh_y^2), %mr_sfh_a))$

/* ---- Task 10 (inert-trig substrate): CalculusFreeQ and TryPureTanSubst
 * -- the two utilities 4.7.5's last three bridge records call and nothing
 * in the port defined:
 *   TryPureTanSubst: the conditions of r21/r22 (the Cot/Tan substitution
 *     records, 4.7.5.m L24/L25), which declined on the unbound call from
 *     Task 9 until this port -- porting it makes them LIVE;
 *   CalculusFreeQ: the inner condition of r71 (L74, the half-angle
 *     Weierstrass substitution), CalculusFreeQ[w, x] on the trial
 *     integral w.
 * SubstFor needs nothing new for r71: its v is Tan[v/2]/d, served by the
 * Tan arm Task 9 ported (%mr_substForTrigHead).
 *
 * r71 also carries Block[{$ShowSteps = False, $StepCounter = Null}, Int[..]]
 * around that trial integral -- verbatim Rubi's IntHide body (L16-17). The
 * two globals drive the ShowSteps machinery (display of applied rules, and
 * a count of them; ShowStepRoutines.m L4, L225-239), which the port does
 * not have: the generator takes every rule's non-ShowSteps branch. Binding
 * them could change nothing a rule observes, so the generator emits the
 * Block's BODY alone, exactly as it maps IntHide to plain mr_int
 * (generate_rules.py translate(), "Block"; any other Block shape is a
 * generation error). There is no mr_ variable for them to bind, unlike
 * SimplifyFlag (mr_simplify_flag, line 11) and $UseGamma
 * (mr_use_gamma_flag), whose values rules do read.
 *
 * Every bound name is %mr_-prefixed (the capture trap). */

/* Rubi CalculusFreeQ[u,x] (IntegrationUtilityFunctions.m L338-344): u has
   no calculus function whose variable (part 2) is x. The CalculusQ list is
   %mr_calculusQ's (the package nouns, 'unintegrable[f, x] included -- the
   answer a failed nested mr_int gives -- and the integrate noun of the
   fall-through). HeldFormQ (Hold, HoldForm, Defer, Pattern) has no port
   analogue: the port builds no held values (%mr_hold is the identity), so
   that disjunct reads false. A Power is scanned base and exponent, as the
   .m's Scan over u. */
%mr_calculusFreeQ(%mr_cfq_u, %mr_cfq_x) :=
  block([inflag : true, %mr_cfq_k, %mr_cfq_r],
  if atom(%mr_cfq_u) then true
  elseif %mr_calculusQ(%mr_cfq_u) and is(length(%mr_cfq_u) >= 2)
         and is(part(%mr_cfq_u, 2) = %mr_cfq_x) then false
  else (
    %mr_cfq_r : true,
    for %mr_cfq_k in args(%mr_cfq_u) do
      if %mr_cfq_r and not %mr_calculusFreeQ(%mr_cfq_k, %mr_cfq_x)
      then %mr_cfq_r : false,
    %mr_cfq_r))$

/* Rubi TryPureTanSubst[u,x] (L6099-6108; the commented-out conjuncts of
   the .m are not live and are not ported):
     Not[MatchQ[u, F_[c_.*(a_.+b_.*G_[v_])] /; FreeQ[{a,b,c},x] &&
       MemberQ[{ArcTan,ArcCot,ArcTanh,ArcCoth},F] &&
       MemberQ[{Tan,Cot,Tanh,Coth},G] && LinearQ[v,x]]]
   The MatchQ is decided structurally rather than through MR-MATCH, with
   the pattern's Mathematica semantics spelled out: Times and Plus are
   flat, so c_. absorbs EVERY x-free factor of the argument and a_. every
   x-free term; the defaults are c = 1, a = 0, b = 1. The argument
   therefore matches iff it is (x-free factors) * S, where S is either
   b*G[v] (b x-free) or a sum whose terms are all x-free except exactly one
   b*G[v] -- or S is that sum itself / that term itself (c = 1). Any other
   x-dependent factor or term would have to go into a, b or c and fail
   FreeQ, so Mathematica's match fails too. No deviation. */
%mr_tpt_gq(%mr_tpt_g, %mr_tpt_x) := block([inflag : true],
  not atom(%mr_tpt_g)
  and is(member(op(%mr_tpt_g), [tan, cot, tanh, coth]) = true)
  and is(length(%mr_tpt_g) = 1)
  and %mr_linearQ(part(%mr_tpt_g, 1), %mr_tpt_x))$

/* The x-dependent factors of a product (a non-product is its own one
   factor). */
%mr_tpt_nonfree(%mr_tpt_t, %mr_tpt_x) := block([inflag : true],
  sublist(if not atom(%mr_tpt_t) and op(%mr_tpt_t) = "*"
          then args(%mr_tpt_t) else [%mr_tpt_t],
          lambda([%mr_tpt_f], not freeof(%mr_tpt_x, %mr_tpt_f))))$

/* b_.*G_[v_]: exactly one x-dependent factor, and it is G[v]. */
%mr_tpt_bg(%mr_tpt_t, %mr_tpt_x) := block([%mr_tpt_nf],
  %mr_tpt_nf : %mr_tpt_nonfree(%mr_tpt_t, %mr_tpt_x),
  is(length(%mr_tpt_nf) = 1) and %mr_tpt_gq(first(%mr_tpt_nf), %mr_tpt_x))$

/* a_.+b_.*G_[v_]: b*G[v] itself, or a sum with exactly one x-dependent
   term, that term b*G[v]. */
%mr_tpt_abg(%mr_tpt_s, %mr_tpt_x) := block([inflag : true, %mr_tpt_nt],
  if not atom(%mr_tpt_s) and op(%mr_tpt_s) = "+" then (
    %mr_tpt_nt : sublist(args(%mr_tpt_s),
                         lambda([%mr_tpt_q], not freeof(%mr_tpt_x, %mr_tpt_q))),
    is(length(%mr_tpt_nt) = 1) and %mr_tpt_bg(first(%mr_tpt_nt), %mr_tpt_x))
  else %mr_tpt_bg(%mr_tpt_s, %mr_tpt_x))$

/* c_.*(a_.+b_.*G_[v_]). */
%mr_tpt_arg(%mr_tpt_w, %mr_tpt_x) := block([%mr_tpt_nf],
  if %mr_tpt_abg(%mr_tpt_w, %mr_tpt_x) then true
  else (
    %mr_tpt_nf : %mr_tpt_nonfree(%mr_tpt_w, %mr_tpt_x),
    is(length(%mr_tpt_nf) = 1) and %mr_tpt_abg(first(%mr_tpt_nf), %mr_tpt_x)))$

%mr_tryPureTanSubst(%mr_tpt_u, %mr_tpt_x) := block([inflag : true],
  not (not atom(%mr_tpt_u)
       and is(member(op(%mr_tpt_u), [atan, acot, atanh, acoth]) = true)
       and is(length(%mr_tpt_u) = 1)
       and %mr_tpt_arg(part(%mr_tpt_u, 1), %mr_tpt_x)))$

/* ===================== section 9 (2026-09-22 A2.3) ====================
 * Rubi's UnsameQ (=!=): structural inequality. is(a = b) is Maxima's
 * SYNTACTIC identity of the simplified forms, which is what SameQ tests;
 * no ev, so no capture (spec 2026-09-22 A2.3). */
%mr_unsameQ(%mr_usq_a, %mr_usq_b) := not is(%mr_usq_a = %mr_usq_b)$

/* ===================== section 9 (2026-09-22 A1) ======================
 * Rubi :7430-7448 PiecewiseLinearQ / Divides -- 9.2's gate (all 19 of
 * 9.2's rules call PiecewiseLinearQ) and 9.3's Divides. */

/* Rubi :7434 F_[G_[v_]] pair table: MemberQ[{{ArcTanh,Tanh}, ...},{F,G}].
   Native atan/acot/atanh/acoth operator names -- NOT %mr_atanh (this
   file's line-3125 evaluating shim, unrelated to the native atanh/acoth
   Maxima binds and corpus integrands carry). */
%mr_plq_fgQ(%mr_plq_u, %mr_plq_x) := block([inflag : true, %mr_plq_g],
  if atom(%mr_plq_u) or not is(length(%mr_plq_u) = 1) then false
  else (
    %mr_plq_g : part(%mr_plq_u, 1),
    not atom(%mr_plq_g) and is(length(%mr_plq_g) = 1)
    and is(member([op(%mr_plq_u), op(%mr_plq_g)],
                  [[atanh, tanh], [atanh, coth], [acoth, coth], [acoth, tanh],
                   [atan, tan], [atan, cot], [acot, cot], [acot, tan]]) = true)
    and %mr_linearQ(part(%mr_plq_g, 1), %mr_plq_x)))$

/* Rubi :7434 F_^(v_): a kept power node (the line-3903 note: an
   exponent-1 or sqrt argument is stripped/re-headed before this sees
   it, matching the .m's own Power[F,v] requirement) with an x-free
   base and a linear exponent. */
%mr_plq_powFV(%mr_plq_p, %mr_plq_x) := block([inflag : true],
  %mr_powerQ(%mr_plq_p)
  and freeof(%mr_plq_x, part(%mr_plq_p, 1))
  and %mr_linearQ(part(%mr_plq_p, 2), %mr_plq_x))$

/* Rubi :7434 Log[c_.*F_^(v_)] /; FreeQ[{F,c},x] && LinearQ[v,x]: Times is
   flat, so c_. absorbs EVERY x-free factor of the log argument, and the
   match holds iff its x-dependent factors are exactly one F^v. The
   non-free-factors accounting is %mr_tpt_nonfree (line 6459, TryPureTanSubst's
   port, immediately above): it already binds inflag : true and prefixes
   its own locals/params, so it is called here rather than reimplemented
   (fix round 1, task review finding 1). */
%mr_plq_logArgQ(%mr_plq_w, %mr_plq_x) := block([%mr_plq_nf],
  %mr_plq_nf : %mr_tpt_nonfree(%mr_plq_w, %mr_plq_x),
  is(length(%mr_plq_nf) = 1) and %mr_plq_powFV(first(%mr_plq_nf), %mr_plq_x))$

/* Rubi :7434-7440 PiecewiseLinearQ[u,x], the 2-arg predicate: LinearQ,
   or the Log[c F^v] shape, or one of the eight F[G[v]] pairs. The .m's
   commented-out (* && Not[MonomialQ[u,x]] *) stays out -- not live
   upstream (task-2 brief step 3). */
%mr_plq_core(%mr_plq_u, %mr_plq_x) := block([inflag : true],
  %mr_linearQ(%mr_plq_u, %mr_plq_x)
  or (not atom(%mr_plq_u) and is(op(%mr_plq_u) = log)
      and is(length(%mr_plq_u) = 1)
      and %mr_plq_logArgQ(part(%mr_plq_u, 1), %mr_plq_x))
  or %mr_plq_fgQ(%mr_plq_u, %mr_plq_x))$

/* Rubi :7430-7433 PiecewiseLinearQ[u,x] / PiecewiseLinearQ[u,v,x]: one
   Maxima function with a rest argument, since Rubi overloads the name
   by arity. One rest element is the 2-arg form; two is (u,v,x) =
   plq(u,x) and plq(v,x). Any other rest length is a caller error, not a
   silent first()/second() failure on a short list (fix round 1, task
   review finding 2). */
%mr_piecewiseLinearQ(%mr_plq_u, [%mr_plq_r]) := block([%mr_plq_x],
  if length(%mr_plq_r) = 2 then (
    %mr_plq_x : second(%mr_plq_r),
    %mr_plq_core(%mr_plq_u, %mr_plq_x)
      and %mr_plq_core(first(%mr_plq_r), %mr_plq_x)
  )
  elseif length(%mr_plq_r) = 1 then (
    %mr_plq_x : first(%mr_plq_r),
    %mr_plq_core(%mr_plq_u, %mr_plq_x)
  )
  else error("%mr_piecewiseLinearQ: expected (u, x) or (u, v, x), got ",
             length(%mr_plq_r) + 1, " total argument(s)"))$

/* Rubi :7443-7448 Divides[y,u,x]: the quotient u/y when it is free of x,
   else False. %mr_simp is a pure rewrite of its argument (no ev), so
   capture trap 1 does not apply; x stays unprefixed (house rule: the
   integration variable itself). */
%mr_divides(%mr_div_y, %mr_div_u, x) := block([%mr_div_v],
  %mr_div_v : %mr_simp(%mr_div_u / %mr_div_y),
  if freeof(x, %mr_div_v) then %mr_div_v else false)$

/* ===================== section 9 (2026-09-22 A2) ======================
 * Rubi :5017-5039 EulerIntegrandQ, :804-819 SimplerIntegrandQ, :821-835
 * CancelCommonFactors. */

/* Rubi :5017-5039 EulerIntegrandQ: its five clauses are the generated
   rewrite table mr_rw_eiq (rules/utils/inert_trig_rewrites.mac); every
   clause answers True or False, the last unconditionally. */
%mr_eulerIntegrandQ(%mr_eiq_u, x) :=
  is(%mr_rewrite("EulerIntegrandQ", mr_rw_eiq, %mr_eiq_u, x) = true)$

/* Rubi :821-835 CancelCommonFactors[u,v]: {u1,v1} are u and v with their
   common factors cancelled one at a time. ProductQ/First/Rest/MemberQ
   read under inflag : true (capture trap 2): First[u] is first(u),
   Rest[u] is %mr_rest_in(u), MemberQ[v,f] is member(f, %mr_args_in(v)).
   DeleteCases[v,f,1,1] removes ONE occurrence of f from v's factor list
   and rebuilds the product; delete(f,v,1) does the same and, via its own
   Times reconstruction, already collapses a one-factor remainder to that
   bare factor and an empty remainder to 1 -- both call sites here delete
   from a v (or u) already known ProductQ, so delete always sees a
   genuine multi-factor Times. */
%mr_cancelCommonFactors(%mr_ccf_u, %mr_ccf_v) := block([inflag : true],
  if %mr_productQ(%mr_ccf_u) then (
    if %mr_productQ(%mr_ccf_v) then (
      if member(first(%mr_ccf_u), %mr_args_in(%mr_ccf_v)) then
        %mr_cancelCommonFactors(%mr_rest_in(%mr_ccf_u),
                                 delete(first(%mr_ccf_u), %mr_ccf_v, 1))
      else block([%mr_ccf_r],
        %mr_ccf_r : %mr_cancelCommonFactors(%mr_rest_in(%mr_ccf_u), %mr_ccf_v),
        [first(%mr_ccf_u) * first(%mr_ccf_r), second(%mr_ccf_r)])
    ) else (
      if member(%mr_ccf_v, %mr_args_in(%mr_ccf_u)) then
        [delete(%mr_ccf_v, %mr_ccf_u, 1), 1]
      else [%mr_ccf_u, %mr_ccf_v]
    )
  ) else (
    if %mr_productQ(%mr_ccf_v) then (
      if member(%mr_ccf_u, %mr_args_in(%mr_ccf_v)) then
        [1, delete(%mr_ccf_u, %mr_ccf_v, 1)]
      else [%mr_ccf_u, %mr_ccf_v]
    ) else [%mr_ccf_u, %mr_ccf_v]
  ))$

/* Rubi :804-819 SimplerIntegrandQ[u,v,x]: the two commented-out lines
   (the Head/Length short circuit) stay out, not live upstream. LeafCount
   is %mr_leafCount, Apply[Plus,RationalFunctionExponents[..]] is the sum
   of %mr_rationalFunctionExponents's 2-element list.
   Deviation: %mr_leafCount counts differently from Mathematica's
   LeafCount (measured 2026-09-22: 7 for both 1/(x^2+1) and x/(x^3+1),
   where Mathematica gives 7 and 9), so the 6/10 threshold can decide
   differently near the boundary. */
%mr_simplerIntegrandQ(%mr_sic_u, %mr_sic_v, x) := block(
  [%mr_sic_lst, %mr_sic_u1, %mr_sic_v1],
  %mr_sic_lst : %mr_cancelCommonFactors(%mr_sic_u, %mr_sic_v),
  %mr_sic_u1 : first(%mr_sic_lst),
  %mr_sic_v1 : second(%mr_sic_lst),
  if %mr_leafCount(%mr_sic_u1) < 6/10 * %mr_leafCount(%mr_sic_v1) then true
  elseif %mr_rationalFunctionQ(%mr_sic_u1, x) then
    (if %mr_rationalFunctionQ(%mr_sic_v1, x) then
       is(apply("+", %mr_rationalFunctionExponents(%mr_sic_u1, x))
          < apply("+", %mr_rationalFunctionExponents(%mr_sic_v1, x)))
     else true)
  else false)$

/* ===================== section 9 (2026-09-22 A1) ======================
 * Rubi :1815 SubstForFractionalPowerQ, :1822 SubstForFractionalPowerAuxQ,
 * :3223 PolynomialInQ, :3227 PolynomialInAuxQ, :3275 PolynomialInSubst,
 * :3280 PolynomialInSubstAux. */

/* Rubi :1815 SubstForFractionalPowerQ[u,v,x]: True unless u has a
   fractional-power subexpression whose base is not v (Catch/Scan/
   Throw[False] over u's arguments, else True). Scan[..Throw[False]];True
   is every() over the internal-args list (capture trap 2, %mr_args_in);
   every([]) = true matches the empty-Scan default. */
%mr_substForFractionalPowerQ(%mr_sffpq_u, %mr_sffpq_v, x) := block([inflag : true],
  if atom(%mr_sffpq_u) or freeof(x, %mr_sffpq_u) then true
  elseif %mr_fractionalPowerQ(%mr_sffpq_u) then
    %mr_substForFractionalPowerAuxQ(%mr_sffpq_u, %mr_sffpq_v, x)
  else every(
    lambda([%mr_sffpq_t],
           %mr_substForFractionalPowerQ(%mr_sffpq_t, %mr_sffpq_v, x)),
    %mr_args_in(%mr_sffpq_u)))$

/* Rubi :1822 SubstForFractionalPowerAuxQ[u,v,x]: True iff some
   subexpression of u is a fractional power of exactly v. Scan[..
   Throw[True]];False is some() over the internal-args list; some([]) =
   false matches the empty-Scan default. */
%mr_substForFractionalPowerAuxQ(%mr_sffpaq_u, %mr_sffpaq_v, x) := block(
  [inflag : true],
  if atom(%mr_sffpaq_u) then false
  elseif %mr_fractionalPowerQ(%mr_sffpaq_u)
         and %mr_eqQ(part(%mr_sffpaq_u, 1), %mr_sffpaq_v) then true
  else some(
    lambda([%mr_sffpaq_t],
           %mr_substForFractionalPowerAuxQ(%mr_sffpaq_t, %mr_sffpaq_v, x)),
    %mr_args_in(%mr_sffpaq_u)))$

/* Rubi :3227 PolynomialInAuxQ[u,v,x]: u===v is is(u = v) (SameQ, the
   %mr_unsameQ precedent, this file's line ~6495); IGtQ is %mr_iGtQ (the
   RESTRUCTURE "cmp" path's ported positive-integer test,
   maxima_rubi_utils.mac:711, used by the same-base exponent-ratio and
   exponent-positivity checks); SumQ/ProductQ's Scan[..Throw[False]];True
   is every() over the internal-args list (capture trap 2). */
%mr_polynomialInAuxQ(%mr_piaq_u, %mr_piaq_v, x) := block([inflag : true],
  if is(%mr_piaq_u = %mr_piaq_v) then true
  elseif atom(%mr_piaq_u) then not is(%mr_piaq_u = x)
  elseif %mr_powerQ(%mr_piaq_u) then
    (if %mr_powerQ(%mr_piaq_v)
        and is(part(%mr_piaq_u, 1) = part(%mr_piaq_v, 1))
       then %mr_iGtQ(part(%mr_piaq_u, 2) / part(%mr_piaq_v, 2), 0)
       else %mr_iGtQ(part(%mr_piaq_u, 2), 0)
              and %mr_polynomialInAuxQ(part(%mr_piaq_u, 1), %mr_piaq_v, x))
  elseif %mr_sumQ(%mr_piaq_u) or %mr_productQ(%mr_piaq_u) then
    every(lambda([%mr_piaq_t], %mr_polynomialInAuxQ(%mr_piaq_t, %mr_piaq_v, x)),
          %mr_args_in(%mr_piaq_u))
  else false)$

/* Rubi :3223 PolynomialInQ[u,v,x]. */
%mr_polynomialInQ(%mr_piq_u, %mr_piq_v, x) :=
  %mr_polynomialInAuxQ(%mr_piq_u,
    %mr_nonfreeFactors(%mr_nonfreeTerms(%mr_piq_v, x), x), x)$

/* Rubi :3280 PolynomialInSubstAux[u,v,x]: the else-branch Map[Function[
   ..],u] is, under inflag : true, apply(op(u), map(f, args(u))) (capture
   trap 2, the house idiom cited at this file's line ~9). */
%mr_polynomialInSubstAux(%mr_pisa_u, %mr_pisa_v, x) := block([inflag : true],
  if is(%mr_pisa_u = %mr_pisa_v) then x
  elseif atom(%mr_pisa_u) then %mr_pisa_u
  elseif %mr_powerQ(%mr_pisa_u) then
    (if %mr_powerQ(%mr_pisa_v)
        and is(part(%mr_pisa_u, 1) = part(%mr_pisa_v, 1))
       then x^(part(%mr_pisa_u, 2) / part(%mr_pisa_v, 2))
       else %mr_polynomialInSubstAux(part(%mr_pisa_u, 1), %mr_pisa_v, x)
              ^part(%mr_pisa_u, 2))
  else apply(op(%mr_pisa_u),
             map(lambda([%mr_pisa_t],
                        %mr_polynomialInSubstAux(%mr_pisa_t, %mr_pisa_v, x)),
                 %mr_args_in(%mr_pisa_u))))$

/* Rubi :3275 PolynomialInSubst[u,v,x]: ReplaceAll[...,{x->...}] is a
   single-target subst (Maxima's subst is simultaneous, matching
   Mathematica's ReplaceAll here since there is only the one x-rule). */
%mr_polynomialInSubst(%mr_pis_u, %mr_pis_v, x) := block([%mr_pis_w],
  %mr_pis_w : %mr_nonfreeTerms(%mr_pis_v, x),
  subst((x - %mr_freeTerms(%mr_pis_v, x)) / %mr_freeFactors(%mr_pis_w, x), x,
        %mr_polynomialInSubstAux(%mr_pis_u,
          %mr_nonfreeFactors(%mr_pis_w, x), x)))$

/* ===================== section 9 (2026-09-22 A1) ======================
 * Rubi :4976 PowerVariableExpn, :4985 PowerVariableDegree, :5001
 * PowerVariableSubst. */

/* Rubi :4985 PowerVariableDegree[u,m,c,x]: threads {m,c} through u's
   arguments (Catch[Module[{lst={m,c}}, Scan[..If[AtomQ[lst],
   Throw[False]]],u]; lst]), false at the first argument that declines
   (capture trap 2: the found-flag while loop over %mr_args_in(u), the
   %mr_simplerQ_scan precedent, this file's line ~1182). u[[1]]/x is the
   power's base over x (FreeQ[u[[1]]/x,x] asks whether the base is c*x);
   m===u[[2]] and c===u[[1]]/x are SameQ, is(a = b) (capture trap 3, the
   %mr_polynomialInAuxQ precedent). GCD is gcd on the two integers. */
%mr_powerVariableDegree(%mr_pvd_u, %mr_pvd_m, %mr_pvd_c, x) := block(
  [inflag : true, %mr_pvd_args, %mr_pvd_i, %mr_pvd_n, %mr_pvd_lst, %mr_pvd_ok],
  if freeof(x, %mr_pvd_u) then [%mr_pvd_m, %mr_pvd_c]
  elseif atom(%mr_pvd_u) or %mr_calculusQ(%mr_pvd_u) then false
  elseif %mr_powerQ(%mr_pvd_u) and freeof(x, part(%mr_pvd_u, 1) / x) then (
    if %mr_eqQ(%mr_pvd_m, 0)
       or (is(%mr_pvd_m = part(%mr_pvd_u, 2))
           and is(%mr_pvd_c = part(%mr_pvd_u, 1) / x))
    then [part(%mr_pvd_u, 2), part(%mr_pvd_u, 1) / x]
    elseif integerp(part(%mr_pvd_u, 2)) and integerp(%mr_pvd_m)
           and gcd(%mr_pvd_m, part(%mr_pvd_u, 2)) > 1
           and is(%mr_pvd_c = part(%mr_pvd_u, 1) / x)
    then [gcd(%mr_pvd_m, part(%mr_pvd_u, 2)), %mr_pvd_c]
    else false
  )
  else (
    %mr_pvd_args : %mr_args_in(%mr_pvd_u),
    %mr_pvd_n : length(%mr_pvd_args),
    %mr_pvd_i : 0,
    %mr_pvd_lst : [%mr_pvd_m, %mr_pvd_c],
    %mr_pvd_ok : true,
    while %mr_pvd_ok and %mr_pvd_i < %mr_pvd_n do (
      %mr_pvd_i : %mr_pvd_i + 1,
      %mr_pvd_lst : %mr_powerVariableDegree(part(%mr_pvd_args, %mr_pvd_i),
                      first(%mr_pvd_lst), second(%mr_pvd_lst), x),
      if atom(%mr_pvd_lst) then %mr_pvd_ok : false
    ),
    if %mr_pvd_ok then %mr_pvd_lst else false
  ))$

/* Rubi :5001 PowerVariableSubst[u,m,x]: the else-branch Map[Function[..],
   u] is, under inflag : true, apply(op(u), map(f, args(u))) (capture
   trap 2, the house idiom cited at this file's line ~9). */
%mr_powerVariableSubst(%mr_pvs_u, %mr_pvs_m, x) := block([inflag : true],
  if freeof(x, %mr_pvs_u) or atom(%mr_pvs_u) or %mr_calculusQ(%mr_pvs_u)
  then %mr_pvs_u
  elseif %mr_powerQ(%mr_pvs_u) and freeof(x, part(%mr_pvs_u, 1) / x) then
    x^(part(%mr_pvs_u, 2) / %mr_pvs_m)
  else apply(op(%mr_pvs_u),
             map(lambda([%mr_pvs_t],
                        %mr_powerVariableSubst(%mr_pvs_t, %mr_pvs_m, x)),
                 %mr_args_in(%mr_pvs_u))))$

/* Rubi :4976 PowerVariableExpn[u,m,x]: With[{lst=PowerVariableDegree[u,m,
   1,x]}, ...] is a plain local (no recomputation hazard: lst is bound
   once from the call's own arguments, none of them named lst). */
%mr_powerVariableExpn(%mr_pve_u, %mr_pve_m, x) := block([%mr_pve_lst],
  if not integerp(%mr_pve_m) then false
  else (
    %mr_pve_lst : %mr_powerVariableDegree(%mr_pve_u, %mr_pve_m, 1, x),
    if atom(%mr_pve_lst) then false
    else [x^(%mr_pve_m / first(%mr_pve_lst))
            * %mr_powerVariableSubst(%mr_pve_u, first(%mr_pve_lst), x),
          first(%mr_pve_lst), second(%mr_pve_lst)]
  ))$

/* ===================== section 9 (2026-09-22 A1) ======================
 * Rubi :5071 FunctionOfSquareRootOfQuadratic (2-arg entry, its :5102
 * 3-arg overload) and :5119 SquareRootOfQuadraticSubst. */

/* Rubi :5071 the exclusion MatchQ[u, x^m_.*(a_+b_.*x^n_.)^p_ /;
   FreeQ[{a,b,m,n,p},x]]: neither Times-level factor carries its own
   Optional dot (only the nested m_./n_. do), so the pattern requires u
   to be EXACTLY a two-factor product -- one factor a bare x or x^m
   (m free of x), the other a kept power (a+b*x^n)^p with p free of x.
   BinomialQ[w,x] (%mr_binomialQ, :549) is exactly the a+b*x^n test, so
   the remaining structural work is picking out the two factors; a
   three-term sum such as x^2+x+1 is not a BinomialQ base, so it does
   not exclude (the c>0 target below depends on this). */
%mr_fosq_excludedQ(%mr_fosqx_u, x) := block(
  [inflag : true, %mr_fosqx_facs, %mr_fosqx_xf, %mr_fosqx_pw, %mr_fosqx_t],
  if not %mr_productQ(%mr_fosqx_u) then false
  else (
    %mr_fosqx_facs : %mr_args_in(%mr_fosqx_u),
    if not is(length(%mr_fosqx_facs) = 2) then false
    else (
      %mr_fosqx_xf : false, %mr_fosqx_pw : false,
      for %mr_fosqx_t in %mr_fosqx_facs do (
        if is(%mr_fosqx_t = x)
           or (%mr_powerQ(%mr_fosqx_t) and is(part(%mr_fosqx_t, 1) = x)
               and freeof(x, part(%mr_fosqx_t, 2)))
        then %mr_fosqx_xf : %mr_fosqx_t
        elseif %mr_powerQ(%mr_fosqx_t) and freeof(x, part(%mr_fosqx_t, 2))
        then %mr_fosqx_pw : %mr_fosqx_t
      ),
      if %mr_fosqx_xf = false or %mr_fosqx_pw = false then false
      else %mr_binomialQ(part(%mr_fosqx_pw, 1), x)
    )
  ))$

/* Rubi :5102 FunctionOfSquareRootOfQuadratic[u,v,x] (the 3-arg
   overload): the Catch[Scan[..Throw[False]]] thread over u's arguments
   is, under inflag : true, the %mr_powerVariableDegree precedent (this
   file's line ~6732) -- a found-flag while loop over %mr_args_in(u)
   threading the single-element list forward and stopping at the first
   atom (False) result. u===v in the power branch is is(u = v) (SameQ,
   the %mr_unsameQ precedent). */
%mr_functionOfSquareRootOfQuadraticAux(%mr_fosqa_u, %mr_fosqa_v, x) := block(
  [inflag : true, %mr_fosqa_args, %mr_fosqa_n, %mr_fosqa_i, %mr_fosqa_lst,
   %mr_fosqa_ok],
  if atom(%mr_fosqa_u) or freeof(x, %mr_fosqa_u) then [%mr_fosqa_v]
  elseif %mr_powerQ(%mr_fosqa_u) and freeof(x, part(%mr_fosqa_u, 2)) then (
    if %mr_fractionQ(part(%mr_fosqa_u, 2))
       and is(denom(part(%mr_fosqa_u, 2)) = 2)
       and %mr_polynomialQ(part(%mr_fosqa_u, 1), x)
       and is(%mr_degree(part(%mr_fosqa_u, 1), x) = 2)
    then (
      if %mr_falseQ(%mr_fosqa_v) or is(part(%mr_fosqa_u, 1) = %mr_fosqa_v)
      then [part(%mr_fosqa_u, 1)]
      else false
    )
    else %mr_functionOfSquareRootOfQuadraticAux(
           part(%mr_fosqa_u, 1), %mr_fosqa_v, x)
  )
  elseif %mr_productQ(%mr_fosqa_u) or %mr_sumQ(%mr_fosqa_u) then (
    %mr_fosqa_args : %mr_args_in(%mr_fosqa_u),
    %mr_fosqa_n : length(%mr_fosqa_args),
    %mr_fosqa_i : 0,
    %mr_fosqa_lst : [%mr_fosqa_v],
    %mr_fosqa_ok : true,
    while %mr_fosqa_ok and %mr_fosqa_i < %mr_fosqa_n do (
      %mr_fosqa_i : %mr_fosqa_i + 1,
      %mr_fosqa_lst : %mr_functionOfSquareRootOfQuadraticAux(
                        part(%mr_fosqa_args, %mr_fosqa_i),
                        first(%mr_fosqa_lst), x),
      if atom(%mr_fosqa_lst) then %mr_fosqa_ok : false
    ),
    if %mr_fosqa_ok then %mr_fosqa_lst else false
  )
  else false)$

/* Rubi :5119 SquareRootOfQuadraticSubst[u,vv,xx,x]: the else-branch
   Map[Function[..],u] is, under inflag : true, apply(op(u), map(f,
   args(u))) (capture trap 2, the house idiom cited at this file's
   line ~9). */
%mr_squareRootOfQuadraticSubst(%mr_sqs_u, %mr_sqs_vv, %mr_sqs_xx, x) :=
  block([inflag : true],
  if atom(%mr_sqs_u) or freeof(x, %mr_sqs_u) then
    (if is(%mr_sqs_u = x) then %mr_sqs_xx else %mr_sqs_u)
  elseif %mr_powerQ(%mr_sqs_u) and freeof(x, part(%mr_sqs_u, 2)) then (
    if %mr_fractionQ(part(%mr_sqs_u, 2))
       and is(denom(part(%mr_sqs_u, 2)) = 2)
       and %mr_polynomialQ(part(%mr_sqs_u, 1), x)
       and is(%mr_degree(part(%mr_sqs_u, 1), x) = 2)
    then %mr_sqs_vv^num(part(%mr_sqs_u, 2))
    else %mr_squareRootOfQuadraticSubst(
           part(%mr_sqs_u, 1), %mr_sqs_vv, %mr_sqs_xx, x)^part(%mr_sqs_u, 2)
  )
  else apply(op(%mr_sqs_u),
             map(lambda([%mr_sqs_t],
                        %mr_squareRootOfQuadraticSubst(
                          %mr_sqs_t, %mr_sqs_vv, %mr_sqs_xx, x)),
                 %mr_args_in(%mr_sqs_u))))$

/* Rubi :5071-5100 FunctionOfSquareRootOfQuadratic[u,x] (the 2-arg
   entry): the three Euler-substitution branches (c>0, a>0, else) in
   upstream order, tagged 2/1/3. FullSimplify in the third branch is
   ratsimp (the translation table's row); Simplify is %mr_simp. */
%mr_functionOfSquareRootOfQuadratic(%mr_fosq_u, x) := block(
  [inflag : true, %mr_fosq_lst, %mr_fosq_tmp, %mr_fosq_a, %mr_fosq_b,
   %mr_fosq_c, %mr_fosq_sqrt, %mr_fosq_q, %mr_fosq_r],
  if %mr_fosq_excludedQ(%mr_fosq_u, x) then false
  else (
    %mr_fosq_lst : %mr_functionOfSquareRootOfQuadraticAux(%mr_fosq_u, false, x),
    if atom(%mr_fosq_lst) or %mr_falseQ(first(%mr_fosq_lst)) then false
    else (
      %mr_fosq_tmp : first(%mr_fosq_lst),
      %mr_fosq_a : %mr_coeff(%mr_fosq_tmp, x, 0),
      %mr_fosq_b : %mr_coeff(%mr_fosq_tmp, x, 1),
      %mr_fosq_c : %mr_coeff(%mr_fosq_tmp, x, 2),
      if (%mr_eqQ(%mr_fosq_a, 0) and %mr_eqQ(%mr_fosq_b, 0))
         or %mr_eqQ(%mr_fosq_b^2 - 4*%mr_fosq_a*%mr_fosq_c, 0)
      then false
      elseif %mr_posQ(%mr_fosq_c) then (
        %mr_fosq_sqrt : %mr_rt(%mr_fosq_c, 2),
        %mr_fosq_q : %mr_fosq_a*%mr_fosq_sqrt + %mr_fosq_b*x
                       + %mr_fosq_sqrt*x^2,
        %mr_fosq_r : %mr_fosq_b + 2*%mr_fosq_sqrt*x,
        [%mr_simp(%mr_squareRootOfQuadraticSubst(%mr_fosq_u,
                    %mr_fosq_q / %mr_fosq_r, (-%mr_fosq_a + x^2) / %mr_fosq_r,
                    x)
                  * %mr_fosq_q / %mr_fosq_r^2),
         %mr_simp(%mr_fosq_sqrt*x + sqrt(%mr_fosq_tmp)),
         2]
      )
      elseif %mr_posQ(%mr_fosq_a) then (
        %mr_fosq_sqrt : %mr_rt(%mr_fosq_a, 2),
        %mr_fosq_q : %mr_fosq_c*%mr_fosq_sqrt - %mr_fosq_b*x
                       + %mr_fosq_sqrt*x^2,
        %mr_fosq_r : %mr_fosq_c - x^2,
        [%mr_simp(%mr_squareRootOfQuadraticSubst(%mr_fosq_u,
                    %mr_fosq_q / %mr_fosq_r,
                    (-%mr_fosq_b + 2*%mr_fosq_sqrt*x) / %mr_fosq_r, x)
                  * %mr_fosq_q / %mr_fosq_r^2),
         %mr_simp((-%mr_fosq_sqrt + sqrt(%mr_fosq_tmp)) / x),
         1]
      )
      else (
        %mr_fosq_sqrt : %mr_rt(%mr_fosq_b^2 - 4*%mr_fosq_a*%mr_fosq_c, 2),
        %mr_fosq_r : %mr_fosq_c - x^2,
        [%mr_simp(-%mr_fosq_sqrt
                  * %mr_squareRootOfQuadraticSubst(%mr_fosq_u,
                      -%mr_fosq_sqrt*x / %mr_fosq_r,
                      -(%mr_fosq_b*%mr_fosq_c + %mr_fosq_c*%mr_fosq_sqrt
                         + (-%mr_fosq_b + %mr_fosq_sqrt)*x^2)
                        / (2*%mr_fosq_c*%mr_fosq_r),
                      x)
                  * x / %mr_fosq_r^2),
         ratsimp(2*%mr_fosq_c*sqrt(%mr_fosq_tmp)
                   / (%mr_fosq_b - %mr_fosq_sqrt + 2*%mr_fosq_c*x)),
         3]
      )
    )
  ))$

/* ===================== section 9 (2026-09-22 A1) ======================
 * Rubi :1801 SubstForFractionalPowerOfQuotientOfLinears, :1831
 * FractionalPowerOfQuotientOfLinears (G5). */

/* lcm is a NOUN until "functs" is loaded (describe("lcm", exact):
   "load (\"functs\") loads this function" -- measured 2026-09-22;
   integerp(lcm(1,1)) is false unloaded, true once loaded -- the
   witness this guard reads). Loaded once, guarded, so re-loading this
   file after functs is already present is a no-op. */
if not integerp(lcm(1, 1)) then load("functs")$

/* Rubi :1831-1840  FractionalPowerOfQuotientOfLinears[u,n,v,x] — the
   first (depth-first, parts order) fractional power of a NON-LINEAR
   quotient-of-linears base found in u: {LCM[Denominator[exponent], n],
   base}; the {n,v} identity on atom/x-free; the CalculusQ decline; the
   v-equality guard (the LCM accumulates only for the SAME base); else
   the parts scan. This is %mr_fractionalPowerOfLinear's twin (this
   file's line ~5476) with the extra QuotientOfLinearsQ-and-not-LinearQ
   guard in place of the plain LinearQ test, and a genuine lcm() call
   in place of abs(d*n)/gcd(d,n) (that port's LCM stand-in predates
   loading "functs"; the guard above makes the noun-free lcm available
   here). The scan's Throw[False] is the flag + bare return() idiom
   (the line-81 note); inflag : true reads u's internal Times/Plus/
   Power args, matching Mathematica's Scan over ALL of a node's parts
   (a Power node's exponent is scanned too, not only its base). */
%mr_fractionalPowerOfQuotientOfLinears(%mr_fpql_u, %mr_fpql_n, %mr_fpql_v, x) :=
  block([inflag : true, %mr_fpql_i, %mr_fpql_e, %mr_fpql_d, %mr_fpql_lst],
  if atom(%mr_fpql_u) or freeof(x, %mr_fpql_u) then [%mr_fpql_n, %mr_fpql_v]
  elseif %mr_calculusQ(%mr_fpql_u) then false
  elseif %mr_fractionalPowerQ(%mr_fpql_u)
         and %mr_quotientOfLinearsQ(part(%mr_fpql_u, 1), x)
         and not %mr_linearQ(part(%mr_fpql_u, 1), x)
         and (%mr_falseQ(%mr_fpql_v) or %mr_eqQ(part(%mr_fpql_u, 1), %mr_fpql_v))
  then (
    %mr_fpql_e : %mr_fractionalPowerExpon(%mr_fpql_u),
    %mr_fpql_d : denom(%mr_fpql_e),
    [lcm(%mr_fpql_d, %mr_fpql_n), part(%mr_fpql_u, 1)]
  )
  else (
    %mr_fpql_lst : [%mr_fpql_n, %mr_fpql_v],
    for %mr_fpql_i : 1 thru length(%mr_fpql_u) do (
      %mr_fpql_lst : %mr_fractionalPowerOfQuotientOfLinears(
                       part(%mr_fpql_u, %mr_fpql_i),
                       part(%mr_fpql_lst, 1), part(%mr_fpql_lst, 2), x),
      if atom(%mr_fpql_lst) then return()
    ),
    if atom(%mr_fpql_lst) then false else %mr_fpql_lst
  ))$

/* Rubi :1801-1811  SubstForFractionalPowerOfQuotientOfLinears[u,x] —
   the 4-list contract: {v,n,(a+b*x)/(c+d*x),b*c-a*d} where v is u with
   every ((a+b*x)/(c+d*x))^(m/n) replaced by x^m and x by
   (-a+c*x^n)/(b-d*x^n), times x^(n-1)/(b-d*x^n)^2, all Simplify'd
   (= %mr_simp); NonfreeFactors/FreeFactors split v. False decline when
   FractionalPowerOfQuotientOfLinears finds no such quotient (the
   {n,False} identity — lst[[2]] atom) or when d = 0 (the quotient
   collapsed to a plain linear, EqQ guard). This is
   %mr_substForFractionalPowerOfLinear's twin (line ~5549): the located
   base is a quotient, so its four QuotientOfLinearsParts coefficients
   replace the plain linear's two, and the substitution target w is the
   quotient's own inverse-map value in place of -a/b + x^n/b. */
%mr_substForFractionalPowerOfQuotientOfLinears(%mr_sffpoql_u, x) := block(
  [%mr_sffpoql_lst, %mr_sffpoql_n, %mr_sffpoql_tmp, %mr_sffpoql_a,
   %mr_sffpoql_b, %mr_sffpoql_c, %mr_sffpoql_d, %mr_sffpoql_l],
  %mr_sffpoql_lst : %mr_fractionalPowerOfQuotientOfLinears(%mr_sffpoql_u, 1, false, x),
  if atom(%mr_sffpoql_lst) or atom(part(%mr_sffpoql_lst, 2)) then false
  else (
    %mr_sffpoql_n : part(%mr_sffpoql_lst, 1),
    %mr_sffpoql_tmp : part(%mr_sffpoql_lst, 2),
    %mr_sffpoql_lst : %mr_quotientOfLinearsParts(%mr_sffpoql_tmp, x),
    %mr_sffpoql_a : part(%mr_sffpoql_lst, 1),
    %mr_sffpoql_b : part(%mr_sffpoql_lst, 2),
    %mr_sffpoql_c : part(%mr_sffpoql_lst, 3),
    %mr_sffpoql_d : part(%mr_sffpoql_lst, 4),
    if %mr_eqQ(%mr_sffpoql_d, 0) then false
    else (
      %mr_sffpoql_l : %mr_simp(
        x^(%mr_sffpoql_n - 1)
        * %mr_substForFractionalPower(%mr_sffpoql_u, %mr_sffpoql_tmp,
            %mr_sffpoql_n,
            (-%mr_sffpoql_a + %mr_sffpoql_c*x^%mr_sffpoql_n)
              / (%mr_sffpoql_b - %mr_sffpoql_d*x^%mr_sffpoql_n), x)
        / (%mr_sffpoql_b - %mr_sffpoql_d*x^%mr_sffpoql_n)^2),
      [%mr_nonfreeFactors(%mr_sffpoql_l, x), %mr_sffpoql_n, %mr_sffpoql_tmp,
       %mr_freeFactors(%mr_sffpoql_l, x)
         * (%mr_sffpoql_b*%mr_sffpoql_c - %mr_sffpoql_a*%mr_sffpoql_d)]
    )
  ))$

/* ===================== section 9 (2026-09-22 A1), G6a =================
 * The factor utilities under FunctionOfLinear (Rubi :1281-:1975,
 * :3025-:3160, :4224): LeadFactor/RemainingFactors/LeadBase/LeadDegree,
 * MonomialFactor/MinimumDegree, DivideDegreesOfFactors, the absurd-number
 * family, Smallest/FactorOrder/MostMainFactorPosition, and CommonFactors. */

/* Rubi :1281-1290  LeadFactor[u] — the leading factor of a product,
   recursing into First[u]; for a purely-imaginary complex number (Re = 0)
   whose Im is not 1, the leading factor of the imaginary part (I is not
   itself counted as a factor); else u itself. inflag : true reads the
   internal Times args (this file's house idiom). */
%mr_leadFactor(%mr_lf_u) := block([inflag : true],
  if %mr_productQ(%mr_lf_u) then %mr_leadFactor(first(%mr_lf_u))
  elseif %mr_complexNumberQ(%mr_lf_u) and is(realpart(%mr_lf_u) = 0) then
    (if is(imagpart(%mr_lf_u) = 1) then %mr_lf_u
     else %mr_leadFactor(imagpart(%mr_lf_u)))
  else %mr_lf_u)$

/* Rubi :1296-1305  RemainingFactors[u] — the product without its leading
   factor: RemainingFactors[First[u]] * Rest[u] for a product (the .m's
   own recursion on First[u], not just Rest[u], matters only when First[u]
   is itself a purely-imaginary complex number); the complex/else branches
   mirror LeadFactor's. */
%mr_remainingFactors(%mr_rf_u) := block([inflag : true],
  if %mr_productQ(%mr_rf_u) then
    %mr_remainingFactors(first(%mr_rf_u)) * %mr_rest_in(%mr_rf_u)
  elseif %mr_complexNumberQ(%mr_rf_u) and is(realpart(%mr_rf_u) = 0) then
    (if is(imagpart(%mr_rf_u) = 1) then 1
     else %i * %mr_remainingFactors(imagpart(%mr_rf_u)))
  else 1)$

/* Rubi :1311-1319  LeadBase[u] — the base of LeadFactor[u]. */
%mr_leadBase(%mr_lb_u) := block([inflag : true, %mr_lb_v],
  %mr_lb_v : %mr_leadFactor(%mr_lb_u),
  if %mr_powerQ(%mr_lb_v) then part(%mr_lb_v, 1) else %mr_lb_v)$

/* Rubi :1323-1331  LeadDegree[u] — the degree (exponent) of LeadFactor[u],
   or 1 when the leading factor is not itself a power. */
%mr_leadDegree(%mr_ld_u) := block([inflag : true, %mr_ld_v],
  %mr_ld_v : %mr_leadFactor(%mr_ld_u),
  if %mr_powerQ(%mr_ld_v) then part(%mr_ld_v, 2) else 1)$

/* Rubi :3112-3132  MonomialFactor[u,x] — {n,v} where x^n*v == u and n is
   free of x. The atom/Power/Product/Sum cases follow the .m literally;
   the Power case's IntegerQ branch reads u's own exponent (u[[2]]), not
   MonomialFactor's; the Sum case's Scan is the for-loop starting at the
   second mapped {deg,v} pair (this file's house idiom for Scan under
   inflag : true, e.g. line 5523). */
%mr_monomialFactor(%mr_mf_u, x) := block(
  [inflag : true, %mr_mf_lst1, %mr_mf_lst2, %mr_mf_lst, %mr_mf_deg, %mr_mf_i],
  if atom(%mr_mf_u) then
    (if is(%mr_mf_u = x) then [1, 1] else [0, %mr_mf_u])
  elseif %mr_powerQ(%mr_mf_u) then (
    if integerp(part(%mr_mf_u, 2)) then (
      %mr_mf_lst1 : %mr_monomialFactor(part(%mr_mf_u, 1), x),
      [first(%mr_mf_lst1) * part(%mr_mf_u, 2),
       second(%mr_mf_lst1) ^ part(%mr_mf_u, 2)]
    )
    elseif is(part(%mr_mf_u, 1) = x) and freeof(x, part(%mr_mf_u, 2))
      then [part(%mr_mf_u, 2), 1]
    else [0, %mr_mf_u]
  )
  elseif %mr_productQ(%mr_mf_u) then (
    %mr_mf_lst1 : %mr_monomialFactor(first(%mr_mf_u), x),
    %mr_mf_lst2 : %mr_monomialFactor(%mr_rest_in(%mr_mf_u), x),
    [first(%mr_mf_lst1) + first(%mr_mf_lst2),
     second(%mr_mf_lst1) * second(%mr_mf_lst2)]
  )
  elseif %mr_sumQ(%mr_mf_u) then (
    %mr_mf_lst : map(lambda([%mr_mf_e], %mr_monomialFactor(%mr_mf_e, x)),
                      %mr_args_in(%mr_mf_u)),
    %mr_mf_deg : first(first(%mr_mf_lst)),
    for %mr_mf_i : 2 thru length(%mr_mf_lst) do
      %mr_mf_deg : %mr_minimumDegree(%mr_mf_deg, first(part(%mr_mf_lst, %mr_mf_i))),
    if %mr_eqQ(%mr_mf_deg, 0) or (%mr_rationalQ(%mr_mf_deg) and is(%mr_mf_deg < 0))
    then [0, %mr_mf_u]
    else [%mr_mf_deg,
          apply("+", map(lambda([%mr_mf_e],
                                 x ^ (first(%mr_mf_e) - %mr_mf_deg) * second(%mr_mf_e)),
                          %mr_mf_lst))]
  )
  else [0, %mr_mf_u])$

/* Rubi :3138-3152  MinimumDegree[deg1,deg2] — the .m's OrderedQ[{d1,d2}]
   tie-break is %mr_orderedQ (ported, this file's line 1060); Simplify is
   %mr_simp (the zero-chain, this file's line ~429). */
%mr_minimumDegree(%mr_mdeg_d1, %mr_mdeg_d2) := block([%mr_mdeg_d],
  if %mr_rationalQ(%mr_mdeg_d1) then
    (if %mr_rationalQ(%mr_mdeg_d2) then min(%mr_mdeg_d1, %mr_mdeg_d2) else %mr_mdeg_d1)
  elseif %mr_rationalQ(%mr_mdeg_d2) then %mr_mdeg_d2
  else (
    %mr_mdeg_d : %mr_simp(%mr_mdeg_d1 - %mr_mdeg_d2),
    if %mr_rationalQ(%mr_mdeg_d) then
      (if is(%mr_mdeg_d > 0) then %mr_mdeg_d2 else %mr_mdeg_d1)
    else
      (if %mr_orderedQ(%mr_mdeg_d1, %mr_mdeg_d2) then %mr_mdeg_d1 else %mr_mdeg_d2)
  ))$

/* Rubi :4224-4230  DivideDegreesOfFactors[u,n] — the base of each factor
   of u raised to its degree divided by n; Map over a product preserves
   the Times head (apply(op(u), map(f, args(u))), the house idiom for
   Mathematica's Map on a compound node under inflag : true). */
%mr_divideDegreesOfFactors(%mr_ddof_u, %mr_ddof_n) := block([inflag : true],
  if %mr_productQ(%mr_ddof_u) then
    apply(op(%mr_ddof_u),
          map(lambda([%mr_ddof_f],
                      %mr_leadBase(%mr_ddof_f) ^ (%mr_leadDegree(%mr_ddof_f) / %mr_ddof_n)),
              %mr_args_in(%mr_ddof_u)))
  else %mr_leadBase(%mr_ddof_u) ^ (%mr_leadDegree(%mr_ddof_u) / %mr_ddof_n))$

/* ---- the absurd-number family, Rubi :1905-1975 ---------------------- */

/* Rubi :1905-1913  AbsurdNumberQ[u] — a rational number, a positive
   rational raised to a fractional power, or a product of absurd numbers.
   The .m's binary u_*v_ pattern is, over Maxima's flat "*" node, every
   top-level factor being absurd (%mr_everyQ over %mr_args_in). */
%mr_absurdNumberQ(%mr_anq_u) := block([inflag : true],
  if %mr_rationalQ(%mr_anq_u) then true
  elseif %mr_powerQ(%mr_anq_u) then
    %mr_rationalQ(part(%mr_anq_u, 1)) and is(part(%mr_anq_u, 1) > 0)
      and %mr_fractionQ(part(%mr_anq_u, 2))
  elseif %mr_productQ(%mr_anq_u) then
    %mr_everyQ(%mr_absurdNumberQ, %mr_args_in(%mr_anq_u))
  else false)$

/* Rubi :1918-1923  AbsurdNumberFactors[u] — the product of u's absurd-
   number factors. */
%mr_absurdNumberFactors(%mr_anf_u) := block([inflag : true],
  if %mr_absurdNumberQ(%mr_anf_u) then %mr_anf_u
  elseif %mr_productQ(%mr_anf_u) then
    apply(op(%mr_anf_u), map(%mr_absurdNumberFactors, %mr_args_in(%mr_anf_u)))
  else %mr_numericFactor(%mr_anf_u))$

/* Rubi :1926-1931  NonabsurdNumberFactors[u] — the product of u's factors
   that are not absurd numbers. */
%mr_nonabsurdNumberFactors(%mr_nanf_u) := block([inflag : true],
  if %mr_absurdNumberQ(%mr_nanf_u) then 1
  elseif %mr_productQ(%mr_nanf_u) then
    apply(op(%mr_nanf_u), map(%mr_nonabsurdNumberFactors, %mr_args_in(%mr_nanf_u)))
  else %mr_nonnumericFactors(%mr_nanf_u))$

/* Rubi :1934-1940  FactorAbsurdNumber[m] — m's prime factorization as a
   list of [prime, exponent] pairs, denominator primes carrying a negative
   exponent. MEASURED 2026-09-22 (branch_5_50_base_84_g4204fb669/SBCL):
   ifactors(n) factors a POSITIVE integer n > 1 (ifactors(6) = [[2,1],
   [3,1]]) and ifactors(1) = [] (NOT Mathematica's FactorInteger[1] =
   {{1,1}}); a numerator or denominator of 1 contributes no pairs, and
   the whole-m-is-1 (or -1) case is the only place the {{1,1}} (or
   {{-1,1}}) identity is needed, handled by the empty-merge special case
   below. A negative m gets a leading [-1,1] pair (FactorInteger's own
   sign convention). The power branch reads m's own exponent (m[[2]]);
   the product branch's Flatten[Map[...],1] is apply(append, map(...))
   over %mr_args_in, and Sort[...,#1[[1]]<#2[[1]]&] is the exact sort
   comparator the brief specifies. */
%mr_factorAbsurdNumber(%mr_fan_m) := block(
  [inflag : true, %mr_fan_sgn, %mr_fan_nu, %mr_fan_de, %mr_fan_l1, %mr_fan_l2,
   %mr_fan_merged, %mr_fan_p, %mr_fan_q],
  if %mr_rationalQ(%mr_fan_m) then (
    %mr_fan_sgn : if is(%mr_fan_m < 0) then -1 else 1,
    %mr_fan_nu : abs(num(%mr_fan_m)),
    %mr_fan_de : abs(denom(%mr_fan_m)),
    %mr_fan_l1 : if is(%mr_fan_nu = 1) then [] else ifactors(%mr_fan_nu),
    %mr_fan_l2 : map(lambda([%mr_fan_p], [first(%mr_fan_p), -second(%mr_fan_p)]),
                      if is(%mr_fan_de = 1) then [] else ifactors(%mr_fan_de)),
    %mr_fan_merged : append(%mr_fan_l1, %mr_fan_l2),
    if is(%mr_fan_merged = []) then
      %mr_fan_merged : (if is(%mr_fan_sgn = -1) then [[-1, 1]] else [[1, 1]])
    elseif is(%mr_fan_sgn = -1) then
      %mr_fan_merged : cons([-1, 1], %mr_fan_merged),
    sort(%mr_fan_merged, lambda([%mr_fan_p, %mr_fan_q], first(%mr_fan_p) < first(%mr_fan_q)))
  )
  elseif %mr_powerQ(%mr_fan_m) then
    map(lambda([%mr_fan_p], [first(%mr_fan_p), second(%mr_fan_p) * part(%mr_fan_m, 2)]),
        %mr_factorAbsurdNumber(part(%mr_fan_m, 1)))
  else
    %mr_combineExponents(
      sort(apply(append, map(%mr_factorAbsurdNumber, %mr_args_in(%mr_fan_m))),
           lambda([%mr_fan_p, %mr_fan_q], first(%mr_fan_p) < first(%mr_fan_q)))))$

/* Rubi :1943-1947  CombineExponents[lst] — a sorted [prime,exponent] list
   with equal-prime pairs merged (added) into one. */
%mr_combineExponents(%mr_ce_lst) := block([],
  if length(%mr_ce_lst) < 2 then %mr_ce_lst
  elseif is(first(first(%mr_ce_lst)) = first(second(%mr_ce_lst))) then
    %mr_combineExponents(
      cons([first(first(%mr_ce_lst)), second(first(%mr_ce_lst)) + second(second(%mr_ce_lst))],
           rest(%mr_ce_lst, 2)))
  else cons(first(%mr_ce_lst), %mr_combineExponents(rest(%mr_ce_lst))))$

/* Rubi :1950-1956  AbsurdNumberGCD[seq__] — DEVIATION (spec, the brief's
   Interfaces list): the pinned Rubi only ever calls this through
   Apply[AbsurdNumberGCD, lst], so the port takes ONE Maxima list in place
   of the variadic seq__. A one-element list is its own element (the
   .m's Length[lst]==1 base case); otherwise the gcd of the first element's
   factorization against the gcd of the rest. */
%mr_absurdNumberGCD(%mr_agcd_lst) := block([%mr_agcd_rest],
  if is(length(%mr_agcd_lst) = 1) then first(%mr_agcd_lst)
  else (
    %mr_agcd_rest : %mr_absurdNumberGCD(rest(%mr_agcd_lst)),
    %mr_absurdNumberGCDList(%mr_factorAbsurdNumber(first(%mr_agcd_lst)),
                             %mr_factorAbsurdNumber(%mr_agcd_rest))
  ))$

/* Rubi :1959-1975  AbsurdNumberGCDList[lst1,lst2] — the gcd of two
   [prime,exponent] factorizations: an exhausted list contributes only its
   partner's negative-exponent (denominator) primes; equal leading primes
   keep the smaller exponent; otherwise the smaller leading prime is
   dropped (kept only if its own exponent is negative, i.e. it is a
   denominator prime the gcd must still carry). */
%mr_absurdNumberGCDList(%mr_agcdl_l1, %mr_agcdl_l2) := block([%mr_agcdl_p],
  if is(%mr_agcdl_l1 = []) then
    apply("*", map(lambda([%mr_agcdl_p], first(%mr_agcdl_p) ^ min(second(%mr_agcdl_p), 0)),
                    %mr_agcdl_l2))
  elseif is(%mr_agcdl_l2 = []) then
    apply("*", map(lambda([%mr_agcdl_p], first(%mr_agcdl_p) ^ min(second(%mr_agcdl_p), 0)),
                    %mr_agcdl_l1))
  elseif is(first(first(%mr_agcdl_l1)) = first(first(%mr_agcdl_l2))) then
    (if is(second(first(%mr_agcdl_l1)) <= second(first(%mr_agcdl_l2))) then
       first(first(%mr_agcdl_l1)) ^ second(first(%mr_agcdl_l1))
         * %mr_absurdNumberGCDList(rest(%mr_agcdl_l1), rest(%mr_agcdl_l2))
     else
       first(first(%mr_agcdl_l1)) ^ second(first(%mr_agcdl_l2))
         * %mr_absurdNumberGCDList(rest(%mr_agcdl_l1), rest(%mr_agcdl_l2)))
  elseif is(first(first(%mr_agcdl_l1)) < first(first(%mr_agcdl_l2))) then
    (if is(second(first(%mr_agcdl_l1)) < 0) then
       first(first(%mr_agcdl_l1)) ^ second(first(%mr_agcdl_l1))
         * %mr_absurdNumberGCDList(rest(%mr_agcdl_l1), %mr_agcdl_l2)
     else
       %mr_absurdNumberGCDList(rest(%mr_agcdl_l1), %mr_agcdl_l2))
  else
    (if is(second(first(%mr_agcdl_l2)) < 0) then
       first(first(%mr_agcdl_l2)) ^ second(first(%mr_agcdl_l2))
         * %mr_absurdNumberGCDList(%mr_agcdl_l1, rest(%mr_agcdl_l2))
     else
       %mr_absurdNumberGCDList(%mr_agcdl_l1, rest(%mr_agcdl_l2))))$

/* Rubi :3092-3101  Smallest — the smaller of two numbers when they agree
   in sign, else 0; Smallest[lst] folds Smallest over a list. */
%mr_smallest(%mr_sm_n1, %mr_sm_n2) := block([],
  if is(%mr_sm_n1 > 0) then
    (if is(%mr_sm_n2 > 0) then min(%mr_sm_n1, %mr_sm_n2) else 0)
  else (if is(%mr_sm_n2 > 0) then 0 else max(%mr_sm_n1, %mr_sm_n2)))$

%mr_smallestList(%mr_sml_lst) := block([%mr_sml_num, %mr_sml_e],
  %mr_sml_num : first(%mr_sml_lst),
  for %mr_sml_e in rest(%mr_sml_lst) do %mr_sml_num : %mr_smallest(%mr_sml_num, %mr_sml_e),
  %mr_sml_num)$

/* Rubi :3082-3090  FactorOrder[u,v] — 0 if u and v are both 1, -1/1 if
   only one of them is 1, else Mathematica's Order[u,v] (1 before, 0
   equal, -1 after in canonical order). DEVIATION (spec A1): Maxima's
   canonical order (orderlessp) stands in for Mathematica's Order; ported
   as orderlessp/is(u=v) per the brief. */
%mr_factorOrder(%mr_fo_u, %mr_fo_v) := block([],
  if is(%mr_fo_u = 1) then (if is(%mr_fo_v = 1) then 0 else -1)
  elseif is(%mr_fo_v = 1) then 1
  else (if orderlessp(%mr_fo_u, %mr_fo_v) then 1
        elseif is(%mr_fo_u = %mr_fo_v) then 0
        else -1))$

/* Rubi :3076-3080  MostMainFactorPosition[lst] — the position of the
   factor most main (FactorOrder-earliest) in lst, starting from the
   sentinel factor 1 (which every real factor is FactorOrder-before). */
%mr_mostMainFactorPosition(%mr_mmfp_lst) := block(
  [%mr_mmfp_factor : 1, %mr_mmfp_num : 1, %mr_mmfp_i],
  for %mr_mmfp_i : 1 thru length(%mr_mmfp_lst) do
    if is(%mr_factorOrder(part(%mr_mmfp_lst, %mr_mmfp_i), %mr_mmfp_factor) > 0) then (
      %mr_mmfp_factor : part(%mr_mmfp_lst, %mr_mmfp_i),
      %mr_mmfp_num : %mr_mmfp_i
    ),
  %mr_mmfp_num)$

/* Rubi :3025-3051  CommonFactors[lst] — an (n+1)-element list whose first
   element is the product of the factors common to every term of lst and
   whose remaining elements are each term divided by the common factor.
   Map2/ReapList are NOT ported (spec A1): the .m's Map2 is Maxima's
   two-list map (measured to apply element-wise, this file's line
   ~7100-probe); the While[True,...,Return[...]] loop is a for-loop with
   a return, matching the house idiom (e.g. this file's line ~6979); the
   .m's nested If-chain, where the THIRD branch's lst4=Map[LeadDegree,...]
   assignment runs unconditionally once the first two branches decline
   (a plain statement between two Ifs, not itself a condition), is ported
   as the %mr_cf_isLog flag guarding entry to the log branch, with lst4
   computed only in the surviving elses -- semantically identical to the
   .m's fall-through, since the log branch's own lst4 (the per-term
   ratio, a DIFFERENT variable reused under the same name upstream) is
   never read once that branch is skipped. ReplacePart[lst,e,k] is a
   makelist copy with index k replaced (never a destructive part-set).
   Apply[SameQ,lst3] (every element syntactically identical) is
   %mr_everyQ against is(# = first(lst3)) (the %mr_unsameQ SameQ
   precedent, this file's line ~6495). The Log branch's First[#] (the
   log's own argument) is first(%mr_args_in(#)).
   FIX ROUND 1 (Task 8 fix round 1, 2026-09-22): the brief's "FullSimplify
   there is ratsimp" is WRONG for this ratio specifically -- MEASURED:
   ratsimp(log(8)/log(4)) stays the unsimplified quotient log(8)/log(4)
   (not 3/2), so with ratsimp the log branch's EveryQ[RationalQ,...] gate
   never passes for any two DIFFERENT log arguments and the branch was
   dead code (commonFactors([log(4),log(8)]) came out [1,log(4),log(8)]
   -- no common log factor extracted at all, via the MostMainFactorPosition
   fallback, which is wrong: upstream's FullSimplify recognizes log(8)/
   log(4) = 3/2 and extracts log(2)). This is exactly the gap
   %mr_logRatio(base, F) already closes for commensurable positive-
   integer bases (this file's line ~4801, written for the same FullSimplify/
   ratsimp gap in FunctionOfExponential's TestAux) -- reused here rather
   than reinvented: %mr_logRatio(first(%mr_args_in(e)), first(%mr_args_in(
   first(lst3)))) gives the exact rational log(e's argument)/log(first
   lst3's argument), or false when the arguments are not commensurable
   (MEASURED: %mr_logRatio(8,4) = 3/2, %mr_logRatio(6,4) = false, matching
   FullSimplify's own decline on non-commensurable bases); %mr_rationalQ
   (false) = false, so the EveryQ[RationalQ,...] gate still correctly
   declines non-commensurable inputs. GCD of the (possibly fractional)
   ratio list is the numerator-gcd over denominator-lcm identity
   (Mathematica's GCD on rationals), since Maxima's gcd/lcm are
   integer-only. MEASURED 2026-09-22: apply(gcd, [1,3]) is the noun
   spmod(1,3), NOT 1 -- gcd is also a Maxima OPTION VARIABLE (its default
   algorithm name, "spmod"), and apply evaluates its function-position
   argument, so the bare symbol gcd resolves to that option value before
   apply ever sees it; gcd(1,3) direct-called (no apply) is unaffected
   (evaluates to 1) since a direct call resolves the function cell, not
   the value cell. apply("gcd", ...) (the quoted-string form, the same
   idiom this file already uses for apply("+", ...) / apply("*", ...))
   sidesteps the value-cell read and gives 1 for TWO arguments -- but
   gcd's real signature (? gcd) is gcd(p1, p2, x1, ...), a BINARY gcd
   plus optional POLYNOMIAL VARIABLES, not a variadic numeric gcd: three
   or more numeric arguments (apply("gcd", [1,3,2])) fail "gcd: improper
   argument: 2" (2 is read as a variable spec). lcm(expr1, ..., exprn)
   (functs) IS genuinely variadic, so apply("lcm", ...) is fine for any
   length; gcd is folded pairwise instead, lreduce("gcd", ...) (the
   quoted-string form again -- lreduce(gcd, ...), unquoted, hits the
   same value-cell trap and silently builds spmod(spmod(...),...)
   nouns). */
%mr_commonFactors(%mr_cf_lst) := block(
  [%mr_cf_lst1, %mr_cf_lst2, %mr_cf_lst3, %mr_cf_lst4, %mr_cf_bases,
   %mr_cf_common, %mr_cf_base, %mr_cf_num, %mr_cf_isLog, %mr_cf_ratios,
   %mr_cf_i, %mr_cf_dummy, %mr_cf_result, %mr_cf_e, %mr_cf_p, %mr_cf_q],
  %mr_cf_lst1 : map(%mr_nonabsurdNumberFactors, %mr_cf_lst),
  %mr_cf_lst2 : map(%mr_absurdNumberFactors, %mr_cf_lst),
  %mr_cf_num : %mr_absurdNumberGCD(%mr_cf_lst2),
  %mr_cf_common : %mr_cf_num,
  %mr_cf_lst2 : map(lambda([%mr_cf_e], %mr_cf_e / %mr_cf_num), %mr_cf_lst2),
  %mr_cf_result : for %mr_cf_dummy : 1 while true do (
    %mr_cf_lst3 : map(%mr_leadFactor, %mr_cf_lst1),
    if %mr_everyQ(lambda([%mr_cf_e], is(%mr_cf_e = first(%mr_cf_lst3))), %mr_cf_lst3)
    then (
      %mr_cf_common : %mr_cf_common * first(%mr_cf_lst3),
      %mr_cf_lst1 : map(%mr_remainingFactors, %mr_cf_lst1)
    )
    else (
      %mr_cf_isLog : false,
      if %mr_everyQ(lambda([%mr_cf_e],
                           %mr_logQ(%mr_cf_e)
                             and integerp(first(%mr_args_in(%mr_cf_e)))
                             and is(first(%mr_args_in(%mr_cf_e)) > 0)),
                    %mr_cf_lst3)
      then (
        %mr_cf_ratios : map(lambda([%mr_cf_e],
                                    %mr_logRatio(first(%mr_args_in(%mr_cf_e)),
                                                 first(%mr_args_in(first(%mr_cf_lst3))))),
                             %mr_cf_lst3),
        if %mr_everyQ(%mr_rationalQ, %mr_cf_ratios) then %mr_cf_isLog : true
      ),
      if %mr_cf_isLog then (
        %mr_cf_num : lreduce("gcd", map(num, %mr_cf_ratios)) / apply("lcm", map(denom, %mr_cf_ratios)),
        %mr_cf_common : %mr_cf_common
          * log(first(%mr_args_in(first(%mr_cf_lst3))) ^ %mr_cf_num),
        %mr_cf_lst2 : map(lambda([%mr_cf_p, %mr_cf_q], %mr_cf_p * %mr_cf_q / %mr_cf_num),
                           %mr_cf_lst2, %mr_cf_ratios),
        %mr_cf_lst1 : map(%mr_remainingFactors, %mr_cf_lst1)
      )
      else (
        %mr_cf_lst4 : map(%mr_leadDegree, %mr_cf_lst1),
        %mr_cf_bases : map(%mr_leadBase, %mr_cf_lst1),
        if %mr_everyQ(lambda([%mr_cf_e], is(%mr_cf_e = first(%mr_cf_bases))), %mr_cf_bases)
           and %mr_everyQ(%mr_rationalQ, %mr_cf_lst4)
        then (
          %mr_cf_num : %mr_smallestList(%mr_cf_lst4),
          %mr_cf_base : first(%mr_cf_bases),
          if not is(%mr_cf_num = 0) then %mr_cf_common : %mr_cf_common * %mr_cf_base ^ %mr_cf_num,
          %mr_cf_lst2 : map(lambda([%mr_cf_p, %mr_cf_q], %mr_cf_p * %mr_cf_base ^ (%mr_cf_q - %mr_cf_num)),
                             %mr_cf_lst2, %mr_cf_lst4),
          %mr_cf_lst1 : map(%mr_remainingFactors, %mr_cf_lst1)
        )
        elseif is(length(%mr_cf_lst1) = 2)
           and %mr_eqQ(first(%mr_cf_bases) + second(%mr_cf_bases), 0)
           and %mr_neQ(first(%mr_cf_lst1), 1)
           and integerp(first(%mr_cf_lst4))
           and %mr_fractionQ(second(%mr_cf_lst4))
        then (
          %mr_cf_num : min(first(%mr_cf_lst4), second(%mr_cf_lst4)),
          %mr_cf_base : second(%mr_cf_bases),
          if not is(%mr_cf_num = 0) then %mr_cf_common : %mr_cf_common * %mr_cf_base ^ %mr_cf_num,
          %mr_cf_lst2 : [first(%mr_cf_lst2) * (-1) ^ first(%mr_cf_lst4), second(%mr_cf_lst2)],
          %mr_cf_lst2 : map(lambda([%mr_cf_p, %mr_cf_q], %mr_cf_p * %mr_cf_base ^ (%mr_cf_q - %mr_cf_num)),
                             %mr_cf_lst2, %mr_cf_lst4),
          %mr_cf_lst1 : map(%mr_remainingFactors, %mr_cf_lst1)
        )
        elseif is(length(%mr_cf_lst1) = 2)
           and %mr_eqQ(first(%mr_cf_bases) + second(%mr_cf_bases), 0)
           and %mr_neQ(second(%mr_cf_lst1), 1)
           and integerp(second(%mr_cf_lst4))
           and %mr_fractionQ(first(%mr_cf_lst4))
        then (
          %mr_cf_num : min(first(%mr_cf_lst4), second(%mr_cf_lst4)),
          %mr_cf_base : first(%mr_cf_bases),
          if not is(%mr_cf_num = 0) then %mr_cf_common : %mr_cf_common * %mr_cf_base ^ %mr_cf_num,
          %mr_cf_lst2 : [first(%mr_cf_lst2), second(%mr_cf_lst2) * (-1) ^ second(%mr_cf_lst4)],
          %mr_cf_lst2 : map(lambda([%mr_cf_p, %mr_cf_q], %mr_cf_p * %mr_cf_base ^ (%mr_cf_q - %mr_cf_num)),
                             %mr_cf_lst2, %mr_cf_lst4),
          %mr_cf_lst1 : map(%mr_remainingFactors, %mr_cf_lst1)
        )
        else (
          %mr_cf_num : %mr_mostMainFactorPosition(%mr_cf_lst3),
          %mr_cf_lst2 : makelist(
                          if %mr_cf_i = %mr_cf_num
                          then part(%mr_cf_lst3, %mr_cf_num) * part(%mr_cf_lst2, %mr_cf_num)
                          else part(%mr_cf_lst2, %mr_cf_i),
                          %mr_cf_i, 1, length(%mr_cf_lst2)),
          %mr_cf_lst1 : makelist(
                          if %mr_cf_i = %mr_cf_num
                          then %mr_remainingFactors(part(%mr_cf_lst1, %mr_cf_num))
                          else part(%mr_cf_lst1, %mr_cf_i),
                          %mr_cf_i, 1, length(%mr_cf_lst1))
        )
      )
    ),
    if %mr_everyQ(lambda([%mr_cf_e], is(%mr_cf_e = 1)), %mr_cf_lst1)
    then return(cons(%mr_cf_common, %mr_cf_lst2))
  ),
  %mr_cf_result)$

/* ==== Section 9 (9.2 + 9.3) utilities: spec 2026-09-22 ==== */

/* Rubi :4169-4175  FunctionOfLinear[u,x] — if u(x) is equivalent to an
   expression of the form f(a+b*x) and not the case a=0, b=1, returns
   [f(x),a,b]; else false. The With[{lst=...}] binding is the aux call
   below with the initial a/b/flag all false. */
%mr_functionOfLinear(%mr_fol_u, x) := block([inflag : true, %mr_fol_lst],
  %mr_fol_lst : %mr_functionOfLinearAux(%mr_fol_u, false, false, x, false),
  if atom(%mr_fol_lst) or %mr_falseQ(first(%mr_fol_lst))
     or (is(first(%mr_fol_lst) = 0) and is(second(%mr_fol_lst) = 1))
  then false
  else [%mr_functionOfLinearSubst(%mr_fol_u, first(%mr_fol_lst), second(%mr_fol_lst), x),
        first(%mr_fol_lst), second(%mr_fol_lst)])$

/* Rubi :4176-4205  FunctionOfLinear[u,a,b,x,flag] — the 5-arg overload:
   thread a running [a,b] pair through u's structure until every leaf is
   free of x or the pattern fails (an atom result signals failure and the
   Catch/Scan of :4198-4202 short-circuits the whole call to False; ported
   as the inner block's early return(false), which return exits, matching
   the Catch/Throw). The PowerQ branch (:4193-4194) recurses on
   Log[u[[1]]]*u[[2]] when the base is free of x. The :4196-4199
   ProductQ/MonomialFactor branch's true arm is dead code upstream
   (If[False && ...] always falls to its own else, False) — not ported;
   only the false-arm's decline (ProductQ[u] and a nonzero monomial
   degree) is kept. */
%mr_functionOfLinearAux(%mr_fola_u, %mr_fola_a, %mr_fola_b, x, %mr_fola_flag) := block(
  [inflag : true, %mr_fola_lst, %mr_fola_e, %mr_fola_sflag],
  if freeof(x, %mr_fola_u) then [%mr_fola_a, %mr_fola_b]
  elseif %mr_calculusQ(%mr_fola_u) then false
  elseif %mr_linearQ(%mr_fola_u, x) then (
    /* WORKAROUND (ticket .scratch/class-ports/issues/10-mr-coeff-drops-
       nonatomic-constant-terms.md): %mr_coeff(u,x,0) drops a degree-0
       term that is x-free but not an atom (e.g. log(4) in log(4)*(2*x+1),
       the exact form the PowerQ branch below recurses into for a
       non-%e base) -- MEASURED, %mr_coeff(log(4)+x,x,0) = 0. ratcoef(u,
       x,n), verified on this file's actual cases (a symbolic a+b*x, an
       integer 2+3*x, the log(4)*(2*x+1) product form, and an %e-bearing
       constant/coefficient), gives the correct degree-0 and degree-1
       terms in every case and is used here in %mr_coeff's place; u is
       already gated %mr_linearQ so ratcoef's polynomial-in-x reading
       applies. Do not carry this substitution to any other port -- the
       general fix belongs to ticket 10. */
    if %mr_falseQ(%mr_fola_a) then
      [ratcoef(%mr_fola_u, x, 0), ratcoef(%mr_fola_u, x, 1)]
    else (
      %mr_fola_lst : %mr_commonFactors([%mr_fola_b, ratcoef(%mr_fola_u, x, 1)]),
      if %mr_eqQ(ratcoef(%mr_fola_u, x, 0), 0) and not %mr_fola_flag
        then [0, first(%mr_fola_lst)]
      elseif %mr_eqQ(%mr_fola_b * ratcoef(%mr_fola_u, x, 0)
                       - %mr_fola_a * ratcoef(%mr_fola_u, x, 1), 0)
        then [%mr_fola_a / second(%mr_fola_lst), first(%mr_fola_lst)]
      else [0, 1]
    )
  )
  elseif %mr_powerQ(%mr_fola_u) and freeof(x, part(%mr_fola_u, 1)) then
    %mr_functionOfLinearAux(log(part(%mr_fola_u, 1)) * part(%mr_fola_u, 2),
                             %mr_fola_a, %mr_fola_b, x, false)
  else (
    %mr_fola_lst : if %mr_productQ(%mr_fola_u) then %mr_monomialFactor(%mr_fola_u, x)
                   else [0, %mr_fola_u],
    if %mr_productQ(%mr_fola_u) and %mr_neQ(first(%mr_fola_lst), 0) then false
    else (
      %mr_fola_sflag : %mr_sumQ(%mr_fola_u),
      block([%mr_fola_acc : [%mr_fola_a, %mr_fola_b]],
        for %mr_fola_e in %mr_args_in(%mr_fola_u) do (
          %mr_fola_acc : %mr_functionOfLinearAux(%mr_fola_e, first(%mr_fola_acc),
                                                  second(%mr_fola_acc), x, %mr_fola_sflag),
          if atom(%mr_fola_acc) then return(false)
        ),
        %mr_fola_acc)
    )
  ))$

/* Rubi :4206-4222  FunctionOfLinearSubst[u,a,b,x] — substitutes x back
   into u = f(a+b*x) to recover f(x). The PowerQ branch's E^FullSimplify[
   ...] (:4213) is %e^ratsimp(...) (the brief's exact reading: this
   occurrence, unlike CommonFactors' log-ratio gate, is a plain rational
   simplification of an additive/multiplicative exponent expression,
   which ratsimp closes). Map[Function[...],u] (:4219) under inflag : true
   is apply(op(u), map(...)), the house idiom (this file's line ~3582). */
%mr_functionOfLinearSubst(%mr_fols_u, %mr_fols_a, %mr_fols_b, x) := block(
  [inflag : true, %mr_fols_lst, %mr_fols_tmp],
  if freeof(x, %mr_fols_u) then %mr_fols_u
  elseif %mr_linearQ(%mr_fols_u, x) then (
    /* WORKAROUND (ticket 10, same as %mr_functionOfLinearAux above):
       ratcoef(u,x,n) in place of %mr_coeff(u,x,n), u already gated
       %mr_linearQ. */
    %mr_fols_tmp : ratcoef(%mr_fols_u, x, 1),
    %mr_fols_tmp : if is(%mr_fols_tmp = %mr_fols_b) then 1 else %mr_fols_tmp / %mr_fols_b,
    ratcoef(%mr_fols_u, x, 0) - %mr_fols_a * %mr_fols_tmp + %mr_fols_tmp * x
  )
  elseif %mr_powerQ(%mr_fols_u) and freeof(x, part(%mr_fols_u, 1)) then
    %e ^ ratsimp(%mr_functionOfLinearSubst(log(part(%mr_fols_u, 1)) * part(%mr_fols_u, 2),
                                            %mr_fols_a, %mr_fols_b, x))
  else (
    %mr_fols_lst : if %mr_productQ(%mr_fols_u) then %mr_monomialFactor(%mr_fols_u, x)
                   else [0, %mr_fols_u],
    if %mr_productQ(%mr_fols_u) and %mr_neQ(first(%mr_fols_lst), 0) then (
      if %mr_rationalQ(%mr_leadFactor(second(%mr_fols_lst)))
         and is(%mr_leadFactor(second(%mr_fols_lst)) < 0)
      then -%mr_functionOfLinearSubst(
              %mr_divideDegreesOfFactors(-second(%mr_fols_lst), first(%mr_fols_lst)) * x,
              %mr_fols_a, %mr_fols_b, x) ^ first(%mr_fols_lst)
      else %mr_functionOfLinearSubst(
              %mr_divideDegreesOfFactors(second(%mr_fols_lst), first(%mr_fols_lst)) * x,
              %mr_fols_a, %mr_fols_b, x) ^ first(%mr_fols_lst)
    )
    else apply(op(%mr_fols_u),
               map(lambda([%mr_fols_e], %mr_functionOfLinearSubst(%mr_fols_e, %mr_fols_a, %mr_fols_b, x)),
                   %mr_args_in(%mr_fols_u)))
  ))$

mr_witness_utils() := true$
