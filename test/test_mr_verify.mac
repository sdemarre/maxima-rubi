/* test/test_mr_verify.mac -- unit tests for the corpus checker's proof
   module (test/mr_verify.mac + test/mr_verify.lisp;
   .scratch/corpus-harness/issues/06). No rule files are loaded: every
   residual below is synthetic, identically zero (or deliberately not), and
   frozen, so the suite depends on neither the rule set nor the corpus --
   the lesson of .scratch/corpus-harness/issues/03, whose corpus-entry
   witnesses rotted when a rule change stopped them reaching the checker.
   From the repo root:
     maxima --very-quiet -b test/test_mr_verify.mac < /dev/null
   Ends with a Results: line; a missing Results line is a failure. */
display2d : false$

tests_passed : 0$
tests_failed : 0$

check(test_name, actual, expected) := block([],
  if actual = expected then (
    tests_passed : tests_passed + 1,
    print("  PASS: ", test_name)
  ) else (
    tests_failed : tests_failed + 1,
    print("  FAIL: ", test_name),
    print("    expected: ", expected),
    print("    actual:   ", actual)
  ),
  true)$

check_bool(test_name, actual) := block([v],
  v : is(actual),
  if v = true then (
    tests_passed : tests_passed + 1,
    print("  PASS: ", test_name)
  ) else (
    tests_failed : tests_failed + 1,
    print("  FAIL: ", test_name),
    print("    actual:   ", actual)
  ),
  true)$

load("test/mr_verify.mac")$

/* ---- witnesses: one identically-zero residual per symbolic stage ----
   Measured 2026-09-28 (branch_5_50_base_84_g4204fb669, SBCL 2.6.7): each
   is closed by its own stage and by no stage ahead of it in
   mr_proof_stages, so the full chain reports exactly that stage. */
w_chain  : (x^2-1)/(x-1) - (x+1)$
w_radcan : log(a*x) - log(a) - log(x)$
w_exp    : sinh(x) - (%e^x - %e^-x)/2$
w_rect   : (-1)^(1/4)*x - (1+%i)/sqrt(2)*x$
w_trig   : sin(2*atan(x)) - 2*x/(1+x^2)$
w_logarc : %e^(asinh(x)) - (x+sqrt(x^2+1))$
/* Euler's reflection formula for li[2]: zero, but no symbolic stage
   proves it; the numeric check does (x = 0.35 / 0.65). */
w_numeric : li[2](x) + li[2](1-x) - (%pi^2/6 - log(x)*log(1-x))$
/* not zero */
w_wrong : sin(x) - x$

/* ---- 1. the stage order ----
   rectform LAST (2026-09-29, probes/verify-stages/08-stage-order.out): the
   order changes no verdict, but run third its heap garbage stopped the
   stages after it. */
check("stage order: chains, radcan family, rat fallback, rectform",
  mr_proof_stages,
  ["chainA.1", "chainA.2", "chainA.3", "chainA.4",
   "chainB.1", "chainB.2", "chainB.3", "chainB.4",
   "radcan", "exponentialize", "trigexpand", "demoivre",
   "logarc", "rat-radcan", "rectform"])$

/* ---- 2. the full chain names the first stage that proves it ---- */
check("chain A proves a rational residual", mr_proof(w_chain, x), "chainA.1")$
check("radcan proves a log residual", mr_proof(w_radcan, x), "radcan")$
check("exponentialize proves a hyperbolic residual", mr_proof(w_exp, x), "exponentialize")$
check("rectform proves a root-of-unity residual", mr_proof(w_rect, x), "rectform")$
check("trigexpand proves sin(2*atan(x))", mr_proof(w_trig, x), "trigexpand")$
check("logarc proves %e^asinh(x)", mr_proof(w_logarc, x), "logarc")$

/* ---- 3. symbolic stages fail -> the numeric check, named as such ---- */
check("numeric check closes the li[2] reflection", mr_proof(w_numeric, x), "numeric")$
check("a wrong residual is not proved, numeric mismatch",
  mr_proof(w_wrong, x), "none/numeric-mismatch")$
/* n is not a sweep parameter: the float carries it, the check declines */
check("a free non-sweep symbol makes the numeric check decline",
  mr_proof(sin(n*x) - n*x, x), "none/numeric-declined")$

/* ---- 4. single stages, in isolation (the third argument) ---- */
check("demoivre alone proves %e^(%i*asin(x))",
  mr_proof(%e^(%i*asin(x)) - (sqrt(1-x^2) + %i*x), x, ["demoivre"]), "demoivre")$
check("rat-radcan alone proves %e^(n*log(x)) - x^n",
  mr_proof(%e^(n*log(x)) - x^n, x, ["rat-radcan"]), "rat-radcan")$
/* the elliptic gate the rat-radcan stage has carried since 2026-08-28 */
check("rat-radcan is gated off an elliptic residual",
  mr_proof(elliptic_f(x, 1/2)*(%e^(n*log(x)) - x^n), x, ["rat-radcan"]),
  "none/numeric-declined")$
check("an empty stage list goes straight to the numeric check",
  mr_proof(w_numeric, x, []), "numeric")$

/* ---- 5. the numeric check on its own ---- */
check("numeric check: ok", mr_numeric_check(w_numeric, x), "ok")$
check("numeric check: mismatch", mr_numeric_check(w_wrong, x), "mismatch")$
check("numeric check: declined", mr_numeric_check(sin(n*x) - n*x, x), "declined")$
/* a domain error at a test point declines rather than failing the chain */
check("numeric check: 1/0 at a test point declines",
  mr_numeric_check(1/(x - 0.35) - 1/(x - 7/20), x), "declined")$

/* reading the float value can raise too: realpart/cabs of a float
   hypergeometric with a pole parameter (c = 2 - log(4)/log(2) -> 0.0) signal
   `pquotient: attempted quotient by zero' AFTER the guarded evaluation
   (2 Exponentials 2.3 e477, 2026-09-28: the entry died, class error) */
check("numeric check: an error while reading the value declines",
  mr_numeric_check(hypergeometric([2, 1-log(4)/log(2)], [2-log(4)/log(2)], -x) + x, x),
  "declined")$
/* li[2] of a complex argument not in a + b*%i form stays unevaluated under
   float; the check rectforms li arguments first (5.4.1 e18, 2026-09-28) */
check("numeric check: li[2] of a non-rectform complex argument evaluates",
  mr_numeric_check(li[2](2/(%i*x-1)+1) - li[2](1-2/(1-%i*x)), x), "ok")$

/* ---- 6. per-stage CPU limit ---- */
/* A stage that runs past mr_stage_cap is abandoned and the chain moves on.
   factor((x+y+z+1)^60 - 1) runs for seconds (measured 2026-09-28); radcan
   of the same residual returns at once. The residual is not zero, so the
   call ends at the numeric check, well inside a few stage caps of CPU. */
block([mr_stage_cap : 0.3, t0, tag, dt],
  t0 : elapsed_run_time(),
  tag : mr_proof((x+y+z+1)^60 - 1, x, ["chainA.1", "chainA.2", "radcan"]),
  dt : elapsed_run_time() - t0,
  check_bool("a stage over its CPU limit is abandoned", dt < 3),
  check("the abandoned stage is named; its chain's next stage is skipped",
        tag, "none/numeric-declined/timeout:chainA.1"))$
check("mr_cpu_timed returns the value in a list", mr_cpu_timed(1+1, 2), [2])$
check("mr_cpu_timed returns timeout past its limit",
  mr_cpu_timed(factor(expand((x+y+z+1)^60) - 1), 0.2), 'timeout)$

:lisp (defun mr-test-foreign-ticks (n) (let ((th (sb-thread:make-thread (lambda () (dotimes (i n) (sleep 0.0005) (mr-vtalrm-handler nil nil nil)))))) (prog1 (loop for i below 200000000 sum i) (sb-thread:join-thread th :timeout 10 :default nil))))
/* The timer signal is process-directed, and SBCL starts a finalizer thread
   lazily: a tick can land in that thread (4.1.7 e516, 2026-09-28: the
   handler ran there, read the unbound tick count as 0, signalled the
   timeout in the wrong thread and dropped it into that thread's debugger).
   A foreign tick is forwarded to the thread that armed the timer; a tick
   while no stage is running is ignored. The witness: 300 foreign ticks
   (0.5 ms apart, the real rate is one per 20 ms) against a 5 s limit of
   250 ticks, on a loop of about a second -- it times out only if the
   foreign ticks are counted. */
check("a tick from another thread reaches the timed stage",
  mr_cpu_timed(?mr\-test\-foreign\-ticks(300), 5), 'timeout)$
check("a tick while no stage runs is ignored",
  block([errormsg : false], errcatch(?mr\-vtalrm\-handler(false, false, false), 1)), [1])$

/* A stage that allocates past mr_heap_fraction of the dynamic space is
   abandoned: heap exhaustion is FATAL in SBCL (4.5.1.2 e714, 2026-09-28: a
   radcan-family stage filled the 1 GB heap inside its 5 s and the entry
   died in ldb). makelist of 2*10^8 conses needs ~3 GB. */
check("mr_cpu_timed returns heaplimit before the heap is exhausted",
  mr_cpu_timed(length(makelist(i, i, 1, 2*10^8)), 60), 'heaplimit)$
check("the heap is usable again afterwards", length(makelist(i, i, 1, 10^5)), 10^5)$


/* mr_heap_fraction 0: every tick reads "over the limit", so the first stage
   that runs past one 20 ms tick is abandoned as a heap stop, named with
   (heap) in the tag, and the chain goes on */
block([mr_heap_fraction : 0.0, tag],
  tag : mr_proof((x+y+z+1)^60 - 1, x, ["chainA.1"]),
  check("a stage stopped by the heap guard is named (heap)",
        is(ssearch("chainA.1(heap)", tag) # false), true))$

/* ---- 7. a stage that errors does not end the chain ---- */
check("an erroring stage is survived and the next stage still runs",
  mr_proof(w_radcan, x, ["no-such-stage", "radcan"]), "radcan")$

printf(true, "Results: ~d passed, ~d failed~%", tests_passed, tests_failed)$
