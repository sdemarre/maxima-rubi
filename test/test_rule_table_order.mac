/* test/test_rule_table_order.mac -- the bare-u_ tail-position gate on the
 * REAL loaded table (inert-trig substrate design 3.3, Task 8 fix round 1;
 * ledger R21).
 *
 * test_maxima_rubi.mac's "tail records are last in the table" target
 * (test_load_and_api) only ever sees the eager milestone-1 core stand-in
 * (mr_rule_table_body_handles = mr_rules_1_1_1_1, tail = []) -- Layer A
 * never calls mr_load_all(), by design (later Layer A targets depend on
 * the rule table's contents at their point in the suite, so mr_load_all()
 * must not run inside test_maxima_rubi.mac). That makes the Layer A target
 * permanently vacuous on the real table: nothing committed checked the
 * ordering of the table mr_load_all() actually builds, which is the
 * guarantee Task 9's end-to-end acceptance depends on. This file is that
 * check, kept OUTSIDE Layer A.
 *
 * From the repo root:  maxima --very-quiet -b test/test_rule_table_order.mac
 * Ends with a Results: line; a missing Results line is a failure. */
display2d : false$

tests_passed : 0$
tests_failed : 0$

check_bool(test_name, actual) := block([v],
  v : is(actual),
  if v = true then (
    tests_passed : tests_passed + 1,
    print("  PASS: ", test_name)
  ) else (
    tests_failed : tests_failed + 1,
    print("  FAIL: ", test_name),
    print("    actual:   ", actual)
  ),
  true)$

load("maxima_rubi.mac")$
mr_load_all()$

/* The same structural definition generator/generate_rules.py's
   bare_int_clause and test/check_generated_rules.py's INT_BARE_U check
   statically, replayed here against %mr_rule_pattern_text(handle) -- the
   rule's ORIGINAL pattern string, off the LIVE loaded table, not the
   source files on disk. A bare-u_ Int record's pattern is exactly
   "(Int (Pattern <name> (Blank)) (Pattern x (Blank Symbol)))"; <name> is
   either a bare word or a |piped| name with no nested structure, so ruling
   out any "(", ")" or " " in the middle segment is enough to rule out
   every other (structured) pattern accidentally sharing the prefix/suffix
   -- every non-bare pattern has more structure between them, which always
   introduces at least one of those three characters. */
mr_bare_u_pattern_p(mr_pat) := block([mr_pre, mr_suf, mr_ln, mr_pn, mr_sn, mr_mid],
  mr_pre : "(Int (Pattern ",
  mr_suf : " (Blank)) (Pattern x (Blank Symbol)))",
  mr_ln : slength(mr_pat),
  mr_pn : slength(mr_pre),
  mr_sn : slength(mr_suf),
  if mr_ln <= mr_pn + mr_sn then false
  elseif substring(mr_pat, 1, mr_pn + 1) # mr_pre then false
  elseif substring(mr_pat, mr_ln - mr_sn + 1, mr_ln + 1) # mr_suf then false
  else (
    mr_mid : substring(mr_pat, mr_pn + 1, mr_ln - mr_sn + 1),
    is(slength(mr_mid) > 0) and is(ssearch("(", mr_mid) = false)
      and is(ssearch(")", mr_mid) = false)
      and is(ssearch(" ", mr_mid) = false)
  ))$

/* The closed, named exception list (generator/generate_rules.py
   BARE_U_BODY_EXCEPTIONS, test/check_generated_rules.py's copy of the
   same six pairs, .scratch/class-ports/issues/07-bare-u-records-mid-
   table.md) -- looked up here by the Maxima globals each generated file
   binds its handle to, not re-derived. */
mr_exception_handles : [
  _mr_rule_1_4_1_r7, _mr_rule_1_4_1_r8,
  _mr_rule_9_1_r8, _mr_rule_9_1_r13,
  _mr_rule_2_3_r96, _mr_rule_3_5_r42
]$

check_bool("both handle lists are defined lists and the body list is non-empty",
  listp(mr_rule_table_body_handles) and listp(mr_rule_table_tail_handles)
  and length(mr_rule_table_body_handles) > 0)$

check_bool("mr_rule_table = body handles followed by tail handles, nothing lost",
  is(mr_rule_table = append(mr_rule_table_body_handles, mr_rule_table_tail_handles))
  and is(length(mr_rule_table) = length(mr_rule_table_body_handles)
                                  + length(mr_rule_table_tail_handles)))$

/* Task 9 (ledger R19/R21): the tail is no longer empty -- class 4's
   inert-trig bridge subset put the first real _tail lists in it, so the
   ordering check below is no longer vacuous. These two pin WHAT the tail
   holds: non-empty, and exactly the eight bridge records in Rubi LoadRules
   order (4.1.0.1's DeactivateTrig bridge first, then 4.7.5's catch-alls in
   source order: the five Subst forms, r71 -- the half-angle Weierstrass
   substitution, Task 10 -- and r72, the re-activating CannotIntegrate
   give-up (Task 10 fix round 1, ruling R26), which is 4.7.5's last record),
   followed by section 9.3's eleven bare-u_ records in file order (Task 11,
   spec 3.2/A3), r67 -- Rubi's own final CannotIntegrate catch-all -- last
   and closing the tail) -- a _tail list mr_load_all forgot to name in its
   tail flatten, or named in the wrong order, fails here. */
check_bool("the tail is non-empty",
  is(length(mr_rule_table_tail_handles) > 0))$

/* Class 8 (2026-09-25): 8.9's bare-u_ record r44 (Int[u_, x] /;
   FunctionOfQ[ProductLog[x], u, x]) sits between class 4's bridge records
   and 9.3's, section 8 loading after section 4 and before 9.3. */
check_bool("the tail is the eight bridge records, then 8.9 r44, then 9.3's eleven, in load order",
  is(mr_rule_table_tail_handles =
     [_mr_rule_4_1_0_1_r1,
      _mr_rule_4_7_5_r21, _mr_rule_4_7_5_r22, _mr_rule_4_7_5_r47,
      _mr_rule_4_7_5_r48, _mr_rule_4_7_5_r58, _mr_rule_4_7_5_r71,
      _mr_rule_4_7_5_r72,
      _mr_rule_8_9_r44,
      _mr_rule_9_3_r9, _mr_rule_9_3_r37, _mr_rule_9_3_r38, _mr_rule_9_3_r51,
      _mr_rule_9_3_r55, _mr_rule_9_3_r56, _mr_rule_9_3_r57, _mr_rule_9_3_r62,
      _mr_rule_9_3_r63, _mr_rule_9_3_r66, _mr_rule_9_3_r67]))$

/* r72 answers Rubi's give-up marker, so the dispatcher's mr_giveup_last
   second pass holds it back as well; 9.3's r67 is Rubi's own final
   CannotIntegrate catch-all, so it is the tail's other give-up record --
   nothing re-orders the tail's other nine around either of them. */
check_bool("the tail's give-ups are 4.7.5 r72 then 9.3 r67 (Rubi's final catch-all)",
  is(%mr_giveup_handles(mr_rule_table_tail_handles) = [_mr_rule_4_7_5_r72, _mr_rule_9_3_r67]))$
/* Ticket 14: the dispatcher's last-resort tier (mr_last_resort_tier)
   reads the per-rule tail MARK mr_load_all sets with %mr_mark_tail, not
   the list -- so the marked set must be exactly the tail list. */
check_bool("the rules marked as tail are exactly mr_rule_table_tail_handles",
  is(%mr_tail_handles(mr_rule_table) = mr_rule_table_tail_handles))$
check_bool("the rules marked as general are exactly 9.3's body",
  is(%mr_general_handles(mr_rule_table) = mr_rules_9_3))$
check_bool("9.3 r67 is the last record of the table",
  is(last(mr_rule_table) = _mr_rule_9_3_r67))$

/* The converse of the universal cross-check below: nothing but a bare-u_
   record may sit in the tail (a specific record there would be tried after
   every catch-all, i.e. too late). */
check_bool("every tail handle's pattern is a bare-u_ Int pattern",
  every(lambda([mr_h], mr_bare_u_pattern_p(%mr_rule_pattern_text(mr_h))),
        mr_rule_table_tail_handles))$

/* Spec 2026-09-22 A3: 9.3 interleaves -- body records r64/r65 follow
   tail record r63 in the file, so REGISTRATION order no longer matches
   table order. The dispatcher walks list order (%mr_dispatch_tree), so
   that is the order asserted. */
mr_nbody : length(mr_rule_table_body_handles)$
check_bool("every tail handle sits after every body handle in the table",
  every(lambda([mr_h], is(first(sublist_indices(mr_rule_table, lambda([mr_g], mr_g = mr_h))) > mr_nbody)),
        mr_rule_table_tail_handles))$

/* Spec 3.2: 9.2's body right after class 1 (whose last list is the
   legacy 9_1) and before class 2; 9.3's body is the last body entry. */
mr_pos(mr_h) := first(sublist_indices(mr_rule_table, lambda([mr_g], mr_g = mr_h)))$
check_bool("9.2's body follows 9.1 (legacy) and precedes class 2",
  is(mr_pos(first(mr_rules_9_2)) = mr_pos(last(mr_rules_9_1)) + 1)
  and is(mr_pos(last(mr_rules_9_2)) + 1 = mr_pos(first(mr_rules_2_1))))$
check_bool("9.3's body is the last body entry",
  is(last(mr_rule_table_body_handles) = last(mr_rules_9_3)))$
/* Class 8 (2026-09-25): its nine bodies in Rubi.m order, then 9.1
   Derivative (9_1d), contiguous, after class 6 and before 9.3's body. */
check_bool("class 8's bodies (8.1..8.9) then 9.1 Derivative follow class 6 and precede 9.3",
  is(mr_pos(first(mr_rules_8_1)) > mr_pos(last(mr_rules_6_7_9)))
  and is(sublist(mr_rule_table, lambda([mr_h],
            member(mr_h, flatten([mr_rules_8_1, mr_rules_8_2, mr_rules_8_3,
                                  mr_rules_8_4, mr_rules_8_5, mr_rules_8_6,
                                  mr_rules_8_7, mr_rules_8_8, mr_rules_8_9,
                                  mr_rules_9_1d]))))
         = flatten([mr_rules_8_1, mr_rules_8_2, mr_rules_8_3, mr_rules_8_4,
                    mr_rules_8_5, mr_rules_8_6, mr_rules_8_7, mr_rules_8_8,
                    mr_rules_8_9, mr_rules_9_1d]))
  and is(mr_pos(last(mr_rules_9_1d)) + 1 = mr_pos(first(mr_rules_9_3))))$
/* Class 5 (2026-09-25): its fifteen bodies in Rubi.m order (5.1.1 ..
   5.5.2), contiguous, right after class 3's last list (3_5) and right
   before class 6's first (6_1_10) -- section 5 loads after section 4
   (whose ported bridge bodies are empty) and before section 6. Class 5
   has no bare-u_ record, so the tail is unchanged. */
mr_c5_lists : [mr_rules_5_1_1, mr_rules_5_1_2, mr_rules_5_1_3, mr_rules_5_1_4,
               mr_rules_5_1_5, mr_rules_5_1_6, mr_rules_5_3_1, mr_rules_5_3_2,
               mr_rules_5_3_3, mr_rules_5_3_4, mr_rules_5_3_5, mr_rules_5_3_6,
               mr_rules_5_3_7, mr_rules_5_5_1, mr_rules_5_5_2]$
check_bool("class 5's bodies (5.1.1..5.5.2) follow class 3 and precede class 6, contiguous",
  is(mr_pos(first(mr_rules_5_1_1)) = mr_pos(last(mr_rules_3_5)) + 1)
  and is(sublist(mr_rule_table, lambda([mr_h], member(mr_h, flatten(mr_c5_lists))))
         = flatten(mr_c5_lists))
  and is(mr_pos(last(mr_rules_5_5_2)) + 1 = mr_pos(first(mr_rules_6_1_10)))
  and is(length(flatten(mr_c5_lists)) = 667))$
print("table length after mr_load_all: ", length(mr_rule_table))$

/* The universal cross-check, over EVERY handle mr_load_all() actually
   registered (3,903 at Task 8; 3,909 with Task 9's six; 3,910 with Task
   10's r71; 3,911 with r72; +86 with Task 11's 9.2/9.3): a bare-u_ record
   must be in the tail or be one of the six named exceptions -- anywhere
   else fails it. */
mr_bad_bare : sublist(mr_rule_table,
  lambda([mr_h],
    mr_bare_u_pattern_p(%mr_rule_pattern_text(mr_h))
    and not(member(mr_h, mr_rule_table_tail_handles))
    and not(member(mr_h, mr_exception_handles))))$
check_bool("every bare-u_ Int record in the loaded table is in the tail or a named exception",
  is(mr_bad_bare = []))$

print("")$
print("========================================")$
print("Results: ", tests_passed, " passed, ", tests_failed, " failed")$
print("========================================")$
