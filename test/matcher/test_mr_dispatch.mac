/* test/matcher/test_mr_dispatch.mac -- unit tests for the rule records, the
   dispatcher and the MatchQ entries (maxima_rubi_dispatch.lisp; matcher
   substrate spec sections 3.4-3.6). Synthetic rules only; loads the matcher,
   the converter, the utils and the dispatcher directly — no rule files, so
   no TLS flag (mr_top's mr_model_flags binding is pinned in Layer A).
   From the repo root:
     maxima --very-quiet -b test/matcher/test_mr_dispatch.mac
   Ends with a Results: line; a missing Results line is a failure. */
display2d : false$

tests_passed : 0$
tests_failed : 0$

check(test_name, actual, expected) := block([],
  if actual = expected then (
    tests_passed : tests_passed + 1,
    print("  PASS: ", test_name)
  ) else (
    tests_failed : tests_failed + 1,
    print("  FAIL: ", test_name),
    print("    expected: ", expected),
    print("    actual:   ", actual)
  ),
  true)$

check_bool(test_name, actual) := block([v],
  v : is(actual),
  if v = true then (
    tests_passed : tests_passed + 1,
    print("  PASS: ", test_name)
  ) else (
    tests_failed : tests_failed + 1,
    print("  FAIL: ", test_name),
    print("    actual:   ", actual)
  ),
  true)$

load("maxima_rubi_match.lisp")$
load("maxima_rubi_tree.lisp")$
load("maxima_rubi_utils.mac")$
load("maxima_rubi_dispatch.lisp")$

/* ---- synthetic conds and repls (the generated (mm, x) signature) ---- */
t_true(mm, x) := true$
t_false(mm, x) := false$
t_err(mm, x) := error("t_err: deliberate")$
t_unknown(mm, x) := tq > 0$
/* The fault guard catches any serious-condition a match signals. It is
   tested with a signalled storage-condition, not with runaway recursion:
   SBCL control-stack exhaustion is fatal ("Control stack exhausted while
   pseudo-atomic") when the guard page is hit inside an allocation, which
   a runaway Maxima recursion does (measured 2026-09-13, plan-2
   pre-validation) — the guard cannot make that case survivable. */
t_fault(mm, x) := ?error('?storage\-condition)$
t_42(mm, x) := 42$
t_7(mm, x) := 7$
t_m(mm, x) := geteqR(mm, '_t_m)$
t_u(mm, x) := geteqR(mm, '_t_u)$
t_leak(mm, x) := [1, true]$
t_half(mm, x) := is(geteqR(mm, '_t_p) = 1/2)$
t_p(mm, x) := geteqR(mm, '_t_p)$
t_inv(mm, x) := %mr_memberQ([asin, acos], geteqR(mm, '_t_F))$
t_app(mm, x) := apply(geteqR(mm, '_t_F), [2])$
t_flags(mm, x) := sconcat(radexpand, " ", logexpand)$
/* give-up replacements: they answer Rubi's Unintegrable marker, which is
   what mr-giveup-repl-p detects in the body at %mr_defrule time */
t_unint(mm, x) := mr_unintegrable(geteqR(mm, '_t_m), x)$
t_unint1(mm, x) := mr_unintegrable(1, x)$
t_unint2(mm, x) := mr_unintegrable(2, x)$

/* Int[x^m_., x] */
p_xm : "(Int (Power (Pattern x (Blank)) (Optional (Pattern |_t_m| (Blank)))) (Pattern x (Blank Symbol)))"$
/* Int[u_, x] */
p_u : "(Int (Pattern |_t_u| (Blank)) (Pattern x (Blank Symbol)))"$
/* Int[(a_.+b_.*x)^p_.*(c_.+d_.*x)^q_., x] -- two complete bindings on
   (1+2x)^3*(4+5x)^(1/2) */
p_two : "(Int (Times (Power (Plus (Optional (Pattern |_t_a| (Blank))) (Times (Optional (Pattern |_t_b| (Blank))) (Pattern x (Blank)))) (Optional (Pattern |_t_p| (Blank)))) (Power (Plus (Optional (Pattern |_t_c| (Blank))) (Times (Optional (Pattern |_t_d| (Blank))) (Pattern x (Blank)))) (Optional (Pattern |_t_q| (Blank))))) (Pattern x (Blank Symbol)))"$
/* Int[F_[x], x] */
p_head : "(Int ((Pattern |_t_F| (Blank)) (Pattern x (Blank))) (Pattern x (Blank Symbol)))"$

test_records() := block([h1, h2],
  print("--- rule records ---"),
  h1 : %mr_defrule("t", 1, p_xm, t_true, t_42),
  h2 : %mr_defrule("t", 2, p_xm, t_true, t_7),
  check_bool("%mr_defrule returns an integer handle", integerp(h1)),
  check("handles are consecutive", h2, h1 + 1),
  check("a pattern prepare rejects is a load error",
        errcatch(%mr_defrule("t", 3, "(Int (Alternatives (Pattern |_t_a| (Blank)) (Pattern |_t_b| (Blank))) (Pattern x (Blank Symbol)))", t_true, t_42)),
        []),
  check("a non-handle is an error", errcatch(%mr_rule_apply(10^9, x^3, x)), []),
  check("wrong arity is an error", errcatch(%mr_defrule("t", 4, p_xm, t_true)), []),
  check("switch defaults: mr_flat_wide false, mr_cond_retry true, mr_model_flags true",
        [mr_flat_wide, mr_cond_retry, mr_model_flags], [false, true, true]),
  true)$

test_dispatch() := block([h42, h7, hm, hdecl, hmis, hleak, hcf, hce, hcu, hfault],
  print("--- dispatcher: firing, order, outcomes ---"),
  h42 : %mr_defrule("t", 10, p_xm, t_true, t_42),
  h7 : %mr_defrule("t", 11, p_xm, t_true, t_7),
  hm : %mr_defrule("t", 12, p_xm, t_true, t_m),
  hdecl : %mr_defrule("t", 13, p_xm, t_true, t_false),
  hmis : %mr_defrule("t", 14, p_xm, t_true, t_err),
  hleak : %mr_defrule("t", 15, p_xm, t_true, t_leak),
  hcf : %mr_defrule("t", 16, p_xm, t_false, t_42),
  hce : %mr_defrule("t", 17, p_xm, t_err, t_42),
  hcu : %mr_defrule("t", 18, p_xm, t_unknown, t_42),
  hfault : %mr_defrule("t", 19, p_xm, t_fault, t_42),
  check("the firing rule's answer", %mr_dispatch_tree(x^3, x, [h42], 1), 42),
  check("first firing rule wins (order a)", %mr_dispatch_tree(x^3, x, [h42, h7], 1), 42),
  check("first firing rule wins (order b)", %mr_dispatch_tree(x^3, x, [h7, h42], 1), 7),
  check("no match -> false", %mr_dispatch_tree(sin(x), x, [h42], 1), false),
  check("empty table -> false", %mr_dispatch_tree(x^3, x, [], 1), false),
  check("binding reaches repl", %mr_dispatch_tree(x^3, x, [hm], 1), 3),
  check("Optional exponent default 1", %mr_dispatch_tree(x, x, [hm], 1), 1),
  check("x is pre-bound to the integration variable",
        %mr_dispatch_tree(y^3, x, [hm], 1), false),
  check("decline (repl false) -> next rule", %mr_dispatch_tree(x^3, x, [hdecl, h7], 1), 7),
  check("misfire (repl error) -> next rule", %mr_dispatch_tree(x^3, x, [hmis, h7], 1), 7),
  check("misfire (boolean leak) -> next rule", %mr_dispatch_tree(x^3, x, [hleak, h7], 1), 7),
  %mr_boolcheck : false,
  check("boolean leak passes with %mr_boolcheck false",
        %mr_dispatch_tree(x^3, x, [hleak, h7], 1), [1, true]),
  %mr_boolcheck : true,
  check("cond false -> next rule", %mr_dispatch_tree(x^3, x, [hcf, h7], 1), 7),
  check("cond error -> next rule", %mr_dispatch_tree(x^3, x, [hce, h7], 1), 7),
  check("cond unknown -> next rule", %mr_dispatch_tree(x^3, x, [hcu, h7], 1), 7),
  check("fault guard: a storage-condition signalled in cond -> next rule",
        %mr_dispatch_tree(x^3, x, [hfault, h7], 1), 7),
  check("the process survives the fault", %mr_dispatch_tree(x^3, x, [h42], 1), 42),
  check("fault type excludes interactive-interrupt",
        ?typep(?make\-condition(?intern("INTERACTIVE-INTERRUPT", "SB-SYS")), '?mr\-fault),
        false),
  check("fault type excludes timeout",
        ?typep(?make\-condition(?intern("TIMEOUT", "SB-EXT")), '?mr\-fault),
        false),
  check("fault type includes storage-condition",
        ?typep(?make\-condition('?storage\-condition), '?mr\-fault),
        true),
  true)$

/* Int[(g_.+h_.*x)*Sin[x], x] -- G-6: the narrow reading does not match
   h*x*sin(x); the wide reading binds g = 0, h = h */
p_wide : "(Int (Times (Plus (Optional (Pattern |_t_g| (Blank))) (Times (Optional (Pattern |_t_h| (Blank))) (Pattern x (Blank)))) (Sin (Pattern x (Blank)))) (Pattern x (Blank Symbol)))"$
t_h(mm, x) := geteqR(mm, '_t_h)$

test_bindings() := block([hu, hm, hr, hF, hw],
  print("--- dispatcher: bindings, retry, head symbols, CRE ---"),
  hu : %mr_defrule("t", 20, p_u, t_true, t_u),
  check("u_ binds a constant integrand", %mr_dispatch_tree(5, x, [hu], 1), 5),
  check("a binding holding a boolean is rejected", %mr_dispatch_tree(true, x, [hu], 1), false),
  hm : %mr_defrule("t", 21, p_xm, t_true, t_m),
  check("CRE integrand converts", %mr_dispatch_tree(rat(x^3), x, [hm], 1), 3),
  hr : %mr_defrule("t", 22, p_two, t_half, t_p),
  mr_cond_retry : true,
  check("mr_cond_retry true: the cond reaches the second binding",
        %mr_dispatch_tree((1+2*x)^3*sqrt(4+5*x), x, [hr], 1), 1/2),
  mr_cond_retry : false,
  check("mr_cond_retry false: the first complete binding is final",
        %mr_dispatch_tree((1+2*x)^3*sqrt(4+5*x), x, [hr], 1), false),
  mr_cond_retry : true,
  hF : %mr_defrule("t", 23, p_head, t_inv, t_app),
  check("a head capture binds the symbol the cond's list holds",
        %mr_dispatch_tree(asin(x), x, [hF], 1), asin(2)),
  check("a head outside the cond's list declines",
        %mr_dispatch_tree(sin(x), x, [hF], 1), false),
  hw : %mr_defrule("t", 24, p_wide, t_true, t_h),
  mr_flat_wide : false,
  check("mr_flat_wide false: an Optional-reduced Plus takes no run (G-6 narrow)",
        %mr_dispatch_tree(h*x*sin(x), x, [hw], 1), false),
  mr_flat_wide : true,
  check("mr_flat_wide true: an Optional-reduced Plus takes a run (G-6 wide)",
        %mr_dispatch_tree(h*x*sin(x), x, [hw], 1), h),
  mr_flat_wide : false,
  true)$

test_entries() := block([hm, hcf],
  print("--- test entries: bindings / accept / apply ---"),
  hm : %mr_defrule("t", 30, p_xm, t_true, t_m),
  hcf : %mr_defrule("t", 31, p_xm, t_false, t_42),
  check("%mr_rule_bindings ignores the cond", %mr_rule_bindings(hcf, x^3, x), [_t_m = 3]),
  check("%mr_rule_accept honours the cond (false)", %mr_rule_accept(hcf, x^3, x), false),
  check("%mr_rule_accept returns the accepted binding", %mr_rule_accept(hm, x^3, x), [_t_m = 3]),
  check("%mr_rule_apply answers", %mr_rule_apply(hm, x^3, x), 3),
  check("%mr_rule_apply on a cond-false rule", %mr_rule_apply(hcf, x^3, x), false),
  check("%mr_rule_bindings on no match", %mr_rule_bindings(hm, sin(x), x), false),
  true)$

/* The give-up rules and the two-pass walk (the mr_giveup_last switch).
   The port's table is LOAD order where Mathematica's is SPECIFICITY order,
   so a general give-up catch-all that loads early can pre-empt a specific
   rule that loads late; deferring the give-up rules to a second pass stops
   that without changing what Unintegrable MEANS — it still answers when
   nothing else does. */
test_giveup() := block([hg, h42, hd, hg1, hg2, saved],
  print("--- give-up rules and the two-pass walk (mr_giveup_last) ---"),
  saved : mr_giveup_last,
  hg  : %mr_defrule("t", 40, p_xm, t_true, t_unint),
  h42 : %mr_defrule("t", 41, p_xm, t_true, t_42),
  hd  : %mr_defrule("t", 42, p_xm, t_false, t_42),
  hg1 : %mr_defrule("t", 43, p_xm, t_true, t_unint1),
  hg2 : %mr_defrule("t", 44, p_xm, t_true, t_unint2),
  check("%mr_giveup_handles finds the mr_unintegrable repl",
        %mr_giveup_handles([hg, h42]), [hg]),
  check("an ordinary repl is not a give-up rule",
        %mr_giveup_handles([h42, hd]), []),
  mr_giveup_last : true,
  check("mr_giveup_last: an earlier give-up rule does not pre-empt a later ordinary one",
        %mr_dispatch_tree(x^3, x, [hg, h42], 1), 42),
  mr_giveup_last : false,
  check("mr_giveup_last false: the give-up rule wins in load order",
        %mr_dispatch_tree(x^3, x, [hg, h42], 1), mr_unintegrable(3, x)),
  mr_giveup_last : true,
  check("a give-up rule still answers when every ordinary rule declines",
        %mr_dispatch_tree(x^3, x, [hg, hd], 1), mr_unintegrable(3, x)),
  check("deferred give-up rules keep their relative order",
        %mr_dispatch_tree(x^3, x, [hg1, hg2], 1), mr_unintegrable(1, x)),
  check("%mr_giveup_handles wrong arity is an error",
        errcatch(%mr_giveup_handles()), []),
  check("%mr_giveup_handles on a non-list is an error",
        errcatch(%mr_giveup_handles(7)), []),
  mr_giveup_last : saved,
  true)$

/* The inert-trig domain (the mr_inert_leak_misfire switch, ticket 15). An
   integrand carrying one of the six inert trig heads exists only below the
   class-4 deactivation bridge. General records may work there -- 9_3 r51's
   FunctionOfLinear substitution, the 9.1 pull-outs -- as long as what they
   emit OUTSIDE the recursive Int is inert-free; a non-class-4 answer that
   carries an inert head (9_3 r41's prefactor) is a misfire, and the walk
   goes on. Class-4 records re-activate as they emit and are exempt. */
t_itan(mm, x) := 3*%mr_itan(x)$
test_inert_domain() := block([hleak, hok, hc4, hc4leak, saved],
  print("--- the inert-trig domain (mr_inert_leak_misfire) ---"),
  saved : mr_inert_leak_misfire,
  hleak   : %mr_defrule("9_t", 50, p_u, t_true, t_itan),
  hok     : %mr_defrule("9_t", 51, p_u, t_true, t_42),
  hc4     : %mr_defrule("4_t", 52, p_u, t_true, t_7),
  hc4leak : %mr_defrule("4_t", 53, p_u, t_true, t_itan),
  mr_inert_leak_misfire : true,
  check("inert integrand: a non-class-4 answer carrying an inert head is a misfire",
        %mr_dispatch_tree(%mr_itan(x)^3, x, [hleak, hc4], 1), 7),
  check("inert integrand: an inert-free non-class-4 answer stands",
        %mr_dispatch_tree(%mr_itan(x)^3, x, [hok, hc4], 1), 42),
  check("inert head below the top: the leak is still a misfire",
        %mr_dispatch_tree(x*%mr_isin(2*x), x, [hleak, hok], 1), 42),
  check("inert head inside a CRE integrand: the leak is still a misfire",
        %mr_dispatch_tree(rat(%mr_itan(x)^3), x, [hleak, hok], 1), 42),
  check("inert integrand: a class-4 answer carrying an inert head stands",
        %mr_dispatch_tree(%mr_icos(x), x, [hc4leak, hok], 1), 3*%mr_itan(x)),
  check("active integrand: the check does not apply",
        %mr_dispatch_tree(tan(x)^3, x, [hleak, hok], 1), 3*%mr_itan(x)),
  check("inert integrand, only a leaking record: no rule answers",
        %mr_dispatch_tree(%mr_icsc(x), x, [hleak], 1), false),
  mr_inert_leak_misfire : false,
  check("mr_inert_leak_misfire false: the leaking answer stands",
        %mr_dispatch_tree(%mr_itan(x)^3, x, [hleak, hc4], 1), 3*%mr_itan(x)),
  mr_inert_leak_misfire : saved,
  check("mr_inert_leak_misfire defaults to true", saved, true),
  true)$

/* The last-resort tier (the mr_last_resort_tier switch, ticket 14). A
   bare-u_ TAIL record (%mr_mark_tail) is Mathematica's least specific
   pattern, so the specific give-ups (the Unintegrable markers) outrank it:
   under mr_giveup_last the walk is ordinary rules, then the specific
   give-ups, then the tail's ordinary records, then the tail's give-ups.
   Class-4 tail records are the inert-trig bridge -- domain-guarded, tried
   in the first pass as before -- so only their give-up (4_7_5 r72) waits
   for the last tier. */
test_last_resort() := block([hord, hgu, htail, htgu, hc4, hc4gu, saved, savedg, savedb],
  print("--- the last-resort tier (mr_last_resort_tier) ---"),
  saved : mr_last_resort_tier, savedg : mr_giveup_last,
  /* the TAIL tier alone: the general-body switch (next section) moves the
     class-4 bridge as well */
  savedb : mr_general_after_giveups, mr_general_after_giveups : false,
  hord  : %mr_defrule("1_t", 60, p_xm, t_true, t_42),
  hgu   : %mr_defrule("3_t", 61, p_xm, t_true, t_unint1),
  htail : %mr_defrule("9_t", 62, p_xm, t_true, t_7),
  htgu  : %mr_defrule("9_t", 63, p_xm, t_true, t_unint2),
  hc4   : %mr_defrule("4_t", 64, p_xm, t_true, t_m),
  hc4gu : %mr_defrule("4_t", 65, p_xm, t_true, t_unint),
  check("%mr_mark_tail returns the number of handles marked",
        %mr_mark_tail([htail, htgu, hc4, hc4gu]), 4),
  check("%mr_tail_handles reads the marks back, in table order",
        %mr_tail_handles([hord, htail, hgu, htgu, hc4, hc4gu]), [htail, htgu, hc4, hc4gu]),
  mr_giveup_last : true, mr_last_resort_tier : true,
  check("a specific give-up outranks a tail ordinary record",
        %mr_dispatch_tree(x^3, x, [htail, hgu], 1), mr_unintegrable(1, x)),
  check("an ordinary rule still outranks the specific give-up",
        %mr_dispatch_tree(x^3, x, [htail, hgu, hord], 1), 42),
  check("a tail ordinary record outranks a tail give-up",
        %mr_dispatch_tree(x^3, x, [htgu, htail], 1), 7),
  check("a class-4 tail ordinary record stays in the first pass",
        %mr_dispatch_tree(x^3, x, [hgu, hc4], 1), 3),
  check("a class-4 tail give-up waits for the last tier",
        %mr_dispatch_tree(x^3, x, [hc4gu, htail], 1), 7),
  check("tail give-ups keep their table order",
        %mr_dispatch_tree(x^3, x, [hc4gu, htgu], 1), mr_unintegrable(3, x)),
  mr_last_resort_tier : false,
  check("mr_last_resort_tier false: the tail ordinary record wins pass 1",
        %mr_dispatch_tree(x^3, x, [htail, hgu], 1), 7),
  mr_last_resort_tier : true, mr_giveup_last : false,
  check("mr_giveup_last false: load order, whatever the tier switch",
        %mr_dispatch_tree(x^3, x, [htail, hgu], 1), 7),
  mr_giveup_last : savedg, mr_last_resort_tier : saved,
  mr_general_after_giveups : savedb,
  check("mr_last_resort_tier defaults to true", saved, true),
  check("%mr_mark_tail on a non-handle is an error", errcatch(%mr_mark_tail([10^9])), []),
  check("%mr_tail_handles wrong arity is an error", errcatch(%mr_tail_handles()), []),
  true)$

/* The general body records (the mr_general_after_giveups switch, ticket
   14). %mr_mark_general flags BODY records whose patterns are general enough
   that Mathematica's specificity order puts the specific give-ups first (9.3's
   body: u_/x, u_*x^m_., ...). Under the switch their ordinary records join the
   tail's ordinary records in pass 3, in table order; a general give-up stays a
   specific give-up (pass 2). */
t_5(mm, x) := 5$
test_general_body() := block([hgu, htail, htgu, hgen, hgengu, hc4, saved, savedt, savedg],
  print("--- general body records (mr_general_after_giveups) ---"),
  saved : mr_general_after_giveups, savedt : mr_last_resort_tier, savedg : mr_giveup_last,
  hgu    : %mr_defrule("3_t", 70, p_xm, t_true, t_unint1),
  htail  : %mr_defrule("9_t", 71, p_xm, t_true, t_7),
  htgu   : %mr_defrule("9_t", 72, p_xm, t_true, t_unint2),
  hgen   : %mr_defrule("9_t", 73, p_xm, t_true, t_5),
  hgengu : %mr_defrule("9_t", 74, p_xm, t_true, t_unint),
  hc4    : %mr_defrule("4_t", 75, p_xm, t_true, t_m),
  %mr_mark_tail([htail, htgu, hc4]),
  check("%mr_mark_general returns the number of handles marked",
        %mr_mark_general([hgen, hgengu]), 2),
  check("%mr_general_handles reads the marks back, in table order",
        %mr_general_handles([htail, hgengu, hgu, hgen]), [hgengu, hgen]),
  mr_giveup_last : true, mr_last_resort_tier : true,
  mr_general_after_giveups : false,
  check("switch false: a general ordinary record wins pass 1",
        %mr_dispatch_tree(x^3, x, [hgen, hgu], 1), 5),
  mr_general_after_giveups : true,
  check("a specific give-up outranks a general ordinary record",
        %mr_dispatch_tree(x^3, x, [hgen, hgu], 1), mr_unintegrable(1, x)),
  check("general and tail ordinary records share pass 3, in table order (a)",
        %mr_dispatch_tree(x^3, x, [hgen, htail], 1), 5),
  check("general and tail ordinary records share pass 3, in table order (b)",
        %mr_dispatch_tree(x^3, x, [htail, hgen], 1), 7),
  check("a general ordinary record outranks a tail give-up",
        %mr_dispatch_tree(x^3, x, [htgu, hgen], 1), 5),
  check("the class-4 bridge keeps its place BEHIND a general record",
        %mr_dispatch_tree(x^3, x, [hgen, hc4], 1), 5),
  check("the class-4 bridge waits behind the specific give-ups too",
        %mr_dispatch_tree(x^3, x, [hgu, hc4], 1), mr_unintegrable(1, x)),
  check("a general give-up stays a specific give-up (pass 2)",
        %mr_dispatch_tree(x^3, x, [htail, hgengu], 1), mr_unintegrable(3, x)),
  mr_general_after_giveups : saved, mr_last_resort_tier : savedt, mr_giveup_last : savedg,
  check("mr_general_after_giveups defaults to true", saved, true),
  check("%mr_mark_general on a non-handle is an error", errcatch(%mr_mark_general([10^9])), []),
  check("%mr_general_handles wrong arity is an error", errcatch(%mr_general_handles()), []),
  true)$

t_fault1(b) := ?error('?storage\-condition)$

test_matchq() := block([B],
  print("--- MatchQ entries ---"),
  check_bool("MatchQ 5*x^2 vs u_.*x^m_. /; IntegerQ[m]",
             %mr_matchQ(5*x^2, "(Times (Optional (Pattern |_t_mq1_u| (Blank))) (Power (MRArg 1) (Optional (Pattern |_t_mq1_m| (Blank)))))",
                        [x], lambda([%mr_mqb], integerp(%mr_mk(_t_mq1_m, %mr_mqb))))),
  B : %mr_matchQ_bindings(5*x^2, "(Times (Optional (Pattern |_t_mq1_u| (Blank))) (Power (MRArg 1) (Optional (Pattern |_t_mq1_m| (Blank)))))",
                          [x], true),
  check_bool("MatchQ bindings u = 5, m = 2",
             listp(B) and is(geteqR(B, '_t_mq1_u) = 5) and is(geteqR(B, '_t_mq1_m) = 2)),
  check("MatchQ x^y vs x^m_ /; IntegerQ[m] is false",
        %mr_matchQ(x^y, "(Power (MRArg 1) (Pattern |_t_mq2_m| (Blank)))",
                   [x], lambda([%mr_mqb], integerp(%mr_mk(_t_mq2_m, %mr_mqb)))),
        false),
  check_bool("MatchQ a Times part splices into Plus (f_+g_.*x^2)^r_.",
             %mr_matchQ(3 + 5*x^2, "(Power (Plus (Pattern |_t_mq3_f| (Blank)) (Times (Optional (Pattern |_t_mq3_g| (Blank))) (MRArg 1))) (Optional (Pattern |_t_mq3_r| (Blank))))",
                        [x^2], true)),
  /* Plus is Flat: f_ alone can take the run 3 + 7*x^4, so only the
     FreeQ cond rejects the trinomial */
  check("MatchQ trinomial vs (f_+g_.*x^2)^r_. /; FreeQ[f, x] is false",
        %mr_matchQ(3 + 5*x^2 + 7*x^4, "(Power (Plus (Pattern |_t_mq3_f| (Blank)) (Times (Optional (Pattern |_t_mq3_g| (Blank))) (MRArg 1))) (Optional (Pattern |_t_mq3_r| (Blank))))",
                   [x^2], lambda([%mr_mqb], freeof(x, %mr_mk(_t_mq3_f, %mr_mqb)))),
        false),
  mr_cond_retry : false,
  check_bool("MatchQ tries every binding whatever mr_cond_retry says",
             %mr_matchQ((1+2*x)^3*sqrt(4+5*x),
                        "(Times (Power (Plus (Optional (Pattern |_t_mq4_a| (Blank))) (Times (Optional (Pattern |_t_mq4_b| (Blank))) (MRArg 1))) (Optional (Pattern |_t_mq4_p| (Blank)))) (Power (Plus (Optional (Pattern |_t_mq4_c| (Blank))) (Times (Optional (Pattern |_t_mq4_d| (Blank))) (MRArg 1))) (Optional (Pattern |_t_mq4_q| (Blank)))))",
                        [x], lambda([%mr_mqb], is(%mr_mk(_t_mq4_p, %mr_mqb) = 1/2)))),
  mr_cond_retry : true,
  check("MatchQ fault guard: a storage-condition signalled in cond -> false",
        %mr_matchQ(x, "(Pattern |_t_mq5_u| (Blank))", [], t_fault1), false),
  check("MatchQ wrong arity is an error",
        errcatch(%mr_matchQ(x, "(Pattern |_t_mq5_u| (Blank))", [], true, 5)), []),
  check("MatchQ a pattern prepare rejects is an error",
        errcatch(%mr_matchQ(x, "(Alternatives (Pattern |_t_mq6_a| (Blank)) (Pattern |_t_mq6_b| (Blank)))", [], true)), []),
  /* Part folding (final review, 1.4.2 r17): Mathematica evaluates the
     pattern after inserting the parts, so (d_.+e_.*x)^m with m = 1 is
     d_.+e_.*x, a part 0 exponent gives 1, a literal 1 under Times and 0
     under Plus drop, a one-argument Times/Plus collapses — bottom-up.
     Numeric products and sums are not folded. */
  check_bool("MatchQ a part 1 in an exponent folds: (a+b x)^1 on 1+2x",
             %mr_matchQ(1+2*x, "(Power (Plus (Optional (Pattern |_t_mq7_a| (Blank))) (Times (MRArg 1) (Optional (Pattern |_t_mq7_b| (Blank))))) (MRArg 2))", [x, 1], true)),
  check_bool("MatchQ a part 2 in an exponent: (a+b x)^2 on (1+2x)^2",
             %mr_matchQ((1+2*x)^2, "(Power (Plus (Optional (Pattern |_t_mq7_a| (Blank))) (Times (MRArg 1) (Optional (Pattern |_t_mq7_b| (Blank))))) (MRArg 2))", [x, 2], true)),
  check_bool("MatchQ a part 0 in an exponent folds to 1: (a+b x)^0 on 1",
             %mr_matchQ(1, "(Power (Plus (Optional (Pattern |_t_mq7_a| (Blank))) (Times (MRArg 1) (Optional (Pattern |_t_mq7_b| (Blank))))) (MRArg 2))", [x, 0], true)),
  check("MatchQ a spliced 1 under Times drops: 1*u_ on sin(x) binds u",
        %mr_matchQ_bindings(sin(x), "(Times (MRArg 1) (Pattern |_t_mq8_u| (Blank)))", [1], true),
        [_t_mq8_u = sin(x)]),
  check("MatchQ a spliced 0 under Plus drops: 0+u_ on sin(x) binds u",
        %mr_matchQ_bindings(sin(x), "(Plus (MRArg 1) (Pattern |_t_mq8_u| (Blank)))", [0], true),
        [_t_mq8_u = sin(x)]),
  check("MatchQ folds bottom-up: x^0*u_ on sin(x) binds u",
        %mr_matchQ_bindings(sin(x), "(Times (Power (MRArg 1) (MRArg 2)) (Pattern |_t_mq8_u| (Blank)))", [x, 0], true),
        [_t_mq8_u = sin(x)]),
  check("MatchQ an out-of-range (MRArg 2) with one part is an error",
        errcatch(%mr_matchQ(1+2*x, "(Power (Plus (Optional (Pattern |_t_mq7_a| (Blank))) (Times (MRArg 1) (Optional (Pattern |_t_mq7_b| (Blank))))) (MRArg 2))", [x], true)), []),
  check("MatchQ an out-of-range (MRArg 0) is an error",
        errcatch(%mr_matchQ(x, "(Times (MRArg 0) (Pattern |_t_mq8_u| (Blank)))", [x], true)), []),
  true)$

/* Rewrite records (inert-trig substrate design 3.2): the non-Int sibling of
   %mr_defrule. Five behaviours, on a hand-written two-record table -- no
   generated content, no rule files.

   Table (in order):
     r1  F[a_*u_, x] := 99            /; FreeQ[a, x]
     r2  F[u_, x]    := 7

   so F[3*y, y] takes r1 (a=3 is free of y), F[y, y] falls to r2, and
   F[y*(y+1), y] -- every complete binding of a_*u_ has x=y free in BOTH
   factors, so r1's cond rejects them all -- shows a rejecting cond does
   not stop the walk. Each %mr_defrewrite call itself is
   wrapped in errcatch (rather than assigning its handle directly) so the
   RED run -- %mr_defrewrite still undefined -- fails only the checks below
   instead of aborting the whole block. */
_mr_cond_t3_r1(mm, x) := freeof(x, geteqR(mm, '_t3_r1_a))$
_mr_repl_t3_r1(mm, x) := 99$
_mr_cond_t3_r2(mm, x) := true$
_mr_repl_t3_r2(mm, x) := 7$

p_t3_r1 : "(F (Times (Pattern |_t3_r1_a| (Blank)) (Pattern |_t3_r1_u| (Blank))) (Pattern x (Blank)))"$
p_t3_r2 : "(F (Pattern |_t3_r2_u| (Blank)) (Pattern x (Blank)))"$

test_rewrite() := block([h1, h2, tbl],
  print("--- rewrite records: %mr_defrewrite / %mr_rewrite ---"),
  h1 : %mr_defrewrite("t3", 1, p_t3_r1, _mr_cond_t3_r1, _mr_repl_t3_r1),
  h2 : %mr_defrewrite("t3", 2, p_t3_r2, _mr_cond_t3_r2, _mr_repl_t3_r2),
  tbl : [h1, h2],
  check("rewrite: first record fires", %mr_rewrite("F", tbl, 3*y, y), 99),
  check("rewrite: falls through to second", %mr_rewrite("F", tbl, y, y), 7),
  /* y*(y+1): a_*u_ has two candidate bindings (a=y,u=y+1) and (a=y+1,u=y);
     x=y occurs free in BOTH factors, so r1's cond rejects every binding
     (not just the first one mr_cond_retry would otherwise retry into) and
     the walk falls to r2. */
  check("rewrite: cond rejects, walk continues", %mr_rewrite("F", tbl, y*(y+1), y), 7),
  check("rewrite: no record matches -> u unchanged", %mr_rewrite("G", [h1], y, y), y),
  check("rewrite: a pattern the preparer rejects errors at load",
        errcatch(%mr_defrewrite("t3", 3,
          "(F (Alternatives (Pattern |_t3_r3_a| (Blank)) (Pattern |_t3_r3_b| (Blank))) (Pattern x (Blank)))",
          true, _mr_repl_t3_r2)),
        []),
  /* Class 4 (2026-09-25): the 3-argument walk, for a ONE-argument function
     (TrigSimplifyAux[u]). The pattern binds (H u); cond and repl see
     x = false. */
  h1 : %mr_defrewrite("t3", 4, "(H (Times (Pattern |_t3_r4_a| (Blank)) (Pattern |_t3_r4_u| (Blank))))",
                      _mr_cond_t3_r4, _mr_repl_t3_r4),
  check("rewrite (3 args): a one-argument record fires, x is false",
        %mr_rewrite("H", [h1], 3*y), [3, y, false]),
  check("rewrite (3 args): no record matches -> u unchanged",
        %mr_rewrite("H", [h1], y), y),
  check("rewrite: 2 args is an error", errcatch(%mr_rewrite("H", [h1])), []),
  true)$
_mr_cond_t3_r4(mm, x) := true$
_mr_repl_t3_r4(mm, x) := [geteqR(mm, '_t3_r4_a), geteqR(mm, '_t3_r4_u), x]$

test_records()$
test_dispatch()$
test_bindings()$
test_entries()$
test_giveup()$
test_inert_domain()$
test_last_resort()$
test_general_body()$
test_matchq()$
test_rewrite()$
print("")$
print("========================================")$
print("Results: ", tests_passed, " passed, ", tests_failed, " failed")$
print("========================================")$
