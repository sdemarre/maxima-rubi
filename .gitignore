# Claude Code native worktrees
.claude/worktrees/

# Git worktree fallback (isolated implementation workspaces)
.worktrees/

# Subagent-driven-development scratch (briefs, reports, review packages).
# The progress ledger is tracked; everything else here is disposable.
/.superpowers/sdd/*
!/.superpowers/sdd/progress.md

# Local reference clones — working copies, not part of this project.
# Pinned hashes are recorded in todo/TODO.md. In worktrees the clone is
# a SYMLINK to the main checkout, so both the dir and the bare name
# (symlinks do not match a trailing-slash pattern) are ignored.
/reference/
/reference

# Python bytecode from probes.
__pycache__/

# Option-D rules core: a 154 MB saved Maxima image, rebuilt by
# test/build_rules_core.sh (fingerprint sidecar + build lock are disposable
# too). Never committed.
/test/mr_rules.core
/test/mr_rules.core.stamp
/test/mr_rules.core.lock

# Layer B sharded-run artifacts for any class (per-shard outputs, pid
# files, one-off watcher/merge logs). The committed records are the
# merged test/corpus_classN.out / test/corpus_classN.baseline.out and
# the re-check record + merge transcript inside
# test/corpus_classN.timeout-rerun/ — the patterns below cannot match
# them (the run-dir contents are re-included explicitly).
/test/corpus_class*.shard*
/test/corpus_class*.baseline.pids
/test/class*_merge.*
/test/corpus_class*.timeout-rerun/*
!/test/corpus_class*.timeout-rerun/corpus_class*.timeout*.out
!/test/corpus_class*.timeout-rerun/merge.out
/test/w1_ab_shard*
/test/run_status.log
/test/wait_and_merge.log
/test/timeout_rerun_wait.log
/test/full_run3_merge.out
