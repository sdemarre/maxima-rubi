# Claude Code native worktrees
.claude/worktrees/

# Git worktree fallback (isolated implementation workspaces)
.worktrees/

# Subagent-driven-development scratch (briefs, reports, review packages).
# The progress ledger is tracked; everything else here is disposable.
/.superpowers/sdd/*
!/.superpowers/sdd/progress.md

# Local reference clones — working copies, not part of this project.
# Pinned hashes are recorded in todo/TODO.md. In worktrees the clone is
# a SYMLINK to the main checkout, so both the dir and the bare name
# (symlinks do not match a trailing-slash pattern) are ignored.
/reference/
/reference

# Python bytecode from probes.
__pycache__/
